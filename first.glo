// The complete build entry point. main.glo loads the manual sources from src/.

append_reference_text :: (path: string, text: string) -> bool {
    file: File;
    if open(path, .Write, .Open_Or_Create, .flags = .Append) == {
        case .Ok(opened); file = opened;
        case .Err; return false;
    }
    wrote := write(file, text);
    closed := close(*file);
    if #pattern .Ok(written) = wrote {
        return written == text.count && result_is_ok(closed);
    }
    return false;
}

append_generated_part :: (output_path: string, part_path: string) -> bool {
    loaded := read_file(part_path, 8 * 1024 * 1024);
    if loaded == {
        case .Err;
            print("could not read generated reference part %\n", part_path);
            return false;
        case .Ok(text);
            return append_reference_text(output_path, text);
    }
}

assemble_reference_parts :: () -> bool {
    glo_parts := .[
        "build/reference-glo-header.part",
        "build/reference-modules.glo.part",
        "build/reference-glo-after-modules.part",
        "build/reference-symbols.glo.part",
        "build/reference-glo-after-symbols.part",
        "build/reference-details.glo.part",
        "build/reference-glo-after-details.part",
        "build/reference-members.glo.part",
        "build/reference-glo-after-members.part",
        "build/reference-instances.glo.part",
        "build/reference-glo-footer.part",
    ];
    if !os_fs_is_directory("src/generated") && !os_fs_create_directories("src/generated") {
        print("could not create src/generated\n");
        return false;
    }
    initialized_glo := write_file("src/generated/std_reference.glo", "");
    if result_is_err(initialized_glo) {
        print("could not initialize src/generated/std_reference.glo\n");
        return false;
    }
    for path: glo_parts {
        if !append_generated_part("src/generated/std_reference.glo", path)
            return false;
    }

    initialized_js := write_file(
        "reference-index.js",
        "// Generated by `glosso first.glo -- gen-reference`. Do not edit by hand.\nexport const referenceIndex = {\"modules\":[",
    );
    if result_is_err(initialized_js) return false;
    if !append_generated_part("reference-index.js", "build/reference-modules.js.part") return false;
    if !append_reference_text("reference-index.js", "],\"symbols\":[") return false;
    if !append_generated_part("reference-index.js", "build/reference-symbols.js.part") return false;
    if !append_reference_text("reference-index.js", "],\"manual\":") return false;
    if !append_generated_part("reference-index.js", "build/reference-manual.js.part") return false;
    if !append_reference_text("reference-index.js", "};\n") return false;

    return true;
}

run_reference_generator :: (std_directory: string) -> bool {
    if !os_fs_is_directory("build") &&
       !os_fs_create_directories("build") {
        print("could not create build\n");
        return false;
    }

    source_generator := "build/generate-reference-source";
    #if OUT.os == Target_OS.Windows
        source_generator = "build/generate-reference-source.exe";

    source_workspace := compiler_create_workspace("manual-reference-source");
    source_options := get_build_options(source_workspace);
    source_options.output_path = "build";
    source_options.output_executable_name = "generate-reference-source";
    #if OUT.os == Target_OS.Windows
        source_options.output_executable_name = "generate-reference-source.exe";
    set_optimization(*source_options, .Optimized);
    set_borrow_check(*source_options, Compiler_Borrow_Check.Off);
    set_temp_allocator_size(*source_options, 1024 * 1024 * 1024);
    set_build_options(source_options, source_workspace);
    source_built := add_build_file("scripts/generate-reference-source.glo", source_workspace);
    if #pattern .Err(failure) = source_built {
        print("reference source extractor build failed:\n");
        report_error(failure);
        return false;
    }

    source_command := command_make(source_generator);
    command_add_argument(*source_command, std_directory);
    command_add_argument(*source_command, "build/reference-source.json");
    extracted := command_run(source_command);
    command_destroy(*source_command);
    if extracted == {
        case .Ok(finished);
            if !finished.status.exited || finished.status.code != 0 return false;
        case .Err;
            print("could not run the Glosso reference source extractor\n");
            return false;
    }

    generator := "build/generate-reference";
    #if OUT.os == Target_OS.Windows
        generator = "build/generate-reference.exe";

    generator_workspace := compiler_create_workspace("manual-reference-generator");
    options := get_build_options(generator_workspace);
    options.output_path = "build";
    options.output_executable_name = "generate-reference";
    #if OUT.os == Target_OS.Windows
        options.output_executable_name = "generate-reference.exe";
    set_optimization(*options, .Optimized);
    set_borrow_check(*options, Compiler_Borrow_Check.Warning);
    set_temp_allocator_size(*options, 256 * 1024 * 1024);
    set_build_options(options, generator_workspace);
    built := add_build_file("scripts/generate-reference.glo", generator_workspace);
    if #pattern .Err(failure) = built {
        print("reference generator build failed:\n");
        report_error(failure);
        return false;
    }

    command := command_make(generator);
    command_add_argument(*command, "build/reference-source.json");
    generated := command_run(command);
    command_destroy(*command);
    if generated == {
        case .Ok(finished);
            if !finished.status.exited || finished.status.code != 0 return false;
        case .Err;
            print("could not run the reference generator\n");
            return false;
    }
    return assemble_reference_parts();
}

build_manual :: () -> bool {
    if !os_fs_is_directory("dist") && !os_fs_create_directories("dist") {
        print("could not create dist\n");
        return false;
    }

    wasm_target := Output_Target.{
        .os = Target_OS.Wasm,
        .cpu = Target_CPU.Wasm32,
        .abi = Target_ABI.Freestanding,
    };
    cache_arg_result := #try { str_cat("--cache-dir=", absolute("build/cache")?) };
    cache_arg: string;
    if cache_arg_result == {
    case .Ok(argument); cache_arg = argument;
    case .Err;
        print("cannot get the absolute path \"build/cache\"\n");
        return false;
    }

    workspace := compiler_create_workspace("manual-wasm");
    options := get_build_options(workspace);
    options.output_path = "dist";
    options.output_executable_name = "manual.wasm";
    set_target(*options, wasm_target);
    // The current LLVM 23 pipeline still rejects its Os/Oz pipeline levels,
    // even though Glosso applies optsize/minsize attributes for those modes.
    set_optimization(*options, .Optimized);
    set_borrow_check(*options, Compiler_Borrow_Check.Error);
    set_color(*options, .Always);
    set_temp_allocator_size(*options, 1024 * 1024);
    add_compiler_arg(*options, cache_arg);
    add_linker_arg(*options, "--export=__heap_base");
    add_linker_arg(*options, "--export=glo_manual_set_view");
    add_linker_arg(*options, "--export=glo_manual_select_section");
    add_linker_arg(*options, "--export=glo_manual_select_module");
    add_linker_arg(*options, "--export=glo_manual_set_search_results");
    add_linker_arg(*options, "--export=glo_manual_get_view");
    add_linker_arg(*options, "--export=glo_manual_get_section");
    add_linker_arg(*options, "--export=glo_manual_get_module");
    add_linker_arg(*options, "--export=glo_manual_get_scroll_request");
    add_linker_arg(*options, "--export=glo_manual_clear_scroll_request");
    add_linker_arg(*options, "--allow-undefined");
    add_linker_arg(*options, "--initial-memory=134217728");
    add_linker_arg(*options, "--max-memory=268435456");
    set_build_options(options, workspace);
    built := add_build_file("main.glo", workspace);
    if #pattern .Err(failure) = built {
        print("manual build failed:\n");
        report_error(failure);
        return false;
    }

    if !os_fs_copy_file("index.html", "dist/index.html", true) {
        print("manual built, but index.html could not be staged\n");
        return false;
    }
    assets := .[
        .["app.js", "dist/app.js"],
        .["reference-index.js", "dist/reference-index.js"],
        .["tree-sitter/tree-sitter-glosso.wasm", "dist/tree-sitter-glosso.wasm"],
        .["tree-sitter/highlights.scm", "dist/highlights.scm"],
        .["vendor/web-tree-sitter/web-tree-sitter.js", "dist/web-tree-sitter.js"],
        .["vendor/web-tree-sitter/web-tree-sitter.wasm", "dist/web-tree-sitter.wasm"],
        .["vendor/web-tree-sitter/LICENSE", "dist/web-tree-sitter.LICENSE"],
    ];
    for asset: assets {
        if !os_fs_copy_file(asset[0], asset[1], true) {
            print("manual built, but % could not be staged\n", asset[0]);
            return false;
        }
    }
    print("built the searchable manual and staged its browser assets in dist/\n");
    return true;
}

manual_task_usage :: () {
    print(#string
        \\usage: glosso first.glo -- <command> [arguments]
        \\
        \\commands:
        \\  build                    build main.glo and stage dist
        \\  tree-sitter              embed tree-sitter/highlights.scm in app.js
        \\  gen-reference <std-dir>  regenerate reference data from a Glosso std directory
        \\
    );
}

run_manual_task :: () {
    set_build_options_dc(.do_output = false);
    args := get_cmdline_args();
    if args.count == 0 {
        manual_task_usage();
        exit(1);
    }
    command := args[0];

    if command == {
    case "build"; if !build_manual() exit(1); return;
    case "tree-sitter"; if !sync_tree_sitter() exit(1); return;
    case "gen-reference";
        if args.count < 2 {
            print("gen-reference requires a standard-library directory\n\n");
            manual_task_usage();
            exit(1);
        }
        if !run_reference_generator(args[1]) exit(1);
        return;
    else;
        print("unknown manual task: %\n\n", command);
        manual_task_usage();
        exit(1);
    }
}

#comptime run_manual_task();
main :: () {}

#import "Io";
#import "Typeclass/Error";
#import "Compiler";
#import "Os";
#import "Process/Command";
#import "File_System/Types";
#import "File_System/File";
#import "File_System/System";

#load,embed "scripts/tree_sitter.glo";
