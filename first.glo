// The complete build entry point. main.glo loads the manual sources from src/.

append_reference_text :: (path: string, text: string) -> Fs_Error!bool {
    file := File.open(path, .Write, .Open_Or_Create, .flags = .Append)?;
    wrote := file.write(text);
    closed := file.close();
    if #pattern .Ok(written) = wrote {
        return .Ok(written == text.count && closed.is_ok());
    }
    return .Ok(false);
}

append_generated_part :: (output_path: string, part_path: string) -> bool {
    loaded := part_path.read_file(8 * 1024 * 1024);
    if loaded == {
        case .Err;
            print("could not read generated reference part %\n", part_path);
            return false;
        case .Ok(text);
            defer text.free();
            return append_reference_text(output_path, text).unwrap_or(false);
    }
}

assemble_reference_parts :: () -> bool {
    glo_parts := .[
        "build/reference-glo-header.part",
        "build/reference-modules.glo.part",
        "build/reference-glo-after-modules.part",
        "build/reference-symbols.glo.part",
        "build/reference-glo-after-symbols.part",
        "build/reference-details.glo.part",
        "build/reference-glo-after-details.part",
        "build/reference-members.glo.part",
        "build/reference-glo-after-members.part",
        "build/reference-instances.glo.part",
        "build/reference-glo-footer.part",
    ];
    if !("src/generated").os_fs_is_directory() && !("src/generated").os_fs_create_directories() {
        print("could not create src/generated\n");
        return false;
    }
    initialized_glo := ("src/generated/std_reference.glo").write_file("");
    if initialized_glo.is_err() {
        print("could not initialize src/generated/std_reference.glo\n");
        return false;
    }
    for path: glo_parts {
        if !append_generated_part("src/generated/std_reference.glo", path)
            return false;
    }

    initialized_js := ("reference-index.js").write_file("// Generated by `glosso first.glo -- gen-reference`. Do not edit by hand.\nexport const referenceIndex = {\"modules\":[");
    if initialized_js.is_err() return false;
    if !append_generated_part("reference-index.js", "build/reference-modules.js.part") return false;
    if !append_reference_text("reference-index.js", "],\"symbols\":[").unwrap_or(false) return false;
    if !append_generated_part("reference-index.js", "build/reference-symbols.js.part") return false;
    if !append_reference_text("reference-index.js", "],\"manual\":").unwrap_or(false) return false;
    if !append_generated_part("reference-index.js", "build/reference-manual.js.part") return false;
    if !append_reference_text("reference-index.js", "};\n").unwrap_or(false) return false;

    return true;
}

run_reference_generator :: (std_directory: string) -> bool {
    if !("build").os_fs_is_directory() &&
       !("build").os_fs_create_directories() {
        print("could not create build\n");
        return false;
    }

    source_generator := "build/generate-reference-source";
    #if OUT.os == Target_OS.Windows
        source_generator = "build/generate-reference-source.exe";

    source_workspace := ("manual-reference-source").compiler_create_workspace();
    source_options := source_workspace.get_build_options();
    source_options.output_path = "build";
    source_options.output_executable_name = "generate-reference-source";
    #if OUT.os == Target_OS.Windows
        source_options.output_executable_name = "generate-reference-source.exe";
    source_options.set_optimization(.Optimized);
    source_options.set_borrow_check(Compiler_Borrow_Check.Off);
    source_options.set_temp_allocator_size(1024 * 1024 * 1024);
    source_options.set_build_options(source_workspace);
    source_built := ("scripts/generate-reference-source.glo").add_build_file(source_workspace);
    if #pattern .Err(failure) = source_built {
        print("reference source extractor build failed:\n");
        report_error(failure);
        return false;
    }

    source_command := source_generator.command_make();
    source_command.add_argument(std_directory);
    source_command.add_argument("build/reference-source.json");
    extracted := source_command.run();
    source_command.destroy();
    if extracted == {
        case .Ok(finished);
            if !finished.status.exited || finished.status.code != 0 return false;
        case .Err(failure);
            if failure.child.valid _ := failure.child.close();
            print("could not run the Glosso reference source extractor\n");
            return false;
    }

    generator := "build/generate-reference";
    #if OUT.os == Target_OS.Windows
        generator = "build/generate-reference.exe";

    generator_workspace := ("manual-reference-generator").compiler_create_workspace();
    options := generator_workspace.get_build_options();
    options.output_path = "build";
    options.output_executable_name = "generate-reference";
    #if OUT.os == Target_OS.Windows
        options.output_executable_name = "generate-reference.exe";
    options.set_optimization(.Optimized);
    options.set_borrow_check(Compiler_Borrow_Check.Warning);
    options.set_temp_allocator_size(256 * 1024 * 1024);
    options.set_build_options(generator_workspace);
    built := ("scripts/generate-reference.glo").add_build_file(generator_workspace);
    if #pattern .Err(failure) = built {
        print("reference generator build failed:\n");
        report_error(failure);
        return false;
    }

    command := generator.command_make();
    command.add_argument("build/reference-source.json");
    generated := command.run();
    command.destroy();
    if generated == {
        case .Ok(finished);
            if !finished.status.exited || finished.status.code != 0 return false;
        case .Err(failure);
            if failure.child.valid _ := failure.child.close();
            print("could not run the reference generator\n");
            return false;
    }
    return assemble_reference_parts();
}

build_manual :: () -> bool {
    // The browser embeds this query; staging highlights.scm alone leaves it
    // stale when a compiler update also changes the Tree-sitter grammar.
    if !sync_tree_sitter() return false;
    if !("dist").os_fs_is_directory() && !("dist").os_fs_create_directories() {
        print("could not create dist\n");
        return false;
    }

    wasm_target := Output_Target.{
        .os = Target_OS.Wasm,
        .cpu = Target_CPU.Wasm32,
        .abi = Target_ABI.Freestanding,
    };
    cache_arg_result := #try { ("--cache-dir=").cat(("build/cache").absolute()?) };
    cache_arg: string;
    if cache_arg_result == {
    case .Ok(argument); cache_arg = argument;
    case .Err;
        print("cannot get the absolute path \"build/cache\"\n");
        return false;
    }

    workspace := ("manual-wasm").compiler_create_workspace();
    options := workspace.get_build_options();
    options.output_path = "dist";
    options.output_executable_name = "manual.wasm";
    options.set_target(wasm_target);
    // The current LLVM 23 pipeline still rejects its Os/Oz pipeline levels,
    // even though Glosso applies optsize/minsize attributes for those modes.
    options.set_optimization(.Optimized);
    options.set_borrow_check(Compiler_Borrow_Check.Error);
    options.set_color(.Always);
    options.set_temp_allocator_size(1024 * 1024);
    options.add_compiler_arg(cache_arg);
    options.add_linker_arg("--export=__heap_base");
    options.add_linker_arg("--export=glo_manual_set_view");
    options.add_linker_arg("--export=glo_manual_select_section");
    options.add_linker_arg("--export=glo_manual_select_module");
    options.add_linker_arg("--export=glo_manual_set_search_results");
    options.add_linker_arg("--export=glo_manual_get_view");
    options.add_linker_arg("--export=glo_manual_get_section");
    options.add_linker_arg("--export=glo_manual_get_module");
    options.add_linker_arg("--export=glo_manual_get_scroll_request");
    options.add_linker_arg("--export=glo_manual_clear_scroll_request");
    options.add_linker_arg("--allow-undefined");
    options.add_linker_arg("--initial-memory=134217728");
    options.add_linker_arg("--max-memory=268435456");
    options.set_build_options(workspace);
    built := ("main.glo").add_build_file(workspace);
    if #pattern .Err(failure) = built {
        print("manual build failed:\n");
        report_error(failure);
        return false;
    }

    if !("index.html").os_fs_copy_file("dist/index.html", true) {
        print("manual built, but index.html could not be staged\n");
        return false;
    }
    assets := .[
        .["app.js", "dist/app.js"],
        .["reference-index.js", "dist/reference-index.js"],
        .["tree-sitter/tree-sitter-glosso.wasm", "dist/tree-sitter-glosso.wasm"],
        .["tree-sitter/highlights.scm", "dist/highlights.scm"],
        .["vendor/web-tree-sitter/web-tree-sitter.js", "dist/web-tree-sitter.js"],
        .["vendor/web-tree-sitter/web-tree-sitter.wasm", "dist/web-tree-sitter.wasm"],
        .["vendor/web-tree-sitter/LICENSE", "dist/web-tree-sitter.LICENSE"],
    ];
    for asset: assets {
        if !(asset[0]).os_fs_copy_file(asset[1], true) {
            print("manual built, but % could not be staged\n", asset[0]);
            return false;
        }
    }
    print("built the searchable manual and staged its browser assets in dist/\n");
    return true;
}

manual_task_usage :: () {
    print(#string
        \\usage: glosso first.glo -- <command> [arguments]
        \\
        \\commands:
        \\  build                    build main.glo and stage dist
        \\  tree-sitter              embed tree-sitter/highlights.scm in app.js
        \\  gen-reference <std-dir>  regenerate reference data from a Glosso std directory
        \\
    );
}

run_manual_task :: () {
    set_build_options_dc(.do_output = false);
    args := get_cmdline_args();
    if args.count == 0 {
        manual_task_usage();
        exit(1);
    }
    command := args[0];

    if command == {
    case "build"; if !build_manual() exit(1); return;
    case "tree-sitter"; if !sync_tree_sitter() exit(1); return;
    case "gen-reference";
        if args.count < 2 {
            print("gen-reference requires a standard-library directory\n\n");
            manual_task_usage();
            exit(1);
        }
        if !run_reference_generator(args[1]) exit(1);
        return;
    else;
        print("unknown manual task: %\n\n", command);
        manual_task_usage();
        exit(1);
    }
}

#comptime run_manual_task();
main :: () {}

#import "Io";
#import "Typeclass/Error";
#import "Compiler";
#import "Os";
#import "Process/Command";
#import "File_System/Types";
#import "File_System/File";
#import "File_System/System";

#load,embed "scripts/tree_sitter.glo";
