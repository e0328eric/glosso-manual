// The complete build entry point. main.glo loads the manual sources from src/.
#import "Io";
#import "Compiler";
#import "File_System";
#import "Os";
#import "Process/Command";

#load "scripts/tree_sitter.glo";

append_reference_text :: (path: string, text: string) -> bool {
    opened := append_file(path);
    if result_is_err(opened) return false;
    file := opened.Ok;
    wrote := write(file, text);
    closed := close_file(file);
    return result_is_ok(wrote) && wrote.Ok == text.count &&
        result_is_ok(closed);
}

append_generated_part :: (output_path: string, part_path: string) -> bool {
    loaded := read_file(part_path, 8 * 1024 * 1024);
    if loaded == {
        case .Err;
            print("could not read generated reference part %\n", part_path);
            return false;
        case .Ok;
            return append_reference_text(output_path, loaded.Ok);
    }
}

assemble_reference_parts :: () -> bool {
    glo_parts := .[
        "build/reference-glo-header.part",
        "build/reference-modules.glo.part",
        "build/reference-glo-after-modules.part",
        "build/reference-symbols.glo.part",
        "build/reference-glo-after-symbols.part",
        "build/reference-details.glo.part",
        "build/reference-glo-after-details.part",
        "build/reference-members.glo.part",
        "build/reference-glo-after-members.part",
        "build/reference-instances.glo.part",
        "build/reference-glo-footer.part",
    ];
    initialized_glo := write_file("src/generated/std_reference.glo", "");
    if result_is_err(initialized_glo) return false;
    for path: glo_parts {
        if !append_generated_part("src/generated/std_reference.glo", path)
            return false;
    }

    initialized_js := write_file(
        "reference-index.js",
        "// Generated by `glosso first.glo -- gen-reference`. Do not edit by hand.\nexport const referenceIndex = {\"modules\":[",
    );
    if result_is_err(initialized_js) return false;
    if !append_generated_part("reference-index.js", "build/reference-modules.js.part") return false;
    if !append_reference_text("reference-index.js", "],\"symbols\":[") return false;
    if !append_generated_part("reference-index.js", "build/reference-symbols.js.part") return false;
    if !append_reference_text("reference-index.js", "],\"manual\":[") return false;
    if !append_generated_part("reference-index.js", "build/reference-manual.js.part") return false;
    if !append_reference_text("reference-index.js", "]};\n") return false;

    return true;
}

run_reference_generator :: (snapshot: string) -> bool {
    if !os_fs_is_directory("build") &&
       !os_fs_create_directories("build") {
        print("could not create build\n");
        return false;
    }
    generator := "build/generate-reference";
    #if OUT.os == Target_OS.Windows
        generator = "build/generate-reference.exe";

    options: Compile_Options;
    set_optimization_level(*options, 1);
    set_borrow_check(*options, Compiler_Borrow_Check.Warning);
    set_temp_allocator_size(*options, 256 * 1024 * 1024);
    built := compile("scripts/generate-reference.glo", generator, options);
    if !built.ok {
        print("reference generator build failed:\n%", built.output);
        return false;
    }

    command := command_make(generator);
    command_add_argument(*command, snapshot);
    generated := command_run(command);
    command_destroy(*command);
    if result_is_err(generated) {
        print("could not run the reference generator\n");
        return false;
    }
    if !generated.Ok.status.exited || generated.Ok.status.code != 0 return false;
    return assemble_reference_parts();
}

build_manual :: () {
    if !os_fs_is_directory("dist") && !os_fs_create_directories("dist") {
        print("could not create dist\n");
        return;
    }

    wasm_target := Output_Target.{
        .os = Target_OS.Wasm,
        .cpu = Target_CPU.Wasm32,
        .abi = Target_ABI.Freestanding,
    };
    cache_arg := str_cat("--cache-dir=", absolute("build/cache"));

    options: Compile_Options;
    set_target(*options, wasm_target);
    set_optimization_level(*options, 2);
    set_borrow_check(*options, Compiler_Borrow_Check.Error);
    set_temp_allocator_size(*options, 1024 * 1024);
    add_compiler_arg(*options, cache_arg);
    add_linker_arg(*options, "--export=__heap_base");
    add_linker_arg(*options, "--export=glo_manual_set_view");
    add_linker_arg(*options, "--export=glo_manual_select_section");
    add_linker_arg(*options, "--export=glo_manual_select_module");
    add_linker_arg(*options, "--export=glo_manual_set_search_results");
    add_linker_arg(*options, "--export=glo_manual_get_view");
    add_linker_arg(*options, "--export=glo_manual_get_section");
    add_linker_arg(*options, "--export=glo_manual_get_module");
    add_linker_arg(*options, "--allow-undefined");
    add_linker_arg(*options, "--initial-memory=134217728");
    add_linker_arg(*options, "--max-memory=268435456");
    built := compile("main.glo", "dist/manual.wasm", options);
    if !built.ok {
        print("manual build failed:\n%", built.output);
        return;
    }

    if !os_fs_copy_file("index.html", "dist/index.html", true) {
        print("manual built, but index.html could not be staged\n");
        return;
    }
    assets := .[
        .["app.js", "dist/app.js"],
        .["reference-index.js", "dist/reference-index.js"],
        .["tree-sitter/tree-sitter-glosso.wasm", "dist/tree-sitter-glosso.wasm"],
        .["tree-sitter/highlights.scm", "dist/highlights.scm"],
        .["vendor/web-tree-sitter/web-tree-sitter.js", "dist/web-tree-sitter.js"],
        .["vendor/web-tree-sitter/web-tree-sitter.wasm", "dist/web-tree-sitter.wasm"],
        .["vendor/web-tree-sitter/LICENSE", "dist/web-tree-sitter.LICENSE"],
    ];
    for asset: assets {
        if !os_fs_copy_file(asset[0], asset[1], true) {
            print("manual built, but % could not be staged\n", asset[0]);
            return;
        }
    }
    print("built the searchable manual and staged its browser assets in dist/\n");
}

manual_task_usage :: () {
    print(#string
        \\usage: glosso first.glo -- <command> [arguments]
        \\
        \\commands:
        \\  build                    build main.glo and stage dist
        \\  tree-sitter              embed tree-sitter/highlights.scm in app.js
        \\  gen-reference [snapshot] generate the Glosso and browser reference data
    );
}

run_manual_task :: () {
    set_build_options_dc(.do_output = false);
    args := get_cmdline_args();
    if args.count == 0 {
        manual_task_usage();
        exit(1);
    }
    command := args[0];
    
    if command == {
    case "build"; build_manual(); return;
    case "tree-sitter"; if !sync_tree_sitter() exit(1); return;
    case "gen-reference";
        snapshot := "../glosso-manual-old/src/generated/docs.ts";
        if args.count > 1 snapshot = args[1];
        if !run_reference_generator(snapshot) exit(1);
        return;
    else;
        print("unknown manual task: %\n\n", command);
        manual_task_usage();
        exit(1);
    }
}

#comptime run_manual_task();
main :: () {}
