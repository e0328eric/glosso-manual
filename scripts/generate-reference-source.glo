// Extract public standard-library declarations into the compact reference
// generator's JSON transport. This is intentionally implemented in Glosso.

Reference_Parameter :: struct {
    name: string;
    value_type: string;
    default_value: string;
    modifiers: [..]string;
    constraints: [..]string;
}

Reference_Memory_Contract :: struct {
    effect: string;
    arguments: [..]string;
}

Reference_Function :: struct {
    parameters: [..]Reference_Parameter;
    return_type: string;
    memory_contracts: [..]Reference_Memory_Contract;
    where_clauses: [..]string;
}

Reference_Type_Field :: struct {
    name: string;
    value_type: string;
    default_value: string;
    modifiers: [..]string;
}

Reference_Type_Variant :: struct {
    name: string;
    variant_type: string;
    value: string;
}

Reference_Type_Info :: struct {
    kind: string;
    fields: [..]Reference_Type_Field;
    variants: [..]Reference_Type_Variant;
}

Reference_Member :: struct {
    name: string;
    kind: string;
    signature: string;
    display_signature: string;
    summary: string;
    source_path: string;
    source_line: ssize;
    has_default: bool;
    function_info: Reference_Function;
}

Reference_Class_Info :: struct {
    minimal: string;
    minimal_explicit: bool;
    members: [..]Reference_Member;
}

Reference_Symbol :: struct {
    name: string;
    kind: string;
    signature: string;
    display_signature: string;
    searchable_signature: string;
    summary: string;
    source_path: string;
    source_line: ssize;
    owner_typeclass: string;
    has_default: bool;
    function_info: Reference_Function;
    type_info: Reference_Type_Info;
    class_info: Reference_Class_Info;
}

Reference_Instance :: struct {
    class_name: string;
    head: string;
    module: string;
    signature: string;
    summary: string;
    source_path: string;
    source_line: ssize;
    negative: bool;
}

Reference_Module :: struct {
    name: string;
    summary: string;
    source_path: string;
    symbols: [..]Reference_Symbol;
}

Reference_Header :: struct {
    text: string;
    terminator: u8;
    terminator_index: ssize;
}

// Explicit transport serializers keep extraction independent of compile-time
// formatting used by the standard Serialize derive.
Reference_Parameter ::: instance Serialize {
    serialize :: (value: Reference_Parameter) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "name", .value = serialize(value.name) });
        fields.add(.{ .name = "value_type", .value = serialize(value.value_type) });
        fields.add(.{ .name = "default_value", .value = serialize(value.default_value) });
        fields.add(.{ .name = "modifiers", .value = serialize(value.modifiers) });
        fields.add(.{ .name = "constraints", .value = serialize(value.constraints) });
        return ("Reference_Parameter").serialization_structure_value(fields);
    }
}

Reference_Memory_Contract ::: instance Serialize {
    serialize :: (value: Reference_Memory_Contract) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "effect", .value = serialize(value.effect) });
        fields.add(.{ .name = "arguments", .value = serialize(value.arguments) });
        return ("Reference_Memory_Contract").serialization_structure_value(fields);
    }
}

Reference_Function ::: instance Serialize {
    serialize :: (value: Reference_Function) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "parameters", .value = serialize(value.parameters) });
        fields.add(.{ .name = "return_type", .value = serialize(value.return_type) });
        fields.add(.{ .name = "memory_contracts", .value = serialize(value.memory_contracts) });
        fields.add(.{ .name = "where_clauses", .value = serialize(value.where_clauses) });
        return ("Reference_Function").serialization_structure_value(fields);
    }
}

Reference_Type_Field ::: instance Serialize {
    serialize :: (value: Reference_Type_Field) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "name", .value = serialize(value.name) });
        fields.add(.{ .name = "value_type", .value = serialize(value.value_type) });
        fields.add(.{ .name = "default_value", .value = serialize(value.default_value) });
        fields.add(.{ .name = "modifiers", .value = serialize(value.modifiers) });
        return ("Reference_Type_Field").serialization_structure_value(fields);
    }
}

Reference_Type_Variant ::: instance Serialize {
    serialize :: (value: Reference_Type_Variant) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "name", .value = serialize(value.name) });
        fields.add(.{ .name = "variant_type", .value = serialize(value.variant_type) });
        fields.add(.{ .name = "value", .value = serialize(value.value) });
        return ("Reference_Type_Variant").serialization_structure_value(fields);
    }
}

Reference_Type_Info ::: instance Serialize {
    serialize :: (value: Reference_Type_Info) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "kind", .value = serialize(value.kind) });
        fields.add(.{ .name = "fields", .value = serialize(value.fields) });
        fields.add(.{ .name = "variants", .value = serialize(value.variants) });
        return ("Reference_Type_Info").serialization_structure_value(fields);
    }
}

Reference_Member ::: instance Serialize {
    serialize :: (value: Reference_Member) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "name", .value = serialize(value.name) });
        fields.add(.{ .name = "kind", .value = serialize(value.kind) });
        fields.add(.{ .name = "signature", .value = serialize(value.signature) });
        fields.add(.{ .name = "display_signature", .value = serialize(value.display_signature) });
        fields.add(.{ .name = "summary", .value = serialize(value.summary) });
        fields.add(.{ .name = "source_path", .value = serialize(value.source_path) });
        fields.add(.{ .name = "source_line", .value = serialize(value.source_line) });
        fields.add(.{ .name = "has_default", .value = serialize(value.has_default) });
        fields.add(.{ .name = "function_info", .value = serialize(value.function_info) });
        return ("Reference_Member").serialization_structure_value(fields);
    }
}

Reference_Class_Info ::: instance Serialize {
    serialize :: (value: Reference_Class_Info) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "minimal", .value = serialize(value.minimal) });
        fields.add(.{ .name = "minimal_explicit", .value = serialize(value.minimal_explicit) });
        fields.add(.{ .name = "members", .value = serialize(value.members) });
        return ("Reference_Class_Info").serialization_structure_value(fields);
    }
}

Reference_Symbol ::: instance Serialize {
    serialize :: (value: Reference_Symbol) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "name", .value = serialize(value.name) });
        fields.add(.{ .name = "kind", .value = serialize(value.kind) });
        fields.add(.{ .name = "signature", .value = serialize(value.signature) });
        fields.add(.{ .name = "display_signature", .value = serialize(value.display_signature) });
        fields.add(.{ .name = "searchable_signature", .value = serialize(value.searchable_signature) });
        fields.add(.{ .name = "summary", .value = serialize(value.summary) });
        fields.add(.{ .name = "source_path", .value = serialize(value.source_path) });
        fields.add(.{ .name = "source_line", .value = serialize(value.source_line) });
        fields.add(.{ .name = "owner_typeclass", .value = serialize(value.owner_typeclass) });
        fields.add(.{ .name = "has_default", .value = serialize(value.has_default) });
        fields.add(.{ .name = "function_info", .value = serialize(value.function_info) });
        fields.add(.{ .name = "type_info", .value = serialize(value.type_info) });
        fields.add(.{ .name = "class_info", .value = serialize(value.class_info) });
        return ("Reference_Symbol").serialization_structure_value(fields);
    }
}

Reference_Module ::: instance Serialize {
    serialize :: (value: Reference_Module) -> Serialization_Value {
        fields: [..]Serialization_Field;
        fields.add(.{ .name = "name", .value = serialize(value.name) });
        fields.add(.{ .name = "summary", .value = serialize(value.summary) });
        fields.add(.{ .name = "source_path", .value = serialize(value.source_path) });
        fields.add(.{ .name = "symbols", .value = serialize(value.symbols) });
        return ("Reference_Module").serialization_structure_value(fields);
    }
}

reference_copy_string :: (value: string) -> string {
    return value.clone();
}

reference_is_space :: (byte: u8) -> bool {
    return byte == cast(u8)(#char " ") || byte == cast(u8)(#char "\t") ||
        byte == cast(u8)(#char "\r") || byte == cast(u8)(#char "\n") ||
        byte == 11 || byte == 12;
}

reference_is_identifier_start :: (byte: u8) -> bool {
    return byte == cast(u8)(#char "_") ||
        (byte >= cast(u8)(#char "A") && byte <= cast(u8)(#char "Z")) ||
        (byte >= cast(u8)(#char "a") && byte <= cast(u8)(#char "z")) || byte >= 128;
}

reference_is_identifier_continue :: (byte: u8) -> bool {
    return reference_is_identifier_start(byte) ||
        (byte >= cast(u8)(#char "0") && byte <= cast(u8)(#char "9"));
}

// The public UTF-8 search API now returns `?ssize` and character-oriented
// searches accept `u8`/`rune`. Reference extraction deliberately works in
// byte offsets because every slice below indexes the original source text.
// Keep the old sentinel-shaped operation local instead of repeatedly
// unpacking an option at every scanner call site.
reference_index_of_byte_from :: (
    value: string,
    needle: u8,
    start: ssize,
) -> ssize {
    i := start;
    if i < 0 i = 0;
    while i < value.count {
        if value[i] == needle return i;
        i += 1;
    }
    return -1;
}

reference_index_of_byte :: (value: string, needle: u8) -> ssize {
    return reference_index_of_byte_from(value, needle, 0);
}

reference_index_of :: (
    value: string,
    needle: string,
    start: ssize = 0,
) -> ssize {
    if needle.count == 0 return 0;
    i := start;
    if i < 0 i = 0;
    last := value.count - needle.count;
    while i <= last {
        j: ssize = 0;
        while j < needle.count && value[i + j] == needle[j] j += 1;
        if j == needle.count return i;
        i += 1;
    }
    return -1;
}

reference_normalize_space :: (value: string) -> string {
    out := String_Builder.make_len_cap(0, value.count);
    pending := false;
    wrote := false;
    for i: 0..value.count {
        byte := value[i];
        if reference_is_space(byte) {
            if wrote pending = true;
            continue;
        }
        if pending {
            out.write_byte(cast(u8)(#char " "));
            pending = false;
        }
        out.write_byte(byte);
        wrote = true;
    }
    return out.into_string();
}

reference_replace_slashes :: (value: string) -> string {
    out := String_Builder.make_len_cap(0, value.count);
    for i: 0..value.count {
        byte := value[i];
        if byte == cast(u8)(#char "\\") byte = cast(u8)(#char "/");
        out.write_byte(byte);
    }
    return out.into_string();
}

reference_compare_paths :: (left: string, right: string) -> Ordering {
    count := left.count;
    if right.count < count count = right.count;
    for i: 0..count {
        if left[i] != right[i] return left[i] <=> right[i];
    }
    return left.count <=> right.count;
}

reference_collect_paths :: (
    directory_path: string,
    paths: *[..]string,
) -> Fs_Error!ssize {
    entries := directory_path.os_fs_directory_entries();
    for child: entries {
        if child.os_fs_is_directory() {
            _ := reference_collect_paths(child, paths)?;
        } else if child.os_fs_is_regular_file() && child.ends_with(".glo") {
            paths.add(reference_copy_string(child));
        }
    }
    return .Ok(cast(ssize)0);
}

reference_module_name :: (std_directory: string, path: string) -> string {
    root := reference_replace_slashes(std_directory);
    normalized := reference_replace_slashes(path);
    start := 0;
    if normalized.starts_with(root) {
        start = root.count;
        while start < normalized.count && normalized[start] == cast(u8)(#char "/") start += 1;
    }
    end := normalized.count;
    if end >= 4 && normalized[end - 4..end] == ".glo" end -= 4;
    name := normalized[start..end];
    if name.ends_with("/module") name = name[0..name.count - 7];
    return reference_copy_string(name);
}

reference_source_path :: (std_directory: string, path: string) -> string {
    normalized := reference_replace_slashes(path);
    root := reference_replace_slashes(std_directory);
    start := 0;
    if normalized.starts_with(root) {
        start = root.count;
        while start < normalized.count && normalized[start] == cast(u8)(#char "/") start += 1;
    }
    out := String_Builder.make_len_cap(0, normalized.count - start + 4);
    out.write_string("std/");
    out.write_string(normalized[start..normalized.count]);
    return out.into_string();
}

reference_line_end :: (source: string, start: ssize) -> ssize {
    end := reference_index_of_byte_from(source, cast(u8)(#char "\n"), start);
    if end < 0 return source.count;
    return end;
}

reference_line_comment_start :: (line: string) -> ssize {
    quote: u8 = 0;
    i := 0;
    while i + 1 < line.count {
        byte := line[i];
        if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") {
            quote = byte;
        } else if byte == cast(u8)(#char "/") && line[i + 1] == cast(u8)(#char "/") {
            return i;
        }
        i += 1;
    }
    return -1;
}

reference_code_line :: (line: string) -> string {
    comment := reference_line_comment_start(line);
    if comment >= 0 return line[0..comment];
    return line;
}

reference_brace_delta :: (line: string) -> ssize {
    code := reference_code_line(line);
    quote: u8 = 0;
    delta: ssize = 0;
    i := 0;
    while i < code.count {
        byte := code[i];
        if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
        else if byte == cast(u8)(#char "{") delta += 1;
        else if byte == cast(u8)(#char "}") delta -= 1;
        i += 1;
    }
    return delta;
}

// Only marked comments are documentation: `///` describes the declaration
// written under it and `//!` describes the file's module. A plain `//` is an
// implementation note that stays out of the reference. A further slash cancels
// the marker, so the `////` rules the std draws above a section read as plain
// comments rather than as documentation for whatever follows them.
REFERENCE_DOC_MARKER :: "///";
REFERENCE_MODULE_DOC_MARKER :: "//!";

reference_is_doc_line :: (line: string, marker: string) -> bool {
    if !line.starts_with(marker) return false;
    if line.count > marker.count && line[marker.count] == cast(u8)(#char "/") return false;
    return true;
}

reference_doc_line_text :: (line: string, marker: string) -> string {
    return line[marker.count..line.count].trim();
}

// The comment block above a declaration is read upwards for its `///` lines.
// An unmarked note inside the block is stepped over rather than ending it, so a
// declaration keeps its documentation however its author interleaves the two.
// A blank line ends the block: prose that far from a declaration belongs to
// whatever stands above the gap, not to the declaration under it.
reference_previous_summary :: (source: string, declaration_start: ssize) -> string {
    cursor := declaration_start;
    while cursor > 0 && (source[cursor - 1] == cast(u8)(#char " ") || source[cursor - 1] == cast(u8)(#char "\t"))
        cursor -= 1;
    if cursor > 0 && source[cursor - 1] == cast(u8)(#char "\n") cursor -= 1;
    pieces: [..]string;
    while cursor > 0 {
        end := cursor;
        if end > 0 && source[end - 1] == cast(u8)(#char "\r") end -= 1;
        start := end;
        while start > 0 && source[start - 1] != cast(u8)(#char "\n") start -= 1;
        line := source[start..end].trim();
        if !line.starts_with("//") break;
        if reference_is_doc_line(line, REFERENCE_DOC_MARKER)
            pieces.add(reference_doc_line_text(line, REFERENCE_DOC_MARKER));
        cursor = start;
        if cursor > 0 cursor -= 1;
    }
    out := String_Builder.make_len_cap(0, pieces.count * 32);
    i := pieces.count;
    while i > 0 {
        i -= 1;
        if out.len() > 0 out.write_byte(cast(u8)(#char " "));
        out.write_string(pieces[i]);
    }
    pieces.free();
    return reference_normalize_space(out.into_string());
}

// `//!` writes the intro of a std file: the summary of the module itself rather
// than of any one declaration. The intro is the comment block the file opens
// with, so reading stops at the first line of code. A licence header or a plain
// note may share the block without changing what the summary says.
reference_module_summary :: (source: string) -> string {
    out := String_Builder.make_len_cap(0, 128);
    cursor: ssize = 0;
    while cursor < source.count {
        end := reference_line_end(source, cursor);
        line := source[cursor..end].trim();
        if line.count > 0 && !line.starts_with("//") break;
        if reference_is_doc_line(line, REFERENCE_MODULE_DOC_MARKER) {
            text := reference_doc_line_text(line, REFERENCE_MODULE_DOC_MARKER);
            if text.count > 0 {
                if out.len() > 0 out.write_byte(cast(u8)(#char " "));
                out.write_string(text);
            }
        }
        cursor = end + 1;
    }
    return reference_normalize_space(out.into_string());
}

reference_header_needs_space :: (out: *String_Builder, byte: u8) -> bool {
    if out.*.buf.count == 0 return false;
    previous := out.*.buf[out.*.buf.count - 1];
    if previous == cast(u8)(#char "(") || previous == cast(u8)(#char "[") return false;
    if byte == cast(u8)(#char ")") || byte == cast(u8)(#char "]") return false;
    return true;
}

reference_header_ends_with :: (out: *String_Builder, suffix: string) -> bool {
    if suffix.count > out.*.buf.count return false;
    start := out.*.buf.count - suffix.count;
    for i: 0..suffix.count if out.*.buf[start + i] != suffix[i] return false;
    return true;
}

reference_header_starts_braced_directive :: (out: *String_Builder) -> bool {
    return reference_header_ends_with(out, "#memory") ||
        reference_header_ends_with(out, "#modify");
}

reference_header :: (source: string, start: ssize) -> Reference_Header {
    out := String_Builder.make_len_cap(0, 256);
    round: ssize = 0;
    square: ssize = 0;
    directive_brace: ssize = 0;
    quote: u8 = 0;
    line_comment := false;
    block_comment := false;
    pending_space := false;
    i := start;
    while i < source.count {
        byte := source[i];
        next: u8 = 0;
        if i + 1 < source.count next = source[i + 1];
        if line_comment {
            if byte == cast(u8)(#char "\n") {
                line_comment = false;
                pending_space = true;
            }
            i += 1;
            continue;
        }
        if block_comment {
            if byte == cast(u8)(#char "*") && next == cast(u8)(#char "/") {
                block_comment = false;
                i += 2;
            } else i += 1;
            pending_space = true;
            continue;
        }
        if quote != 0 {
            out.write_byte(byte);
            if byte == cast(u8)(#char "\\") && i + 1 < source.count {
                i += 1;
                out.write_byte(source[i]);
            } else if byte == quote quote = 0;
            i += 1;
            continue;
        }
        if byte == cast(u8)(#char "/") && next == cast(u8)(#char "/") {
            line_comment = true;
            i += 2;
            continue;
        }
        if byte == cast(u8)(#char "/") && next == cast(u8)(#char "*") {
            block_comment = true;
            i += 2;
            continue;
        }
        if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") {
            if pending_space && reference_header_needs_space(*out, byte)
                out.write_byte(cast(u8)(#char " "));
            pending_space = false;
            quote = byte;
            out.write_byte(byte);
            i += 1;
            continue;
        }
        if byte == cast(u8)(#char "(") round += 1;
        else if byte == cast(u8)(#char ")") round -= 1;
        else if byte == cast(u8)(#char "[") square += 1;
        else if byte == cast(u8)(#char "]") square -= 1;
        else if byte == cast(u8)(#char "{") && directive_brace > 0 {
            directive_brace += 1;
        } else if byte == cast(u8)(#char "{") && round == 0 && square == 0 {
            if reference_header_starts_braced_directive(*out) {
                directive_brace = 1;
            } else {
                return .{
                    .text = (out.into_string()).trim(),
                    .terminator = byte,
                    .terminator_index = i,
                };
            }
        } else if byte == cast(u8)(#char "}") && directive_brace > 0 {
            directive_brace -= 1;
        }
        if round == 0 && square == 0 && directive_brace == 0 && byte == cast(u8)(#char ";") {
            return .{
                .text = (out.into_string()).trim(),
                .terminator = byte,
                .terminator_index = i,
            };
        }
        if reference_is_space(byte) pending_space = true;
        else {
            if pending_space && reference_header_needs_space(*out, byte)
                out.write_byte(cast(u8)(#char " "));
            pending_space = false;
            out.write_byte(byte);
        }
        i += 1;
    }
    return .{
        .text = (out.into_string()).trim(),
        .terminator_index = source.count,
    };
}

reference_top_level_index :: (value: string, needle: u8) -> ssize {
    round: ssize = 0;
    square: ssize = 0;
    brace: ssize = 0;
    quote: u8 = 0;
    i := 0;
    while i < value.count {
        byte := value[i];
        if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
        else if byte == cast(u8)(#char "(") round += 1;
        else if byte == cast(u8)(#char ")") round -= 1;
        else if byte == cast(u8)(#char "[") square += 1;
        else if byte == cast(u8)(#char "]") square -= 1;
        else if byte == cast(u8)(#char "{") brace += 1;
        else if byte == cast(u8)(#char "}") brace -= 1;
        else if byte == needle && round == 0 && square == 0 && brace == 0 return i;
        i += 1;
    }
    return -1;
}

reference_matching_paren :: (value: string, open: ssize) -> ssize {
    depth: ssize = 0;
    quote: u8 = 0;
    i := open;
    while i < value.count {
        byte := value[i];
        if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
        else if byte == cast(u8)(#char "(") depth += 1;
        else if byte == cast(u8)(#char ")") {
            depth -= 1;
            if depth == 0 return i;
        }
        i += 1;
    }
    return -1;
}

reference_matching_brace :: (value: string, open: ssize) -> ssize {
    depth: ssize = 0;
    quote: u8 = 0;
    line_comment := false;
    block_comment := false;
    i := open;
    while i < value.count {
        byte := value[i];
        next: u8 = 0;
        if i + 1 < value.count next = value[i + 1];
        if line_comment {
            if byte == cast(u8)(#char "\n") line_comment = false;
        } else if block_comment {
            if byte == cast(u8)(#char "*") && next == cast(u8)(#char "/") {
                block_comment = false;
                i += 1;
            }
        } else if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "/") && next == cast(u8)(#char "/") {
            line_comment = true;
            i += 1;
        } else if byte == cast(u8)(#char "/") && next == cast(u8)(#char "*") {
            block_comment = true;
            i += 1;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
        else if byte == cast(u8)(#char "{") depth += 1;
        else if byte == cast(u8)(#char "}") {
            depth -= 1;
            if depth == 0 return i;
        }
        i += 1;
    }
    return -1;
}

reference_without_comments :: (value: string) -> string {
    out := String_Builder.make_len_cap(0, value.count);
    quote: u8 = 0;
    line_comment := false;
    block_comment := false;
    i := 0;
    while i < value.count {
        byte := value[i];
        next: u8 = 0;
        if i + 1 < value.count next = value[i + 1];
        if line_comment {
            if byte == cast(u8)(#char "\n") {
                line_comment = false;
                out.write_byte(byte);
            }
        } else if block_comment {
            if byte == cast(u8)(#char "*") && next == cast(u8)(#char "/") {
                block_comment = false;
                i += 1;
            } else if byte == cast(u8)(#char "\n") out.write_byte(byte);
        } else if quote != 0 {
            out.write_byte(byte);
            if byte == cast(u8)(#char "\\") && i + 1 < value.count {
                i += 1;
                out.write_byte(value[i]);
            } else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "/") && next == cast(u8)(#char "/") {
            line_comment = true;
            i += 1;
        } else if byte == cast(u8)(#char "/") && next == cast(u8)(#char "*") {
            block_comment = true;
            i += 1;
        } else {
            if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
            out.write_byte(byte);
        }
        i += 1;
    }
    return out.into_string();
}

reference_aggregate_body_open :: (
    source: string,
    declaration_start: ssize,
    first_open: ssize,
) -> ssize {
    open := first_open;
    while open >= 0 && open < source.count {
        prefix := source[declaration_start..open].trim();
        if !prefix.ends_with("#modify") return open;
        close := reference_matching_brace(source, open);
        if close < 0 return -1;
        open = reference_index_of_byte_from(source, cast(u8)(#char "{"), close + 1);
    }
    return -1;
}

// Aggregate members default to public, with the same nested visibility groups
// as declarations. Preserve initializer braces while flattening visible groups.
reference_public_members :: (body: string, default_public: bool = true) -> string {
    out := String_Builder.make_len_cap(0, body.count);
    cursor: ssize = 0;
    while cursor < body.count {
        while cursor < body.count && reference_is_space(body[cursor]) cursor += 1;
        if cursor >= body.count break;
        tail := body[cursor..body.count];
        visible := default_public;
        prefix: ssize = 0;
        if tail.starts_with("#public(unit)") { visible = false; prefix = 13; }
        else if tail.starts_with("#private ") { visible = false; prefix = 9; }
        else if tail.starts_with("#public ") { visible = true; prefix = 8; }
        if prefix > 0 {
            cursor += prefix;
            while cursor < body.count && reference_is_space(body[cursor]) cursor += 1;
            if cursor < body.count && body[cursor] == cast(u8)(#char "{") {
                close := reference_matching_brace(body, cursor);
                if close < 0 break;
                out.write_string(reference_public_members(body[cursor + 1..close], visible));
                cursor = close + 1;
                continue;
            }
            tail = body[cursor..body.count];
        }
        end := reference_top_level_index(tail, cast(u8)(#char ";"));
        if end < 0 end = tail.count;
        if visible {
            out.write_string(tail[0..end]);
            out.write_string(";");
        }
        cursor += end + 1;
    }
    return out.into_temporary_string();
}

reference_parse_struct_fields :: (body: string, info: *Reference_Type_Info) {
    parts := reference_split_top_level(body, cast(u8)(#char ";"));
    for part: parts {
        value := reference_normalize_space(part);
        if value.count == 0 continue;
        if value.starts_with("#empty") {
            colon := reference_top_level_index(value, cast(u8)(#char ":"));
            if colon < 0 continue;
            types := reference_split_top_level(value[colon + 1..value.count]);
            for raw_type: types {
                field: Reference_Type_Field = .{
                    .name = "#empty",
                    .value_type = reference_copy_string(raw_type.trim()),
                };
                field.modifiers.add("empty type witness");
                info.*.fields.add(field);
            }
            continue;
        }
        modifiers: [..]string;
        while value.starts_with("using ") || value.starts_with("#as ") {
            space := reference_index_of_byte(value, cast(u8)(#char " "));
            modifiers.add(reference_copy_string(value[0..space]));
            value = reference_copy_string(value[space + 1..value.count].trim());
        }
        colon := reference_top_level_index(value, cast(u8)(#char ":"));
        if colon < 0 continue;
        name := value[0..colon].trim();
        value_type := value[colon + 1..value.count].trim();
        default_value := "";
        equal := reference_top_level_index(value_type, cast(u8)(#char "="));
        if equal >= 0 {
            default_value = value_type[equal + 1..value_type.count].trim();
            value_type = value_type[0..equal].trim();
        }
        if name.count > 0 && value_type.count > 0 {
            field: Reference_Type_Field = .{
                .name = reference_copy_string(name),
                .value_type = reference_copy_string(value_type),
                .default_value = reference_copy_string(default_value),
                .modifiers = modifiers,
            };
            info.*.fields.add(field);
        }
    }
}

reference_parse_union_variants :: (body: string, info: *Reference_Type_Info) {
    parts := reference_split_top_level(body, cast(u8)(#char ";"));
    for part: parts {
        value := reference_normalize_space(part);
        colon := reference_top_level_index(value, cast(u8)(#char ":"));
        if colon < 0 continue;
        name := value[0..colon].trim();
        variant_type := value[colon + 1..value.count].trim();
        if name.count > 0 && variant_type.count > 0 {
            info.*.variants.add(Reference_Type_Variant.{
                .name = reference_copy_string(name),
                .variant_type = reference_copy_string(variant_type),
            });
        }
    }
}

reference_parse_enum_variants :: (body: string, info: *Reference_Type_Info) {
    parts := reference_split_top_level(body, cast(u8)(#char ";"));
    for part: parts {
        variant := reference_normalize_space(part);
        if variant.count == 0 continue;
        separator := reference_index_of(variant, "::");
        name := variant;
        value := "";
        if separator >= 0 {
            name = variant[0..separator].trim();
            value = variant[separator + 2..variant.count].trim();
        }
        if name.count > 0 {
            info.*.variants.add(Reference_Type_Variant.{
                .name = reference_copy_string(name),
                .value = reference_copy_string(value),
            });
        }
    }
}

reference_type_info :: (
    definition: string,
    source: string,
    declaration_start: ssize,
    first_open: ssize,
) -> Reference_Type_Info {
    info: Reference_Type_Info;
    if definition.starts_with("struct") info.kind = "struct";
    else if definition.starts_with("union") info.kind = "union";
    else if definition.starts_with("enum_flags") info.kind = "enum_flags";
    else if definition.starts_with("enum") info.kind = "enum";
    else if definition.starts_with("#fn_ptr") {
        info.kind = "function-pointer";
        return info;
    }
    else return info;
    open := reference_aggregate_body_open(source, declaration_start, first_open);
    if open < 0 return info;
    close := reference_matching_brace(source, open);
    if close < 0 return info;
    body := reference_public_members(reference_without_comments(source[open + 1..close]));
    if info.kind == "struct" reference_parse_struct_fields(body, *info);
    else if info.kind == "union" reference_parse_union_variants(body, *info);
    else reference_parse_enum_variants(body, *info);
    return info;
}

reference_split_top_level :: (value: string, delimiter: u8 = cast(u8)(#char ",")) -> [..]string {
    parts: [..]string;
    start: ssize = 0;
    round: ssize = 0;
    square: ssize = 0;
    brace: ssize = 0;
    quote: u8 = 0;
    i := 0;
    while i < value.count {
        byte := value[i];
        if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
        else if byte == cast(u8)(#char "(") round += 1;
        else if byte == cast(u8)(#char ")") round -= 1;
        else if byte == cast(u8)(#char "[") square += 1;
        else if byte == cast(u8)(#char "]") square -= 1;
        else if byte == cast(u8)(#char "{") brace += 1;
        else if byte == cast(u8)(#char "}") brace -= 1;
        else if byte == delimiter && round == 0 && square == 0 && brace == 0 {
            part := value[start..i].trim();
            if part.count > 0 parts.add(part);
            start = i + 1;
        }
        i += 1;
    }
    part := value[start..value.count].trim();
    if part.count > 0 parts.add(part);
    return parts;
}

reference_parse_parameter :: (raw: string) -> Reference_Parameter {
    parameter: Reference_Parameter;
    value := raw.trim();
    while value.starts_with("using ") || value.starts_with("noalias ") ||
          value.starts_with("#comptime ") || value.starts_with("#lazy ") {
        space := reference_index_of_byte(value, cast(u8)(#char " "));
        modifier := value[0..space];
        if modifier.starts_with("#") modifier = modifier[1..modifier.count];
        parameter.modifiers.add(reference_copy_string(modifier));
        value = value[space + 1..value.count].trim();
    }
    equal := reference_top_level_index(value, cast(u8)(#char "="));
    if equal >= 0 {
        parameter.default_value = reference_copy_string(value[equal + 1..value.count].trim());
        value = value[0..equal].trim();
    }
    colon := reference_top_level_index(value, cast(u8)(#char ":"));
    if colon >= 0 {
        parameter.name = reference_copy_string(value[0..colon].trim());
        parameter.value_type = reference_copy_string(value[colon + 1..value.count].trim());
    } else {
        parameter.name = reference_copy_string(value);
        parameter.value_type = reference_copy_string("any");
    }
    if parameter.name == "#comptime"
        parameter.modifiers.add("comptime");
    else if parameter.name == "#empty"
        parameter.modifiers.add("empty type witness");
    if parameter.value_type.starts_with("...") {
        parameter.modifiers.add("variadic");
        parameter.value_type = reference_copy_string(parameter.value_type[3..parameter.value_type.count].trim());
    }
    return parameter;
}

reference_matches_at :: (value: string, offset: ssize, needle: string) -> bool {
    if offset < 0 || offset + needle.count > value.count return false;
    for i: 0..needle.count if value[offset + i] != needle[i] return false;
    return true;
}

// Context's checked-in docs still describe the former -O0 allocator default.
// Correct only those exact fragments while the implementation uses the
// GLOSSO_DEBUG_ALLOCATOR switch.  Once upstream wording changes, none of the
// needles match and this becomes an output-preserving no-op.
reference_correct_context_docs :: (module_name: string, value: string) -> string {
    if module_name != "Context" || value.count == 0 return value;
    needles: [5]string = .[
        "`context.allocator` defaults to the debug allocator at -O0 and to the heap allocator otherwise",
        "`context.allocator` set to the debug allocator at -O0 and heap otherwise",
        "`context.allocator` already holds it at -O0, so installing it by hand is only needed to keep tracking at higher optimization levels",
        "automatic report the runtime emits at exit under -O0",
        "compiler's built-in heap, which is the tracking debug allocator in debug builds",
    ];
    replacements: [5]string = .[
        "`context.allocator` defaults to the heap allocator; the `GLOSSO_DEBUG_ALLOCATOR` environment variable selects the debug allocator when set to a nonzero value",
        "`context.allocator` set to the heap allocator unless `GLOSSO_DEBUG_ALLOCATOR` is nonzero",
        "`context.allocator` holds it automatically only when `GLOSSO_DEBUG_ALLOCATOR` is nonzero; otherwise install it explicitly to enable leak tracking",
        "automatic report the runtime emits at exit when `GLOSSO_DEBUG_ALLOCATOR` is nonzero",
        "compiler's built-in allocator, which is the tracking debug allocator only when `GLOSSO_DEBUG_ALLOCATOR` is nonzero and the ordinary heap otherwise",
    ];
    out := String_Builder.make_len_cap(0, value.count + 128);
    cursor: ssize = 0;
    while cursor < value.count {
        matched := false;
        for i: 0..needles.count {
            if !reference_matches_at(value, cursor, needles[i]) continue;
            out.write_string(replacements[i]);
            cursor += needles[i].count;
            matched = true;
            break;
        }
        if matched continue;
        out.write_byte(value[cursor]);
        cursor += 1;
    }
    return out.into_string();
}

reference_find_top_level_word :: (
    value: string,
    word: string,
    start: ssize = 0,
) -> ssize {
    round: ssize = 0;
    square: ssize = 0;
    brace: ssize = 0;
    quote: u8 = 0;
    i := start;
    while i < value.count {
        byte := value[i];
        if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
        else if byte == cast(u8)(#char "(") round += 1;
        else if byte == cast(u8)(#char ")") round -= 1;
        else if byte == cast(u8)(#char "[") square += 1;
        else if byte == cast(u8)(#char "]") square -= 1;
        else if byte == cast(u8)(#char "{") brace += 1;
        else if byte == cast(u8)(#char "}") brace -= 1;
        else if round == 0 && square == 0 && brace == 0 &&
                reference_matches_at(value, i, word) {
            before_ok := i == 0 || !reference_is_identifier_continue(value[i - 1]);
            after := i + word.count;
            after_ok := after == value.count || !reference_is_identifier_continue(value[after]);
            if before_ok && after_ok return i;
        }
        i += 1;
    }
    return -1;
}

reference_split_top_level_and :: (value: string) -> [..]string {
    parts: [..]string;
    start: ssize = 0;
    round: ssize = 0;
    square: ssize = 0;
    brace: ssize = 0;
    quote: u8 = 0;
    i := 0;
    while i < value.count {
        byte := value[i];
        if quote != 0 {
            if byte == cast(u8)(#char "\\") i += 1;
            else if byte == quote quote = 0;
        } else if byte == cast(u8)(#char "\"") || byte == cast(u8)(#char "'") quote = byte;
        else if byte == cast(u8)(#char "(") round += 1;
        else if byte == cast(u8)(#char ")") round -= 1;
        else if byte == cast(u8)(#char "[") square += 1;
        else if byte == cast(u8)(#char "]") square -= 1;
        else if byte == cast(u8)(#char "{") brace += 1;
        else if byte == cast(u8)(#char "}") brace -= 1;
        else if byte == cast(u8)(#char "&") && i + 1 < value.count &&
                value[i + 1] == cast(u8)(#char "&") &&
                round == 0 && square == 0 && brace == 0 {
            part := value[start..i].trim();
            if part.count > 0 parts.add(part);
            i += 1;
            start = i + 1;
        }
        i += 1;
    }
    part := value[start..value.count].trim();
    if part.count > 0 parts.add(part);
    return parts;
}

reference_contains_identifier :: (value: string, identifier: string) -> bool {
    if identifier.count == 0 return false;
    i: ssize = 0;
    while i + identifier.count <= value.count {
        if reference_matches_at(value, i, identifier) {
            before_ok := i == 0 || !reference_is_identifier_continue(value[i - 1]);
            after := i + identifier.count;
            after_ok := after == value.count || !reference_is_identifier_continue(value[after]);
            if before_ok && after_ok return true;
        }
        i += 1;
    }
    return false;
}

reference_parameter_introduces_constraint_type :: (
    parameter: Reference_Parameter,
    constraint: string,
) -> bool {
    value_type := parameter.value_type;
    i: ssize = 0;
    while i + 1 < value_type.count {
        if value_type[i] == cast(u8)(#char "$") && reference_is_identifier_start(value_type[i + 1]) {
            end := i + 2;
            while end < value_type.count && reference_is_identifier_continue(value_type[end])
                end += 1;
            if reference_contains_identifier(constraint, value_type[i + 1..end]) return true;
            i = end;
        } else i += 1;
    }
    return value_type == "type" &&
        reference_contains_identifier(constraint, parameter.name);
}

reference_attach_parameter_constraint :: (
    function: *Reference_Function,
    constraint: string,
) {
    for i: 0..function.*.parameters.count {
        if reference_parameter_introduces_constraint_type(
            function.*.parameters[i], constraint,
        ) function.*.parameters[i].constraints.add(reference_copy_string(constraint),);
    }
}

reference_parse_where_clauses :: (
    tail: string,
    function: *Reference_Function,
) {
    marker := reference_find_top_level_word(tail, "where");
    while marker >= 0 {
        clause_start := marker + 5;
        next := reference_find_top_level_word(tail, "where", clause_start);
        clause_end := tail.count;
        if next >= 0 clause_end = next;
        clause := tail[clause_start..clause_end].trim();
        if clause.count > 0 {
            function.*.where_clauses.add(reference_copy_string(clause));
            constraints := reference_split_top_level_and(clause);
            for constraint: constraints
                reference_attach_parameter_constraint(function, constraint);
            constraints.free();
        }
        if next < 0 break;
        marker = next;
    }
}

reference_return_type :: (tail: string) -> string {
    arrow := reference_index_of(tail, "->");
    if arrow < 0 return "void";
    value := tail[arrow + 2..tail.count].trim();
    directive := reference_top_level_index(value, cast(u8)(#char "#"));
    if directive >= 0 value = value[0..directive].trim();
    where_index := reference_index_of(value, " where ");
    if where_index >= 0 value = value[0..where_index].trim();
    if value.count == 0 return "void";
    return reference_copy_string(value);
}

reference_memory_contract :: (raw: string) -> Reference_Memory_Contract {
    contract: Reference_Memory_Contract;
    value := raw.trim();
    if value.count == 0 return contract;
    open := reference_index_of_byte(value, cast(u8)(#char "("));
    if open < 0 || !value.ends_with(")") {
        contract.effect = reference_copy_string(value);
        return contract;
    }
    contract.effect = reference_copy_string(value[0..open].trim());
    arguments := reference_split_top_level(value[open + 1..value.count - 1]);
    for argument: arguments
        contract.arguments.add(reference_copy_string(argument.trim()));
    return contract;
}

reference_parse_memory_contracts :: (
    tail: string,
    function: *Reference_Function,
) {
    offset: ssize = 0;
    while offset < tail.count {
        marker := reference_find_top_level_word(tail, "#memory", offset);
        if marker < 0 break;
        cursor := marker + 7;
        while cursor < tail.count && reference_is_space(tail[cursor]) cursor += 1;
        raw := "";
        if cursor < tail.count && tail[cursor] == cast(u8)(#char "(") {
            close := reference_matching_paren(tail, cursor);
            if close < 0 break;
            raw = tail[cursor + 1..close];
            offset = close + 1;
        } else if cursor < tail.count && tail[cursor] == cast(u8)(#char "{") {
            close := reference_matching_brace(tail, cursor);
            if close < 0 break;
            raw = tail[cursor + 1..close];
            offset = close + 1;
        } else {
            end := cursor;
            while end < tail.count && reference_is_identifier_continue(tail[end]) end += 1;
            if end == cursor break;
            argument_open := end;
            while argument_open < tail.count && reference_is_space(tail[argument_open])
                argument_open += 1;
            if argument_open < tail.count && tail[argument_open] == cast(u8)(#char "(") {
                close := reference_matching_paren(tail, argument_open);
                if close < 0 break;
                raw = tail[cursor..close + 1];
                offset = close + 1;
            } else {
                raw = tail[cursor..end];
                offset = end;
            }
        }
        parts := reference_split_top_level(raw);
        for part: parts {
            contract := reference_memory_contract(part);
            if contract.effect.count > 0
                function.*.memory_contracts.add(contract);
        }
    }
}

reference_memory_directive_end :: (value: string, marker: ssize) -> ssize {
    cursor := marker + 7;
    while cursor < value.count && reference_is_space(value[cursor]) cursor += 1;
    if cursor < value.count && value[cursor] == cast(u8)(#char "(") {
        close := reference_matching_paren(value, cursor);
        if close >= 0 return close + 1;
        return marker;
    }
    if cursor < value.count && value[cursor] == cast(u8)(#char "{") {
        close := reference_matching_brace(value, cursor);
        if close >= 0 return close + 1;
        return marker;
    }
    end := cursor;
    while end < value.count && reference_is_identifier_continue(value[end]) end += 1;
    if end == cursor return marker;
    argument_open := end;
    while argument_open < value.count && reference_is_space(value[argument_open])
        argument_open += 1;
    if argument_open < value.count && value[argument_open] == cast(u8)(#char "(") {
        close := reference_matching_paren(value, argument_open);
        if close >= 0 return close + 1;
        return marker;
    }
    return end;
}

reference_display_decorations :: (value: string) -> string {
    out := String_Builder.make_len_cap(0, value.count);
    cursor: ssize = 0;
    while cursor < value.count {
        memory := reference_find_top_level_word(value, "#memory", cursor);
        modify := reference_find_top_level_word(value, "#modify", cursor);
        marker := memory;
        is_memory := true;
        if marker < 0 || (modify >= 0 && modify < marker) {
            marker = modify;
            is_memory = false;
        }
        if marker < 0 {
            out.write_string(value[cursor..value.count]);
            break;
        }
        out.write_string(value[cursor..marker]);
        if is_memory {
            end := reference_memory_directive_end(value, marker);
            if end <= marker {
                cursor = marker + 7;
            } else cursor = end;
            continue;
        }
        out.write_string("#modify");
        after := marker + 7;
        while after < value.count && reference_is_space(value[after]) after += 1;
        if after < value.count && value[after] == cast(u8)(#char "{") {
            close := reference_matching_brace(value, after);
            if close < 0 break;
            cursor = close + 1;
        } else cursor = marker + 7;
    }
    return reference_normalize_space(out.into_string());
}

reference_function_info :: (right: string) -> Reference_Function {
    function: Reference_Function;
    open := reference_index_of_byte(right, cast(u8)(#char "("));
    if open < 0 return function;
    close := reference_matching_paren(right, open);
    if close < 0 return function;
    parts := reference_split_top_level(right[open + 1..close]);
    for part: parts function.parameters.add(reference_parse_parameter(part));
    parts.free();
    tail := right[close + 1..right.count];
    function.return_type = reference_return_type(tail);
    reference_parse_memory_contracts(tail, *function);
    reference_parse_where_clauses(tail, *function);
    return function;
}

reference_display_signature :: (
    name: string,
    right: string,
    function: Reference_Function,
) -> string {
    open := reference_index_of_byte(right, cast(u8)(#char "("));
    if open < 0 return "";
    close := reference_matching_paren(right, open);
    if close < 0 return "";
    out := String_Builder.make_len_cap(0, name.count + close + 24);
    out.write_string(name);
    if right.starts_with("#fn_ptr") out.write_string(" :: #fn_ptr(");
    else out.write_string(" :: (");
    parts := reference_split_top_level(right[open + 1..close]);
    for i: 0..parts.count {
        if i > 0 out.write_string(", ");
        out.write_string(parts[i]);
    }
    parts.free();
    out.write_byte(cast(u8)(#char ")"));
    tail := right[close + 1..right.count];
    arrow := reference_index_of(tail, "->");
    decoration_start: ssize = 0;
    if arrow >= 0 {
        out.write_string(" -> ");
        out.write_string(function.return_type);
        return_start := arrow + 2;
        while return_start < tail.count && reference_is_space(tail[return_start])
            return_start += 1;
        decoration_start = return_start + function.return_type.count;
    }
    decoration_end := tail.count;
    where_marker := reference_find_top_level_word(tail, "where");
    if where_marker >= 0 decoration_end = where_marker;
    if decoration_start < decoration_end {
        decorations := reference_display_decorations(
            tail[decoration_start..decoration_end],
        );
        if decorations.count > 0 {
            out.write_byte(cast(u8)(#char " "));
            out.write_string(decorations);
        }
    }
    return out.into_string();
}

reference_searchable_signature :: (function: Reference_Function) -> string {
    out := String_Builder.make_len_cap(0, 64);
    out.write_byte(cast(u8)(#char "("));
    wrote := false;
    for parameter: function.parameters {
        skip := false;
        variadic := false;
        for modifier: parameter.modifiers {
            if modifier == "comptime" || modifier == "empty type witness" skip = true;
            if modifier == "variadic" variadic = true;
        }
        if skip continue;
        if wrote out.write_string(", ");
        if variadic out.write_string("...");
        value_type := parameter.value_type;
        if value_type.count == 0 value_type = "any";
        out.write_string(value_type);
        wrote = true;
    }
    out.write_string(") -> ");
    out.write_string(function.return_type);
    return out.into_string();
}

reference_find_module :: (modules: *[..]Reference_Module, name: string) -> ssize {
    for i: 0..modules.*.count if modules.*[i].name == name return i;
    return -1;
}

reference_find_typeclass :: (module: *Reference_Module, name: string) -> ssize {
    for i: 0..module.*.symbols.count {
        symbol := module.*.symbols[i];
        if symbol.kind == "typeclass" && symbol.name == name return i;
    }
    return -1;
}

reference_add_typeclass_member :: (
    module: *Reference_Module,
    owner: string,
    symbol: Reference_Symbol,
) {
    index := reference_find_typeclass(module, owner);
    if index < 0 return;
    member: Reference_Member = .{
        .name = reference_copy_string(symbol.name),
        .kind = "method",
        .signature = reference_copy_string(symbol.signature),
        .display_signature = reference_copy_string(symbol.display_signature),
        .summary = reference_copy_string(symbol.summary),
        .source_path = reference_copy_string(symbol.source_path),
        .source_line = symbol.source_line,
        .has_default = symbol.has_default,
        .function_info = symbol.function_info,
    };
    module.*.symbols[index].class_info.members.add(member);
}

reference_add_associated_member :: (
    module: *Reference_Module,
    owner: string,
    name: string,
    annotation: string,
    summary: string,
    source_path: string,
    source_line: ssize,
) {
    index := reference_find_typeclass(module, owner);
    if index < 0 return;
    signature_builder := String_Builder.make_len_cap(0, name.count + annotation.count + 4);
    signature_builder.write_string(name);
    signature_builder.write_string(" :: ");
    signature_builder.write_string(annotation);
    member: Reference_Member = .{
        .name = reference_copy_string(name),
        .kind = "associated-type",
        .signature = reference_copy_string(signature_builder.into_string()),
        .summary = reference_copy_string(summary),
        .source_path = reference_copy_string(source_path),
        .source_line = source_line,
    };
    module.*.symbols[index].class_info.members.add(member);
}

reference_finalize_typeclasses :: (module: *Reference_Module) {
    for i: 0..module.*.symbols.count {
        symbol := module.*.symbols[i];
        if symbol.kind != "typeclass" || symbol.class_info.minimal_explicit continue;
        out := String_Builder.make_len_cap(0, 64);
        wrote := false;
        for member: symbol.class_info.members {
            if member.kind != "method" || member.has_default continue;
            if wrote out.write_string(", ");
            if member.signature.starts_with("'") {
                out.write_byte(cast(u8)(#char "'"));
                out.write_string(member.name);
                out.write_byte(cast(u8)(#char "'"));
            } else out.write_string(member.name);
            wrote = true;
        }
        symbol.class_info.minimal = out.into_string();
        module.*.symbols[i] = symbol;
    }
}

reference_builtin_type_alias :: (name: string) -> bool {
    return name == "any" || name == "bool" ||
        name == "rune" || name == "ssize" || name == "usize" ||
        name == "s8" || name == "s16" || name == "s32" ||
        name == "s64" || name == "s128" || name == "u8" ||
        name == "u16" || name == "u32" || name == "u64" ||
        name == "u128" || name == "f16" || name == "f32" ||
        name == "f64" || name == "f80" || name == "f128" ||
        name == "c32" || name == "c64" || name == "c128" ||
        name == "c160" || name == "c256" || name == "string" ||
        name == "cstring" || name == "string16" ||
        name == "cstring16" || name == "type" || name == "void" ||
        name == "Code" || name == "label" || name == "Namespace" ||
        name == "Library" || name == "Macro" || name == "Typeclass";
}

reference_alias_target :: (signature: string) -> string {
    separator := reference_index_of(signature, "::");
    if separator < 0 return "";
    target := signature[separator + 2..signature.count].trim();
    if target.count == 0 || !reference_is_identifier_start(target[0])
        return "";
    for i: 1..target.count
        if !reference_is_identifier_continue(target[i]) return "";
    return target;
}

// A declaration such as `array_append :: array_add` is a procedure alias,
// while `Process_Id :: s64` is a type alias.  They have no syntactic body of
// their own, so resolve their category and callable details after every module
// has been scanned.  This keeps aliases beside what they denote in the
// reference and carries the target's parameter, constraint, and memory rows.
reference_resolve_aliases :: (modules: *[..]Reference_Module) {
    changed := true;
    passes: ssize = 0;
    while changed && passes < 16 {
        changed = false;
        passes += 1;
        for module_index: 0..modules.*.count {
            module := *modules.*[module_index];
            for symbol_index: 0..module.*.symbols.count {
                symbol := module.*.symbols[symbol_index];
                if symbol.kind != "constant" continue;
                target_name := reference_alias_target(symbol.signature);
                if target_name.count == 0 continue;
                if reference_builtin_type_alias(target_name) {
                    symbol.kind = "type";
                    module.*.symbols[symbol_index] = symbol;
                    changed = true;
                    continue;
                }
                found := false;
                target: Reference_Symbol;
                ambiguous := false;
                for candidate_module: modules.* {
                    for candidate: candidate_module.symbols {
                        if candidate.name != target_name ||
                           candidate.kind == "constant" continue;
                        if found {
                            ambiguous = true;
                        } else {
                            target = candidate;
                            found = true;
                        }
                    }
                }
                if !found || ambiguous continue;
                if target.kind == "function" || target.kind == "method" {
                    symbol.kind = "function";
                    symbol.function_info = target.function_info;
                    symbol.searchable_signature = reference_copy_string(
                        target.searchable_signature,
                    );
                } else if target.kind == "type" || target.kind == "typeclass" {
                    symbol.kind = "type";
                } else continue;
                module.*.symbols[symbol_index] = symbol;
                changed = true;
            }
        }
    }
}

reference_parse_file :: (
    std_directory: string,
    path: string,
    modules: *[..]Reference_Module,
    all_instances: *[..]Reference_Instance,
    symbol_count: *ssize,
) -> bool {
    // Filesystem byte counts are fixed-width metadata; convert only after the
    // value has been checked, because `read_file` indexes host memory.
    size: s64;
    if path.file_size() == {
        case .Ok(measured); size = measured;
        case .Err(reason);
            report_error(reason);
            return false;
    }

    if size < 0 {
        print("could not determine file size for %\n", path);
        return false;
    }
    source: string;
    if path.read_file(cast(ssize)(size + 1)) == {
        case .Err(reason);
            print("could not read %: ", path);
            report_error(reason);
            return false;
        case .Ok(text); source = text;
    }
    module_name := reference_module_name(std_directory, path);
    source_path := reference_source_path(std_directory, path);
    module_index := reference_find_module(modules, module_name);
    if module_index < 0 {
        module_summary := reference_correct_context_docs(
            module_name,
            reference_module_summary(source),
        );
        module: Reference_Module = .{
            .name = module_name,
            .summary = module_summary,
            .source_path = source_path,
        };
        if module.summary.count == 0 {
            summary := String_Builder.make_len_cap(0, source_path.count + 26);
            summary.write_string("Public declarations from ");
            summary.write_string(source_path);
            summary.write_string(".");
            module.summary = summary.into_string();
        }
        modules.add(module);
        module_index = modules.*.count - 1;
    } else if source_path.ends_with("/module.glo") {
        summary := reference_correct_context_docs(
            module_name,
            reference_module_summary(source),
        );
        if summary.count > 0 modules.*[module_index].summary = summary;
        modules.*[module_index].source_path = source_path;
    }
    module := *modules.*[module_index];

    cursor: ssize = 0;
    line_number: ssize = 1;
    depth: ssize = 0;
    // Top-level declarations and inherent methods are private unless exported.
    // Visibility groups nest and restore the enclosing default at their brace.
    scope_declarations: [256]bool;
    scope_public: [256]bool;
    scope_class: [256]string;
    scope_inherent: [256]string;
    scope_constraints: [256]string;
    scope_declarations[0] = true;
    pending_scope := false;
    pending_public := false;
    pending_class := "";
    pending_inherent := "";
    pending_constraints := "";
    while cursor < source.count {
        line_end := reference_line_end(source, cursor);
        line := source[cursor..line_end];
        code := (reference_code_line(line)).trim();
        declaration_depth := depth < 255 && scope_declarations[depth];
        owner_typeclass := scope_class[depth];
        owner_inherent := scope_inherent[depth];
        visible := scope_public[depth];
        if code.starts_with("#public(unit)") {
            visible = false;
            code = code[13..code.count].trim();
        } else if code.starts_with("#public ") {
            visible = true;
            code = code[8..code.count].trim();
        } else if code.starts_with("#private ") {
            visible = false;
            code = code[9..code.count].trim();
        }
        child_declarations := false;
        child_public := false;
        child_class := "";
        child_inherent := "";
        child_constraints := "";
        if declaration_depth && code.starts_with("{") {
            child_declarations = true;
            child_public = visible;
            child_class = owner_typeclass;
            child_inherent = owner_inherent;
            child_constraints = scope_constraints[depth];
        }
        if pending_scope {
            child_declarations = true;
            child_public = pending_public;
            child_class = pending_class;
            child_inherent = pending_inherent;
            child_constraints = pending_constraints;
        }
        instance_separator := reference_index_of(code, ":::");
        separator := instance_separator;
        separator_width := 3;
        if separator < 0 {
            separator = reference_index_of(code, "::");
            separator_width = 2;
        }
        if declaration_depth && separator > 0 {
            left := code[0..separator].trim();
            code_right := code[separator + separator_width..code.count].trim();
            is_instance := code_right.starts_with("instance ") || code_right.starts_with("instance !");
            is_inherent := instance_separator > 0 && !is_instance;
            if is_inherent {
                child_declarations = true;
                child_public = code_right.starts_with("#public") &&
                    !code_right.starts_with("#public(unit)");
                child_inherent = reference_copy_string(left);
                inherent_header := reference_header(source, cursor + reference_index_of(line, left));
                where_at := reference_find_top_level_word(inherent_header.text, "where");
                if where_at >= 0
                    child_constraints = reference_copy_string(inherent_header.text[where_at..inherent_header.text.count]);
            }
            valid_name := left.count > 0 && !is_inherent &&
                (is_instance || (visible &&
                 (reference_is_identifier_start(left[0]) || left[0] == cast(u8)(#char "'"))));
            if valid_name {
                leading := reference_index_of(line, left);
                declaration_start := cursor;
                if leading >= 0 declaration_start += leading;
                header := reference_header(source, declaration_start);
                header_instance_separator := reference_index_of(header.text, ":::");
                header_separator := header_instance_separator;
                header_separator_width := 3;
                if header_separator < 0 {
                    header_separator = reference_index_of(header.text, "::");
                    header_separator_width = 2;
                }
                if header_separator > 0 {
                    header_left := header.text[0..header_separator].trim();
                    right := (header.text[
                        header_separator + header_separator_width..header.text.count]).trim();
                    summary := reference_correct_context_docs(
                        module_name,
                        reference_previous_summary(source, cursor),
                    );
                    if right.starts_with("instance ") || right.starts_with("instance !") {
                        instance_tail := right[8..right.count].trim();
                        negative := false;
                        if instance_tail.starts_with("!") {
                            negative = true;
                            instance_tail = instance_tail[1..instance_tail.count].trim();
                        }
                        class_end := reference_index_of_byte(instance_tail, cast(u8)(#char " "));
                        parameter_start := reference_index_of_byte(instance_tail, cast(u8)(#char "("));
                        if class_end < 0 || (parameter_start >= 0 && parameter_start < class_end)
                            class_end = parameter_start;
                        if class_end < 0 class_end = instance_tail.count;
                        instance: Reference_Instance = .{
                            .class_name = reference_copy_string(instance_tail[0..class_end].trim()),
                            .head = reference_copy_string(header_left),
                            .module = reference_copy_string(module_name),
                            .signature = reference_copy_string(header.text),
                            .summary = reference_copy_string(summary),
                            .source_path = reference_copy_string(source_path),
                            .source_line = line_number,
                            .negative = negative,
                        };
                        all_instances.add(instance);
                    } else if owner_typeclass.count > 0 && !right.starts_with("(") {
                        reference_add_associated_member(
                            module, owner_typeclass, header_left, right,
                            summary, source_path, line_number);
                    } else {
                        symbol_name := header_left;
                        if symbol_name.count >= 2 && symbol_name[0] == cast(u8)(#char "'") &&
                           symbol_name[symbol_name.count - 1] == cast(u8)(#char "'")
                            symbol_name = symbol_name[1..symbol_name.count - 1];
                        if owner_inherent.count > 0 {
                            qualified := String_Builder.make_len_cap(0, owner_inherent.count + symbol_name.count + 1);
                            qualified.write_string(owner_inherent);
                            qualified.write_string(".");
                            qualified.write_string(symbol_name);
                            symbol_name = qualified.into_string();
                        }
                        display_name := header_left;
                        if owner_inherent.count > 0 display_name = symbol_name;
                        symbol: Reference_Symbol = .{
                            .name = reference_copy_string(symbol_name),
                            .signature = reference_copy_string(header.text),
                            .summary = reference_copy_string(summary),
                            .source_path = reference_copy_string(source_path),
                            .source_line = line_number,
                            .owner_typeclass = reference_copy_string(owner_typeclass),
                            .has_default = header.terminator == cast(u8)(#char "{") || reference_index_of(right, "#magic") >= 0,
                        };
                        if right.starts_with("(") {
                            if owner_typeclass.count > 0 || owner_inherent.count > 0 symbol.kind = "method";
                            else symbol.kind = "function";
                            symbol.function_info = reference_function_info(right);
                            if owner_inherent.count > 0 {
                                for parameter_index: 0..symbol.function_info.parameters.count {
                                    parameter := *symbol.function_info.parameters[parameter_index];
                                    receiver := parameter.*.name;
                                    if receiver == "#self" || receiver == "*#self" || receiver == "*const #self" {
                                        parameter.*.name = "#self";
                                        receiver_type := String_Builder.make_len_cap(0, owner_inherent.count + 8);
                                        if receiver.starts_with("*const") receiver_type.write_string("*const ");
                                        else if receiver.starts_with("*") receiver_type.write_string("*");
                                        receiver_type.write_string(owner_inherent);
                                        parameter.*.value_type = receiver_type.into_string();
                                        parameter.*.modifiers.add("receiver");
                                    }
                                }
                                reference_parse_where_clauses(scope_constraints[depth], *symbol.function_info);
                            }
                            symbol.display_signature = reference_display_signature(
                                display_name, right, symbol.function_info,
                            );
                            symbol.searchable_signature = reference_searchable_signature(symbol.function_info);
                        } else if right.starts_with("typeclass") {
                            symbol.kind = "typeclass";
                            minimal_marker := reference_index_of(right, "#minimal(");
                            if minimal_marker >= 0 {
                                open := minimal_marker + 8;
                                close := reference_matching_paren(right, open);
                                if close > open {
                                    symbol.class_info.minimal = reference_copy_string(right[open + 1..close].trim());
                                    symbol.class_info.minimal_explicit = true;
                                }
                            }
                        } else if right.starts_with("struct") || right.starts_with("union") ||
                                  right.starts_with("enum") || right.starts_with("#fn_ptr") {
                            symbol.kind = "type";
                            symbol.type_info = reference_type_info(
                                right, source, declaration_start, header.terminator_index);
                            if right.starts_with("#fn_ptr") {
                                symbol.function_info = reference_function_info(right);
                                symbol.display_signature = reference_display_signature(
                                    display_name, right, symbol.function_info,
                                );
                                symbol.searchable_signature = reference_searchable_signature(
                                    symbol.function_info,
                                );
                            }
                        } else symbol.kind = "constant";
                        module.*.symbols.add(symbol);
                        symbol_count.* += 1;
                        if symbol.kind == "typeclass" {
                            child_class = symbol.name;
                            child_declarations = true;
                            child_public = true;
                        }
                        else if symbol.kind == "method" && owner_typeclass.count > 0
                            reference_add_typeclass_member(module, owner_typeclass, symbol);
                    }
                }
            }
        }
        next_depth := depth + reference_brace_delta(line);
        if child_declarations && next_depth == depth && reference_index_of_byte(code, cast(u8)(#char "{")) < 0 {
            pending_scope = true;
            pending_public = child_public;
            pending_class = child_class;
            pending_inherent = child_inherent;
            pending_constraints = child_constraints;
        }
        if next_depth > depth && next_depth < 256 {
            scope_declarations[next_depth] = child_declarations;
            scope_public[next_depth] = child_public;
            scope_class[next_depth] = child_class;
            scope_inherent[next_depth] = child_inherent;
            scope_constraints[next_depth] = child_constraints;
            pending_scope = false;
        }
        depth = next_depth;
        if depth < 0 depth = 0;
        cursor = line_end + 1;
        line_number += 1;
    }
    return true;
}

reference_write_source :: (
    modules: []Reference_Module,
    instances: []Reference_Instance,
    output_path: string,
) -> bool {
    out := String_Builder.make_len_cap(0, 4 * 1024 * 1024);
    out.write_string("{\"modules\":[");
    for i: 0..modules.count {
        if i > 0 out.write_byte(cast(u8)(#char ","));
        if modules[i].json_serialize() == {
        case .Ok(encoded_module); out.write_string(encoded_module);
        case .Err;
            print("could not serialize reference module %\n", modules[i].name);
            return false;
        }
    }
    out.write_string("],\"instances\":[");
    for i: 0..instances.count {
        instance := instances[i];
        if i > 0 out.write_byte(cast(u8)(#char ","));
        out.write_string("{\"class_name\":");
        fields: [5]string = .[
            instance.class_name,
            instance.head,
            instance.module,
            instance.signature,
            instance.summary,
        ];
        names: [5]string = .[
            "class_name", "head", "module", "signature", "summary",
        ];
        for j: 0..fields.count {
            if j > 0 {
                out.write_byte(cast(u8)(#char ","));
                if names[j].json_serialize() == {
                case .Ok(encoded_name); out.write_string(encoded_name);
                case .Err; return false;
                }
                out.write_byte(cast(u8)(#char ":"));
            }
            if fields[j].json_serialize() == {
            case .Ok(encoded); out.write_string(encoded);
            case .Err; return false;
            }
        }
        out.write_string(",\"source_path\":");
        if instance.source_path.json_serialize() == {
        case .Ok(encoded_path); out.write_string(encoded_path);
        case .Err; return false;
        }
        out.write_string(",\"source_line\":");
        out.write_string(instance.source_line.format_int(10));
        out.write_string(",\"negative\":");
        if instance.negative out.write_string("true");
        else out.write_string("false");
        out.write_byte(cast(u8)(#char "}"));
    }
    out.write_string("]}\n");
    result := output_path.write_file(out.into_string());
    return result.is_ok();
}

main :: () {
    args := get_cmdline_args();
    if args.count < 3 {
        print("usage: % <std-directory> <output>\n", args[0]);
        exit(1);
    }
    std_directory := args[1].trim_right();
    if !std_directory.os_fs_is_directory() {
        print("standard-library directory does not exist: %\n", std_directory);
        exit(1);
    }
    paths: [..]string;
    collected := reference_collect_paths(std_directory, *paths);
    if collected.is_err() {
        print("could not walk standard-library directory: %\n", std_directory);
        exit(1);
    }
    _ := (paths.view()).sort_by(reference_compare_paths);
    modules: [..]Reference_Module;
    instances: [..]Reference_Instance;
    symbol_count: ssize = 0;
    modules.reserve(paths.count);
    for path: paths {
        if !reference_parse_file(std_directory, path, *modules, *instances, *symbol_count) exit(1);
    }
    reference_resolve_aliases(*modules);
    for i: 0..modules.count reference_finalize_typeclasses(*modules[i]);
    if !reference_write_source(modules.view(), instances.view(), args[2]) exit(1);
    print(
        "Extracted % modules, % public symbols, and % instances from %.\n",
        modules.count, symbol_count, instances.count, std_directory);
}

#import "File_System/Directory";
#import "File_System/Metadata";
#import "File_System/Path";
#import "File_System/Types";
#import "File_System/File";
#import "Format";
#import "Io";
#import "Typeclass/Error";
#import "Os";
#import "Serialization/Core";
#import "Serialization/Json";
#import "Sort";
#import "String_Builder";
#import "Strings/Utf8";

