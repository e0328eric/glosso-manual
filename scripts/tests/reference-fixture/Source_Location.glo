//! Source positions remain expressions, including in initialized parameters.
//! This source-only fixture mirrors the public Prelude type and Show instance.

/// A filename and a one-based line and Unicode scalar column in that file.
Source_Location :: struct {
    filename: string;
    line: ssize;
    column: ssize;
}

/// The location where this directive is written, not a caller's location.
HERE :: #source_location;

diagnostic :: (
    message: string,
    location: Source_Location = #source_location,
    line := #source_location.line,
    fallback: Source_Location = .{ .filename = "generated.glo", .line = 1, .column = 1 },
) -> string #memory{returns_fresh, reads(message, location), noescape(message, location)} {
}

/// Renders filename:line:column using temporary storage.
Source_Location ::: instance Show {
    show :: (value: Source_Location) -> string
        #memory{returns_fresh, reads(value), noescape(value)} {
    }
}
