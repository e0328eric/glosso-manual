//! Source-only fixture: tests the reference scanner, not Glosso type checking.

open :: (
    path: $P,
    /// The direction the handle is usable in.
    access: File_Access = File_Access.Read,
    disposition: Open_Disposition = Open_Disposition.Open_Existing,
    permissions: File_Permissions = File_Permissions.Default_File,
    flags: Open_Flags = .None,
) -> Fs_Error!File
    #memory{returns_fresh(returned.Ok),
            released_by(place: returned.Ok, by: close), escapes(path),}
    where AsView(P, Path_View) {
}

Open_Flags :: enum_flags u64 {
    None :: 0;
    Append :: 1;
    Sync :: 32;
    Default :: Append | Sync;
}

lazy :: (#lazy #comptime value: bool, #comptime #lazy other: bool, size := 42, values: []string = .[]) -> bool {
}

legacy :: (path: $P) -> string #memory(returns_borrow(path), noescape(path)) where AsView(P, Path_View) {
}

bare :: (path: $P) -> string #memory returns_borrow(path) where AsView(P, Path_View) {
}

Callback :: #fn_ptr(path: $P) -> string #memory{reads(path), noescape(path)} where AsView(P, Path_View);
