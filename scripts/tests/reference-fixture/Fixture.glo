//! Source-only fixture: tests the reference scanner, not Glosso type checking.

#public open :: (
    path: $P,
    /// The direction the handle is usable in.
    access: File_Access = File_Access.Read,
    disposition: Open_Disposition = Open_Disposition.Open_Existing,
    permissions: File_Permissions = File_Permissions.Default_File,
    flags: Open_Flags = .None,
) -> Fs_Error!File

    where AsView(P, Path_View) {
}

#public Open_Flags :: enum_flags u64 {
    None :: 0;
    Append :: 1;
    Sync :: 32;
    Temporary :: 16#40;
}

#public lazy :: (#lazy #comptime value: bool, #comptime #lazy other: bool, size := 42, values: []const str = .[]) -> bool {
}

/// A borrowed path view whose constraint is written after the return type.
// An ordinary note between documentation lines does not end the block.
/// The constraint stays out of the display signature.
#public view_text :: (path: $P) -> str where AsView(P, Path_View) {
}

/// A callback keeps its calling-convention directive.
#public Callback :: #fn_ptr(path: cstr, data: ?*void) -> s32 #c_call;

/// Private implementation declarations must never enter the public reference.
_private_helper :: () {}
__Private_Type :: struct { value: ssize; }
_Private_Class :: typeclass(T: type) {
    hidden_method :: (value: T);
}

#private {
section_private :: () {}
}

unmarked_private :: () {}
#public,unit unit_private :: () {}
#public,unit {
    unit_grouped :: () {}
}
#public {
    /// A public function inside a visibility group.
    grouped :: () {}
    #private {
        hidden_nested :: () {}
    }
    after_nested :: () {}
}

#public Box :: struct {
    value: ssize;
    #private secret: ssize;
    #public,unit internal: str;
    #private {
        hidden: bool;
        #public exposed: bool;
    }
}

Box ::: #public
{
    /// Constructs a box without a receiver.
    make :: (value: ssize, label: str = "#Self_Type") -> #Self_Type {}
    /// Reads a box through its receiver.
    get :: (#self) -> ssize {}
    copy_from :: (*#self, other: *const #Self_Type) -> Fs_Error!#Self_Type {}
    #private reveal :: (#self) -> ssize {}
    #public,unit adjust :: (*#self) {}
}

Box ::: {
    conceal :: (#self) {}
    #public set :: (*#self, value: ssize) {}
}

Box ::: #public,unit {
    unit_method :: (#self) {}
}

/// A second public block reads through a read-only receiver.
Box ::: #public {
    peek :: (*const #self) -> ssize {}
}

$T ::: #public where Show(T) {
    inspect :: (*#self) -> str {}
}

#public abort :: () -> #Never #foreign "c" "abort";

/// A foreign declaration keeps its directive after a nullable return type.
#public c_malloc :: (size: usize) -> ?*void #foreign "c" "malloc";

#public GROUPED :: (1 + 2) * 3;
#public GROUPED_SIMPLE :: (42);
#public Signed :: enum s8 { Low :: -1; Zero; }

#public {
    C_TEXT :: c"// { ; }";
    BYTE_TEXT :: b"\xFF; // }";
    literal_defaults :: (message: cstr = c"// { ; }", bytes: [2]u8 = b"\xFF;") -> *const u8 {}
}

// Every file is a module: the import names Source_Location.glo, whose
// declarations stay in their own module.
#import "Source_Location.glo";

/// Rebinds a type before compiling the body.
#public widen :: (value: $T) -> T #specialize {
    T = s64;
    return true;
} { return value; }

#public integer_only :: (value: $T) -> T #specialize Is_Integer(T) { return value; }

#public read_foo :: (value: $T) -> s64
    #specialize #meaningful { T,,foo; } { return value.foo; }

#public Specialized_Box :: struct #specialize { T = s64; return true; } {
    value: $T;
}

#public Field_Box :: struct #specialize #meaningful { T,,foo; } {
    value: $T;
}
