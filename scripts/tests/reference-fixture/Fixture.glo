//! Source-only fixture: tests the reference scanner, not Glosso type checking.

#public open :: (
    path: $P,
    /// The direction the handle is usable in.
    access: File_Access = File_Access.Read,
    disposition: Open_Disposition = Open_Disposition.Open_Existing,
    permissions: File_Permissions = File_Permissions.Default_File,
    flags: Open_Flags = .None,
) -> Fs_Error!File

    where AsView(P, Path_View) {
}

#public Open_Flags :: enum_flags u64 {
    None :: 0;
    Append :: 1;
    Sync :: 32;
    Default :: Append | Sync;
}

#public lazy :: (#lazy #comptime value: bool, #comptime #lazy other: bool, size := 42, values: []const string = .[]) -> bool {
}

#public legacy :: (path: $P) -> string #memory { returns_borrow(path) } where AsView(P, Path_View) {
}

/// A borrowed path view with a leading contract.
#public #memory { reads(path), noescape(path), returns_borrow(path) }
bare :: (path: $P) -> string  where AsView(P, Path_View) {
}

/// A callback retains the contract of its function-pointer type.
#memory { returns_borrow(path), noescape(path) }
#public Callback :: #fn_ptr(path: $P) -> string  where AsView(P, Path_View);

/// Private implementation declarations must never enter the public reference.
_private_helper :: () {}
__Private_Type :: struct { value: ssize; }
_Private_Class :: typeclass(T: type) {
    hidden_method :: (value: T);
}

#private {
section_private :: () {}
}

unmarked_private :: () {}
#public(unit) unit_private :: () {}
#public {
    /// A public function inside a visibility group.
    #memory {}
    grouped :: () {}
    #private {
        hidden_nested :: () {}
    }
    after_nested :: () {}
}

#public Box :: struct {
    value: ssize;
    #private secret: ssize;
    #public(unit) internal: string;
    #private {
        hidden: bool;
        #public exposed: bool;
    }
}

Box ::: #public
{
    /// Constructs a box without a receiver.
    make :: (value: ssize, label: string = "#Self_Type") -> #Self_Type {}
    /// Reads a box through its receiver.
    #memory { reads(#self), noescape(#self) }
    get :: (#self) -> ssize {}
    copy_from :: (*#self, other: *const #Self_Type) -> Fs_Error!#Self_Type {}
    #private secret :: (#self) -> ssize {}
    #public(unit) internal :: (*#self) {}
}

Box ::: {
    hidden :: (#self) {}
    #public set :: (*#self, value: ssize) {}
}

$T ::: #public where Show(T) {
    inspect :: (*#self) -> string {}
}

#public abort :: () -> #Never #foreign "c" "abort";

#public GROUPED :: (1 + 2) * 3;
#public GROUPED_SIMPLE :: (42);
#public Signed :: enum s8 { Low :: -1; Zero; }

#public {
    C_TEXT :: c"// { ; }";
    BYTE_TEXT :: b"\xFF; // }";
    literal_defaults :: (message: cstring = c"// { ; }", bytes: [2]u8 = b"\xFF;") -> *const u8 {}
}

/// Visibility before an inline contract.
#public #memory { unknown(reason: "// { ; }") } inline_contract :: () {}
/// Visibility after a multiline contract.
#memory
{
    reads(value),
    noescape(value),
}
#public after_contract :: (value: *const u8) {}
#public(unit) #memory {} hidden_unit_contract :: () {}
#memory {} hidden_contract :: () {}

/// Independent results retain their release identities.
#memory {
    returns_fresh(returned.0, returned.1),
    released_by(place: returned.0, by: release, instance: allocator),
    released_by(place: returned.1, by: release, instance: allocator),
    unknown(arg: arg(0).data, reason: "external, { opaque } API"),
}
#public acquire_pair :: (allocator: Allocator) -> (*u8, *u8) #foreign "c" "acquire_pair";

#public old_parentheses :: (value: *const u8) #memory(reads(value), noescape(value),);

/// Typed release operations retain their complete owner syntax.
#memory {
    returns_fresh,
    released_by(place: returned, by: (?*void).mem_free, instance: allocator),
}
#public typed_acquire :: (allocator: Allocator) -> ?*void #foreign "c" "typed_acquire";

Box ::: #public {
    #memory { reads(#self), noescape(#self) }
    peek :: (*const #self) -> ssize {}
}

