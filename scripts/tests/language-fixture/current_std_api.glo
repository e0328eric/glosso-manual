#import "Io";
#import "File_System/File";
#import "File_System/Metadata";
#import "File_System/Directory";
#import "File_System/Path";
#import "Meta";
#import "Serialization/Core";
#import "Serialization/Json";
#import "String_Builder";
#import "Strings/Utf8";

check_file :: () -> Fs_Error!void {
    path := "scripts/tests/language-fixture/current_std_api.glo";
    #assert file_size(path)? > 0;
    text := read_file(path, 16)?;
    defer text.free();
    #assert text.starts_with("#import");
    file := File.open(path)?;
    prefix := file.read(7)?;
    defer prefix.free();
    #assert prefix == "#import";
    return .Ok;
}

check_json :: () -> Serialization_Error!void {
    value := Serialization_Value.json_value_from_string("true")?;
    defer value.destroy(.owned_text = true);
    if #partial (&value).* == {
        case .boolean(flag); #assert flag;
        else; exit(1);
    }
    encoded := json_serialize(true)?;
    defer encoded.free();
    #assert encoded == "true";
    return .Ok;
}

main :: () {
    #assert Drop_Error(File) == #Never;
    path := Path.from_string("src/main.glo", .style = Path_Style.Posix);
    text := path.to_string(Path_Style.Posix);
    defer text.free();
    #assert text == "src/main.glo";
    home := get_home_dir();
    config := get_config_dir();
    downloads := get_download_dir();
    #assert type_of(home) == ?Path && type_of(config) == ?Path && type_of(downloads) == ?Path;
    builder := String_Builder.builder_from_string("factory");
    #assert builder.to_string() == "factory";
    #assert check_file().is_ok();
    #assert check_json().is_ok();
    print("current std APIs passed\n");
}
