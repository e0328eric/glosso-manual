#import "Compiler";
#import "Io";
#import "Strings/Memory";

check_build_commands :: () -> bool {
    #if HOST.os == Target_OS.Windows {
        if run_build_command("echo build step") == {
            case .Ok(output);
                defer output.free();
                if output != "build step\r\n" return false;
            case .Err(failure); failure.message.free(); return false;
        }
    } else {
        // The compile-time service preserves raw stdout bytes followed by stderr.
        if run_build_command("printf 'A\\000\\377\\n'; printf 'B\\376\\n' >&2") == {
            case .Ok(output);
                defer output.free();
                if output.count != 7 || output[0] != 65 || output[1] != 0 ||
                    output[2] != 255 || output[3] != 10 || output[4] != 66 ||
                    output[5] != 254 || output[6] != 10 return false;
            case .Err(failure); failure.message.free(); return false;
        }
    }
    if run_build_command("exit 7") == {
        case .Err(failure);
            defer failure.message.free();
            return failure.status == 7;
        case .Ok(output); output.free(); return false;
    }
    return false;
}

BUILD_COMMANDS_OK :: #comptime check_build_commands();

main :: () {
    #assert BUILD_COMMANDS_OK;
    print("current build command API passed\n");
}
