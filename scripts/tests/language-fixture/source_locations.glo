#import "Io";

capture :: (location: Source_Location = #source_location) -> Source_Location {
    return location;
}

main :: () {
    default_location := capture();
    text := "한"; explicit_location := capture(#source_location);
    print("default %:%\n", default_location.line, default_location.column);
    print("explicit %:%\n", explicit_location.line, explicit_location.column);
    print("filename %\n", explicit_location.filename);
    print("text %\n", text);
}
