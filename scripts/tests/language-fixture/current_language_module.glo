// Only explicitly public declarations cross the load boundary.
#public Counter :: struct { value: ssize; }

initial_value :: () -> ssize { return 40; }

Counter ::: #public {
    make :: () -> Counter { return .{ .value = initial_value() }; }
    get :: (#self) -> ssize { return #self.value; }
    increment :: (*#self) { #self.*.value += 1; }
}

#public {
    exported_answer :: () -> ssize { return initial_value() + 2; }
    #private {
        hidden_answer :: () -> ssize { return 0; }
    }
}
