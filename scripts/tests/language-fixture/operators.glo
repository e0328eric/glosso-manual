#import "Io";
#load "operator_module.glo";

// Uses precede the local classes so the test also exercises the file prescan.
main :: () {
    print("left %\n", 20 <> 5 <> 2);
    print("right %\n", 20 ~~ 5 ~~ 2);
    print("prefix %\n", !! 7);
    print("suffix %\n", 6 ++);
    value: ssize = 6;
    value <<<= 5;
    print("assign %\n", value);
    print("loaded %\n", 2 * 3 %% 4);
}

Difference :: typeclass (T: type) {
    '<>' :: (left: T, right: T) -> T #operator(left, 18);
}
ssize ::: instance Difference {
    // The level is inherited even when the instance repeats only the mode.
    '<>' :: (left: ssize, right: ssize) -> ssize #operator(left) {
        return left - right;
    }
}

Right_Difference :: typeclass (T: type) {
    '~~' :: (left: T, right: T) -> T #operator(right, 14);
}
ssize ::: instance Right_Difference {
    '~~' :: (left: ssize, right: ssize) -> ssize { return left - right; }
}

Negative :: typeclass (T: type) {
    '!!' :: (value: T) -> T #operator(prefix);
}
ssize ::: instance Negative {
    '!!' :: (value: ssize) -> ssize { return 0 - value; }
}

Double :: typeclass (T: type) {
    '++' :: (value: T) -> T #operator(suffix);
}
ssize ::: instance Double {
    '++' :: (value: ssize) -> ssize #operator(suffix) { return value + value; }
}

Merge :: typeclass (T: type) {
    '<<<=' :: (left: T, right: T) -> T #operator(assign, 0);
}
ssize ::: instance Merge {
    '<<<=' :: (left: ssize, right: ssize) -> ssize { return left * 10 + right; }
}
