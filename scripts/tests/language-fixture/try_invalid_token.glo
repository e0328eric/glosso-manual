Wrong_Break :: typeclass (Source: type) {
    '!!' :: (#empty: $Target, value: Source)
        -> Try_Branch(s64, Result_Residual(str))
        #operator(suffix, try(Target)) {
        return .Continue(1);
    }
}
str!s64 ::: instance Wrong_Break {}
main :: () {
    value: str!s64 = .Ok(1);
    _ := Wrong_Break.'!!'(str!str, value);
}
