Wrong_Break :: typeclass (Source: type) {
    '!!' :: (#empty: $Target, value: Source)
        -> Try_Branch(s64, Result_Residual(string))
        #operator(suffix, try(Target)) {
        return .Continue(1);
    }
}
string!s64 ::: instance Wrong_Break {}
main :: () {
    value: string!s64 = .Ok(1);
    _ := Wrong_Break.'!!'(string!string, value);
}
