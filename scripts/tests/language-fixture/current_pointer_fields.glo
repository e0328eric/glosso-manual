#import "Io";

Point :: struct { x: s64; y: s64; }
Box :: struct { point: Point; next: *Point; }
Point ::: {
    bump :: (*#self) { #self.x += 1; }
}

main :: () {
    value := Point.{ 3, 4 };
    pointer := &value;
    pointer.x += 1;
    field := &pointer.y;
    field.* = 40;
    readonly: *const Point = pointer;
    #assert readonly.x == 4 && readonly.y == 40;
    readonly_field: *const s64 = &readonly.x;
    #assert readonly_field.* == 4;
    volatile_pointer: *volatile Point = pointer;
    volatile_pointer.y = 41;
    #assert volatile_pointer.y == 41;
    pointer.bump();
    double := &pointer;
    #assert double.*.x == 5;
    box := Box.{ .point = .{ 6, 7 }, .next = pointer };
    box_pointer := &box;
    #assert box_pointer.point.y == 7 && box_pointer.next.x == 5;
    maybe: ?*Point = pointer;
    if #pattern .Some(present) = maybe { #assert present.x == 5; }
    print("pointer fields passed\n");
}
