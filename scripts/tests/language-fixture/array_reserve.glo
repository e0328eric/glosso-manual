#import "Io";

reserve_values :: () -> bool {
    values: [..]ssize;
    defer values.free();
    values.reserve(0);
    if values.count != 0 || values.capacity != 0 return false;
    values.reserve(3);
    if values.count != 0 || values.capacity != 3 return false;
    values.add(41, 42);
    values.reserve(2);
    if values.count != 2 || values.capacity != 3 return false;
    values.reserve(17);
    if values.count != 2 || values.capacity != 17 return false;
    if values[0] != 41 || values[1] != 42 return false;
    values.reset();
    return values.count == 0 && values.capacity == 17;
}

Point :: struct { x: s32; y: u8; }
reserve_soa :: () -> bool {
    points: #soa [..]Point;
    defer points.free();
    points.reserve(2);
    points.add(.{7, 9});
    points.reserve(5);
    points.add(.{8, 10});
    return points.count == 2 && points.capacity == 5 &&
           points[0].x == 7 && points[0].y == 9 &&
           points[1].x == 8 && points[1].y == 10;
}

#comptime {
    #assert reserve_values();
    #assert reserve_soa();
}

main :: () {
    #assert reserve_values();
    #assert reserve_soa();
    print("array reserve passed\n");
}
