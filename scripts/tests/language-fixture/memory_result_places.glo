#import "Context";

#memory { kills(pointer), reads(allocator), noescape(pointer, allocator) }
release_byte :: (pointer: *u8, allocator: Allocator)
    #foreign "c" "release_byte";

#memory {
    reads(allocator),
    noescape(allocator),
    returns_fresh(returned.0, returned.1),
    released_by(place: returned.0, by: release_byte, instance: allocator),
    released_by(place: returned.1, by: release_byte, instance: allocator),
}
acquire_pair :: (allocator: Allocator) -> (*u8, *u8)
    #foreign "c" "acquire_pair";
main :: () {}
