#import "Io";
#import "Strings";

main :: () {
    text := "ab".repeat(3);
    defer text.free();
    #assert text == "ababab";

    single := "ab".repeat(1);
    defer single.free();
    #assert single == "ab" && single.data != "ab".data;

    zero := "ab".repeat(0);
    defer zero.free();
    negative := "ab".repeat(-1);
    defer negative.free();
    empty := "".repeat(3);
    defer empty.free();
    #assert zero.count == 0 && negative.count == 0 && empty.count == 0;
    print("string repeat passed\n");
}
