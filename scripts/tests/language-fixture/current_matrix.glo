#import "Io";
#import "Math/Matrix";
#import "Meta";

M23 :: Matrix(s64, 2, 3);
CONSTANT: M23: #matrix .[1, 2, 3; 4, 5, 6];

make :: (first: s64) -> M23 { return #matrix .[first, 2, 3; 4, 5, 6]; }
last :: (value: M23) -> s64 { return value[5]; }
Holder :: struct { value: M23; }

check :: () {
    m := make(1);
    #assert m[0] == 1 && m[3] == 4 && m[5] == 6 && CONSTANT[4] == 5;
    #assert last(#matrix .[1, 2, 3; 4, 5, 6]) == 6;
    m = #matrix .[6, 5, 4,; 3, 2, 1,;];
    #assert m[0] == 6 && m[5] == 1;
    m = cast(M23)#matrix .[1, 2, 3; 4, 5, 6];
    holder: Holder = .{ .value = #matrix .[1, 2, 3; 4, 5, 6] };
    #assert holder.value[3] == 4;
    row: Matrix(s64, 1, 3) = #matrix .[1, 2, 3];
    column: Matrix(s64, 3, 1) = #matrix .[1; 2; 3];
    #assert row[2] == 3 && column[2] == 3;

    values := matrix_to_array(m);
    method_values := m.to_array();
    copy := matrix_from_array(M23, values);
    #assert type_of(values) == [6]s64 && matrix_array_type(M23) == [6]s64;
    for index: 0..values.count {
        #assert values[index] == cast(s64)(index + 1);
        #assert method_values[index] == values[index] && copy[index] == values[index];
    }
    values[0] = 99;
    copy[1] = 88;
    #assert m[0] == 1 && m[1] == 2 && copy[0] == 1 && values[1] == 2;

    no_rows: Matrix(s64, 0, 3) = #matrix .[];
    no_columns: Matrix(s64, 2, 0) = #matrix .[];
    empty_values := no_rows.to_array();
    empty_copy := matrix_from_array(Matrix(s64, 2, 0), empty_values);
    #assert no_rows.count == 0 && no_columns.count == 0 && empty_copy.count == 0;
    #assert type_of(empty_values) == [0]s64;
}

#comptime check();
main :: () {
    check();
    print("matrix literals and conversions passed\n");
}
