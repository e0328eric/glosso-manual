#import "Io";
#import "Meta";

check_pointers :: () -> bool {
    value: s64 = 7;
    prefix := &value;
    suffix := value.&;
    #assert prefix.type_of() == *s64;
    #assert prefix == suffix;
    *prefix += 2;
    suffix.* += 3;
    nested := &prefix;
    #assert **nested == 12;
    #assert &(*prefix) == suffix.*.&;
    values: [2]s64 = .[1, 2];
    for *element: values { *element += value; }
    #assert values[0] == 13 && values[1] == 14;
    return (7 & 3) == 3 && 3 * 4 == value;
}

check_literals :: () -> bool {
    terminated := c"A\0tail";
    #assert terminated.type_of() == cstring;
    #assert terminated.count == 1 && terminated.data[1] == 0;
    #assert cast(string)terminated == "A";
    bytes := b"é\xFF\0\u{41}";
    #assert bytes.type_of() == [5]u8;
    #assert bytes[0] == 16#c3 && bytes[1] == 16#a9;
    #assert bytes[2] == 255 && bytes[3] == 0 && bytes[4] == 65;
    copy := bytes;
    bytes[2] = 7;
    #assert copy[2] == 255;
    empty := b"";
    return empty.count == 0 && c"".count == 0;
}

#comptime {
    #assert check_pointers();
    #assert check_literals();
}
main :: () {
    #assert check_pointers();
    #assert check_literals();
    print("pointers and literals passed\n");
}
