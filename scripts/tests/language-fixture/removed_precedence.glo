// These directives must each fail; #operator is the only accepted spelling.
Removed_Left :: typeclass (T: type) {
    '<>' :: (left: T, right: T) -> T #precedence(left, 18);
}
Removed_Right :: typeclass (T: type) {
    '<~>' :: (left: T, right: T) -> T #precedence(right, 14);
}
Removed_Assign :: typeclass (T: type) {
    '<<<=' :: (left: T, right: T) -> T #precedence(assign, 0);
}
main :: () {}
