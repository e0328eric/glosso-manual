#import "Io";
#import "Format";

half :: (n: s64) -> ?s64 {
    if n % 2 != 0 return null;
    return ?(n / 2);
}

quarter :: (n: s64) -> ?s64 { return half(half(n)?); }

main :: () {
    a: ?s64 = ?5;
    b: ?s64 = null;
    unit := ?.();
    nested: ??s64 = ?null;
    if tprint("{} {} {} {}", a, b, unit, nested) != "?5 null ?.() ?null" exit(1);
    if quarter(8) != ?2 || quarter(6) != null exit(2);
    flag := true;
    picked: ?s64 = ifx flag ?7 else null;
    if picked != ?7 exit(3);
    small := 0;
    values: [4]?s64 = .[?3, null, ?12, ?0];
    for value: values {
        if value == {
            case ?1..=9; small += 1;
            case ?_;
            case null;
        }
    }
    if small != 1 exit(4);
    if #pattern ??inner = ?a { if inner != 5 exit(5); } else exit(6);
    #pattern ?h := half(10) else { exit(7); };
    if h != 5 exit(8);
    print("optional values passed\n");
}
