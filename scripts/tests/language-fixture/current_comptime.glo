#import "Io";
#import "Format";
#import "Meta";
#import "String_Builder";

Record :: struct { x: s64; y: s64; }
names :: (#comptime T: type, #comptime i: ssize) -> string {
    #if i >= field_count(T) {
        return "";
    } else {
        return tprint("%%", field_name(T, i), names(T, i + 1));
    }
}
NAMES :: #comptime names(Record, 0);

source_text :: () -> string {
    builder := String_Builder.source_new();
    builder.append("source ", "builder");
    return builder.finish_source();
}
TEXT :: #comptime source_text();

main :: () {
    #assert NAMES == "xy" && TEXT == "source builder";
    print("current comptime passed\n");
}
