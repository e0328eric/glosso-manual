#import "Io";
#import "Format";
#import "Meta";
#import "Strings/Utf8";
#import "String_Builder";

main :: () {
    #assert size_of(str) == 2 * size_of(ssize);
    #assert size_of(string16) == 2 * size_of(ssize);
    #assert size_of(cstr) == size_of(*const u8);
    #assert size_of(cstring16) == size_of(*const u16);

    bytes: [4]u8 = .[65, 66, 67, 0];
    text := cast(str)(bytes[0..3]);
    middle := text[1..3];
    #assert middle.data == bytes.data + 1;
    bytes[1] = 90;
    #assert text == "AZC" && middle == "ZC";
    terminated := cast(cstr)bytes.data;
    counted := cast(str)terminated;
    #assert counted.data == text.data && counted.count == 3;
    #assert tprint("{}", terminated) == "AZC";
    null_c: cstr;
    empty_c: cstr = "";
    #assert null_c != empty_c && null_c < empty_c;
    wide: string16 = "A";
    wide_after: string16 = "B";
    #assert wide < wide_after;
    wide_c: cstring16 = "A";
    #assert tprint("{}", wide_c) == "A";

    builder := String_Builder.builder_from_string("first chapter");
    #assert builder.to_string().data == builder.buf.data;
    saved := builder.clone();
    defer saved.free();
    builder.reset();
    builder.write_string("second chapter");
    #assert saved == "first chapter";
    transferred := builder.into_string();
    defer transferred.free();
    #assert transferred == "second chapter";
    print("string views passed\n");
}
