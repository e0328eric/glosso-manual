#import "Context";
#import "Io";
#import "Memory/Object";
#import "String_Builder";

drops: ssize = 0;
Record :: struct { text: String_Builder; count: s64 = 7; }
Record ::: instance Drop {
    Error :: #Never;
    drop :: (record: *#Self_Type) -> #Never!void {
        #assert record.*.text.to_string() == "owned object";
        drops += 1;
        return .Ok;
    }
}

main :: () {
    absent: ?*Record = .None;
    #assert delete(absent).is_ok();
    #assert drops == 0;
    if #pattern .Some(record) = new(Record) {
        #assert record.*.count == 7;
        record.*.text.write_string("owned object");
        // Deletion uses the captured heap allocator, not this new context.
        #push_allocator(nil_allocator());
        #assert delete(record).is_ok();
    } else {
        exit(1);
    }
    #assert drops == 1;
    #push_allocator(nil_allocator());
    #assert new(Record).is_none();
    print("owned objects passed\n");
}
