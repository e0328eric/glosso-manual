#import "Io";
#enable(memory_strict);

#public {
    #memory {}
    square :: (value: s64) -> s64 { return value * value; }

    #memory { reads(source), noescape(source), returns_borrow(source) }
    view :: (source: []const u8) -> []const u8 { return source; }
}

// Historical trailing contracts remain supported.
identity :: (value: s64) -> s64 #memory {} { return value; }

main :: () {
    bytes: [3]u8 = b"abc";
    result := view(bytes[..]);
    #assert result.count == 3 && result[0] == 97;
    #assert square(identity(7)) == 49;
    print("memory contracts passed\n");
}
