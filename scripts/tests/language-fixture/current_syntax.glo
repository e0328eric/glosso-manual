#import "Io";
#import "Meta";

GROUPED :: (1 + 2) * 3;
Signed :: enum s8 { Low :: -1; Zero; }
Box :: struct { value: $T; }

main :: () {
    LOCAL :: (40 + 2);
    #assert GROUPED == 9 && LOCAL == 42;
    #assert cast(s8)Signed.Low == -1 && cast(s8)Signed.Zero == 0;
    #assert #char "\u{1f642}" == #char "🙂";
    Slice :: []s64;
    Fixed :: [2]s64;
    Many :: [*]u8;
    Dynamic :: [..]u8;
    #assert size_of(Slice) == 2 * size_of(ssize);
    #assert size_of(Fixed) == 2 * size_of(s64);
    #assert size_of(Many) == size_of(*u8);
    #assert size_of(Dynamic) == 3 * size_of(ssize);
    pair := .(.(1, 2), 3);
    #assert pair.0.1 == 2;
    box := Box(f64).{ .value = 1.5 };
    #assert box.value == 1.5;
    print("current syntax passed\n");
}
