#import "Io";
#import "Format";

// A source and its boundary may have different success types.
describe :: (value: str!s64) -> str!str {
    number := value?;
    return .Ok(tprint("{}", number));
}
optional :: (value: ?s64) -> ?str {
    _ := value?;
    return "present";
}
void_success :: (value: str!void) -> str!str {
    value?;
    return "done";
}
local_boundary :: (value: str!s64) -> str!str {
    captured := #try { value? + 1 };
    if captured.is_err() return "caught";
    return "continued";
}

Inner :: struct { trace: *s64; }
Outer :: union { #from inner: Inner; }

// Conversion is inside the operator body, before both kinds of cleanup.
Input_Error :: struct { trace: *s64; }
Output_Error :: struct { trace: *s64; }
(Input_Error, Output_Error) ::: instance Propagate {
    propagate :: (#empty: Output_Error, value: Input_Error) -> Output_Error {
        value.trace.* = value.trace.* * 10 + 1;
        return .{ .trace = value.trace };
    }
}
widen :: (value: Input_Error!s64, trace: *s64) -> Output_Error!str {
    defer trace.* = trace.* * 10 + 3;
    #try defer trace.* = trace.* * 10 + 2;
    _ := value?;
    return "ok";
}
explicit_error :: (trace: *s64) -> Output_Error!str {
    defer trace.* = trace.* * 10 + 3;
    #try defer trace.* = trace.* * 10 + 2;
    return .Err(.{ .trace = trace });
}
from_variant :: (value: Inner!s64) -> Outer!str {
    _ := value?;
    return "ok";
}

// An override must be called exactly once, after evaluating its operand once.
Observed :: struct { value: str!s64; calls: ?*s64; }
Observed ::: instance Try {
    Output :: s64;
    Residual :: Result_Residual(str);
    from_output :: (#empty: Observed, output: s64) -> Observed {
        return Observed.{ .value = .Ok(output), .calls = null };
    }
    from_residual :: (#empty: Observed, residual: Result_Residual(str)) -> Observed {
        return Observed.{ .value = .Err(residual.error), .calls = null };
    }
    branch :: (value: Observed) -> Try_Branch(s64, Result_Residual(str)) {
        return branch(value.value);
    }
    '?' :: (#empty: $Target, value: Observed) -> Try_Branch(s64, Target)
        #operator(suffix, try(Target))
        where Try(Target) &&
            (Try(Observed).Residual == Try(Target).Residual ||
             Propagate(Try(Observed).Residual, Try(Target).Residual)) {
        if #pattern ?calls = value.calls calls.* += 1;
        return '?'(Target, value.value);
    }
}
observe :: (evaluations: *s64, calls: *s64) -> Observed {
    evaluations.* += 1;
    return Observed.{ .value = .Ok(41), .calls = ?calls };
}
use_override :: (evaluations: *s64, calls: *s64) -> str!str {
    value := observe(evaluations, calls)?;
    return .Ok(tprint("{}", value));
}

Forward_Try :: typeclass (Source: type) {
    '!!' :: (#empty: $Target, value: Source)
        -> Try_Branch(Try(Source).Output, Target)
        #operator(suffix, try(Target))
        where Try(Source) && Try(Target) &&
            (Try(Source).Residual == Try(Target).Residual ||
             Propagate(Try(Source).Residual, Try(Target).Residual)) {
        return '?'(Target, value);
    }
}
str!s64 ::: instance Forward_Try {}
forward :: (value: str!s64) -> str!str { return .Ok(tprint("{}", value!!)); }

verify :: () -> bool {
    good: str!s64 = .Ok(41);
    bad: str!s64 = .Err("failure");
    if (describe(good)).unwrap_or("") != "41" return false;
    if !(describe(bad)).is_err() return false;
    if (optional(?1)).unwrap_or("") != "present" return false;
    if !(optional(null)).is_none() return false;
    if (void_success(.Ok)).unwrap_or("") != "done" return false;
    if !(void_success(.Err("failure"))).is_err() return false;
    if (local_boundary(bad)).unwrap_or("") != "caught" return false;
    if (local_boundary(good)).unwrap_or("") != "continued" return false;

    // Quoted calls return tokens outside any boundary, including scoped calls.
    continued := Try(str!s64).'?'(str!str, good);
    broken := '?'(str!s64, bad);
    if #pattern .Continue(value) = continued {
        if value != 41 return false;
    } else return false;
    if #pattern .Break(carrier) = broken {
        if #pattern .Err(error) = carrier {
            if error != "failure" return false;
        } else return false;
    } else return false;
    scoped := Forward_Try.'!!'(str!str, good);
    if #pattern .Continue(value) = scoped {
        if value != 41 return false;
    } else return false;
    if (forward(good)).unwrap_or("") != "41" return false;
    if !(forward(bad)).is_err() return false;

    trace: s64 = 0;
    if !(widen(.Err(.{ .trace = &trace }), &trace)).is_err() || trace != 123
        return false;
    trace = 0;
    if (widen(.Ok(41), &trace)).unwrap_or("") != "ok" || trace != 3
        return false;
    trace = 0;
    if !(explicit_error(&trace)).is_err() || trace != 3 return false;
    if !(from_variant(.Err(.{ .trace = &trace }))).is_err() return false;

    evaluations: s64 = 0;
    calls: s64 = 0;
    if (use_override(&evaluations, &calls)).unwrap_or("") != "41" return false;
    return evaluations == 1 && calls == 1;
}

#comptime { #assert verify(); }
main :: () {
    if !verify() exit(1);
    print("try operator passed\n");
}
