// Standard-library reference generator invoked by first.glo.

reference_json_field :: (
    value: ?*Serialization_Value,
    name: string,
) -> ?*Serialization_Value {
    if #pattern .Some(present) = value return present.field_value(name);
    return .None;
}

reference_json_text :: (
    value: ?*Serialization_Value,
    name: string,
    fallback: string = "",
) -> string {
    if #pattern .Some(field) = reference_json_field(value, name) {
        if #partial field.* == {
            case .text(text); return text;
        }
    }
    return fallback;
}

reference_json_bool :: (
    value: ?*Serialization_Value,
    name: string,
    fallback: bool = false,
) -> bool {
    if #pattern .Some(field) = reference_json_field(value, name) {
        if #partial field.* == {
            case .boolean(boolean); return boolean;
        }
    }
    return fallback;
}

reference_json_int :: (
    value: ?*Serialization_Value,
    name: string,
    fallback: ssize = 0,
) -> ssize {
    if #pattern .Some(field) = reference_json_field(value, name) {
        if #partial field.* == {
            case .signed_integer(signed); return cast(ssize)signed;
            case .unsigned_integer(unsigned); return cast(ssize)unsigned;
            case .floating(floating); return cast(ssize)floating;
        }
    }
    return fallback;
}

reference_json_array :: (
    value: ?*Serialization_Value,
    name: string,
) -> []Serialization_Value {
    empty: []Serialization_Value;
    if #pattern .Some(field) = reference_json_field(value, name) {
        if #partial field.* == {
            case .sequence(sequence); return sequence.view();
        }
    }
    return empty;
}

// The browser search index carries one [title, text] pair per manual chapter.
// Both halves are read out of the manual's own sources, so the index cannot
// drift from the chapters the way a preserved copy did: titles come from
// src/section_catalog.glo, and the prose comes from the section files that
// main.glo loads. Code blocks are skipped; a chapter is searched by what it
// says, not by the programs it quotes.

MANUAL_TEXT_CALLS :: .[
    "paragraph(", "subheading(", "bullet(", "note(",
    "table_header(", "table_row(",
];

reference_read_file_text :: (path: string) -> string {
    size: s64;
    if path.file_size() == {
        case .Ok(measured); size = measured;
        case .Err(reason);
            report_error(reason);
            return "";
    }
    if size < 0 return "";
    if path.read_file(cast(ssize)(size + 1)) == {
        case .Ok(text); return text;
        case .Err; return "";
    }
}

reference_line_end :: (source: string, start: ssize) -> ssize {
    i := start;
    while i < source.count && source[i] != cast(u8)(#char "\n") i += 1;
    return i;
}

reference_trim_line :: (value: string) -> string {
    start: ssize = 0;
    finish := value.count;
    while start < finish &&
        (value[start] == cast(u8)(#char " ") || value[start] == cast(u8)(#char "\t")) start += 1;
    while finish > start && (value[finish - 1] == cast(u8)(#char " ") ||
        value[finish - 1] == cast(u8)(#char "\t") ||
        value[finish - 1] == cast(u8)(#char "\r")) finish -= 1;
    return value[start..finish];
}

reference_leading_number :: (value: string) -> ssize {
    result: ssize = 0;
    seen := false;
    for i: 0..value.count {
        byte := value[i];
        if byte < cast(u8)(#char "0") || byte > cast(u8)(#char "9") break;
        result = result * 10 + cast(ssize)(byte - cast(u8)(#char "0"));
        seen = true;
    }
    if !seen return -1;
    return result;
}

// The text of a call written on one line, as in `table_row(3, "a | b");`.
reference_quoted_argument :: (line: string) -> string {
    open: ssize = -1;
    if #pattern .Some(found) = line.index_of("\"") open = found;
    if open < 0 return "";
    close := line.count - 1;
    while close > open && line[close] != cast(u8)(#char "\"") close -= 1;
    if close <= open return "";
    return line[open + 1..close];
}

// Chapter prose is Markdown-flavoured: backticks mark inline code and carry no
// searchable text of their own. Escapes written for the literal are undone so
// the index holds what a reader sees.
reference_append_prose :: (out: *String_Builder, value: string) {
    i: ssize = 0;
    while i < value.count {
        byte := value[i];
        if byte == cast(u8)(#char "`") { i += 1; continue; }
        if byte == cast(u8)(#char "\\") && i + 1 < value.count {
            next := value[i + 1];
            if next == cast(u8)(#char "\"") || next == cast(u8)(#char "\\") {
                out.write_byte(next);
                i += 2;
                continue;
            }
        }
        out.write_byte(byte);
        i += 1;
    }
    out.write_byte(cast(u8)(#char " "));
}

reference_manual_titles :: () -> [..]string {
    titles: [..]string;
    source := reference_read_file_text("src/section_catalog.glo");
    position: ssize = 0;
    while position < source.count {
        finish := reference_line_end(source, position);
        line := reference_trim_line(source[position..finish]);
        position = finish + 1;
        if !line.starts_with("case ") continue;
        rest := line[5..line.count];
        index := reference_leading_number(rest);
        if index < 0 continue;
        title := reference_quoted_argument(rest);
        if title.count == 0 continue;
        while titles.count <= index titles.add("");
        titles[index] = title.clone();
    }
    return titles;
}

// main.glo is the list of chapter files, so the generator never needs its own
// copy of it.
reference_manual_section_files :: () -> [..]string {
    files: [..]string;
    source := reference_read_file_text("main.glo");
    marker := "#load";
    position: ssize = 0;
    while position < source.count {
        finish := reference_line_end(source, position);
        line := reference_trim_line(source[position..finish]);
        position = finish + 1;
        if !line.starts_with(marker) continue;
        path := reference_quoted_argument(line);
        if path.starts_with("src/sections_") files.add(path.clone());
    }
    return files;
}

MANUAL_SCAN_IDLE :: 0;
MANUAL_SCAN_PROSE :: 1;
MANUAL_SCAN_CODE :: 2;

reference_collect_manual_text :: (path: string, texts: *[..]string) {
    source := reference_read_file_text(path);
    out := String_Builder.make_len_cap(0, 8 * 1024);
    current: ssize = -1;
    mode := MANUAL_SCAN_IDLE;
    position: ssize = 0;
    while position < source.count {
        finish := reference_line_end(source, position);
        line := reference_trim_line(source[position..finish]);
        position = finish + 1;

        if mode != MANUAL_SCAN_IDLE {
            // A continuation line of a #string block starts with its marker;
            // the call's own closing parenthesis is the only other shape.
            if line.starts_with(")") {
                mode = MANUAL_SCAN_IDLE;
            } else if mode == MANUAL_SCAN_PROSE && line.starts_with("\\\\") {
                reference_append_prose(*out, line[2..line.count]);
            }
            continue;
        }

        if line.starts_with("render_section_") {
            if current >= 0 && current < texts.*.count {
                texts.*[current] = out.to_string();
                out.reset();
            }
            current = reference_leading_number(line["render_section_".count..line.count]);
            continue;
        }
        if current < 0 continue;

        is_code := line.starts_with("code_block(");
        is_text := false;
        for name: MANUAL_TEXT_CALLS {
            if line.starts_with(name) { is_text = true; break; }
        }
        if !is_code && !is_text continue;

        // A call closed on its own line carries an ordinary literal; anything
        // else opens a #string block that runs to a lone closing parenthesis.
        if !line.ends_with(");") {
            if is_code mode = MANUAL_SCAN_CODE;
            else mode = MANUAL_SCAN_PROSE;
            continue;
        }
        if is_text reference_append_prose(*out, reference_quoted_argument(line));
    }
    if current >= 0 && current < texts.*.count {
        texts.*[current] = out.into_string();
    } else {
        out.free();
    }
}

reference_manual_json :: () -> string {
    titles := reference_manual_titles();
    defer titles.free();
    if titles.count == 0 {
        print("src/section_catalog.glo yielded no section titles\n");
        return "";
    }

    texts: [..]string;
    defer texts.free();
    while texts.count < titles.count texts.add("");

    files := reference_manual_section_files();
    defer files.free();
    if files.count == 0 {
        print("main.glo lists no src/sections_*.glo chapter files\n");
        return "";
    }
    for path: files reference_collect_manual_text(path, *texts);

    empty: ssize = 0;
    for text: texts if text.count == 0 empty += 1;
    if empty != 0 print("manual index: % of % chapters have no prose\n", empty, titles.count);

    out := String_Builder.make_len_cap(0, 1024 * 1024);
    out.write_byte(cast(u8)(#char "["));
    for i: 0..titles.count {
        if i != 0 out.write_byte(cast(u8)(#char ","));
        out.write_byte(cast(u8)(#char "["));
        reference_write_escaped_string(*out, titles[i], false);
        out.write_byte(cast(u8)(#char ","));
        reference_write_escaped_string(*out, reference_one_line(texts[i]), false);
        out.write_byte(cast(u8)(#char "]"));
    }
    out.write_byte(cast(u8)(#char "]"));
    return out.into_string();
}

reference_is_space :: (byte: u8) -> bool {
    return byte == cast(u8)(#char " ") || byte == cast(u8)(#char "\t") ||
        byte == cast(u8)(#char "\n") || byte == cast(u8)(#char "\r") ||
        byte == 11 || byte == 12;
}

reference_is_rule_byte :: (byte: u8) -> bool {
    return byte == cast(u8)(#char "=") || byte == cast(u8)(#char "-") || byte == cast(u8)(#char "~") ||
        byte == cast(u8)(#char "_") || byte == cast(u8)(#char "*") || byte == cast(u8)(#char "#") ||
        byte == cast(u8)(#char "+");
}

// Documentation comments draw section rules out of repeated punctuation. The
// rules carry no prose, and word wrapping cannot break a token that long, so
// one of them widens the reference column past its maximum and pushes the
// running text underneath the status rail. Drop them while flattening.
reference_is_rule_token :: (value: string) -> bool {
    if value.count < 4 return false;
    first := value[0];
    if !reference_is_rule_byte(first) return false;
    i: ssize = 1;
    while i < value.count {
        if value[i] != first return false;
        i += 1;
    }
    return true;
}

reference_one_line :: (value: string) -> string {
    out := String_Builder.make_len_cap(0, value.count);
    wrote := false;
    start: ssize = 0;
    i: ssize = 0;
    while i <= value.count {
        if i < value.count && !reference_is_space(value[i]) {
            i += 1;
            continue;
        }
        if i > start {
            token := value[start..i];
            if !reference_is_rule_token(token) {
                if wrote out.write_byte(cast(u8)(#char " "));
                out.write_string(token);
                wrote = true;
            }
        }
        start = i + 1;
        i += 1;
    }
    return out.into_string();
}

reference_compact_summary :: (value: string, limit: ssize = 150) -> string {
    summary := value;
    if summary.count <= limit return summary;
    cut := limit;
    i := limit - 1;
    while i >= 0 {
        if summary[i] == cast(u8)(#char " ") {
            if i > limit * 3 / 5 cut = i;
            break;
        }
        i -= 1;
    }
    out := String_Builder.make_len_cap(0, cut + 3);
    out.write_string(summary[0..cut]);
    out.write_string("...");
    return out.into_string();
}

reference_join_json_texts :: (
    values: []Serialization_Value,
    separator: string,
) -> string {
    out := String_Builder.make_len_cap(0, values.count * 8);
    wrote := false;
    for i: 0..values.count {
        value := *values[i];
        text := reference_json_text(value, "");
        if text.count == 0 {
            if #partial value.* == {
                case .text(direct); text = direct;
            }
        }
        if text.count == 0 continue;
        if wrote out.write_string(separator);
        out.write_string(text);
        wrote = true;
    }
    return out.into_string();
}

reference_details_cell :: (value: *Serialization_Value) -> string {
    out := String_Builder.make_len_cap(0, 32);
    wrote := false;
    modifiers := reference_json_array(value, "modifiers");
    if modifiers.count > 0 {
        out.write_string(reference_join_json_texts(modifiers, ", "));
        wrote = true;
    }
    default_value := reference_json_text(value, "default_value");
    if default_value.count > 0 {
        if wrote out.write_string(" / ");
        out.write_string("Default: ");
        out.write_string(default_value);
        wrote = true;
    }
    constraints := reference_json_array(value, "constraints");
    if constraints.count > 0 {
        if wrote out.write_string(" / ");
        out.write_string("Constraint: ");
        out.write_string(reference_join_json_texts(constraints, " && "));
        wrote = true;
    }
    if !wrote out.write_string("-");
    return out.into_string();
}

reference_kind_order :: (kind: string) -> ssize {
    if kind == "type" return 0;
    if kind == "typeclass" return 1;
    if kind == "constant" return 2;
    if kind == "function" return 3;
    if kind == "method" return 4;
    return 99;
}

reference_collation_weight :: (byte: u8) -> ssize {
    if byte == cast(u8)(#char "_") return 1;
    if byte == cast(u8)(#char "-") return 2;
    if byte == cast(u8)(#char "!") return 3;
    if byte == cast(u8)(#char ".") return 4;
    if byte == cast(u8)(#char "[") || byte == cast(u8)(#char "]") return 5;
    if byte == cast(u8)(#char "*") return 6;
    if byte == cast(u8)(#char "/") return 7;
    if byte == cast(u8)(#char "&") return 8;
    if byte == cast(u8)(#char "%") return 9;
    if byte == cast(u8)(#char "^") return 10;
    if byte == cast(u8)(#char "+") return 11;
    if byte == cast(u8)(#char "<") return 12;
    if byte == cast(u8)(#char "=") return 13;
    if byte == cast(u8)(#char ">") return 14;
    if byte == cast(u8)(#char "|") return 15;
    if byte == cast(u8)(#char "~") return 16;
    if byte >= cast(u8)(#char "0") && byte <= cast(u8)(#char "9")
        return 100 + cast(ssize)(byte - cast(u8)(#char "0"));
    if byte >= cast(u8)(#char "A") && byte <= cast(u8)(#char "Z")
        return 200 + cast(ssize)(byte - cast(u8)(#char "A"));
    if byte >= cast(u8)(#char "a") && byte <= cast(u8)(#char "z")
        return 200 + cast(ssize)(byte - cast(u8)(#char "a"));
    return 50 + cast(ssize)byte;
}

reference_compare_strings :: (left: string, right: string) -> Ordering {
    count := left.count;
    if right.count < count count = right.count;
    for i: 0..count {
        left_weight := reference_collation_weight(left[i]);
        right_weight := reference_collation_weight(right[i]);
        if left_weight != right_weight return left_weight <=> right_weight;
    }
    if left.count != right.count return left.count <=> right.count;
    for i: 0..count {
        if left[i] == right[i] continue;
        left_upper := left[i] >= cast(u8)(#char "A") && left[i] <= cast(u8)(#char "Z");
        right_upper := right[i] >= cast(u8)(#char "A") && right[i] <= cast(u8)(#char "Z");
        if left_upper != right_upper return cast(ssize)left_upper <=> cast(ssize)right_upper;
        return left[i] <=> right[i];
    }
    return Ordering.Equal;
}

reference_compare_symbols :: (
    left: *Serialization_Value,
    right: *Serialization_Value,
) -> Ordering {
    left_kind := reference_kind_order(reference_json_text(left, "kind"));
    right_kind := reference_kind_order(reference_json_text(right, "kind"));
    if left_kind != right_kind return left_kind <=> right_kind;
    left_name := reference_json_text(left, "name");
    right_name := reference_json_text(right, "name");
    return reference_compare_strings(left_name, right_name);
}

reference_write_integer :: (out: *String_Builder, value: ssize) {
    out.write_string(value.format_int(10));
}

reference_write_boolean :: (out: *String_Builder, value: bool) {
    if value out.write_string("true");
    else out.write_string("false");
}

reference_write_escaped_string :: (
    out: *String_Builder,
    value: string,
    glosso: bool,
) {
    out.write_byte(cast(u8)(#char "\""));
    i: ssize = 0;
    while i < value.count {
        byte := value[i];
        if byte == cast(u8)(#char "\"") {
            out.write_string("\\\"");
        } else if byte == cast(u8)(#char "\\") {
            out.write_string("\\\\");
        } else if byte == cast(u8)(#char "\n") {
            out.write_string("\\n");
        } else if byte == cast(u8)(#char "\r") {
            out.write_string("\\r");
        } else if byte == cast(u8)(#char "\t") {
            out.write_string("\\t");
        } else if byte < 32 {
            out.write_string(" ");
        } else if i + 2 < value.count && byte == 16#e2 &&
                  value[i + 1] == 16#80 &&
                  (value[i + 2] == 16#a8 || value[i + 2] == 16#a9) {
            if glosso {
                if value[i + 2] == 16#a8 out.write_string("\\u{2028}");
                else out.write_string("\\u{2029}");
            } else {
                if value[i + 2] == 16#a8 out.write_string("\\u2028");
                else out.write_string("\\u2029");
            }
            i += 2;
        } else {
            out.write_byte(byte);
        }
        i += 1;
    }
    out.write_byte(cast(u8)(#char "\""));
}

reference_stream_detail_row :: (
    out: *String_Builder,
    first: string,
    second: string,
    third: string = "",
) {
    out.write_string("    .{ .first = ");
    reference_write_escaped_string(out, first, true);
    out.write_string(", .second = ");
    reference_write_escaped_string(out, second, true);
    out.write_string(", .third = ");
    reference_write_escaped_string(out, third, true);
    out.write_string(" },\n");
}

reference_stream_function_rows :: (
    function: ?*Serialization_Value,
    details: *String_Builder,
    detail_count: *ssize,
) -> (ssize, ssize, string, ssize, ssize) {
    first_parameter := detail_count.*;
    if !function
        return first_parameter, 0, "", detail_count.*, 0;

    parameters := reference_json_array(function, "parameters");
    for i: 0..parameters.count {
        parameter := *parameters[i];
        // `name := value` deliberately omits its annotation: the compiler
        // takes the parameter type from the default expression. Keep the
        // searchable signature broad (`any`), but do not leave the manual's
        // TYPE cell blank for this valid and widely used declaration form.
        parameter_type := reference_json_text(parameter, "value_type");
        if parameter_type.count == 0 parameter_type = "inferred";
        reference_stream_detail_row(
            details,
            reference_json_text(parameter, "name"),
            parameter_type,
            reference_details_cell(parameter),
        );
        detail_count.* += 1;
    }
    parameter_count := detail_count.* - first_parameter;
    return_type := reference_json_text(function, "return_type");
    first_memory := detail_count.*;
    contracts := reference_json_array(function, "memory_contracts");
    for i: 0..contracts.count {
        contract := *contracts[i];
        arguments := reference_json_array(contract, "arguments");
        argument_text := "-";
        if arguments.count > 0
            argument_text = reference_join_json_texts(arguments, ", ");
        reference_stream_detail_row(
            details,
            reference_json_text(contract, "effect"),
            argument_text,
        );
        detail_count.* += 1;
    }
    return first_parameter, parameter_count, return_type,
        first_memory, detail_count.* - first_memory;
}

reference_stream_type_details :: (
    symbol: *Serialization_Value,
    details: *String_Builder,
    detail_count: *ssize,
) -> (string, ssize, ssize) {
    first := detail_count.*;
    kind := "";
    type_info := reference_json_field(symbol, "type_info");
    if !type_info return kind, first, 0;
    type_kind := reference_json_text(type_info, "kind");
    if type_kind == "function-pointer" {
        kind = "function-pointer";
    } else if type_kind == "struct" {
        kind = "fields";
        fields := reference_json_array(type_info, "fields");
        for i: 0..fields.count {
            field := *fields[i];
            reference_stream_detail_row(
                details,
                reference_json_text(field, "name"),
                reference_json_text(field, "value_type"),
                reference_details_cell(field),
            );
            detail_count.* += 1;
        }
    } else if type_kind == "union" || type_kind == "enum" || type_kind == "enum_flags" {
        if type_kind == "union" kind = "variants";
        else if type_kind == "enum_flags" kind = "flags";
        else kind = "values";
        variants := reference_json_array(type_info, "variants");
        for i: 0..variants.count {
            variant := *variants[i];
            second := "-";
            if type_kind != "union" second = "automatic";
            value := reference_json_text(variant, "variant_type");
            if type_kind != "union" value = reference_json_text(variant, "value");
            if value.count > 0 second = value;
            reference_stream_detail_row(
                details,
                reference_json_text(variant, "name"),
                second,
            );
            detail_count.* += 1;
        }
    }
    return kind, first, detail_count.* - first;
}

reference_stream_typeclass_members :: (
    symbol: *Serialization_Value,
    details: *String_Builder,
    detail_count: *ssize,
    members_out: *String_Builder,
    member_count: *ssize,
) -> (string, bool, ssize, ssize, ssize, ssize) {
    first := member_count.*;
    associated: ssize = 0;
    methods: ssize = 0;
    minimal := "No methods are required.";
    explicit := false;
    typeclass := reference_json_field(symbol, "class_info");
    if !typeclass return minimal, explicit, first, 0, associated, methods;
    raw_minimal := reference_json_text(typeclass, "minimal");
    if raw_minimal.count > 0 minimal = raw_minimal;
    explicit = reference_json_bool(typeclass, "minimal_explicit");
    members := reference_json_array(typeclass, "members");
    for i: 0..members.count {
        member := *members[i];
        kind := reference_json_text(member, "kind");
        if kind == "associated-type" associated += 1;
        if kind == "method" methods += 1;
        first_parameter, parameter_count, return_type,
            first_memory, memory_count := reference_stream_function_rows(
                reference_json_field(member, "function_info"),
                details,
                detail_count,
            );
        members_out.write_string("    .{ .name = ");
        reference_write_escaped_string(members_out, reference_json_text(member, "name"), true);
        members_out.write_string(", .signature = ");
        member_signature := reference_json_text(member, "display_signature");
        if member_signature.count == 0
            member_signature = reference_json_text(member, "signature");
        reference_write_escaped_string(members_out, member_signature, true);
        members_out.write_string(", .summary = ");
        reference_write_escaped_string(members_out, reference_one_line(reference_json_text(member, "summary")), true);
        members_out.write_string(", .source_path = ");
        reference_write_escaped_string(members_out, reference_json_text(member, "source_path"), true);
        members_out.write_string(", .source_line = "); reference_write_integer(members_out, reference_json_int(member, "source_line"));
        members_out.write_string(", .kind = "); reference_write_escaped_string(members_out, kind, true);
        members_out.write_string(", .has_default = "); reference_write_boolean(members_out, reference_json_bool(member, "has_default"));
        members_out.write_string(", .first_parameter = "); reference_write_integer(members_out, first_parameter);
        members_out.write_string(", .parameter_count = "); reference_write_integer(members_out, parameter_count);
        members_out.write_string(", .return_type = "); reference_write_escaped_string(members_out, return_type, true);
        members_out.write_string(", .first_memory = "); reference_write_integer(members_out, first_memory);
        members_out.write_string(", .memory_count = "); reference_write_integer(members_out, memory_count);
        members_out.write_string(" },\n");
        member_count.* += 1;
    }
    return minimal, explicit, first, member_count.* - first, associated, methods;
}

reference_stream_instances :: (
    symbol: *Serialization_Value,
    all_instances: []Serialization_Value,
    instances_out: *String_Builder,
    instance_count: *ssize,
) -> (ssize, ssize) {
    first := instance_count.*;
    if reference_json_text(symbol, "kind") != "typeclass" return first, 0;
    typeclass := reference_json_text(symbol, "name");
    for i: 0..all_instances.count {
        instance := *all_instances[i];
        if reference_json_text(instance, "class_name") != typeclass continue;
        instances_out.write_string("    .{ .head = ");
        reference_write_escaped_string(instances_out, reference_json_text(instance, "head"), true);
        instances_out.write_string(", .signature = "); reference_write_escaped_string(instances_out, reference_json_text(instance, "signature"), true);
        instances_out.write_string(", .module = "); reference_write_escaped_string(instances_out, reference_json_text(instance, "module"), true);
        instances_out.write_string(", .source_path = "); reference_write_escaped_string(instances_out, reference_json_text(instance, "source_path"), true);
        instances_out.write_string(", .source_line = "); reference_write_integer(instances_out, reference_json_int(instance, "source_line"));
        instances_out.write_string(", .negative = "); reference_write_boolean(instances_out, reference_json_bool(instance, "negative"));
        instances_out.write_string(" },\n");
        instance_count.* += 1;
    }
    return first, instance_count.* - first;
}

reference_flush_builder_to_file :: (
    path: string,
    builder: *String_Builder,
) -> Fs_Error!bool {
    if builder.len() == 0 return .Ok(true);
    file := File.open(path, .Write, .Open_Existing, .flags = .Append)?;
    written := file.write(builder.to_string())?;
    _ := file.close()?;
    if written != builder.len() return .Ok(false);
    builder.reset();
    return .Ok(true);
}

reference_flush_large_builder_to_file :: (
    path: string,
    builder: *String_Builder,
) -> Fs_Error!bool {
    if builder.len() < 96 * 1024 return .Ok(true);
    return reference_flush_builder_to_file(path, builder);
}

reference_generate_outputs :: (
    modules: []Serialization_Value,
    instances: []Serialization_Value,
) -> Fs_Error!bool {
    glo_modules := String_Builder.make_len_cap(0, 128 * 1024);
    glo_symbols := String_Builder.make_len_cap(0, 128 * 1024);
    glo_details := String_Builder.make_len_cap(0, 128 * 1024);
    glo_members := String_Builder.make_len_cap(0, 128 * 1024);
    glo_instances := String_Builder.make_len_cap(0, 128 * 1024);
    js_modules := String_Builder.make_len_cap(0, 128 * 1024);
    js_symbols := String_Builder.make_len_cap(0, 128 * 1024);
    part_paths: [7]string = .[
        "build/reference-modules.glo.part",
        "build/reference-symbols.glo.part",
        "build/reference-details.glo.part",
        "build/reference-members.glo.part",
        "build/reference-instances.glo.part",
        "build/reference-modules.js.part",
        "build/reference-symbols.js.part",
    ];
    for i: 0..part_paths.count {
        _ := part_paths[i].write_file("")?;
    }
    symbol_count: ssize = 0;
    detail_count: ssize = 0;
    member_count: ssize = 0;
    instance_count: ssize = 0;

    for module_index: 0..modules.count {
        module := *modules[module_index];
        first_symbol := symbol_count;
        raw_symbols := reference_json_array(module, "symbols");
        ordered: [..]*Serialization_Value;
        for i: 0..raw_symbols.count ordered.add(*raw_symbols[i]);
        _ := (ordered.view()).sort_by(reference_compare_symbols);
        for i: 0..ordered.count {
            symbol := ordered[i];
            detail_kind, first_detail, type_detail_count :=
                reference_stream_type_details(symbol, *glo_details, *detail_count);
            first_parameter, parameter_count, return_type,
                first_memory, memory_count := reference_stream_function_rows(
                    reference_json_field(symbol, "function_info"),
                    *glo_details,
                    *detail_count,
                );
            minimal, minimal_explicit, first_member, symbol_member_count,
                associated_count, method_count := reference_stream_typeclass_members(
                    symbol,
                    *glo_details,
                    *detail_count,
                    *glo_members,
                    *member_count,
                );
            first_instance, symbol_instance_count := reference_stream_instances(
                symbol,
                instances,
                *glo_instances,
                *instance_count,
            );
            name := reference_json_text(symbol, "name");
            signature := reference_json_text(symbol, "signature");
            display_signature := reference_json_text(symbol, "display_signature");
            if display_signature.count == 0 display_signature = signature;
            searchable_signature := reference_json_text(symbol, "searchable_signature");
            summary := reference_one_line(reference_json_text(symbol, "summary"));
            kind := reference_json_text(symbol, "kind");

            glo_symbols.write_string("    .{ .name = "); reference_write_escaped_string(*glo_symbols, name, true);
            glo_symbols.write_string(", .signature = "); reference_write_escaped_string(*glo_symbols, display_signature, true);
            glo_symbols.write_string(", .searchable_signature = "); reference_write_escaped_string(*glo_symbols, searchable_signature, true);
            glo_symbols.write_string(", .owner_typeclass = "); reference_write_escaped_string(*glo_symbols, reference_json_text(symbol, "owner_typeclass"), true);
            glo_symbols.write_string(", .summary = "); reference_write_escaped_string(*glo_symbols, summary, true);
            glo_symbols.write_string(", .source_path = "); reference_write_escaped_string(*glo_symbols, reference_json_text(symbol, "source_path"), true);
            glo_symbols.write_string(", .source_line = "); reference_write_integer(*glo_symbols, reference_json_int(symbol, "source_line"));
            glo_symbols.write_string(", .kind = "); reference_write_escaped_string(*glo_symbols, kind, true);
            glo_symbols.write_string(", .module_index = "); reference_write_integer(*glo_symbols, module_index);
            glo_symbols.write_string(", .first_instance = "); reference_write_integer(*glo_symbols, first_instance);
            glo_symbols.write_string(", .instance_count = "); reference_write_integer(*glo_symbols, symbol_instance_count);
            glo_symbols.write_string(", .detail_kind = "); reference_write_escaped_string(*glo_symbols, detail_kind, true);
            glo_symbols.write_string(", .first_detail = "); reference_write_integer(*glo_symbols, first_detail);
            glo_symbols.write_string(", .detail_count = "); reference_write_integer(*glo_symbols, type_detail_count);
            glo_symbols.write_string(", .first_parameter = "); reference_write_integer(*glo_symbols, first_parameter);
            glo_symbols.write_string(", .parameter_count = "); reference_write_integer(*glo_symbols, parameter_count);
            glo_symbols.write_string(", .return_type = "); reference_write_escaped_string(*glo_symbols, return_type, true);
            glo_symbols.write_string(", .first_memory = "); reference_write_integer(*glo_symbols, first_memory);
            glo_symbols.write_string(", .memory_count = "); reference_write_integer(*glo_symbols, memory_count);
            glo_symbols.write_string(", .minimal = "); reference_write_escaped_string(*glo_symbols, minimal, true);
            glo_symbols.write_string(", .minimal_explicit = "); reference_write_boolean(*glo_symbols, minimal_explicit);
            glo_symbols.write_string(", .first_member = "); reference_write_integer(*glo_symbols, first_member);
            glo_symbols.write_string(", .member_count = "); reference_write_integer(*glo_symbols, symbol_member_count);
            glo_symbols.write_string(", .associated_count = "); reference_write_integer(*glo_symbols, associated_count);
            glo_symbols.write_string(", .method_count = "); reference_write_integer(*glo_symbols, method_count);
            glo_symbols.write_string(" },\n");

            if symbol_count > 0 js_symbols.write_byte(cast(u8)(#char ","));
            js_symbols.write_byte(cast(u8)(#char "["));
            reference_write_escaped_string(*js_symbols, name, false); js_symbols.write_byte(cast(u8)(#char ","));
            reference_write_escaped_string(*js_symbols, signature, false); js_symbols.write_byte(cast(u8)(#char ","));
            reference_write_escaped_string(*js_symbols, searchable_signature, false); js_symbols.write_byte(cast(u8)(#char ","));
            reference_write_escaped_string(*js_symbols, summary, false); js_symbols.write_byte(cast(u8)(#char ","));
            reference_write_integer(*js_symbols, module_index); js_symbols.write_byte(cast(u8)(#char ","));
            reference_write_escaped_string(*js_symbols, kind, false); js_symbols.write_byte(cast(u8)(#char "]"));
            symbol_count += 1;
            if !reference_flush_large_builder_to_file(part_paths[1], *glo_symbols)? ||
               !reference_flush_large_builder_to_file(part_paths[2], *glo_details)? ||
               !reference_flush_large_builder_to_file(part_paths[3], *glo_members)? ||
               !reference_flush_large_builder_to_file(part_paths[4], *glo_instances)? ||
               !reference_flush_large_builder_to_file(part_paths[6], *js_symbols)?
                return .Ok(false);
        }
        ordered.free();
        module_summary := reference_one_line(reference_json_text(module, "summary"));
        module_name := reference_json_text(module, "name");
        module_symbol_count := symbol_count - first_symbol;
        glo_modules.write_string("    .{ .name = "); reference_write_escaped_string(*glo_modules, module_name, true);
        glo_modules.write_string(", .summary = "); reference_write_escaped_string(*glo_modules, module_summary, true);
        glo_modules.write_string(", .compact_summary = "); reference_write_escaped_string(*glo_modules, reference_compact_summary(module_summary), true);
        glo_modules.write_string(", .source_path = "); reference_write_escaped_string(*glo_modules, reference_json_text(module, "source_path"), true);
        glo_modules.write_string(", .first_symbol = "); reference_write_integer(*glo_modules, first_symbol);
        glo_modules.write_string(", .symbol_count = "); reference_write_integer(*glo_modules, module_symbol_count);
        glo_modules.write_string(" },\n");

        if module_index > 0 js_modules.write_byte(cast(u8)(#char ","));
        js_modules.write_byte(cast(u8)(#char "["));
        reference_write_escaped_string(*js_modules, module_name, false); js_modules.write_byte(cast(u8)(#char ","));
        reference_write_escaped_string(*js_modules, module_summary, false); js_modules.write_byte(cast(u8)(#char ","));
        reference_write_integer(*js_modules, first_symbol); js_modules.write_byte(cast(u8)(#char ","));
        reference_write_integer(*js_modules, module_symbol_count); js_modules.write_byte(cast(u8)(#char "]"));
        if !reference_flush_large_builder_to_file(part_paths[0], *glo_modules)? ||
           !reference_flush_large_builder_to_file(part_paths[5], *js_modules)?
            return .Ok(false);
    }

    if !reference_flush_builder_to_file(part_paths[0], *glo_modules)? return .Ok(false);
    if !reference_flush_builder_to_file(part_paths[1], *glo_symbols)? return .Ok(false);
    if !reference_flush_builder_to_file(part_paths[2], *glo_details)? return .Ok(false);
    if !reference_flush_builder_to_file(part_paths[3], *glo_members)? return .Ok(false);
    if !reference_flush_builder_to_file(part_paths[4], *glo_instances)? return .Ok(false);
    if !reference_flush_builder_to_file(part_paths[5], *js_modules)? return .Ok(false);
    if !reference_flush_builder_to_file(part_paths[6], *js_symbols)? return .Ok(false);

    glo := String_Builder.make_len_cap(0, 16 * 1024);
    glo.write_string(#string
        \\// Generated by `glosso first.glo -- gen-reference`. Do not edit by hand.
        \\
        \\#public(unit) {
        \\
        \\Std_Module_Doc :: struct {
        \\    name: string;
        \\    summary: string;
        \\    compact_summary: string;
        \\    source_path: string;
        \\    first_symbol: s32;
        \\    symbol_count: s32;
        \\}
        \\
        \\Std_Symbol_Doc :: struct {
        \\    name: string;
        \\    signature: string;
        \\    searchable_signature: string;
        \\    owner_typeclass: string;
        \\    summary: string;
        \\    source_path: string;
        \\    source_line: s32;
        \\    kind: string;
        \\    module_index: s32;
        \\    first_instance: s32;
        \\    instance_count: s32;
        \\    detail_kind: string;
        \\    first_detail: s32;
        \\    detail_count: s32;
        \\    first_parameter: s32;
        \\    parameter_count: s32;
        \\    return_type: string;
        \\    first_memory: s32;
        \\    memory_count: s32;
        \\    minimal: string;
        \\    minimal_explicit: bool;
        \\    first_member: s32;
        \\    member_count: s32;
        \\    associated_count: s32;
        \\    method_count: s32;
        \\}
        \\
        \\Std_Detail_Row_Doc :: struct {
        \\    first: string;
        \\    second: string;
        \\    third: string;
        \\}
        \\
        \\Std_Member_Doc :: struct {
        \\    name: string;
        \\    signature: string;
        \\    summary: string;
        \\    source_path: string;
        \\    source_line: s32;
        \\    kind: string;
        \\    has_default: bool;
        \\    first_parameter: s32;
        \\    parameter_count: s32;
        \\    return_type: string;
        \\    first_memory: s32;
        \\    memory_count: s32;
        \\}
        \\
        \\Std_Instance_Doc :: struct {
        \\    head: string;
        \\    signature: string;
        \\    module: string;
        \\    source_path: string;
        \\    source_line: s32;
        \\    negative: bool;
        \\}
        \\
    );
    glo.write_string("\n");
    glo.write_string("STD_MODULE_COUNT :: "); reference_write_integer(*glo, modules.count); glo.write_string(";\n");
    glo.write_string("STD_SYMBOL_COUNT :: "); reference_write_integer(*glo, symbol_count); glo.write_string(";\n");
    glo.write_string("STD_INSTANCE_COUNT :: "); reference_write_integer(*glo, instance_count); glo.write_string(";\n");
    glo.write_string("STD_DETAIL_ROW_COUNT :: "); reference_write_integer(*glo, detail_count); glo.write_string(";\n");
    glo.write_string("STD_MEMBER_COUNT :: "); reference_write_integer(*glo, member_count); glo.write_string(";\n\n");
    glo.write_string("STD_MODULE_DOCS: ["); reference_write_integer(*glo, modules.count); glo.write_string("]Std_Module_Doc = .[\n");
    layout_ok := (("build/reference-glo-header.part").write_file(glo.to_string())).is_ok();
    separator := String_Builder.make_len_cap(0, 256);
    separator.write_string("];\n\nSTD_SYMBOL_DOCS: ["); reference_write_integer(*separator, symbol_count); separator.write_string("]Std_Symbol_Doc = .[\n");
    layout_ok = layout_ok && (("build/reference-glo-after-modules.part").write_file(separator.to_string())).is_ok();
    separator.reset();
    separator.write_string("];\n\nSTD_DETAIL_ROWS: ["); reference_write_integer(*separator, detail_count); separator.write_string("]Std_Detail_Row_Doc = .[\n");
    layout_ok = layout_ok && (("build/reference-glo-after-symbols.part").write_file(separator.to_string())).is_ok();
    separator.reset();
    separator.write_string("];\n\nSTD_MEMBER_DOCS: ["); reference_write_integer(*separator, member_count); separator.write_string("]Std_Member_Doc = .[\n");
    layout_ok = layout_ok && (("build/reference-glo-after-details.part").write_file(separator.to_string())).is_ok();
    separator.reset();
    separator.write_string("];\n\nSTD_INSTANCE_DOCS: ["); reference_write_integer(*separator, instance_count); separator.write_string("]Std_Instance_Doc = .[\n");
    layout_ok = layout_ok && (("build/reference-glo-after-members.part").write_file(separator.to_string())).is_ok();
    layout_ok = layout_ok && (("build/reference-glo-footer.part").write_file("];\n\n}\n")).is_ok();
    if !layout_ok return .Ok(false);
    print(
        "Generated % modules, % symbols, and % typeclass instances.\n",
        modules.count,
        symbol_count,
        instance_count,
    );
    return .Ok(true);
}

generate_reference :: (source_path: string) -> bool {
    size: s64;
    if source_path.file_size() == {
        case .Ok(measured); size = measured;
        case .Err(reason);
            report_error(reason);
            return false;
    }

    if size < 0 {
        print("could not determine generated reference source size: %\n", source_path);
        return false;
    }
    source: string;
    if source_path.read_file(cast(ssize)(size + 1)) == {
        case .Err;
            print("could not read generated reference source %\n", source_path);
            return false;
        case .Ok(text); source = text;
    }
    root: Serialization_Value;
    if source.json_value_from_string(.max_depth = 256) == {
        case .Err(failure);
            print("reference JSON: % at %\n", failure.message, failure.offset);
            return false;
        case .Ok(value); root = value;
    }
    modules := reference_json_array(*root, "modules");
    instances := reference_json_array(*root, "instances");
    if modules.count == 0 {
        print("generated reference JSON has no modules\n");
        return false;
    }

    if !("src/generated").is_directory().unwrap_or(false) {
        created := ("src/generated").create_directory(.make_parent = true);
        if created.is_err() {
            print("could not create src/generated\n");
            return false;
        }
    }
    if !reference_generate_outputs(modules, instances).unwrap_or(false) return false;
    manual_json := reference_manual_json();
    if manual_json.count == 0 {
        print("could not build the manual search index from the chapter sources\n");
        return false;
    }
    return (("build/reference-manual.js.part").write_file(manual_json)).is_ok();
}

main :: () {
    args := get_cmdline_args();
    source := "build/reference-source.json";
    if args.count > 1 source = args[1];
    if !generate_reference(source) exit(1);
}

#import "File_System/Directory";
#import "File_System/File";
#import "File_System/Metadata";
#import "File_System/Path";
#import "File_System/Types";
#import "Format";
#import "Io";
#import "Typeclass/Error";
#import "Serialization/Core";
#import "Serialization/Json";
#import "Sort";
#import "String_Builder";
#import "Strings/Utf8";

