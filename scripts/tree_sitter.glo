// Synchronize Tree-sitter query data into the browser host.

// The markers exclude their line terminator. .gitattributes checks app.js out
// with CRLF on Windows and LF elsewhere, so the terminator is discovered from
// the file and reused for the line this script generates.
TREE_SITTER_QUERY_BEGIN :: "// BEGIN GENERATED TREE-SITTER QUERY";
TREE_SITTER_QUERY_END :: "// END GENERATED TREE-SITTER QUERY";

tree_sitter_write_escaped_string :: (
    out: *String_Builder,
    value: string,
) {
    out.write_byte(cast(u8)(#char "\""));
    i: ssize = 0;
    while i < value.count {
        byte := value[i];
        if byte == cast(u8)(#char "\"") {
            out.write_string("\\\"");
        } else if byte == cast(u8)(#char "\\") {
            out.write_string("\\\\");
        } else if byte == cast(u8)(#char "\n") {
            out.write_string("\\n");
        } else if byte == cast(u8)(#char "\r") {
            out.write_string("\\r");
        } else if byte == cast(u8)(#char "\t") {
            out.write_string("\\t");
        } else if byte < 32 {
            out.write_string(" ");
        } else if i + 2 < value.count && byte == 16#e2 &&
                  value[i + 1] == 16#80 &&
                  (value[i + 2] == 16#a8 || value[i + 2] == 16#a9) {
            if value[i + 2] == 16#a8 out.write_string("\\u2028");
            else out.write_string("\\u2029");
            i += 2;
        } else {
            out.write_byte(byte);
        }
        i += 1;
    }
    out.write_byte(cast(u8)(#char "\""));
}

tree_sitter_append_text :: (path: string, text: string) -> Fs_Error!bool {
    file := File.open(path, .Write, .Open_Or_Create, .flags = .Append)?;
    wrote := file.write(text);
    closed := file.close();
    if #pattern .Ok(written) = wrote {
        return .Ok(written == text.count && closed.is_ok());
    }
    return .Ok(false);
}

#public(unit) sync_tree_sitter :: () -> bool {
    query_result := ("tree-sitter/highlights.scm").read_file(1024 * 1024);
    app_result := ("app.js").read_file(4 * 1024 * 1024);
    query: string;
    app: string;
    if query_result == {
        case .Err;
            print("could not read tree-sitter/highlights.scm\n");
            return false;
        case .Ok(text); query = text;
    }
    if app_result == {
        case .Err;
            print("could not read app.js\n");
            return false;
        case .Ok(text); app = text;
    }

    begin: ssize;
    if app.index_of(TREE_SITTER_QUERY_BEGIN) == {
        case .Some(found); begin = found;
        case .None;
            print("app.js is missing the Tree-sitter query begin marker\n");
            return false;
    }
    content_start := begin + TREE_SITTER_QUERY_BEGIN.count;
    line_end := "\n";
    if content_start < app.count && app[content_start] == cast(u8)(#char "\r") {
        line_end = "\r\n";
        content_start += 1;
    }
    if content_start < app.count && app[content_start] == cast(u8)(#char "\n")
        content_start += 1;
    finish: ssize;
    if app.index_of(TREE_SITTER_QUERY_END, .start = content_start) == {
        case .Some(found); finish = found;
        case .None;
            print("app.js is missing the Tree-sitter query end marker\n");
            return false;
    }

    replacement := String_Builder.make_len_cap(0, query.count + 128);
    replacement.write_string("const GLOSSO_HIGHLIGHTS_QUERY = ");
    tree_sitter_write_escaped_string(*replacement, query);
    replacement.write_string(";");
    replacement.write_string(line_end);
    replacement_text := replacement.into_temporary_string();
    initialized := ("app.js").write_file(app[0..content_start]);
    if initialized.is_err() ||
       !tree_sitter_append_text("app.js", replacement_text).unwrap_or(false) ||
       !tree_sitter_append_text("app.js", app[finish..app.count]).unwrap_or(false) {
        print("could not update app.js\n");
        return false;
    }
    print("Embedded % bytes from tree-sitter/highlights.scm into app.js.\n", query.count);
    return true;
}

#import "String_Builder";
#import "File_System/File";
#import "Strings/Utf8";
#import "Io";
