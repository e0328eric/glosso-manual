{
  "name": "glosso-manual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "nub scripts/generate-docs.ts",
    "dev": "nub scripts/generate-docs.ts && nubx vite",
    "build": "nub scripts/generate-docs.ts && nubx vite build",
    "preview": "nubx vite preview",
    "typecheck": "nubx tsc --noEmit",
    "check:wasm": "nub scripts/check-wasm.ts",
    "check:search": "nub scripts/check-search.ts",
    "check:coverage": "nub scripts/check-manual-coverage.ts",
    "check": "nub scripts/generate-docs.ts && nub scripts/check-manual-coverage.ts && nubx tsc --noEmit && nub scripts/check-search.ts && nub scripts/check-wasm.ts && nubx vite build"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "vue": "^3.5.40",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.0"
  }
}
