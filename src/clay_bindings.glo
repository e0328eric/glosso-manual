// Builds Clay for OUT and inserts matching declarations into this compilation.
#import "Io";
#import "Compiler";
#import "Bindgen";

// The compiler services serialize these records in the order shown. Keep the
// bridge records `#c_call`: ordinary structs are reordered by target layout,
// and `string` becoming two 32-bit words on wasm32 otherwise moves `s64`
// ahead of it and scrambles the service result.
Clay_Native_Compile_Result :: struct #c_call {
    output: string;
    artifact: string;
    status: s64;
    ok: bool;
}

clay_compile_c_archive :: (
    name: string,
    sources: [..]string,
    options: C_Compile_Options,
) -> Clay_Native_Compile_Result #magic "compiler_compile_c_archive"
    #memory{returns_fresh, reads(name, sources, options),
            noescape(name, sources, options)};

Clay_Bindgen_Result :: struct #c_call {
    output: string;
    status: s64;
    ok: bool;
}

clay_generate_bindings :: (
    header: string,
    library: any,
    options: Bindgen_Options,
) -> Clay_Bindgen_Result #magic "bindgen_generate_source"
    #memory{returns_fresh, reads(header, library, options),
            noescape(header, library, options)};

// Produces Bindgen's freshly built source on success and a static
// `#compile_error` literal on every failure path, so the computation makes no
// return-origin claim; the checker infers what each path produced.
CLAY_BINDINGS_SOURCE :: #comptime -> string {
    if OUT.os != Target_OS.Wasm ||
       OUT.cpu != Target_CPU.Wasm32 ||
       OUT.abi != Target_ABI.Freestanding
        return "#compile_error \"Clay manual bindings require wasm32-freestanding\";";

    header := find_header("clay.h", "vendor/clay");
    if header.count == 0 {
        print("Clay header was not found under vendor/clay\n");
        return "#compile_error \"Clay header was not found\";";
    }

    sources: [..]string;
    defer array_free(*sources);
    array_add(*sources, header);

    definitions: [..]string;
    defer array_free(*definitions);
    array_add(
        *definitions,
        "CLAY_IMPLEMENTATION",
        "CLAY_WASM",
        "CLAY_DISABLE_SIMD",
    );

    c_options: C_Compile_Options;
    c_options.preprocessor_definitions = definitions;
    add_c_include_path(*c_options, "vendor/clay");
    add_c_compiler_arg(*c_options, "-ffreestanding");
    add_c_compiler_arg(*c_options, "-fno-builtin");
    clay_archive := clay_compile_c_archive("clay", sources, c_options);
    if !clay_archive.ok {
        print("Clay compilation failed (status %):\n", clay_archive.status);
        print("%", clay_archive.output);
        return "#compile_error \"Clay compilation failed\";";
    }

    bindgen_options: Bindgen_Options;
    add_include_path(*bindgen_options, "vendor/clay");
    add_bindgen_preprocessor_definition(*bindgen_options, "CLAY_WASM");
    add_bindgen_preprocessor_definition(*bindgen_options, "CLAY_DISABLE_SIMD");
    add_bindgen_compiler_arg(*bindgen_options, "--target=wasm32-unknown-unknown");
    add_bindgen_compiler_arg(*bindgen_options, "-ffreestanding");
    generated := clay_generate_bindings(
        header,
        clay_archive.artifact,
        bindgen_options,
    );
    if !generated.ok {
        print("Clay Bindgen failed (status %):\n", generated.status);
        print("%", generated.output);
        return "#compile_error \"Clay Bindgen failed\";";
    }
    return generated.output;
}

#insert CLAY_BINDINGS_SOURCE;
