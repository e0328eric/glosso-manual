// Builds Clay for OUT and inserts matching declarations into this compilation.
#import "Io";
#import "Compiler";
#import "Bindgen";

// Produces Bindgen's freshly built source on success and a static
// failed compile-time assertion on every failure path, so it makes no
// return-origin claim; the checker infers what each path produced.
CLAY_BINDINGS_SOURCE :: #comptime -> string {
    if OUT.os != Target_OS.Wasm ||
       OUT.cpu != Target_CPU.Wasm32 ||
       OUT.abi != Target_ABI.Freestanding
        return "#comptime { #assert false, \"Clay manual bindings require wasm32-freestanding\"; }";

    header := find_header("clay.h", "vendor/clay");
    if header.count == 0 {
        print("Clay header was not found under vendor/clay\n");
        return "#comptime { #assert false, \"Clay header was not found\"; }";
    }

    sources: [..]string;
    defer array_free(*sources);
    array_add(*sources, header);

    clay_archive: Native_Compile_Output;
    if compile_c_archive(
        "clay",
        sources,
        .include_paths = .["vendor/clay"],
        .preprocessor_definitions = .[
            "CLAY_IMPLEMENTATION", "CLAY_WASM", "CLAY_DISABLE_SIMD",
        ],
        .compiler_args = .["-ffreestanding", "-fno-builtin"],
    ) == {
        case .Ok(compiled); clay_archive = compiled;
        case .Err(error);
            print("Clay compilation failed (status %):\n%", error.status, error.message);
            return "#comptime { #assert false, \"Clay compilation failed\"; }";
    }

    if generate_source(
        header,
        library_spec("clay", clay_archive.artifact),
        .include_paths = .["vendor/clay"],
        .preprocessor_definitions = .["CLAY_WASM", "CLAY_DISABLE_SIMD"],
        .compiler_args = .["--target=wasm32-unknown-unknown", "-ffreestanding"],
        // Clay needs Clang's complete ABI layouts, never the textual parser.
        .allow_textual_fallback = false,
    ) == {
        case .Ok(source); return source;
        case .Err(error);
            print("Clay Bindgen failed (status %):\n%", error.status, error.message);
            return "#comptime { #assert false, \"Clay Bindgen failed\"; }";
    }
}

#insert CLAY_BINDINGS_SOURCE;
