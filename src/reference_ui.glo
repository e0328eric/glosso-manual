// Shared by the embedded files in the manual ownership unit.
#public(unit) {
// Standard-library reference, global search, and browser-facing application state.

APP_VIEW_MANUAL : s32 : 0;
APP_VIEW_STANDARD_LIBRARY : s32 : 1;
APP_VIEW_SEARCH : s32 : 2;

SEARCH_RESULTS_PER_PAGE : s32 : 20;
MAX_SEARCH_RESULTS : s32 : 100;

Search_Result :: struct {
    kind: s32; // 0 = manual section, 1 = module, 2 = standard-library symbol
    index: s32;
}

app_view: s32 = APP_VIEW_MANUAL;
selected_module: s32 = -1;
selected_symbol: s32 = -1;
selected_type: s32 = -1; // A method identifies a primitive/generic receiver with no declaration.
REFERENCE_METHOD_FOLD :: 32;
REFERENCE_MEMBER_FOLD :: REFERENCE_METHOD_FOLD + STD_SYMBOL_COUNT;
REFERENCE_INSTANCE_FOLD :: REFERENCE_MEMBER_FOLD + STD_MEMBER_COUNT;
REFERENCE_FOLD_COUNT :: REFERENCE_INSTANCE_FOLD + STD_INSTANCE_COUNT;
reference_folded: [REFERENCE_FOLD_COUNT]bool;
reference_fold_visible: [REFERENCE_FOLD_COUNT]bool;
reference_owners: [STD_SYMBOL_COUNT]s32;
reference_owners_ready: bool = false;
search_page: s32 = 0;
search_result_count: s32 = 0;
search_results: [MAX_SEARCH_RESULTS]Search_Result;
reference_viewport_width: f32 = 1280.0;

// The browser document owns scrolling, so navigation performed inside a frame
// has to tell the host where the new page should start. 0 leaves the offset
// alone, 1 asks for the top of the document, and 2 asks for the declaration
// tagged with SYMBOL_ANCHOR_MARKER during this frame.
SCROLL_REQUEST_NONE : s32 : 0;
SCROLL_REQUEST_TOP : s32 : 1;
SCROLL_REQUEST_ANCHOR : s32 : 2;

scroll_request: s32 = SCROLL_REQUEST_NONE;
scroll_symbol: s32 = -1;
scroll_member: s32 = -1;

clear_scroll_target :: () {
    scroll_request = SCROLL_REQUEST_NONE;
    scroll_symbol = -1;
    scroll_member = -1;
}

manual_set_view :: (view: s32) #c_call {
    if view < APP_VIEW_MANUAL || view > APP_VIEW_SEARCH return;
    clear_scroll_target();
    app_view = view;
    if view == APP_VIEW_MANUAL selected_section = -1;
    if view == APP_VIEW_STANDARD_LIBRARY {
        selected_module = -1;
        selected_symbol = -1;
        selected_type = -1;
        reset_reference_folds();
    }
    if view == APP_VIEW_SEARCH search_page = 0;
}

manual_select_section :: (section: s32) #c_call {
    if section < -1 || section >= SECTION_COUNT return;
    clear_scroll_target();
    selected_section = section;
    app_view = APP_VIEW_MANUAL;
}

reset_reference_folds :: () {
    for index: 0..REFERENCE_FOLD_COUNT {
        // Keep the index and section headings open; individual method and
        // instance bodies unfold on demand or when reached by a direct link.
        reference_folded[index] = index >= REFERENCE_METHOD_FOLD;
        reference_fold_visible[index] = false;
    }
}

manual_select_module :: (module: s32) #c_call {
    clear_scroll_target();
    app_view = APP_VIEW_STANDARD_LIBRARY;
    selected_symbol = -1;
    selected_type = -1;
    selected_module = -1;
    if module >= 0 && module < STD_MODULE_COUNT selected_module = module;
    reset_reference_folds();
}

manual_select_symbol :: (index: s32) #c_call {
    if index < 0 || index >= STD_SYMBOL_COUNT return;
    prepare_reference_owners();
    manual_select_module(STD_SYMBOL_DOCS[index].module_index);
    selected_symbol = index;
    resolve_search_symbol_target(index);
    reference_folded[REFERENCE_METHOD_FOLD + index] = false;
    if scroll_member >= 0 reference_folded[REFERENCE_MEMBER_FOLD + scroll_member] = false;
    scroll_request = SCROLL_REQUEST_TOP;
    if STD_SYMBOL_DOCS[index].kind == "method" scroll_request = SCROLL_REQUEST_ANCHOR;
}

manual_select_type :: (index: s32) #c_call {
    if index < 0 || index >= STD_SYMBOL_COUNT return;
    symbol := STD_SYMBOL_DOCS[index];
    if symbol.kind != "method" || symbol.owner_typeclass.count > 0 return;
    prepare_reference_owners();
    if reference_owners[index] >= 0 {
        manual_select_symbol(reference_owners[index]);
        return;
    }
    manual_select_module(symbol.module_index);
    selected_type = index;
    scroll_request = SCROLL_REQUEST_TOP;
}

manual_get_symbol :: () -> s32 #c_call { return selected_symbol; }
manual_get_type :: () -> s32 #c_call { return selected_type; }

manual_toggle_fold :: (index: s32) #c_call {
    if index < 0 || index >= REFERENCE_FOLD_COUNT return;
    reference_folded[index] = !reference_folded[index];
    clear_scroll_target();
}

manual_set_search_results :: (data: [*]const s32, count: s32) #c_call {
    if count < 0 count = 0;
    if count > MAX_SEARCH_RESULTS count = MAX_SEARCH_RESULTS;
    search_result_count = count;
    search_page = 0;
    results := cast([*]Search_Result)&search_results;
    i: s32 = 0;
    while i < count {
        results[i].kind = data[i * 2];
        results[i].index = data[i * 2 + 1];
        i = i + 1;
    }
}

manual_get_view :: () -> s32 #c_call { return app_view; }
manual_get_section :: () -> s32 #c_call { return selected_section; }
manual_get_module :: () -> s32 #c_call { return selected_module; }
manual_get_scroll_request :: () -> s32 #c_call { return scroll_request; }
manual_clear_scroll_request :: () #c_call { clear_scroll_target(); }

// Freestanding executables keep only procedures reachable from main. The
// browser asks wasm-ld to export these C-ABI procedures, so keep a runtime
// reference chain that LLVM can later remove from ordinary positive-width
// frames.
manual_keep_browser_exports_reachable :: () {
    empty_result_storage: [1]s32 = .[0];
    manual_set_view(APP_VIEW_MANUAL);
    manual_select_section(0);
    manual_select_module(-1);
    manual_select_symbol(-1);
    manual_select_type(-1);
    manual_get_symbol();
    manual_get_type();
    manual_toggle_fold(-1);
    manual_set_search_results(cast([*]s32)&empty_result_storage, 0);
    manual_get_view();
    manual_get_section();
    manual_get_module();
    manual_get_scroll_request();
    manual_clear_scroll_request();
}

clamp_page :: (page: s32, count: s32, page_size: s32) -> s32 {
    if page < 0 return 0;
    maximum := (count - 1) / page_size;
    if maximum < 0 maximum = 0;
    if page > maximum return maximum;
    return page;
}

render_small_badge :: (index: s32, value: string) {
    badge := column_box();
    badge.layout.sizing.width = fit_axis();
    badge.layout.padding = padding(6, 2);
    badge.backgroundColor = color(244, 240, 232);
    badge.border.color = color(216, 209, 197);

    open_indexed("badge", index, badge);
    emit_text(value, text_style(10, color(109, 107, 102), FONT_MONO_BOLD, 16));
    close_element();
}

render_reference_pager :: (
    previous_name: string,
    next_name: string,
    page: s32,
    count: s32,
    page_size: s32,
) {
    pages := (count + page_size - 1) / page_size;
    if pages <= 1 return;

    pager: Clay_ElementDeclaration;
    pager.layout.sizing.width = grow_axis();
    pager.layout.sizing.height = fit_axis();
    pager.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    pager.layout.childGap = 12;
    pager.layout.padding = padding(0, 12);
    open_element("reference-pager", pager);
    render_pager_button(previous_name, "Previous page", page > 0);
    label_box := column_box();
    label_box.layout.sizing.width = fixed_axis(132);
    label_box.layout.padding = padding(10, 13);
    open_element("page-count", label_box);
    emit_text(tprint("Page {} of {}", page + 1, pages), text_style(12, color(109, 107, 102), FONT_MONO_BOLD, 21));
    close_element();
    render_pager_button(next_name, "Next page", page + 1 < pages);
    close_element();
}

render_source_link :: (index: s32, path: string, line: s32) {
    label := path;
    if line > 0 label = tprint("{}:{} ↗", path, line);
    emit_text(label, source_text_style(10, color(109, 107, 102), 18));
}

render_count_badge :: (index: s32, value: s32) {
    render_small_badge(index, tprint("{}", value));
}

SIGNATURE_SIZE : ssize : 13;
SIGNATURE_MINIMUM : ssize : 9;

// Keep long, unbroken return types within their monospace detail column.
mono_fit_size :: (value: string, budget: ssize) -> u16 {
    longest: ssize = 0;
    run: ssize = 0;
    i: ssize = 0;
    while i <= value.count {
        if i == value.count || value[i] == cast(u8)(#char " ") || value[i] == cast(u8)(#char "\t") {
            if run > longest longest = run;
            run = 0;
        } else {
            run += 1;
        }
        i += 1;
    }
    if longest <= 0 return cast(u16)SIGNATURE_SIZE;
    // The monospace faces the host asks for advance 0.6em per character.
    limit := budget * 5 / (longest * 3);
    if limit >= SIGNATURE_SIZE return cast(u16)SIGNATURE_SIZE;
    if limit <= SIGNATURE_MINIMUM return cast(u16)SIGNATURE_MINIMUM;
    return cast(u16)limit;
}

render_signature_box :: (index: s32, value: string, size: u16 = 13) {
    signature := column_box();
    signature.layout.padding = padding(13, 10);
    signature.backgroundColor = color(244, 241, 234);
    signature.border.color = color(216, 209, 197);
    open_indexed("signature-box", index, signature);
    emit_text(
        value,
        tagged_text_style(
            size, color(23, 50, 158), FONT_MONO, size + 9,
            CLAY_TEXT_WRAP_WORDS, 1,
        ),
    );
    close_element();
}

render_section_heading :: (index: s32, title: string, count: s32) {
    row: Clay_ElementDeclaration;
    row.layout.sizing.width = grow_axis();
    row.layout.sizing.height = fit_axis();
    row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    row.layout.childGap = 12;
    row.layout.padding = padding(0, 10);
    row.border.color = color(216, 209, 197);
    row.border.width.bottom = 1;
    open_indexed("section-heading", index, row);
    title_box := column_box();
    title_box.layout.sizing.width = grow_axis();
    open_indexed("section-title", index, title_box);
    emit_text(title, heading_text_style());
    close_element();
    render_count_badge(200000 + index, count);
    close_element();
}

render_compact_section_heading :: (index: s32, title: string, count: s32) {
    row: Clay_ElementDeclaration;
    row.layout.sizing.width = grow_axis();
    row.layout.sizing.height = fit_axis();
    row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    row.layout.childGap = 12;
    row.layout.padding = padding(0, 4);
    open_indexed("compact-section-heading", index, row);
    title_box := column_box();
    title_box.layout.sizing.width = grow_axis();
    open_indexed("compact-section-title", index, title_box);
    emit_text(title, text_style(11, color(109, 107, 102), FONT_SANS_BOLD, 18));
    close_element();
    render_count_badge(205000 + index, count);
    close_element();
}

render_detail_cell :: (name: string, index: s32, value: string, style_kind: s32) {
    cell := column_box();
    cell.layout.sizing.width = grow_axis(80);
    // Keep adjacent columns distinct when a long effect name, such as
    // `released_by`, consumes the complete content width of its cell.
    cell.layout.padding = padding(6, 12);
    open_indexed(name, index, cell);
    if style_kind == 1 {
        emit_text(value, text_style(13, color(23, 50, 158), FONT_MONO, 22));
    } else if style_kind == 2 {
        emit_text(value, text_style(13, color(109, 107, 102), FONT_SANS, 22));
    } else {
        emit_text(value, text_style(11, color(109, 107, 102), FONT_SANS_BOLD, 20));
    }
    close_element();
}

render_detail_table :: (
    index: s32,
    first_row: s32,
    count: s32,
    first_header: string,
    second_header: string,
    third_header: string,
    columns: s32,
) {
    table := column_box();
    table.layout.padding = padding(0, 2);
    table.layout.padding.bottom = 16;
    table.backgroundColor = color(255, 253, 248);
    table.userData = cast([*]void)"table-scroll".data;
    if reference_viewport_width < 1120.0 table.layout.sizing.width = fixed_axis(article_content_width() - 32);
    open_indexed("detail-table", index, table);
    header: Clay_ElementDeclaration;
    header.layout.sizing.width = grow_axis();
    header.layout.sizing.height = fit_axis();
    header.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    header.border.color = color(216, 209, 197);
    header.border.width.bottom = 1;
    if reference_viewport_width < 1120.0 header.layout.sizing.width = fixed_axis(content_table_width());
    open_indexed("detail-table-header", index, header);
    render_detail_cell("detail-head-one", index, first_header, 0);
    render_detail_cell("detail-head-two", index, second_header, 0);
    if columns == 3 render_detail_cell("detail-head-three", index, third_header, 0);
    close_element();

    relative: s32 = 0;
    while relative < count {
        row_index := first_row + relative;
        row_value := STD_DETAIL_ROWS[row_index];
        row: Clay_ElementDeclaration;
        row.layout.sizing.width = grow_axis();
        row.layout.sizing.height = fit_axis();
        row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
        row.border.color = color(216, 209, 197);
        row.border.width.bottom = 1;
        if reference_viewport_width < 1120.0 row.layout.sizing.width = fixed_axis(content_table_width());
        open_indexed("detail-table-row", row_index, row);
        render_detail_cell("detail-one", row_index, row_value.first, 1);
        render_detail_cell("detail-two", row_index, row_value.second, 1);
        if columns == 3 render_detail_cell("detail-three", row_index, row_value.third, 2);
        close_element();
        relative = relative + 1;
    }
    close_element();
}

render_module_card :: (index: s32) {
    module := STD_MODULE_DOCS[index];
    id := Clay_GetElementIdWithIndex(clay_string("module-card"), cast(u32)index);
    row := column_box(12);
    row.layout.padding = padding(0, 6);
    if reference_viewport_width >= 1000.0 row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    if Clay_PointerOver(id) row.backgroundColor = color(248, 245, 238);
    open_id(id, row);
    title := column_box();
    if reference_viewport_width >= 1000.0 title.layout.sizing.width = fixed_axis(300);
    open_indexed("module-card-title", index, title);
    name_width := article_content_width();
    if reference_viewport_width >= 1000.0 name_width = 300;
    emit_text(wrap_path(module.name, cast(ssize)(name_width / 9)), route_text_style(APP_VIEW_STANDARD_LIBRARY, index, 14, true));
    close_element();
    emit_text(module.compact_summary, text_style(16, color(66, 65, 62), FONT_BODY, 24));
    close_element();
}

render_standard_index :: () {
    emit_text("Standard library", heading_text_style(26, true));
    subheading(9000, "The Glosso Standard Library");
    paragraph(9001, "The standard library provides the types and operations used by Glosso programs. Browse modules for collections, strings, I/O, mathematics, platform services, and compiler tools.");
    subheading(9002, "How to read this documentation");
    paragraph(9003, "Search for a declaration by name or function signature, or choose a module below. Each module lists its types, typeclasses, constants, and functions. Select an item to open its documentation. Type pages include their methods and associated functions. Use the arrows to fold sections and implementation details; source links open the corresponding declaration.");
    paragraph(9004, "For language syntax, program structure, and compiler usage, start with the language manual.");
    emit_text("Language manual", route_text_style(APP_VIEW_MANUAL, -1));
    render_section_heading(9005, "Modules", STD_MODULE_COUNT);
    list := column_box();
    open_element("module-list", list);
    for index: 0..STD_MODULE_COUNT render_module_card(cast(s32)index);
    close_element();
}

render_symbol_header :: (
    index: s32,
    name: string,
    kind: string,
    path: string,
    line: s32,
    anchor: bool = false,
    link_index: s32 = -1,
) {
    header: Clay_ElementDeclaration;
    header.layout.sizing.width = grow_axis();
    header.layout.sizing.height = fit_axis();
    header.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    header.layout.childGap = 12;
    if reference_viewport_width < 1000.0 header.layout.layoutDirection = CLAY_TOP_TO_BOTTOM;
    open_indexed("symbol-header", index, header);
    identity: Clay_ElementDeclaration;
    identity.layout.sizing.width = grow_axis();
    identity.layout.sizing.height = fit_axis();
    identity.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    identity.layout.childGap = 12;
    if reference_viewport_width < 520.0 identity.layout.layoutDirection = CLAY_TOP_TO_BOTTOM;
    open_indexed("symbol-identity", index, identity);
    name_style := text_style(18, color(23, 50, 158), FONT_MONO_BOLD, 27);
    // The host scrolls the document to whichever name carries this marker.
    if anchor name_style.userData = cast([*]void)SYMBOL_ANCHOR_MARKER.data;
    if link_index >= 0 {
        name_style = item_text_style(link_index, false, 18);
        if anchor name_style.userData = cast([*]void)frame_text_copy(tprint("anchor-item:{}:0;                                                ", link_index)).data;
    }
    emit_text(name, name_style);
    render_small_badge(220000 + index, kind);
    close_element();
    render_source_link(index, path, line);
    close_element();
}

render_function_details :: (
    index: s32,
    first_parameter: s32,
    parameter_count: s32,
    return_type: string,
    first_memory: s32,
    memory_count: s32,
    memory_declared: bool,
) {
    layout: Clay_ElementDeclaration;
    layout.layout.sizing.width = grow_axis();
    layout.layout.sizing.height = fit_axis();
    layout.layout.childGap = 24;
    if reference_viewport_width >= 1120.0 {
        layout.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    } else {
        layout.layout.layoutDirection = CLAY_TOP_TO_BOTTOM;
    }
    open_indexed("function-details", index, layout);
    parameters := column_box(10);
    parameters.layout.sizing.width = grow_axis(280);
    open_indexed("function-parameters", index, parameters);
    render_section_heading(300000 + index, "Parameters", parameter_count);
    if parameter_count > 0 {
        render_detail_table(310000 + index, first_parameter, parameter_count, "PARAMETER", "TYPE", "DETAILS", 3);
    } else {
        emit_text("No parameters.", text_style(13, color(109, 107, 102), FONT_SANS, 22));
    }
    close_element();
    side := column_box(20);
    if reference_viewport_width >= 1120.0 {
        side.layout.sizing.width = fixed_axis(300);
    } else {
        side.layout.sizing.width = grow_axis();
    }
    open_indexed("function-side", index, side);
    emit_text("RETURN TYPE", text_style(11, color(109, 107, 102), FONT_SANS_BOLD, 18));
    // 300px of column, or the full article width once the layout stacks, less
    // the 13px the signature box pads with on each side.
    return_budget: ssize = 274;
    if reference_viewport_width < 1120.0 return_budget = 718;
    render_signature_box(320000 + index, return_type, mono_fit_size(return_type, return_budget));
    close_element();
    close_element();
    // Use the article width so result paths and release identities remain readable.
    memory := column_box(10);
    memory.layout.padding = padding(0, 12);
    open_indexed("function-memory", index, memory);
    render_compact_section_heading(330000 + index, "#MEMORY CONTRACTS", memory_count);
    if memory_count > 0 {
        render_detail_table(340000 + index, first_memory, memory_count, "EFFECT", "TARGETS / VALUES", "", 2);
    } else if memory_declared {
        emit_text("Written empty contract (#memory {}).", text_style(13, color(109, 107, 102), FONT_SANS, 22));
    } else {
        emit_text("No written #memory contract; effects may be inferred by the compiler.", text_style(13, color(109, 107, 102), FONT_SANS, 22));
    }
    close_element();
}

render_type_details :: (index: s32, symbol: Std_Symbol_Doc) {
    if symbol.detail_kind.count == 0 return;
    if symbol.detail_kind == "fields" {
        render_section_heading(350000 + index, "Fields", symbol.detail_count);
        if symbol.detail_count > 0 render_detail_table(360000 + index, symbol.first_detail, symbol.detail_count, "FIELD", "TYPE", "DETAILS", 3);
    } else if symbol.detail_kind == "flags" {
        render_section_heading(350000 + index, "Flags", symbol.detail_count);
        if symbol.detail_count > 0 render_detail_table(360000 + index, symbol.first_detail, symbol.detail_count, "FLAG", "DECLARED VALUE", "", 2);
    } else if symbol.detail_kind == "values" {
        render_section_heading(350000 + index, "Variants", symbol.detail_count);
        if symbol.detail_count > 0 render_detail_table(360000 + index, symbol.first_detail, symbol.detail_count, "VARIANT", "DECLARED VALUE", "", 2);
    } else {
        render_section_heading(350000 + index, "Variants", symbol.detail_count);
        if symbol.detail_count > 0 render_detail_table(360000 + index, symbol.first_detail, symbol.detail_count, "VARIANT", "PAYLOAD TYPE", "", 2);
    }
}

render_typeclass_member :: (member_index: s32, module_index: s32) {
    member := STD_MEMBER_DOCS[member_index];
    card := column_box(10);
    card.layout.padding = padding(0, 16);
    card.border.color = color(216, 209, 197);
    card.border.width.top = 1;
    open_indexed("typeclass-member", member_index, card);
    badge := "required";
    if member.has_default badge = "default";
    link_index: s32 = -1;
    module := STD_MODULE_DOCS[module_index];
    for index: module.first_symbol..module.first_symbol + module.symbol_count {
        symbol := STD_SYMBOL_DOCS[index];
        if symbol.name == member.name && symbol.source_path == member.source_path &&
           symbol.source_line == member.source_line { link_index = cast(s32)index; break; }
    }
    render_symbol_header(
        400000 + member_index, member.name, badge,
        member.source_path, member.source_line,
        member_index == scroll_member, link_index,
    );
    render_signature_box(410000 + member_index, member.signature);
    render_reference_fold(REFERENCE_MEMBER_FOLD + member_index, "Documentation", -1, false);
    if reference_folded[REFERENCE_MEMBER_FOLD + member_index] { close_element(); return; }
    if member.summary.count > 0 emit_text(member.summary, text_style(16, color(66, 65, 62), FONT_BODY, 26));
    if member.kind == "method" {
        render_function_details(
            420000 + member_index,
            member.first_parameter,
            member.parameter_count,
            member.return_type,
            member.first_memory,
            member.memory_count,
            member.memory_declared,
        );
    }
    close_element();
}

render_typeclass_members :: (symbol_index: s32, symbol: Std_Symbol_Doc, member_kind: string) {
    count := symbol.associated_count;
    title := "Associated types";
    if member_kind == "method" {
        count = symbol.method_count;
        title = "Methods";
    }
    if count <= 0 return;
    key: s32 = 8;
    if member_kind == "method" key = 7;
    render_reference_fold(key, title, count);
    if reference_folded[key] return;
    section := column_box(0);
    section.layout.padding = padding(16, 10);
    section.border.color = color(216, 209, 197);
    section.border.width.left = 1;
    open_indexed("typeclass-members", 430000 + symbol_index + count, section);
    relative: s32 = 0;
    while relative < symbol.member_count {
        member_index := symbol.first_member + relative;
        if STD_MEMBER_DOCS[member_index].kind == member_kind render_typeclass_member(member_index, symbol.module_index);
        relative = relative + 1;
    }
    close_element();
}

render_typeclass_instances :: (symbol_index: s32, symbol: Std_Symbol_Doc) {
    if symbol.instance_count <= 0 return;
    section := column_box(0);
    section.layout.padding = padding(16, 10);
    section.border.color = color(216, 209, 197);
    section.border.width.left = 1;
    open_indexed("instances", symbol_index, section);
    render_reference_fold(9, "Implementations", symbol.instance_count);
    if reference_folded[9] { close_element(); return; }
    relative: s32 = 0;
    while relative < symbol.instance_count {
        instance_index := symbol.first_instance + relative;
        instance := STD_INSTANCE_DOCS[instance_index];
        card := column_box(10);
        card.layout.padding = padding(0, 16);
        card.border.color = color(216, 209, 197);
        card.border.width.bottom = 1;
        open_indexed("instance-card", instance_index, card);
        render_symbol_header(460000 + instance_index, instance.head, "instance", instance.source_path, instance.source_line);
        emit_text(instance.module, text_style(10, color(109, 107, 102), FONT_MONO_BOLD, 18));
        render_reference_fold(REFERENCE_INSTANCE_FOLD + instance_index, "Implementation", -1, false);
        if !reference_folded[REFERENCE_INSTANCE_FOLD + instance_index]
            render_signature_box(470000 + instance_index, instance.signature);
        close_element();
        relative = relative + 1;
    }
    close_element();
}

render_typeclass_details :: (index: s32, symbol: Std_Symbol_Doc) {
    minimal := column_box(10);
    minimal.layout.padding = padding(16, 10);
    minimal.border.color = color(233, 104, 45);
    minimal.border.width.left = 2;
    open_indexed("minimal-implementation", index, minimal);
    emit_text("MINIMAL COMPLETE IMPLEMENTATION", text_style(11, color(109, 107, 102), FONT_SANS_BOLD, 18));
    render_signature_box(480000 + index, symbol.minimal);
    if symbol.minimal_explicit {
        emit_text("Declared by #minimal. A comma requires both sides; a vertical bar permits either side.", text_style(13, color(109, 107, 102), FONT_SANS, 22));
    } else {
        emit_text("Implicit: every method without a default implementation must be supplied by an instance.", text_style(13, color(109, 107, 102), FONT_SANS, 22));
    }
    close_element();
    render_typeclass_members(index, symbol, "associated-type");
    render_typeclass_members(index, symbol, "method");
    render_typeclass_instances(index, symbol);
}

render_symbol_body :: (index: s32, show_summary: bool = true) {
    symbol := STD_SYMBOL_DOCS[index];
    if show_summary && symbol.summary.count > 0 emit_text(symbol.summary, text_style(16, color(66, 65, 62), FONT_BODY, 26));
    if symbol.kind == "type" && symbol.detail_kind != "function-pointer"
        render_type_details(index, symbol);
    if symbol.kind == "function" || symbol.kind == "method" ||
       symbol.detail_kind == "function-pointer" {
        render_function_details(
            index,
            symbol.first_parameter,
            symbol.parameter_count,
            symbol.return_type,
            symbol.first_memory,
            symbol.memory_count,
            symbol.memory_declared,
        );
    }
}

render_symbol_card :: (index: s32, foldable: bool = false) {
    symbol := STD_SYMBOL_DOCS[index];
    card := column_box(10);
    card.layout.padding = padding(0, 12);
    card.border.color = color(216, 209, 197);
    card.border.width.bottom = 1;
    open_indexed("symbol-card", index, card);
    render_symbol_header(index, symbol.name, symbol.kind, symbol.source_path, symbol.source_line,
                         index == scroll_symbol && scroll_member < 0, index);
    render_signature_box(index, symbol.signature);
    if foldable render_reference_fold(REFERENCE_METHOD_FOLD + index, "Documentation", -1, false);
    if !foldable || !reference_folded[REFERENCE_METHOD_FOLD + index] render_symbol_body(index);
    close_element();
}

// Only the final dot separates a receiver from its method: array receivers
// and typed pointers may themselves contain punctuation.
method_owner_name :: (symbol: Std_Symbol_Doc) -> string {
    index := symbol.name.count;
    while index > 0 {
        index -= 1;
        if symbol.name[index] == cast(u8)(#char ".") return symbol.name[0..index];
    }
    return symbol.name;
}

method_owner_base :: (symbol: Std_Symbol_Doc) -> string {
    name := method_owner_name(symbol);
    for index: 1..name.count {
        if name[index] == cast(u8)(#char "(") return name[0..index];
    }
    return name;
}

prepare_reference_owners :: () {
    if reference_owners_ready return;
    reference_owners_ready = true;
    for index: 0..STD_SYMBOL_COUNT {
        reference_owners[index] = -1;
        method := STD_SYMBOL_DOCS[index];
        if method.kind != "method" || method.owner_typeclass.count > 0 continue;
        name := method_owner_base(method);
        best: s32 = -1;
        best_score: s32 = -1;
        ambiguous := false;
        for candidate: 0..STD_SYMBOL_COUNT {
            owner := STD_SYMBOL_DOCS[candidate];
            if owner.kind != "type" || owner.name != name continue;
            // Prefer the declaring module, then the closest shared module
            // path. Do not attach methods to an ambiguous namesake.
            score: s32 = 0;
            left := STD_MODULE_DOCS[method.module_index].name;
            right := STD_MODULE_DOCS[owner.module_index].name;
            offset: ssize = 0;
            while offset < left.count && offset < right.count && left[offset] == right[offset] {
                if left[offset] == cast(u8)(#char "/") score = cast(s32)offset + 1;
                offset += 1;
            }
            if method.module_index == owner.module_index score = 100000;
            if score > best_score {
                best = cast(s32)candidate;
                best_score = score;
                ambiguous = false;
            } else if score == best_score ambiguous = true;
        }
        if !ambiguous reference_owners[index] = best;
    }
}

// A module lists each receiver once, even when its declaration lives in a
// different module or is a built-in type such as string or [..]$T.
module_owner_row :: (index: s32) -> bool {
    symbol := STD_SYMBOL_DOCS[index];
    if symbol.kind != "method" || symbol.owner_typeclass.count > 0 return false;
    owner := reference_owners[index];
    if owner >= 0 && STD_SYMBOL_DOCS[owner].module_index == symbol.module_index return false;
    module := STD_MODULE_DOCS[symbol.module_index];
    for previous: module.first_symbol..index {
        other := STD_SYMBOL_DOCS[previous];
        if other.kind != "method" || other.owner_typeclass.count > 0 continue;
        if owner >= 0 && reference_owners[previous] == owner return false;
        if owner < 0 && reference_owners[previous] < 0 &&
           method_owner_name(other) == method_owner_name(symbol) return false;
    }
    return true;
}

module_item_group :: (index: s32) -> s32 {
    symbol := STD_SYMBOL_DOCS[index];
    if symbol.kind == "type" || module_owner_row(index) return 0;
    if symbol.kind == "typeclass" return 1;
    if symbol.kind == "constant" return 2;
    if symbol.kind == "function" return 3;
    return -1;
}

render_reference_fold :: (key: s32, title: string, count: s32 = -1, heading: bool = true) {
    reference_fold_visible[key] = true;
    row := column_box(12);
    row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    row.layout.padding = padding(0, 8);
    if heading {
        row.border.color = color(216, 209, 197);
        row.border.width.bottom = 1;
    }
    open_indexed("reference-fold", key, row);
    style := text_style(13, color(109, 107, 102), FONT_SANS, 24);
    if heading style = heading_text_style();
    expanded: s32 = 1;
    heading_tag: s32 = 0;
    arrow := "▾";
    if reference_folded[key] { expanded = 0; arrow = "▸"; }
    if heading heading_tag = 1;
    style.userData = cast([*]void)frame_text_copy(tprint("fold:{}:{}:{};                                                ", key, expanded, heading_tag)).data;
    emit_text(tprint("{} {}", arrow, title), style);
    if count >= 0 render_count_badge(600000 + key, count);
    close_element();
}

compact_symbol_summary :: (value: string) -> string {
    if value.count <= 180 return value;
    end: ssize = 180;
    while end > 0 && value[end] != cast(u8)(#char " ") end -= 1;
    if end == 0 return "";
    return tprint("{}…", value[0..end]);
}

render_module_item :: (index: s32) {
    symbol := STD_SYMBOL_DOCS[index];
    name := symbol.name;
    summary := symbol.summary;
    owner_row := symbol.kind == "method";
    target := index;
    virtual_owner := false;
    if owner_row {
        target = reference_owners[index];
        if target >= 0 {
            name = STD_SYMBOL_DOCS[target].name;
            summary = STD_SYMBOL_DOCS[target].summary;
        } else {
            target = index;
            virtual_owner = true;
            name = method_owner_name(symbol);
            summary = "Methods and associated functions.";
        }
    }
    row := column_box(8);
    row.layout.padding = padding(0, 6);
    if reference_viewport_width >= 1000.0 row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    open_indexed("module-item", index, row);
    label := column_box();
    label_width := article_content_width();
    if reference_viewport_width >= 1000.0 {
        label_width = 280;
        label.layout.sizing.width = fixed_axis(label_width);
    }
    open_indexed("module-item-label", index, label);
    emit_text(wrap_path(name, cast(ssize)(label_width / 9)), item_text_style(target, virtual_owner));
    close_element();
    if summary.count > 0 emit_text(compact_symbol_summary(summary), text_style(16, color(66, 65, 62), FONT_BODY, 24));
    close_element();
}

render_standard_module :: () {
    module := STD_MODULE_DOCS[selected_module];
    emit_text("Standard library", route_text_style(APP_VIEW_STANDARD_LIBRARY, -1, 13));
    emit_text(wrap_path(module.name, cast(ssize)(article_content_width() / 19)), heading_text_style(26, true));
    render_source_link(9101, module.source_path, 0);
    render_reference_fold(4, "Module description", -1, false);
    if !reference_folded[4] paragraph(9100, module.summary);
    groups: [4]string = .["Types", "Typeclasses", "Constants", "Functions"];
    for group: 0..4 {
        count: s32 = 0;
        for index: module.first_symbol..module.first_symbol + module.symbol_count {
            if module_item_group(cast(s32)index) == group count += 1;
        }
        if count == 0 continue;
        render_reference_fold(cast(s32)group, groups[group], count);
        if reference_folded[group] continue;
        for index: module.first_symbol..module.first_symbol + module.symbol_count {
            if module_item_group(cast(s32)index) == group render_module_item(cast(s32)index);
        }
    }
    if module.symbol_count == 0 paragraph(9102, "This module has no public items.");
}

method_on_page :: (index: s32, owner: s32, receiver: s32) -> bool {
    symbol := STD_SYMBOL_DOCS[index];
    if symbol.kind != "method" || symbol.owner_typeclass.count > 0 return false;
    if owner >= 0 return reference_owners[index] == owner;
    if receiver < 0 return false;
    source := STD_SYMBOL_DOCS[receiver];
    return reference_owners[index] < 0 && symbol.module_index == source.module_index &&
           method_owner_name(symbol) == method_owner_name(source);
}

render_inherent_methods :: (owner: s32, receiver: s32) {
    count: s32 = 0;
    for index: 0..STD_SYMBOL_COUNT {
        if method_on_page(cast(s32)index, owner, receiver) count += 1;
    }
    if count == 0 return;
    render_reference_fold(7, "Methods and associated functions", count);
    if reference_folded[7] return;
    for index: 0..STD_SYMBOL_COUNT {
        if method_on_page(cast(s32)index, owner, receiver) render_symbol_card(cast(s32)index, true);
    }
}

render_standard_symbol :: () {
    target := selected_symbol;
    receiver := selected_type;
    if target >= 0 && STD_SYMBOL_DOCS[target].kind == "method" {
        symbol := STD_SYMBOL_DOCS[target];
        if symbol.owner_typeclass.count > 0 {
            target = resolve_search_symbol_target(target);
        } else {
            receiver = target;
            target = reference_owners[target];
        }
    }
    emit_text("Standard library", route_text_style(APP_VIEW_STANDARD_LIBRARY, -1, 13));
    module_index := selected_module;
    if target >= 0 module_index = STD_SYMBOL_DOCS[target].module_index;
    emit_text(STD_MODULE_DOCS[module_index].name, route_text_style(APP_VIEW_STANDARD_LIBRARY, module_index, 14, true));
    if target >= 0 {
        symbol := STD_SYMBOL_DOCS[target];
        emit_text(wrap_path(symbol.name, cast(ssize)(article_content_width() / 19)), heading_text_style(26, true));
        render_small_badge(9104, symbol.kind);
        render_source_link(9105, symbol.source_path, symbol.source_line);
        render_signature_box(target, symbol.signature);
        if symbol.summary.count > 0 {
            render_reference_fold(4, "Description", -1, false);
            if !reference_folded[4] emit_text(symbol.summary, text_style(16, color(66, 65, 62), FONT_BODY, 26));
        }
        render_symbol_body(target, false);
        if symbol.kind == "typeclass" render_typeclass_details(target, symbol);
        if symbol.kind == "type" render_inherent_methods(target, -1);
    } else if receiver >= 0 {
        name := method_owner_name(STD_SYMBOL_DOCS[receiver]);
        emit_text(wrap_path(name, cast(ssize)(article_content_width() / 19)), heading_text_style(26, true));
        render_small_badge(9104, "type");
        render_inherent_methods(-1, receiver);
    }
}

render_standard_article :: () {
    prepare_reference_owners();
    for index: 0..REFERENCE_FOLD_COUNT reference_fold_visible[index] = false;
    if selected_module < 0 render_standard_index();
    else if selected_symbol >= 0 || selected_type >= 0 render_standard_symbol();
    else render_standard_module();
}

search_result_title :: (result: Search_Result) -> string {
    if result.kind == 0 return section_title(result.index);
    if result.kind == 1 return STD_MODULE_DOCS[result.index].name;
    return STD_SYMBOL_DOCS[result.index].name;
}

search_result_meta :: (result: Search_Result) -> string {
    if result.kind == 0 return "Language manual";
    if result.kind == 1 return tprint("Module · {} symbols", STD_MODULE_DOCS[result.index].symbol_count);
    symbol := STD_SYMBOL_DOCS[result.index];
    return tprint("{} · {}", symbol.kind, STD_MODULE_DOCS[symbol.module_index].name);
}

render_search_result :: (position: s32, result: Search_Result) {
    id := Clay_GetElementIdWithIndex(clay_string("search-result"), cast(u32)position);
    card := column_box(8);
    card.layout.padding = padding(0, 12);
    card.cornerRadius = radius(0);
    card.backgroundColor = color(255, 253, 248);
    card.border.color = color(216, 209, 197);
    card.border.width.bottom = 1;
    if Clay_PointerOver(id) {
        card.backgroundColor = color(248, 245, 238);
    }
    open_id(id, card);
    emit_text(search_result_title(result), action_text_style(text_style(18, color(23, 50, 158), FONT_MONO_BOLD, 26)));
    emit_text(search_result_meta(result), text_style(10, color(109, 107, 102), FONT_MONO_BOLD, 18));
    if result.kind == 1 {
        emit_text(STD_MODULE_DOCS[result.index].summary, text_style(14, color(109, 107, 102), FONT_SANS, 24));
    } else if result.kind == 2 {
        symbol := STD_SYMBOL_DOCS[result.index];
        render_signature_box(600000 + position, symbol.signature);
        if symbol.summary.count > 0 {
            emit_text(symbol.summary, text_style(14, color(109, 107, 102), FONT_SANS, 24));
        }
    }
    close_element();
}

render_search_article :: () {
    emit_text("Search results", heading_text_style(26, true));
    paragraph(9200, #string,oneline
        \\Search the language manual and all public standard-library declarations. Function-shape queries such as `(ssize, ssize) -> ssize` unify compatible generic signatures.
    );

    if search_result_count == 0 {
        paragraph(9201, "No results to display. Enter a name or function signature in the search field, or try a shorter query.");
        return;
    }

    emit_text(tprint("{} MATCHES", search_result_count), text_style(11, color(36, 73, 216), FONT_MONO_BOLD, 18));
    search_page = clamp_page(search_page, search_result_count, SEARCH_RESULTS_PER_PAGE);
    start := search_page * SEARCH_RESULTS_PER_PAGE;
    i := start;
    while i < start + SEARCH_RESULTS_PER_PAGE && i < search_result_count {
        render_search_result(i, search_results[i]);
        i = i + 1;
    }
    render_reference_pager(
        "previous-search-page", "next-search-page",
        search_page, search_result_count, SEARCH_RESULTS_PER_PAGE,
    );
}

handle_standard_navigation :: () {
    for key: 0..REFERENCE_FOLD_COUNT {
        if reference_fold_visible[key] &&
           Clay_PointerOver(Clay_GetElementIdWithIndex(clay_string("reference-fold"), cast(u32)key)) {
            manual_toggle_fold(cast(s32)key);
            return;
        }
    }
    if selected_module < 0 {
        for index: 0..STD_MODULE_COUNT {
            if Clay_PointerOver(Clay_GetElementIdWithIndex(clay_string("module-card"), cast(u32)index)) {
                manual_select_module(cast(s32)index);
                return;
            }
        }
        return;
    }
    if selected_symbol >= 0 || selected_type >= 0 return;
    module := STD_MODULE_DOCS[selected_module];
    for index: module.first_symbol..module.first_symbol + module.symbol_count {
        if Clay_PointerOver(Clay_GetElementIdWithIndex(clay_string("module-item"), cast(u32)index)) {
            if STD_SYMBOL_DOCS[index].kind == "method" manual_select_type(cast(s32)index);
            else manual_select_symbol(cast(s32)index);
            return;
        }
    }
}

// Typeclass operations open the owning class and anchor on the matching
// member, including overloaded names distinguished by their source location.
resolve_search_symbol_target :: (symbol_index: s32) -> s32 {
    symbol := STD_SYMBOL_DOCS[symbol_index];
    scroll_symbol = symbol_index;
    scroll_member = -1;
    if symbol.kind != "method" || symbol.owner_typeclass.count == 0 return symbol_index;

    module := STD_MODULE_DOCS[symbol.module_index];
    relative: s32 = 0;
    while relative < module.symbol_count {
        owner_index := module.first_symbol + relative;
        owner := STD_SYMBOL_DOCS[owner_index];
        if owner.kind == "typeclass" {
            offset: s32 = 0;
            while offset < owner.member_count {
                member_index := owner.first_member + offset;
                member := STD_MEMBER_DOCS[member_index];
                if member.kind == "method" && member.name == symbol.name &&
                   member.source_line == symbol.source_line {
                    scroll_symbol = owner_index;
                    scroll_member = member_index;
                    return owner_index;
                }
                offset = offset + 1;
            }
        }
        relative = relative + 1;
    }
    return symbol_index;
}

handle_search_navigation :: () {
    start := search_page * SEARCH_RESULTS_PER_PAGE;
    i := start;
    while i < start + SEARCH_RESULTS_PER_PAGE && i < search_result_count {
        id := Clay_GetElementIdWithIndex(clay_string("search-result"), cast(u32)i);
        if Clay_PointerOver(id) {
            result := search_results[i];
            if result.kind == 0 {
                selected_section = result.index;
                app_view = APP_VIEW_MANUAL;
            } else if result.kind == 1 {
                manual_select_module(result.index);
            } else {
                manual_select_symbol(result.index);
            }
            return;
        }
        i = i + 1;
    }
    if search_page > 0 && Clay_PointerOver(Clay_GetElementId(clay_string("previous-search-page"))) {
        search_page = search_page - 1;
    }
    if (search_page + 1) * SEARCH_RESULTS_PER_PAGE < search_result_count &&
       Clay_PointerOver(Clay_GetElementId(clay_string("next-search-page"))) {
        search_page = search_page + 1;
    }
}

}
