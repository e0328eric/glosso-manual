#import "Format";
#import "String_Builder";
#import "Math/Core";
#import "clay_ui.glo";

#public {

// Chapters 25-32: Types and Values.

render_section_25 :: () {
    paragraph(0, #string,oneline
        \\This chapter lists every type the compiler provides without a
        \\declaration, with the size and alignment of each, and describes the
        \\built-in types that have no chapter of their own: `void`, `#Never`,
        \\`any`, and the types whose values exist only at compile time. Every
        \\other type of a program is built from these, either with one of the
        \\type constructors listed below or by a declaration. No import is
        \\needed to name a built-in type; importing a module such as
        \\`Math/Complex` or `Simd` adds operations, not the types themselves.
        \\Values, Variables, and Arithmetic introduces the everyday numeric
        \\types by example.
    );
    subheading(1, "The primitive types");
    paragraph(2, #string,oneline
        \\The primitive types fall into the families below. The last column
        \\names the chapter that describes each family in full.
    );
    table_header(3, "Family   —   Types   —   Described in");
    table_row(4, "Signed integers   |   `s8` `s16` `s32` `s64` `s128` `ssize`, and `sN` for any width N from 1 to 65535   |   Integer Arithmetic, Overflow, and Traps");
    table_row(5, "Unsigned integers   |   `u8` `u16` `u32` `u64` `u128` `usize`, and `uN`   |   Integer Arithmetic, Overflow, and Traps");
    table_row(6, "Unicode scalar   |   `rune`   |   Text and Character Literals");
    table_row(7, "Floating point   |   `f16` `f32` `f64` `f80` `f128`   |   Floating-Point and Complex Arithmetic");
    table_row(8, "Complex   |   `c32` `c64` `c128` `c160` `c256`   |   Floating-Point and Complex Arithmetic");
    table_row(9, "Boolean   |   `bool`   |   `bool` and Conditions");
    table_row(10, "Text   |   `str` `cstr` `string16` `cstring16`   |   `str`, `cstr`, and UTF-16 Text");
    table_row(11, "Vectors and matrices   |   `Simd(T, N)` `Matrix(T, Rows, Cols)`   |   `Simd` Vectors and `Matrix` Values");
    table_row(12, "No value   |   `void` `#Never`   |   this chapter");
    table_row(13, "A value of any type   |   `any`   |   this chapter");
    table_row(14, "Jump target   |   `label`   |   Labels, `goto`, and Non-Local Transfers");
    table_row(15, "Compile-time values   |   `type` `Code` `Pattern` `Namespace` `Library`   |   this chapter, and `type` Values and Type Reflection");
    subheading(16, "Types built from other types");
    paragraph(17, #string,oneline
        \\A pointer, array, optional, tuple or procedure type is written with a
        \\type constructor around one or more existing types and needs no
        \\declaration. Records, unions and enumerations are declared and get a
        \\name of their own.
    );
    table_header(18, "Written   —   Type   —   Described in");
    table_row(19, "`*T`, `*const T`   |   a pointer to one value, never null   |   Pointer Types");
    table_row(20, "`[*]T`   |   a pointer to a run of values   |   Pointer Types");
    table_row(21, "`?T`   |   a value of type `T`, or `null`   |   `?T` and `E!T`");
    table_row(22, "`E!T`   |   a value of type `T`, or an error of type `E`   |   `?T` and `E!T`");
    table_row(23, "`[N]T`   |   `N` values stored inline   |   Arrays, Views, Dynamic Arrays, and Slicing");
    table_row(24, "`[]T`, `[]const T`   |   a view of values stored elsewhere   |   Arrays, Views, Dynamic Arrays, and Slicing");
    table_row(25, "`[..]T`   |   a dynamic array with a growable buffer   |   Arrays, Views, Dynamic Arrays, and Slicing");
    table_row(26, "`#soa [..]T`, `#soa []T`   |   the same, stored as one buffer per field   |   `#soa` and `#aos` Storage");
    table_row(27, "`(A, B)`   |   a tuple   |   Tuple Types");
    table_row(28, "`(A) -> R`, `#fn_ptr(a: A) -> R`   |   a pointer to a procedure   |   Lambdas and `#fn_ptr` Values");
    table_row(29, "`struct { ... }`   |   a record of named fields   |   Struct Types");
    table_row(30, "`union { ... }`, `union #raw { ... }`   |   a tagged or an untagged union   |   Tagged and Untagged Unions");
    table_row(31, "`enum { ... }`, `enum_flags { ... }`   |   named values, or named bits   |   `enum` and `enum_flags`");
    table_row(32, "`distinct T`   |   a new type represented like `T`   |   Nominal Types with `distinct`");
    paragraph(33, #string,oneline
        \\`type_name` from the `Meta` module spells a type the way it is written
        \\in source, which makes it a quick way to see what type an expression
        \\has:
    );
    code_block(34, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Error :: enum { Missing; }
        \\
        \\negate :: (x: s64) -> s64 { return -x; }
        \\
        \\main :: () {
        \\    pair: (s64, str) = .(1, "one");
        \\    print("{} {}\n", type_name(*const s64), type_name([*]u8));
        \\    print("{} {}\n", type_name(?*s64), type_name(Error!s64));
        \\    print("{} {} {}\n", type_name([4]s32), type_name([]const s32), type_name([..]s32));
        \\    print("{} {}\n", type_name(type_of(pair)), type_name(type_of(negate)));
        \\}
    );
    code_block(35, "text", #string
        \\*const s64 [*]u8
        \\?*s64 Error!s64
        \\[4]s32 []const s32 [..]s32
        \\(s64, str) (s64) -> s64
    );
    subheading(36, "Sizes and alignments");
    paragraph(37, #string,oneline
        \\`size_of(T)` from the `Meta` module gives the size of a type in
        \\bytes, and `type_info(T).alignment` its alignment. Both are answered
        \\for the target being compiled for, not for the machine running the
        \\compiler.
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    print("s128: size {}, alignment {}\n", size_of(s128), type_info(s128).alignment);
        \\    print("c64: size {}, alignment {}\n", size_of(c64), type_info(c64).alignment);
        \\    print("str: size {}, alignment {}\n", size_of(str), type_info(str).alignment);
        \\}
    );
    code_block(39, "text", #string
        \\s128: size 16, alignment 16
        \\c64: size 8, alignment 4
        \\str: size 16, alignment 8
    );
    paragraph(40, #string,oneline
        \\On `x86_64-pc-linux-gnu` the built-in types have these sizes and
        \\alignments in bytes:
    );
    table_header(41, "Types   —   Size   —   Alignment");
    table_row(42, "`s8` `u8` `bool`   |   1   |   1");
    table_row(43, "`s16` `u16` `f16`   |   2   |   2");
    table_row(44, "`s32` `u32` `f32` `rune`   |   4   |   4");
    table_row(45, "`s64` `u64` `ssize` `usize` `f64`   |   8   |   8");
    table_row(46, "`s128` `u128` `f80` `f128`   |   16   |   16");
    table_row(47, "`c32`   |   4   |   2");
    table_row(48, "`c64`   |   8   |   4");
    table_row(49, "`c128`   |   16   |   8");
    table_row(50, "`c160` `c256`   |   32   |   16");
    table_row(51, "`cstr` `cstring16` `label`   |   8   |   8");
    table_row(52, "`str` `string16` `any`   |   16   |   8");
    table_row(53, "`void` `#Never` `type` `Code` `Pattern` `Namespace` `Library`   |   0   |   1");
    paragraph(54, #string,oneline
        \\Several of these numbers depend on the target. `ssize`, `usize`, the
        \\string types, `label` and `any` follow the pointer width, so on a
        \\32-bit target such as `x86-linux-musl` or `wasm32-wasi` an `ssize` is
        \\4 bytes and a `str` 8. Scalar alignment varies too: on
        \\`x86-linux-musl` an `f64` is aligned to 4 and an `f80` occupies 12
        \\bytes aligned to 4, and on `armv7-linux-musl` an `s128` is aligned to
        \\8. A complex number is aligned like its component, not like the pair.
        \\Field Order, Alignment, and Packing describes how these combine in a
        \\record.
    );
    subheading(55, "`void`");
    paragraph(56, #string,oneline
        \\`void` is the type with exactly one value, written `.()`. It occupies
        \\no storage. A procedure without a return type returns `void`, so a
        \\call to it is an expression of type `void` like any other. Two `void`
        \\values are always equal, and `print` shows the value as `.()`.
    );
    code_block(57, "glosso", #string
        \\#import "Io";
        \\
        \\nothing :: () {}
        \\
        \\main :: () {
        \\    a: void = .();
        \\    b := nothing();
        \\    print("{} {}\n", a, a == b);
        \\}
    );
    code_block(58, "text", #string
        \\.() true
    );
    subheading(59, "`#Never`");
    paragraph(60, #string,oneline
        \\`#Never` is the type of an expression that does not finish: a call to
        \\`exit`, or to any procedure declared with `-> #Never`. It has no
        \\values, so the compiler accepts it wherever any type is expected. A
        \\procedure that ends in such a call needs no `return` after it.
    );
    code_block(61, "glosso", #string
        \\#import "Io";
        \\
        \\fail :: (message: str) -> #Never {
        \\    print("fatal: {}\n", message);
        \\    exit(2);
        \\}
        \\
        \\digit_name :: (n: s64) -> str {
        \\    if n == 0 return "zero";
        \\    if n == 1 return "one";
        \\    fail("not a binary digit");
        \\}
        \\
        \\main :: () {
        \\    print("{}\n", digit_name(1));
        \\    print("{}\n", digit_name(7));
        \\}
    );
    code_block(62, "text", #string
        \\$ glosso --run never.glo 2>&1 | tail -3
        \\one
        \\fatal: not a binary digit
        \\glosso: program exited with status 2
    );
    paragraph(63, #string,oneline
        \\The compiler checks the promise. A `-> #Never` procedure whose body
        \\can reach its end is rejected:
    );
    code_block(64, "text", #string
        \\// f :: () -> #Never { }
        \\error: #Never function 'f' can return normally
    );
    subheading(65, "`any`");
    paragraph(66, #string,oneline
        \\An `any` holds a value of some other type together with a pointer to
        \\the description of that type. Every type converts to `any` without a
        \\cast; this is how `print` accepts arguments of every type. The two
        \\fields are `.type`, a `*const Type_Info` whose record is described in
        \\`type` Values and Type Reflection, and `.value`, a `*void` pointing at
        \\the value. An `any` is two pointers wide.
    );
    code_block(67, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\describe :: (value: any) {
        \\    print("{} ({} bytes): {}\n", value.type.name, value.type.size, value);
        \\}
        \\
        \\main :: () {
        \\    describe(42);
        \\    describe(2.5);
        \\    describe("text");
        \\    describe(cast(u8) 7);
        \\}
    );
    code_block(68, "text", #string
        \\ssize (8 bytes): 42
        \\f64 (8 bytes): 2.5
        \\str (16 bytes): text
        \\u8 (1 bytes): 7
    );
    paragraph(69, #string,oneline
        \\The `any` refers to the value rather than copying it, so it is valid
        \\only as long as the value it was made from. Variadic Procedures shows
        \\how `...any` collects arguments, and `type` Values and Type
        \\Reflection how to inspect them.
    );
    subheading(70, "Compile-time-only types");
    paragraph(71, #string,oneline
        \\`type`, `Code`, `Pattern`, `Namespace` and `Library` have no runtime
        \\representation. Their values exist only while the program is being
        \\compiled. A `type` names a type (`type` Values and Type Reflection), a
        \\`Code` is a fragment of unexpanded source (`#code`, `#insert`, and
        \\`#expand`), a `Pattern` is a match pattern (Coverage, Binding Forms,
        \\and Pattern Constants), a `Namespace` is a module bound to a name by
        \\`Alias :: #import "Module"` (Modules, Imports, and the Prelude), and a
        \\`Library` is a native library named by `#library` (`#foreign`,
        \\`#library`, and `#c_call`).
    );
    subheading(72, "Writing the type of a definition");
    paragraph(73, #string,oneline
        \\The type of a named definition can be written between its two colons,
        \\like the type of any other constant. Aggregate declarations have type
        \\`type`, a procedure has its procedure type, and typeclasses and macros
        \\have the declaration types `Typeclass(...)`, listing the kinds of the
        \\parameters, and `Macro(...)`, giving the signature. These two forms are
        \\valid only in this position.
    );
    code_block(74, "glosso", #string
        \\Point : type : struct { x: ssize; y: ssize; }
        \\twice : (ssize) -> ssize : (x: ssize) -> ssize { return x * 2; }
        \\IO : Namespace : #import "Io";
        \\libc : Library : #library "c";
        \\Render : Typeclass(type) : typeclass (T: type) {}
        \\emit : Macro((ssize) -> void) : (x: ssize) #expand {}
        \\
        \\main :: () {
        \\    IO.print("{}\n", twice(21));
        \\}
    );
    code_block(75, "text", #string
        \\42
    );
    paragraph(76, #string,oneline
        \\The annotation is checked against the definition:
    );
    code_block(77, "text", #string
        \\// Render : Typeclass(type, type) : typeclass (T: type) {}
        \\error: declaration 'Render' has type Typeclass(type), not declared type Typeclass(type, type)
    );
    subheading(78, "Type names are identifiers");
    paragraph(79, #string,oneline
        \\A primitive type name is not a keyword. The compiler looks it up like
        \\any other name, after local and global declarations, so a variable may
        \\be called `ssize` or `str`. Inside that variable's scope the name then
        \\means the variable, and using it as a type is an error:
    );
    code_block(80, "text", #string
        \\// u8 := 3; x: u8 = 4;
        \\error: 'u8' is a variable, not a type
    );
    paragraph(81, #string,oneline
        \\For code produced by Bindgen, the C names `int8_t`, `int16_t`,
        \\`int32_t`, `int64_t`, `uint8_t`, `uint16_t`, `uint32_t`, `uint64_t`
        \\and `__int128` are accepted as other spellings of the fixed-width
        \\integer types. They are the same types, not aliases with an identity of
        \\their own: `int64_t == s64` is `true`, and `type_name(int8_t)` is
        \\`"s8"`.
    );
}

render_section_26 :: () {
    paragraph(0, #string,oneline
        \\This chapter describes the integer types and everything done with
        \\them: their ranges, the default integer `ssize`, the arithmetic,
        \\bitwise and shift operators, and what happens when a result does not
        \\fit. An integer operation whose exact result does not fit its type is
        \\an error in Glosso, not a silent wraparound. At compile time it is a
        \\compile error, and at run time it stops the program in a build with
        \\runtime checks. Code that wants modular or clamped arithmetic says so
        \\with the wrapping and saturating operators, which are never checked.
        \\Values, Variables, and Arithmetic introduces integers by example.
    );
    subheading(1, "Integer types");
    paragraph(2, #string,oneline
        \\An integer type is signed or unsigned and has a fixed width in bits.
        \\`sN` is a signed N-bit integer and `uN` an unsigned one. The usual
        \\widths have the familiar names below; `ssize` and `usize` have the
        \\width of a pointer on the target. All integers use two's complement,
        \\at compile time and at run time alike.
    );
    table_header(3, "Type   —   Range   —   Bytes");
    table_row(4, "`s8`   |   -128 to 127   |   1");
    table_row(5, "`s16`   |   -32768 to 32767   |   2");
    table_row(6, "`s32`   |   -2147483648 to 2147483647   |   4");
    table_row(7, "`s64`   |   -9223372036854775808 to 9223372036854775807   |   8");
    table_row(8, "`s128`   |   -2^127 to 2^127 - 1   |   16");
    table_row(9, "`u8`   |   0 to 255   |   1");
    table_row(10, "`u16`   |   0 to 65535   |   2");
    table_row(11, "`u32`   |   0 to 4294967295   |   4");
    table_row(12, "`u64`   |   0 to 18446744073709551615   |   8");
    table_row(13, "`u128`   |   0 to 2^128 - 1   |   16");
    table_row(14, "`ssize`, `usize`   |   as `s64`, `u64` on a 64-bit target; as `s32`, `u32` on a 32-bit one   |   8 or 4");
    subheading(15, "`ssize` and `usize`");
    paragraph(16, #string,oneline
        \\`ssize` is the integer type the language uses when nothing else is
        \\asked for. An integer literal bound with `:=` becomes an `ssize`, and so
        \\are the `.count` of every array and string, indices, and `it_index` in
        \\a `for` loop. `usize` is its unsigned counterpart, for sizes and
        \\addresses that must not be negative.
    );
    paragraph(17, #string,oneline
        \\`ssize` is a type of its own, not another name for `s64`:
        \\`ssize == s64` is `false` even on a 64-bit target, and the two print
        \\under their own names. Because they have the same width there, a value
        \\converts implicitly between them (see Literal Typing and Type
        \\Conversion). On a 32-bit target the same assignment of an `s64` to an
        \\`ssize` is an error, so code meant for several targets should not lean
        \\on that equivalence. The prelude's `ssize_max()` returns the largest
        \\`ssize` of the target.
    );
    subheading(18, "Widths from 1 to 65535 bits");
    paragraph(19, #string,oneline
        \\Any width from 1 to 65535 bits can be written: `s7`, `u3` and `u129`
        \\are integer types like the others, with exact arithmetic at their
        \\width. A value is stored in the smallest power-of-two number of bytes
        \\that holds it, so `s7` occupies one byte, `u24` four and `u129`
        \\thirty-two. The width is written in decimal without leading zeros;
        \\`s0`, `s08` and `u65536` are unknown types. The last line of the
        \\example uses the wrapping `+%` and the saturating `-|`, described
        \\below, which work at the declared width.
    );
    code_block(20, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    small: s7 = -64;
        \\    flags: u3 = 5;
        \\    huge: u129 = 340282366920938463463374607431768211456;
        \\    print("{} {} {}\n", small, flags, huge);
        \\    print("{} {} {}\n", size_of(s7), size_of(u3), size_of(u129));
        \\    print("{} {}\n", flags +% 4, small -| 1);
        \\}
    );
    code_block(21, "text", #string
        \\-64 5 340282366920938463463374607431768211456
        \\1 1 32
        \\1 -64
    );
    paragraph(22, #string,oneline
        \\`s128` and `u128` are native types, not a library emulation, and the
        \\same holds for the wider ones: arithmetic and printing work at the
        \\declared width. A literal too large for `ssize` needs a context that
        \\can hold it; Literal Typing and Type Conversion describes what a bare
        \\`:=` does with one.
    );
    subheading(23, "Operators");
    table_header(24, "Operators   —   Result");
    table_row(25, "`+` `-` `*`, prefix `-`   |   sum, difference, product, negation; an overflow is an error");
    table_row(26, "`/` `%`   |   quotient truncated toward zero, and remainder; a zero divisor is an error");
    table_row(27, "`+%` `-%` `*%`, prefix `-%`   |   wrapping: the exact result modulo 2 to the power of the width");
    table_row(28, "`+|` `-|` `*|`   |   saturating: the exact result clamped to the type's range");
    table_row(29, "`&` `|` `^`, prefix `~`   |   bitwise and, or, exclusive or, and complement");
    table_row(30, "`<<` `>>`   |   left and right shift; never checked at run time");
    table_row(31, "`<<|`   |   saturating left shift");
    table_row(32, "`==` `!=` `<` `<=` `>` `>=`   |   a `bool`");
    table_row(33, "`<=>`   |   an `Ordering`: `Less`, `Equal` or `Greater`");
    paragraph(34, #string,oneline
        \\Both operands of a binary operator must have the same type. There is
        \\no promotion of the narrower operand, as there is in C; convert one
        \\side explicitly. A literal operand adapts to the other side, so with
        \\`m: u8`, `m *% 2` multiplies two `u8` values and `m == 3` compares
        \\two.
    );
    code_block(35, "text", #string
        \\// a: u8 = 1; b: u16 = 2; c := a + b;
        \\error: no operator '+' for u8, u16
    );
    paragraph(36, #string,oneline
        \\Every binary operator except the comparisons has a compound assignment
        \\form, such as `+=`, `+%=` and `<<|=`; see Assignment, Blocks, and Name
        \\Lookup.
    );
    subheading(37, "Wrapping and saturating arithmetic");
    paragraph(38, #string,oneline
        \\The wrapping operators keep the low bits of the exact result, so
        \\`127 +% 1` is `-128` in an `s8`, and prefix `-%` maps the most
        \\negative value to itself. The saturating operators give the nearest
        \\value the type can hold. Both families mean the same thing at every
        \\optimization level and are never checked.
    );
    code_block(39, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    hi: s8 = 127;
        \\    lo: s8 = -128;
        \\    print("{} {}\n", hi +% 1, hi +| 1);
        \\    print("{} {}\n", lo -% 1, lo -| 1);
        \\    print("{}\n", -%lo);
        \\    m: u8 = 200;
        \\    print("{} {}\n", m *% 2, m *| 2);
        \\    z: s8 = 0;
        \\    zu: u8 = 0;
        \\    print("{} {}\n", ~z, ~zu);
        \\}
    );
    code_block(40, "text", #string
        \\-128 127
        \\127 -128
        \\-128
        \\144 255
        \\-1 255
    );
    subheading(41, "Division and remainder");
    paragraph(42, #string,oneline
        \\`/` truncates toward zero, and `%` takes the sign of the dividend, so
        \\`(a / b) * b + a % b` equals `a` whenever the division is defined. `%`
        \\is defined only for integers. A zero divisor, and the most negative
        \\value of a signed type divided by `-1`, are errors described under
        \\Checked operations below.
    );
    code_block(43, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    a: s64 = 7;
        \\    b: s64 = -7;
        \\    print("{} {}\n", a / 2, a % 2);
        \\    print("{} {}\n", b / 2, b % 2);
        \\    print("{} {}\n", a / -2, a % -2);
        \\    print("{}\n", (b / 2) * 2 + b % 2);
        \\}
    );
    code_block(44, "text", #string
        \\3 1
        \\-3 -1
        \\-3 1
        \\-7
    );
    subheading(45, "Shifts");
    paragraph(46, #string,oneline
        \\The shift count has the same type as the shifted value. `<<` discards
        \\the bits shifted out at the top. `>>` is an arithmetic shift, which
        \\copies the sign bit, on a signed operand and a logical shift, which
        \\fills with zeros, on an unsigned one. `<<|` is the saturating left
        \\shift: when a significant bit would be lost it gives the type's
        \\largest value, or its smallest for a negative operand.
    );
    code_block(47, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    one: u8 = 1;
        \\    print("{} {}\n", one << 7, one <<| 9);
        \\    neg: s8 = -8;
        \\    pos: u8 = 248;
        \\    print("{} {}\n", neg >> 2, pos >> 2);
        \\    half: s8 = 64;
        \\    print("{} {}\n", half << 1, half <<| 1);
        \\}
    );
    code_block(48, "text", #string
        \\128 255
        \\-2 62
        \\-128 127
    );
    paragraph(49, #string,oneline
        \\A constant shift count must be smaller than the width of the type:
    );
    code_block(50, "text", #string
        \\// a: u8 = 1; b := a << 8;
        \\error: shift count 8 is not less than the 8 bits of u8
        \\note: a shift by the width or more has no defined result
    );
    paragraph(51, #string,oneline
        \\A count known only at run time is not rejected, and the result is
        \\defined: shifting left or logically right by the width or more gives
        \\zero, and an arithmetic right shift gives `0` or `-1` according to the
        \\sign. A negative count of a signed type counts as too large. Shifts
        \\never stop the program.
    );
    subheading(52, "Checked operations");
    paragraph(53, #string,oneline
        \\Four integer operations can fail. Each failure has a name, which a
        \\stopped program prints:
    );
    table_header(54, "Operation   —   Failure");
    table_row(55, "`+`, `-`, `*` on integers   |   the exact result is outside the type: `arithmetic.overflow`");
    table_row(56, "prefix `-` on integers   |   negating the most negative signed value, or any nonzero unsigned value: `arithmetic.overflow`");
    table_row(57, "`/` and `%` on integers   |   a zero divisor: `divide.by.zero`");
    table_row(58, "`/` on signed integers   |   the most negative value divided by `-1`: `divide.overflow`");
    paragraph(59, #string,oneline
        \\The remainder of the most negative value by `-1` is defined as `0`,
        \\since that result fits. Float arithmetic is never checked: it follows
        \\IEEE 754 and produces infinities and NaNs, as described in
        \\Floating-Point and Complex Arithmetic. Shifts and the wrapping and
        \\saturating operators are never checked either.
    );
    subheading(60, "Runtime checks and the optimization level");
    paragraph(61, #string,oneline
        \\Runtime checks are compiled in at `-O0` and at the default level,
        \\`-O1`. A failed check prints `runtime check failed:` followed by the
        \\name of the failure on standard error and ends the process with status
        \\134, the status of an abort. At `-O2`, `-O3`, `-Os`, `-Oz` and `-Ozz`
        \\the checks are not emitted.
    );
    code_block(62, "glosso", #string
        \\#import "Io";
        \\
        \\bump :: (v: s8) -> s8 {
        \\    return v + 1;
        \\}
        \\
        \\main :: () {
        \\    print("before\n");
        \\    print("after: {}\n", bump(127));
        \\}
    );
    code_block(63, "text", #string
        \\$ glosso --run bump.glo 2>&1 | tail -3
        \\before
        \\runtime check failed: arithmetic.overflow
        \\glosso: program exited with status 134
        \\$ glosso --run -O2 bump.glo 2>/dev/null
        \\before
        \\after: -128
    );
    paragraph(64, #string,oneline
        \\In an unchecked build an overflowing `+`, `-` or `*` produces whatever
        \\the machine operation produces, which on current targets is the
        \\wrapped value, and an integer division by zero has no defined result
        \\at all. A program that depends on wrapping states it with `+%`, `-%`,
        \\`*%` and prefix `-%`, and one that wants to stop at the limits uses
        \\`+|`, `-|`, `*|` and `<<|`. Integer lanes of a `Simd` vector always
        \\wrap (see `Simd` Vectors and `Matrix` Values).
    );
    code_block(65, "glosso", #string
        \\#import "Io";
        \\
        \\divide :: (a: s32, b: s32) -> s32 {
        \\    return a / b;
        \\}
        \\
        \\main :: () {
        \\    print("{}\n", divide(-2147483648, 1));
        \\    print("{}\n", divide(1, 0));
        \\}
    );
    code_block(66, "text", #string
        \\$ glosso --run divide.glo 2>&1 | tail -3
        \\-2147483648
        \\runtime check failed: divide.by.zero
        \\glosso: program exited with status 134
    );
    paragraph(67, #string,oneline
        \\The same `-O` switch controls the other runtime checks, such as array
        \\bounds and the enum and pointer casts of Literal Typing and Type
        \\Conversion. Feature Gates and Runtime Checks lists them all, and
        \\Compiler Options and Output Kinds describes the levels.
    );
    subheading(68, "Overflow in constant evaluation");
    paragraph(69, #string,oneline
        \\An operation the compiler evaluates itself is checked at every
        \\optimization level, and a failure is a compile error with the operands
        \\and the range. This covers top-level constants, `#comptime`
        \\evaluation, including procedures it calls, and expressions whose
        \\operands are all constants, such as `cast(u8) 255 + cast(u8) 1`.
    );
    code_block(70, "text", #string
        \\// compute :: () -> u8 { a: u8 = 200; b: u8 = 100; return a + b; }
        \\// K :: #comptime compute();
        \\error: constant arithmetic overflow: 200 + 100 = 300 does not fit u8, whose range is 0..=255
        \\
        \\// x := cast(s8) -128 / cast(s8) -1;
        \\error: constant arithmetic overflow: -128 / -1 = 128 does not fit s8, whose range is -128..=127
        \\
        \\// K :: 1 / 0;
        \\error: constant division by zero
    );
    paragraph(71, #string,oneline
        \\Literals that do not fit their type are reported the same way, as
        \\described in Literal Typing and Type Conversion.
    );
    subheading(72, "Strict conversions and `lossy_numerics`");
    paragraph(73, #string,oneline
        \\The checks above rely on a value's type being the type the program
        \\chose for it. That is why integers convert implicitly only when the
        \\conversion loses nothing (see Literal Typing and Type Conversion): a
        \\silent narrowing or sign change looks exactly like code that does not
        \\convert at all, and is the kind of mistake the checks exist to catch.
    );
    paragraph(74, #string,oneline
        \\Code ported from C, or a hash function written in terms of deliberate
        \\truncation, would need a `cast` on almost every line. For such code the
        \\feature gate `lossy_numerics` makes every integer type convert
        \\implicitly to every other, truncating and reinterpreting the sign as a
        \\cast would. `#enable(lossy_numerics);` and `#disable(lossy_numerics);`
        \\are written between top-level declarations and apply to the
        \\declarations in between, bodies included; without a `#disable` the
        \\gate lasts to the end of the file.
    );
    code_block(75, "glosso", #string
        \\#import "Io";
        \\
        \\#enable(lossy_numerics);
        \\truncate :: (a: u64) -> s8  { return a; }
        \\resign   :: (a: s64) -> u64 { return a; }
        \\#disable(lossy_numerics);
        \\
        \\main :: () {
        \\    print("{} {}\n", truncate(300), resign(-1));
        \\}
    );
    code_block(76, "text", #string
        \\44 18446744073709551615
    );
    paragraph(77, #string,oneline
        \\The gate belongs to the declarations that perform the conversion, not
        \\to the procedures they define: a caller outside the gate still cannot
        \\pass a `u64` to a parameter of type `s8` declared inside it. The gate
        \\changes nothing else. Floats, `bool`, `rune` and `distinct` types keep
        \\their rules, a literal still has to fit its type, and operands of
        \\different integer types still have no operator.
    );
    code_block(78, "text", #string
        \\// under #enable(lossy_numerics):
        \\// narrow :: (a: f64) -> f32 { return a; }
        \\error: got f64, expected f32
        \\
        \\// sum :: (a: u8, b: u16) -> u16 { return a + b; }
        \\error: no operator '+' for u8, u16
        \\
        \\// h :: () { x: u8 = 300; }
        \\error: 300 does not fit u8, whose range is 0..=255
    );
    paragraph(79, #string,oneline
        \\Writing the gate inside a procedure body is
        \\`error: unexpected directive 'enable'`, and an unknown feature name is
        \\`error: unknown feature 'lossy_stuff'`. Feature Gates and Runtime
        \\Checks describes the other gates.
    );
    subheading(80, "Types that are not integers");
    paragraph(81, #string,oneline
        \\`rune` is stored like a `u32` but is not an integer. It holds a
        \\Unicode scalar value and has equality, ordering and printing, but no
        \\arithmetic: `r + r` is `error: no operator '+' for rune, rune`, and a
        \\`rune` does not convert implicitly to or from an integer. `cast(u32) r`
        \\gives its code point. Text and Character Literals describes it with
        \\the character literals.
    );
    paragraph(82, #string,oneline
        \\An enum has an integer representation but is a type of its own; see
        \\`enum` and `enum_flags`. `bool` is not an integer either (`bool` and
        \\Conditions). The integer literal forms, including the bases `16#ff`
        \\and `2#1010`, are described in Number Literals, and the hexadecimal
        \\and binary output selectors `{x}` and `{b}` in `Show`, `Formatter`,
        \\`FromString`, and Format Strings.
    );
}

render_section_27 :: () {
    paragraph(0, #string,oneline
        \\Glosso has five floating-point types and five complex types built
        \\from them. This chapter gives their formats and ranges, how float
        \\arithmetic treats infinity, NaN and negative zero, the rules that keep
        \\float types apart, the elementary functions of the `Math/Core` module,
        \\and the complex operations of `Math/Complex`. Float arithmetic follows
        \\IEEE 754 and never stops the program: where an integer overflow is an
        \\error, a float result that is too large becomes an infinity.
    );
    subheading(1, "The float types");
    paragraph(2, #string,oneline
        \\Four of the float types are IEEE 754 binary formats; `f80` is the
        \\80-bit extended format of the x87 unit. The significand width decides
        \\how many decimal digits a value keeps.
    );
    table_header(3, "Type   —   Format   —   Significand bits, largest finite value");
    table_row(4, "`f16`   |   IEEE binary16   |   11 bits (about 3 digits), 65504");
    table_row(5, "`f32`   |   IEEE binary32   |   24 bits (about 7 digits), about 3.4e38");
    table_row(6, "`f64`   |   IEEE binary64   |   53 bits (about 16 digits), about 1.8e308");
    table_row(7, "`f80`   |   x87 extended   |   64 bits (about 19 digits), about 1.2e4932");
    table_row(8, "`f128`   |   IEEE binary128   |   113 bits (about 34 digits), about 1.2e4932");
    paragraph(9, #string,oneline
        \\`f64` is the default: a float literal bound with `:=` becomes an `f64`.
        \\Each type computes at its own precision, at compile time as well as at
        \\run time, so a constant folded by the compiler has the value the
        \\program would have computed. In particular `f16` arithmetic is real
        \\binary16 arithmetic, not `f32` arithmetic stored in two bytes.
    );
    code_block(10, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    h: f16 = 1.0;
        \\    s: f32 = 1.0;
        \\    d: f64 = 1.0;
        \\    e: f80 = 1.0;
        \\    q: f128 = 1.0;
        \\    print("{} {} {} {} {}\n", h / 3.0, s / 3.0, d / 3.0, e / 3.0, q / 3.0);
        \\    tenth: f16 = 0.1;
        \\    print("{} {}\n", tenth, h + 0.001);
        \\    x := 2.5;
        \\    print("{}\n", x * 4.0);
        \\}
    );
    code_block(11, "text", #string
        \\0.333252 0.333333 0.333333 0.333333 0.333333
        \\0.0999756 1.00098
        \\10
    );
    subheading(12, "Printing and parsing floats");
    paragraph(13, #string,oneline
        \\`print` shows a float the way C's `%g` does: six significant digits,
        \\without trailing zeros, switching to exponent form for very large and
        \\very small magnitudes (`1.23457e+06`, `1e-05`). Every float type is
        \\converted to `f64` for display, so the extra digits of an `f80` or
        \\`f128` do not show. In the example above, the literal `0.1` is not
        \\exactly representable, and at `f16` the nearest value is
        \\`0.0999756`; `1.00098` is the `f16` nearest to `1.001`. `Show`,
        \\`Formatter`, `FromString`, and Format Strings covers precision and other
        \\format options, and `from_string(f64, text)` parses a float,
        \\returning `null` for text that is not one.
    );
    subheading(14, "Infinity, NaN, and negative zero");
    paragraph(15, #string,oneline
        \\Float arithmetic never stops the program. A result too large for the
        \\type becomes an infinity, and an operation with no meaningful result,
        \\such as `0.0 / 0.0`, gives NaN ("not a number"). Zero has a sign:
        \\`-0.0` equals `0.0` but divides to `-inf`. `print` writes these values
        \\as `inf`, `-inf`, `nan` and `-0`.
    );
    code_block(16, "glosso", #string
        \\#import "Io";
        \\#import "Math/Core";
        \\
        \\main :: () {
        \\    big: f64 = 1e308;
        \\    zero: f64 = 0.0;
        \\    nan := zero / zero;
        \\    print("{} {} {} {}\n", big * 10.0, -big * 10.0, nan, -zero);
        \\    print("{} {} {}\n", nan == nan, is_nan(nan), -zero == zero);
        \\    print("{} {}\n", sign_bit(-zero), 1.0 / -zero);
        \\    print("{} {}\n", f64_max_finite(), f64_min_normal());
        \\}
    );
    code_block(17, "text", #string
        \\inf -inf nan -0
        \\false true true
        \\true -inf
        \\1.79769e+308 2.22507e-308
    );
    paragraph(18, #string,oneline
        \\A NaN is not equal to anything, itself included, so `x == x` is false
        \\when `x` is NaN; test with `is_nan`. For that reason the float types
        \\have `PartialEq` and `PartialOrd` instances but no `Eq`: the prelude
        \\declares the negative instance `$T ::: instance !Eq where Is_Float(T)`,
        \\so a float cannot be used where a total equality is required (see
        \\`PartialEq`, `PartialOrd`, and `Hash`). `Math/Core` also provides
        \\`positive_infinity()`, `negative_infinity()`, `quiet_nan()`,
        \\`negative_zero()` and the `f32_...` counterparts of these constants.
    );
    subheading(19, "Float literals must fit");
    paragraph(20, #string,oneline
        \\A float literal is rounded to the nearest value of its type. A finite
        \\literal beyond the type's range is an error rather than an infinity,
        \\and so is a nonzero literal that would round to zero:
    );
    code_block(21, "text", #string
        \\// x: f16 = 100000.0;
        \\error: float literal '100000.0' is out of range for f16
        \\note: the largest finite f16 is 65504
        \\
        \\// y: f32 = 1e-50;
        \\error: float literal '1e-50' is out of range for f32
        \\note: the smallest positive f32 is 1.4e-45, and this literal rounds to zero
    );
    paragraph(22, #string,oneline
        \\An integer literal is accepted where a float is expected, so
        \\`f: f64 = 5;` needs no `.0`. Number Literals describes the literal
        \\syntax.
    );
    subheading(23, "No mixing and no implicit conversion");
    paragraph(24, #string,oneline
        \\The two operands of an arithmetic operator must have the same float
        \\type, and no float converts implicitly to another float, not even to a
        \\wider one. A runtime integer does not become a float implicitly either.
        \\Each of these needs a `cast`, described in Literal Typing and Type
        \\Conversion.
    );
    code_block(25, "text", #string
        \\// x: f32 = 1.5; y: f64 = x;
        \\error: got f32, expected f64
        \\
        \\// x: f32 = 1.5; y: f64 = 2.0; z := x + y;
        \\error: got f64, expected f32
        \\
        \\// n: s64 = 3; y: f64 = n;
        \\error: got s64, expected f64
    );
    paragraph(26, #string,oneline
        \\`%` is not defined for floats (`no operator '%' for f64, f64`); the
        \\remainder of a float division is `fmod(x, y)` from `Math/Core`.
    );
    subheading(27, "Mathematical functions");
    paragraph(28, #string,oneline
        \\The `Math/Core` module provides the elementary functions for `f32` and
        \\`f64` through its `Floating` and `RealFloat` typeclasses: roots,
        \\powers, exponentials, logarithms, trigonometric and hyperbolic
        \\functions, rounding, and classification. `to_bits` and `from_bits`
        \\give the IEEE bit pattern of an `f32` or `f64`.
    );
    code_block(29, "glosso", #string
        \\#import "Io";
        \\#import "Math/Core";
        \\
        \\main :: () {
        \\    x: f64 = -2.5;
        \\    print("{} {} {} {}\n", floor(x), ceil(x), round(x), trunc(x));
        \\    print("{} {} {}\n", sqrt(2.0), pow(2.0, 10.0), fmod(7.5, 2.0));
        \\    print("{} {}\n", x.abs(), x.clamp(-1.0, 1.0));
        \\    bits := x.to_bits();
        \\    print("{} {}\n", bits, f64.from_bits(bits));
        \\}
    );
    code_block(30, "text", #string
        \\-3 -2 -3 -2
        \\1.41421 1024 1.5
        \\2.5 -1
        \\13836183955189006336 -2.5
    );
    paragraph(31, #string,oneline
        \\`round` rounds halfway cases away from zero, so `round(-2.5)` is `-3`;
        \\`x.round_even()` rounds them to the even neighbour.
    );
    subheading(32, "`f80` and `f128` on different targets");
    paragraph(33, #string,oneline
        \\Only x86 processors have `f80` arithmetic in hardware. On an `x86` or
        \\`x86_64` target an `f80` is the x87 extended value. On every other
        \\target it is stored in a 16-byte binary128 carrier and each result is
        \\rounded to `f80` precision, so the arithmetic agrees but the bytes in
        \\memory do not: an `f80` written to a file by one build cannot be read
        \\back as an `f80` by a build for another architecture. Its size is 16
        \\bytes on most targets but 12 on `x86-linux-musl`.
    );
    paragraph(34, #string,oneline
        \\Few processors have `f128` instructions. Its arithmetic, conversions
        \\and printing are carried out by compiler runtime helper routines,
        \\which the compiler links into the program for the targets it
        \\supports.
    );
    subheading(35, "The complex types");
    paragraph(36, #string,oneline
        \\A complex type is a primitive pair of floats of the same type, the
        \\real part followed by the imaginary part. The number in the name is
        \\the width of the pair, so a `c128` is two `f64` components.
    );
    table_header(37, "Type   —   Components   —   Size, alignment (x86-64)");
    table_row(38, "`c32`   |   two `f16`   |   4, 2");
    table_row(39, "`c64`   |   two `f32`   |   8, 4");
    table_row(40, "`c128`   |   two `f64`   |   16, 8");
    table_row(41, "`c160`   |   two `f80`   |   32, 16");
    table_row(42, "`c256`   |   two `f128`   |   32, 16");
    paragraph(43, #string,oneline
        \\The types need no import, but everything done with them is in the
        \\`Math/Complex` module: the constructors `complex32` to `complex256`,
        \\the methods `real_part`, `imaginary_part`, `conjugate` and `norm`, and
        \\the instances behind `+`, `-`, `*`, `/`, prefix `-` and `==`. Import
        \\it in every module that computes with complex values, including
        \\helper modules whose callers already import it.
    );
    code_block(44, "glosso", #string
        \\#import "Io";
        \\#import "Math/Complex";
        \\
        \\main :: () {
        \\    a := complex128(1.0, 2.0);
        \\    b := complex128(3.0, -4.0);
        \\    sum := a + b;
        \\    product := a * b;
        \\    quotient := a / b;
        \\    print("{} {}\n", sum.real_part(), sum.imaginary_part());
        \\    print("{} {}\n", product.real_part(), product.imaginary_part());
        \\    print("{} {}\n", quotient.real_part(), quotient.imaginary_part());
        \\    c := a.conjugate();
        \\    print("{} {} {}\n", c.imaginary_part(), b.norm(), a == c);
        \\    zero: c64;
        \\    three: c64 = 3;
        \\    print("{} {}\n", zero.real_part(), three.real_part());
        \\}
    );
    code_block(45, "text", #string
        \\4 -2
        \\11 2
        \\-0.2 0.4
        \\-2 5 false
        \\0 3
    );
    paragraph(46, #string,oneline
        \\`real_part` and `imaginary_part` return the component type, `f64` for a
        \\`c128`, and `norm` returns the magnitude as that type. A complex
        \\variable without an initializer is zero.
    );
    subheading(47, "Constructing complex values");
    paragraph(48, #string,oneline
        \\There is no imaginary literal, and no runtime float converts to a
        \\complex number implicitly. The only implicit path is from a compile-time
        \\number, which becomes the real part with a zero imaginary part, as
        \\`three` shows above. Everything else goes through a constructor, whose
        \\arguments are the component type.
    );
    code_block(49, "text", #string
        \\// r: f64 = 1.5; z: c128 = r;
        \\error: got f64, expected c128
        \\
        \\// z := complex128(1.0, 2.0); r: f64 = 1.5; w := z + r;
        \\error: no operator '+' for c128, f64
        \\
        \\// z := complex64(1.0, 2.0); w := z + complex128(1.0, 2.0);
        \\error: no operator '+' for c64, c128
    );
    paragraph(50, #string,oneline
        \\Both operands of an operator must have the same complex type. To add a
        \\real number, build it as a complex one first: `z + complex128(r, 0.0)`.
    );
    subheading(51, "Complex functions and generic code");
    paragraph(52, #string,oneline
        \\Every complex width has `Fractional` and `Floating` instances, so the
        \\functions of `Math/Core` such as `sqrt`, `exp`, `log`, `pow`, `sin` and
        \\`cos` accept complex arguments and use the principal branch. Complex
        \\types also have a `Num` instance, so generic code constrained by `Num`
        \\accepts them. They are deliberately not `Is_Numeric`, which covers only
        \\integers and floats, so code written against that predicate does not.
    );
    code_block(53, "glosso", #string
        \\#import "Io";
        \\#import "Math/Complex";
        \\#import "Math/Core";
        \\#import "Meta";
        \\
        \\square :: (x: $T) -> T where Num(T) { return x * x; }
        \\
        \\main :: () {
        \\    i := sqrt(complex128(-1.0, 0.0));
        \\    print("{} {}\n", i.real_part(), i.imaginary_part());
        \\    s := square(complex128(1.0, 1.0));
        \\    print("{} {}\n", s.real_part(), s.imaginary_part());
        \\    print("{} {}\n", square(3), Is_Numeric(c128));
        \\    w := exp(complex128(0.0, 3.141592653589793));
        \\    print("{} {}\n", w.real_part(), w.imaginary_part());
        \\}
    );
    code_block(54, "text", #string
        \\0 1
        \\0 2
        \\9 false
        \\-1 1.22465e-16
    );
    paragraph(55, #string,oneline
        \\Arithmetic and division are carried out at the width of the
        \\components; division scales by the larger component of the divisor so
        \\that ordinary finite values do not overflow. The elementary functions
        \\of `c160` and `c256` are computed with `f64` precision and widened
        \\back, so they are not more accurate than those of `c128`.
    );
    subheading(56, "Complex equality, printing, and C");
    paragraph(57, #string,oneline
        \\`==` and `!=` compare both components. Like the float types, the
        \\complex types have `PartialEq` but no `Eq`, because a NaN component is
        \\unequal to itself. There is no `Show` instance, so `print("{}", z)` is
        \\an error (`no Formatter instance for selector '' and value type c128`);
        \\print the two components instead.
    );
    paragraph(58, #string,oneline
        \\A complex value has no portable by-value C calling convention, so a
        \\`#c_call` signature that contains one is rejected with
        \\`error: primitive c128 has no declared C ABI; pass its real and
        \\imaginary components separately`.
    );
}

render_section_28 :: () {
    paragraph(0, #string,oneline
        \\`bool` is the type of truth values. This chapter describes its values
        \\and operators, how it converts to and from numbers, and what may stand
        \\as the condition of an `if` or a `while`. Those two statements accept
        \\more than a `bool`: a number, a string, a view or a pointer is tested
        \\against zero or emptiness, by the fixed set of rules given below.
        \\Every other place that needs a truth value requires a `bool`.
    );
    subheading(1, "Values and operators");
    paragraph(2, #string,oneline
        \\`bool` has the two values `true` and `false` and occupies one byte. A
        \\`bool` variable without an initializer is `false`, and `print` writes
        \\the values as `true` and `false`. The logical operators are `&&` and
        \\`||`, which evaluate their right operand only when it decides the
        \\result, prefix `!`, and the compound assignments `&&=` and `||=`.
        \\`==` and `!=` compare two `bool` values.
    );
    code_block(3, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    ready := true;
        \\    done: bool;
        \\    print("{} {} {}\n", ready, done, !ready);
        \\    print("{} {}\n", ready && done, ready || done);
        \\    print("{} {}\n", ready == done, cast(s64) ready);
        \\    print("{} {}\n", cast(bool) 0, cast(bool) -5);
        \\    done ||= ready;
        \\    print("{}\n", done);
        \\}
    );
    code_block(4, "text", #string
        \\true false false
        \\false true
        \\false 1
        \\false true
        \\true
    );
    paragraph(5, #string,oneline
        \\`&&` and `||` are short-circuiting because their right operand is a
        \\lazy parameter of the operator; `noalias`, `#lazy`, `#comptime`, and
        \\Type Parameters explains the mechanism.
    );
    subheading(6, "`bool` is not an integer");
    paragraph(7, #string,oneline
        \\`bool` has no arithmetic (`true + false` is
        \\`error: no operator '+' for bool, bool`), and nothing converts to or
        \\from it implicitly. `cast` is the bridge in both directions:
        \\`cast(s64) true` is `1`, and `cast(bool) n` is `n != 0`.
    );
    code_block(8, "text", #string
        \\// b: bool = 1;
        \\error: got ssize, expected bool
        \\
        \\// x: s64 = true;
        \\error: got bool, expected s64
        \\
        \\// n: s64 = 1; b := true; c := n && b;
        \\error: no operator '&&' for s64, bool
    );
    subheading(9, "Truthiness in `if` and `while`");
    paragraph(10, #string,oneline
        \\The condition of an `if` or a `while` does not have to be a `bool`.
        \\For the types below the compiler tests the value itself, so `if count`
        \\means `if count != 0` and `if name` means `if name.count != 0`. The
        \\table is the complete set of rules.
    );
    table_header(11, "Condition type   —   True when");
    table_row(12, "`bool`   |   the value is `true`");
    table_row(13, "integers, `rune`, enums   |   the value is not zero");
    table_row(14, "floats   |   the value is not zero and not NaN");
    table_row(15, "pointers `*T` and `[*]T`, procedure pointers, `label`   |   always, since these are never null");
    table_row(16, "optional pointers `?*T` and `?[*]T`   |   the optional is not `null`");
    table_row(17, "`str`, `cstr`, `string16`, `cstring16`   |   the string is not empty");
    table_row(18, "views `[]T` and dynamic arrays `[..]T`   |   the count is not zero");
    code_block(19, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    count: s64 = 0;
        \\    if count print("count\n");
        \\    temperature: f64 = -0.0;
        \\    if temperature print("temperature\n");
        \\    name: str = "glosso";
        \\    if name print("name\n");
        \\    items: [..]s64;
        \\    defer items.free();
        \\    if items print("items\n");
        \\    items.push(4);
        \\    if items print("items after push\n");
        \\    value: s64 = 7;
        \\    pointer := &value;
        \\    if pointer print("pointer\n");
        \\    maybe: ?*s64 = null;
        \\    if maybe print("maybe\n");
        \\    n := 2;
        \\    while n {
        \\        print("n is {}\n", n);
        \\        n -= 1;
        \\    }
        \\}
    );
    code_block(20, "text", #string
        \\name
        \\items after push
        \\pointer
        \\n is 2
        \\n is 1
    );
    note(21, #string,oneline
        \\A NaN is false and so is `-0.0`. The float rule is an ordered
        \\comparison with zero, and an ordered comparison with a NaN is always
        \\false, so for a NaN `x`, `if x` is not taken although `x != 0.0` is
        \\true.
    );
    subheading(22, "Types with no truthiness rule");
    paragraph(23, #string,oneline
        \\An optional pointer can be tested because it is stored as the bare
        \\pointer with `null` as zero. An optional of any other payload, a
        \\result, a struct, a union, a tuple and a complex number have no rule,
        \\and using one as a condition is rejected when the program is compiled:
    );
    code_block(24, "text", #string
        \\// o: ?s64 = .Some(5); if o print("present\n");
        \\error: values of type ?s64 have no native truthiness rule [opcode Jz] while lowering 'main' at IR instruction 4
    );
    paragraph(25, #string,oneline
        \\Write the test out instead: `if o != null`, or a pattern that binds the
        \\payload as described in `?T` and `E!T`. A fixed array `[N]T` is not a
        \\condition either; test its elements or its `.count`.
    );
    subheading(26, "`!` and the `LogicalNot` typeclass");
    paragraph(27, #string,oneline
        \\Truthiness belongs to `if` and `while` alone. The prefix operator `!`
        \\is an ordinary operator of the `LogicalNot` typeclass, and the prelude
        \\gives it three instances: on a `bool`, on any optional `?T`, where `!o`
        \\is true when `o` is `null`, and on any result `E!T`, where it is true
        \\for an error. It has no instance for integers, floats or pointers, so
        \\`!n` on an `s64` is `error: no prefix operator '!' for s64`. The two
        \\mechanisms cover different types: `!o` works on a `?s64` although
        \\`if o` does not. Operator Declarations describes how a type of your
        \\own can implement `!`.
    );
    subheading(28, "Conditions that must be `bool`");
    paragraph(29, #string,oneline
        \\Other conditions require a `bool` outright: the condition of `ifx`, of
        \\`#if`, and of `#assert`, and the operands of `&&` and `||`.
    );
    code_block(30, "text", #string
        \\// n: s64 = 1; s := ifx n "a" else "b";
        \\error: got s64, expected bool
        \\
        \\// #if 3 { ... }
        \\error: #if condition must be bool, got comptime_int
    );
}

render_section_29 :: () {
    paragraph(0, #string,oneline
        \\Glosso has four built-in string types. Each is a view: it refers to
        \\text stored somewhere else and does not own it. This chapter describes
        \\their representation, indexing and comparison, how UTF-8 text relates
        \\to bytes and characters, the type of a string literal, where text built
        \\at run time comes from and who releases it, and the conversions between
        \\`str`, `cstr`, byte views and UTF-16. Working with Text teaches
        \\everyday text handling step by step.
    );
    subheading(1, "The string types");
    paragraph(2, #string,oneline
        \\The four types differ in the width of a code unit and in how the end
        \\of the text is found:
    );
    table_header(3, "Type   —   Code unit   —   End of the text");
    table_row(4, "`str`   |   `u8`, UTF-8   |   a stored count");
    table_row(5, "`cstr`   |   `u8`, UTF-8   |   the first zero byte");
    table_row(6, "`string16`   |   `u16`, UTF-16   |   a stored count");
    table_row(7, "`cstring16`   |   `u16`, UTF-16   |   the first zero unit");
    subheading(8, "`str`");
    paragraph(9, #string,oneline
        \\`str` is the string type of ordinary code. It is two words, `.data`, a
        \\`[*]const u8` pointing at the first byte, and `.count`, the number of
        \\bytes as an `ssize`. Copying a `str`, passing it or returning it copies
        \\those two words and never the bytes. A `str` without an initializer is
        \\empty. The fields and the bytes are read-only through the view:
        \\`s.count = 1` and `s[0] = 65` are both
        \\`error: left side of assignment is not assignable`.
    );
    code_block(10, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    s := "café";
        \\    print("{} {} {}\n", s.count, s[0], s[1..3]);
        \\    print("{} {}\n", type_name(type_of(s[0])), type_name(type_of(s.data)));
        \\    print("{} {}\n", s == "café", "apple" < "banana");
        \\    empty: str;
        \\    print("[{}] {}\n", empty, empty.count);
        \\}
    );
    code_block(11, "text", #string
        \\5 99 af
        \\u8 [*]const u8
        \\true true
        \\[] 0
    );
    subheading(12, "Indexing, slicing, and comparison");
    paragraph(13, #string,oneline
        \\Indexing gives one code unit, so `s[0]` above is the byte `99`, the
        \\letter `c`, and not a character. Slicing with a range gives another
        \\`str` that shares the bytes. `==` and `!=` compare the contents, and
        \\`<`, `<=`, `>`, `>=` and `<=>` order strings by their code units, which
        \\for valid UTF-8 is the order of the code points. Both operands must
        \\have the same string type.
    );
    subheading(14, "Bytes and characters");
    paragraph(15, #string,oneline
        \\The count of a `str` is a number of bytes. The four characters of
        \\`café` take five bytes, because `é` is encoded in two. A `for` loop over
        \\a string decodes it and yields one `rune` per Unicode scalar value;
        \\`it_index` counts characters, not bytes, and a byte sequence that is not
        \\valid UTF-8 yields U+FFFD. To walk the encoded bytes, loop over
        \\`s.bytes()`, a `[]const u8` view of the same storage from the
        \\`Strings` module.
    );
    code_block(16, "glosso", #string
        \\#import "Io";
        \\#import "Strings";
        \\
        \\main :: () {
        \\    text := "Aé😀";
        \\    print("{} bytes\n", text.count);
        \\    for r: text print("[{}:{}]", it_index, cast(u32) r);
        \\    print("\n");
        \\    for b: text.bytes() print("[{}]", b);
        \\    print("\n");
        \\}
    );
    code_block(17, "text", #string
        \\7 bytes
        \\[0:65][1:233][2:128512]
        \\[65][195][169][240][159][152][128]
    );
    paragraph(18, #string,oneline
        \\Nothing checks that a `str` holds valid UTF-8. A view made from bytes
        \\with `cast(str)` or `byte_slice_to_string` takes them as they are;
        \\`utf8_from_bytes`, which returns `null` for malformed input, is the
        \\validating constructor, and `s.string_is_valid()` tests an existing
        \\string. Text and Character Literals describes the character types
        \\`u8` and `rune`.
    );
    subheading(19, "The type of a string literal");
    paragraph(20, #string,oneline
        \\A string literal is a `str` unless its context asks for one of the
        \\other string types, which it then becomes. `c"..."` is always a
        \\`cstr`, and `b"..."` is a fixed array of bytes, `[N]u8`, that can be
        \\modified like any other array. The text of a literal lives in static
        \\storage for the whole run of the program. Text and Character Literals
        \\covers the escapes and prefixes.
    );
    subheading(21, "Building text at run time");
    paragraph(22, #string,oneline
        \\`+` concatenates constant strings, and the result is again a constant.
        \\At run time it is rejected, because joining two views needs new storage
        \\and the operator has no way to say where it comes from:
    );
    code_block(23, "text", #string
        \\// a: str = "ab"; b: str = "cd"; c := a + b;
        \\error: string concatenation with '+' requires constant strings; use String_Builder at runtime
    );
    paragraph(24, #string,oneline
        \\Text built at run time comes from a `String_Builder`, from `format`,
        \\which allocates the result, or from `tprint`, which formats into the
        \\temporary allocator. Library procedures that copy or transform text,
        \\such as `clone`, `to_upper` or `replace`, also return new storage,
        \\while `substring`, `trim` and the pieces of `split` are views into their
        \\input.
    );
    code_block(25, "glosso", #string
        \\#import "Io";
        \\#import "Format";
        \\#import "String_Builder";
        \\#import "Strings";
        \\
        \\main :: () {
        \\    owned := format("{}-{}", "left", 42);
        \\    defer owned.free();
        \\    builder: String_Builder;
        \\    defer builder.free();
        \\    builder.write_string("hello");
        \\    builder.write_string(", world");
        \\    print("{} | {}\n", owned, builder.to_string());
        \\    print("{}\n", tprint("{} items", 3));
        \\    words := "a,b,c".split(",");
        \\    defer words.free();
        \\    print("{} {}\n", words.count, words[1]);
        \\    trimmed := "  padded  ".trim();
        \\    print("[{}] {}\n", trimmed, "glosso".contains("oss"));
        \\}
    );
    code_block(26, "text", #string
        \\left-42 | hello, world
        \\3 items
        \\3 b
        \\[padded] true
    );
    subheading(27, "Who owns the bytes");
    paragraph(28, #string,oneline
        \\A string never records where its bytes came from, so the code that
        \\allocated them decides when they are released. A literal is static and
        \\is never freed. A string returned by `format` or `clone` is owned by the
        \\caller and released once with `free`, usually through `defer`, using
        \\the same allocator. A `tprint` result belongs to the temporary allocator
        \\and must not be freed. A view such as a slice, a `trim` result or a
        \\`to_string()` of a builder is valid only while the storage it looks at
        \\is alive and unchanged. In the example above, `words.free()` releases
        \\the array that `split` allocated, not the three pieces, which point
        \\into the literal. `Freeable`, Copies, and Ownership Transfer and The
        \\Temporary Allocator describe the rules in full.
    );
    subheading(29, "`cstr`");
    paragraph(30, #string,oneline
        \\A `cstr` is a single pointer to bytes followed by a zero, the
        \\representation C uses. Its `.count` scans for that zero each time it is
        \\read. A `cstr` without an initializer is null; its count is zero, but it
        \\is not equal to the empty string `""`, which points at a zero byte. A
        \\`cstr` converts implicitly to `*const u8` and `[*]const u8`, so it can
        \\be passed straight to a C function.
    );
    subheading(31, "Converting between `str` and `cstr`");
    paragraph(32, #string,oneline
        \\A `str` does not promise a zero after its last byte, so it never
        \\converts to a `cstr`, not even with `cast`
        \\(`error: cannot cast str to cstr`). `s.c_string()` copies it into
        \\zero-terminated temporary storage, enough for the duration of a call,
        \\and `s.cstring_from_string()` makes an owned copy to release with
        \\`free`. In the other direction `c.to_string()` or `cast(str) c` scans a
        \\C string once and views its bytes without copying.
    );
    code_block(33, "glosso", #string
        \\#import "Io";
        \\#import "Strings";
        \\
        \\libc :: #library "c";
        \\c_strlen :: (s: cstr) -> usize #foreign libc "strlen";
        \\
        \\main :: () {
        \\    name: str = "glosso";
        \\    temporary := name.c_string();
        \\    print("{} {}\n", temporary.count, c_strlen(temporary));
        \\    owned := name.cstring_from_string();
        \\    defer owned.free();
        \\    print("{}\n", owned.to_string() == name);
        \\    stopped: cstr = "A\0BC";
        \\    print("{} {}\n", stopped.count, cast(str) stopped);
        \\    missing: cstr;
        \\    print("{} {}\n", missing.count, missing == "");
        \\}
    );
    code_block(34, "text", #string
        \\6 6
        \\true
        \\1 A
        \\0 false
    );
    subheading(35, "Strings, bytes, and pointers");
    paragraph(36, #string,oneline
        \\A bare pointer has no length, so it does not become a `str` by itself.
        \\The compiler says what to do instead:
    );
    code_block(37, "text", #string
        \\// p: [*]const u8 = ...; s: str = p;
        \\error: cannot implicitly convert [*]const u8 to str, which carries a count the pointer does not; make a slice of known length and use byte_slice_to_string
    );
    paragraph(38, #string,oneline
        \\The explicit casts between a string and its storage copy nothing:
        \\`cast(str) bytes` views a `[]const u8` as text, `cast([]const u8) s`
        \\views text as bytes, and `cast(cstr) pointer` trusts that the pointer
        \\addresses zero-terminated bytes. C Types, Callbacks, and Bindgen has
        \\more on passing text to and from C.
    );
    subheading(39, "UTF-16: `string16` and `cstring16`");
    paragraph(40, #string,oneline
        \\`string16` and `cstring16` hold UTF-16 code units, the encoding of
        \\Windows APIs. They behave like `str` and `cstr` with `u16` in place of
        \\`u8`: indexing gives a `u16`, the count is in units, and a character
        \\outside the Basic Multilingual Plane takes two units, a surrogate pair.
        \\`print` decodes them to UTF-8. Converting between the encodings
        \\allocates: `s.utf16_from_string()` and `w.to_string()`, the second
        \\returning `null` for invalid UTF-16, come from the `Strings` module.
    );
    code_block(41, "glosso", #string
        \\#import "Io";
        \\#import "Strings";
        \\
        \\main :: () {
        \\    wide: string16 = "Aé😀";
        \\    print("{} {} {}\n", wide.count, wide[2], wide[3]);
        \\    converted := "naïve".utf16_from_string();
        \\    defer converted.free();
        \\    print("{} {}\n", converted.count, converted);
        \\}
    );
    code_block(42, "text", #string
        \\4 55357 56832
        \\5 naïve
    );
    subheading(43, "The text modules");
    paragraph(44, #string,oneline
        \\The types are built in; the operations on them are in the standard
        \\library. `Strings` gathers `Strings/Utf8` (searching, splitting,
        \\trimming, case mapping, validation and C-string conversion),
        \\`Strings/Utf16` and `Strings/Memory` (`free`). `String_Builder` builds
        \\text incrementally, `Format` provides `format` and `tprint`, and
        \\`Unicode` classifies characters. Appendix D: Standard Library Modules
        \\lists them, and the library reference documents each procedure.
    );
}

render_section_30 :: () {
    paragraph(0, #string,oneline
        \\Two primitive type constructors describe fixed-size groups of numbers
        \\held by value. `Simd(T, N)` is a vector of `N` lanes of type `T` whose
        \\operators work on every lane at once and compile to the target's
        \\vector instructions. `Matrix(T, Rows, Cols)` is a matrix of
        \\`Rows * Cols` elements stored inline in row-major order. Both types can
        \\be named without an import; their operations are in the `Simd` and
        \\`Math/Matrix` modules. This chapter describes vectors first, then
        \\matrices.
    );
    subheading(1, "Vector types and literals");
    paragraph(2, #string,oneline
        \\A vector's lane type is an integer of at most 64 bits, `f32` or `f64`,
        \\and its lane count is a literal from 1 to 64. A vector value is
        \\written `#simd` followed by an array literal, in a context whose type
        \\is the vector type. Lanes are read and replaced with `v[i]`, `.count` is
        \\the number of lanes, and `for` walks the lanes in order.
    );
    code_block(3, "glosso", #string
        \\#import "Io";
        \\#import "Simd";
        \\#import "Meta";
        \\
        \\V4 :: Simd(f32, 4);
        \\
        \\main :: () {
        \\    a: V4 = #simd .[1.0, 2.0, 3.0, 4.0];
        \\    b: V4 = #simd .[10.0, 20.0, 30.0, 40.0];
        \\    sum := a + b;
        \\    scaled := sum * simd_splat(V4, cast(f32) 0.5);
        \\    for lane: scaled print("[{}]", lane);
        \\    print("\n");
        \\    a[0] = 99.0;
        \\    print("{} {} {}\n", a[0], a.count, a == b);
        \\    print("{} {} {}\n", type_name(V4), size_of(V4), simd_lane_count(V4));
        \\    print("{}\n", scaled.simd_reduce_add(cast(f32) 0));
        \\}
    );
    code_block(4, "text", #string
        \\[5.5][11][16.5][22]
        \\99 4 false
        \\Simd(f32, 4) 16 4
        \\55
    );
    paragraph(5, #string,oneline
        \\The shape is checked where the type and the literal are written:
    );
    table_header(6, "Written   —   Diagnostic");
    table_row(7, "`Simd(f64, 65)` or `Simd(f64, 0)`   |   `Simd lane count must be a literal in 1..64`");
    table_row(8, "`Simd(s128, 2)`, `Simd(f16, 4)`, `Simd(bool, 4)`   |   `unsupported Simd lane type s128` (and likewise)");
    table_row(9, "`v: Simd(s32, 4) = .[1, 2, 3, 4];`   |   `ordinary array literal .[...] cannot initialize Simd(s32, 4); use #simd .[...]`");
    table_row(10, "`v := #simd .[1, 2, 3, 4];`   |   `#simd literal requires a Simd(T, N) context`");
    table_row(11, "`v: Simd(s32, 4) = #simd .[1, 2, 3];`   |   `SIMD literal has 3 lane(s), expected 4`");
    subheading(12, "Vector operators");
    paragraph(13, #string,oneline
        \\The operators `+`, `-`, `*`, `/` and prefix `-` work lane by lane on
        \\every vector, and `&`, `|`, `^`, `~`, `<<` and `>>` on vectors with
        \\integer lanes. Integer lanes wrap on overflow instead of being checked;
        \\a zero divisor in a lane is still checked like an integer division
        \\(see Integer Arithmetic, Overflow, and Traps). Both operands must have
        \\the same vector type: there is no implicit broadcast of a scalar, so
        \\`v + 1` is `error: no operator '+' for Simd(s32, 4), ssize`, and
        \\`simd_splat` builds the vector instead. `==` and `!=` compare whole
        \\vectors and give a single `bool`; there is no lane-wise comparison
        \\operator.
    );
    subheading(14, "The `Simd` module");
    table_header(15, "Procedure   —   Result");
    table_row(16, "`simd_zero(V)`   |   a vector of type `V` with every lane zero");
    table_row(17, "`simd_splat(V, x)`   |   every lane set to `x`, which must already have the lane type");
    table_row(18, "`simd_load(V, p)`, `simd_store(p, v)`   |   move all lanes from or to contiguous memory at the many-pointer `p`, aligned or not");
    table_row(19, "`v.simd_reverse()`   |   the lanes in reverse order");
    table_row(20, "`v.simd_reduce_add(x)`, `simd_reduce_mul`, `simd_reduce_xor`, `simd_reduce_or`   |   all lanes folded into `x` from lane 0 upward");
    table_row(21, "`simd_lane_count(V)`, `simd_element_type(V)`   |   the shape of a vector type, at compile time");
    subheading(22, "Vectors and memory");
    paragraph(23, #string,oneline
        \\A vector is not an array. It has no `.data` (`error: Simd has no
        \\stable .data pointer`) and cannot be sliced, because where its lanes
        \\live, in a register or in memory, is the compiler's choice. It converts
        \\to and from a fixed array of the same element type and length with
        \\`cast` or `acast`, never implicitly (`cannot implicitly convert [4]f32
        \\to Simd(f32, 4); use cast(Simd(f32, 4))value or acast`). `simd_load`
        \\and `simd_store` move lanes to and from any memory.
    );
    code_block(24, "glosso", #string
        \\#import "Io";
        \\#import "Simd";
        \\
        \\I4 :: Simd(s32, 4);
        \\
        \\main :: () {
        \\    values: [8]s32 = .[1, 2, 3, 4, 5, 6, 7, 8];
        \\    low := simd_load(I4, values.data);
        \\    high := simd_load(I4, values.data + 4);
        \\    out: [4]s32;
        \\    simd_store(out.data, low * high);
        \\    print("{} {} {} {}\n", out[0], out[1], out[2], out[3]);
        \\    lanes: [4]s32 = .[5, 6, 7, 8];
        \\    v := cast(I4) lanes;
        \\    back := cast([4]s32) v.simd_reverse();
        \\    print("{} {}\n", back[0], back[3]);
        \\}
    );
    code_block(25, "text", #string
        \\5 12 21 32
        \\8 5
    );
    paragraph(26, #string,oneline
        \\`simd_load` and `simd_store` do not check their pointer; it must
        \\address at least as many elements as the vector has lanes. A vector has
        \\no C calling convention, so a `#c_call` signature cannot contain one;
        \\pass a pointer to the elements and load them on the Glosso side.
    );
    subheading(27, "Matrix types");
    paragraph(28, #string,oneline
        \\A `Matrix(T, Rows, Cols)` holds its elements inline, row after row,
        \\with no allocation. `m[i]` and `.count` treat it as a flat sequence of
        \\`Rows * Cols` elements, so the element at row `r` and column `c` is
        \\`m[r * Cols + c]`, and `for` walks the elements in that order. It is
        \\copied like any other value; pass a pointer to a large matrix or to one
        \\a procedure should change. A literal is written `#matrix .[...]` with
        \\commas between the columns and semicolons between the rows.
    );
    code_block(29, "glosso", #string
        \\#import "Io";
        \\#import "Math/Matrix";
        \\#import "Meta";
        \\
        \\M23 :: Matrix(s64, 2, 3);
        \\
        \\main :: () {
        \\    m: M23 = #matrix .[1, 2, 3;
        \\                       4, 5, 6];
        \\    print("{} {} {}\n", m.count, m[4], size_of(M23));
        \\    value, ok := m.get(1, 2);
        \\    missing, found := m.get(5, 0);
        \\    print("{} {} {} {}\n", value, ok, missing, found);
        \\    changed, stored := m.set(0, 0, cast(s64) 99);
        \\    print("{} {} {}\n", changed[0], m[0], stored);
        \\    t := m.transpose();
        \\    p := m.multiply(t);
        \\    print("{} {}\n", type_name(type_of(t)), type_name(type_of(p)));
        \\    print("{} {} {} {}\n", p[0], p[1], p[2], p[3]);
        \\    v: [3]s64 = .[1, 0, 1];
        \\    r := m.matvec(v);
        \\    print("{} {}\n", r[0], r[1]);
        \\    for e: m.scale(cast(s64) 10) print("[{}]", e);
        \\    print("\n");
        \\}
    );
    code_block(30, "text", #string
        \\6 5 48
        \\6 true 0 false
        \\99 1 true
        \\Matrix(s64, 3, 2) Matrix(s64, 2, 2)
        \\14 32 32 77
        \\4 10
        \\[10][20][30][40][50][60]
    );
    subheading(31, "Matrix operations");
    paragraph(32, #string,oneline
        \\`get` returns the element and `true`, or a zero and `false` for a
        \\position outside the matrix. `set` does not modify its receiver: it
        \\returns a changed copy and a success flag. `m[i] = x` assigns an element
        \\in place. The other operations, `transpose`, `multiply`, `matvec`,
        \\`add`, `subtract` and `scale`, and the constructors `matrix_zero`,
        \\`matrix_fill`, `matrix_identity` and `matrix_from_array`, also return
        \\new values. Matrices have no arithmetic operators and no `Show`
        \\instance.
    );
    paragraph(33, #string,oneline
        \\The result shapes are computed at compile time, so multiplying
        \\matrices whose shapes do not fit together is a compile error at the
        \\call:
    );
    code_block(34, "text", #string
        \\// m: Matrix(s64, 2, 3) = ...; n := m.multiply(m);
        \\error: constraint failed for multiply
        \\note: the #modify constraint fails here: incompatible matrix product types
    );
    subheading(35, "Matrix literals");
    paragraph(36, #string,oneline
        \\A `#matrix` literal needs a matrix type from its context, such as an
        \\annotated declaration, a parameter, a return type or a `cast`, and both
        \\of its dimensions must match that type. A row may end with a comma and
        \\the last row with a semicolon. `#matrix .[]` initializes any matrix
        \\with no elements, such as a `Matrix(s64, 0, 3)`. An ordinary array
        \\literal never initializes a matrix.
    );
    table_header(37, "Written for `M23 :: Matrix(s64, 2, 3)`   —   Diagnostic");
    table_row(38, "`m: M23 = #matrix .[1, 2, 3; 4, 5];`   |   `#matrix literal row 2 has 2 column(s), expected 3`");
    table_row(39, "`m: M23 = #matrix .[1, 2, 3, 4, 5, 6];`   |   `Matrix literal expects 2 row(s) and 3 column(s), got 1 row(s) and 6 column(s)`");
    table_row(40, "`m: M23 = .[1, 2, 3, 4, 5, 6];`   |   `ordinary array literal .[...] cannot initialize Matrix(s64, 2, 3); use #matrix .[...; ...]`");
    table_row(41, "`m := #matrix .[1, 2; 3, 4];`   |   `#matrix literal requires a Matrix(T, Row, Col) context`");
    subheading(42, "Matrices and arrays");
    paragraph(43, #string,oneline
        \\`m.to_array()` and `matrix_from_array(M, values)` copy between a matrix
        \\and a fixed array of exactly `Rows * Cols` elements of the same type,
        \\in row-major order; `matrix_array_type(M)` names that array type.
        \\Arrays, Views, Dynamic Arrays, and Slicing describes fixed arrays.
    );
}

render_section_31 :: () {
    paragraph(0, #string,oneline
        \\A value changes type only where the program says so or where nothing
        \\can be lost. This chapter describes both halves of that rule. The
        \\first covers numeric literals and untyped constants, which have no
        \\runtime type until their context gives them one, and the range check
        \\that context applies. The second covers conversions between values
        \\that already have a type: the few that happen implicitly, and the
        \\explicit `cast` and `acast` for everything else. Values, Variables,
        \\and Arithmetic introduces literals and explicit types by example.
    );
    subheading(1, "Compile-time numbers");
    paragraph(2, #string,oneline
        \\A numeric literal has no runtime type of its own. `200` is a
        \\compile-time integer and `2.5` a compile-time float, numbers whose
        \\exact value the compiler knows and whose type is decided by where they
        \\are used. So `x: u8 = 200` and `x: s128 = 200` both mean two hundred.
        \\Compiler messages call the two kinds `comptime_int` and
        \\`comptime_float`; neither name can be written in a program
        \\(`unknown type 'comptime_int'`).
    );
    paragraph(3, #string,oneline
        \\Arithmetic between compile-time numbers is exact and gives another
        \\compile-time number. Integer division stays integer division, and an
        \\integer meeting a float gives a float. No intermediate result is limited
        \\to 64 bits, so `1 << 70` is a valid constant.
    );
    code_block(4, "glosso", #string
        \\#import "Io";
        \\
        \\BIG :: 1 << 70;
        \\HALF :: 7 / 2;
        \\RATIO :: 7.0 / 2;
        \\
        \\main :: () {
        \\    print("{} {} {}\n", BIG >> 68, HALF, RATIO);
        \\    byte: u8 = 200 + 55;
        \\    precise: f32 = 1 / 3.0;
        \\    print("{} {}\n", byte, precise);
        \\}
    );
    code_block(5, "text", #string
        \\4 3 3.5
        \\255 0.333333
    );
    subheading(6, "Where a number takes its type");
    paragraph(7, #string,oneline
        \\A compile-time number takes the type its context expects: the
        \\annotation of a declaration, the target of an assignment, a parameter,
        \\the return type, a field of an aggregate literal, or the other operand
        \\of a binary operator. With `x: u8`, `x * 3` is `u8` arithmetic and
        \\`x == 3` compares two `u8` values. A number can become a type of its own
        \\family or of a wider one:
    );
    table_header(8, "Kind   —   Can become   —   Default");
    table_row(9, "`comptime_int`   |   any integer, float or complex type   |   `ssize`");
    table_row(10, "`comptime_float`   |   any float or complex type   |   `f64`");
    paragraph(11, #string,oneline
        \\The other direction is refused with the kind named, and a `distinct`
        \\type accepts only literals of its representation's family:
    );
    code_block(12, "text", #string
        \\// x: s64 = 1.5;
        \\error: cannot implicitly convert comptime_float to s64
        \\
        \\// Meters :: distinct f64; m: Meters = 3;
        \\error: cannot implicitly convert comptime_int to Meters
    );
    subheading(13, "Defaulting");
    paragraph(14, #string,oneline
        \\When nothing decides the type, the number takes its default: `ssize`
        \\for an integer and `f64` for a float. This happens at a `:=`
        \\declaration and when a literal is the argument for a generic `$T`
        \\parameter. An integer literal outside the range of `ssize` defaults to
        \\`s128`, or beyond that to the narrowest signed type that holds it.
    );
    code_block(15, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\name_of :: (value: $T) -> str { return type_name(T); }
        \\
        \\main :: () {
        \\    a := 5;
        \\    b := 5.0;
        \\    c := 1 + 2.5;
        \\    huge := 9223372036854775808;
        \\    print("{} {} {} {}\n", type_of(a), type_of(b), type_of(c), type_of(huge));
        \\    print("{} {}\n", name_of(5), name_of(0.5));
        \\    x: u8 = 7;
        \\    print("{} {}\n", type_of(x * 3), type_of(x == 3));
        \\}
    );
    code_block(16, "text", #string
        \\ssize f64 f64 s128
        \\ssize f64
        \\u8 bool
    );
    paragraph(17, #string,oneline
        \\When several overloads or typeclass instances would accept a call only
        \\because its literal arguments could take several types, the candidate
        \\whose parameter types are the defaults of those arguments is chosen,
        \\and an integer literal may also stand for `f64` where no candidate
        \\takes it as an integer. With instances for `(ssize, ssize)`,
        \\`(f64, f64)` and `(f32, f32)`, the call `f(1, 2)` uses the first and
        \\`f(1, 2.5)` the second. Instance Resolution and Negative Instances
        \\gives the full order.
    );
    subheading(18, "The value must fit");
    paragraph(19, #string,oneline
        \\When a compile-time integer becomes an integer type, its value is
        \\checked against that type's range. Because constant arithmetic is
        \\exact, the check sees the true result, and a value at the edge of the
        \\range is accepted while one past it is an error, not a wrapped number.
    );
    code_block(20, "text", #string
        \\// x: u8 = 300;
        \\error: 300 does not fit u8, whose range is 0..=255
        \\
        \\// x: u8 = -1;
        \\error: -1 does not fit u8, whose range is 0..=255
        \\
        \\// x: u8 = 200 + 100;
        \\error: 300 does not fit u8, whose range is 0..=255
        \\note: compile-time integer arithmetic is exact; the result is checked against the type it is given
    );
    paragraph(21, #string,oneline
        \\A literal written in a base, such as `16#ff`, is a bit pattern and may
        \\use every bit of the type, so `16#ffff_ffff_ffff_ffff` is the largest
        \\`u64` and `-1` as an `s64`. `~` is evaluated at the width of the
        \\target, so `~127` is `128` as a `u8`. A pattern wider than the type is
        \\still an error.
    );
    code_block(22, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    mask: u64 = 16#ffff_ffff_ffff_ffff;
        \\    same: s64 = 16#ffff_ffff_ffff_ffff;
        \\    low: s8 = -128;
        \\    complement: u8 = ~127;
        \\    print("{} {} {} {}\n", mask, same, low, complement);
        \\}
    );
    code_block(23, "text", #string
        \\18446744073709551615 -1 -128 128
    );
    code_block(24, "text", #string
        \\// x: s8 = 16#1ff;
        \\error: 511 does not fit s8, whose range is -128..=127
        \\note: a based literal is a bit pattern, so it may use every bit of s8 - this one is wider than that
    );
    paragraph(25, #string,oneline
        \\Float literals are checked against the range of their float type in
        \\the same way; Floating-Point and Complex Arithmetic gives the
        \\diagnostics.
    );
    subheading(26, "Named constants");
    paragraph(27, #string,oneline
        \\A constant declared without a type, `LIMIT :: 100`, is a compile-time
        \\number like the literal it names: it takes its type from each use and
        \\is checked against it, so `K :: 300; x: u8 = K;` is rejected exactly as
        \\`x: u8 = 300;` is. An element of a constant array also narrows when its
        \\value fits. A constant with a declared fixed-width type, such as
        \\`TYPED : s64 : 100`, has that type and converts only as an `s64`
        \\would, so narrowing it to `u8` needs a `cast`.
    );
    code_block(28, "glosso", #string
        \\#import "Io";
        \\
        \\LIMIT :: 100;
        \\TYPED : s64 : 100;
        \\TABLE : [3]s64 : .[10, 20, 30];
        \\
        \\main :: () {
        \\    a: u8 = LIMIT;
        \\    b: u8 = TABLE[2];
        \\    c: u8 = cast(u8) TYPED;
        \\    print("{} {} {}\n", a, b, c);
        \\}
    );
    code_block(29, "text", #string
        \\100 30 100
    );
    note(30, #string,oneline
        \\A local declared with `:=` from a compile-time number is an `ssize`,
        \\but while the compiler still knows its value, because nothing has
        \\assigned to it or taken its address yet, using it directly narrows by
        \\value too: after `n := 10;`, `b: u8 = n;` compiles. Once `n` has been
        \\assigned, the same line is `error: got ssize, expected u8`. Declare the
        \\local with the type it is meant to have rather than relying on this.
    );
    subheading(31, "Implicit conversions between integers");
    paragraph(32, #string,oneline
        \\A value that already has a type changes it implicitly only when no
        \\information can be lost or misread. Every other conversion is written
        \\out with `cast(T)` or `acast`, so a narrowing, a change of sign or a
        \\float rounding is visible where it happens. Implicit conversions take
        \\place wherever a value meets an expected type: a declaration with a
        \\type, an assignment, an argument, a `return`, and a field of an
        \\aggregate literal.
    );
    paragraph(33, #string,oneline
        \\An integer converts to another integer type that holds every value of
        \\the source. Within the same signedness the target must be at least as
        \\wide; an unsigned value needs a strictly wider signed target, because
        \\the sign takes a bit; a signed value never converts to an unsigned type,
        \\because a negative value has no place there. `ssize` and `usize` count
        \\with the width they have on the target, so on a 64-bit target `s64`
        \\and `ssize` convert into each other, and on a 32-bit target they do
        \\not.
    );
    table_header(34, "From   —   To   —   Implicit");
    table_row(35, "`u8`   |   `u16`, `s16`, `ssize`   |   yes");
    table_row(36, "`u32`   |   `s64`   |   yes");
    table_row(37, "`u64`   |   `s128`, `u128`   |   yes");
    table_row(38, "`s64`   |   `ssize` (64-bit target)   |   yes");
    table_row(39, "`u64`   |   `s64`   |   no: `got u64, expected s64`");
    table_row(40, "`s8`   |   `u16`   |   no: `got s8, expected u16`");
    table_row(41, "`s64`   |   `s8`   |   no: `got s64, expected s8`");
    table_row(42, "`usize`   |   `ssize`   |   no: `got usize, expected ssize`");
    paragraph(43, #string,oneline
        \\The feature gate `lossy_numerics` lifts this restriction for the
        \\declarations it covers; Integer Arithmetic, Overflow, and Traps
        \\describes it.
    );
    subheading(44, "Other implicit conversions");
    paragraph(45, #string,oneline
        \\Besides the integer widenings and the compile-time numbers described
        \\above, these conversions are implicit. Every value converts to `any`.
        \\A pointer to a mutable value converts to a pointer to a constant one,
        \\`*T` to `*const T`, and likewise a view `[]T` to `[]const T`; a pointer
        \\converts to the optional pointer `?*T`, and `null` to any optional. A
        \\`cstr` converts to `*const u8` and `[*]const u8`, and a string literal
        \\to any of the string types. An expression of type `#Never` is accepted
        \\everywhere. Pointer Types gives the details for pointers, and `?T` and
        \\`E!T` for optionals.
    );
    paragraph(46, #string,oneline
        \\Nothing else is implicit. In particular no float converts to another
        \\float, no runtime integer becomes a float or the reverse, `bool` and
        \\`rune` do not mix with integers, a `distinct` type does not mix with
        \\its representation, a `str` does not become a `cstr`, and a dynamic
        \\array does not become a view without `[..]`. A rejected conversion is
        \\reported with both types; at an argument the message names the call.
    );
    code_block(47, "text", #string
        \\// x: s32 = 5; y: s64 = x; z: s32 = y;
        \\error: got s64, expected s32
        \\
        \\// f :: (x: s64) {} ... f(cast(u64) 5);
        \\error: arg type u64 != s64 in call f
        \\
        \\// r: rune = #char "a"; n: u32 = r;
        \\error: got rune, expected u32
    );
    subheading(48, "`cast` and `acast`");
    paragraph(49, #string,oneline
        \\`cast(T) expr` converts `expr` to `T`. `acast expr` is the same
        \\conversion with the target type taken from the context, which saves
        \\writing a type the reader can already see. Both have a method-like
        \\form, `expr.cast(T)` and `expr.acast`, which reads well at the end of a
        \\chain of calls.
    );
    code_block(50, "glosso", #string
        \\#import "Io";
        \\
        \\Point :: struct { x: u8; }
        \\
        \\take_u8 :: (v: u8) -> u8 { return v; }
        \\to_f32 :: (v: ssize) -> f32 { return acast v; }
        \\
        \\main :: () {
        \\    big: ssize = 300;
        \\    a := cast(u8) big;
        \\    b := big.cast(u8);
        \\    c: u8 = acast big;
        \\    d: u8 = big.acast;
        \\    p: Point = .{ .x = acast big };
        \\    print("{} {} {} {} {}\n", a, b, c, d, p.x);
        \\    print("{} {}\n", take_u8(acast big), to_f32(7));
        \\}
    );
    code_block(51, "text", #string
        \\44 44 44 44 44
        \\44 7
    );
    paragraph(52, #string,oneline
        \\`acast` works only where the expected type is known: an annotated
        \\declaration, an assignment, a typed parameter, a field of an aggregate
        \\literal and a `return`. Elsewhere, for example as an operand of `+` or
        \\in a `:=` declaration, there is nothing to take the type from. `cast`
        \\always needs its parentheses.
    );
    code_block(53, "text", #string
        \\// a := acast 5;
        \\error: acast needs a target type from context or an explicit cast type
        \\
        \\// x := cast ssize 5;
        \\error: cast requires a type in parentheses; use acast for contextual casts
    );
    subheading(54, "What a cast does");
    table_header(55, "Source   —   Target   —   Result");
    table_row(56, "integer   |   integer   |   the low bits of the value, extended by its sign or by zeros when the target is wider");
    table_row(57, "float   |   integer   |   truncated toward zero; clamped to the target's range; NaN gives 0");
    table_row(58, "integer or float   |   float   |   the nearest value of the target type");
    table_row(59, "`bool`   |   integer or float   |   `1` or `0`");
    table_row(60, "integer or float   |   `bool`   |   `true` when the value is not zero");
    table_row(61, "enum   |   integer, and back   |   the member's value; the reverse direction is checked, see below");
    table_row(62, "`rune`   |   integer, and back   |   the code point");
    table_row(63, "`distinct` type   |   its representation, and back   |   the same value with the other type; see Nominal Types with `distinct` for struct representations");
    table_row(64, "`[N]T`   |   `Simd(T, N)`, and back   |   the same elements; the shapes must match exactly");
    table_row(65, "`str`   |   `[]const u8`, and back   |   the same bytes viewed as the other type");
    table_row(66, "`cstr`   |   `str`   |   a view of the bytes before the terminating zero");
    table_row(67, "pointer   |   pointer, integer   |   the same address");
    table_row(68, "integer   |   pointer, optional pointer   |   the address; see below");
    code_block(69, "glosso", #string
        \\#import "Io";
        \\#import "Math/Core";
        \\
        \\Color :: enum { Red; Green; Blue; }
        \\
        \\main :: () {
        \\    wide: u64 = 300;
        \\    minus: s8 = -1;
        \\    print("{} {} {}\n", cast(s8) wide, cast(u8) minus, cast(s64) minus);
        \\    f: f64 = -3.9;
        \\    big: f64 = 1e20;
        \\    print("{} {} {} {}\n", cast(s32) f, cast(u8) f, cast(s32) big, cast(s32) quiet_nan());
        \\    n: s64 = 7;
        \\    print("{} {}\n", cast(f32) n, cast(f32) 0.1);
        \\    print("{} {} {}\n", cast(s64) true, cast(bool) n, cast(f64) false);
        \\    print("{} {}\n", cast(s64) Color.Blue, cast(Color) 1);
        \\    print("{} {}\n", cast(u8) 300, cast(u8) 300.0);
        \\}
    );
    code_block(70, "text", #string
        \\44 255 -1
        \\-3 0 2147483647 0
        \\7 0.1
        \\1 true 0
        \\2 Green
        \\44 255
    );
    paragraph(71, #string,oneline
        \\A cast also accepts a compile-time number without the range check that
        \\an implicit conversion makes: `cast(u8) 300` keeps the low eight bits
        \\and is `44`, while `x: u8 = 300` is an error. A float constant follows
        \\the float rule and clamps, so `cast(u8) 300.0` is `255`. A cast of a
        \\literal wider than 64 bits keeps every digit:
        \\`cast(u128) 340282366920938463463374607431768211455` is the number
        \\written.
    );
    subheading(72, "Checked casts");
    paragraph(73, #string,oneline
        \\Two casts can receive a value that has no meaning in the target type.
        \\An integer cast to an enum may not name a member. In a build with
        \\runtime checks, at `-O0` and `-O1`, the program stops with the
        \\position of the cast; at `-O2` and above the check is omitted and the
        \\enum holds the stray value.
    );
    code_block(74, "glosso", #string
        \\#import "Io";
        \\
        \\Color :: enum { Red; Green; Blue; }
        \\
        \\to_color :: (n: s64) -> Color {
        \\    return cast(Color) n;
        \\}
        \\
        \\main :: () {
        \\    print("{}\n", to_color(1));
        \\    print("{}\n", to_color(7));
        \\}
    );
    code_block(75, "text", #string
        \\$ glosso --run color.glo 2>&1 | tail -3
        \\Green
        \\color.glo:6:12: runtime check failed: the value is not a member of Color
        \\glosso: program exited with status 134
        \\$ glosso --run -O2 color.glo 2>/dev/null
        \\Green
        \\7
    );
    paragraph(76, #string,oneline
        \\An integer cast to a pointer must not be zero, because a plain pointer
        \\is never null. A zero known at compile time is an error that names the
        \\alternative, and a zero arriving at run time stops a checked build.
        \\`cast(?*T) address` has no such condition: it gives `null` for zero.
        \\Pointer Types describes pointer casts in full.
    );
    code_block(77, "text", #string
        \\// p := cast(*ssize) 0;
        \\error: cast to *ssize of an address that is zero at compile time
        \\note: a plain pointer excludes zero - that is what gives ?T its niche, where .None IS address 0
        \\note: cast to ?*ssize instead, which is total and yields .None here
    );
    subheading(78, "Casts that are rejected");
    paragraph(79, #string,oneline
        \\A cast converts or reinterprets one value; it does not restructure
        \\aggregates, build strings or unwrap optionals. Any pair not in the
        \\table above is rejected with both types named. Conversion to `any` is
        \\implicit and therefore not a cast, and an optional is unwrapped by a
        \\pattern, as described in `?T` and `E!T`.
    );
    code_block(80, "text", #string
        \\// s: str = "12"; n := cast(ssize) s;
        \\error: cannot cast str to ssize
        \\
        \\// s: str = "hi"; c := cast(cstr) s;
        \\error: cannot cast str to cstr
        \\
        \\// a: [4]f32; b := cast([2]f32) a;
        \\error: cannot cast [4]f32 to [2]f32
        \\
        \\// o: ?*s64 = null; p := cast(*s64) o;
        \\error: cannot cast ?*s64 to *s64
    );
}

render_section_32 :: () {
    paragraph(0, #string,oneline
        \\`Name :: distinct T` declares a new type that is represented exactly
        \\like `T` but is not `T`. Size, alignment and machine operations are
        \\those of `T`; what changes is that the compiler keeps the two apart, so
        \\a length cannot be passed where a duration is expected and a file
        \\handle cannot be added to a count. This chapter describes how values
        \\cross between a distinct type and its representation, and how the
        \\type gets its operators.
    );
    paragraph(1, #string,oneline
        \\A `distinct` type is different from a second name for a type.
        \\`Name :: T` declares an alias: `Name` and `T` are the same type,
        \\`Name == T` is `true`, and values pass freely between them.
        \\`Name :: distinct T` makes `Name == T` false.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Meters  :: distinct f64 #derive(Add, Sub, PartialOrd, Mul(Meters, f64));
        \\Seconds :: distinct f64;
        \\Count   :: distinct s64 #derive,all;
        \\Handle  :: distinct u32;
        \\
        \\main :: () {
        \\    a: Meters = 3.0;
        \\    b := cast(Meters) 4.5;
        \\    total := a + b;
        \\    doubled := total * 2.0;
        \\    print("{} {} {}\n", total, doubled, a < b);
        \\    print("{} {} {}\n", type_name(type_of(doubled)), size_of(Handle), Is_Float(Meters));
        \\    n: Count = 5;
        \\    print("{}\n", n * n - n);
        \\    h := cast(Handle) 7;
        \\    print("{}\n", cast(u32) h + 1);
        \\}
    );
    code_block(3, "text", #string
        \\7.5 15 true
        \\Meters 4 true
        \\20
        \\8
    );
    paragraph(4, #string,oneline
        \\The type has its own name, which `type_name` and every diagnostic use.
        \\Type predicates answer as for the representation, so `Is_Float(Meters)`
        \\is true. `distinct` is recognized only in this position, after `::`;
        \\elsewhere it is an ordinary identifier.
    );
    subheading(5, "Crossing the boundary");
    paragraph(6, #string,oneline
        \\No value converts implicitly between a distinct type and its
        \\representation, in either direction, nor between two distinct types
        \\with the same representation. A numeric literal of the
        \\representation's own family is accepted directly, which is why
        \\`a: Meters = 3.0` compiles; an integer literal for `Meters` is not. A
        \\string literal initializes a distinct string type, but `true` and
        \\`false` are typed `bool` values and do not become a distinct `bool`
        \\without a `cast`. Except over a struct, described next, `cast` crosses
        \\in both directions.
    );
    code_block(7, "text", #string
        \\// a: Meters = 3.0; x: f64 = a;
        \\error: got Meters, expected f64
        \\
        \\// a: Meters = 3.0; s: Seconds = a;
        \\error: got Meters, expected Seconds
        \\
        \\// m: Meters = 3;
        \\error: cannot implicitly convert comptime_int to Meters
        \\
        \\// Flag :: distinct bool; f: Flag = true;
        \\error: got bool, expected Flag
    );
    subheading(8, "Representations");
    paragraph(9, #string,oneline
        \\The representation can be any type. Over a scalar, a pointer, `bool`,
        \\an enum or a string, `cast` converts both ways. A distinct struct type
        \\is built with an aggregate literal of its own, and its fields are read
        \\and assigned as usual, but no cast connects it to the original struct
        \\in either direction: with `Position :: distinct Point`, both
        \\`cast(Position) point` and `cast(Point) position` are errors
        \\(`error: cannot cast Point to Position`).
    );
    code_block(10, "glosso", #string
        \\#import "Io";
        \\
        \\Point :: struct { x: s64; y: s64; }
        \\Position :: distinct Point;
        \\Name :: distinct str;
        \\Flag :: distinct bool;
        \\
        \\main :: () {
        \\    at: Position = .{ .x = 2, .y = 5 };
        \\    at.y += 1;
        \\    print("{} {}\n", at.x, at.y);
        \\    who: Name = "glosso";
        \\    print("{} {}\n", cast(str) who, who.count);
        \\    on := cast(Flag) true;
        \\    print("{}\n", cast(bool) on);
        \\}
    );
    code_block(11, "text", #string
        \\2 6
        \\glosso 6
        \\true
    );
    subheading(12, "Operators come from `#derive`");
    paragraph(13, #string,oneline
        \\A distinct type starts with no operators at all, not even `==`. The
        \\`#derive` list after the declaration names the operator typeclasses
        \\whose operators it borrows from its representation; Operator
        \\Declarations lists which typeclass owns which operator. Leaving one out
        \\is the point of the feature: two lengths can be added, but multiplying
        \\two lengths does not give a length, so `Meters` above derives `Add`
        \\and `Mul(Meters, f64)` and not `Mul`.
    );
    table_header(14, "Written   —   Grants");
    table_row(15, "`#derive(Add)`   |   the operator of `Add` with every operand of the distinct type: `Meters + Meters`");
    table_row(16, "`#derive(Mul(Meters, f64))`   |   the operator with exactly these operand types: `Meters * f64`");
    table_row(17, "`#derive(Add, Sub, PartialOrd)`   |   each class in the list");
    table_row(18, "`#derive,all`   |   every operator the representation has");
    table_row(19, "no `#derive`   |   no operators");
    paragraph(20, #string,oneline
        \\The operation is the representation's own, and when its result is the
        \\representation the result gets the distinct type back: `Meters +
        \\Meters` and `Meters * f64` are `Meters`, while `Meters < Meters` is a
        \\`bool`. `#derive,all` cannot add an operator the representation lacks;
        \\`%` on a `distinct f64` is still `no operator '%' for f64, f64`.
    );
    code_block(21, "text", #string
        \\// a: Meters = 3.0; x := a == a;
        \\error: no operator '==' for Meters and Meters: a distinct type gets only the classes it derives; add '#derive(...)' or '#derive,all' on the declaration of 'Meters'
        \\
        \\// a: Meters = 3.0; s: Seconds = 1.0; x := a + s;
        \\error: no operator '+' between different distinct types: Meters and Seconds
        \\
        \\// X :: distinct f64 #derive;
        \\error: '#derive' on a distinct type needs a class list or ',all'
    );
    subheading(22, "Generic code and printing");
    paragraph(23, #string,oneline
        \\The `#derive` list governs operators only. A procedure or typeclass
        \\instance written for any type satisfying a predicate, such as the
        \\`Show` instance for `Is_Float`, also accepts the distinct type, but its
        \\body is checked with the distinct type and may only use the operators
        \\the type derives. That is why `Meters` prints directly, while a
        \\distinct integer prints only when it derives `PartialOrd` (or uses
        \\`#derive,all`, like `Count`), and `Handle` above is printed through a
        \\cast. An instance written for one concrete type does not apply to a
        \\distinct type at all, whatever it derives. The `Show` instances of
        \\`bool` and `str` are of that kind, so a distinct `bool` or string is
        \\printed through a cast to its representation, as `who` and `on` are
        \\above; printing it directly is
        \\`error: no Formatter instance for selector '' and value type Name`.
    );
    paragraph(24, #string,oneline
        \\The chapter `#derive` describes `#derive` on structs and other
        \\declarations, where it generates instances rather than borrowing
        \\operators.
    );
}

}
