#import "Format";
#import "String_Builder";
#import "Math/Core";
#import "clay_ui.glo";

#public {

// Chapters 76-78: Concurrency.

render_section_76 :: () {
    paragraph(
        0,
        #string,oneline
            \\A program starts with one thread, the one that runs `main`, and
            \\starts more through the standard library. Threads are not syntax:
            \\they are procedures of the `Thread` module and its submodules. What
            \\the compiler contributes is a check on what may pass from one thread
            \\to another, described in `Send`, `Sync`, and Shared Data. This
            \\chapter describes the ways to start threads and wait for them, what
            \\each thread has of its own, and the errors the operations report.
            \\There are three checked ways to run code on other threads and one
            \\unchecked one:
    );
    table_header(1, "Procedure   —   What it does");
    table_row(
        2,
        #string,oneline
            \\`spawn_owned(value, entry)`   |   Starts one thread that runs
            \\`entry(value)`. The value is handed to that thread, and the result
            \\comes back through `join`. Module `Thread/Task`.
    );
    table_row(
        3,
        #string,oneline
            \\`thread_scope(&ctx, tasks)`   |   Runs a batch of tasks on as many
            \\new threads, all sharing one context, and returns when every task
            \\has finished. Module `Thread`.
    );
    table_row(
        4,
        #string,oneline
            \\`pool.run(&ctx, tasks)`   |   The same on the workers of a
            \\`Thread_Pool`, which stay alive between batches. Module `Thread`.
    );
    table_row(
        5,
        #string,oneline
            \\`Thread.spawn(proc, data)`   |   Starts an operating-system thread
            \\with an untyped pointer; nothing is checked. Module `Thread`.
    );
    subheading(6, "Handing a value to a thread: `spawn_owned`");
    paragraph(
        7,
        #string,oneline
            \\`spawn_owned(value, entry)` starts a thread and calls `entry(value)`
            \\on it. `entry` is any procedure of type `(T) -> R`, named or a
            \\lambda. The call returns at once with a `Thread_Error!Task(R)` while
            \\the new thread runs, and `join` on the task waits for the thread to
            \\finish and returns the result as a `Thread_Error!R`.
    );
    code_block(
        8,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\
            \\count_primes :: (limit: s64) -> s64 {
            \\    count: s64 = 0;
            \\    for n: 2..limit {
            \\        prime := true;
            \\        d: s64 = 2;
            \\        while d * d <= n {
            \\            if n % d == 0 { prime = false; break; }
            \\            d += 1;
            \\        }
            \\        if prime count += 1;
            \\    }
            \\    return count;
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    small := spawn_owned(10000, count_primes)?;
            \\    large := spawn_owned(100000, count_primes)?;
            \\    print("primes below 10000: {}\n", small.join()?);
            \\    print("primes below 100000: {}\n", large.join()?);
            \\    return .Ok;
            \\}
    );
    code_block(
        9,
        "text",
        #string
            \\primes below 10000: 1229
            \\primes below 100000: 9592
    );
    paragraph(
        10,
        #string,oneline
            \\The two counts run at the same time. The program prints only after
            \\joining each task, so its output does not depend on which thread
            \\finishes first. `Thread_Error` implements `Error`, so `main` can
            \\return `Thread_Error!void` and pass every failure on with `?`; the
            \\last section of this chapter lists the errors.
    );
    paragraph(
        11,
        #string,oneline
            \\The value is handed to the new thread. From the call on it belongs to
            \\`entry`, and the caller must not use or release it again; nothing
            \\checks this, as for any transfer (see `Freeable`, Copies, and
            \\Ownership Transfer). When the value is an owner, `entry` releases it:
    );
    code_block(
        12,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\
            \\total :: (values: [..]s64) -> s64 {
            \\    defer free(&values);      // the input belongs to the entry
            \\    sum: s64 = 0;
            \\    for v: values sum += v;
            \\    return sum;
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    numbers: [..]s64;
            \\    for i: 1..101 numbers.push(i);
            \\    task := spawn_owned(numbers, total)?;    // numbers belongs to the task
            \\    print("{}\n", task.join()?);
            \\    return .Ok;
            \\}
    );
    code_block(
        13,
        "text",
        #string
            \\5050
    );
    paragraph(
        14,
        #string,oneline
            \\An owned result passes the other way: it belongs to whoever joins the
            \\task. If `spawn_owned` fails, it releases the value itself. Both `T`
            \\and `R` must be `Send`, so a value that points at the caller's
            \\variables cannot be handed over; `Send`, `Sync`, and Shared Data
            \\explains the rule and its diagnostic.
    );
    paragraph(
        15,
        #string,oneline
            \\The entry must return a value. With an entry that returns nothing,
            \\the instantiation of `spawn_owned` fails inside the standard library;
            \\an entry with nothing to report returns a placeholder such as a
            \\`bool`:
    );
    code_block(
        16,
        "text",
        #string
            \\// greet :: (name: str) { ... }   spawn_owned("worker", greet)
            \\error: union variant has no payload
            \\note: raised here, in standard library code, during instantiation of 'spawn_owned'
    );
    subheading(17, "Completing a task");
    paragraph(
        18,
        #string,oneline
            \\Every `Task(R)` is completed exactly once, by `join` or by `free`.
            \\`free(&task)` also waits for the thread, then releases the result when
            \\`R` is an owner, so `defer free(&task);` suits a task whose result is
            \\not needed. A task is a handle: assigning it copies the handle, both
            \\copies name the same thread, and once one of them is completed the
            \\other must not be joined or released.
    );
    paragraph(
        19,
        #string,oneline
            \\The type of a task depends only on its result type, so tasks with
            \\different input types fit in one array. `Task(R)` has only private
            \\fields and so no zero value; an array that is filled in a loop holds
            \\`?Task(R)`:
    );
    code_block(
        20,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\
            \\cube :: (n: s64) -> s64 { return n * n * n; }
            \\
            \\main :: () -> Thread_Error!void {
            \\    tasks: [4]?Task(s64);
            \\    for i: 0..4 tasks[i] = .Some(spawn_owned(cast(s64) i + 1, cube)?);
            \\    for slot: tasks {
            \\        #pattern .Some(task) := slot else { continue; };
            \\        print("{}\n", task.join()?);
            \\    }
            \\    return .Ok;
            \\}
    );
    code_block(
        21,
        "text",
        #string
            \\1
            \\8
            \\27
            \\64
    );
    subheading(22, "Scoped threads: `thread_scope`");
    paragraph(
        23,
        #string,oneline
            \\`thread_scope(ctx, tasks)` runs a batch of tasks at the same time.
            \\`tasks` is a view of procedures of type `(*const C) -> void`, and
            \\`ctx` points at one value of type `C`, the context, which every task
            \\receives. The call starts one thread per task, waits until every task
            \\has returned, joins the threads, and only then returns its
            \\`Thread_Error!void`.
    );
    code_block(
        24,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\Survey :: struct {
            \\    lines: [3]str;
            \\    next: Atomic(ssize);
            \\    vowels: [3]Atomic(s64);
            \\}
            \\
            \\is_vowel :: (c: rune) -> bool {
            \\    return c == #char "a" || c == #char "e" || c == #char "i"
            \\        || c == #char "o" || c == #char "u";
            \\}
            \\
            \\count_vowels :: (survey: *const Survey) {
            \\    i := survey.next.fetch_add(1);        // claim a line
            \\    n: s64 = 0;
            \\    for c: survey.lines[i] if is_vowel(c) n += 1;
            \\    survey.vowels[i].store(n);
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    survey := Survey.{ .lines = .["the quick brown fox", "jumps over", "the lazy dog"] };
            \\    tasks: [3]((*const Survey) -> void) = .[count_vowels, count_vowels, count_vowels];
            \\    thread_scope(&survey, tasks[..])?;
            \\    for i: 0..3 print("{} vowels in \"{}\"\n", survey.vowels[i].load(), survey.lines[i]);
            \\    return .Ok;
            \\}
    );
    code_block(
        25,
        "text",
        #string
            \\5 vowels in "the quick brown fox"
            \\3 vowels in "jumps over"
            \\3 vowels in "the lazy dog"
    );
    paragraph(
        26,
        #string,oneline
            \\Each task claims a line by adding 1 to an atomic counter, so three
            \\copies of one procedure work on three different lines. The tasks of
            \\a batch may also be different procedures or lambdas, as long as each
            \\has the task type. The threads take the tasks in turn, so a task is
            \\not tied to a thread: a thread that finishes its task early may run
            \\another task of the batch. Since there are as many threads as tasks,
            \\every task can be running at the same time. An empty batch returns
            \\`.Ok` without starting a thread. When a thread cannot be started,
            \\`thread_scope` joins the threads it already started and returns
            \\`.Err(.Spawn_Failed)` before any task has run.
    );
    subheading(27, "What a scoped task can reach");
    paragraph(
        28,
        #string,oneline
            \\The context usually lives in the caller's stack frame. Lending it to
            \\other threads is safe because `thread_scope` does not return, and the
            \\frame cannot end, until every task is done with it; that is what
            \\makes the threads scoped. Three rules keep the loan sound:
    );
    bullet(
        29,
        #string,oneline
            \\Tasks receive the context as `*const C`, so its ordinary fields are
            \\read-only to them. What tasks change lives in synchronized fields:
            \\an `Atomic`, a `Mutex`, a `Condvar` or a `Channel`, whose operations
            \\work through a `*const` pointer (see `Mutex`, `Condvar`, `Channel`,
            \\`Once`, and `Atomic`).
    );
    bullet(
        30,
        #string,oneline
            \\`C` must be `Sync`. A context that holds a raw pointer, a view or an
            \\`any` is rejected, because through it tasks could reach memory
            \\outside the context without synchronization. The data the tasks read
            \\is in the context itself, as values: fixed arrays, dynamic arrays,
            \\strings, structs.
    );
    bullet(
        31,
        #string,oneline
            \\A task cannot capture the caller's locals, because lambdas have no
            \\captures (see Lambdas and `#fn_ptr` Values). A value a task needs
            \\goes into the context.
    );
    code_block(
        32,
        "text",
        #string
            \\// .[|t| { _ := t.sum.fetch_add(step); }, ...]   (step is a local of main)
            \\error: lambda captures local 'step', but captured closures are not supported
            \\help: pass the value as an explicit callback or context argument
            \\
            \\// Job :: struct { input: []s64; sum: Atomic(s64); }   thread_scope(&job, tasks[..])
            \\error: constraint failed for thread_scope
    );
    paragraph(
        33,
        #string,oneline
            \\Global variables are outside these rules: every thread reaches every
            \\global, and nothing checks how. A global that tasks change must itself
            \\be a synchronized type; the `Once` example in `Mutex`, `Condvar`,
            \\`Channel`, `Once`, and `Atomic` keeps its shared state in globals that
            \\way.
    );
    subheading(34, "Thread pools: `Thread_Pool`");
    paragraph(
        35,
        #string,oneline
            \\A program that runs many short batches can keep its threads instead
            \\of starting new ones for each batch. `Thread_Pool.new(count)` starts
            \\`count` worker threads that wait for work. `run(ctx, tasks)` hands one
            \\batch to them under the same rules as `thread_scope`, including the
            \\`Sync` context, and returns when every task of the batch has
            \\returned. Batches may have different context types, and a batch may
            \\have more tasks than the pool has workers.
    );
    code_block(
        36,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\Blocks :: struct {
            \\    next: Atomic(s64);
            \\    total: Atomic(s64);
            \\}
            \\
            \\// Each task claims the next block of 1000 numbers and adds it up.
            \\add_block :: (b: *const Blocks) {
            \\    block := b.next.fetch_add(1);
            \\    subtotal: s64 = 0;
            \\    for n: block * 1000 + 1..block * 1000 + 1001 subtotal += n;
            \\    _ := b.total.fetch_add(subtotal);
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    pool := Thread_Pool.new(3)?;
            \\    defer free(&pool);
            \\    tasks: [10]((*const Blocks) -> void);
            \\    for i: 0..10 tasks[i] = add_block;
            \\    for round: 0..2 {
            \\        blocks: Blocks;
            \\        pool.run(&blocks, tasks[..])?;
            \\        print("round {}: {} on {} workers\n", round, blocks.total.load(), pool.worker_count());
            \\    }
            \\    return .Ok;
            \\}
    );
    code_block(
        37,
        "text",
        #string
            \\round 0: 50005000 on 3 workers
            \\round 1: 50005000 on 3 workers
    );
    paragraph(
        38,
        #string,oneline
            \\`free(&pool)`, like `pool.join()`, stops the workers, joins them and
            \\releases the pool, so `defer free(&pool);` follows `new`. A joined
            \\pool is empty: joining or releasing it again does nothing,
            \\`worker_count()` is 0, and `run` returns `.Err(.Invalid_Argument)`.
            \\A pool with zero workers is valid and runs every task on the calling
            \\thread, in order. One pool runs one batch at a time.
    );
    note(
        39,
        #string,oneline
            \\A pool runs at most as many tasks at once as it has workers, and a
            \\worker takes a new task only after its previous one has returned.
            \\Tasks of one batch therefore must not wait for each other: with
            \\fewer workers than tasks, a task that waits for one that has not
            \\started waits forever. `thread_scope` starts as many threads as
            \\there are tasks, so its tasks may wait for each other.
    );
    subheading(40, "Raw threads: `Thread.spawn`");
    paragraph(
        41,
        #string,oneline
            \\`Thread.spawn(proc, data)` is the layer the others are built on. It
            \\starts an operating-system thread that calls `proc(data)`. `proc` is
            \\a `Thread_Proc`, a procedure `(data: *void) -> ?*void` with the C
            \\calling convention, so it can be handed to the platform unchanged.
            \\`data` is any pointer, and nothing about it is checked: the caller
            \\keeps what it points at valid, and every shared access synchronized,
            \\until the thread ends.
    );
    code_block(
        42,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\Slot :: struct {
            \\    input: s64;
            \\    output: s64;
            \\}
            \\
            \\square :: (data: *void) -> ?*void #c_call {
            \\    slot := cast(*Slot) data;
            \\    slot.output = slot.input * slot.input;
            \\    return null;
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    slots: [3]Slot;
            \\    threads: [3]Thread;
            \\    for i: 0..3 {
            \\        slots[i].input = i + 2;
            \\        threads[i] = Thread.spawn(square, cast(*void) &slots[i])?;
            \\    }
            \\    for i: 0..3 _ := threads[i].join()?;
            \\    for slot: slots print("{} squared is {}\n", slot.input, slot.output);
            \\    return .Ok;
            \\}
    );
    code_block(
        43,
        "text",
        #string
            \\2 squared is 4
            \\3 squared is 9
            \\4 squared is 16
    );
    paragraph(
        44,
        #string,oneline
            \\`join` waits for the thread and returns the pointer `proc` returned,
            \\as a `Thread_Error!?*void`; on Windows, which reports only an exit
            \\code, it is always `null`. `detach` lets the thread run on
            \\unobserved. Every thread is completed by exactly one of the two. A
            \\`Thread` is a handle that may be copied, and a zero `Thread` names no
            \\thread: `join` and `detach` on it return `.Err(.Invalid_Argument)`. A
            \\procedure without `#c_call` does not convert to `Thread_Proc`:
    );
    code_block(
        45,
        "text",
        #string
            \\// worker :: (data: *void) -> ?*void { return null; }   Thread.spawn(worker, p)
            \\error: arg type #fn_ptr(*void) -> ?*void != #fn_ptr(*void) -> ?*void #c_call: the calling conventions differ (#c_call) in call spawn
    );
    paragraph(
        46,
        #string,oneline
            \\`Thread_Pool.thread_pool(count, proc, data)` starts `count` raw
            \\threads on the same `proc` and `data`. Such a pool has no work queue;
            \\`run` on it returns `.Err(.Invalid_Argument)`, and its only use is
            \\`join` or `free`.
    );
    paragraph(
        47,
        #string,oneline
            \\When `main` returns, the process ends, and threads that are still
            \\running end with it, detached or not. Joining a thread is the only
            \\way to know that it has finished its work.
    );
    subheading(48, "What each thread has of its own");
    paragraph(
        49,
        #string,oneline
            \\Every thread started by these procedures begins with the default
            \\implicit context, not a copy of its creator's: what `main` changes in
            \\its context or pushes with `#push_context` does not reach the worker,
            \\and the worker's changes do not reach `main` (see `#Context` and
            \\`context`).
    );
    code_block(
        50,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Context";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\
            \\report :: (unused: s64) -> s64 {
            \\    return context.user_index;
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    context.user_index = 7;
            \\    task := spawn_owned(0, report)?;
            \\    print("main {}, worker {}\n", context.user_index, task.join()?);
            \\    return .Ok;
            \\}
    );
    code_block(
        51,
        "text",
        #string
            \\main 7, worker 0
    );
    paragraph(
        52,
        #string,oneline
            \\Each thread also has its own temporary storage (see The Temporary
            \\Allocator) and its own instance of every `#thread_local` global (see
            \\Constants, Variables, and Globals). Two procedures act on the calling
            \\thread: `yield_now()` offers the rest of its time slice to another
            \\thread, and `sleep_ms(ms)` suspends it for at least `ms`
            \\milliseconds.
    );
    note(
        53,
        #string,oneline
            \\The threads of `thread_scope` and of a `Thread_Pool` run the tasks of
            \\a batch in turn, so a task may start on a thread where another task
            \\has already run. It then sees what that task left behind: an
            \\assignment to `context`, temporary memory that was not rewound, and
            \\the values of `#thread_local` globals. A task that changes its
            \\context does so with `#push_context` or `#push_allocator`, which undo
            \\the change when the task returns, and a task that uses temporary
            \\memory rewinds it before it returns.
    );
    subheading(54, "Errors");
    paragraph(
        55,
        #string,oneline
            \\Every operation of the `Thread` modules reports failure as a
            \\`Thread_Error`. Returned from `main`, an error prints one line
            \\`thread error: <reason>` on standard error and ends the program with
            \\status 1 (see `Try`, `?`, `#try`, and `Termination`); `reason()`
            \\returns the text.
    );
    table_header(56, "Member   —   Meaning");
    table_row(57, "`.Unsupported`   |   The platform cannot perform the operation.");
    table_row(
        58,
        #string,oneline
            \\`.Invalid_Argument`   |   A handle names no thread, a pool size is
            \\negative, or `run` was called on a raw or joined pool.
    );
    table_row(
        59,
        #string,oneline
            \\`.Spawn_Failed`   |   The operating system refused to start a
            \\thread. WASI has no threads, so every spawn fails this way there.
    );
    table_row(
        60,
        "`.Join_Failed`   |   Reserved. A failing native join aborts the program instead, since the thread may still be using its data."
    );
    table_row(
        61,
        "`.Synchronization_Failed`   |   Shared state could not be allocated, or the platform cannot detach."
    );
    table_row(62, "`.Closed`   |   A value was sent to a closed channel.");
}

render_section_77 :: () {
    paragraph(
        0,
        #string,oneline
            \\Data that several threads change is kept in a synchronized type: a
            \\type whose operations take a `*const` pointer and synchronize every
            \\access themselves, so that one value can be shared by all threads.
            \\They are the only `Sync` types whose contents change (see `Send`,
            \\`Sync`, and Shared Data). This chapter describes each of them, and
            \\ends with the memory ordering they guarantee.
    );
    table_header(1, "Type   —   Module   —   Use");
    table_row(
        2,
        "`Mutex(T)`, `Guard(T)`   |   `Thread`   |   Data reached by one thread at a time."
    );
    table_row(
        3,
        "`Condvar`   |   `Thread`   |   Waiting until another thread has changed data under a mutex."
    );
    table_row(4, "`Channel(T)`   |   `Thread`   |   Passing values from one thread to another.");
    table_row(
        5,
        "`Shared(T)`   |   `Thread/Shared`   |   A reference-counted value behind a lock, for threads that cannot share a pointer."
    );
    table_row(
        6,
        "`Once`   |   `Thread`, `Thread/Once`   |   Running an initialization exactly once."
    );
    table_row(
        7,
        "`Atomic(T)`   |   `Thread`, `Thread/Atomic`   |   One integer, `bool` or pointer changed without a lock."
    );
    paragraph(
        8,
        #string,oneline
            \\`Mutex`, `Condvar`, `Once` and `Atomic` are valid when zero and hold
            \\no operating-system object. A declaration without an initializer is
            \\ready to use and nothing needs destroying, which makes them fit for
            \\globals and for fields of a context. `Channel` and `Shared` allocate
            \\shared state and are made with `new`.
    );
    subheading(9, "`Mutex` and `Guard`");
    paragraph(
        10,
        #string,oneline
            \\`Mutex(T)` keeps a `T` together with a lock, and the data can be
            \\reached only while the lock is held. `lock()` waits until the calling
            \\thread holds the lock and returns a `Guard(T)`; the guard's `data()`
            \\is a `*T` to the data, and `unlock()` releases the lock and ends the
            \\guard.
    );
    code_block(
        11,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\Word_Lengths :: struct {
            \\    words: [6]str;
            \\    next: Atomic(ssize);
            \\    counts: Mutex([8]s64);     // counts[n]: words of n letters
            \\}
            \\
            \\measure :: (w: *const Word_Lengths) {
            \\    i := w.next.fetch_add(1);
            \\    length := w.words[i].count;
            \\    #pattern .Ok(g) := w.counts.lock() else { return; };
            \\    defer g.unlock();
            \\    g.data().*[length] += 1;
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    w := Word_Lengths.{ .words = .["lock", "guard", "wait", "mutex", "atomic", "once"] };
            \\    tasks: [6]((*const Word_Lengths) -> void);
            \\    for i: 0..6 tasks[i] = measure;
            \\    thread_scope(&w, tasks[..])?;
            \\    counts := w.counts.into_inner();
            \\    for n: 0..8 if counts[n] > 0 print("{} letters: {}\n", n, counts[n]);
            \\    return .Ok;
            \\}
    );
    code_block(
        12,
        "text",
        #string
            \\4 letters: 3
            \\5 letters: 2
            \\6 letters: 1
    );
    paragraph(
        13,
        #string,oneline
            \\`lock` returns `Thread_Error!Guard(T)`. The lock itself cannot fail
            \\on any target, so the result is always `.Ok`; the error type leaves
            \\room for a platform lock that reports failures. A task, which
            \\returns nothing, takes the guard with `#pattern ... else { return;
            \\}` as above.
    );
    paragraph(
        14,
        #string,oneline
            \\Nothing ends a guard implicitly. It must be unlocked on every path,
            \\which `defer g.unlock();` right after locking ensures; a guard that is
            \\never unlocked leaves the mutex locked, and every later `lock` waits
            \\forever. The pointer from `data()` is valid only until `unlock`.
            \\Locking a mutex again from the thread that holds it deadlocks; it is
            \\never undefined behaviour.
    );
    table_header(15, "Operation   —   Effect");
    table_row(
        16,
        "`Mutex(T).new(value)`   |   An unlocked mutex holding `value`. A zero `Mutex(T)` is an unlocked mutex holding a zero `T`."
    );
    table_row(17, "`m.lock()`   |   Waits for the lock; returns `Thread_Error!Guard(T)`.");
    table_row(
        18,
        "`m.try_lock()`   |   Takes the lock if it is free; `.Ok(null)` when any thread holds it."
    );
    table_row(
        19,
        "`m.with(ctx, f)`   |   Locks, calls `f(data, ctx)` with `f: (*T, *C) -> void`, unlocks."
    );
    table_row(20, "`m.into_inner()`   |   The data, once no thread uses the mutex any more.");
    table_row(21, "`g.data()`   |   A `*T` to the data, valid until `unlock`.");
    table_row(22, "`g.unlock()`   |   Releases the lock and ends the guard.");
    paragraph(
        23,
        #string,oneline
            \\`with` suits an update that fits in one procedure: the lock is held
            \\exactly for the call, so no guard can be left locked. `try_lock`
            \\never waits; it returns a guard when the lock was free and `null`
            \\when any thread holds it, the calling thread included:
    );
    code_block(
        24,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\// Called with the lock held: `words` is the mutex's data.
            \\add_word :: (words: *[..]str, word: *str) {
            \\    words.push(word.*);
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    names: Mutex([..]str);
            \\    defer free(&names);                     // releases the array inside
            \\    first := "alpha";
            \\    names.with(&first, add_word)?;
            \\    second := "beta";
            \\    names.with(&second, add_word)?;
            \\
            \\    #pattern .Ok(g) := names.lock() else { return .Ok; };
            \\    words := g.data();
            \\    busy := names.try_lock()?;             // the lock is held: no guard
            \\    print("try_lock while held: {}\n", busy == null);
            \\    print("{} words, last {}\n", words.*.count, words.*[1]);
            \\    g.unlock();
            \\
            \\    #pattern .Some(again) := names.try_lock()? else { return .Ok; };
            \\    print("try_lock after unlock: got the guard\n");
            \\    again.unlock();
            \\    return .Ok;
            \\}
    );
    code_block(
        25,
        "text",
        #string
            \\try_lock while held: true
            \\2 words, last beta
            \\try_lock after unlock: got the guard
    );
    paragraph(
        26,
        #string,oneline
            \\Threads share one mutex through a pointer. Assigning a mutex copies
            \\the lock together with the data, and the copy is a separate lock:
            \\two threads that lock two copies exclude nothing. A guard points at
            \\its mutex, so the mutex must not move while it is locked, and a guard
            \\is not `Send`: it stays on the thread that locked. `Mutex(T)` is an
            \\owner exactly when `T` is, and `free` on it releases the data, as
            \\`free(&names)` does above; after `into_inner`, release either the
            \\result or the mutex, not both.
    );
    subheading(27, "Condition variables: `Condvar`");
    paragraph(
        28,
        #string,oneline
            \\A `Condvar` lets a thread sleep until another thread has changed
            \\data under a mutex. `wait(&g)` takes a pointer to the guard the
            \\waiter holds, releases that mutex, sleeps until the condition
            \\variable is signalled, and takes the mutex again before it returns.
            \\`signal()` wakes at most one waiter and `broadcast()` every waiter;
            \\the signalling thread need not hold the mutex.
    );
    code_block(
        29,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\Queue :: struct {
            \\    items: [..]s64;
            \\    taken: ssize;
            \\    finished: bool;
            \\}
            \\
            \\Pipeline :: struct {
            \\    queue: Mutex(Queue);
            \\    changed: Condvar;
            \\    total: Atomic(s64);
            \\}
            \\
            \\produce :: (p: *const Pipeline) {
            \\    for n: 1..101 {
            \\        #pattern .Ok(g) := p.queue.lock() else { return; };
            \\        g.data().items.push(n);
            \\        g.unlock();
            \\        p.changed.signal();
            \\    }
            \\    #pattern .Ok(g) := p.queue.lock() else { return; };
            \\    g.data().finished = true;
            \\    g.unlock();
            \\    p.changed.signal();
            \\}
            \\
            \\consume :: (p: *const Pipeline) {
            \\    #pattern .Ok(g) := p.queue.lock() else { return; };
            \\    defer g.unlock();
            \\    while true {
            \\        q := g.data();
            \\        if q.taken < q.items.count {
            \\            _ := p.total.fetch_add(q.items[q.taken]);
            \\            q.taken += 1;
            \\        } else if q.finished {
            \\            break;
            \\        } else {
            \\            _ := p.changed.wait(&g);
            \\        }
            \\    }
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    pipeline: Pipeline;
            \\    tasks: [2]((*const Pipeline) -> void) = .[consume, produce];
            \\    thread_scope(&pipeline, tasks[..])?;
            \\    queue := pipeline.queue.into_inner();
            \\    defer free(&queue.items);
            \\    print("consumed {} items, total {}\n", queue.taken, pipeline.total.load());
            \\    return .Ok;
            \\}
    );
    code_block(
        30,
        "text",
        #string
            \\consumed 100 items, total 5050
    );
    paragraph(
        31,
        #string,oneline
            \\A wakeup says only that something may have changed, and it can even
            \\come without a signal. The waiter therefore tests its condition in a
            \\loop, as `consume` does, and waits again when nothing it needs has
            \\arrived. The test happens while the mutex is held, and `wait` notes
            \\the state of the condition variable before it releases the mutex, so
            \\a signal sent between the test and the sleep is not lost.
            \\`broadcast` is the right call when waiters wait for different
            \\conditions.
    );
    paragraph(
        32,
        #string,oneline
            \\The two tasks wait for each other, which works under `thread_scope`
            \\because it starts as many threads as there are tasks, so both run at
            \\the same time. On a pool with one worker the
            \\same batch would wait forever (see `spawn_owned`, `thread_scope`, and
            \\`Thread_Pool`).
    );
    subheading(33, "Channels: `Channel`");
    paragraph(
        34,
        #string,oneline
            \\`Channel(T)` passes values of type `T` from one thread to another.
            \\It has a single slot: `send(value)` waits while the slot is full and
            \\`recv()` waits while it is empty. A value is handed on through the
            \\channel: after `send` it belongs to the channel, after `recv` to the
            \\receiver, so a channel of owners hands them over without copying
            \\what they own. `T` must be `Send`.
    );
    code_block(
        35,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\
            \\produce :: (ch: Channel(s64)) -> s64 {
            \\    defer free(&ch);                  // this thread's endpoint
            \\    sent: s64 = 0;
            \\    for n: 1..6 {
            \\        if ch.send(n * n).is_err() break;
            \\        sent += 1;
            \\    }
            \\    ch.close();
            \\    return sent;
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    ch := Channel(s64).new()?;
            \\    defer free(&ch);
            \\    producer := spawn_owned(ch.clone(), produce)?;
            \\    while true {
            \\        #pattern .Some(value) := ch.recv()? else { break; };
            \\        print("received {}\n", value);
            \\    }
            \\    print("producer sent {}\n", producer.join()?);
            \\    return .Ok;
            \\}
    );
    code_block(
        36,
        "text",
        #string
            \\received 1
            \\received 4
            \\received 9
            \\received 16
            \\received 25
            \\producer sent 5
    );
    paragraph(
        37,
        #string,oneline
            \\With one sender and one receiver, values arrive in the order they
            \\were sent, so printing them as they arrive gives the same output on
            \\every run. `recv` returns `Thread_Error!?T`, and `null` means that the
            \\channel is closed and every value has been received, which ends the
            \\loop. `close()` marks the channel closed and wakes every waiting
            \\thread. A value already in the slot stays available to `recv`; a
            \\later `send` returns `.Err(.Closed)` and releases the value it was
            \\given.
    );
    paragraph(
        38,
        #string,oneline
            \\A `Channel(T)` value is an endpoint of state that `new` allocates
            \\with the heap allocator. `clone()` makes another endpoint of the same
            \\channel without allocating, and `free` gives one up; releasing the
            \\last endpoint releases the state and any value left in the slot. A
            \\thread started with `spawn_owned` gets an endpoint of its own, as
            \\`produce` does here, and releases it when it is done. Assigning an
            \\endpoint copies the handle without adding a reference, so release
            \\every endpoint from `new` or `clone` exactly once.
    );
    subheading(39, "Shared values: `Shared`");
    paragraph(
        40,
        #string,oneline
            \\A thread started with `spawn_owned` cannot point at its creator's
            \\data, because its input must be `Send`. When such threads must update
            \\one value together, the `Thread/Shared` module provides `Shared(T)`:
            \\a reference-counted `T` on the heap behind a lock. Every handle
            \\reaches the same value, and `clone()` makes a handle for another
            \\thread.
    );
    code_block(
        41,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\#import "Thread/Shared";
            \\
            \\Order :: struct {
            \\    totals: Shared([3]s64);
            \\    item: ssize;
            \\    amount: s64;
            \\}
            \\
            \\record :: (order: Order) -> s64 {
            \\    defer free(&order.totals);          // this thread's handle
            \\    #pattern .Ok(g) := order.totals.lock() else { return -1; };
            \\    defer g.unlock();
            \\    totals := g.get().*;
            \\    totals[order.item] += order.amount;
            \\    g.set(totals);
            \\    return totals[order.item];
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    zero: [3]s64;
            \\    totals := Shared([3]s64).new(zero)?;
            \\    defer free(&totals);
            \\    first := spawn_owned(Order.{ totals.clone(), 0, 5 }, record)?;
            \\    second := spawn_owned(Order.{ totals.clone(), 2, 7 }, record)?;
            \\    third := spawn_owned(Order.{ totals.clone(), 0, 1 }, record)?;
            \\    _ := first.join()?;
            \\    _ := second.join()?;
            \\    _ := third.join()?;
            \\    t := totals.snapshot();
            \\    print("{} {} {}\n", t[0], t[1], t[2]);
            \\    return .Ok;
            \\}
    );
    code_block(
        42,
        "text",
        #string
            \\6 0 7
    );
    paragraph(
        43,
        #string,oneline
            \\`lock()` returns a `Shared_Guard(T)`. Its `get()` is a `*const T` to
            \\the value, `set(value)` replaces the value and releases the old one
            \\when `T` is an owner, `replace(value)` replaces it and returns the
            \\old one, and `unlock()` ends the guard. `swap(value)` and
            \\`snapshot()` on the handle take the lock themselves: `swap` exchanges
            \\the value, and `snapshot` returns a bitwise copy, which suits only a
            \\`T` that owns nothing. Releasing the last handle with `free` releases
            \\the value; as with channels, release every handle from `new` or
            \\`clone` exactly once. `Shared(T)` is `Send` and `Sync` when `T` is
            \\`Send`.
    );
    subheading(44, "One-time initialization: `Once`");
    paragraph(
        45,
        #string,oneline
            \\`Once` runs a procedure at most once, however many threads ask.
            \\`call_once(f)` runs `f` when no call has run it yet. A thread that
            \\calls while `f` is running waits until it has returned, so after any
            \\`call_once` returns, `f` has completed. `is_done()` reports whether
            \\it has.
    );
    code_block(
        46,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\TABLE_READY: Once;
            \\TABLE: Mutex([16]s64);
            \\BUILDS: Atomic(s32);
            \\
            \\build_table :: () {
            \\    _ := BUILDS.fetch_add(1);
            \\    #pattern .Ok(g) := TABLE.lock() else { return; };
            \\    for i: 0..16 g.data().*[i] = i * i;
            \\    g.unlock();
            \\}
            \\
            \\square :: (n: ssize) -> s64 {
            \\    TABLE_READY.call_once(build_table);
            \\    #pattern .Ok(g) := TABLE.lock() else { return -1; };
            \\    defer g.unlock();
            \\    return g.data().*[n];
            \\}
            \\
            \\Results :: struct {
            \\    next: Atomic(ssize);
            \\    sum: Atomic(s64);
            \\}
            \\
            \\worker :: (r: *const Results) {
            \\    i := r.next.fetch_add(1);
            \\    _ := r.sum.fetch_add(square(i));
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    results: Results;
            \\    tasks: [4]((*const Results) -> void) = .[worker, worker, worker, worker];
            \\    thread_scope(&results, tasks[..])?;
            \\    print("sum {}, table built {} time(s)\n", results.sum.load(), BUILDS.load());
            \\    return .Ok;
            \\}
    );
    code_block(
        47,
        "text",
        #string
            \\sum 14, table built 1 time(s)
    );
    paragraph(
        48,
        #string,oneline
            \\`f` is a `() -> void` without captures, so what it initializes is a
            \\global, and the threads that read the result reach it through a
            \\synchronized type as well, here a mutex around the table. All three
            \\globals are valid when zero and need no setup. `f` must return
            \\normally: a non-local exit out of it leaves the `Once` running
            \\forever, and later callers wait forever. `Once.new()` is the same as
            \\a zero `Once`.
    );
    subheading(49, "Atomics: `Atomic`");
    paragraph(
        50,
        #string,oneline
            \\`Atomic(T)` holds one value that any thread may read and change
            \\without a lock. Each operation is a single atomic instruction, so no
            \\thread sees the value half-written and no update is lost. `T` is
            \\`bool`, an integer type of 8 to 64 bits, or a raw pointer type. The
            \\operations take `*const Atomic(T)`, so an atomic is shared through a
            \\pointer or as a field of a context.
    );
    code_block(
        51,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\main :: () {
            \\    a := Atomic(s32).new(5);
            \\    print("{}\n", a.fetch_add(3));   // the value before the addition
            \\    print("{}\n", a.load());
            \\    print("{}\n", a.swap(100));
            \\    seen, stored := a.compare_exchange(7, 9);
            \\    print("{} {}\n", seen, stored);
            \\    seen2, stored2 := a.compare_exchange(100, 9);
            \\    print("{} {} {}\n", seen2, stored2, a.load());
            \\
            \\    bits := Atomic(u8).new(16#F0);
            \\    _ := bits.fetch_and(16#3C);
            \\    _ := bits.fetch_or(16#01);
            \\    print("{x}\n", bits.load());
            \\    _ := bits.fetch_add(16#F0);      // wraps; no overflow check
            \\    print("{}\n", bits.load());
            \\
            \\    flag: Atomic(bool);              // zero is false
            \\    flag.store(true);
            \\    print("{} {}\n", flag.swap(false), flag.load());
            \\}
    );
    code_block(
        52,
        "text",
        #string
            \\5
            \\8
            \\8
            \\100 false
            \\100 true 9
            \\31
            \\33
            \\true false
    );
    table_header(53, "Operation   —   Result");
    table_row(54, "`Atomic(T).new(v)`   |   An atomic holding `v`. A zero `Atomic(T)` holds zero.");
    table_row(55, "`load()`   |   The current value.");
    table_row(56, "`store(v)`   |   Replaces the value.");
    table_row(57, "`swap(v)`   |   Replaces the value and returns the previous one.");
    table_row(
        58,
        "`compare_exchange(expected, desired)`   |   Stores `desired` if the value equals `expected`; returns the previous value and whether it stored."
    );
    table_row(
        59,
        "`fetch_add(v)`, `fetch_sub(v)`   |   Wrapping integer arithmetic; returns the previous value."
    );
    table_row(
        60,
        "`fetch_and(v)`, `fetch_or(v)`, `fetch_xor(v)`   |   Bitwise operations (logical for `bool`); return the previous value."
    );
    paragraph(
        61,
        #string,oneline
            \\Arithmetic on an atomic wraps, without the overflow checks of
            \\ordinary arithmetic (see Integer Arithmetic, Overflow, and Traps).
            \\`compare_exchange` builds any update the other operations do not
            \\cover: read the value, compute the new one, and store it only if no
            \\other thread has changed the value in between, retrying otherwise.
            \\Its two results are bound by a declaration, as above; they cannot be
            \\assigned to existing variables in one statement.
    );
    code_block(
        62,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\Search :: struct {
            \\    samples: [4][3]s64;
            \\    next: Atomic(ssize);
            \\    largest: Atomic(s64);
            \\}
            \\
            \\// Raises `largest` to `value` unless it is already at least that.
            \\raise_to :: (largest: *const Atomic(s64), value: s64) {
            \\    current := largest.load();
            \\    while value > current {
            \\        seen, stored := largest.compare_exchange(current, value);
            \\        if stored return;
            \\        current = seen;        // another thread changed it; retry
            \\    }
            \\}
            \\
            \\scan :: (search: *const Search) {
            \\    row := search.next.fetch_add(1);
            \\    for value: search.samples[row] raise_to(&search.largest, value);
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    search := Search.{
            \\        .samples = .[.[3, 41, 7], .[12, 5, 40], .[38, 2, 19], .[6, 27, 33]],
            \\    };
            \\    tasks: [4]((*const Search) -> void) = .[scan, scan, scan, scan];
            \\    thread_scope(&search, tasks[..])?;
            \\    print("largest {}\n", search.largest.load());
            \\    return .Ok;
            \\}
    );
    code_block(
        63,
        "text",
        #string
            \\largest 41
    );
    subheading(64, "Memory ordering");
    paragraph(
        65,
        #string,oneline
            \\Every atomic operation is sequentially consistent, and there is no
            \\other ordering to choose: no relaxed, acquire or release variants and
            \\no separate fence. All atomic operations of all threads take place in
            \\one total order that agrees with each thread's own order. An atomic
            \\operation also orders the ordinary memory accesses around it: what a
            \\thread wrote before a store is visible to another thread once a load
            \\there returns the stored value. The locks, channels and `Once` of
            \\this chapter are built on these operations and give the same
            \\guarantee: what a thread wrote before `unlock` is visible to the
            \\thread that takes the lock next.
    );
    paragraph(
        66,
        #string,oneline
            \\Assigning an atomic copies its value with an ordinary read and makes
            \\an independent atomic, so threads share one atomic through a pointer
            \\rather than copies of it. A few targets limit the widths: a 64-bit
            \\`T` on 32-bit MIPS, PowerPC or ARMv5 needs the platform's
            \\`libatomic`, which is not linked, and ARMv5 has atomics only for
            \\32-bit values.
    );
}

render_section_78 :: () {
    paragraph(
        0,
        #string,oneline
            \\Two typeclasses of the implicit prelude state what may cross from one
            \\thread to another. Neither has methods; the compiler decides them
            \\from the structure of a type, and the threading procedures of the
            \\standard library require them in their `where` clauses, so a program
            \\that would give a thread memory it must not use is rejected when it
            \\is compiled. This chapter gives the rule, the diagnostics, the
            \\instances that adjust it, the paths it does not cover, and a summary
            \\of the ways threads share data.
    );
    table_header(1, "Typeclass   —   Meaning");
    table_row(
        2,
        #string,oneline
            \\`Send(T)`   |   A value of type `T` may be handed to another thread,
            \\which uses and releases it from then on.
    );
    table_row(
        3,
        #string,oneline
            \\`Sync(T)`   |   A value of type `T` may be read from several threads
            \\at once through `*const T`.
    );
    table_header(4, "Procedure   —   Requires");
    table_row(5, "`spawn_owned(value, entry)`   |   `Send` for the input and for the result.");
    table_row(
        6,
        "`thread_scope(&ctx, tasks)`, `pool.run(&ctx, tasks)`   |   `Sync` for the context."
    );
    table_row(7, "`channel.send(value)`   |   `Send` for the value.");
    subheading(8, "The structural rule");
    paragraph(
        9,
        #string,oneline
            \\A raw pointer (`*T`, `*const T`, `[*]T`, `*void`), a view `[]T` and
            \\an `any` refer to memory that the value does not own, which another
            \\thread may be changing or releasing. These types are neither `Send`
            \\nor `Sync`, and neither is any type that contains one: a struct, a
            \\union, a fixed array, a tuple, an optional `?T`, a result `E!T` or a
            \\`distinct` type. Every other type is `Send` when all its parts are
            \\`Send` and `Sync` when all its parts are `Sync`. Numbers, `bool`,
            \\enums and procedure types are both. A dynamic array `[..]T` owns its
            \\buffer and counts as its element type, and `str` and `cstr` count as
            \\owned text.
    );
    code_block(
        10,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\#import "Thread";
            \\
            \\Point :: struct { x: s64; y: s64; }
            \\Cursor :: struct { at: *s64; }
            \\Window :: struct { values: []s64; }
            \\
            \\describe :: (#empty: $T) {
            \\    send :: #comptime Send(T);
            \\    sync :: #comptime Sync(T);
            \\    print("{}: Send {}, Sync {}\n", type_name(T), send, sync);
            \\}
            \\
            \\main :: () {
            \\    describe(Point);
            \\    describe([..]Point);
            \\    describe(str);
            \\    describe(Cursor);
            \\    describe(Window);
            \\    describe(?*s64);
            \\    describe(Mutex([..]s64));
            \\    describe(Mutex(Cursor));
            \\    describe(Guard(s64));
            \\    describe(Atomic(s64));
            \\}
    );
    code_block(
        11,
        "text",
        #string
            \\Point: Send true, Sync true
            \\[..]Point: Send true, Sync true
            \\str: Send true, Sync true
            \\Cursor: Send false, Sync false
            \\Window: Send false, Sync false
            \\?*s64: Send false, Sync false
            \\Mutex([..]s64): Send true, Sync true
            \\Mutex(Cursor): Send false, Sync false
            \\Guard(s64): Send false, Sync false
            \\Atomic(s64): Send true, Sync true
    );
    paragraph(
        12,
        #string,oneline
            \\`describe` receives the type through an `#empty` slot (see
            \\`noalias`, `#lazy`, `#comptime`, and Type Parameters). `Send(T)` and
            \\`Sync(T)` are compile-time facts: they are asked in a `where`
            \\clause, a `#comptime` constant as in `describe`, an `#if`, or an
            \\`#assert`, which turns a requirement into a check with a message of
            \\its own:
    );
    code_block(
        13,
        "text",
        #string
            \\// Cursor :: struct { at: *s64; }   inside main:
            \\// #assert Send(Cursor), "a Cursor is handed to workers";
            \\error: assertion failed: a Cursor is handed to workers
    );
    subheading(14, "When a check fails");
    paragraph(
        15,
        #string,oneline
            \\A failed `Send` or `Sync` requirement is reported as a failed
            \\constraint of the procedure called. The message names the procedure
            \\and points at the call; the `where` clause of the procedure tells
            \\which requirement it was. Here a worker would receive a pointer to a
            \\local of `main`:
    );
    code_block(
        16,
        "glosso",
        #string
            \\#import "Thread/Task";
            \\
            \\Borrowed :: struct {
            \\    counter: *s64;
            \\}
            \\
            \\bump :: (borrowed: Borrowed) -> s64 {
            \\    borrowed.counter.* += 1;
            \\    return borrowed.counter.*;
            \\}
            \\
            \\main :: () {
            \\    x: s64 = 0;
            \\    #pattern .Ok(task) := spawn_owned(Borrowed.{ .counter = &x }, bump) else { exit(1); };
            \\    _ := task.join();
            \\}
    );
    code_block(
        17,
        "text",
        #string
            \\error: constraint failed for spawn_owned
            \\   --> main.glo:14:27
            \\   |
            \\14 |     #pattern .Ok(task) := spawn_owned(Borrowed.{ .counter = &x }, bump) else { exit(1); };
            \\   |                           ^^^^^^^^^^^
    );
    paragraph(
        18,
        #string,oneline
            \\`spawn_owned` is declared with `where Send(T) && Send(R)`, and
            \\`Borrowed` is not `Send`. Nothing would keep `x` alive while the
            \\worker writes through the pointer, and nothing would keep the two
            \\threads from writing it at once. The fix is to hand the thread
            \\something it can own: the value itself, or a handle such as a
            \\`Shared(s64)` or a `Channel` endpoint (see `Mutex`, `Condvar`,
            \\`Channel`, `Once`, and `Atomic`).
    );
    paragraph(
        19,
        #string,oneline
            \\A scoped batch fails the same way when its context holds a pointer.
            \\Every task would write through `total` without synchronization:
    );
    code_block(
        20,
        "text",
        #string
            \\// Tally :: struct { total: *s64; }
            \\// add :: (ctx: *const Tally) { ctx.total.* += 1; }
            \\// thread_scope(&ctx, tasks[..])
            \\error: constraint failed for thread_scope
    );
    paragraph(
        21,
        #string,oneline
            \\With the counter as a synchronized field of the context itself, the
            \\context is `Sync` and the tasks change it safely:
    );
    code_block(
        22,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\
            \\Tally :: struct {
            \\    total: Atomic(s64);
            \\}
            \\
            \\add :: (ctx: *const Tally) {
            \\    _ := ctx.total.fetch_add(1);
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    ctx: Tally;
            \\    tasks: [2]((*const Tally) -> void) = .[add, add];
            \\    thread_scope(&ctx, tasks[..])?;
            \\    print("{}\n", ctx.total.load());
            \\    return .Ok;
            \\}
    );
    code_block(
        23,
        "text",
        #string
            \\2
    );
    subheading(24, "Synchronized types");
    paragraph(
        25,
        #string,oneline
            \\A mutex, a condition variable and an atomic change through a
            \\`*const` pointer; that is their purpose, and they do it safely
            \\because they synchronize every access. Their modules say so with
            \\instances, which take precedence over the structure of the type:
    );
    table_header(26, "Type   —   `Send`   —   `Sync`");
    table_row(27, "`Mutex(T)`   |   when `T` is `Send`   |   when `T` is `Send`");
    table_row(28, "`Guard(T)`, `Shared_Guard(T)`   |   no   |   no");
    table_row(29, "`Condvar`, `Once`, `Atomic(T)`   |   yes   |   yes");
    table_row(30, "`Channel(T)`, `Shared(T)`   |   when `T` is `Send`   |   when `T` is `Send`");
    table_row(31, "`Task(R)`   |   when `R` is `Send`   |   yes");
    table_row(32, "`Thread`, `Thread_Pool`, `Thread_Error`   |   yes   |   yes");
    paragraph(
        33,
        #string,oneline
            \\A mutex needs only `Send(T)` to be `Sync`: several threads reach the
            \\data, but one at a time, so the data passes from thread to thread and
            \\is never read by two at once. A guard is the proof that one thread
            \\holds a lock and never leaves that thread. `Atomic(T)` is `Sync` even
            \\for a pointer `T`, because the atomic makes the pointer value safe to
            \\exchange; the memory it points at is another matter.
    );
    subheading(34, "Declaring `Send` and `Sync`");
    paragraph(
        35,
        #string,oneline
            \\A type that fails the structural rule but is safe to pass between
            \\threads states so with an empty instance. A negative instance
            \\`!Send` or `!Sync` does the opposite, for a type whose fields pass
            \\but that must stay on one thread, and a `where` clause makes an
            \\instance conditional on a type parameter:
    );
    code_block(
        36,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\// A view of a table that is filled before any thread starts and is
            \\// never changed or released afterwards.
            \\Lookup :: struct {
            \\    entries: [*]const s64;
            \\    count: ssize;
            \\}
            \\Lookup ::: instance Send {}
            \\Lookup ::: instance Sync {}
            \\
            \\// An index into this thread's #thread_local cache; meaningless elsewhere.
            \\Cache_Slot :: struct {
            \\    index: s64;
            \\}
            \\Cache_Slot ::: instance !Send {}
            \\
            \\// Owns a heap block that nothing else points at.
            \\Boxed :: struct {
            \\    value: *$T;
            \\}
            \\Boxed($T) ::: instance Send where Send(T) {}
            \\
            \\main :: () {
            \\    lookup :: #comptime Send(Lookup) && Sync(Lookup);
            \\    slot_send :: #comptime Send(Cache_Slot);
            \\    slot_sync :: #comptime Sync(Cache_Slot);
            \\    boxed_number :: #comptime Send(Boxed(s64));
            \\    boxed_pointer :: #comptime Send(Boxed(*s64));
            \\    print("Lookup: {}\n", lookup);
            \\    print("Cache_Slot: Send {}, Sync {}\n", slot_send, slot_sync);
            \\    print("Boxed(s64): {}, Boxed(*s64): {}\n", boxed_number, boxed_pointer);
            \\}
    );
    code_block(
        37,
        "text",
        #string
            \\Lookup: true
            \\Cache_Slot: Send false, Sync true
            \\Boxed(s64): true, Boxed(*s64): false
    );
    paragraph(
        38,
        #string,oneline
            \\An instance decides for its type without looking at the fields, and
            \\when both a positive and a negative instance apply, the negative one
            \\wins. `Cache_Slot` stays `Sync` because only `Send` was denied. A
            \\positive instance is a promise the compiler cannot verify, about how
            \\the type's own procedures use its fields, so it belongs in the module
            \\that defines the type, next to those procedures. Instance Resolution
            \\and Negative Instances describes negative and conditional instances
            \\in general.
    );
    subheading(39, "Requirements in generic code");
    paragraph(
        40,
        #string,oneline
            \\A generic procedure that hands its arguments to threads states the
            \\requirement in its own `where` clause:
    );
    code_block(
        41,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\
            \\// Runs `f(value)` on a new thread and waits for the result.
            \\on_worker :: (value: $T, f: (T) -> s64) -> Thread_Error!s64 where Send(T) {
            \\    task := spawn_owned(value, f)?;
            \\    return task.join();
            \\}
            \\
            \\double :: (n: s64) -> s64 { return n * 2; }
            \\
            \\main :: () -> Thread_Error!void {
            \\    print("{}\n", on_worker(21, double)?);
            \\    return .Ok;
            \\}
    );
    code_block(
        42,
        "text",
        #string
            \\42
    );
    paragraph(
        43,
        #string,oneline
            \\Given `peek :: (p: *s64) -> s64`, a call `on_worker(&x, peek)` is
            \\then reported where it is written. Without the clause, the call is
            \\accepted, the body is checked for `T = *s64`, and the error points
            \\into `on_worker`, with the call only in a note:
    );
    code_block(
        44,
        "text",
        #string
            \\// with `where Send(T)`
            \\error: constraint failed for on_worker
            \\   --> main.glo:17:19
            \\   |
            \\17 |     print("{}\n", on_worker(&x, peek)?);
            \\   |                   ^^^^^^^^^
            \\
            \\// without it
            \\error: constraint failed for spawn_owned
            \\  --> main.glo:7:13
            \\  |
            \\7 |     task := spawn_owned(value, f)?;
            \\  |             ^^^^^^^^^^^
            \\note: in instantiation of 'on_worker'
            \\   --> main.glo:17:19
            \\   |
            \\17 |     print("{}\n", on_worker(&x, peek)?);
            \\   |                   ^^^^^^^^^
    );
    paragraph(
        45,
        #string,oneline
            \\`#if Send(T)` chooses between code paths instead, for a generic
            \\procedure that can work either way (see `#if`, `#assert`, and
            \\`#compile_error`).
    );
    subheading(46, "What the checks do not cover");
    paragraph(
        47,
        #string,oneline
            \\The checks apply where a value crosses through the typed procedures.
            \\Three paths are outside them:
    );
    bullet(
        48,
        #string,oneline
            \\Global variables. Every thread reaches every global, and nothing
            \\checks how. A global that several threads change should be a
            \\synchronized type such as an `Atomic`, a `Mutex` or a `Once`, all of
            \\which are valid when zero.
    );
    bullet(
        49,
        #string,oneline
            \\Raw threads. `Thread.spawn` and `Thread_Pool.thread_pool` take a
            \\`*void` and check nothing about what it points at (see
            \\`spawn_owned`, `thread_scope`, and `Thread_Pool`).
    );
    bullet(
        50,
        #string,oneline
            \\Where a string's bytes live. `str` counts as owned text, but a string
            \\may point into memory that belongs to the sending thread, such as its
            \\temporary storage, which is reused once that thread rewinds it (see
            \\The Temporary Allocator). A string handed to another thread must
            \\point at memory that stays valid while the receiver uses it.
    );
    subheading(51, "Ways to share data between threads");
    paragraph(
        52,
        #string,oneline
            \\Every way for threads to share data falls under one of these
            \\situations, each with its own tool:
    );
    table_header(53, "Situation   —   Tool");
    table_row(
        54,
        #string,oneline
            \\A value one thread produces and another consumes   |   Hand it over:
            \\the input or result of `spawn_owned`, or `send` on a `Channel(T)`.
            \\`T` must be `Send`, and the receiver owns the value.
    );
    table_row(
        55,
        #string,oneline
            \\Data that a batch of tasks reads, and the results they write   |   The
            \\context of `thread_scope` or `Thread_Pool.run`: ordinary fields
            \\are read-only, results go into synchronized fields, and the context
            \\must be `Sync`.
    );
    table_row(
        56,
        #string,oneline
            \\One value that independently started threads update   |   A
            \\`Shared(T)`, with one handle per thread.
    );
    table_row(
        57,
        #string,oneline
            \\State of the whole program   |   A global of a synchronized type:
            \\`Atomic`, `Mutex` or `Once`.
    );
    table_row(
        58,
        #string,oneline
            \\State each thread keeps for itself   |   A `#thread_local` global
            \\(see Constants, Variables, and Globals).
    );
    table_row(
        59,
        #string,oneline
            \\Anything else   |   `Thread.spawn` with a raw pointer, unchecked:
            \\the program keeps the data valid and every access synchronized.
    );
    paragraph(
        60,
        #string,oneline
            \\The last two kinds of global differ in how many instances exist. A
            \\`#thread_local` global has one instance per thread, which starts from
            \\its initial value in each new thread, while an ordinary global has
            \\one instance that every thread reaches:
    );
    code_block(
        61,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread";
            \\#import "Thread/Task";
            \\
            \\#thread_local calls: s64;         // one counter per thread
            \\TOTAL_CALLS: Atomic(s64);         // one counter for the whole program
            \\
            \\note_call :: () {
            \\    calls += 1;
            \\    _ := TOTAL_CALLS.fetch_add(1);
            \\}
            \\
            \\count_calls :: (n: s64) -> s64 {
            \\    for 0..n note_call();
            \\    return calls;                 // this thread's own count
            \\}
            \\
            \\main :: () -> Thread_Error!void {
            \\    note_call();
            \\    a := spawn_owned(10, count_calls)?;
            \\    b := spawn_owned(20, count_calls)?;
            \\    print("worker a: {} calls\n", a.join()?);
            \\    print("worker b: {} calls\n", b.join()?);
            \\    print("main: {} call; all threads: {}\n", calls, TOTAL_CALLS.load());
            \\    return .Ok;
            \\}
    );
    code_block(
        62,
        "text",
        #string
            \\worker a: 10 calls
            \\worker b: 20 calls
            \\main: 1 call; all threads: 31
    );
    paragraph(
        63,
        #string,oneline
            \\A `#thread_local` global belongs to a thread, not to a task. The
            \\tasks of a `thread_scope` batch or a pool are handed to the threads
            \\in turn, and a thread that finishes one task may run another, so two
            \\tasks can see the same instance (see `spawn_owned`, `thread_scope`,
            \\and `Thread_Pool`). `spawn_owned` runs each entry on a thread of its
            \\own, which is why the counts above are exact.
    );
}

}
