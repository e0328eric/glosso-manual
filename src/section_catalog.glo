#import "Format";
#import "String_Builder";
#import "Math/Core";

#public {
// Manual section state and titles.

SECTION_COUNT :: 98;
selected_section: s32 = 0;

section_title :: (index: s32) -> str {
    if index == {
        case 0; return "Hello, Glosso";
        case 1; return "Values, Variables, and Arithmetic";
        case 2; return "Branching and Looping";
        case 3; return "Procedures";
        case 4; return "Structs and Methods";
        case 5; return "Arrays, Views, and Growing Lists";
        case 6; return "Working with Text";
