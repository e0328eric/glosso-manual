        case 35; return "Tuple Types";
        case 36; return "`enum` and `enum_flags`";
        case 37; return "Tagged and Untagged Unions";
        case 38; return "`?T` and `E!T`";
        case 39; return "Pointer Types";
        case 40; return "Arrays, Views, Dynamic Arrays, and Slicing";
        case 41; return "`#soa` and `#aos` Storage";
        case 42; return "Aggregate Literal Syntax";
        case 43; return "Constants, Variables, and Globals";
        case 44; return "Assignment, Blocks, and Name Lookup";
