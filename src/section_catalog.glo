// Manual section state and titles.

SECTION_COUNT :: 109;
selected_section: s32 = 0;

section_title :: (index: s32) -> string {
    if index == {
        case 0; return "Compilation Pipeline and Prelude";
        case 1; return "Using the Compiler";
        case 2; return "Compiler Cache and Generated Sources";
