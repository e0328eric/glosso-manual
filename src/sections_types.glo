// Sections 22-36: primitive types.

render_section_22 :: () {
    paragraph(0, #string,oneline
        \\A primitive type is one the compiler knows without a declaration.
        \\The set is closed. Thirty-three spellings are recognised directly,
        \\and the checker accepts ten further C names so that generated
        \\bindings can use the shapes C wrote. Everything else in the
        \\language is assembled out of these.
    );
    paragraph(1, #string,oneline
        \\A primitive spelling is not a keyword. The lexer produces an
        \\ordinary identifier and the name is resolved during checking,
        \\after locals and globals have been consulted. A binding therefore
        \\shadows a primitive: `int := 5;` declares a local named `int`, and
        \\`pattern := 5;` declares one named `pattern`. This is what keeps
        \\`pattern` usable as an everyday identifier despite being a
        \\compiler primitive rather than a library type.
    );
    table_header(2, "Family   —   Spellings   —   Detailed in");
    table_row(3, "Integers   |   `s8` `s16` `s32` `s64` `s128` `u8` `u16` `u32` `u64` `u128` `int` `uint`   |   Integers");
    table_row(4, "Floating point   |   `f16` `f32` `f64` `f80` `f128`   |   Floating Point");
    table_row(5, "Complex   |   `c32` `c64` `c128` `c160` `c256`   |   Complex Numbers");
    table_row(6, "Boolean   |   `bool`   |   Booleans and Truthiness");
    table_row(7, "Strings   |   `string` `cstring` `string16` `cstring16`   |   Built-in Strings");
    table_row(8, "Other   |   `void` `type` `any` `label` `Code` `pattern`   |   this chapter");
    subheading(9, "Sizes and alignments");
    paragraph(10, #string,oneline
        \\Both numbers come from `type_info(T)`, whose result carries
        \\`.size` and `.alignment`. There is no separate alignment
        \\intrinsic: `align_of(s64)` is `error: unknown function align_of`.
        \\The figures below are for `x86_64-pc-windows-msvc`; only the
        \\pointer-derived ones (`any`, `label`, the string record) move with
        \\the target.
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\row :: (T: type, name: string) {
        \\    info :: type_info(T);
        \\    print("%   size %   align %\n", name, info.size, info.alignment);
        \\}
        \\
        \\main :: () {
        \\    row(s8, "s8");     row(s16, "s16");   row(s32, "s32");
        \\    row(s64, "s64");   row(s128, "s128"); row(int, "int");
        \\    row(u8, "u8");     row(u16, "u16");   row(u32, "u32");
        \\    row(u64, "u64");   row(u128, "u128"); row(uint, "uint");
        \\    row(f16, "f16");   row(f32, "f32");   row(f64, "f64");
        \\    row(f80, "f80");   row(f128, "f128");
        \\    row(c32, "c32");   row(c64, "c64");   row(c128, "c128");
        \\    row(c160, "c160"); row(c256, "c256");
        \\    row(bool, "bool");
        \\    row(string, "string");     row(cstring, "cstring");
        \\    row(string16, "string16"); row(cstring16, "cstring16");
        \\    row(void, "void");   row(type, "type");   row(any, "any");
        \\    row(label, "label"); row(Code, "Code");   row(pattern, "pattern");
        \\}
    );
    code_block(12, "text", #string
        \\s8   size 1   align 1
        \\s16   size 2   align 2
        \\s32   size 4   align 4
        \\s64   size 8   align 8
        \\s128   size 16   align 16
        \\int   size 8   align 8
        \\u8   size 1   align 1
        \\u16   size 2   align 2
        \\u32   size 4   align 4
        \\u64   size 8   align 8
        \\u128   size 16   align 16
        \\uint   size 8   align 8
        \\f16   size 2   align 2
        \\f32   size 4   align 4
        \\f64   size 8   align 8
        \\f80   size 16   align 16
        \\f128   size 16   align 16
        \\c32   size 4   align 2
        \\c64   size 8   align 4
        \\c128   size 16   align 8
        \\c160   size 32   align 16
        \\c256   size 32   align 16
        \\bool   size 1   align 1
        \\string   size 24   align 8
        \\cstring   size 24   align 8
        \\string16   size 24   align 8
        \\cstring16   size 24   align 8
        \\void   size 0   align 1
        \\type   size 0   align 1
        \\any   size 16   align 8
        \\label   size 8   align 8
        \\Code   size 0   align 1
        \\pattern   size 0   align 1
    );
    bullet(13, #string,oneline
        \\Size equals alignment for every integer and every float, so a
        \\primitive scalar is always naturally aligned.
    );
    bullet(14, #string,oneline
        \\`s128`, `u128`, `f80` and `f128` all occupy sixteen bytes.
        \\`f80` carries eighty significant bits and pads the rest; the
        \\padding is what makes the size a power of two.
    );
    bullet(15, #string,oneline
        \\A complex type is aligned to its component, not to the pair, so
        \\`c32` is four bytes with alignment two and `c128` is sixteen bytes
        \\with alignment eight.
    );
    bullet(16, #string,oneline
        \\`void`, `type`, `Code` and `pattern` are zero-sized. `any` is two
        \\pointers wide and `label` is one.
    );
    subheading(17, "`int` and `uint`");
    paragraph(18, #string,oneline
        \\`int` and `s64` are not two types that happen to agree: they are
        \\the same type value, and so are `uint` and `u64`. `int` is the
        \\spelling the compiler prints for the unnamed 64-bit signed
        \\integer, which is also why an unannotated integer literal reports
        \\its default as `int`. There is no `sint`.
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    print("type_name(int)  %\n", type_name(int));
        \\    print("type_name(s64)  %\n", type_name(s64));
        \\    print("type_name(uint) %\n", type_name(uint));
        \\    print("int == s64      %\n", int == s64);
        \\    print("uint == u64     %\n", uint == u64);
        \\    print("int == int64_t  %\n", int == int64_t);
        \\}
    );
    code_block(20, "text", #string
        \\type_name(int)  int
        \\type_name(s64)  int
        \\type_name(uint) u64
        \\int == s64      1
        \\uint == u64     1
        \\int == int64_t  0
    );
    note(21, #string,oneline
        \\The last line is the trap. `int64_t` is a separate named type of
        \\the same width, so it is a different type for overload resolution
        \\and instance selection, and it is the one that prints as `s64`. A
        \\diagnostic reading `got s64, expected u64` came from a value
        \\declared `int64_t`; a value declared `s64` produces
        \\`got int, expected u64`.
    );
    subheading(22, "The accepted C spellings");
    paragraph(23, #string,oneline
        \\These names exist because Bindgen emits them. They are resolved by
        \\the checker rather than listed as builtin names in the parser,
        \\which is why they can appear in a type annotation without being
        \\reserved words. Each is a named integer type of the stated width
        \\and converts to its Glosso counterpart implicitly, both being the
        \\same width and signedness.
    );
    table_header(24, "C spelling   —   Width and signedness   —   Prints as");
    table_row(25, "`int8_t` `int16_t` `int32_t` `int64_t`   |   signed 8, 16, 32, 64   |   `s8` `s16` `s32` `s64`");
    table_row(26, "`__int128`   |   signed 128   |   `s128`");
    table_row(27, "`uint8_t` `uint16_t` `uint32_t` `uint64_t`   |   unsigned 8, 16, 32, 64   |   `u8` `u16` `u32` `u64`");
    table_row(28, "`unsigned __int128`   |   unsigned 128   |   `u128`");
    paragraph(29, #string,oneline
        \\The last row has no source spelling: the name contains a space, so
        \\it is reachable only from inside the compiler. Write `u128`.
    );
    code_block(30, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    a: int8_t = -1;
        \\    b: uint32_t = 7;
        \\    c: __int128 = 170141183460469231731687303715884105727;
        \\    print("int8_t   % %\n", type_name(int8_t), a);
        \\    print("uint32_t % %\n", type_name(uint32_t), b);
        \\    print("__int128 % %\n", type_name(__int128), c);
        \\}
    );
    code_block(31, "text", #string
        \\int8_t   s8 -1
        \\uint32_t u32 7
        \\__int128 s128 170141183460469231731687303715884105727
    );
    subheading(32, "`void`, `type`, `any`, `label`, `Code`, and `pattern`");
    paragraph(33, #string,oneline
        \\`void` is the no-value type. It has exactly one value, written
        \\`.()`, and zero bytes. A procedure with no return annotation
        \\returns it, and a union variant with no payload carries it.
        \\`(void, void)` has `PartialEq` and `PartialOrd` instances that
        \\always answer equal.
    );
    code_block(34, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    a: void = .();
        \\    b: void = .();
        \\    print("void == void  %\n", a == b);
        \\    print("size of void  %\n", size_of(void));
        \\    print("show of void  %\n", show(a));
        \\}
    );
    code_block(35, "text", #string
        \\void == void  1
        \\size of void  0
        \\show of void  .()
    );
    table_header(36, "Spelling   —   Size   —   What it holds");
    table_row(37, "`void`   |   0   |   the single value `.()`");
    table_row(38, "`type`   |   0   |   a type, as a first-class value");
    table_row(39, "`any`   |   2 pointers   |   any value, boxed with its type");
    table_row(40, "`label`   |   1 pointer   |   a jump target within a procedure");
    table_row(41, "`Code`   |   0   |   an unexpanded fragment of program text");
    table_row(42, "`pattern`   |   0   |   a match pattern as a compile-time value");
    paragraph(43, #string,oneline
        \\`any` is the boxing target: the coercion rule accepts every type
        \\into it, which is how variadic arguments are collected. A
        \\compile-time number takes its default type on the way in. `type`
        \\values may be stored in a runtime local and shown, but a
        \\compile-time intrinsic will not accept one; `Types as Values`
        \\covers that boundary. `Code` and `pattern` exist only during
        \\compilation, and `type_kind` reports `0` for both because neither
        \\has a tag of its own in `Type_Info_Tag`.
    );
    note(44, #string,oneline
        \\A `void` local cannot be passed to `print`. Variadic arguments are
        \\boxed into an array, and a zero-sized member is not supported
        \\there: `error: a zero-sized 'void' member inside a struct, tuple,
        \\or array is not supported yet; remove the member, or wrap it in a
        \\single-field struct`. `show(a)` works, because that is an ordinary
        \\call.
    );
}

render_section_23 :: () {
    paragraph(0, #string,oneline
        \\Glosso has five signed and five unsigned integer widths, from
        \\eight bits to a hundred and twenty-eight. `int` is another
        \\spelling of `s64` and `uint` another spelling of `u64`; neither is
        \\a separate type. Every width is a real machine type with a fixed
        \\size, not a promotion tier: the arithmetic instances are
        \\homogeneous, so two operands must already share a type before an
        \\operator will accept them.
    );
    table_header(1, "Spelling   —   Range   —   Size");
    table_row(2, "`s8`   |   -128..=127   |   1");
    table_row(3, "`s16`   |   -32768..=32767   |   2");
    table_row(4, "`s32`   |   -2147483648..=2147483647   |   4");
    table_row(5, "`s64`, `int`   |   -9223372036854775808..=9223372036854775807   |   8");
    table_row(6, "`s128`   |   -170141183460469231731687303715884105728..=170141183460469231731687303715884105727   |   16");
    table_row(7, "`u8`   |   0..=255   |   1");
    table_row(8, "`u16`   |   0..=65535   |   2");
    table_row(9, "`u32`   |   0..=4294967295   |   4");
    table_row(10, "`u64`, `uint`   |   0..=18446744073709551615   |   8");
    table_row(11, "`u128`   |   0..=340282366920938463463374607431768211455   |   16");
    paragraph(12, #string,oneline
        \\The ranges above are the compiler's own: a written literal that
        \\leaves them is rejected with the range quoted back, as in
        \\`error: 300 does not fit u8, whose range is 0..=255`. The rule and
        \\its exceptions belong to `Compile-Time Numbers and Literal
        \\Defaulting`.
    );
    code_block(13, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    s8lo:  s8   = -128;                   s8hi:  s8   = 127;
        \\    s64lo: s64  = -9223372036854775808;   s64hi: s64  = 9223372036854775807;
        \\    u8hi:  u8   = 255;                    u64hi: u64  = 18446744073709551615;
        \\    print("s8   % .. %\n", s8lo, s8hi);
        \\    print("s64  % .. %\n", s64lo, s64hi);
        \\    print("u8   0 .. %\n", u8hi);
        \\    print("u64  0 .. %\n", u64hi);
        \\}
    );
    code_block(14, "text", #string
        \\s8   -128 .. 127
        \\s64  -9223372036854775808 .. 9223372036854775807
        \\u8   0 .. 255
        \\u64  0 .. 18446744073709551615
    );
    subheading(15, "Two's complement");
    paragraph(16, #string,oneline
        \\Every integer is a two's-complement bit pattern, at compile time
        \\and at run time alike. The compile-time evaluator carries values
        \\in a 128-bit signed payload and re-widens at each operation, so
        \\every width up to 128 bits computes exactly. A cast between a
        \\signed and an unsigned type of the same width therefore
        \\reinterprets rather than converts, and `~0` is all ones at every
        \\width.
    );
    code_block(17, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    hi: s8 = 127;
        \\    one: s8 = 1;
        \\    print("s8 127 wrap-add 1  = %\n", hi +% one);
        \\    lo: s8 = -128;
        \\    print("s8 -128 wrap-sub 1 = %\n", lo -% one);
        \\    print("s8 -128 as u8 = %\n", cast(u8) lo);
        \\    print("u8 255 as s8  = %\n", cast(s8) cast(u8) 255);
        \\    z: s8 = 0;
        \\    print("~0 at s8      = %\n", ~z);
        \\    zu: u8 = 0;
        \\    print("~0 at u8      = %\n", ~zu);
        \\}
    );
    code_block(18, "text", #string
        \\s8 127 wrap-add 1  = -128
        \\s8 -128 wrap-sub 1 = 127
        \\s8 -128 as u8 = 128
        \\u8 255 as s8  = -1
        \\~0 at s8      = -1
        \\~0 at u8      = 255
    );
    paragraph(19, #string,oneline
        \\Plain `+`, `-`, `*` and unary `-` do not wrap silently: they are
        \\checked at `-O0` and `-O1` and abort on overflow. `+%` and `-%`,
        \\used above, are the operators that ask for the wrap explicitly;
        \\`*%` completes that family and `+|`, `-|`, `*|` saturate instead.
        \\See `Overflow, Traps, and the -O Level` for the checks and
        \\`The Operator System` for the full family.
    );
    subheading(20, "Division and remainder");
    paragraph(21, #string,oneline
        \\Both truncate toward zero. The quotient of a negative dividend is
        \\rounded up toward zero rather than down, and the remainder takes
        \\the sign of the dividend, so `(a / b) * b + (a % b)` reproduces
        \\`a` for every pair that does not overflow.
    );
    code_block(22, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    a: s64 = 7;   b: s64 = 2;
        \\    c: s64 = -7;  d: s64 = -2;
        \\    print(" 7 / 2 = %   7 rem 2 = %\n", a / b, a % b);
        \\    print("-7 / 2 = %  -7 rem 2 = %\n", c / b, c % b);
        \\    print(" 7 / -2 = %   7 rem -2 = %\n", a / d, a % d);
        \\    print("-7 / -2 = %  -7 rem -2 = %\n", c / d, c % d);
        \\    print("quotient times divisor plus remainder: %\n", (c / b) * b + (c % b));
        \\}
    );
    code_block(23, "text", #string
        \\ 7 / 2 = 3   7 rem 2 = 1
        \\-7 / 2 = -3  -7 rem 2 = -1
        \\ 7 / -2 = -3   7 rem -2 = 1
        \\-7 / -2 = 3  -7 rem -2 = -1
        \\quotient times divisor plus remainder: -7
    );
    bullet(24, #string,oneline
        \\`%` is integer-only. There is no float instance of `Rem`, so
        \\`a % b` on two `f64` values is `error: no operator '%' for f64,
        \\f64`.
    );
    note(25, #string,oneline
        \\Neither division nor remainder is a checked operation at any `-O`
        \\level. Dividing the most negative value of a signed type by `-1`
        \\and dividing by zero both reach the hardware trap directly. The
        \\exit statuses are listed in `Overflow, Traps, and the -O Level`.
    );
    subheading(26, "The three shifts");
    paragraph(27, #string,oneline
        \\There are three shift operators, each owned by its own typeclass.
        \\`>>` is arithmetic on a signed operand and logical on an unsigned
        \\one; the operand type decides, because the instance is selected on
        \\it. There is no saturating right shift, since a right shift cannot
        \\leave the range it started in.
    );
    table_header(28, "Operator   —   Class   —   Meaning");
    table_row(29, "`<<`   |   `ShiftLeft`   |   shift left, discarding the bits that leave the width");
    table_row(30, "`>>`   |   `ShiftRight`   |   shift right, sign-filling when signed and zero-filling when unsigned");
    table_row(31, "`<<|`   |   `SaturatingShiftLeft`   |   shift left, clamping to the extreme value instead of discarding");
    code_block(32, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    a: u8 = 1;
        \\    print("u8   1 << 7  = %\n", a << 7);
        \\    print("u8   1 <<| 9 = %\n", a <<| 9);
        \\    b: s8 = -8;
        \\    print("s8  -8 >> 2  = %\n", b >> 2);
        \\    c: u8 = 248;
        \\    print("u8 248 >> 2  = %\n", c >> 2);
        \\    d: s8 = 64;
        \\    print("s8  64 << 1  = %\n", d << 1);
        \\    print("s8  64 <<| 1 = %\n", d <<| 1);
        \\}
    );
    code_block(33, "text", #string
        \\u8   1 << 7  = 128
        \\u8   1 <<| 9 = 255
        \\s8  -8 >> 2  = -2
        \\u8 248 >> 2  = 62
        \\s8  64 << 1  = -128
        \\s8  64 <<| 1 = 127
    );
    paragraph(34, #string,oneline
        \\The shift count has the same type as the shifted value, and a
        \\written count is checked against the width rather than against the
        \\value range. A shift by the width or more is rejected outright,
        \\because it is not wrapping but undefined: the emitted instruction
        \\would be poison.
    );
    code_block(35, "glosso", #string
        \\main :: () {
        \\    a: u8 = 1;
        \\    b: u8 = a << 8;
        \\    _ := b;
        \\}
    );
    code_block(36, "text", #string
        \\error: shift count 8 is not less than the 8 bits of u8
        \\  --> shift.glo:3:18
        \\  |
        \\3 |     b: u8 = a << 8;
        \\  |                  ^
        \\note: a shift by the width or more has no defined result
    );
    subheading(37, "128-bit integers");
    paragraph(38, #string,oneline
        \\`s128` and `u128` are ordinary integer types, not a library
        \\emulation. Literals lex to a full 128-bit magnitude, arithmetic
        \\and division work, and `print` renders them in full. The lexer
        \\stops at 128 bits: a wider magnitude is
        \\`error: integer literal '...' does not fit in 128 bits`.
    );
    code_block(39, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    hi:  s128 = 170141183460469231731687303715884105727;
        \\    lo:  s128 = -170141183460469231731687303715884105728;
        \\    umx: u128 = 340282366920938463463374607431768211455;
        \\    print("s128 max %\n", hi);
        \\    print("s128 min %\n", lo);
        \\    print("u128 max %\n", umx);
        \\    a: u128 = 18446744073709551615;
        \\    print("u64max squared %\n", a * a);
        \\    one: u128 = 1;
        \\    print("1 << 127 %\n", one << 127);
        \\    mask: u128 = 16#ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff;
        \\    print("hex mask %\n", mask);
        \\    p: s128 = -7;  q: s128 = 2;
        \\    print("-7 / 2 = %  -7 rem 2 = %\n", p / q, p % q);
        \\    print("cast s128 -1 to u128 %\n", cast(u128) cast(s128) -1);
        \\    print("cast u128 max to u8  %\n", cast(u8) umx);
        \\}
    );
    code_block(40, "text", #string
        \\s128 max 170141183460469231731687303715884105727
        \\s128 min -170141183460469231731687303715884105728
        \\u128 max 340282366920938463463374607431768211455
        \\u64max squared 340282366920938463426481119284349108225
        \\1 << 127 170141183460469231731687303715884105728
        \\hex mask 340282366920938463463374607431768211455
        \\-7 / 2 = -3  -7 rem 2 = -1
        \\cast s128 -1 to u128 340282366920938463463374607431768211455
        \\cast u128 max to u8  255
    );
    note(41, #string,oneline
        \\A 128-bit value needs an annotation. An unannotated literal
        \\defaults to `int`, so
        \\`big := 170141183460469231731687303715884105727;` is
        \\`error: 170141183460469231731687303715884105727 does not fit int,
        \\whose range is -9223372036854775808..=9223372036854775807`. Write
        \\`: s128` or `: u128`, or cast.
    );
}

render_section_24 :: () {
    paragraph(0, #string,oneline
        \\Five float spellings are recognised. Each names a semantic width,
        \\which is how many bits the arithmetic actually uses, and a storage
        \\size, which is how many bytes the value occupies. The two differ
        \\for `f80`: eighty significant bits stored in sixteen.
    );
    table_header(1, "Spelling   —   Format   —   Size / alignment");
    table_row(2, "`f16`   |   IEEE binary16   |   2 / 2");
    table_row(3, "`f32`   |   IEEE binary32   |   4 / 4");
    table_row(4, "`f64`   |   IEEE binary64   |   8 / 8");
    table_row(5, "`f80`   |   x87 80-bit extended   |   16 / 16");
    table_row(6, "`f128`   |   IEEE binary128   |   16 / 16");
    paragraph(7, #string,oneline
        \\`f64` is the default: an unannotated float literal becomes one,
        \\and the unnamed float type prints as `f64`. The backend lowers the
        \\five to the LLVM types `half`, `float`, `double`, `x86_fp80` and
        \\`fp128`. Literal defaulting itself is covered in `Compile-Time
        \\Numbers and Literal Defaulting`.
    );
    code_block(8, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    a: f16 = 1.5;  b: f32 = 1.5;  c: f64 = 1.5;
        \\    d: f80 = 1.5;  e: f128 = 1.5;
        \\    print("f16 %  f32 %  f64 %  f80 %  f128 %\n", a, b, c, d, cast(f64) e);
        \\
        \\    t: f16 = 1.0 / 3.0;
        \\    u: f32 = 1.0 / 3.0;
        \\    v: f64 = 1.0 / 3.0;
        \\    print("one third at f16 %  f32 %  f64 %\n", cast(f64) t, u, v);
        \\
        \\    one: f16 = 1.0;
        \\    tick: f16 = 0.001;
        \\    print("f16 next above 1.0 is %\n", cast(f64)(one + tick));
        \\}
    );
    code_block(9, "text", #string
        \\f16 1.5  f32 1.5  f64 1.5  f80 1.5  f128 1.5
        \\one third at f16 0.333252  f32 0.333333  f64 0.333333
        \\f16 next above 1.0 is 1.000977
    );
    subheading(10, "binary16 is real");
    paragraph(11, #string,oneline
        \\`f16` is not a storage-only format that widens for arithmetic. The
        \\compile-time evaluator rounds through a binary16 encode and decode
        \\with round-to-nearest, ties-to-even, so a compile-time result and a
        \\run-time result agree. One third is `0.333252` at `f16` against
        \\`0.333333` at `f32`, and the next representable value above `1.0`
        \\is `1.000977`, which is one plus two to the minus tenth. The largest
        \\finite `f16` is `65504`.
    );
    subheading(12, "`f80` is x87 only");
    paragraph(13, #string,oneline
        \\`f80` is the x87 extended format, and only an x86 target has it in
        \\hardware. The backend asks the target: for cpu `x86_64`, `x86` or
        \\`i386` it emits LLVM's `x86_fp80`, and on every other target it
        \\carries the value in an `fp128` instead. The storage size stays
        \\sixteen bytes either way, so a layout does not shift under a
        \\cross-compile.
    );
    code_block(14, "glosso", #string
        \\widen :: (a: f80, b: f80) -> f80 {
        \\    return a + b;
        \\}
        \\
        \\main :: () {
        \\    x: f80 = 1.5;
        \\    y: f80 = 2.5;
        \\    z := widen(x, y);
        \\    _ := z;
        \\}
    );
    code_block(15, "text", #string
        \\$ glosso --backend llvm-ir -o f80_x86.ll f80.glo
        \\define x86_fp80 @glo_widen(x86_fp80 %0, x86_fp80 %1) {
        \\
        \\$ glosso --backend llvm-ir --target aarch64-linux-musl -o f80_arm.ll f80.glo
        \\define fp128 @glo_widen(fp128 %0, fp128 %1) {
    );
    note(16, #string,oneline
        \\The two carriers are not the same bit image. On an x86 target the
        \\sixteen bytes hold an x87 extended value; elsewhere they hold an
        \\IEEE binary128. An `f80` written to a file by one build is not
        \\readable as an `f80` by the other. `f80` is for reaching x87
        \\precision, not for portable storage.
    );
    subheading(17, "There is no float fitting check");
    paragraph(18, #string,oneline
        \\An integer literal that leaves its target's range is a compile
        \\error, quoting the range: `error: 300 does not fit u8, whose range
        \\is 0..=255`. There is no counterpart for floats. A float literal
        \\is rounded to the nearest representable value of the target type
        \\and nothing is reported, so a magnitude above the maximum becomes
        \\an infinity and a magnitude below the smallest subnormal becomes
        \\zero.
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    over:  f16 = 100000.0;
        \\    under: f16 = 0.00000001;
        \\    limit: f16 = 65504.0;
        \\    print("over <= f16 max : %\n", over <= limit);
        \\    print("over == over    : %\n", over == over);
        \\    print("over + over     : %\n", over + over == over);
        \\    print("over / over     : %\n", over / over == over / over);
        \\    print("under == 0.0    : %\n", cast(f64) under == 0.0);
        \\}
    );
    code_block(20, "text", #string
        \\over <= f16 max : 0
        \\over == over    : 1
        \\over + over     : 1
        \\over / over     : 0
        \\under == 0.0    : 1
    );
    paragraph(21, #string,oneline
        \\That output is the signature of a positive infinity. `over` is not
        \\below the largest finite `f16`, it equals itself so it is not a
        \\NaN, and adding it to itself leaves it unchanged. Dividing it by
        \\itself does produce a NaN, which is why the fourth comparison
        \\fails. `under` has become an exact zero.
    );
    note(22, #string,oneline
        \\`print` will not reveal the infinity. On this target the float
        \\renderer converts the magnitude to a 64-bit integer first, so an
        \\infinity prints as `9223372036854775809`. Float rendering is
        \\target-dependent and is described in `Show, FromString, and print
        \\Formatting`; comparisons are the reliable test.
    );
    code_block(23, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    over: f16 = 100000.0;
        \\    print("f16 100000.0 prints as %\n", cast(f64) over);
        \\}
    );
    code_block(24, "text", #string
        \\f16 100000.0 prints as 9223372036854775809
    );
    subheading(25, "Conversions and operators");
    paragraph(26, #string,oneline
        \\No float converts implicitly to another float, in either
        \\direction, and no runtime integer converts implicitly to a float.
        \\Widening is rejected as firmly as narrowing: the conversion rule
        \\has a lossless-widening branch for integers and none at all for
        \\floats. `#enable(lossy_numerics)` does not change this, because
        \\the gate is consulted only in the integer-to-integer branch;
        \\`f32` to `f64` still fails under it.
    );
    code_block(27, "glosso", #string
        \\main :: () {
        \\    x: f32 = 1.5;
        \\    y: f64 = x;
        \\    _ := y;
        \\}
    );
    code_block(28, "text", #string
        \\error: got f32, expected f64
        \\  --> widen.glo:3:14
        \\  |
        \\3 |     y: f64 = x;
        \\  |              ^
    );
    bullet(29, #string,oneline
        \\`cast(T)` is the bridge in both directions, and it truncates
        \\toward zero going to an integer. `cast` and `acast` covers it.
    );
    bullet(30, #string,oneline
        \\Operators are homogeneous. `a + b` with `a: f32` and `b: f64` is
        \\`error: got f64, expected f32`, not a promotion.
    );
    bullet(31, #string,oneline
        \\`%` has no float instance: `error: no operator '%' for f64, f64`.
    );
    bullet(32, #string,oneline
        \\Floats are `PartialEq` but explicitly not `Eq`. The Prelude
        \\declares a negative instance, `$T :: instance !Eq where
        \\Is_Float(T)`, because NaN is not equal to itself.
    );
    note(33, #string,oneline
        \\An `f128` cannot be printed on `x86_64-pc-windows-msvc`. The
        \\boxing path that `print` uses needs the compiler-runtime helpers
        \\`__trunctfdf2` and `__lttf2`, and the link fails with
        \\`rust-lld: error: undefined symbol: __trunctfdf2`. Arithmetic on
        \\`f128` works; print `cast(f64) x` instead. `f80` prints normally.
    );
}

render_section_25 :: () {
    paragraph(0, #string,oneline
        \\A complex type is a primitive, not a two-field struct. Five widths
        \\exist, each a pair of same-width floats laid out as real part then
        \\imaginary part. The name gives the total number of semantic bits,
        \\so `c128` is a pair of `f64` and `c32` a pair of `f16`. Alignment
        \\follows the component, not the pair.
    );
    table_header(1, "Spelling   —   Components   —   Size / alignment");
    table_row(2, "`c32`   |   two `f16`   |   4 / 2");
    table_row(3, "`c64`   |   two `f32`   |   8 / 4");
    table_row(4, "`c128`   |   two `f64`   |   16 / 8");
    table_row(5, "`c160`   |   two `f80`   |   32 / 16");
    table_row(6, "`c256`   |   two `f128`   |   32 / 16");
    paragraph(7, #string,oneline
        \\`c160` and `c256` are thirty-two bytes rather than twenty and
        \\thirty-two respectively, because each component uses the sixteen
        \\byte storage its scalar type uses. The components round to their
        \\own widths: one third is `0.333252` in a `c32` and `0.333333` in a
        \\`c64`, exactly as it is in `f16` and `f32`.
    );
    paragraph(8, #string,oneline
        \\`type_kind` reports `15` for a complex type, its own tag.
        \\`Is_Complex(T)` answers true; `Is_Numeric(T)` does not, because
        \\`Is_Numeric` is defined as integer or float. That definition is
        \\the reason for everything in the next section.
    );
    subheading(9, "Why the arithmetic is not in the Prelude");
    paragraph(10, #string,oneline
        \\Every primitive operator instance in the Prelude is keyed on
        \\`Is_Integer(T)` or on `Is_Float(T)`. A complex type satisfies
        \\neither, so none of those instances reaches it. `Add`, `Sub`,
        \\`Mul`, `Div`, `Neg`, `Num` and `PartialEq` for `Is_Complex(T)` are
        \\declared in `std/Math/Complex.glo` instead, together with the
        \\constructors and accessors, which are `#magic` functions. Nothing
        \\about complex arithmetic is in scope until that file is imported.
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    a := complex128(1.0, 2.0);
        \\    _ := a;
        \\}
    );
    code_block(12, "text", #string
        \\error: unknown function complex128
        \\  --> nocomplex.glo:4:10
        \\  |
        \\4 |     a := complex128(1.0, 2.0);
        \\  |          ^^^^^^^^^^
    );
    paragraph(13, #string,oneline
        \\With the import, the operators and the accessor functions are both
        \\available. There is one function per width, named with the number
        \\of semantic bits.
    );
    table_header(14, "Function   —   Widths   —   Result");
    table_row(15, "`complex32` … `complex256`   |   32, 64, 128, 160, 256   |   a complex value from a real and an imaginary component");
    table_row(16, "`real_part32` … `real_part256`   |   32, 64, 128, 160, 256   |   the real component, as the matching float type");
    table_row(17, "`imaginary_part32` … `imaginary_part256`   |   32, 64, 128, 160, 256   |   the imaginary component");
    table_row(18, "`conjugate32` … `conjugate256`   |   32, 64, 128, 160, 256   |   the complex conjugate");
    table_row(19, "`norm32` … `norm256`   |   32, 64, 128, 160, 256   |   the Euclidean magnitude, as the matching float type");
    code_block(20, "glosso", #string
        \\#import "Io";
        \\#import "Math/Complex";
        \\
        \\main :: () {
        \\    a := complex128(1.0, 2.0);
        \\    b := complex128(3.0, -4.0);
        \\    sum := a + b;
        \\    prod := a * b;
        \\    print("sum  re % im %\n", real_part128(sum), imaginary_part128(sum));
        \\    print("prod re % im %\n", real_part128(prod), imaginary_part128(prod));
        \\    print("conj re % im %\n", real_part128(conjugate128(a)), imaginary_part128(conjugate128(a)));
        \\    print("norm b  %\n", norm128(b));
        \\    print("a == a  %\n", a == a);
        \\    z: c128;
        \\    print("default re % im %\n", real_part128(z), imaginary_part128(z));
        \\}
    );
    code_block(21, "text", #string
        \\sum  re 4 im -2
        \\prod re 11 im 2
        \\conj re 1 im -2
        \\norm b  5
        \\a == a  1
        \\default re 0 im 0
    );
    note(22, #string,oneline
        \\Importing `Math/Complex` currently also emits a warning from
        \\inside the library itself, `warning: no '*' for <T>: the
        \\where-clause only provides nothing`, pointing at
        \\`std/Math/Complex.glo`. It is harmless and comes from the library,
        \\not from the importing program.
    );
    subheading(23, "There is no imaginary literal");
    paragraph(24, #string,oneline
        \\Construction is explicit. Glosso has no suffix or directive for an
        \\imaginary part; `#I` in particular is not a token, and writing it
        \\is `error: unexpected directive 'I'`. The only way to make a
        \\complex value with a non-zero imaginary component is a constructor
        \\call.
    );
    code_block(25, "glosso", #string
        \\#import "Math/Complex";
        \\
        \\main :: () {
        \\    a: c128 = 2.0 + 3.0#I;
        \\    _ := a;
        \\}
    );
    code_block(26, "text", #string
        \\error: unexpected directive 'I'
        \\  --> imaginary.glo:4:24
        \\  |
        \\4 |     a: c128 = 2.0 + 3.0#I;
        \\  |                        ^^
    );
    paragraph(27, #string,oneline
        \\A compile-time integer does reach a complex target and lands in
        \\the real part, since the compile-time number rules let an integer
        \\family widen into the complex family. That is the whole of the
        \\implicit path: there is no conversion from a runtime scalar.
    );
    code_block(28, "glosso", #string
        \\#import "Io";
        \\#import "Math/Complex";
        \\
        \\main :: () {
        \\    z: c128 = 3;
        \\    print("from comptime_int re % im %\n", real_part128(z), imaginary_part128(z));
        \\    r: f64 = 1.5;
        \\    w := complex128(r, 0.0);
        \\    print("built re % im %\n", real_part128(w), imaginary_part128(w));
        \\}
    );
    code_block(29, "text", #string
        \\from comptime_int re 3 im 0
        \\built re 1.5 im 0
    );
    bullet(30, #string,oneline
        \\Mixing a complex and a scalar in one operator is rejected: with
        \\`a: c128` and `r: f64`, `a + r` is `error: no operator '+' for
        \\c128, f64`. Widen the scalar with a constructor first.
    );
    bullet(31, #string,oneline
        \\A complex type does not implement `Show`. Passing one to `print`
        \\is ``error: variadic arg type `c128` does not implement `Show` in
        \\call `print` ``. Print the components.
    );
    bullet(32, #string,oneline
        \\`c256` components are `f128` and inherit that type's printing
        \\limitation, so `cast(f64)` them before printing. `c160`
        \\components are `f80` and print directly.
    );
    bullet(33, #string,oneline
        \\`c160` uses x87 arithmetic on x86 targets and an `fp128` carrier
        \\elsewhere, for the same reason `f80` does. `Floating Point` has
        \\the detail.
    );
}

render_section_26 :: () {
    paragraph(0, #string,oneline
        \\`bool` is one byte with two values, `true` and `false`. It is its
        \\own type kind, not a narrow integer: `Is_Bool(bool)` is true and
        \\`Is_Integer(bool)` is false, so none of the integer arithmetic
        \\instances reaches it and `true + false` is `error: no operator '+'
        \\for bool, bool`.
    );
    paragraph(1, #string,oneline
        \\Nothing converts to `bool` implicitly and `bool` converts to
        \\nothing. `b: bool = 1;` is `error: got int, expected bool`, and
        \\`x: s64 = true;` is `error: got bool, expected int`. The
        \\strictness is deliberate: an integer used where a truth value was
        \\meant is the most common way for a condition to be silently wrong,
        \\and Glosso answers that question in the condition position only,
        \\where it is visible.
    );
    subheading(2, "`cast` is the only bridge");
    code_block(3, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    t := true;
        \\    f := false;
        \\    print("show true/false  % %\n", t, f);
        \\    print("cast(int) true   %\n", cast(int) t);
        \\    print("cast(bool) 0     %\n", cast(bool) 0);
        \\    print("cast(bool) 5     %\n", cast(bool) 5);
        \\    print("cast(bool) -1    %\n", cast(bool) -1);
        \\    print("size / kind      % %\n", size_of(bool), type_kind(bool));
        \\    z: bool;
        \\    print("default          %\n", z);
        \\    print("and / or / not   % % %\n", t && f, t || f, !t);
        \\}
    );
    code_block(4, "text", #string
        \\show true/false  1 0
        \\cast(int) true   1
        \\cast(bool) 0     0
        \\cast(bool) 5     1
        \\cast(bool) -1    1
        \\size / kind      1 3
        \\default          0
        \\and / or / not   0 1 0
    );
    bullet(5, #string,oneline
        \\`show` renders a `bool` as `1` or `0`, not as `true` or `false`.
        \\The Prelude's shower emits the C strings `"1"` and `"0"`.
    );
    bullet(6, #string,oneline
        \\`cast(bool)` of an integer is a not-equal-to-zero test, so `5` and
        \\`-1` both become `true`.
    );
    bullet(7, #string,oneline
        \\An uninitialised `bool` local is `false`; the default value of
        \\every primitive is its zero.
    );
    bullet(8, #string,oneline
        \\`&&` and `||` have a single instance each, `(bool, bool)`, with a
        \\`#lazy` right operand. A non-`bool` operand is rejected rather
        \\than tested: `n && b` with `n: s64` is `error: no operator '&&'
        \\for int, bool`.
    );
    subheading(9, "Truthiness");
    paragraph(10, #string,oneline
        \\A condition does not have to be a `bool`. `if` and `while` accept
        \\any type for which the backend has a truth rule, and the rule is
        \\chosen by the type's kind. The table below is the complete set;
        \\anything outside it is rejected, not guessed at.
    );
    table_header(11, "Type   —   The condition is true when");
    table_row(12, "`bool`   |   the value is `true`");
    table_row(13, "integer, `enum`   |   the value is not zero");
    table_row(14, "float   |   the value is ordered-unequal to zero, so `-0.0` and NaN are both false");
    table_row(15, "`*T`, `[*]T`, function pointer, `label`   |   the address is not null");
    table_row(16, "`?*T`, `?[*]T`, optional function pointer   |   the optional is present, which is the same null test");
    table_row(17, "`string`, `cstring`, `string16`, `cstring16`   |   the count is not zero");
    table_row(18, "`[]T`, `[..]T`   |   the count is not zero");
    code_block(19, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    zero: s64 = 0;
        \\    if zero print("0        taken\n"); else print("0        skipped\n");
        \\    neg: s64 = -2;
        \\    if neg print("-2       taken\n"); else print("-2       skipped\n");
        \\    minus: f64 = -0.0;
        \\    if minus print("-0.0     taken\n"); else print("-0.0     skipped\n");
        \\    nan := minus / minus;
        \\    if nan print("nan      taken\n"); else print("nan      skipped\n");
        \\    empty: string = "";
        \\    if empty print("\"\"       taken\n"); else print("\"\"       skipped\n");
        \\    text: string = "x";
        \\    if text print("\"x\"      taken\n"); else print("\"x\"      skipped\n");
        \\    n: s64 = 7;
        \\    p: *s64 = *n;
        \\    if p print("*s64     taken\n"); else print("*s64     skipped\n");
        \\    none: ?*s64 = .None;
        \\    if none print("?*s64 .None  taken\n"); else print("?*s64 .None  skipped\n");
        \\}
    );
    code_block(20, "text", #string
        \\0        skipped
        \\-2       taken
        \\-0.0     skipped
        \\nan      skipped
        \\""       skipped
        \\"x"      taken
        \\*s64     taken
        \\?*s64 .None  skipped
    );
    note(21, #string,oneline
        \\A NaN is false. The float test is an ordered comparison against
        \\zero, and an ordered comparison involving a NaN is false whatever
        \\the other operand is. So `if x` and `if x != 0.0` disagree on a
        \\NaN, and neither `if x` nor `if !x` will be entered by one.
    );
    paragraph(22, #string,oneline
        \\A pointer optional is truthy exactly when it is present because it
        \\has no tag to consult: `?*T` is laid out as the bare pointer and
        \\`.None` is address zero, so the presence test and the null test
        \\are the same instruction. An optional over a value type is a real
        \\tagged union, and the rule does not extend to it.
    );
    code_block(23, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    o: ?s64 = .Some(5);
        \\    if o print("taken\n"); else print("skipped\n");
        \\}
    );
    code_block(24, "text", #string
        \\error: values of type Option_int have no native truthiness rule [opcode Jz]
        \\  while lowering 'main' at IR instruction 5
    );
    paragraph(25, #string,oneline
        \\The same refusal covers structs, tuples, unions and every other
        \\aggregate: `if p` on a struct `P` is `error: values of type P have
        \\no native truthiness rule`. Every entry in the table above rests
        \\on a word the value already carries: a tag-free null, or a count
        \\at offset zero. A fixed `[N]T` carries neither, so write
        \\`arr[..]` or `arr.count` and test that.
    );
    subheading(26, "`!` is a typeclass operator");
    paragraph(27, #string,oneline
        \\`!` is not built into the language. It is owned by the
        \\`LogicalNot` typeclass, whose declaration lives in
        \\`std/Prelude/Primitive_Operators.glo`, and it does only what an
        \\instance says it does. The Prelude ships three instances, and no
        \\instance covers integers or pointers.
    );
    code_block(28, "glosso", #string
        \\LogicalNot :: typeclass (T: type) {
        \\    Output :: type;
        \\    '!' :: (value: T) -> Output #operator(prefix);
        \\}
    );
    table_header(29, "Instance   —   `!value` is true when");
    table_row(30, "`bool`   |   the value is `false`; the body is `#magic \"bool_not\"`");
    table_row(31, "`?$T`   |   the optional is `.None`, for every `T`, niche or not");
    table_row(32, "`$E!$T`   |   the result is an `.Err`");
    code_block(33, "glosso", #string
        \\#import "Io";
        \\
        \\Fault :: enum { Bad; }
        \\
        \\main :: () {
        \\    b: bool = false;
        \\    print("!false     %\n", !b);
        \\
        \\    o: ?s64 = .Some(5);
        \\    n: ?s64 = .None;
        \\    print("!.Some(5)  %\n", !o);
        \\    print("!.None     %\n", !n);
        \\
        \\    ok: Fault!s64 = .Ok(1);
        \\    bad: Fault!s64 = .Err(.Bad);
        \\    print("!.Ok(1)    %\n", !ok);
        \\    print("!.Err      %\n", !bad);
        \\}
    );
    code_block(34, "text", #string
        \\!false     1
        \\!.Some(5)  0
        \\!.None     1
        \\!.Ok(1)    0
        \\!.Err      1
    );
    paragraph(35, #string,oneline
        \\The two mechanisms answer different questions and cover different
        \\types. `!o` works on a `?s64` because `LogicalNot` has an instance
        \\for every `?T`, while `if o` on the same value does not, because
        \\the truth rule stops at the niche layouts. In the other direction,
        \\`if n` on an integer works and `!n` does not:
        \\`error: no prefix operator '!' for int`.
    );
    note(36, #string,oneline
        \\Truthiness belongs to `if` and `while` alone. `#if` requires a
        \\`bool` outright: `#if 3` is `error: #if condition must be bool,
        \\got comptime_int`. `ifx` requires one too, reporting it as an
        \\ordinary conversion failure: `ifx 3 "a" else "b"` is
        \\`error: got int, expected bool`. See `Static Branching with #if`
        \\and `ifx Expressions`.
    );
}

render_section_27 :: () {
    paragraph(0, #string,oneline
        \\Glosso has four built-in string types. They differ in the encoding of
        \\their code units and in whether the storage keeps a zero unit past the
        \\end; they do not differ in representation, and no import is needed to
        \\use any of them.
    );
    table_header(1, "Spelling   —   Code unit   —   Trailing zero");
    table_row(2, "`string`   |   `u8`, UTF-8   |   no");
    table_row(3, "`cstring`   |   `u8`, UTF-8   |   yes");
    table_row(4, "`string16`   |   `u16`, UTF-16   |   no");
    table_row(5, "`cstring16`   |   `u16`, UTF-16   |   yes");
    paragraph(6, #string,oneline
        \\All four are one kind to the compiler: `type_kind` answers `4`
        \\(`Type_Info_Tag.String`) for every one of them, and `size_of` answers
        \\`24` for every one of them. A string value is a three-word descriptor,
        \\not a pointer, so passing one by value copies twenty-four bytes and
        \\copies no character data.
    );
    table_header(7, "Field   —   Type   —   Holds");
    table_row(8, "`.count`   |   `s64`   |   code units the value denotes");
    table_row(9, "`.data`   |   `[*]u8` or `[*]u16`   |   the first code unit");
    table_row(10, "`.capacity`   |   `s64`   |   code units the storage can hold");
    paragraph(11, #string,oneline
        \\`.count` and `.capacity` are measured in code units, not in bytes and
        \\not in characters, so a `string16` of four characters has `.count` four
        \\and occupies eight bytes of character data. `.data` is a many-pointer
        \\to the unit type; `type_name` prints it under its C spelling,
        \\`uint8_t *` for the UTF-8 types and `uint16_t *` for the UTF-16 ones.
    );
    code_block(12, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    s: string = "hello";
        \\    print("count %  capacity %\n", s.count, s.capacity);
        \\    print("s[0] %  s[1..3] %\n", s[0], s[1..3]);
        \\    print("concat %\n", s + " world");
        \\    print("equal %  differ %\n", s == "hello", s != "hello");
        \\}
    );
    code_block(13, "text", #string
        \\count 5  capacity 5
        \\s[0] 104  s[1..3] el
        \\concat hello world
        \\equal 1  differ 0
    );
    paragraph(14, #string,oneline
        \\Indexing yields one code unit as an integer, so `s[0]` on a `string` is
        \\a `u8` and prints as the byte value `104`, not as the character `h`.
        \\Slicing with a range yields a string of the same type. `+` is the `Add`
        \\instance for `Is_String(T)` and concatenates into fresh storage.
    );
    note(15, #string,oneline
        \\`.count` counts code units, so it is not a character count for anything
        \\outside ASCII. The four-character string `café` has `.count` five as a
        \\`string` and `.count` four as a `string16`, because the `é` occupies two
        \\UTF-8 bytes and one UTF-16 unit.
    );
    code_block(16, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    s: string = "café";
        \\    print("bytes % first % last %\n", s.count, s[0], s[4]);
        \\    w: string16 = "café";
        \\    print("utf-16 units %\n", w.count);
        \\    c: cstring = "café";
        \\    print("cstring count % terminator %\n", c.count, c.data[c.count]);
        \\}
    );
    code_block(17, "text", #string
        \\bytes 5 first 99 last 169
        \\utf-16 units 4
        \\cstring count 5 terminator 0
    );
    subheading(18, "The trailing zero");
    paragraph(19, #string,oneline
        \\`cstring` and `cstring16` promise that `data[count]` is a zero code
        \\unit. That unit lives outside the descriptor's accounting: allocation
        \\reserves one code unit more than `count`, and both `count` and
        \\`capacity` exclude it. The promise exists so that a `cstring` can be
        \\handed to a C function that scans for a terminator, which is the only
        \\thing the C convention gives it that the count does not.
    );
    paragraph(20, #string,oneline
        \\`string` and `string16` make no such promise. A string literal happens
        \\to carry one, because a literal is emitted as a static constant that is
        \\one unit longer than its count, but a `string` produced by
        \\concatenation or by any other library routine is allocated to exactly
        \\`count` code units. Reading `data[count]` on such a value reads past the
        \\buffer.
    );
    note(21, #string,oneline
        \\Never assume a `string` is terminated. Convert with `cstring_from_string`
        \\or `c_string` from `Strings/Utf8` when a terminator is required; the
        \\first takes an allocator and must be released with `cstring_free`, the
        \\second allocates from the temporary allocator.
    );
    subheading(22, "Reaching C");
    paragraph(23, #string,oneline
        \\A string coerces to a `const` many-pointer of its code-unit type. This
        \\is the one implicit conversion a string value takes part in, and it
        \\exists so that a C binding whose parameter is `const char *` accepts a
        \\Glosso string without ceremony. The target must be `const`: handing out
        \\a mutable pointer into a value whose storage may be shared or static is
        \\not something the conversion is willing to do silently.
    );
    table_header(24, "Source   —   Reaches");
    table_row(25, "`string`, `cstring`   |   `[*]const u8`, `[*]const s8`");
    table_row(26, "`string16`, `cstring16`   |   `[*]const u16`, `[*]const s16`");
    code_block(27, "glosso", #string
        \\#import "Io";
        \\
        \\W16 : string16 : "hi";
        \\Bytes :: type_of(("hi").data);
        \\Units :: type_of(W16.data);
        \\
        \\first_byte :: (p: [*]const u8) -> u8 { return p[0]; }
        \\first_char :: (p: [*]const s8) -> s8 { return p[0]; }
        \\first_unit :: (p: [*]const u16) -> u16 { return p[0]; }
        \\
        \\main :: () {
        \\    print(".data is % for string, % for string16\n",
        \\        type_name(Bytes), type_name(Units));
        \\    s: string = "hi";
        \\    w: string16 = "hi";
        \\    print("% % %\n", first_byte(s), first_char(s), first_unit(w));
        \\}
    );
    code_block(28, "text", #string
        \\.data is uint8_t * for string, uint16_t * for string16
        \\104 104 104
    );
    paragraph(29, #string,oneline
        \\The reverse direction is refused by name, because a pointer has no
        \\length to recover: `back: string = p;` reports `cannot implicitly
        \\convert [*]u8 to string, which carries a count the pointer does not;
        \\make a slice of known length and use byte_slice_to_string`. Scanning for
        \\a terminator would be a hidden traversal of a buffer that never promised
        \\to have one, so the compiler asks for the length instead of inventing it.
    );
    paragraph(30, #string,oneline
        \\The four string types do not convert to one another either, implicitly
        \\or by `cast`: `c: cstring = s;` is `got string, expected cstring`, and
        \\`cast(cstring) s` is `cannot cast string to cstring`. Crossing between
        \\them copies, so it is a library call rather than a conversion.
    );
    code_block(31, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Strings/Utf8";
        \\
        \\main :: () {
        \\    s: string = "hi";
        \\    c := c_string(s);
        \\    print("cstring count % terminator %\n", c.count, c.data[c.count]);
        \\    print("back to string %\n", cstring_to_string(c));
        \\    bytes := utf8_bytes(s);
        \\    print("view count % first %\n", bytes.count, bytes[0]);
        \\    print("round trip %\n", byte_slice_to_string(bytes));
        \\}
    );
    code_block(32, "text", #string
        \\cstring count 2 terminator 0
        \\back to string hi
        \\view count 2 first 104
        \\round trip hi
    );
    subheading(33, "Comparison");
    paragraph(34, #string,oneline
        \\`==` and `!=` compare contents, not descriptors: the Prelude declares
        \\`($T, T) :: instance PartialEq where Is_String(T)` with the `str_eq` and
        \\`str_ne` intrinsics, and `$T :: instance Eq where Is_String(T)` makes
        \\the relation a full equality. Two strings of equal length whose code
        \\units agree are equal however their storage was obtained.
    );
    bullet(35, #string,oneline
        \\There is no ordering instance for strings. `a <=> b` reaches lowering
        \\and fails there with `binary operator '<=>' is unsupported for string
        \\and string`, and `<`, `<=`, `>` and `>=` are `PartialOrd` default
        \\methods written over `<=>`, so they fail the same way. Compare with a
        \\loop over the units, or with the helpers in `Strings/Utf8`.
    );
    bullet(36, #string,oneline
        \\Both operands must be the same string type. The instance head is
        \\`($T, T)`, so comparing a `string` against a `cstring` finds no operator.
    );
    note(37, #string,oneline
        \\`cstring` and `cstring16` do not implement `Show`. Passing one to
        \\`print` reports that the variadic argument type `cstring` does not
        \\implement `Show` in the call. `string` and `string16` do implement it;
        \\convert with `cstring_to_string` before printing.
    );
}

render_section_28 :: () {
    paragraph(0, #string,oneline
        \\`Simd(T, N)` is a first-class value type holding exactly `N` inline
        \\lanes of type `T`. It is declared in `std/Simd.glo` and needs
        \\`#import "Simd";`. The compile-time evaluator executes each lane
        \\scalarly; the LLVM backend receives a fixed-width vector and selects
        \\native instructions where the target has them.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Simd";
        \\#import "Meta";
        \\
        \\V4 :: Simd(f32, 4);
        \\
        \\main :: () {
        \\    a: V4 = #simd .[1.0, 2.0, 3.0, 4.0];
        \\    b: V4 = #simd .[10.0, 20.0, 30.0, 40.0];
        \\    sum := a + b;
        \\    print("sum % % % %\n", sum[0], sum[1], sum[2], sum[3]);
        \\    print("lanes % element % size % kind %\n",
        \\        simd_lane_count(V4), type_name(simd_element_type(V4)),
        \\        size_of(V4), cast(s64) type_kind(V4));
        \\    print("count % name %\n", a.count, type_name(V4));
        \\    a[0] = 99.0;
        \\    print("after lane store %\n", a[0]);
        \\}
    );
    code_block(2, "text", #string
        \\sum 11 22 33 44
        \\lanes 4 element f32 size 16 kind 16
        \\count 4 name Simd(f32, 4)
        \\after lane store 99
    );
    paragraph(3, #string,oneline
        \\A `Simd` is not an array. Internally it is an array type carrying a
        \\vector flag, so `Is_Simd(V4)` is `1` while `Is_Array(V4)` is `0`, and
        \\`type_kind` answers `16` rather than `6`. `Type::repr` renders it
        \\`Simd(f32, 4)`, which is what every diagnostic naming one prints.
    );
    subheading(4, "Lane counts and lane types");
    paragraph(5, #string,oneline
        \\The lane count must be a literal in `1..64`, and the lane type must be
        \\an integer of at most 64 bits, `f32`, or `f64`. Both limits are checked
        \\where the type is written, so a bad shape is a type error and never a
        \\backend surprise.
    );
    table_header(6, "Written   —   Result");
    table_row(7, "`Simd(u64, 64)`   |   accepted, 512 bits");
    table_row(8, "`Simd(f64, 65)`   |   `Simd lane count must be a literal in 1..64`");
    table_row(9, "`Simd(f64, 0)`   |   `Simd lane count must be a literal in 1..64`");
    table_row(10, "`Simd(s128, 2)`   |   `unsupported Simd lane type s128`");
    table_row(11, "`Simd(f16, 4)`   |   `unsupported Simd lane type f16`");
    table_row(12, "`Simd(bool, 4)`   |   `unsupported Simd lane type bool`");
    subheading(13, "`#simd` literals");
    paragraph(14, #string,oneline
        \\A vector literal is `#simd` followed by a dot-bracket literal. The
        \\prefix is required and the context must already be a `Simd(T, N)`: an
        \\unprefixed `.[...]` builds an ordinary fixed array and is never
        \\reinterpreted, which is what keeps the two shapes from silently
        \\swapping places. The element count must equal the lane count exactly.
    );
    table_header(15, "Written   —   Diagnostic");
    table_row(16, "`a: V4 = .[1, 2, 3, 4];`   |   `ordinary array literal .[...] cannot initialize Simd(s32, 4); use #simd .[...]`");
    table_row(17, "`a := #simd .[1, 2, 3, 4];`   |   `#simd literal requires a Simd(T, N) context`");
    table_row(18, "`a: [4]s32 = #simd .[1, 2, 3, 4];`   |   `#simd literal requires a Simd(T, N) context, got [4]s32`");
    table_row(19, "`a: V4 = #simd .[1, 2, 3];`   |   `SIMD literal has 3 lane(s), expected 4`");
    subheading(20, "Lane access, and the missing `.data`");
    paragraph(21, #string,oneline
        \\`value[i]` and `value[i] = lane` go through the ordinary `[]` and `[]=`
        \\operators and lower to LLVM `extractelement` and `insertelement`; the
        \\store replaces a lane in the value, it does not write through a pointer.
        \\`.count` reports the lane count. There is deliberately no `.data`
        \\(`Simd has no stable .data pointer`) and no slicing (`slice constructor
        \\does not support SIMD arrays`), because the register layout of a vector
        \\is a target decision and exposing an address would make it a promise.
    );
    note(22, #string,oneline
        \\The internal vector ABI is not a C ABI. Cross a foreign boundary with
        \\ordinary scalar memory and move lanes with `simd_load` and `simd_store`,
        \\which accept unaligned addresses and lower with alignment 1.
    );
    code_block(23, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Simd";
        \\
        \\V4 :: Simd(s32, 4);
        \\
        \\main :: () {
        \\    lanes: [4]s32 = .[5, 6, 7, 8];
        \\    v := cast(V4) lanes;
        \\    w: V4 = acast lanes;
        \\    print("cast % acast %\n", v[3], w[3]);
        \\    back := cast([4]s32) (v * w);
        \\    print("back % %\n", back[0], back[3]);
        \\
        \\    loaded := simd_load(V4, lanes.data);
        \\    out: [4]s32;
        \\    simd_store(out.data, loaded + loaded);
        \\    print("loaded % stored %\n", loaded[1], out[1]);
        \\    print("reduce % reversed %\n",
        \\        simd_reduce_add(loaded, cast(s32) 0), simd_reverse(loaded)[0]);
        \\}
    );
    code_block(24, "text", #string
        \\cast 8 acast 8
        \\back 25 64
        \\loaded 6 stored 12
        \\reduce 26 reversed 8
    );
    subheading(25, "The array bridge");
    paragraph(26, #string,oneline
        \\A `Simd(T, N)` and a fixed `[N]T` of the same element type convert in
        \\both directions, but only through `cast` or `acast`, and only at exactly
        \\matching shape. There is no implicit conversion: `v: V4 = src;` reports
        \\`cannot implicitly convert [4]f32 to Simd(f32, 4); use
        \\cast(Simd(f32, 4))value or acast`. A mismatched shape is not castable
        \\either, so `cast(Simd(f32, 4)) src` on a `[8]f32` is `cannot cast [8]f32
        \\to Simd(f32, 4)`.
    );
    subheading(27, "Helpers and operators");
    paragraph(28, #string,oneline
        \\`std/Simd.glo` declares `($V, V)` instances of `Add`, `Sub`, `Mul`,
        \\`Div`, `BitAnd`, `BitOr`, `BitXor`, `ShiftLeft` and `ShiftRight`, plus
        \\`Neg` and `BitNot` over `Is_Simd(V)`, so vectors use the ordinary
        \\operator spellings lane-wise. Both operands must be the same vector
        \\type; there is no scalar-against-vector instance, which is what
        \\`simd_splat` exists for.
    );
    table_header(29, "Helper   —   Meaning");
    table_row(30, "`simd_zero(V)`   |   all lanes zero");
    table_row(31, "`simd_splat(V, value)`   |   every lane set to `value`, which must already be the lane type");
    table_row(32, "`simd_load(V, source)` / `simd_store(dest, value)`   |   move every lane to or from contiguous scalar memory");
    table_row(33, "`simd_reverse(value)`   |   lanes in reverse order");
    table_row(34, "`simd_reduce_add/mul/xor/or(value, initial)`   |   fold every lane into one scalar");
    table_row(35, "`simd_lane_count(V)` / `simd_element_type(V)`   |   compile-time shape queries");
    subheading(36, "Matrices");
    paragraph(37, #string,oneline
        \\`Matrix(T, Rows, Cols)` from `std/Math/Matrix.glo` is the other flagged
        \\array type: fixed inline row-major storage, dimensions part of the type,
        \\no allocator and no view state. The flat index of `(row, column)` is
        \\`row * Cols + column`, and that flat index is what `[]` takes. A matrix
        \\value copies like any other value, so pass a pointer when a caller
        \\should mutate one or when the value is large.
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Math/Matrix";
        \\#import "Meta";
        \\
        \\M23 :: Matrix(s64, 2, 3);
        \\
        \\main :: () {
        \\    m: M23 = .[1, 2, 3,
        \\               4, 5, 6];
        \\    print("rows % columns % elements % size %\n",
        \\        matrix_row_count(M23), matrix_column_count(M23),
        \\        matrix_element_count(M23), size_of(M23));
        \\    print("flat m[4] % kind %\n", m[4], cast(s64) type_kind(M23));
        \\    value, ok := matrix_get(m, 1, 2);
        \\    print("get(1, 2) % ok %\n", value, ok);
        \\    missing, found := matrix_get(m, 5, 0);
        \\    print("get(5, 0) % ok %\n", missing, found);
        \\    n, stored := matrix_set(m, 0, 0, 99);
        \\    print("set -> % original % ok %\n", n[0], m[0], stored);
        \\    print("name % transpose %\n",
        \\        type_name(M23), type_name(matrix_transpose_type(M23)));
        \\}
    );
    code_block(39, "text", #string
        \\rows 2 columns 3 elements 6 size 48
        \\flat m[4] 5 kind 17
        \\get(1, 2) 6 ok 1
        \\get(5, 0) 0 ok 0
        \\set -> 99 original 1 ok 1
        \\name Matrix(int, 2, 3) transpose Matrix(int, 3, 2)
    );
    paragraph(40, #string,oneline
        \\`matrix_get` returns a `(value, ok)` tuple rather than trapping, and
        \\`matrix_set` is functional: it returns a new matrix and leaves its
        \\argument alone, which is what keeps matrix values ordinary values in
        \\both the compile-time evaluator and native code. The shape intrinsics
        \\`matrix_transpose_type`, `matrix_product_type` and
        \\`matrix_matvec_result_type` compute result types at compile time and
        \\reject mismatched shapes there; the vector argument of the last one is a
        \\fixed `[Cols]T`, not a `Simd`.
    );
    note(41, #string,oneline
        \\A `Matrix` alias must be declared at file scope to be usable as a type
        \\annotation. Declaring `M :: Matrix(s64, 2, 3);` inside a procedure and
        \\then writing `m: M = .[1, 2, 3, 4, 5, 6];` gives `got [6]comptime_int,
        \\expected type`.
    );
}

render_section_29 :: () {
    paragraph(0, #string,oneline
        \\`type` is a type whose values are types. A type value is obtained by
        \\naming a type, and it can be bound to a constant, compared, passed as a
        \\parameter and switched on. It is a compile-time value: `size_of(type)`
        \\is `0`, because a type carries no runtime representation of its own.
    );
    paragraph(1, #string,oneline
        \\The introspection intrinsics live in `std/Meta/Utilities.glo` and the
        \\classifying predicates in `std/Meta/Types.glo`; both come in with
        \\`#import "Meta";`. Every one of them is folded to a constant during
        \\checking, so they belong in `#comptime`, `#if`, `where`, constant
        \\initialisers and `#insert`.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Meta";
        \\
        \\Vec2 :: struct { x: f64; y: f64; }
        \\Small :: s32;
        \\
        \\main :: () {
        \\    print("% is % bytes, kind %\n",
        \\        type_name(Small), size_of(Small), cast(s64) type_kind(Small));
        \\    print("% is % bytes, kind %\n",
        \\        type_name(Vec2), size_of(Vec2), cast(s64) type_kind(Vec2));
        \\    x: u16 = 3;
        \\    X :: type_of(x);
        \\    print("type_of(x) is %\n", type_name(X));
        \\    info :: type_info(f80);
        \\    print("f80: name % size % alignment % tag %\n",
        \\        info.name, info.size, info.alignment, cast(s64) info.tag);
        \\}
    );
    code_block(3, "text", #string
        \\s32 is 4 bytes, kind 1
        \\Vec2 is 16 bytes, kind 7
        \\type_of(x) is u16
        \\f80: name f80 size 16 alignment 16 tag 2
    );
    paragraph(4, #string,oneline
        \\`type_of(value)` is the static type of an expression, `type_name(T)` its
        \\printed spelling, `size_of(T)` its size in bytes under natural C layout,
        \\`type_kind(T)` its `Type_Info_Tag`, and `type_info(T)` a record holding
        \\all of that at once. There is no `align_of`: writing one is `unknown
        \\function align_of`, and alignment is read from `type_info(T).alignment`.
        \\Field, variant and enum reflection is a larger surface and is covered in
        \\Reflection.
    );
    paragraph(5, #string,oneline
        \\`type_kind` returns an enum, and `show` prints an enum's numeric value
        \\rather than its name, so `print("%", type_kind(s8))` prints `1`. The tag
        \\set is closed and is declared as `Type_Info_Tag` in `std/Meta/Types.glo`.
    );
    table_header(6, "Value   —   Name   —   Covers");
    table_row(7, "0   |   `Void`   |   `void`");
    table_row(8, "1   |   `Integer`   |   `s8`..`s128`, `u8`..`u128`, `int`, `uint`");
    table_row(9, "2   |   `Float`   |   `f16`..`f128`");
    table_row(10, "3   |   `Bool`   |   `bool`");
    table_row(11, "4   |   `String`   |   `string`, `cstring`, `string16`, `cstring16`");
    table_row(12, "5   |   `Pointer`   |   `*T` and `[*]T`");
    table_row(13, "6   |   `Array`   |   fixed arrays, views, dynamic arrays");
    table_row(14, "7   |   `Struct`   |   `struct`");
    table_row(15, "8   |   `Enum`   |   `enum` and `enum_flags`");
    table_row(16, "9   |   `Union`   |   tagged and raw unions");
    table_row(17, "10   |   `Procedure`   |   procedure and function-pointer types");
    table_row(18, "11   |   `Tuple`   |   multiple-return tuple types");
    table_row(19, "12   |   `Type`   |   `type`");
    table_row(20, "13   |   `Any`   |   `any`");
    table_row(21, "14   |   `Label`   |   `label`");
    table_row(22, "15   |   `Complex`   |   `c32`..`c256`");
    table_row(23, "16   |   `Simd`   |   `Simd(T, N)`");
    table_row(24, "17   |   `Matrix`   |   `Matrix(T, Rows, Cols)`");
    paragraph(25, #string,oneline
        \\`Type_Info` itself is an ordinary struct with fields `tag`, `name`,
        \\`size`, `alignment` and `shower`, so a single `type_info(T)` call
        \\answers every shape question about `T` at once.
    );
    subheading(26, "The `Is_*` predicates");
    paragraph(27, #string,oneline
        \\`std/Meta/Types.glo` wraps the tag comparison in a family of named
        \\predicates: `Is_Integer`, `Is_Float`, `Is_Complex`, `Is_Numeric`,
        \\`Is_Bool`, `Is_String`, `Is_Pointer`, `Is_Procedure`, `Is_Addressable`,
        \\`Is_Enum`, `Is_Struct`, `Is_Union`, `Is_Array`, `Is_Simd`, `Is_Matrix`
        \\and `Is_Label`. They are what `where` clauses and instance heads are
        \\written against, so they are the working vocabulary rather than
        \\`type_kind` comparisons.
    );
    bullet(28, #string,oneline
        \\`Is_Numeric` is `Is_Integer(T) || Is_Float(T)` and therefore excludes
        \\complex types: `Is_Numeric(c128)` is `0`.
    );
    bullet(29, #string,oneline
        \\`Is_Addressable` is `Is_Pointer(T) || Is_Procedure(T)`, which is the
        \\predicate the pointer-equality instance is keyed on.
    );
    bullet(30, #string,oneline
        \\The checker answers these for the compile-time number kinds too:
        \\`Is_Integer(comptime_int)` is true, which is what lets `1 + 2` resolve
        \\against instances declared over `Is_Integer(T)`.
    );
    note(31, #string,oneline
        \\The predicates are capitalised. `is_integer(s32)` is `unknown function
        \\is_integer` with `help: did you mean 'Is_Integer'?`.
    );
    code_block(32, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Meta";
        \\
        \\describe :: (value: $T) -> string {
        \\    #if Is_Integer(T) return "an integer";
        \\    else #if Is_Float(T) return "a float";
        \\    else #if Is_String(T) return "a string";
        \\    else return "something else";
        \\}
        \\
        \\size_of_integer :: (#comptime Q: type) -> s64 where Is_Integer(Q) {
        \\    return size_of(Q);
        \\}
        \\
        \\main :: () {
        \\    print("% / % / % / %\n",
        \\        describe(1), describe(1.5), describe("hi"), describe(true));
        \\    print("u8 % s128 %\n", size_of_integer(u8), size_of_integer(s128));
        \\    print("Is_Numeric(c128) %\n", Is_Numeric(c128));
        \\}
    );
    code_block(33, "text", #string
        \\an integer / a float / a string / something else
        \\u8 1 s128 16
        \\Is_Numeric(c128) 0
    );
    paragraph(34, #string,oneline
        \\A parameter declared `Q: type` receives a type as its argument. For a
        \\`where` clause to see it, the parameter has to be a binder the signature
        \\already depends on or be marked `#comptime`, as above; a bare `Q: type`
        \\that appears nowhere else in the signature leaves the constraint
        \\unevaluated and every call fails with `constraint failed`. Compile-Time
        \\and Type-Only Parameters covers the distinction.
    );
    subheading(35, "Equality and switching");
    paragraph(36, #string,oneline
        \\`(type, type)` has a `PartialEq` instance, so `T == s32` is an ordinary
        \\comparison folded at compile time, and a `case` list of types is the
        \\natural way to branch on one. Equality is over the type value, which
        \\means spelling matters where the compiler keeps two names apart: `int`
        \\and `s64` are literally the same type value, while the bindgen spelling
        \\`int64_t` is a differently named type and compares unequal to both.
    );
    code_block(37, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Meta";
        \\
        \\width :: (Q: type) -> string {
        \\    if Q == {
        \\        case s8, u8;   return "one byte";
        \\        case s16, u16; return "two bytes";
        \\        case s32, u32; return "four bytes";
        \\        case s64, u64; return "eight bytes";
        \\    }
        \\    return "something else";
        \\}
        \\
        \\main :: () {
        \\    print("% / % / % / %\n", width(u8), width(s32), width(u64), width(f64));
        \\    print("int == s64 %  int == int64_t %  uint == u64 %\n",
        \\        int == s64, int == int64_t, uint == u64);
        \\    t := s32;
        \\    print("a type in a runtime local shows as %\n", t);
        \\}
    );
    code_block(38, "text", #string
        \\one byte / four bytes / eight bytes / something else
        \\int == s64 1  int == int64_t 0  uint == u64 1
        \\a type in a runtime local shows as s32
    );
    paragraph(39, #string,oneline
        \\A type value may be stored in a runtime local and shown, as the last
        \\line above does, but it cannot then be fed back to a compile-time
        \\intrinsic: `type_kind(t)` on such a local is `unknown const t`. For the
        \\same reason `type_of` has to fold before lowering; using its result
        \\where a runtime value is expected gives `#magic 'type_of' must not reach
        \\native LLVM lowering: type introspection query must be folded before
        \\native lowering`. Binding it to a constant first, as `X :: type_of(x);`,
        \\is the spelling that always works.
    );
}

render_section_30 :: () {
    paragraph(0, #string,oneline
        \\A written numeric literal does not have `int` or `f64`. It has one of
        \\three compile-time kinds whose exact value the checker knows and whose
        \\runtime type a context chooses: `comptime_int`, `comptime_float` and
        \\`comptime_complex`. Keeping the value exact until something concrete
        \\decides it is what makes `x: u8 = 200` and `x: s128 = 200` both mean the
        \\number two hundred rather than a widening of a 64-bit payload.
    );
    table_header(1, "Kind   —   Produced by   —   Defaults to");
    table_row(2, "`comptime_int`   |   an integer literal, and integer arithmetic over compile-time numbers   |   `int`");
    table_row(3, "`comptime_float`   |   a float literal, and arithmetic that mixes one in   |   `f64`");
    table_row(4, "`comptime_complex`   |   nothing, today   |   `c128`");
    paragraph(5, #string,oneline
        \\The three kinds have no source spelling. `x: comptime_int = 1;` is
        \\`unknown type 'comptime_int'`; the names exist so that a diagnostic can
        \\report an undecided value honestly, which is where a reader meets them.
        \\Annotating a declaration with a numeric constant rather than a type
        \\produces one: with `M :: 4;`, writing `m: M = .[1, 2, 3];` reports `got
        \\[3]comptime_int, expected comptime_int`. `comptime_complex` is currently
        \\unreachable, because there is no imaginary literal; `#I` is `unexpected
        \\directive 'I'`. A `#char` literal is a separate case and defaults to
        \\`u8`, not to `int`; `#char` Character Literals covers it.
    );
    subheading(6, "Defaulting");
    paragraph(7, #string,oneline
        \\When nothing decides a compile-time number, it takes its default. That
        \\happens at a `:=` binding, which has no annotation to consult, and at a
        \\generic parameter that binds the literal directly, so `describe(5)` on
        \\`describe :: (value: $T)` instantiates `T` as `int`. The defaults are the
        \\same widths a written literal has always taken, so adding the kinds
        \\changed how the rule is stated and not what programs mean.
    );
    code_block(8, "glosso", #string
        \\#import "Io";
        \\
        \\#import "Meta";
        \\
        \\main :: () {
        \\    a := 5;
        \\    b := 5.0;
        \\    c := 1 + 2;
        \\    A :: type_of(a); B :: type_of(b); C :: type_of(c);
        \\    print("5 -> % / 5.0 -> % / 1 + 2 -> % (%)\n",
        \\        type_name(A), type_name(B), type_name(C), c);
        \\    f: f64 = 5;
        \\    z: c128 = 3;
        \\    Z :: type_of(z);
        \\    print("f64 from an integer literal % ; c128 from one is %\n",
        \\        f, type_name(Z));
        \\}
    );
    code_block(9, "text", #string
        \\5 -> int / 5.0 -> f64 / 1 + 2 -> int (3)
        \\f64 from an integer literal 5 ; c128 from one is c128
    );
    paragraph(10, #string,oneline
        \\Arithmetic over two compile-time numbers stays compile-time and meets at
        \\the wider family: integer is narrower than float, which is narrower than
        \\complex. `+`, `-`, `*` and `/` keep the joined kind; `%`, `&`, `|`, `^`,
        \\`<<` and `>>` are integer-only, and `1.5 % 2.0` falls out of the
        \\compile-time rule and then fails as `no operator '%' for f64, f64`;
        \\comparisons produce `bool`. When one operand is concrete the concrete
        \\side decides outright, which is why `x + 1` on a `u8` is `u8` arithmetic
        \\and `f * 2.0` on an `f32` is `f32` arithmetic, with no promotion to the
        \\default width.
    );
    subheading(11, "Which types a compile-time number reaches");
    paragraph(12, #string,oneline
        \\A compile-time number may become any type in its own family or a wider
        \\one. The relation is one-directional and stops at `distinct` types,
        \\which convert in neither direction without a `cast`.
    );
    table_header(13, "Kind   —   Reaches");
    table_row(14, "`comptime_int`   |   any integer, any float, any complex");
    table_row(15, "`comptime_float`   |   any float, any complex");
    table_row(16, "`comptime_complex`   |   any complex");
    paragraph(17, #string,oneline
        \\This is a rule about literals, not about values. `f: f64 = 5;` compiles
        \\and a named `K :: 5; b: f64 = K;` compiles, because both are still
        \\compile-time integers. Once a value has a runtime type the families are
        \\sealed: `x: s64 = 5; y: f64 = x;` is `got int, expected f64`, and the
        \\reverse is `got f64, expected int`.
    );
    paragraph(18, #string,oneline
        \\Going the other way across the families is refused with the kind named:
        \\`x: s64 = 1.5;` is `cannot implicitly convert comptime_float to int` and
        \\`x: u8 = 1.0;` is `cannot implicitly convert comptime_float to u8`. A
        \\`distinct` target refuses a cross-family literal for the same reason:
        \\with `Meters :: distinct f64;`, `m: Meters = 3;` is `cannot implicitly
        \\convert comptime_int to Meters`. `cast` and `acast` covers the explicit
        \\spelling, and `distinct` Nominal Types covers the nominal rule.
    );
    subheading(19, "Joint defaulting across a call");
    paragraph(20, #string,oneline
        \\When several instances could take the same call because every argument
        \\is still undecided, the tie is broken by defaulting: the candidate whose
        \\parameter types are exactly what those arguments would default to wins.
        \\The rule fires only when a tie exists and only when some argument was
        \\undecided, so an already unambiguous call is untouched.
    );
    code_block(21, "glosso", #string
        \\#import "Io";
        \\
        \\Pairable :: typeclass (L: type, R: type) #minimal(pair_name) {
        \\    pair_name :: (a: L, b: R) -> string;
        \\}
        \\
        \\(int, int) :: instance Pairable {
        \\    pair_name :: (a: int, b: int) -> string { return "int, int"; }
        \\}
        \\(f64, f64) :: instance Pairable {
        \\    pair_name :: (a: f64, b: f64) -> string { return "f64, f64"; }
        \\}
        \\(f32, f32) :: instance Pairable {
        \\    pair_name :: (a: f32, b: f32) -> string { return "f32, f32"; }
        \\}
        \\
        \\main :: () {
        \\    print("(1, 2)     chose %\n", pair_name(1, 2));
        \\    print("(1.5, 2.5) chose %\n", pair_name(1.5, 2.5));
        \\}
    );
    code_block(22, "text", #string
        \\(1, 2)     chose int, int
        \\(1.5, 2.5) chose f64, f64
    );
    paragraph(23, #string,oneline
        \\All three instances accept `(1, 2)`, since a `comptime_int` reaches
        \\`int`, `f64` and `f32` alike; the joint default `(int, int)` picks one.
        \\The narrowing is joint and exact: adding `pair_name(1, 2.5)` to the
        \\program above is `ambiguous typeclass operation 'pair_name' for these
        \\argument types`, because the joint default is `(int, f64)` and no
        \\instance has that shape. Delete the `(f32, f32)` instance and the same
        \\call resolves to `(f64, f64)`, as the only remaining candidate every
        \\argument can reach.
    );
    subheading(24, "The value-fitting rule");
    paragraph(25, #string,oneline
        \\Reaching a type is a question about families; fitting it is a question
        \\about the value. At an integer context the checker asks whether the
        \\magnitude and sign the programmer wrote fit the target's range, and
        \\answers from the written syntax rather than from a wrapped payload. That
        \\is why a value at the exact edge of a type is accepted and one past it
        \\is a compile error rather than a runtime abort.
    );
    table_header(26, "Written   —   Result");
    table_row(27, "`x: s8 = -128;`   |   accepted; the sign folds into the literal, so no negation runs");
    table_row(28, "`x: s8 = -129;`   |   `-129 does not fit s8, whose range is -128..=127`");
    table_row(29, "`x: u8 = 300;`   |   `300 does not fit u8, whose range is 0..=255`");
    table_row(30, "`x: u8 = -1;`   |   `-1 does not fit u8, whose range is 0..=255`");
    table_row(31, "`x: u64 = 16#ffff_ffff_ffff_ffff;`   |   accepted; a based literal is a bit pattern");
    table_row(32, "`x: s8 = 16#1ff;`   |   `511 does not fit s8, whose range is -128..=127`");
    table_row(33, "`x: s8 = - ~127;`   |   `128 does not fit s8, whose range is -128..=127`");
    paragraph(34, #string,oneline
        \\A based literal is read as a bit pattern, so it may use every bit of the
        \\target width and `16#ffff_ffff_ffff_ffff` is `18446744073709551615` at
        \\`u64` and `-1` at `s64`. Over-wide ones say so: the `s8` row above
        \\carries `note: a based literal is a bit pattern, so it may use every bit
        \\of s8 - this one is wider than that`. A leading `-` drops the relaxation,
        \\because it means a magnitude again. `~` is re-evaluated at the target
        \\width, so `~127` is `-128` at `s8` and `128` at `u8`, and negating it at
        \\`s8` asks for `+128`, which does not fit.
    );
    code_block(35, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    mask: u64 = 16#ffff_ffff_ffff_ffff;
        \\    same: s64 = 16#ffff_ffff_ffff_ffff;
        \\    low:  s8  = -128;
        \\    all:  u8  = ~127;
        \\    print("% % % %\n", mask, same, low, all);
        \\}
    );
    code_block(36, "text", #string
        \\18446744073709551615 -1 -128 128
    );
    paragraph(37, #string,oneline
        \\The check recurses into the operands of integer arithmetic but does not
        \\fold the result: each written operand must fit, so `x: u8 = 255 + 0;`
        \\compiles and prints `255`, while `x: u8 = 300 + 0;` is rejected on the
        \\`300`. An expression whose operands each fit but whose result does not
        \\is a runtime question, and `x: u8 = 200 + 100;` compiles and aborts under
        \\the checked arithmetic of `-O0` and `-O1`. A shift count is exempted from
        \\this rule and judged against the shifted type's width instead.
    );
    note(38, #string,oneline
        \\The fitting check inspects literal, unary and binary nodes, so a name
        \\bound to an out-of-range compile-time integer slips past it. With
        \\`K :: 300;`, `x: u8 = K;` compiles and prints `44`, while the identical
        \\`x: u8 = 300;` is rejected. Writing the type on the constant restores the
        \\check by a different route: `K : int : 300;` makes `x: u8 = K;` report
        \\`got int, expected u8`.
    );
}

render_section_31 :: () {
    paragraph(0, #string,oneline
        \\Coercion is the conversion the compiler performs without being asked:
        \\at a declaration's initialiser, at an assignment, at a call argument, at
        \\a `return`, and at every aggregate-literal field. Glosso's default is
        \\strict. C's rule that any arithmetic type converts to any other is gone,
        \\because it silently truncates and silently reinterprets signs; what
        \\remains implicit is the set of conversions that cannot lose information.
        \\`cast` and `acast` is the explicit way to do the rest.
    );
    subheading(1, "The order the checker asks in");
    paragraph(2, #string,oneline
        \\`Checker::coercible` tries the rules below in order and stops at the
        \\first that accepts. The order matters at one point in particular: the
        \\`distinct` guard runs before every structural rule, so a nominal type
        \\never slips through the integer or pointer cases.
    );
    table_header(3, "Rule   —   Accepts");
    table_row(4, "`any` target   |   every source; the value is boxed");
    table_row(5, "`distinct` guard   |   nothing across a nominal boundary, in either direction");
    table_row(6, "structural equality   |   the same type, and `label` to `label`");
    table_row(7, "integer to integer   |   only a lossless widening, or anything under `lossy_numerics`");
    table_row(8, "function pointer to function pointer   |   matching calling convention, varargs and `noalias`, with every parameter and the return coercing");
    table_row(9, "compile-time number   |   a target its family reaches, if the value fits");
    table_row(10, "pointer-like into a niche optional   |   `*T` into `?*T`, and likewise for `[*]T` and `#fn_ptr`");
    table_row(11, "`null`   |   only a niche optional pointer, never a bare one");
    table_row(12, "slice to slice   |   the same element type with compatible `const` and `volatile`");
    table_row(13, "pointer to pointer   |   the same pointer kind, compatible pointees, never `const` to mutable");
    table_row(14, "string to many-pointer   |   `[*]const` of the code-unit type");
    paragraph(15, #string,oneline
        \\Everything else is rejected, and there are two shapes of message. A
        \\rejected assignment or return reports `got <actual>, expected
        \\<expected>`; a rejected argument reports `arg type <actual> != <expected>
        \\in call <name>`. A handful of cases have their own wording where the
        \\generic form would not say what to do instead.
    );
    subheading(16, "Lossless integer widening");
    paragraph(17, #string,oneline
        \\Integer to integer is accepted when no value of the source is
        \\unrepresentable in the target. Same signedness needs only a target at
        \\least as wide. An unsigned source reaching a signed target needs a
        \\strictly wider target, because the sign bit costs a bit. A signed source
        \\never reaches an unsigned target at any width, because negatives have
        \\nowhere to go.
    );
    table_header(18, "From   —   To   —   Implicit");
    table_row(19, "`u8`   |   `u16`, `s16`, `s64`, `int`   |   yes");
    table_row(20, "`s8`   |   `s16`   |   yes");
    table_row(21, "`u32`   |   `s64`   |   yes");
    table_row(22, "`u64`   |   `s128`, `u128`   |   yes");
    table_row(23, "`u64`   |   `s64`   |   no: `got u64, expected int`");
    table_row(24, "`s8`   |   `u16`   |   no: `got s8, expected u16`");
    table_row(25, "`u8`   |   `s8`   |   no: `got u8, expected s8`");
    table_row(26, "`s64`   |   `s8`   |   no: `got int, expected s8`");
    paragraph(27, #string,oneline
        \\The rule is asked of a width-and-signedness profile, and the C spellings
        \\bindgen emits carry the profile of the Glosso type they mirror, so
        \\`int64_t` widens into `int` and `s128` exactly as `s64` does. `int` and
        \\`s64` are one type value and both print as `int` in a diagnostic, so `got
        \\int, expected s8` can name either spelling. Relaxing Strictness with
        \\`lossy_numerics` covers the section-scoped gate that turns the whole
        \\integer rule off.
    );
    subheading(28, "Floats never convert");
    paragraph(29, #string,oneline
        \\No float type converts implicitly to any other, in either direction:
        \\`y: f64 = x;` on an `f32` is `got f32, expected f64`, and the narrowing
        \\is `got f64, expected f32`. Widening is arguably lossless, but making it
        \\implicit would make the narrowing look symmetrical, and a mixed-precision
        \\expression would silently pick a width. Cross-family conversion is
        \\likewise closed once a value has a runtime type: `y: f64 = x;` on an
        \\`s64` is `got int, expected f64`, and `y: s64 = x;` on an `f64` is `got
        \\f64, expected int`. `bool` participates in neither direction: `b: bool =
        \\1;` is `got int, expected bool` and `x: s64 = true;` is `got bool,
        \\expected int`.
    );
    note(30, #string,oneline
        \\`#enable(lossy_numerics)` does not change any of this. The gate is
        \\consulted only in the integer-to-integer branch, so both directions
        \\between float types stay errors under it.
    );
    subheading(31, "Pointers, slices, and optionals");
    paragraph(32, #string,oneline
        \\A pointer reaches a pointer of the same kind with a compatible pointee,
        \\and mutable reaches `const` but never the reverse. `*void` is the
        \\deliberate any-pointer spelling and matches every pointee. A pointer-like
        \\value reaches the matching niche optional for free, because the
        \\representations are identical; `null` reaches only such an optional, and
        \\a bare pointer excludes zero precisely so that the niche can put `.None`
        \\there.
    );
    code_block(33, "glosso", #string
        \\#import "Io";
        \\
        \\read_one   :: (p: *const s64) -> s64 { return p.*; }
        \\count_them :: (view: []const s64) -> s64 { return view.count; }
        \\maybe      :: (p: ?*s64) -> s64 {
        \\    if #pattern .Some(q) = p return q.*;
        \\    return -1;
        \\}
        \\
        \\main :: () {
        \\    v: s64 = 7;
        \\    print("mutable pointer at a const parameter %\n", read_one(*v));
        \\    print("pointer at an optional pointer %\n", maybe(*v));
        \\    print("null at an optional pointer %\n", maybe(null));
        \\    storage: [3]s64 = .[1, 2, 3];
        \\    print("mutable slice at a const slice %\n", count_them(storage[..]));
        \\}
    );
    code_block(34, "text", #string
        \\mutable pointer at a const parameter 7
        \\pointer at an optional pointer 7
        \\null at an optional pointer -1
        \\mutable slice at a const slice 3
    );
    paragraph(35, #string,oneline
        \\The rejections are as narrow as the acceptances. Dropping `const` is
        \\`arg type *const int != *int`; `*T` and `[*]T` describe different things,
        \\one element against a run of them, and do not interconvert, so passing a
        \\`*s64` where `[*]s64` is wanted is `arg type *int != [*]int`; a differing
        \\pointee is `arg type *int != *s32`. `p: *s64 = null;` is `'null' is not a
        \\value of *int`, with `note: a plain pointer excludes zero - write ?*int
        \\for a pointer that may be absent` and `note: its absent value is spelled
        \\'.None'`. `#enable(pointer_punning)`, described in Feature Gates, relaxes
        \\the pointer rules.
    );
    subheading(36, "Strings");
    paragraph(37, #string,oneline
        \\A `string` or `cstring` reaches `[*]const u8` and `[*]const s8`, and a
        \\`string16` or `cstring16` reaches `[*]const u16` and `[*]const s16`. The
        \\reverse never happens, because a pointer has no count. Built-in Strings
        \\gives the whole surface.
    );
    subheading(38, "Why a foldable constant still fits");
    paragraph(39, #string,oneline
        \\A constant whose value the compiler already knows narrows even where the
        \\type rule would refuse, provided the value fits. The reason is that
        \\`int`, `s64` and the type an undecided literal falls back to are one and
        \\the same, so a named constant arrives at the narrowing looking exactly
        \\like a declared `s64`; the difference that matters is not the type but
        \\whether the value is known. The compiler therefore probes: if the
        \\expression is safe to evaluate and folds to an integer in range, it is
        \\accepted.
    );
    code_block(40, "glosso", #string
        \\#import "Io";
        \\
        \\Limit : int : 100;
        \\
        \\main :: () {
        \\    narrow: u8 = Limit;
        \\    print("%\n", narrow);
        \\}
    );
    code_block(41, "text", #string
        \\100
    );
    paragraph(42, #string,oneline
        \\Both halves of the rule are load-bearing. A value that is not foldable
        \\gets nothing: `runtime: s64 = 100; narrow: u8 = runtime;` is `got int,
        \\expected u8`, because a local is not a constant the checker may
        \\evaluate. A foldable value out of range gets nothing either:
        \\`Limit : int : 300;` makes the same declaration `got int, expected u8`.
        \\A named type never narrows silently whatever its value, so this route is
        \\open only to the untyped default.
    );
}

render_section_32 :: () {
    paragraph(0, #string,oneline
        \\A cast is the explicit conversion. Everything Glosso converts on its
        \\own is described in the chapter on conversions; a cast is what the
        \\program writes when the conversion loses information, changes the
        \\interpretation of a bit pattern, or crosses a nominal boundary the
        \\checker will not cross silently.
    );
    paragraph(1, #string,oneline
        \\There are two spellings and they differ in exactly one respect: where
        \\the target type comes from. `cast(T)` writes the target down;
        \\`acast` takes the type the surrounding context expects. Both produce
        \\the same node in the checker, so every rule below applies to both.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\
        \\take_u8 :: (v: u8) -> u8 { return v; }
        \\Point   :: struct { x: u8; }
        \\to_f32  :: (v: int) -> f32 { return acast v; }
        \\
        \\main :: () {
        \\    big: int = 300;
        \\
        \\    a := cast(u8) big;          // prefix, explicit target
        \\    b := big.cast(u8);          // suffix, explicit target
        \\    c: u8 = acast big;          // prefix, contextual target
        \\    d: u8 = big.acast;          // suffix, contextual target
        \\
        \\    print("a % b % c % d %\n", a, b, c, d);
        \\
        \\    p: Point = .{ .x = acast big };
        \\    print("field %\n", p.x);
        \\    print("arg %\n", take_u8(acast big));
        \\    print("ret %\n", to_f32(7));
        \\}
    );
    code_block(3, "text", #string
        \\a 44 b 44 c 44 d 44
        \\field 44
        \\arg 44
        \\ret 7
    );
    table_header(4, "Form   —   Where the target type comes from");
    table_row(5, "`cast(T) expr`   |   the parentheses");
    table_row(6, "`expr.cast(T)`   |   the parentheses");
    table_row(7, "`acast expr`   |   the surrounding context");
    table_row(8, "`expr.acast`   |   the surrounding context");
    paragraph(9, #string,oneline
        \\The parentheses on `cast` are mandatory and the diagnostic points at
        \\the other form: `cast int 5` is
        \\`error: cast requires a type in parentheses; use acast for contextual
        \\casts`. `acast` is the mirror image and never takes a parenthesised
        \\type at all; `acast(f64) 3` is not a form, and the compiler reads it
        \\as an `acast` with no context followed by a parenthesised expression.
    );
    subheading(10, "Where `acast` finds a type");
    paragraph(11, #string,oneline
        \\`acast` resolves in any position that already carries an expected
        \\type. That is the same set of positions a literal is checked against,
        \\and it is a closed set.
    );
    bullet(12, "The initialiser of a declaration with a type annotation.");
    bullet(13, "The right side of a plain assignment to a typed place.");
    bullet(14, "An argument at a parameter with a declared type.");
    bullet(15, "A field of an aggregate literal at a known field type.");
    bullet(16, "A `return` in a procedure with a declared return type.");
    paragraph(17, #string,oneline
        \\Everywhere else there is nothing to read the target from, and the
        \\compiler says so rather than guessing: `a := acast 5`, an operand of
        \\a binary operator, and a variadic argument all produce
        \\`error: acast needs a target type from context or an explicit cast
        \\type`. In those positions `cast(T)` is the only spelling.
    );
    subheading(18, "What a cast accepts");
    paragraph(19, #string,oneline
        \\A cast is legal when the source and target are semantically the same
        \\type, or when they fall into one of the pairs below. The list is small
        \\on purpose: a cast reinterprets or converts a value, it does not
        \\restructure one, so there is no cast between aggregates and no cast
        \\that builds a `string`.
    );
    table_header(20, "Source   —   Target   —   What happens");
    table_row(21, "`Int`, `Float`, `bool`, `enum`   |   `Int`, `Float`, `bool`, `enum`   |   numeric conversion: truncate, extend, or round toward zero");
    table_row(22, "`*T`, `[*]T`, `#fn_ptr`, `null`   |   `*T`, `[*]T`, `#fn_ptr`   |   reinterpretation; no pointee check");
    table_row(23, "`*T`, `[*]T`, `#fn_ptr`   |   `Int` or `enum`   |   the address as a number");
    table_row(24, "`Int` or `enum`   |   `*T`, `[*]T`, `#fn_ptr`   |   the number as an address, asserted non-zero");
    table_row(25, "`Int`, `enum`, or a pointer   |   `?*T`, `?[*]T`   |   total; zero yields `.None`");
    table_row(26, "`[N]T`   |   `Simd(T, N)`, and back   |   exact shape only; the lane type and count must match");
    paragraph(27, #string,oneline
        \\Everything else is `cannot cast <source> to <target>`, with both
        \\types printed under their own names. `cast(int) s` on a `string` is
        \\`error: cannot cast string to int`; `cast(int) p` on a struct `P` is
        \\`error: cannot cast P to int`; `cast(any) 5` is
        \\`error: cannot cast int to any`, because boxing into `any` is an
        \\implicit conversion and not a cast. A fixed array casts only to a
        \\`Simd` of its exact shape, so `cast([2]f32) a` on a `[4]f32` is
        \\`error: cannot cast [4]f32 to [2]f32`.
    );
    subheading(28, "What a cast does that no implicit conversion will");
    code_block(29, "glosso", #string
        \\#import "Io";
        \\
        \\Color :: enum { Red; Green; Blue; }
        \\
        \\main :: () {
        \\    wide: u64 = 300;
        \\    f:    f64 = 3.9;
        \\    print("narrow      %\n", cast(s8) wide);
        \\    print("wrap neg    %\n", cast(u8) -1);
        \\    print("trunc f64   %\n", cast(int) f);
        \\    print("lit to f32  %\n", cast(f32) 7);
        \\    print("lit to u8   %\n", cast(u8) 300);
        \\    print("enum to int %\n", cast(int) Color.Green);
        \\    print("int to enum %\n", cast(Color) 2);
        \\    print("bool to int %\n", cast(int) true);
        \\    print("int to bool %\n", cast(bool) 5);
        \\    print("f64 to f32  %\n", cast(f32) f);
        \\}
    );
    code_block(30, "text", #string
        \\narrow      44
        \\wrap neg    255
        \\trunc f64   3
        \\lit to f32  7
        \\lit to u8   44
        \\enum to int 1
        \\int to enum 2
        \\bool to int 1
        \\int to bool 1
        \\f64 to f32  3.9
    );
    bullet(31, #string,oneline
        \\Narrowing truncates instead of erroring, and signedness is
        \\reinterpreted rather than rejected. `b: s8 = wide` on a `u64` is
        \\`error: got u64, expected s8`; `cast(s8) wide` keeps the low bits, and
        \\`cast(u8) -1` is `255`.
    );
    bullet(32, #string,oneline
        \\Float to integer truncates toward zero, and integer to float and
        \\`f64` to `f32` both convert. None of the three is implicit in either
        \\direction.
    );
    bullet(33, #string,oneline
        \\A compile-time number reaches any numeric target, ignoring both the
        \\family rule and the fitting check: `cast(u8) 300` is `44` where
        \\`x: u8 = 300` is `error: 300 does not fit u8, whose range is 0..=255`.
    );
    bullet(34, #string,oneline
        \\An `enum` crosses to and from its base integer in both directions, and
        \\a `distinct` type crosses to and from its representation in both
        \\directions. Nothing else in the language crosses both ways; the
        \\`distinct` case is covered in the chapter on `distinct` nominal types.
    );
    paragraph(35, #string,oneline
        \\A cast is also the one context that does not impose its type on its
        \\operand, which matters for literals wider than 64 bits. The lexer
        \\wraps a written magnitude into a 64-bit payload, and a plain widening
        \\would sign-extend it; a cast re-reads the literal at the target width
        \\instead, so `cast(u128) 340282366920938463463374607431768211455`
        \\prints the number that was written, while the same literal bound with
        \\`:=` is `error: 340282366920938463463374607431768211455 does not fit
        \\int, whose range is -9223372036854775808..=9223372036854775807`.
    );
    subheading(36, "`cast(*T)` asserts, `cast(?*T)` is total");
    paragraph(37, #string,oneline
        \\Every pointer flavour in Glosso excludes zero. That is what gives
        \\`?*T` a free niche, where `.None` is address 0: a zero `*T` would be
        \\indistinguishable from `.None`, and `.Some(p)` would match `.None`. A
        \\cast from an address integer to a bare pointer therefore asserts the
        \\address is not zero. When the compiler can already fold the address to
        \\zero, `cast(*T)` is a compile error rather than a value, and the
        \\diagnostic points at the spelling that is total.
    );
    code_block(38, "text", #string
        \\error: cast to *int of an address that is zero at compile time
        \\note: a plain pointer excludes zero - that is what gives ?T its niche, where .None IS address 0
        \\note: cast to ?*int instead, which is total and yields .None here
    );
    paragraph(39, #string,oneline
        \\An address that is not known until run time carries the assertion as a
        \\safety check instead. That check covers `*T`, `[*]T`, and `#fn_ptr`
        \\alike, because all three take the same niche; it reports the target
        \\type and aborts, and it is emitted at `-O0` and `-O1` only, like every
        \\other runtime check.
    );
    code_block(40, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    print("start\n");
        \\    p := cast([*]int) 0;
        \\    print("survived\n");
        \\}
    );
    code_block(41, "text", #string
        \\start
        \\cast to [*]int of an address that is zero
        \\glosso: program exited with status exit code: 134
    );
    paragraph(42, #string,oneline
        \\`cast(?*T) addr` is the same reinterpretation with the assertion
        \\dropped. It is total: zero becomes `.None`, anything else becomes
        \\`.Some`, and no check is emitted because no case is excluded.
    );
    code_block(43, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    x: int = 7;
        \\    addr := cast(u64) *x;
        \\
        \\    none := cast(?*int) 0;
        \\    if #pattern .Some(r) = none { print("some %\n", r.*); } else { print("none\n"); }
        \\
        \\    some := cast(?*int) addr;
        \\    if #pattern .Some(r) = some { print("some %\n", r.*); } else { print("none\n"); }
        \\}
    );
    code_block(44, "text", #string
        \\none
        \\some 7
    );
    note(45, #string,oneline
        \\The reverse direction is deliberately absent. `cast(*T) opt` on a
        \\`?*T` is `error: cannot cast Option__int to *int`, even though the
        \\niche layout would make it free. An optional already has a total
        \\spelling that the compiler verifies rather than asserts, so a cast
        \\that unwrapped one would be a second escape hatch with no gate and no
        \\check above `-O1`.
    );
}

render_section_33 :: () {
    paragraph(0, #string,oneline
        \\`distinct T` declares a type with the representation of `T` and an
        \\identity of its own. Nothing about the layout changes: the size, the
        \\alignment, and the machine operations are those of `T`. What changes
        \\is that the checker treats the two as unrelated, so a length cannot be
        \\assigned to a duration and a file handle cannot be added to a socket
        \\handle.
    );
    code_block(1, "glosso", #string
        \\Meters :: distinct f64 #derive(Add, Sub, Neg, PartialEq, PartialOrd, Mul(Meters, f64), Show);
        \\Feet   :: distinct f64;
        \\Count  :: distinct s64 #derive,all;
        \\Handle :: distinct u32;
    );
    paragraph(2, #string,oneline
        \\`distinct` is a contextual keyword. It is recognised only in type
        \\position directly after `::`, so it remains available as an ordinary
        \\identifier everywhere else.
    );
    code_block(3, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    distinct := 5;
        \\    print("identifier still works: %\n", distinct);
        \\}
    );
    code_block(4, "text", #string
        \\identifier still works: 5
    );
    subheading(5, "Representation and identity");
    paragraph(6, #string,oneline
        \\A distinct type carries the representation's kind and name untouched
        \\and adds a nominal tag. `size_of(Handle)` is `4` because `u32` is 4
        \\bytes, and `type_name(Handle)` is `Handle` because the tag is what
        \\names the type. The same tag is what diagnostics print, so a mismatch
        \\reads `got Meters, expected f64` rather than the useless
        \\`got f64, expected f64`.
    );
    paragraph(7, #string,oneline
        \\The representation may be any scalar, pointer, `bool`, or `enum`. It
        \\may not be a struct: `distinct P` over a struct `P` declares fine but
        \\has no way to construct a value, because `cast(Q) p` is
        \\`error: cannot cast P to Q`. The same is true of `distinct string`,
        \\which is therefore unusable in practice.
    );
    subheading(8, "Crossing the boundary");
    paragraph(9, #string,oneline
        \\There is no implicit conversion in either direction. This rule is
        \\checked before every other coercion rule, which is why it applies even
        \\where the representations are identical: `x: f64 = m` on a `Meters` is
        \\`error: got Meters, expected f64`, `f: Feet = m` is
        \\`error: got Meters, expected Feet`, and `c: Count = x` on an `s64` is
        \\`error: got int, expected Count`.
    );
    paragraph(10, #string,oneline
        \\A cast crosses in both directions, and a distinct type is the only
        \\thing in the language a cast will cross both ways.
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\
        \\Meters :: distinct f64 #derive(Add, PartialOrd);
        \\
        \\main :: () {
        \\    a: Meters = 3.0;
        \\    b: Meters = cast(Meters) 4.0;
        \\    print("a+b = % a<b = %\n", cast(f64)(a + b), a < b);
        \\}
    );
    code_block(12, "text", #string
        \\a+b = 7 a<b = 1
    );
    note(13, #string,oneline
        \\A literal of the representation's own family is stamped with the
        \\distinct type directly, so `a: Meters = 3.0` compiles without a cast.
        \\A literal of a different family is not: `m: Meters = 3` is
        \\`error: cannot implicitly convert comptime_int to Meters`. The rule
        \\that refuses a compile-time number at a distinct target runs after the
        \\one that stamps a matching literal kind, and the asymmetry is visible
        \\in nothing else.
    );
    subheading(14, "`#derive` and the operations a distinct type has");
    paragraph(15, #string,oneline
        \\A distinct type gets only the classes it names. Without a `#derive`
        \\it has no operators at all, and the diagnostic names the fix:
        \\`error: no operator '+' for Meters and Meters: a distinct type gets
        \\only the classes it derives; add '#derive(...)' or '#derive,all' on
        \\the declaration of 'Meters'`.
    );
    paragraph(16, #string,oneline
        \\This is the point of the feature rather than an inconvenience. A type
        \\that inherited everything from its representation would be a type
        \\alias with a different spelling; naming the classes is how a distinct
        \\type says which of the representation's operations are meaningful for
        \\it. Adding two lengths is meaningful, multiplying two lengths is not,
        \\and scaling a length by a plain number is.
    );
    table_header(17, "Spelling   —   Meaning");
    table_row(18, "`#derive(Add)`   |   the same-type instance: every operand and the result are the nominal type");
    table_row(19, "`#derive(Mul(Meters, f64))`   |   spells the operand types out where they differ");
    table_row(20, "`#derive(Add, Sub, PartialEq)`   |   a comma-separated list; the two forms mix freely");
    table_row(21, "`#derive,all`   |   every operator the representation has");
    table_row(22, "no `#derive`   |   no operators");
    paragraph(23, #string,oneline
        \\No code is generated. The operator is resolved on the representation
        \\and the nominal tag is put back when the representation's result is
        \\the representation, so `Meters + Meters` is `Meters` and
        \\`Meters * f64` is `Meters`, while `Meters == Meters` stays `bool` and
        \\`Meters <=> Meters` stays `Ordering`.
    );
    code_block(24, "glosso", #string
        \\#import "Io";
        \\
        \\Meters :: distinct f64 #derive(Mul(Meters, f64));
        \\Secs   :: distinct f64 #derive,all;
        \\
        \\main :: () {
        \\    m: Meters = 3.0;
        \\    scale: f64 = 2.0;
        \\    out: Meters = m * scale;         // Mul(Meters, f64); result is Meters
        \\    print("scaled = %\n", cast(f64) out);
        \\
        \\    s: Secs = 7.0;
        \\    t: Secs = 2.0;
        \\    print("s/t = % s<t = %\n", cast(f64)(s / t), s < t);
        \\}
    );
    code_block(25, "text", #string
        \\scaled = 6
        \\s/t = 3.5 s<t = 0
    );
    paragraph(26, #string,oneline
        \\Each entry grants exactly what it names and nothing adjacent.
        \\`#derive(Mul(Meters, f64))` does not give `Meters * Meters`, and
        \\`#derive(Add)` does not give `Meters + f64`; both are the same
        \\`no operator` error. `#derive,all` waves every operator through, but
        \\the operation still has to exist on the representation:
        \\`s % t` on a `distinct f64` with `#derive,all` falls through to
        \\`error: no operator '%' for f64, f64`.
    );
    paragraph(27, #string,oneline
        \\Two spellings are rejected outright. `#derive` with neither a list nor
        \\a mode is `error: '#derive' on a distinct type needs a class list or
        \\',all'`, and any other mode is
        \\`error: unknown '#derive' mode 'every'; the only one is 'all'`.
    );
    note(28, #string,oneline
        \\The derive list gates operators only. A named typeclass method still
        \\resolves through the ordinary generic instances, because the
        \\representation's predicate is still true of the distinct type:
        \\`Is_Float(Meters)` holds, so `show(a)` on a `Meters :: distinct f64`
        \\with no `#derive` at all prints `3.5`.
    );
}

render_section_34 :: () {
    paragraph(0, #string,oneline
        \\Glosso converts between numeric types implicitly only when the
        \\conversion cannot lose anything: an integer widens to a type that can
        \\hold every one of its values, and nothing else. Floats never convert
        \\implicitly in either direction, and neither does `bool`.
        \\`#enable(lossy_numerics)` relaxes exactly one clause of that rule.
    );
    paragraph(1, #string,oneline
        \\Under the gate, any integer type coerces to any other integer type.
        \\Narrowing truncates and a signedness change reinterprets the bits,
        \\both silently, at every position where a coercion happens: assignment,
        \\argument passing, and `return`.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\
        \\#enable(lossy_numerics);
        \\
        \\truncating :: (a: u64) -> s8  { return a; }   // narrowing, implicit
        \\resign     :: (a: s64) -> u64 { return a; }   // reinterpreted sign
        \\
        \\#disable(lossy_numerics);
        \\
        \\main :: () {
        \\    print("truncating(300) = %\n", truncating(300));
        \\    print("resign(-1)      = %\n", resign(-1));
        \\}
    );
    code_block(3, "text", #string
        \\truncating(300) = 44
        \\resign(-1)      = 18446744073709551615
    );
    subheading(4, "Section scoping");
    paragraph(5, #string,oneline
        \\`#enable` and `#disable` are parser directives, not statements. They
        \\may appear only between top-level declarations, and the gate is
        \\stamped on every declaration parsed while it is on. Writing
        \\`#enable(lossy_numerics)` inside a procedure body is
        \\`error: unexpected directive 'enable'`.
    );
    paragraph(6, #string,oneline
        \\The stamp is per declaration and covers the whole of it, body
        \\included. A declaration after the matching `#disable` is unaffected:
        \\in the fragment below `inside` compiles and `outside` is
        \\`error: got u64, expected s8`.
    );
    code_block(7, "glosso", #string
        \\#enable(lossy_numerics);
        \\inside  :: (a: u64) -> s8 { return a; }
        \\#disable(lossy_numerics);
        \\outside :: (a: u64) -> s8 { return a; }
    );
    paragraph(8, #string,oneline
        \\Because the gate belongs to the declaration that performs the
        \\coercion, it does not travel with a procedure to its call sites. A
        \\`takes :: (v: s8)` declared under the gate does not accept a `u64`
        \\argument from an ungated caller: the call is
        \\`error: arg type u64 != s8 in call takes`. The parser state also ends
        \\with the file, so the gate never reaches a `#load`ed or `#import`ed
        \\source.
    );
    subheading(9, "What the gate does not restore");
    paragraph(10, #string,oneline
        \\The gate is consulted in one branch of one function: the integer to
        \\integer case of the coercion rule. Every other rejection stands, and
        \\each of the following still fails with the gate on.
    );
    table_header(11, "Written under the gate   —   Diagnostic");
    table_row(12, "`narrow :: (a: f64) -> f32 { return a; }`   |   `error: got f64, expected f32`");
    table_row(13, "`widen :: (a: f32) -> f64 { return a; }`   |   `error: got f32, expected f64`");
    table_row(14, "`f :: (a: f64) -> int { return a; }`   |   `error: got f64, expected int`");
    table_row(15, "`g :: (a: int) -> f64 { return a; }`   |   `error: got int, expected f64`");
    table_row(16, "`f :: (a: bool) -> int { return a; }`   |   `error: got bool, expected int`");
    table_row(17, "`f :: (a: Meters) -> f64 { return a; }`   |   `error: got Meters, expected f64`");
    table_row(18, "`x: u8 = 300;`   |   `error: 300 does not fit u8, whose range is 0..=255`");
    paragraph(19, #string,oneline
        \\Two of those are worth spelling out. The distinct-type rule runs
        \\before the numeric rules and is not a numeric rule at all, so no gate
        \\reaches it; `cast` remains the only bridge. And the fitting check on a
        \\written literal is a question about the literal, not about a
        \\conversion, so it survives too: the gate makes a `u64` variable
        \\narrow to `u8`, it does not make `300` fit in one.
    );
    paragraph(20, #string,oneline
        \\The gate also does not touch operator resolution. Every primitive
        \\operator instance is homogeneous, keyed on `($T, T)`, and mixed
        \\operand widths are an instance-selection failure rather than a
        \\coercion failure. With the gate on, `a + b` for `a: u8` and `b: u16`
        \\is still `error: no operator '+' for u8, u16`.
    );
    note(21, #string,oneline
        \\Feature names are checked: `#enable(lossy_stuff)` is
        \\`error: unknown feature 'lossy_stuff'`. The siblings of this gate are
        \\`pointer_punning` and `allow_union_unwrap`, described in the chapter
        \\on feature gates.
    );
    subheading(22, "Why the default is strict");
    paragraph(23, #string,oneline
        \\C's conversion rules are the reason integer bugs are hard to see: the
        \\truncation and the sign flip look exactly like the code that does not
        \\convert at all. Making them explicit costs a `cast` at each site and
        \\buys three things.
    );
    bullet(24, #string,oneline
        \\Every place a value can change is written down, so a narrowing is
        \\found by reading rather than by running.
    );
    bullet(25, #string,oneline
        \\A diagnostic can name both types, which is only useful when the
        \\program did not ask for the conversion. `got u64, expected int` is a
        \\question about intent; a silent truncation is not.
    );
    bullet(26, #string,oneline
        \\Overflow checking has something to check. The runtime checks
        \\described in the chapter on overflow assume a value's type is the
        \\type the program chose for it, which is false as soon as widths
        \\convert on their own.
    );
    paragraph(27, #string,oneline
        \\`lossy_numerics` exists for the code where that trade is wrong:
        \\hand-translated C, a hash or checksum written in terms of deliberate
        \\truncation, or a block of bit manipulation where every line would
        \\otherwise carry a cast. Bracketing such a block with `#enable` and
        \\`#disable` keeps the relaxation visible and bounded, which a
        \\command-line flag would not.
    );
}

render_section_35 :: () {
    paragraph(0, #string,oneline
        \\Signed and unsigned integer overflow is a checked failure in Glosso,
        \\not wraparound and not undefined behaviour. The check is emitted by
        \\the backend, so whether it is present is a property of the build, and
        \\the property is exactly the optimisation level.
    );
    paragraph(1, #string,oneline
        \\Runtime checks are on when the optimisation level is 0 or 1. `-O1` is
        \\the default, so a plain `glosso --run bump.glo` is a checked build;
        \\the line the driver prints names the level it used.
    );
    code_block(2, "text", #string
        \\glosso: link bump.exe (target=x86_64-pc-windows-msvc, -O1)
    );
    table_header(3, "Flag   —   Level   —   Runtime checks");
    table_row(4, "`-O0`   |   0   |   on");
    table_row(5, "`-O1` (default)   |   1   |   on");
    table_row(6, "`-O2`   |   2   |   off");
    table_row(7, "`-O3`   |   3   |   off");
    table_row(8, "`-Os`   |   2, small   |   off");
    table_row(9, "`-Oz`   |   3, very small   |   off");
    table_row(10, "`-Ozz`   |   3, tiny   |   off");
    paragraph(11, #string,oneline
        \\The three size levels are not a separate axis: `-Os` is level 2 with a
        \\size preference and `-Oz` and `-Ozz` are level 3 with stronger ones.
        \\They therefore turn the checks off as well, which is worth knowing
        \\before shipping a size-optimised build. Levels outside `0..=3` are
        \\rejected by the driver: `-O4` is `glosso: unknown option -O4`.
    );
    subheading(12, "What is checked");
    paragraph(13, #string,oneline
        \\The arithmetic check covers `+`, `-`, and `*` on integers, and unary
        \\`-`, which is lowered as a checked `0 - x`. Each is emitted as an
        \\LLVM overflow intrinsic in the operand's own signedness, and the
        \\overflow bit branches to an abort.
    );
    code_block(14, "glosso", #string
        \\#import "Io";
        \\
        \\bump :: (v: s8) -> s8 { return v + 1; }
        \\
        \\main :: () {
        \\    print("before\n");
        \\    print("after: %\n", bump(127));
        \\}
    );
    code_block(15, "text", #string
        \\$ glosso --run bump.glo
        \\glosso: compile bump.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link bump.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done bump.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\before
        \\glosso: program exited with status exit code: 134
        \\
        \\$ glosso --run -O2 bump.glo
        \\glosso: compile bump.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link bump.exe (target=x86_64-pc-windows-msvc, -O2)
        \\glosso: done bump.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O2)
        \\before
        \\after: -128
    );
    paragraph(16, #string,oneline
        \\The same flag gates three other checks, so an unchecked build drops
        \\all four together.
    );
    table_header(17, "Check   —   Failure at `-O0` or `-O1`");
    table_row(18, "`+` `-` `*` and unary `-` on integers   |   silent abort");
    table_row(19, "array and view indexing   |   silent abort");
    table_row(20, "`cast` of a runtime-zero address to a pointer   |   `cast to *int of an address that is zero`, then abort");
    table_row(21, "union payload access under `#enable(allow_union_unwrap)`   |   `union access: expected .Square, but the value holds one of .Circle | .Square`, then abort");
    paragraph(22, #string,oneline
        \\The first two print nothing at all. The abort carries no message, no
        \\source location, and no stack trace, and the only evidence is the exit
        \\status. That is the single most useful thing to know when a program
        \\stops partway through with no output of its own.
    );
    subheading(23, "What is not checked");
    paragraph(24, #string,oneline
        \\Integer division and remainder are not checked at any level. The
        \\hardware traps instead, and the process dies with a status the
        \\operating system chose rather than the one the runtime uses. On
        \\`x86_64-pc-windows-msvc`, `-128 / -1` at `s8` and `-128 % -1` both
        \\exit with `0xc0000095`, and `1 / 0` at `s32` exits with `0xc0000094`,
        \\at every optimisation level.
    );
    bullet(25, #string,oneline
        \\The wrapping operators `+%`, `-%`, `*%`, and prefix `-%` are never
        \\checked; wrapping is what they mean.
    );
    bullet(26, #string,oneline
        \\The saturating operators `+|`, `-|`, `*|`, and `<<|` are never
        \\checked; clamping is what they mean.
    );
    bullet(27, #string,oneline
        \\Shifts are not checked at run time. A shift by the operand's width or
        \\more has no defined result, and where the compiler can see a written
        \\literal count it rejects that instead:
        \\`error: shift count 8 is not less than the 8 bits of u8`, with
        \\`note: a shift by the width or more has no defined result`.
    );
    bullet(28, #string,oneline
        \\Float arithmetic is never checked. IEEE 754 produces an infinity or a
        \\NaN and the program continues.
    );
    bullet(29, #string,oneline
        \\A many-pointer index carries no length, so it cannot be bounds
        \\checked at any level.
    );
    subheading(30, "Compile-time arithmetic does not trap");
    paragraph(31, #string,oneline
        \\The constant evaluator and the compile-time VM wrap. They implement
        \\the integer operations directly rather than through the backend, and
        \\the overflow branch lives only in the backend. Identical code
        \\therefore produces a value at compile time and an abort at run time.
    );
    code_block(32, "glosso", #string
        \\#import "Io";
        \\
        \\compute :: () -> u8 { a: u8 = 200; b: u8 = 100; return a + b; }
        \\
        \\K :: #comptime compute();
        \\
        \\main :: () {
        \\    print("compile time: %\n", K);
        \\    print("run time:     %\n", compute());
        \\}
    );
    code_block(33, "text", #string
        \\compile time: 44
        \\glosso: program exited with status exit code: 134
    );
    note(34, #string,oneline
        \\The abort status is the same one an array-bounds failure produces, so
        \\`134` on its own does not identify which check fired. Rebuilding at
        \\`-O2` distinguishes them quickly: if the program then runs to
        \\completion with a wrapped or garbage value, the failure was a checked
        \\operation rather than a hardware trap.
    );
}

render_section_36 :: () {
    paragraph(0, #string,oneline
        \\Binary operator precedence in Glosso is an integer from 0 to 20.
        \\Higher binds tighter. The scale is deliberately sparse: odd and unused
        \\tiers are left free so a library can introduce an operator that lands
        \\between two existing families without renumbering anything.
    );
    paragraph(1, #string,oneline
        \\A level is not a property of a spelling the compiler knows in advance.
        \\It comes from the `#operator` directive on the typeclass method that
        \\declares the operator, and the prescan reads every visible
        \\declaration before parsing begins. That mechanism is described in the
        \\chapter on the operator prescan; this chapter is the table it
        \\produces for the prelude, and the rules a new entry must follow.
    );
    table_header(2, "Level   —   Operators   —   Owning classes");
    table_row(3, "0   |   `=` and every compound form: `+=` `-=` `*=` `/=` `%=` `&=` `|=` `^=` `<<=` `>>=` `&&=` `||=` `+%=` `-%=` `*%=` `+|=` `-|=` `*|=` `<<|=`   |   the `*Assign` classes");
    table_row(4, "2   |   `..` `..=`   |   `RangeExclusiveOp`, `RangeInclusiveOp`");
    table_row(5, "4   |   `||`   |   `LogicalOr`");
    table_row(6, "6   |   `&&`   |   `LogicalAnd`");
    table_row(7, "8   |   `==` `!=`   |   `PartialEq`");
    table_row(8, "10   |   `<` `<=` `>` `>=` `<=>`   |   `PartialOrd`");
    table_row(9, "12   |   `|`   |   `BitOr`");
    table_row(10, "13   |   `^`   |   `BitXor`");
    table_row(11, "14   |   `&`   |   `BitAnd`");
    table_row(12, "16   |   `<<` `>>` `<<|`   |   `ShiftLeft`, `ShiftRight`, `SaturatingShiftLeft`");
    table_row(13, "17   |   `+` `-` `+%` `-%` `+|` `-|`   |   `Add`, `Sub`, `WrapAdd`, `WrapSub`, `SaturatingAdd`, `SaturatingSub`");
    table_row(14, "18   |   `*` `/` `%` `*%` `*|`   |   `Mul`, `Div`, `Rem`, `WrapMul`, `SaturatingMul`");
    table_row(15, "19   |   unoccupied   |   reserved for exponentiation-class user operators");
    table_row(16, "20   |   unoccupied   |   type formers");
    paragraph(17, #string,oneline
        \\Tiers 1, 3, 5, 7, 9, 11, and 15 are unoccupied as well. The prelude
        \\uses twelve of the twenty-one levels, and a user-declared operator may
        \\claim any level from 0 to 1000; the top of that range binds
        \\tighter than everything in the table.
    );
    paragraph(18, #string,oneline
        \\Unary operators have no tier. A prefix operator binds tighter than
        \\every infix operator, and a suffix operator binds to the primary
        \\expression it follows, so `-a + b` is `(-a) + b` and `~a & b` is
        \\`(~a) & b`.
    );
    subheading(19, "Bitwise binds tighter than comparison");
    paragraph(20, #string,oneline
        \\This is the one place the table departs from C. In C, and in Glosso
        \\before the rescale, `&` `^` `|` sit below the comparisons, so
        \\`flags & MASK == 0` parses as `flags & (MASK == 0)`. That grouping has
        \\been a standing source of bugs since it was chosen; Rust and Go both
        \\corrected it and the 0-20 table does the same. Relative order is
        \\preserved everywhere else.
    );
    code_block(21, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    flags: s64 = 6;
        \\    mask:  s64 = 4;
        \\    print("flags & mask == 4  -> %\n", (flags & mask) == 4);
        \\    print("1 | 2 ^ 3 & 6      -> %\n", 1 | 2 ^ 3 & 6);
        \\    print("1 << 2 + 3         -> %\n", 1 << 2 + 3);
        \\    print("2 * 3 + 4          -> %\n", 2 * 3 + 4);
        \\    print("true || false && false -> %\n", true || false && false);
        \\}
    );
    code_block(22, "text", #string
        \\flags & mask == 4  -> 1
        \\1 | 2 ^ 3 & 6      -> 1
        \\1 << 2 + 3         -> 32
        \\2 * 3 + 4          -> 10
        \\true || false && false -> 1
    );
    paragraph(23, #string,oneline
        \\Because exactly one family moved, the expressions whose meaning
        \\changed are exactly those that mix the two families without
        \\parentheses, and the source does not say which reading its author
        \\meant. The compiler lints them.
    );
    code_block(24, "text", #string
        \\warning: this expression changes meaning under the 0-20 precedence
        \\  table: bitwise operators now bind tighter than comparisons
        \\note: add parentheses to say which reading you mean
    );
    paragraph(25, #string,oneline
        \\The lint fires when an unparenthesised bitwise expression is an
        \\operand of a comparison, or an unparenthesised comparison is an
        \\operand of a bitwise operator, and in no other case. `flags & mask ==
        \\4` and `a < b & c` both warn; `(a & b) == 4` does not, and neither
        \\does `a & b | c`, where both operators belong to the same family.
        \\Adding the parentheses is what silences it, and the parenthesised form
        \\reads the same under either table.
    );
    subheading(26, "Associativity");
    paragraph(27, #string,oneline
        \\Every binary operator declares its associativity alongside its level.
        \\Every entry in the table above is declared `left` except the
        \\assignment tier, which uses the `assign` mode and groups to the right.
        \\Two operators that share a level but disagree on associativity cannot
        \\be mixed without parentheses, and the parse fails rather than picking
        \\one: `error: operators '**' and '~>' both have precedence 19 but
        \\different associativity, so '** ~>' is ambiguous; add parentheses`.
    );
    subheading(28, "How a user-declared operator takes a level");
    paragraph(29, #string,oneline
        \\The level is written on the class method, in the `#operator`
        \\directive, as `#operator(mode, level)`. The instance that implements
        \\the operator does not repeat the level; the class has already
        \\registered it, and an instance may omit the directive entirely for a
        \\binary operator.
    );
    code_block(30, "glosso", #string
        \\#import "Io";
        \\
        \\Pow :: typeclass (L: type, R: type) {
        \\    Output :: type;
        \\    '**' :: (a: L, b: R) -> Output #operator(right, 19);
        \\}
        \\Chain :: typeclass (L: type, R: type) {
        \\    Output :: type;
        \\    '~>' :: (a: L, b: R) -> Output #operator(left, 19);
        \\}
        \\
        \\(s64, s64) :: instance Pow {
        \\    Output :: s64;
        \\    '**' :: (a: s64, b: s64) -> s64 {
        \\        r: s64 = 1;
        \\        i: s64 = 0;
        \\        while i < b { r = r * a; i = i + 1; }
        \\        return r;
        \\    }
        \\}
        \\(s64, s64) :: instance Chain {
        \\    Output :: s64;
        \\    '~>' :: (a: s64, b: s64) -> s64 { return a * 10 + b; }
        \\}
        \\
        \\main :: () {
        \\    print("2 ** 3 ** 2 = %\n", 2 ** 3 ** 2);
        \\    print("1 ~> 2 ~> 3 = %\n", 1 ~> 2 ~> 3);
        \\    print("2 ** 3 * 2  = %\n", 2 ** 3 * 2);
        \\}
    );
    code_block(31, "text", #string
        \\2 ** 3 ** 2 = 512
        \\1 ~> 2 ~> 3 = 123
        \\2 ** 3 * 2  = 16
    );
    paragraph(32, #string,oneline
        \\`#precedence(mode, level)` is an accepted synonym of `#operator` for
        \\the binary and assignment modes. It rejects the unary modes, since
        \\they have no level to declare: `#precedence(prefix)` is
        \\`error: #precedence expects left, right, or assign`.
    );
    table_header(33, "Mistake   —   Diagnostic");
    table_row(34, "a binary operator with no level anywhere   |   `error: binary operator '<+>' needs #operator(left|right|assign, n)`");
    table_row(35, "a level outside 0 to 1000   |   `error: operator precedence level must be between 0 and 1000`");
    table_row(36, "a level on `prefix` or `suffix`   |   `error: unexpected token ','`");
    table_row(37, "a mode that is not one of the five   |   `error: #operator expects left, right, prefix, suffix, or assign`");
    table_row(38, "a second class claiming an owned spelling   |   `error: operator '+' is already owned by typeclass 'Add'`");
    paragraph(39, #string,oneline
        \\The remaining rules about operator declaration, including which
        \\spellings are reserved and how ownership is keyed by name, arity, and
        \\fixity, belong to the chapter on the operator system.
    );
}
