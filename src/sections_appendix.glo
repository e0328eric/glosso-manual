#import "Format";
#import "String_Builder";
#import "Math/Core";
#import "clay_ui.glo";

#public {

// Chapters 92-97: Appendices.

render_section_92 :: () {
    paragraph(
        0,
        #string,oneline
            \\When a build finds a problem, the compiler reports it on standard
            \\error as a diagnostic: a level, a message, the place in the source,
            \\and often notes that explain or suggest. Errors stop the build;
            \\warnings do not. This appendix describes the layout of a diagnostic
            \\and how the compiler places errors that arise in generic code, in
            \\the standard library and in generated source, together with the
            \\messages of the driver and the linker and the use of color. Appendix
            \\B: Error Message Index lists the messages themselves. This is the
            \\smallest error:
    );
    code_block(
        1,
        "text",
        #string
            \\error: got str, expected s32
            \\  --> main.glo:2:18
            \\  |
            \\2 |     count: s32 = "three";
            \\  |                  ^^^^^^^
    );
    subheading(2, "The parts of a diagnostic");
    table_header(3, "Line   —   Content");
    table_row(4, "Message   |   The level, `error` or `warning`, a colon and the message.");
    table_row(5, "Location   |   `-->` and the file, line and column, separated by colons.");
    table_row(6, "Margin   |   An empty line of the left margin.");
    table_row(7, "Excerpt   |   The line number, `|`, and the source line as written.");
    table_row(8, "Carets   |   `^` under the span the message is about.");
    paragraph(
        9,
        #string,oneline
            \\The file is printed as an absolute path, whatever path was given on
            \\the command line, so that terminals and editors can open the
            \\location directly; the examples in this manual shorten it to
            \\`main.glo`. Lines and columns count from 1, and a column counts
            \\Unicode characters, not bytes. In the excerpt a tab is shown as four
            \\spaces, and the carets are placed by the width each character takes
            \\on a terminal, so they stay under the text after wide characters such
            \\as Hangul. The margin is as wide as the line number.
    );
    subheading(10, "Notes and help");
    paragraph(
        11,
        #string,oneline
            \\Lines labelled `note:` follow the message and give context: another
            \\place involved in the error, or the reason behind it. A note may have
            \\a location and an excerpt of its own or be a single line. A `help:`
            \\line suggests a fix.
    );
    code_block(
        12,
        "text",
        #string
            \\error: 'total' is already declared in this scope
            \\  --> main.glo:3:5
            \\  |
            \\3 |     total := 2;
            \\  |     ^^^^^
            \\note: first declared here
            \\  --> main.glo:2:5
            \\  |
            \\2 |     total := 1;
            \\  |     ^^^^^
    );
    code_block(
        13,
        "text",
        #string
            \\error: unbound 'countr'
            \\  --> main.glo:5:19
            \\  |
            \\5 |     print("{}\n", countr);
            \\  |                   ^^^^^^
            \\help: did you mean 'counter'?
    );
    subheading(14, "Several errors in one build");
    paragraph(
        15,
        #string,oneline
            \\The compiler does not stop at the first error. A syntax error ends
            \\the parse of its top-level declaration, and parsing resumes at the
            \\next one. Type checking reports at most one error for each
            \\procedure, the first it finds, and goes on with the other procedures.
            \\When there is more than one error, a last line counts them. A build
            \\with errors writes no artifact and exits with status 1.
    );
    code_block(
        16,
        "text",
        #string
            \\error: unexpected token ';'
            \\  --> main.glo:2:15
            \\  |
            \\2 |     return 1 +;
            \\  |               ^
            \\
            \\error: got str, expected s32
            \\  --> main.glo:6:12
            \\  |
            \\6 |     return "two";
            \\  |            ^^^^^
            \\
            \\error: got str, expected s32
            \\   --> main.glo:10:12
            \\   |
            \\10 |     return "three";
            \\   |            ^^^^^^^
            \\
            \\error: aborting due to 3 previous errors
    );
    paragraph(
        17,
        #string,oneline
            \\An error can cause others. A declaration that does not parse is not
            \\declared at all, so its uses fail too. Here the array literal in
            \\`pick` is misspelled, and the call of `pick` reports an unknown
            \\function; fixing the first error removes the second.
    );
    code_block(
        18,
        "text",
        #string
            \\error: unexpected token '.['
            \\  --> main.glo:2:18
            \\  |
            \\2 |     values := s64.[1, 2, 3];
            \\  |                  ^^
            \\
            \\error: unknown function pick
            \\  --> main.glo:7:14
            \\  |
            \\7 |     value := pick(1);
            \\  |              ^^^^
            \\
            \\error: aborting due to 2 previous errors
    );
    subheading(19, "Warnings");
    paragraph(
        20,
        #string,oneline
            \\A warning has the same form with the level `warning`. The build goes
            \\on, and the program is linked and, with `--run`, started.
    );
    code_block(
        21,
        "text",
        #string
            \\$ glosso compile --run main.glo
            \\glosso: compile main.glo (target=x86_64-pc-linux-gnu)
            \\warning: unreachable pattern - already covered by an earlier case
            \\  --> main.glo:7:10
            \\  |
            \\7 |     case .Err(_); return 1;
            \\  |          ^
            \\glosso: link main (target=x86_64-pc-linux-gnu, -O1)
            \\glosso: done main  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
            \\5
    );
    paragraph(
        22,
        #string,oneline
            \\The type checker gives four warnings:
    );
    table_header(23, "Warning   —   Given for");
    table_row(
        24,
        "`unreachable pattern - already covered by an earlier case`   |   A `case` of a switch that earlier cases already cover; see Coverage, Binding Forms, and Pattern Constants."
    );
    table_row(
        25,
        "`range pattern is empty and matches no value`   |   A range pattern such as `5..=1`; see `#pattern` Matching and Pattern Forms."
    );
    table_row(
        26,
        #string,oneline
            \\`this expression changes meaning under the 0-20 precedence table:
            \\bitwise operators now bind tighter than comparisons`   |   A bitwise
            \\operator next to a comparison without parentheses, as in `flags & 4
            \\== 4`, with the note `add parentheses to say which reading you mean`;
            \\see Precedence Levels and Associativity.
    );
    table_row(
        27,
        #string,oneline
            \\`no '>' for <T>: the where-clause only provides Num`   |   A generic
            \\body that uses an operation its `where` clause does not provide, with
            \\the note `reported at the definition; add the class to the 'where'
            \\clause`. It is given even if the procedure is never called; see
            \\Generic Procedures and `where` Clauses.
    );
    paragraph(
        28,
        #string,oneline
            \\There is no option to silence warnings or to turn them into errors.
            \\A build restored from the artifact cache prints the warnings of the
            \\build that produced it again (see Inside a Build: Stages and Caches).
            \\Besides these, the driver prints a single line starting with
            \\`glosso: warning:` for a problem of its own that does not stop the
            \\build, such as a cache directory that cannot be written.
    );
    subheading(29, "Errors in generic code");
    paragraph(
        30,
        #string,oneline
            \\The body of a generic procedure is checked for each set of types it
            \\is used with (see Generic Procedures and `where` Clauses). When the
            \\check fails for one of them, the error is reported in the body, and
            \\a note `in instantiation of` points at the use that asked for those
            \\types:
    );
    code_block(
        31,
        "text",
        #string
            \\error: no operator '+' for bool, bool
            \\  --> main.glo:2:14
            \\  |
            \\2 |     return x + x;
            \\  |              ^
            \\note: in instantiation of 'double'
            \\  --> main.glo:6:13
            \\  |
            \\6 |     flag := double(true);
            \\  |             ^^^^^^
    );
    subheading(32, "Errors raised in the standard library");
    paragraph(
        33,
        #string,oneline
            \\Many library procedures check their arguments at compile time, with
            \\`#compile_error` in a generic body or a macro (see `#if`, `#assert`,
            \\and `#compile_error`). When such a check fails, the error is placed
            \\at the program's own call, where the mistake is, and a note keeps the
            \\place in the library that raised it. Here `print` has a placeholder
            \\and no argument for it:
    );
    code_block(
        34,
        "text",
        #string
            \\error: format has more '{}' placeholders than arguments
            \\  --> main.glo:4:5
            \\  |
            \\4 |     print("value: {}\n");
            \\  |     ^^^^^
            \\note: raised here, in standard library code, during instantiation of 'print'
            \\    --> std/Format.glo:214:17
            \\    |
            \\214 |                 #compile_error "format has more '{}' placeholders than arguments";
            \\    |                 ^^^^^^^^^^^^^^
    );
    paragraph(
        35,
        #string,oneline
            \\When the library call is inside a generic procedure of the program,
            \\the error is placed at that call, and a further note names the use
            \\of the program's procedure:
    );
    code_block(
        36,
        "text",
        #string
            \\error: format has more '{}' placeholders than arguments
            \\  --> main.glo:4:5
            \\  |
            \\4 |     print("{} {}\n", value);
            \\  |     ^^^^^
            \\note: raised here, in standard library code, during instantiation of 'print'
            \\    --> std/Format.glo:214:17
            \\    |
            \\214 |                 #compile_error "format has more '{}' placeholders than arguments";
            \\    |                 ^^^^^^^^^^^^^^
            \\note: in instantiation of 'report'
            \\  --> main.glo:8:5
            \\  |
            \\8 |     report(1);
            \\  |     ^^^^^^
    );
    subheading(37, "Errors in generated source");
    paragraph(
        38,
        #string,oneline
            \\Source text produced by `#insert` (see `#code`, `#insert`, and
            \\`#expand`) has no file of its own in the program, so an error in it
            \\is placed at the `#insert`. The note `generated source failed here`
            \\points into the copy of the text that the compiler saved in its
            \\cache, where the exact line can be read. When generated text itself
            \\contains an `#insert`, a note `generated by this #insert` marks each
            \\level in between. Inside a Build: Stages and Caches describes the
            \\saved files.
    );
    code_block(
        39,
        "text",
        #string
            \\// #insert "broken :: () -> s32 { return 1 }\n";
            \\error: top-level #insert generated invalid source: parse error line 1: unexpected token '}'
            \\  --> main.glo:1:1
            \\  |
            \\1 | #insert "broken :: () -> s32 { return 1 }\n";
            \\  | ^^^^^^^
            \\note: generated source failed here
            \\  --> ~/.cache/glosso/generated/insert/v1/7a2dd3d88c3a255b26d3a669eb743e5ece8d65887ce3755b09d5ddd157328d44.glo:1:32
            \\  |
            \\1 | broken :: () -> s32 { return 1 }
            \\  |                                ^
    );
    subheading(40, "Messages from the driver and the linker");
    paragraph(
        41,
        #string,oneline
            \\Problems found before compiling starts, such as an unknown option or
            \\an unreadable file, are single lines that begin with `glosso:`. A
            \\problem with the command line exits with status 2, and an unknown
            \\option is followed by the usage summary. When the link fails, the
            \\linker's own messages follow `error:`, without a source location.
            \\Appendix E: Environment, Toolchain, and Exit Codes lists the exit
            \\statuses, and Compiler Options and Output Kinds the options.
    );
    code_block(
        42,
        "text",
        #string
            \\$ glosso compile --color sometimes main.glo
            \\glosso: --color must be auto, always, or never
            \\$ glosso compile missing.glo
            \\glosso: cannot read missing.glo: No such file or directory (os error 2)
            \\$ glosso compile --target x86_64-freestanding hello.glo
            \\glosso: compile hello.glo (target=x86_64-unknown-none-elf)
            \\glosso: link hello (target=x86_64-unknown-none-elf, -O1)
            \\error: ld.lld: error: undefined symbol: write
    );
    subheading(43, "Color");
    paragraph(
        44,
        #string,oneline
            \\`--color auto`, the default, colors diagnostics when standard error
            \\is a terminal and `TERM` is set to something other than `dumb` (on
            \\Windows, whenever standard error is a console). `--color always`
            \\colors them even into a pipe or a file, and `--color never` turns
            \\color off, together with the progress display. The environment
            \\variable `NO_COLOR`, set to any value including the empty string,
            \\turns color off and wins over `--color always`.
    );
    table_header(45, "Part   —   Color");
    table_row(46, "`error` and the carets under its excerpt   |   Bold red.");
    table_row(47, "`warning` and the carets under its excerpt   |   Bold yellow.");
    table_row(48, "`note`, `help`, and the carets under their excerpts   |   Bold cyan.");
    table_row(49, "The message text   |   Bold.");
    table_row(50, "`-->`, the margin and the line numbers   |   Bold blue.");
    paragraph(
        51,
        #string,oneline
            \\Messages written by `#compile_error` and `#assert` are ordinary
            \\errors in this format (see `#if`, `#assert`, and `#compile_error`).
            \\A failed check in a running program is reported differently, as one
            \\line from the program itself (see Feature Gates and Runtime Checks).
    );
}

render_section_93 :: () {
    paragraph(
        0,
        #string,oneline
            \\This appendix lists the compiler's common error messages by area, in
            \\the order of the reference chapters. Each entry gives what usually
            \\causes the message, what to do about it, and the chapter with the
            \\full rule. The messages are quoted as the compiler prints them for a
            \\small example; the names, types and numbers in quotes change with
            \\the program. Appendix A: Diagnostic Format describes the layout of a
            \\diagnostic. The compiler reports every error it finds before it
            \\stops, so one build can show several. This program has two mistakes:
    );
    code_block(
        1,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\scale :: (x: s32) -> s32 {
            \\    return x * factor;
            \\}
            \\
            \\main :: () {
            \\    count: u8 = 300;
            \\    print("{}\n", scale(count));
            \\}
    );
    code_block(
        2,
        "text",
        #string
            \\error: unbound 'factor'
            \\  --> main.glo:4:16
            \\  |
            \\4 |     return x * factor;
            \\  |                ^^^^^^
            \\
            \\error: 300 does not fit u8, whose range is 0..=255
            \\  --> main.glo:8:17
            \\  |
            \\8 |     count: u8 = 300;
            \\  |                 ^^^
            \\
            \\error: aborting due to 2 previous errors
    );
    paragraph(
        3,
        #string,oneline
            \\Each message is followed by its location and an excerpt, then by
            \\notes, which add context and may point elsewhere, and help lines,
            \\which suggest a fix. A build with errors writes no artifact and exits
            \\with status 1. Errors raised inside the standard library on behalf
            \\of a call, such as a format string that does not fit its arguments,
            \\are reported at the call with the note `raised here, in standard
            \\library code, during instantiation of 'print'`. Warnings, which do
            \\not stop the build, are listed near the end.
    );
    subheading(4, "Parsing");
    paragraph(
        5,
        #string,oneline
            \\The parser reports the first token it cannot use. That token is
            \\often one past the real mistake: a missing `;` is reported at the
            \\first token of the next line. Appendix C: Grammar gives the syntax.
    );
    table_header(6, "Message   —   Usual cause   —   Fix");
    table_row(
        7,
        "`unexpected token 'y'`   |   A missing `;` before `y`, or syntax from another language: `x++`, `c ? a : b`, `var x`, `switch`   |   Add the `;`. Use `x += 1`, `ifx`, `x := ...` and `if x == { ... }`; see Statements and Conditional Expressions."
    );
    table_row(
        8,
        "`expected '}'`, with the note `this '{' is never closed`   |   A block without its closing brace   |   The note points at the `{` that is open."
    );
    table_row(
        9,
        "`bad decl name '}'`   |   Something at the top level that cannot start a declaration: an extra `}`, or a statement directive such as `#assert` outside a procedure   |   Remove the brace, or move the directive into a procedure or a `#comptime { }` block; see `#if`, `#assert`, and `#compile_error`."
    );
    table_row(
        10,
        "`declaration must end with ';'`   |   A top-level declaration without its `;`, such as `X :: 1`   |   Add the `;`; see Appendix C: Grammar."
    );
    table_row(
        11,
        "`expected a declaration, found ';'`, with `help: a declaration whose body is braced ends at its '}', and is not followed by a semicolon; remove it`   |   `f :: () {};` or `P :: struct { ... };`   |   Remove the `;`; see Appendix C: Grammar."
    );
    table_row(
        12,
        "`a top-level constant binding uses '::'; the second ':' is missing`   |   `P : struct { ... }`   |   Write `::`; see Constants, Variables, and Globals."
    );
    table_row(
        13,
        "`unterminated string literal`   |   A string literal without its closing quote; a literal may span lines, so this is noticed at the end of the file and reported at the opening quote   |   Close the literal there; see Text and Character Literals."
    );
    table_row(
        14,
        "`struct member 'x' must end with ';'`   |   Struct fields separated by commas   |   End each field with `;`; see Struct Types."
    );
    table_row(
        15,
        "`unexpected directive 'foo'`   |   A misspelled or unknown directive   |   Identifiers, Reserved Words, and Directives lists the directives."
    );
    table_row(
        16,
        #string,oneline
            \\`unexpected token '=-'; no operator '=-' is declared, and adjacent
            \\operator characters form one token - write '= -' with
            \\spaces`   |   Two operators written together   |   Separate them with
            \\a space; see Encoding, Comments, and Tokens.
    );
    table_row(
        17,
        "`legacy '0x' integer literals are not supported; use '16#digits'`   |   C-style hexadecimal   |   Write `16#1F`; see Number Literals."
    );
    table_row(
        18,
        "`float literal '5.' needs a digit after the '.'; write '5.0'`   |   A float literal ending in a dot   |   Add the digit; see Number Literals."
    );
    table_row(
        19,
        "`variadic parameter uses '...T'; '..' is the range operator`   |   A variadic parameter written with two dots   |   Write `args: ...T`; see Variadic Procedures."
    );
    table_row(
        20,
        "`cast requires a type in parentheses; use acast for contextual casts`   |   `cast` without `(T)`, or `cast` used as a name   |   Write `cast(T) x`, or `acast x` when the target type is known from context; see Literal Typing and Type Conversion."
    );
    subheading(21, "Names, modules, and imports");
    table_header(22, "Message   —   Usual cause   —   Fix");
    table_row(
        23,
        "`unbound 'x'`   |   A value name with no declaration in scope, or used above its declaration in the block   |   Declare it first. A `help: did you mean 'count'?` line names a close spelling. See Assignment, Blocks, and Name Lookup."
    );
    table_row(
        24,
        "`unknown function frobnicate`   |   A call of a name that no procedure has   |   Check the spelling (`help: did you mean 'print'?`) and the imports; see Modules, Imports, and the Prelude."
    );
    table_row(
        25,
        "`unknown type 'string'`   |   A type name that is not declared; the string type is `str`   |   See Catalog of Built-in Types."
    );
    table_row(
        26,
        #string,oneline
            \\`unknown identifier File`, with the note `'File' is not available
            \\through this module's imports; import its module directly, or include
            \\it in the import selector`   |   The name exists in a loaded module
            \\that this file does not import (imports do not chain)   |   Import the
            \\declaring module, here `File_System/File`; see Modules, Imports, and
            \\the Prelude.
    );
    table_row(
        27,
        #string,oneline
            \\`cannot find module "Nope" (searched: /usr/local/glosso/std)`   |   A
            \\module name found in neither the standard library nor a
            \\`--module-path` directory, or a directory without
            \\`module.glo`   |   Check the spelling; see Appendix D: Standard
            \\Library Modules.
    );
    table_row(
        28,
        #string,oneline
            \\`#import: cannot find source file "missing.glo" (looked for
            \\/home/ana/app/missing.glo)`   |   A file import whose path does not
            \\exist; it is relative to the importing file   |   Fix the path. A
            \\second error, `cannot find module "missing.glo"`, follows. See
            \\Modules, Imports, and the Prelude.
    );
    table_row(
        29,
        #string,oneline
            \\`#import names unknown public declaration 'square' in module
            \\"geometry.glo"`   |   An import list names something the module does not
            \\export; a note lists its public names   |   Remove the name, or make it
            \\`#public` in the module; see Modules, Imports, and the Prelude.
    );
    table_row(
        30,
        "`ambiguous imported name 'describe'`   |   Two imported modules export the name   |   Import one under an alias (`A :: #import \"a.glo\";`) or with an import list; see Modules, Imports, and the Prelude."
    );
    table_row(
        31,
        "`'x' is already declared in this scope`, with the note `first declared here`   |   A second `x :=` in the same block   |   Assign with `=`, rename, or declare it in an inner block; see Assignment, Blocks, and Name Lookup."
    );
    table_row(
        32,
        "`function 'f' is already declared`   |   Two procedures with one name in a module; procedures are not overloaded by parameter types   |   Rename one, or make the operation a typeclass method; see Procedure Declarations and Arguments."
    );
    table_row(
        33,
        "`'s32' is a variable, not a type`   |   A local variable named like a type hides the type   |   Rename the variable; see Identifiers, Reserved Words, and Directives."
    );
    table_row(
        34,
        "`no field 'z' in 'P'`   |   A field or method that `P` does not have   |   Check the struct, its inherent block and the imports that declare methods; see Inherent Methods, Member Access, and Call Syntax."
    );
    table_row(
        35,
        "`enum Color has no variant 'Blue'`   |   A misspelled or missing enum member   |   Check the declaration; see `enum` and `enum_flags`."
    );
    subheading(36, "Visibility");
    table_header(37, "Message   —   Usual cause   —   Fix");
    table_row(
        38,
        "`unknown function square`, with the note `'square' is private to its defining source and module`   |   A declaration of another module without `#public`   |   Mark it `#public`; see Who Can Use a Declaration: Visibility and Units."
    );
    table_row(
        39,
        "`'balance' is private to its defining source and module`, with the note `declared here`   |   A `#private` field or a private method used from another module   |   Use the type's public procedures; see Who Can Use a Declaration: Visibility and Units."
    );
    table_row(
        40,
        "`interface exposes less-visible type 'Hidden'`   |   A public procedure whose signature names a private type   |   Make the type at least as visible as the procedure."
    );
    table_row(
        41,
        "`visibility directives are not allowed on local statements or declarations`   |   `#public` inside a procedure   |   Visibility applies to top-level declarations only."
    );
    table_row(
        42,
        "`'s32' is a builtin type name; a public declaration cannot reuse it`   |   A public type named like a built-in type   |   Rename it, or keep it private or `#public,unit`."
    );
    subheading(43, "Types and conversions");
    paragraph(
        44,
        #string,oneline
            \\Glosso converts implicitly only where no information can be lost and
            \\the meaning is clear (see Literal Typing and Type Conversion). Most
            \\of these messages ask for an explicit `cast`.
    );
    table_header(45, "Message   —   Usual cause   —   Fix");
    table_row(
        46,
        "`got str, expected s32`   |   A value of another type in an initializer, a `return` or an annotated declaration; also `got s64, expected s32` and `got f32, expected f64` between sizes   |   Convert with `cast(s32)`, or change the declared type; see Literal Typing and Type Conversion."
    );
    table_row(
        47,
        "`assign str to ssize`   |   An assignment to a variable whose type was fixed by its first value   |   Declare the variable with the type it needs; see Assignment, Blocks, and Name Lookup."
    );
    table_row(
        48,
        "`arg type str != s32 in call f`   |   An argument of the wrong type   |   Convert the argument or call another procedure; see Procedure Declarations and Arguments."
    );
    table_row(
        49,
        #string,oneline
            \\`no overload 'f' accepts these arguments`, with the note `possible
            \\candidates for 'f':` and a `candidate:` line per signature   |   Too
            \\many or too few arguments, or a named argument the procedure does not
            \\have   |   Compare the call with the candidates; see Procedure
            \\Declarations and Arguments.
    );
    table_row(
        50,
        "`300 does not fit u8, whose range is 0..=255`   |   A constant outside the range of its type, also `-1` for an unsigned type   |   Use a wider type, or convert a run-time value with `cast`; see Literal Typing and Type Conversion."
    );
    table_row(
        51,
        "`no operator '+' for s32, u32`   |   Operands of different types; also a type that has no instance of the operator's class, as in `no operator '+' for P, P`   |   Convert one operand, or declare the instance; see Operator Declarations."
    );
    table_row(
        52,
        "`cannot cast P to s32`   |   A `cast` between types with no conversion   |   See Literal Typing and Type Conversion."
    );
    table_row(
        53,
        "`cannot call value of type ssize`   |   Call syntax on a value that is not a procedure   |   Check the name: a local variable may hide a procedure; see Assignment, Blocks, and Name Lookup."
    );
    table_row(
        54,
        "`cannot assign to constant 'X'`   |   Assignment to a `::` constant   |   Declare it with `:=`; see Constants, Variables, and Globals."
    );
    table_row(
        55,
        "`constant cannot be modified`, with `help: change '::' to ':=' to make the binding mutable`   |   A compound assignment such as `+=` to a constant   |   As the help says."
    );
    table_row(
        56,
        "`left side of assignment is not assignable`   |   Writing through a `*const T`, into a `[]const T` view, or into a `str`   |   Use a mutable pointer or view, or copy the data; see Assignment, Blocks, and Name Lookup."
    );
    table_row(
        57,
        "`got ?s32, expected s32`   |   An optional used where its value is needed   |   Unwrap it with a pattern, `?` or `unwrap_or`; see `?T` and `E!T`."
    );
    table_row(
        58,
        #string,oneline
            \\`'null' is not a value of *s32`, with the note `a plain pointer
            \\excludes zero - write ?*s32 for a pointer that may be
            \\absent`   |   `null` given to a pointer type   |   Use `?*s32`; see
            \\Pointer Types.
    );
    table_row(
        59,
        "`operator '.*' expects a typed pointer, got ssize`   |   Dereferencing a value that is not a pointer, or an optional pointer that has not been unwrapped   |   Check the type; unwrap a `?*T` first. See Pointer Types."
    );
    table_row(
        60,
        "`cannot take a pointer to a non-addressable expression: 'Call'`   |   `.&` or `&` of a call result or another temporary   |   Store the value in a variable first; see Pointer Types."
    );
    table_row(
        61,
        "`cannot infer a type for null; add a type annotation`   |   `x := null;`   |   Write `x: ?*T = null;`; see Constants, Variables, and Globals."
    );
    table_row(
        62,
        "`struct literal needs a type`, `enum shorthand needs an enum context`   |   `.{ ... }` or `.Red` where no type is expected   |   Write the type: `P.{ ... }`, `Color.Red`, or annotate the variable; see Aggregate Literal Syntax."
    );
    table_row(
        63,
        "`no field 'z' in struct literal for P`, `field 'x' is initialized more than once`   |   A wrong or repeated field name; more positional values than fields give `no field ''`   |   Check the struct's fields; see Aggregate Literal Syntax."
    );
    table_row(
        64,
        "`destructuring binds 3 names from a 2-value result`   |   More or fewer names than the procedure returns   |   Match the count; use `_` for values to drop. See Tuple Types."
    );
    table_row(
        65,
        #string,oneline
            \\`struct 'Node' contains itself by value (Node.next -> Node), so its
            \\size would be infinite; refer to it through a pointer, slice or
            \\dynamic array instead`   |   A recursive struct   |   Make the field
            \\`?*Node`; see Struct Types.
    );
    table_row(
        66,
        "`the built-in option type is written '?T'; its values are '?x' and 'null'`   |   `Option(T)` written as a type; `Result(...)` gets the same message for `E!T`   |   Write `?T` or `E!T`; see `?T` and `E!T`."
    );
    table_row(
        67,
        "`'f64' is not iterable; it needs an Iterable instance`   |   `for` over a value that is not a collection or range   |   See Iteration: Cursors and `for_expansion`."
    );
    table_row(
        68,
        "`array count 'n' is not compile-time known`   |   `[n]T` with a run-time `n`   |   Use a constant, or a dynamic array `[..]T`; see Arrays, Views, Dynamic Arrays, and Slicing."
    );
    paragraph(
        69,
        #string,oneline
            \\Two messages of this area quote code themselves. The first is
            \\explained in `?T` and `E!T`, the second in What a Program Is:
    );
    code_block(
        70,
        "text",
        #string
            \\// x: ?s32 = .None;
            \\error: use `null` for an empty `?T`
            \\// main :: () {}  missing from the root file
            \\error: program has no `main` function
    );
    subheading(71, "Control flow, switches, and patterns");
    table_header(72, "Message   —   Usual cause   —   Fix");
    table_row(
        73,
        "`cannot decide a value: an 'ifx' needs an 'else' arm`   |   An `ifx` expression without `else`   |   Add `else`, or use the switch form; see Statements and Conditional Expressions."
    );
    table_row(
        74,
        "`unexpected token 'print'` after `case 1`   |   A case label without its `;`   |   Write `case 1; print(...);`; see Switch Statements."
    );
    table_row(
        75,
        "`break outside loop`, `continue outside loop`   |   `break` or `continue` with no loop around it   |   See `while`, `for`, and Unrolled Loops."
    );
    table_row(
        76,
        #string,oneline
            \\`non-exhaustive switch`, with the notes `missing case: Color.Blue` and
            \\`cover them, or add 'else' or '#partial'`   |   A switch that leaves
            \\values out; `missing case: _` for `str` and float subjects   |   Add the
            \\cases or `else;`; see Coverage, Binding Forms, and Pattern Constants.
    );
    table_row(
        77,
        "`tagged-union payload '.Code' may only be bound by a pattern match`   |   Reading a union variant like a field   |   Match the variant: `case .Code(c);`; see Tagged and Untagged Unions."
    );
    table_row(
        78,
        "`'Nope' is not a variant of union Token`   |   A case that names no variant   |   Check the union; see Tagged and Untagged Unions."
    );
    code_block(
        79,
        "text",
        #string
            \\// f :: () -> s32 { defer return 1; return 2; }
            \\error: `return` cannot leave a deferred statement
    );
    subheading(80, "Procedures and program entry");
    table_header(81, "Message   —   Usual cause   —   Fix");
    table_row(
        82,
        "`main must not take parameters; use get_cmdline_args() for command-line arguments`   |   `main :: (args: ...)`   |   As the message says; see What a Program Is."
    );
    table_row(
        83,
        "`function 'f' can reach the end of its body without returning a value`   |   A path through a procedure with a return type ends without `return`   |   Return on every path, or end with a call to a `#Never` procedure such as `exit`; see Procedure Declarations and Arguments."
    );
    table_row(
        84,
        "`empty return in function returning s32`   |   `return;` in a procedure that returns a value   |   Return a value; see Procedure Declarations and Arguments."
    );
    table_row(
        85,
        "`discarded return value of #must function 'checked'`   |   Calling a `#must` procedure as a statement   |   Use the value, or write `_ := checked(...);`; see Directives That Modify Procedures."
    );
    table_row(
        86,
        "`lambda captures local 'limit', but captured closures are not supported`   |   A lambda reads a local variable of the enclosing procedure   |   Pass the value as a parameter; see Lambdas and `#fn_ptr` Values."
    );
    subheading(87, "Typeclasses and instances");
    table_header(88, "Message   —   Usual cause   —   Fix");
    table_row(
        89,
        "`instance 'Sq :: Shape' does not satisfy the implicit minimal definition; missing name`   |   An instance without a method that the class requires   |   Define the method; see Typeclass Declarations and Instances."
    );
    table_row(
        90,
        #string,oneline
            \\`instance 'Sq :: Shape' does not satisfy the implicit minimal
            \\definition; missing area; area is defined, but its signature does not
            \\match the typeclass`   |   A method whose parameter or return types
            \\differ from the class   |   Two notes show both signatures.
    );
    table_row(
        91,
        "`function 'perimeter' has no owning typeclass`   |   An instance body declares a method the class does not have   |   Move it to an inherent block `Sq ::: { ... }`; see Inherent Methods, Member Access, and Call Syntax."
    );
    table_row(
        92,
        "`duplicate instance head 'Sq' for 'Shape' with identical where constraints`   |   Two instances of one class for one type   |   Keep one; see Instance Resolution and Negative Instances."
    );
    table_row(
        93,
        "`unknown typeclass 'Shapez'`   |   An instance of a class that is not declared or not imported   |   Check the spelling and imports; see Typeclass Declarations and Instances."
    );
    table_row(
        94,
        "`constraint failed for total`   |   A call whose arguments do not meet the procedure's `where` clause; the same for `spawn_owned` with data that is not `Send`   |   See Generic Procedures and `where` Clauses and `Send`, `Sync`, and Shared Data."
    );
    table_row(
        95,
        "`postfix '?' requires a Try-returning function or an enclosing #try block`   |   `?` in a procedure that returns a plain value   |   Return `?T` or `E!T`, or use `#try { }`; see `Try`, `?`, `#try`, and `Termination`."
    );
    table_row(
        96,
        "`postfix '?' operand type ssize does not implement Try`   |   `?` after a value that is neither optional nor a result   |   Remove the `?`."
    );
    table_row(
        97,
        "`no overload '?' accepts these arguments`, with the note `constraint failed for ?`   |   `?` on a result whose error type differs from the procedure's, or on an optional inside a result   |   Add `Propagate` or `#from`; see `Try`, `?`, `#try`, and `Termination`."
    );
    table_row(
        98,
        "`main return type bool does not implement Termination`   |   `main` returns a type with no exit status   |   Return an integer or `E!void`; see `Try`, `?`, `#try`, and `Termination`."
    );
    table_row(
        99,
        "`no typeclass method 'free' accepts this receiver and these arguments`   |   `free` on a value that owns nothing   |   Do not free it; see `Freeable`, Copies, and Ownership Transfer."
    );
    table_row(
        100,
        "`no Formatter instance for selector '' and value type P`   |   `{}` in a format string for a type without `Show`   |   Add `#derive(Show)` to the type or write an instance; see `Show`, `Formatter`, `FromString`, and Format Strings."
    );
    code_block(
        101,
        "text",
        #string
            \\// take_show :: (args: ...Show) {}   take_show(Foo.{1});
            \\error: variadic arg type `Foo` does not implement `Show` in call `take_show`
    );
    subheading(102, "Format strings");
    paragraph(
        103,
        #string,oneline
            \\A format string is checked against its arguments while compiling,
            \\inside the `Format` module, so these errors carry the note `raised
            \\here, in standard library code, during instantiation of 'print'`.
            \\`Show`, `Formatter`, `FromString`, and Format Strings describes the syntax.
    );
    table_header(104, "Message   —   Usual cause   —   Fix");
    table_row(
        105,
        "`format has more '{}' placeholders than arguments`, `format has fewer '{}' placeholders than arguments`   |   Placeholders and arguments do not match   |   Count them."
    );
    table_row(
        106,
        "`unterminated or nested formatter selector`   |   A `{` with no `}`   |   Write `{{` for a literal brace."
    );
    table_row(
        107,
        "`no Formatter instance for selector 'q' and value type ssize`   |   An unknown selector inside `{...}`   |   Use a selector the type supports."
    );
    subheading(108, "Constants and compile time");
    table_header(109, "Message   —   Usual cause   —   Fix");
    table_row(
        110,
        "`unknown const x`   |   A run-time variable read by `#comptime`, `#if`, a `type` parameter or another compile-time context   |   Use a constant, or decide at run time with `if`; see Compile-Time Evaluation."
    );
    table_row(
        111,
        #string,oneline
            \\`argument for #comptime parameter 'fmt' must be known at compile
            \\time`   |   A run-time value for a compile-time parameter, such as a
            \\format string in a variable   |   Pass a literal or a constant; see
            \\`noalias`, `#lazy`, `#comptime`, and Type Parameters.
    );
    table_row(
        112,
        #string,oneline
            \\`global 'G' is a runtime variable, so its value is not a compile-time
            \\constant`   |   A global variable used where a constant is needed,
            \\such as another global's initializer; in a module-level `#if` the
            \\message starts with `module #if condition must be a compile-time
            \\bool:`   |   Declare it with `::`; see Constants, Variables, and
            \\Globals.
    );
    table_row(
        113,
        "`assertion failed: arithmetic is broken`   |   An `#assert` whose condition is false at compile time; the text is the assertion's message   |   See `#if`, `#assert`, and `#compile_error`."
    );
    table_row(
        114,
        "`#assert message must be a compile-time string`   |   A message computed from run-time values   |   Use constants only."
    );
    table_row(
        115,
        "`#assert #comptime condition is not compile-time evaluable`   |   An `#assert #comptime` whose condition reads a run-time value   |   Drop `#comptime` to allow a run-time check, or assert a constant."
    );
    table_row(
        116,
        "`'c_rand' is foreign, so its result is not compile-time known`   |   A constant computed by calling a `#foreign` procedure; in a top-level `#comptime` block the message is `#comptime stopped: VM cannot call foreign/undeclared function 'c_rand'`   |   Compute the value at run time; see Compile-Time Evaluation."
    );
    table_row(
        117,
        "`compile-time constants cannot hold owner values; create a scoped local and free it`   |   A constant whose value is a dynamic array or another owner   |   Free the owner inside the computation and return a plain value; see Compile-Time Evaluation."
    );
    table_row(
        118,
        "`constant division by zero`   |   A constant expression divides by zero   |   Fix the expression; see Integer Arithmetic, Overflow, and Traps."
    );
    table_row(
        119,
        "`constant index is out of range`   |   Compile-time code indexes outside an array; compile-time code is always checked   |   Fix the index; see Feature Gates and Runtime Checks."
    );
    table_row(
        120,
        #string,oneline
            \\`constant evaluation exceeded GLOSSO_COMPTIME_STEP_LIMIT; set 0 for no
            \\limit`; in a top-level `#comptime` block, `#comptime stopped:
            \\compile-time evaluation did not finish within ... VM
            \\instructions`   |   A compile-time loop that does not end, or a
            \\very long computation   |   Fix the loop, or raise the limit; see
            \\Build Scripts and Compile-Time Arguments.
    );
    table_row(
        121,
        "`VM constant evaluation: call stack exhausted: more than 65536 nested calls`   |   Unbounded recursion in compile-time code   |   Add a base case; see Build Scripts and Compile-Time Arguments."
    );
    table_row(
        122,
        "`a 'Code' value is compile-time only; bind it with '::' rather than ':='`   |   A `#code` quote stored in a variable   |   Bind it with `::`; see `#code`, `#insert`, and `#expand`."
    );
    table_row(
        123,
        "`#insert expects Code or string source`; `top-level #insert expects Code or string source`; `expression #insert expects Code`   |   An `#insert` operand of another type, or text where an expression is expected   |   See `#code`, `#insert`, and `#expand`."
    );
    table_row(
        124,
        "`macro expansion depth exceeded while expanding 'countdown' (limit 128)`   |   A macro that expands itself without a compile-time base case   |   Stop the recursion with `#if`; see `#code`, `#insert`, and `#expand`."
    );
    subheading(125, "Warnings");
    table_header(126, "Message   —   Usual cause   —   Fix");
    table_row(
        127,
        #string,oneline
            \\`this expression changes meaning under the 0-20 precedence table:
            \\bitwise operators now bind tighter than comparisons`   |   A bitwise
            \\operator and a comparison mixed without parentheses   |   Add
            \\parentheses; see Precedence Levels and Associativity.
    );
    table_row(
        128,
        "`unreachable pattern - already covered by an earlier case`   |   A case that an earlier case already matches   |   Remove or reorder it; see Coverage, Binding Forms, and Pattern Constants."
    );
    table_row(
        129,
        "`range pattern is empty and matches no value`   |   A range case such as `5..3`   |   Swap the bounds; see `#pattern` Matching and Pattern Forms."
    );
    table_row(
        130,
        "`no '>' for <T>: the where-clause only provides Num`   |   A generic body that uses an operation its `where` clause does not provide   |   Add the class to the `where` clause; see Generic Procedures and `where` Clauses."
    );
    subheading(131, "When the program runs");
    paragraph(
        132,
        #string,oneline
            \\A failed runtime check prints one line to standard error and ends
            \\the program with status 134, for example `runtime check failed:
            \\divide.by.zero`, `main.glo:2:47: runtime check failed: array.bounds`
            \\or `main.glo:2:38: dereference of an uninitialized pointer`. Feature
            \\Gates and Runtime Checks lists every check and the optimization
            \\levels at which it is compiled.
    );
}

render_section_94 :: () {
    paragraph(
        0,
        #string,oneline
            \\This appendix gives the syntax of Glosso as a grammar, read off the
            \\compiler's parser. It is a summary for looking things up. Each section
            \\below names the reference chapters that explain its constructs, and
            \\where the grammar is looser than the language, the checker rejects
            \\what the grammar lets through. The arguments of rare directives are
            \\left out. The binding strength of operators is not part of the grammar
            \\at all, because operators are declarations; Precedence Levels and
            \\Associativity gives the levels.
    );
    subheading(1, "Notation");
    table_header(2, "Form   —   Meaning");
    table_row(3, "`rule = ... ;`   |   Defines `rule`.");
    table_row(4, "`a | b`   |   Either `a` or `b`.");
    table_row(5, "`[ a ]`   |   `a` or nothing.");
    table_row(6, "`{ a }`   |   `a` repeated zero or more times.");
    table_row(
        7,
        "`\"if\"`, `\"::\"`, `\"#import\"`   |   A token spelled exactly so; a directive is one token."
    );
    table_row(8, "`(* ... *)`   |   A comment about the rule.");
    table_row(
        9,
        "`...` without quotes   |   Details left out; the construct's own chapter gives them. `\"...\"` in quotes is the token."
    );
    subheading(10, "Tokens");
    paragraph(
        11,
        #string,oneline
            \\The lexer turns the text into tokens, skipping spaces, tabs, line
            \\breaks and comments; block comments nest. Encoding, Comments, and
            \\Tokens describes comments, operators and punctuation, Identifiers,
            \\Reserved Words, and Directives the names, Number Literals the numbers,
            \\and Text and Character Literals the strings and characters.
    );
    code_block(
        12,
        "ebnf",
        #string
            \\ident         = ( letter | "_" ) { letter | digit | "_" } ;
            \\                (* Unicode letters and digits; not a keyword *)
            \\keyword       = "if" | "ifx" | "else" | "case" | "while" | "for"
            \\              | "return" | "break" | "continue" | "defer"
            \\              | "struct" | "union" | "enum" | "cast" | "acast"
            \\              | "using" | "context" | "where" | "noalias" ;
            \\name          = ident | "`" ident | "``" ident ;   (* macro forms *)
            \\
            \\int_literal   = decimal | decimal "#" based_digits ;   (* 16#ff *)
            \\decimal       = digit { [ "_" ] digit } ;
            \\based_digits  = alnum { [ "_" ] alnum } ;
            \\float_literal = decimal "." decimal [ exponent ]
            \\              | decimal exponent ;
            \\exponent      = ( "e" | "E" ) [ "+" | "-" ] decimal ;
            \\string        = [ "c" | "b" ] '"' { character | escape } '"' ;
            \\char_literal  = "#char" '"' ( character | escape ) '"' ;
            \\                (* the lexer turns it into an integer token *)
            \\string_line   = "\\" { any character but a line break } ;
            \\
            \\directive     = "#" ident ;
            \\label         = "'" ident ;            (* no closing quote *)
            \\op_name       = "'" op_text "'" ;      (* '+'  '<=>'  '[]=' *)
            \\operator      = op_char { op_char } ;  (* the longest run *)
            \\op_char       = "+" | "-" | "*" | "/" | "<" | ">" | "!" | "@"
            \\              | "%" | "^" | "&" | "|" | "~" | "." | ":" | "=" ;
            \\                (* "?" and "," are always tokens of their own *)
            \\punctuation   = "(" | ")" | "{" | "}" | "[" | "]" | ";" | ","
            \\              | ",," | "$" | "?" | "." | ".{" | ".[" | ".*" | ".&"
            \\              | ".." | "..=" | "..." | ":" | "::" | ":::" | ":="
            \\              | "::=" | "=" | "->" ;
    );
    paragraph(
        13,
        #string,oneline
            \\An operator token is the longest run of operator characters, whatever
            \\operators are declared, so adjacent operators need a space between
            \\them. A quote followed by a name is a label when no quote closes it,
            \\as in `'again`, and an operator name when one does, as in `'plus'`.
            \\Digits after a `.` are a tuple index, never a fraction: `t.0.1` is
            \\`(t.0).1`.
    );
    subheading(14, "Source files and declarations");
    paragraph(
        15,
        #string,oneline
            \\A source file is a sequence of top-level items. Most of them are named
            \\declarations: a name, `::` and a definition, or a global variable
            \\written with `:=` or `:`. Modules, Imports, and the Prelude covers
            \\imports, Who Can Use a Declaration: Visibility and Units the
            \\visibility prefixes, and Constants, Variables, and Globals the
            \\constants and globals.
    );
    code_block(
        16,
        "ebnf",
        #string
            \\source_file   = { top_item } ;
            \\top_item      = visibility ( "{" { top_item } "}" | named_decl )
            \\              | "#if" expr decl_block
            \\                { "else" "#if" expr decl_block } [ "else" decl_block ]
            \\              | ( "#import" | "#export" ) import ";"
            \\              | module_params
            \\              | "#comptime" ( block | "->" type block [ ";" ] | expr ";" )
            \\              | "#insert" insert_operand ";"
            \\              | "#thread_local" named_decl    (* a global variable *)
            \\              | ( "#enable" | "#disable" ) "(" ident ")" [ ";" ]
            \\              | instance_decl
            \\              | inherent_decl
            \\              | named_decl ;
            \\decl_block    = "{" { top_item } "}" ;
            \\
            \\visibility    = "#private"
            \\              | "#public" [ "," "unit" ]
            \\              | "#public" "," "to" "(" string { "," string } [ "," ] ")" ;
            \\import        = string [ module_args ] [ import_list ] ;
            \\module_args   = "(" [ module_arg { "," module_arg } [ "," ] ] ")" ;
            \\module_arg    = [ [ "." ] ident "=" ] expr ;
            \\import_list   = "{" [ import_name { "," import_name } [ "," ] ] "}" ;
            \\module_params = "#module_params" "("
            \\                [ module_param { "," module_param } [ "," ] ] ")" ";" ;
            \\module_param  = ident ( ":" type [ "=" expr ] | ":=" expr ) ;
            \\import_name   = ( name | op_name ) { "." ( name | op_name ) } ;
            \\
            \\named_decl    = decl_name "::" definition
            \\              | decl_name ( ":=" | "::=" ) ( definition | expr { var_attr } ";" )
            \\              | decl_name ":" [ type ] { var_attr }
            \\                ( ( ":" | "::" ) definition      (* typed constant *)
            \\                | ( "=" | ":=" ) expr { var_attr } ";"   (* global variable *)
            \\                | ";" ) ;                (* a zero global; needs the type *)
            \\var_attr      = "#align" expr | "#link_section" expr ;
            \\decl_name     = ident | op_name ;
            \\definition    = function
            \\              | struct_type | union_type | enum_type | enum_flags_type
            \\              | "distinct" type { distinct_derive } ";"
            \\              | typeclass
            \\              | ( "#import" | "#export" ) import ";"   (* namespace alias *)
            \\              | "#library" { "," ident } string ";"
            \\              | "#fn_ptr" fn_ptr_signature ";"
            \\              | expr ";" ;                            (* a constant *)
            \\
            \\instance_decl = type ":::" "instance" [ "!" ] ident { where_clause }
            \\                instance_body ;
            \\inherent_decl = type ":::" [ visibility ] { where_clause } inherent_body ;
            \\where_clause  = "where" expr ;
    );
    paragraph(
        17,
        #string,oneline
            \\A declaration that ends with a body in braces ends at its `}`:
            \\procedures, structs, unions, enums, typeclasses, instances, inherent
            \\blocks, visibility groups and module `#if`s, and also a constant whose
            \\value ends in a block, such as `#comptime { ... }`. A `;` after such a
            \\brace is an error. Every other declaration ends with `;`, including `K
            \\:: P.{ 1 };` and `#import "Io";`.
    );
    code_block(
        18,
        "text",
        #string
            \\// f :: () {};
            \\error: expected a declaration, found ';'
            \\help: a declaration whose body is braced ends at its '}', and is not followed by a semicolon; remove it
            \\// K :: 5
            \\error: declaration must end with ';'
    );
    bullet(
        19,
        #string,oneline
            \\After `name ::`, the next token selects the definition: `struct`,
            \\`union`, `enum`, the words `enum_flags`, `distinct` and `typeclass`,
            \\or one of the directives. A `(` starts a procedure unless what follows
            \\is a parenthesized value, so `K :: (1 + 2) * 3;` is a constant. A
            \\procedure type cannot be bound with `::`; `#fn_ptr` declares one (see
            \\Lambdas and `#fn_ptr` Values).
    );
    bullet(
        20,
        #string,oneline
            \\An item is an instance or an inherent block when `:::` appears before
            \\the next `;`, `{` or `}` outside brackets. The tokens before it are
            \\read as a type, so `(Vec2, f64) ::: instance Mul` and
            \\`Box($T) ::: { ... }` work alike.
    );
    bullet(
        21,
        #string,oneline
            \\A declaration takes one visibility prefix. A prefix stands before a
            \\named declaration or a brace group, never before a `:::` block; an
            \\inherent block takes it after `:::`, as in `T ::: #public { ... }`.
    );
    bullet(
        22,
        #string,oneline
            \\A module-level `#if` holds declarations, needs braces on every arm and
            \\has no switch form (see `#if`, `#assert`, and `#compile_error`).
            \\`#compile_error` and `#assert` are statements and cannot appear at the
            \\top level, and `#import` is a top-level item that cannot appear in a
            \\procedure.
    );
    subheading(23, "Procedures");
    code_block(
        24,
        "ebnf",
        #string
            \\function      = "(" [ params ] ")" [ "->" type ] { fn_directive }
            \\                { where_clause } ( block | ";" ) ;
            \\                (* ";" only with #foreign or #magic *)
            \\params        = param { "," param } [ "," ] ;
            \\param         = receiver                (* first parameter of a method *)
            \\              | "..."                   (* C variadic arguments, last *)
            \\              | "#empty" ":" type { "," type }
            \\              | comptime_mark ident { "," ident } ":" type [ "=" expr ]
            \\              | { "using" | "noalias" } [ "#lazy" ] value_param ;
            \\comptime_mark = "#comptime" [ "#lazy" ] | "#lazy" "#comptime" ;
            \\value_param   = ident ":=" expr
            \\              | ident { "," ident } ":" ( type | variadic ) [ "=" expr ] ;
            \\variadic      = "..." [ ident | "$" ident | "(" ident { "&&" ident } ")" ] ;
            \\receiver      = { "using" | "noalias" } [ "*" [ "const" ] ] "#self" ;
            \\
            \\fn_directive  = "#operator" "(" mode [ "," int_literal ]
            \\                [ "," "try" "(" ident ")" ] ")"
            \\              | "#inline" [ "," ( "always" | "never" ) ]
            \\              | "#expand" [ "," "expression" ]
            \\              | "#foreign" ( ident | string ) [ string ]
            \\              | "#magic" string
            \\              | "#specialize" ( block | expr )
            \\              | "#c_call" | "#no_context" | "#must"
            \\              | "#returns_twice" | "#dump" ;
            \\mode          = "left" | "right" | "assign" | "prefix" | "suffix" ;
            \\
            \\fn_ptr_signature = "(" [ fn_ptr_param { "," fn_ptr_param }
            \\                   [ "," [ "..." ] ] ] ")" [ "->" type ]
            \\                   { "#c_call" | "#no_context" } ;
            \\fn_ptr_param  = [ "noalias" ] ident ":" type ;
    );
    paragraph(
        25,
        #string,oneline
            \\The directives come before the `where` clauses. The return type is a
            \\single type, a tuple `(A, B)`, named results `(q: s64, r: s64)`, or
            \\`#Never`. A generic type parameter `$T` is written inside a
            \\parameter's type, as in `x: $T`, never as a parameter name; a
            \\parameter `T: type` is a type parameter in its own right. `#self`,
            \\`*#self` and `*const #self` are accepted only as the first parameter
            \\of a method in an inherent block. Procedure Declarations and
            \\Arguments, Variadic Procedures, `noalias`, `#lazy`, `#comptime`, and
            \\Type Parameters, and Directives That Modify Procedures explain these parts.
    );
    subheading(26, "Struct, union, and enum types");
    code_block(
        27,
        "ebnf",
        #string
            \\struct_type   = "struct" { struct_directive } "{" { struct_item } "}" ;
            \\struct_directive = "#packed" | "#align" "(" int_literal ")" | "#c_call"
            \\              | "#derive" class_list | "#specialize" ( block | expr )
            \\              | "#magic" string ;
            \\struct_item   = visibility ( "{" { struct_item } "}" | field ) | field ;
            \\field         = { "using" | "#as" } ident ":" field_type [ "=" expr ] ";"
            \\              | [ "using" ] "#empty" ":" type { "," type } [ "," ] ";" ;
            \\field_type    = type ;     (* may contain an inline struct_type,
            \\                              union_type, enum_type or enum_flags_type *)
            \\
            \\union_type    = "union" { "#raw" | "#derive" class_list | "#magic" string }
            \\                "{" { union_item } "}" ;
            \\union_item    = visibility ( "{" { union_item } "}" | variant ) | variant ;
            \\variant       = [ "#from" ] ident ":" field_type ";" ;
            \\
            \\enum_type     = "enum" [ type ] { "#derive" class_list }
            \\                "{" { enum_item } "}" ;
            \\enum_flags_type = "enum_flags" type { "#derive" class_list }
            \\                "{" { enum_item } "}" ;
            \\enum_item     = visibility ( "{" { enum_item } "}" | member ) | member ;
            \\member        = ident [ "::" [ "-" ] int_literal ] ";" ;
            \\
            \\class_list    = "(" ident { "," ident } ")" ;
            \\distinct_derive = "#derive" ( "," "all"
            \\                | "(" [ type { "," type } [ "," ] ] ")" ) ;
    );
    paragraph(
        28,
        #string,oneline
            \\Every member ends with `;`, the last one included, and a field
            \\declares one name. An enum member's value is an integer literal, a
            \\`#char` or a negative literal after `::`, never a named constant or an
            \\expression. An aggregate holds no declarations other than its members.
            \\An inline aggregate type is accepted only within a field's type, as in
            \\`items: []struct { ... };`. See Struct Types, Field Order, Alignment,
            \\and Packing, Tagged and Untagged Unions, `enum` and `enum_flags`, and
            \\Nominal Types with `distinct`.
    );
    subheading(29, "Typeclasses, instances, and inherent blocks");
    code_block(
        30,
        "ebnf",
        #string
            \\typeclass     = "typeclass" "(" [ class_param { "," class_param } [ "," ] ] ")"
            \\                { where_clause }
            \\                { "#minimal" "(" [ minimal ] ")"
            \\                | "#derive" "(" ident { "," ident } ")"
            \\                | "#magic" string }
            \\                "{" { class_member } "}" ;
            \\class_param   = [ "#comptime" ] ident ":" type ;
            \\class_member  = ( ident | op_name ) "::" "(" [ params ] ")" [ "->" type ]
            \\                { fn_directive } { where_clause } ( block | ";" )
            \\              | ident "::" type [ ";" ] ;     (* associated type *)
            \\minimal       = minimal_all { "|" minimal_all } ;
            \\minimal_all   = minimal_atom { "," minimal_atom } ;
            \\minimal_atom  = ident | op_name | "(" minimal ")" ;
            \\
            \\instance_body = "{" { ( ident | op_name ) "::" function
            \\                    | ident "::" type [ ";" ] } "}" ;
            \\inherent_body = "{" { inherent_item } "}" ;
            \\inherent_item = visibility ( "{" { inherent_item } "}" | method )
            \\              | method ;
            \\method        = ident "::" function ;
    );
    paragraph(
        31,
        #string,oneline
            \\In a typeclass the `where` clauses come before the directives, the
            \\reverse of a procedure. A member is a method when `(` follows its `::`
            \\and an associated type otherwise. A class member may end with `;` to
            \\state a requirement or carry a body as a default; an instance method
            \\always has a body unless it is `#foreign`. In `#minimal`, `,` means
            \\"and" and binds tighter than `|`. `instance !Class` declares a
            \\negative instance and has an empty body. Inherent methods have plain
            \\names: an operator is declared through a typeclass, never in an
            \\inherent block. See Typeclass Declarations and Instances, Instance
            \\Resolution and Negative Instances, and Inherent Methods, Member
            \\Access, and Call Syntax.
    );
    subheading(32, "Types");
    code_block(
        33,
        "ebnf",
        #string
            \\type          = type_operand [ "!" type ] ;      (* E!T, from the right *)
            \\type_operand  = "?" type_operand
            \\              | "*" { "*" } { "const" | "volatile" } type_operand
            \\              | "[" "*" "]" { "const" | "volatile" } type_operand
            \\              | "[" "]" { "const" | "volatile" } type_operand
            \\              | "[" ( ".." | int_literal | ident | "_" ) "]" type_operand
            \\              | ( "#soa" | "#aos" ) type_operand
            \\              | "$" ident
            \\              | "#Never" | "#Self_Type" | "#Context"
            \\              | "(" [ paren_item { "," paren_item } ] ")" [ "->" type ]
            \\              | "Simd" "(" type "," int_literal ")"
            \\              | "Matrix" "(" type "," dimension "," dimension ")"
            \\              | type_name ;
            \\type_name     = name { "." ident } [ "(" [ type_arg { "," type_arg } ] ")" ]
            \\                { "." ident } ;
            \\type_arg      = type | string ;
            \\paren_item    = [ "noalias" ] [ ident ":" ] type ;
            \\dimension     = [ "-" ] int_literal | ident ;
    );
    paragraph(
        34,
        #string,oneline
            \\Prefixes apply before `!`, so `?T!U` is `(?T)!U`, and `!` groups from
            \\the right. `const` and `volatile` follow only `*`, `[*]` and `[]`. In
            \\parentheses, one type is that type, a comma makes a tuple, and `->`
            \\makes a procedure type. In an expression, a type can stand as a value
            \\when it starts with `*`, `?` or `[`, is an `E!T`, or is a name or a
            \\call such as `Box(s64)`; a tuple or procedure type cannot. Catalog of
            \\Built-in Types lists the named types; Pointer Types, Arrays, Views,
            \\Dynamic Arrays, and Slicing, `?T` and `E!T`, and `#soa` and `#aos`
            \\Storage describe the constructors.
    );
    subheading(35, "Expressions");
    paragraph(
        36,
        #string,oneline
            \\The parser climbs precedence over the module's operator table. Any
            \\operator token or operator name that the table gives a binary level is
            \\a `binary_op`; prefix and suffix operators come from the same table. A
            \\higher level binds tighter, `right` and `assign` operators group from
            \\the right, and two operators of one level with different grouping
            \\cannot be mixed without parentheses (see Operator Declarations).
    );
    code_block(
        37,
        "ebnf",
        #string
            \\expr          = unary { binary_op unary | "!" unary | ".." } ;
            \\                (* "!" is the E!T type; a final ".." is an open range *)
            \\unary         = "cast" "(" type ")" unary
            \\              | "acast" unary
            \\              | "*" { "*" } { "const" | "volatile" } unary
            \\                (* dereference, or a pointer type *)
            \\              | "&" { "&" } unary                (* address *)
            \\              | prefix_op unary                 (* - ! ~ -% .. *)
            \\              | "?" unary                       (* an option type or a present value *)
            \\              | "#comptime" ( [ "->" type ] block | unary )
            \\              | "#try" "{" expr "}"
            \\              | "#meaningful" ( block | unary )
            \\              | "#pattern" pattern_form
            \\              | ifx
            \\              | "return" [ expr ] | "break" | "continue"
            \\              | ".."                            (* full range *)
            \\              | postfix ;
            \\postfix       = primary { "." ( name | op_name | decimal
            \\                              | "cast" "(" type ")" | "acast" )
            \\                        | "(" [ argument { "," argument } [ "," ] ] ")"
            \\                        | "[" expr "]"
            \\                        | ".{" [ field_init { "," field_init } [ "," ] ] "}"
            \\                        | ".*" | ".&" | "?"
            \\                        | ",," ( name | label )
            \\                        | suffix_op } ;
            \\argument      = [ "." ident "=" ] expr [ "..." ] ;
            \\field_init    = [ "." name "=" ] expr ;
            \\
            \\primary       = int_literal | float_literal | char_literal | string
            \\              | name | op_name | label | "context"
            \\              | "." name                        (* .Red, .Ok *)
            \\              | ".{" [ field_init { "," field_init } [ "," ] ] "}"
            \\              | ".[" [ expr { "," expr } [ "," ] ] "]"
            \\              | "." "(" [ expr { "," expr } [ "," ] ] ")"   (* tuple *)
            \\              | "#simd" ".[" ... "]" | "#matrix" ".[" ... "]"
            \\              | "#string" { "," ident } string_line { string_line }
            \\              | "#code" ( block | statement )
            \\              | "#insert" insert_operand
            \\              | "#source_location" | "#undefined"
            \\              | "#self" | "#Self_Type" | "#Never"
            \\              | "$" ident
            \\              | lambda
            \\              | bracket_type                    (* [..]s64 as a value *)
            \\              | "(" expr ")" ;
            \\
            \\ifx           = "ifx" expr expr "else" expr
            \\              | "ifx" ( expr | "#pattern" [ expr ] ) "==" "{" switch_body "}" ;
            \\lambda        = ( "||" | "|" [ lambda_param { "," lambda_param } [ "," ] ] "|" )
            \\                ( "->" type block | block | expr ) ;
            \\lambda_param  = [ "noalias" ] ident [ ":" type ] ;
            \\insert_operand = [ "," "scope" "(" [ expr ] ")" ]
            \\                 ( [ "->" type ] block | expr ) ;
    );
    paragraph(
        38,
        #string,oneline
            \\A prefix form takes a whole `unary` operand, postfixes included, so
            \\`-p.x` is `-(p.x)` and `#comptime 1 + 2` is `(#comptime 1) + 2`. `=`
            \\is not an operator: assignment is a statement, so `b := (a = 2);` is
            \\an error. `==` followed directly by `{` ends an expression and starts
            \\a switch. A struct literal's prefix is a type name, a member chain or
            \\a call made of them, as in `Box(s64).{ 5 }`; a bracket type has no
            \\struct literal (see Aggregate Literal Syntax). Nothing separates the
            \\condition of an `ifx` from its first arm, so an arm that starts with
            \\`(`, `[`, `-` or `.` continues the condition (see Statements and
            \\Conditional Expressions). A bare name after `,,` is a type-field
            \\requirement inside `#meaningful` when the left side is a type, or a
            \\nonlocal label when the left side names a function. A quoted label
            \\after `,,` keeps the nonlocal-label form.
    );
    subheading(39, "Statements");
    code_block(
        40,
        "ebnf",
        #string
            \\block         = "{" { statement } "}" ;
            \\body          = block | statement ;
            \\statement     = block
            \\              | local_decl
            \\              | var_decl
            \\              | expr "=" expr ";"
            \\              | expr assign_op expr ";"          (* += -= ... *)
            \\              | expr ";"
            \\              | "#pattern" pattern ":=" expr "else" block [ ";" ]
            \\              | "if" expr body [ "else" body ]
            \\              | "if" [ "#partial" ] expr "==" "{" switch_body "}"
            \\              | "if" [ "#partial" ] "#pattern" [ expr ] "==" "{" switch_body "}"
            \\              | [ "#inline" ] "while" expr body
            \\              | [ "#inline" ] for_stmt
            \\              | "return" [ expr { "," expr } ] ";"
            \\              | "break" [ ";" ] | "continue" [ ";" ]
            \\              | label ( ":" | ";" )
            \\              | "defer" statement
            \\              | "#try" "defer" statement
            \\              | "using" ident [ ";" ]
            \\              | "#if" expr body [ "else" body ]
            \\              | "#if" expr "==" "{" static_switch_body "}"
            \\              | "#comptime" ( [ "->" type ] block | expr ) [ ";" ]
            \\              | "#assert" [ "#comptime" ] expr [ "," expr ] [ ";" ]
            \\              | "#compile_error" expr [ ";" ]
            \\              | "#insert" insert_operand [ ";" ]
            \\              | "#push_context" [ expr ] body
            \\              | "#push_allocator" "(" expr ")" [ ";" ]
            \\              | "#temp_scope" block
            \\              | "#asm" ...  | "#bytes" expr [ ";" ]
            \\              | "`return" [ expr { "," expr } ] ";"   (* in macros *)
            \\              | "`defer" statement ;
            \\
            \\var_decl      = name { "," name } var_init { var_attr } ";" ;
            \\var_init      = ( ":=" | "::=" | "::" ) expr
            \\              | ":" ( type { var_attr } [ var_value ] | var_value ) ;
            \\var_value     = ( "=" | ":=" | ":" | "::" ) expr ;
            \\local_decl    = decl_name "::" ( function | typeclass
            \\              | struct_type | union_type | enum_type | enum_flags_type
            \\              | "distinct" type { distinct_derive } [ ";" ]
            \\              | "#fn_ptr" fn_ptr_signature [ ";" ] ) ;
            \\for_stmt      = "for" [ "<" ] [ ":" ident ] [ "*" ]
            \\                [ ident [ "," ident ] ":" ] expr body ;
    );
    paragraph(
        41,
        #string,oneline
            \\A simple statement, a declaration, an assignment and `return` end with
            \\`;`; for `break`, `continue`, `using` and most directive statements it
            \\is optional. There is no empty statement, so a `;` after the `}` of an
            \\`if`, a loop, a switch or a local procedure is an error. `if`,
            \\`while`, `for`, `#if` and `#push_context` take either a block or a
            \\single statement, as in `if x > 0 return 1; else return 2;`. A
            \\procedure or type declared inside a body belongs to the module, not to
            \\the block. In a `for` header, `<` walks backwards, `*` binds a pointer
            \\to each element, the second name is the index, and without names the
            \\element is `it`. `break` and `continue` take no label. Statements and
            \\Conditional Expressions, Assignment, Blocks, and Name Lookup, and
            \\`while`, `for`, and Unrolled Loops describe the statements.
    );
    subheading(42, "Switches and patterns");
    code_block(
        43,
        "ebnf",
        #string
            \\switch_body   = { switch_arm } ;               (* at most one "else" *)
            \\switch_arm    = "case" pattern { "," pattern } [ "if" expr ] ";" case_body
            \\              | "else" ";" case_body ;
            \\case_body     = { statement } [ "#falling" [ ";" ] ] ;
            \\static_switch_body = { "case" expr { "," expr } ";" case_body
            \\                     | "else" ";" case_body } ;
            \\
            \\pattern_form  = pattern ":=" expr "else" block       (* bind or diverge *)
            \\              | pattern "=" expr                     (* a test: bool *)
            \\              | "{" pattern "=" expr { ( ";" | "," ) pattern "=" expr }
            \\                [ ";" | "," ] "}"
            \\              | pattern ;                            (* a Pattern value *)
            \\
            \\pattern       = element { "|" element } ;
            \\element       = range_expr | const_expr          (* see below *)
            \\              | "==" expr
            \\              | "?" element                      (* a present ?T *)
            \\              | "#insert" expr
            \\              | pattern_primary { "." name
            \\                                | "(" [ pattern { "," pattern } ] ")"
            \\                                | ".{" pattern_fields "}" } ;
            \\pattern_primary = ident [ "@" element ]          (* binds; "_" binds nothing *)
            \\              | "*" ident                        (* binds a pointer *)
            \\              | "..."                            (* the rest *)
            \\              | int_literal | float_literal | char_literal | string
            \\              | "true" | "false" | "null"
            \\              | type_prefix                      (* ident before "." or ".{" *)
            \\              | "." ident                        (* member or variant *)
            \\              | ".{" pattern_fields "}"
            \\              | ".[" [ pattern { "," pattern } [ "," ] ] "]"
            \\              | "." "(" ")"
            \\              | "(" pattern ")" ;
            \\pattern_fields = [ pattern_field { "," pattern_field } [ "," ] ] ;
            \\pattern_field = "..." | "." name [ "=" pattern ] | pattern ;
    );
    paragraph(
        44,
        #string,oneline
            \\A `case` label ends with `;`, and the arm's statements run to the next
            \\`case`, `else` or `}`. `case a, b;` is the same as `case a | b;`, and
            \\a guard is `case p if condition;`. `#falling` must be the last
            \\statement of an arm and cannot end `else`. Switch Statements describes
            \\the run-time switch.
    );
    paragraph(
        45,
        #string,oneline
            \\A bare name in a pattern binds the matched value; to compare with a
            \\constant, write `== K`. An element that contains an operator other
            \\than `|` and `@`, such as `-1` or `LOW + 1`, is read as a constant
            \\expression, and one with `..` or `..=` outside brackets as a range, so
            \\`case 1..3 | 5;` works. A tuple has no pattern of its own. The labels
            \\of a `#if x == {` switch are expressions rather than patterns, so
            \\there `case A | B;` is a bitwise or; write `case A, B;`. `#pattern`
            \\Matching and Pattern Forms describes what each form matches, and
            \\Coverage, Binding Forms, and Pattern Constants the bind-or-diverge
            \\form and pattern values.
    );
    subheading(46, "Where directives may appear");
    table_header(47, "Position   —   Directives");
    table_row(
        48,
        "Top level   |   `#module_params` `#import` `#export` `#public` `#private` `#if` `#comptime` `#insert` `#thread_local` `#enable` `#disable`"
    );
    table_row(49, "After `name ::`   |   `#import` `#export` `#library` `#fn_ptr`");
    table_row(
        50,
        "After a procedure's parameters   |   `#operator` `#inline` `#expand` `#foreign` `#magic` `#specialize` `#c_call` `#no_context` `#must` `#returns_twice` `#dump`"
    );
    table_row(51, "Parameters   |   `#comptime` `#lazy` `#empty` `#self`");
    table_row(
        52,
        "After `struct`, `union`, `enum`, `distinct`   |   `#packed` `#align` `#c_call` `#specialize` (struct), `#raw` (union), `#derive`, `#magic`"
    );
    table_row(53, "After a variable's type or initial value   |   `#align` `#link_section` (globals only)");
    table_row(54, "Aggregate members   |   `#as` `#empty` `#from` `#public` `#private`");
    table_row(55, "After `typeclass (...)`   |   `#minimal` `#derive` `#magic`");
    table_row(56, "Types   |   `#Never` `#Self_Type` `#Context` `#soa` `#aos`");
    table_row(
        57,
        "Statements   |   `#if` `#comptime` `#assert` `#compile_error` `#insert` `#inline` `#push_context` `#push_allocator` `#temp_scope` `#try defer` `#asm` `#bytes`"
    );
    table_row(
        58,
        "Switches   |   `#partial` and `#pattern` after `if`; `#pattern` after `ifx`; `#falling` at the end of an arm"
    );
    table_row(
        59,
        "Expressions   |   `#comptime` `#try` `#pattern` `#meaningful` `#code` `#insert` `#string` `#char` `#simd` `#matrix` `#source_location` `#undefined` `#self` `#Self_Type` `#Never`"
    );
    table_row(60, "Patterns   |   `#insert`");
    paragraph(
        61,
        #string,oneline
            \\A directive elsewhere is rejected: at the top level as `bad decl
            \\name`, in an expression as `unexpected directive`. Identifiers,
            \\Reserved Words, and Directives lists the chapter of each directive.
    );
}

render_section_95 :: () {
    paragraph(
        0,
        #string,oneline
            \\The standard library is a directory of modules, imported by name like
            \\any other module. Apart from the prelude, nothing in it is in scope
            \\until a file imports it. This appendix is a map of that directory:
            \\what each module and family of modules is for, grouped by task, with
            \\the import line to write and the chapter of this manual that discusses
            \\the subject. Every public declaration of every module, with its
            \\signature and documentation, is listed in the Standard library half of
            \\this site, which is generated from the library's source; this appendix
            \\says where to look rather than repeating those entries.
    );
    subheading(1, "Module names and files");
    paragraph(
        2,
        #string,oneline
            \\A module name is a path below the standard library directory. A name
            \\that names a file, such as `"Io"` or `"Memory/Arena"`, imports that
            \\file. A name that names a directory imports the directory's
            \\`module.glo`, which re-exports the files beside it: `"Memory"` brings
            \\in `Memory/Arena`, `Memory/Ownership` and the rest of the `Memory`
            \\files at once. Each of those files is also a module of its own and can
            \\be imported alone. Modules, Imports, and the Prelude describes the
            \\lookup and re-exporting in general.
    );
    paragraph(
        3,
        #string,oneline
            \\Some directories have no `module.glo`. `Container`, `File_System`,
            \\`Net`, `Crypto` and `Serialization` group independent components, and
            \\a program imports the component it needs, such as
            \\`"Container/HashMap"`. Importing the directory itself fails:
    );
    code_block(
        4,
        "text",
        #string
            \\// #import "Container";
            \\error: cannot find module "Container" (searched: /usr/local/glosso/std)
    );
    paragraph(
        5,
        #string,oneline
            \\`Math` has no `module.glo` either; its components are imported by
            \\their full names, starting with `"Math/Core"`. The command-line
            \\compiler accepts `#import "Math";` as a shorthand for
            \\`#import "Math/Core";`.
    );
    subheading(6, "Choosing what to import");
    bullet(
        7,
        #string,oneline
            \\Import the module that declares what a file uses. Imports do not
            \\chain: a module imported by an imported module is not visible, so a
            \\file that uses `HashMap` and `Container_Error` imports both of their
            \\modules.
    );
    bullet(
        8,
        #string,oneline
            \\An umbrella module such as `Memory`, `Io` or `Time` brings all of its
            \\components' names into scope; importing one component, such as
            \\`Memory/Ownership`, brings only that component's. Prefer the
            \\component when one is enough and a short import list,
            \\`#import "Math/Core" { sqrt };`, when a module's other names would
            \\collide with the file's own.
    );
    bullet(
        9,
        #string,oneline
            \\To find the module that declares a name, search for the name in the
            \\Standard library half of this site; each entry shows its module.
    );
    paragraph(
        10,
        #string,oneline
            \\A typical program imports a handful of modules. This one counts words
            \\with `split` from `Strings` and a `HashMap` from `Container/HashMap`;
            \\the error type of the map's operations comes from `Container/Error`.
            \\`for`, `?`, `free` and the optional pattern need no import, because
            \\they belong to the language and the prelude. Project: A Word-Frequency
            \\Counter builds a complete tool on the same idea.
    );
    code_block(
        11,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\#import "Container/HashMap";
            \\#import "Container/Error";
            \\
            \\main :: () -> Container_Error!void {
            \\    text := "the cat saw the dog and the bird";
            \\    words := text.split(" ");
            \\    defer words.free();
            \\
            \\    counts := HashMap(str, s64).with_seed(1, 2);
            \\    defer counts.free();
            \\    for word: words {
            \\        count := counts.get_or_insert(word, 0)?;
            \\        count.* += 1;
            \\    }
            \\    if #pattern ?n = counts.get("the") print("the: {}\n", n.*);
            \\    print("{} distinct words\n", counts.len());
            \\    return .Ok;
            \\}
    );
    code_block(
        12,
        "text",
        #string
            \\the: 3
            \\6 distinct words
    );
    subheading(13, "Without an import: the prelude");
    paragraph(
        14,
        #string,oneline
            \\The `Prelude` module is loaded into every program without an import.
            \\It holds the typeclasses behind the operators, equality and ordering,
            \\iteration, the operations of dynamic arrays and views, the helpers of
            \\`?T` and `E!T`, the protocols `Try`, `Termination`, `Freeable`,
            \\`Show`, `Send`, `Sync`, the description of the target, and
            \\`get_cmdline_args` and `exit`. Modules, Imports, and the Prelude
            \\describes it. Every module in the tables below needs an `#import`.
    );
    subheading(15, "Text and output");
    table_header(16, "Import   —   For   —   See");
    table_row(
        17,
        #string,oneline
            \\`Io`   |   `print`; writing and reading lines on a `File`; the stream
            \\typeclasses `Reader` and `Writer` with buffering, scanning, transfers
            \\and binary codecs, re-exported from `Io/Core`, `Io/Buffer`, `Io/Scan`
            \\and the other `Io/` files   |   What a Program Is
    );
    table_row(
        18,
        #string,oneline
            \\`Format`   |   `format` (an owned `str`), `tprint` (a temporary
            \\`str`), formatting into a writer, and the `Formatter` protocol behind
            \\`{}`   |   `Show`, `Formatter`, `FromString`, and Format Strings
    );
    table_row(
        19,
        "`String_Builder`   |   A growable byte buffer for assembling strings   |   `Show`, `Formatter`, `FromString`, and Format Strings"
    );
    table_row(
        20,
        #string,oneline
            \\`Strings`   |   UTF-8 search, split, trim, case mapping and
            \\validation (`Strings/Utf8`); UTF-16 conversion (`Strings/Utf16`);
            \\releasing owned strings (`Strings/Memory`)   |   `str`, `cstr`,
            \\and UTF-16 Text
    );
    table_row(
        21,
        "`Unicode`   |   Properties of a code point: general category, letter and digit tests, simple case mapping, display width   |   Text and Character Literals"
    );
    table_row(
        22,
        "`Ascii`   |   Classification and case folding of single `u8` bytes   |   Text and Character Literals"
    );
    table_row(
        23,
        "`Terminal`   |   A terminal toolkit: raw mode, key and mouse events, a styled cell canvas; `Terminal/Text_Input`, a multi-line text input widget   |   Standard library reference"
    );
    table_row(
        24,
        "`Regex`   |   Compiled UTF-8 regular expressions written in Glosso: matching, search, captures, named groups, replacement   |   Standard library reference"
    );
    table_row(
        25,
        "`Html`   |   Parsing HTML, selecting nodes, extracting links and attributes   |   Standard library reference"
    );
    paragraph(
        26,
        #string,oneline
            \\`Io` prints and wraps streams, but opening a file by name is the
            \\business of `File_System/File`; a program that reads a file imports
            \\both.
    );
    subheading(27, "Memory and data structures");
    table_header(28, "Import   —   For   —   See");
    table_row(
        29,
        #string,oneline
            \\`Context`   |   The allocator procedures (`heap_allocator`,
            \\`debug_allocator`, `default_temp_allocator`), `mem_alloc` and
            \\`mem_free`, and the types of the context's fields   |   `#Context`
            \\and `context`; `Allocator` and Allocation Procedures
    );
    table_row(
        30,
        #string,oneline
            \\`Memory`   |   `new` and `delete` (`Memory/Object`); `value_take`,
            \\`value_swap` and `value_replace` (`Memory/Ownership`); `Arena`
            \\(`Memory/Arena`); raw byte copies (`Memory/Raw`); algorithms on views:
            \\fill, reverse, rotate, search, deduplicate, set operations, map,
            \\filter and fold   |   `Freeable`, Copies, and Ownership Transfer;
            \\Container Buffers, Arenas, and Pools
    );
    table_row(
        31,
        "`Container/HashMap`, `Container/HashSet`   |   Hash map and hash set   |   Container Buffers, Arenas, and Pools"
    );
    table_row(
        32,
        "`Container/BTreeMap`, `Container/BTreeSet`   |   Ordered map and set   |   Container Buffers, Arenas, and Pools"
    );
    table_row(
        33,
        "`Container/Deque`, `Container/LinkedList`, `Container/BinaryHeap`   |   Double-ended queue, doubly linked list, max-heap   |   Container Buffers, Arenas, and Pools"
    );
    table_row(
        34,
        "`Container/Pool`   |   A generational pool whose values are addressed by `Handle`   |   Container Buffers, Arenas, and Pools"
    );
    table_row(
        35,
        "`Container/Hash`, `Container/Error`   |   The `Hash` and `Hasher` contracts; `Container_Error`, shared by all containers   |   `PartialEq`, `PartialOrd`, and `Hash`"
    );
    table_row(
        36,
        "`Sort`   |   Sorting views (stable by default), binary search, minimum and maximum, heaps, permutations   |   `PartialEq`, `PartialOrd`, and `Hash`"
    );
    subheading(37, "Numbers");
    table_header(38, "Import   —   For   —   See");
    table_row(
        39,
        "`Math/Core`   |   `sqrt`, trigonometry, exponentials, rounding and float classification; the classes `Fractional`, `Floating`, `RealFloat`   |   Floating-Point and Complex Arithmetic"
    );
    table_row(
        40,
        "`Math/Constants`   |   `PI`, `TAU`, `E` and other constants, and the limits of each float format   |   Floating-Point and Complex Arithmetic"
    );
    table_row(
        41,
        "`Math/Bit`   |   Bit counts, rotations, byte swaps, bit fields, checked arithmetic   |   Integer Arithmetic, Overflow, and Traps"
    );
    table_row(
        42,
        "`Math/Complex`   |   Construction and functions of `c32` to `c256`   |   Floating-Point and Complex Arithmetic"
    );
    table_row(
        43,
        "`Simd`, `Math/Matrix`   |   Helpers for `Simd(T, N)` vectors and `Matrix(T, R, C)` values   |   `Simd` Vectors and `Matrix` Values"
    );
    table_row(
        44,
        "`Math/NumberTheory`   |   gcd, modular arithmetic, primes, binomials, integer square roots   |   Standard library reference"
    );
    table_row(
        45,
        "`Math/Bignum`   |   `BigInt` and `BigFloat`, arbitrary-precision numbers   |   Standard library reference"
    );
    table_row(
        46,
        "`Math/SpecialFunctions`   |   Gamma, error, Bessel, Airy, zeta and hypergeometric functions   |   Standard library reference"
    );
    table_row(
        47,
        #string,oneline
            \\`Random`   |   Sampling through the context's generator, deterministic
            \\engines such as `Pcg32`, operating-system entropy, probability
            \\distributions   |   `#Context` and `context`
    );
    subheading(48, "The operating system");
    table_header(49, "Import   —   For   —   See");
    table_row(
        50,
        "`File_System/File`   |   `File` handles: open, read, write, seek; `read_file` and `write_file`   |   Files, Handles, and Non-Memory Resources"
    );
    table_row(
        51,
        "`File_System/Path`   |   Path manipulation that never touches the disk   |   Standard library reference"
    );
    table_row(
        52,
        "`File_System/Directory`, `File_System/Walk`   |   Creating, listing and removing directories; user directories; recursive traversal   |   Standard library reference"
    );
    table_row(
        53,
        "`File_System/Metadata`, `File_System/System`   |   File status, permissions, links, locks; the current directory, canonical paths, globbing   |   Standard library reference"
    );
    table_row(
        54,
        #string,oneline
            \\`File_System/Copy`, `File_System/Atomic`, `File_System/Temporary`,
            \\`File_System/Map`, `File_System/Watch`,
            \\`File_System/Sandbox`   |   Copies, atomic replacement, temporary
            \\files, memory-mapped files, change polling, handle-relative
            \\access   |   Standard library reference
    );
    table_row(
        55,
        "`Process`   |   Process ids, `process_abort`, exit-status records, `Process_Error`   |   Feature Gates and Runtime Checks"
    );
    table_row(
        56,
        "`Process/Command`   |   Building a command, spawning and waiting for children, capturing output with `run_command`   |   Standard library reference"
    );
    table_row(
        57,
        "`Process/Environment`   |   Environment variables   |   Appendix E: Environment, Toolchain, and Exit Codes"
    );
    table_row(
        58,
        "`Command_Line`   |   Parsing flags, options, positional arguments and subcommands against a textual specification, with generated help text   |   Standard library reference"
    );
    table_row(
        59,
        #string,oneline
            \\`Process/Arguments`, `Process/Pipe`, `Process/Signals`,
            \\`Process/Inspection`, `Process/Limits`, `Process/Scheduling`,
            \\`Process/System`, `Process/User`   |   Response files, pipes,
            \\signals, process handles, resource limits, priority and affinity,
            \\host information, the current user   |   Standard library reference
    );
    table_row(
        60,
        "`Time`   |   `Duration`, `Instant`, clocks, sleeping, deadlines, calendar dates, ISO 8601 and RFC 3339 text, time zones   |   Standard library reference"
    );
    table_row(
        61,
        #string,oneline
            \\`Thread`   |   `Thread`, `thread_scope`, `Thread_Pool`, `Mutex`,
            \\`Condvar`, `Channel`, and `Atomic` and `Once`
            \\re-exported   |   `spawn_owned`, `thread_scope`, and `Thread_Pool`;
            \\`Mutex`, `Condvar`, `Channel`, `Once`, and `Atomic`
    );
    table_row(
        62,
        "`Thread/Task`, `Thread/Shared`   |   `spawn_owned` and `Task(R)`; `Shared(T)`   |   `spawn_owned`, `thread_scope`, and `Thread_Pool`; `Mutex`, `Condvar`, `Channel`, `Once`, and `Atomic`"
    );
    table_row(
        63,
        "`Dynamic_Library`   |   Loading a shared library at run time and looking up its symbols   |   Files, Handles, and Non-Memory Resources"
    );
    table_row(
        64,
        #string,oneline
            \\`Net/Socket`, `Net/Address`, `Net/Dns`, `Net/Http`, `Net/Https`,
            \\`Net/Http_Server`, `Net/Url`, `Net/WebSocket`, `Net/Tls`, `Net/Poll`
            \\and others   |   Sockets, addresses, name resolution, HTTP clients and
            \\a small server, URLs, WebSocket, TLS, readiness polling   |   Files,
            \\Handles, and Non-Memory Resources
    );
    subheading(65, "Security, data formats, and media");
    table_header(66, "Import   —   For   —   See");
    table_row(
        67,
        #string,oneline
            \\`Crypto/Sha2`, `Crypto/Sha3`, `Crypto/Hmac`, `Crypto/Kdf`,
            \\`Crypto/AesGcm`, `Crypto/ChaCha20Poly1305`, `Crypto/Encoding`,
            \\`Crypto/Random` and others   |   Hashes, HMAC, key derivation,
            \\authenticated encryption, hex and Base64, constant-time comparison,
            \\secure random bytes   |   Standard library reference
    );
    table_row(
        68,
        #string,oneline
            \\`Serialization/Core`, `Serialization/Json`, `Serialization/Toml`,
            \\`Serialization/Yaml`, `Serialization/MessagePack`   |   The
            \\`Serialize` and `Deserialize` classes, with derive macros, and four
            \\formats   |   `#derive`
    );
    table_row(
        69,
        "`Image`   |   Reading and writing PNG, JPEG and WebP as RGBA8 images   |   Standard library reference"
    );
    table_row(
        70,
        "`Archive`   |   Reading and safely extracting ZIP archives   |   Standard library reference"
    );
    table_row(
        71,
        "`Gui`   |   Native windows on Windows and Linux, scene rendering, input events, immediate-mode widgets   |   Standard library reference"
    );
    subheading(72, "The language and the compiler");
    table_header(73, "Import   —   For   —   See");
    table_row(
        74,
        "`Meta`   |   Type reflection: `type_of`, `type_name`, `size_of`, fields, enum members, predicates such as `Is_Integer`   |   `type` Values and Type Reflection"
    );
    table_row(
        75,
        #string,oneline
            \\`Typeclass`   |   The `Error` reporting protocol, support for derive
            \\macros, `Functor`, `Applicative` and `Monad`; each also importable
            \\alone, as `Typeclass/Error` and so on   |   `Try`, `?`, `#try`, and
            \\`Termination`; `#derive`; Associated Types and Typeclasses over
            \\Constructors
    );
    table_row(
        76,
        "`Jump`   |   Execution contexts, exceptions, coroutines and a scheduler built on `goto`   |   Labels, `goto`, and Non-Local Transfers"
    );
    table_row(
        77,
        "`Compiler`   |   Compile-time build helpers: finding headers and libraries, running nested builds, build options   |   Build Scripts and Compile-Time Arguments"
    );
    table_row(
        78,
        "`Bindgen`   |   Generating declarations from C headers at compile time   |   C Types, Callbacks, and Bindgen"
    );
    table_row(
        79,
        "`Glosso`   |   The compiler front end as a library, through libglosso's C ABI: token streams, checking, compile-time execution and Bindgen, for formatters, language servers and other back ends; `Glosso/Paths` locates an installation   |   Modules, Imports, and the Prelude"
    );
    table_row(
        80,
        "`Lua`   |   The Lua 5.5 C API with a runtime built from bundled sources   |   The `Lua` Module"
    );
    table_row(
        81,
        "`VarArg`   |   C `va_list` and the `vprintf` family   |   `#foreign`, `#library`, and `#c_call`"
    );
    table_row(
        82,
        "`Os`   |   The platform layer the other modules are built on; not meant for programs   |   Standard library reference"
    );
}

render_section_96 :: () {
    paragraph(
        0,
        #string,oneline
            \\This appendix collects what the compiler takes from its surroundings
            \\and what it gives back: the environment variables it reads, the tools
            \\and libraries it uses to produce an artifact, and its exit status. The
            \\command-line options are described in Compiler Options and Output
            \\Kinds. A program reads its own environment through the
            \\`Process/Environment` module (`environment_get`,
            \\`environment_get_or`); the variables below concern the compiler.
    );
    subheading(1, "Environment variables");
    paragraph(
        2,
        #string,oneline
            \\Every variable is optional. A variable that names a path counts as
            \\unset when it is empty. A switch is on when the variable is set, to
            \\any value, unless the table gives another rule. A command-line option
            \\that covers the same ground takes precedence.
    );
    table_header(3, "Variable   —   Effect");
    table_row(
        4,
        "`GLOSSO_STD`   |   The standard library directory, tried first when `--std` is not given (see Compiler Options and Output Kinds)."
    );
    table_row(
        5,
        "`GLOSSO_CACHE_DIR`   |   The cache directory; must be absolute. Without it the cache is `$XDG_CACHE_HOME/glosso` when that is absolute, else `~/.cache/glosso` (`~/Library/Caches/glosso` on macOS, the local application data folder on Windows). See Inside a Build: Stages and Caches."
    );
    table_row(
        6,
        "`GLOSSO_NATIVE_CACHE_DIR`   |   Where C archives built at compile time are cached; must be absolute."
    );
    table_row(
        7,
        "`GLOSSO_DISABLE_ARTIFACT_CACHE`, `GLOSSO_DISABLE_PARSE_CACHE`   |   Do not use the artifact cache, or the cache of parsed standard library files (see Inside a Build: Stages and Caches)."
    );
    table_row(
        8,
        "`GLOSSO_DEBUG_ALLOCATOR`   |   A value other than `0` makes the debug allocator the default `context.allocator` of the built program (see `Allocator` and Allocation Procedures)."
    );
    table_row(
        9,
        "`GLOSSO_COMPTIME_STEP_LIMIT`   |   How many instructions one compile-time evaluation may run before it is stopped as endless: 268435456 by default, `0` for no limit. Build Scripts and Compile-Time Arguments lists the other limits of compile-time code."
    );
    table_row(
        10,
        "`GLOSSO_CODEGEN_UNITS`   |   How many objects a Linux build is split into for parallel code generation, 1 to 64. By default it depends on the program's size and the number of CPUs, at most 8."
    );
    table_row(
        11,
        "`GLOSSO_NO_PRUNE`   |   Translate every declaration rather than only those the program reaches. The output is the same."
    );
    table_row(
        12,
        "`GLOSSO_PRECHECK_STD`   |   Check every standard library constant and generic, not only those the program reaches; for work on the library."
    );
    table_row(13, "`GLOSSO_TIMINGS`   |   Print the time each compiler phase took.");
    table_row(
        14,
        "`GLOSSO_LLVM_TIMING`   |   Print the time LLVM's passes and object emission took, and the pass pipeline used."
    );
    table_row(
        15,
        "`GLOSSO_LLVM_VERIFY`   |   A value other than `0` runs LLVM's verifier on the generated module."
    );
    table_row(
        16,
        "`GLOSSO_LLVM_OBJECT_PIPELINE`   |   Replace the LLVM pass pipeline run during code generation; `none` runs no passes."
    );
    table_row(
        17,
        "`GLOSSO_JIT`, `GLOSSO_JIT_REPORT`, `GLOSSO_JIT_DUMP`   |   Run top-level `#comptime` code compiled by LLVM's JIT instead of the interpreter when the build targets the host and has one such entry; print what could be compiled; write each compiled module to the named directory."
    );
    table_row(
        18,
        "`NO_COLOR`, `TERM`   |   `NO_COLOR` with any value turns color off, even under `--color always`. With `--color auto`, an empty or `dumb` `TERM` turns off color and the progress display (see Appendix A: Diagnostic Format)."
    );
    paragraph(
        19,
        #string,oneline
            \\The variables that locate the toolchain and the target libraries are
            \\described in the next section. At compile time, `find_header` and
            \\`find_library` of the `Compiler` module also search the directories
            \\listed in `INCLUDE`, `CPATH`, `C_INCLUDE_PATH` and
            \\`CPLUS_INCLUDE_PATH`, and in `LIB`, `LIBRARY_PATH` and
            \\`LD_LIBRARY_PATH` (see Build Scripts and Compile-Time Arguments). This
            \\is the step limit at work on a top-level `#comptime` block that never
            \\ends:
    );
    code_block(
        20,
        "text",
        #string
            \\$ GLOSSO_COMPTIME_STEP_LIMIT=1000 glosso compile steps.glo
            \\glosso: compile steps.glo (target=x86_64-pc-linux-gnu)
            \\error: #comptime stopped: compile-time evaluation did not finish within 1000 VM instructions and may never terminate; set GLOSSO_COMPTIME_STEP_LIMIT to change the limit, or to 0 to remove it
            \\VM trace: __run_0 word 11 (Jmp) at steps.glo:1:21
    );
    subheading(21, "The toolchain");
    paragraph(
        22,
        #string,oneline
            \\LLVM, its linker LLD and the C front end of Clang are built into the
            \\compiler. Code generation, linking, writing static libraries and
            \\reading C headers for bindings all happen inside the compiler
            \\process, so an ordinary build runs no other program. What a build
            \\needs from outside are the target's runtime libraries: C runtime
            \\start files, the C library, compiler-rt builtins and import
            \\libraries. They come from the Glosso library bundle, a `lib`
            \\directory with one subdirectory per target, such as
            \\`lib/x86_64-linux-gnu` for a Linux build against glibc.
    );
    paragraph(
        23,
        #string,oneline
            \\The bundle and the other resources are looked for under a list of
            \\roots: `GLOSSO_RESOURCE_DIR`, `GLOSSO_LIB_DIR`, the current directory,
            \\the compiler's own directory and its parent and grandparent. A
            \\compiler at `prefix/bin/glosso` thus finds `prefix/lib` from any
            \\working directory.
    );
    table_header(24, "Variable   —   Supplies");
    table_row(25, "`GLOSSO_LIB_DIR`   |   The library bundle.");
    table_row(
        26,
        "`GLOSSO_RESOURCE_DIR`   |   The Glosso project or installation root, for resources such as bundled C sources; an error when it is neither."
    );
    table_row(
        27,
        "`GLOSSO_COMPILER_EXE`   |   The path treated as the compiler's own when deriving the roots above and the standard library candidates."
    );
    table_row(
        28,
        "`GLOSSO_CLANG_RESOURCE_DIR`   |   The Clang resource directory, with Clang's own headers."
    );
    table_row(
        29,
        "`GLOSSO_MUSL_SOURCE_DIR`, `GLOSSO_MUSL_LIB_DIR`, `GLOSSO_MUSL_LIBRARY_PATH`   |   The musl sources, a prebuilt musl runtime, and extra library directories for `*-linux-musl` targets."
    );
    table_row(
        30,
        "`GLOSSO_WINDOWS_GNU_LIB_DIR`, `GLOSSO_WINDOWS_GNU_INCLUDE_DIR`   |   The mingw-w64 import libraries and headers for `*-windows-gnu` targets."
    );
    subheading(31, "External tools");
    paragraph(
        32,
        #string,oneline
            \\A few builds do run an external program. A sanitized build is linked
            \\by `clang` (see `--memory-sanitizer` and `--thread-sanitizer`), as is
            \\a Linux build for the host when the bundle has no C runtime for it.
            \\Setting a linker variable from the table below makes the compiler run
            \\that linker instead of its built-in LLD, and `GLOSSO_EMBEDDED_LLD` set
            \\to `0`, `off`, `no` or `false` makes it run the LLD driver it finds by
            \\the search below.
    );
    table_header(33, "Tool   —   Variables, first set one wins");
    table_row(34, "`clang`   |   `GLOSSO_CLANG`, `CLANG`, `CC`");
    table_row(35, "`ld.lld` (ELF)   |   `GLOSSO_LD_LLD`, `LD_LLD`");
    table_row(36, "`lld-link` (Windows)   |   `GLOSSO_LLD_LINK`, `LLD_LINK`");
    table_row(37, "`ld64.lld` (macOS)   |   `GLOSSO_LD64_LLD`, `LD64_LLD`");
    table_row(38, "`wasm-ld` (WebAssembly)   |   `GLOSSO_WASM_LD`, `WASM_LD`");
    table_row(
        39,
        "`llvm-ar`, `llvm-lib`   |   `GLOSSO_LLVM_AR`, `LLVM_AR`, `AR`; `GLOSSO_LLVM_LIB`, `LLVM_LIB` (only for a compiler built without the in-process archive writer)"
    );
    paragraph(
        40,
        #string,oneline
            \\When none of a tool's variables is set, the compiler looks for the
            \\tool in the `bin` directory of each LLVM root and of the
            \\target-named directories one level below it. The roots are
            \\`GLOSSO_LLVM_ROOT`, `LLVM_ROOT`, then `llvm` and the directory itself
            \\for the directory above the compiler's own and the one above that.
            \\The bare name, found on `PATH`, is the last resort. The current
            \\directory is never searched for tools.
    );
    code_block(
        41,
        "text",
        #string
            \\$ GLOSSO_LD_LLD=/opt/none/ld.lld glosso compile hello.glo
            \\glosso: compile hello.glo (target=x86_64-pc-linux-gnu)
            \\glosso: link hello (target=x86_64-pc-linux-gnu, -O1)
            \\error: could not run linker /opt/none/ld.lld: No such file or directory (os error 2)
    );
    subheading(42, "The compiler's exit status");
    table_header(43, "Situation   —   Status");
    table_row(
        44,
        "The requested work was done, including `--help`, `--print-targets` and `--print-cache-dir`   |   0"
    );
    table_row(
        45,
        "Errors in the program, a failed link, an unreadable source file, `--run` for a target that is not the host, an unusable cache directory   |   1"
    );
    table_row(
        46,
        "The command line was rejected: an unknown command or option, a missing or bad value, no source file, two sanitizers   |   2"
    );
    table_row(47, "Compile-time code called `exit(n)`   |   n");
    table_row(
        48,
        "`--run` and the program exited with a nonzero status   |   The program's status; 128 plus the signal number for a signal."
    );
    table_row(49, "The compiler itself crashed (an internal error)   |   101");
    paragraph(
        50,
        #string,oneline
            \\A rejected command line prints the reason and the summary of the
            \\commands or of the `compile` options. A call of `exit` during
            \\compile-time execution ends the compiler at that point with the given
            \\status, even 0, and no artifact is written; a build script uses it to
            \\report its own result (see Compile-Time Evaluation).
    );
    code_block(
        51,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\#comptime {
            \\    print("stopping the build\n");
            \\    exit(7);
            \\}
            \\
            \\main :: () { print("never built\n"); }
    );
    code_block(
        52,
        "text",
        #string
            \\$ glosso compile stop.glo; echo $?
            \\glosso: compile stop.glo (target=x86_64-pc-linux-gnu)
            \\stopping the build
            \\7
    );
    paragraph(
        53,
        #string,oneline
            \\The `glosso:` progress lines and diagnostics go to standard error; the
            \\output of compile-time code and of a program started by `--run` goes
            \\to standard output. A built program's own status comes from `main`
            \\through the `Termination` typeclass (see What a Program Is and `Try`,
            \\`?`, `#try`, and `Termination`), from `exit`, or is 134 after a failed
            \\runtime check (see Feature Gates and Runtime Checks).
    );
}

render_section_97 :: () {
    paragraph(
        0,
        #string,oneline
            \\These conventions describe how the standard library is written. Code
            \\that follows them reads like the library it calls, which is the main
            \\reason to have a style at all. A few of the rules are enforced by the
            \\compiler, and the text says which; the rest are conventions. Each
            \\section names the reference chapters behind its rules.
    );
    subheading(1, "Naming");
    table_header(2, "Kind   —   Convention   —   Examples");
    table_row(
        3,
        "Struct, union, enum and `distinct` types   |   Capitalized words joined by `_`   |   `String_Builder`, `Io_Error`, `Terminal_Canvas`"
    );
    table_row(
        4,
        "Names known from other libraries   |   Their usual spelling   |   `HashMap`, `BTreeMap`, `BigInt`"
    );
    table_row(
        5,
        "Typeclasses   |   Capitalized, one word where one is enough   |   `Show`, `Freeable`, `Iterable`, `PartialEq`"
    );
    table_row(
        6,
        "Procedures, methods, variables, parameters, fields   |   Lower case joined by `_`   |   `read_file`, `get_or_insert`, `free_head`"
    );
    table_row(
        7,
        "Constants   |   Upper case joined by `_`   |   `STOCK_LIMIT`, `PROCESS_ID_MAX`, `PI`"
    );
    table_row(
        8,
        "Enum members, union variants   |   Like types   |   `.Invalid_Argument`, `.Not_Enough`, `.Ok`"
    );
    table_row(
        9,
        "Type parameters, associated types   |   One capital letter, or a capitalized word   |   `$T`, `$K`, `$V`, `Output`"
    );
    table_row(
        10,
        "Modules   |   Like types; a directory module's entry file is `module.glo`   |   `String_Builder`, `File_System/Path`"
    );
    table_row(
        11,
        "Public declarations meant for internal use   |   Two leading underscores   |   `__Pool_Slot`, `__format_into_fresh`"
    );
    paragraph(
        12,
        #string,oneline
            \\The compiler does not care about case, with one exception: a public
            \\declaration may not take the name of a built-in type such as `s32` or
            \\`str`, because every importer would see it in place of the type (see
            \\Who Can Use a Declaration: Visibility and Units). Identifiers,
            \\Reserved Words, and Directives gives the rules for names.
    );
    paragraph(
        13,
        #string,oneline
            \\Importers see a module's procedures without a prefix, so a free
            \\procedure in a library names its subject: `environment_get`,
            \\`random_index`, `zip_extract_file`. A method needs no prefix, because
            \\its receiver says it: `map.insert`, `file.close`. A few suffixes have
            \\one meaning across the library: `_by` takes a comparison, equality
            \\or hashing callback (`sort_by`), `_with` takes an extra cleanup
            \\callback (`clear_with`), and `_checked` returns `null` where the
            \\plain operation would overflow (`add_checked`). Predicates start with
            \\`is_` or `has_`. Error types end in `_Error`, and an error that
            \\carries details pairs
            \\with a `_Kind` enum, as `Io_Error` with `Io_Error_Kind`.
            \\Constructors are `new` and `with_...`; releasing is `free`, with
            \\`reset` for an owner that stays usable and `close` for a handle.
    );
    subheading(14, "Layout");
    bullet(15, "Indent by four spaces. Do not use tabs.");
    bullet(
        16,
        #string,oneline
            \\Keep lines within about 80 columns, as nineteen of every twenty lines
            \\of the standard library are; a long signature or condition may run
            \\over.
    );
    bullet(
        17,
        #string,oneline
            \\Put an opening brace at the end of the line that starts its
            \\construct, and write `} else {` on one line.
    );
    bullet(
        18,
        #string,oneline
            \\A body of one short statement may follow `if`, `while` or `for`
            \\without braces: `if text.count == 0 return .Err(.Empty);`. Use braces
            \\when the body or the condition needs more than one line.
    );
    bullet(
        19,
        #string,oneline
            \\Indent `case` labels one level inside `if x == {`, and put a short
            \\arm on its label's line.
    );
    bullet(
        20,
        #string,oneline
            \\Put spaces around binary operators, `=`, `:=` and `::`, and after
            \\commas; write prefix and postfix operators against their operand:
            \\`-x`, `!done`, `p.*`. The spaces are not only for looks: adjacent
            \\operator characters form one token, so `a =-1` is an error and `a =
            \\-1` is not (see Encoding, Comments, and Tokens).
    );
    bullet(
        21,
        #string,oneline
            \\Do not indent the declarations inside a `#public { }` group; its
            \\closing brace goes in the first column.
    );
    bullet(
        22,
        #string,oneline
            \\Annotate a variable's type only when the initializer does not give the
            \\type wanted: `count := 0;` is an `ssize`, `count: s64 = 0;` picks
            \\another type, and `count: s64;` is a zero `s64` (see Literal Typing
            \\and Type Conversion).
    );
    bullet(
        23,
        #string,oneline
            \\Aligning the values of a block of related constants or enum members
            \\in one column is common where it helps comparison.
    );
    paragraph(
        24,
        #string,oneline
            \\A small module written this way, and a program that uses it:
    );
    code_block(
        25,
        "glosso",
        #string
            \\// inventory.glo
            \\//! Stock records for a small shop.
            \\
            \\#import "Format";
            \\
            \\#public {
            \\/// The largest count one item may reach.
            \\STOCK_LIMIT :: 10_000;
            \\
            \\/// Why a stock operation was refused.
            \\Stock_Error :: enum {
            \\    Over_Limit;
            \\    Not_Enough;
            \\}
            \\
            \\/// One kind of item and how many are on hand.
            \\Item :: struct {
            \\    name: str;
            \\    count: s64;
            \\}
            \\}
            \\
            \\Item ::: #public {
            \\    /// Adds `amount`, refusing to pass `STOCK_LIMIT`.
            \\    restock :: (*#self, amount: s64) -> Stock_Error!void {
            \\        if #self.count + amount > STOCK_LIMIT return .Err(.Over_Limit);
            \\        #self.count += amount;
            \\        return .Ok;
            \\    }
            \\
            \\    /// Removes `amount`, refusing to go below zero.
            \\    take :: (*#self, amount: s64) -> Stock_Error!void {
            \\        if amount > #self.count return .Err(.Not_Enough);
            \\        #self.count -= amount;
            \\        return .Ok;
            \\    }
            \\
            \\    /// A one-line description in temporary memory.
            \\    describe :: (#self) -> str {
            \\        level := ifx #self.count == {
            \\            case 0;      "out of stock";
            \\            case 1..=9;  "low";
            \\            else;        "in stock";
            \\        };
            \\        return tprint("{}: {} ({})", #self.name, #self.count, level);
            \\    }
            \\}
    );
    code_block(
        26,
        "glosso",
        #string
            \\#import "Io";
            \\#import "inventory.glo";
            \\
            \\main :: () {
            \\    apples := Item.{ .name = "apples", .count = 3 };
            \\    print("{}\n", apples.describe());
            \\    if #pattern .Err(problem) = apples.take(5) print("refused: {}\n", problem);
            \\    _ := apples.restock(20);
            \\    print("{}\n", apples.describe());
            \\}
    );
    code_block(
        27,
        "text",
        #string
            \\apples: 3 (low)
            \\refused: Not_Enough
            \\apples: 23 (in stock)
    );
    subheading(28, "Files and modules");
    bullet(
        29,
        #string,oneline
            \\Order a file as the library does: a `//!` comment that says what the
            \\module is for, the imports, the public declarations, then the private
            \\helpers. A type's inherent block, `T ::: #public { ... }`, follows the
            \\type (see Inherent Methods, Member Access, and Call Syntax).
    );
    bullet(
        30,
        #string,oneline
            \\Declare a type's typeclass instances in the type's own module, next
            \\to the type, so that every importer of the type gets them.
    );
    bullet(
        31,
        #string,oneline
            \\Split a large library into a directory whose `module.glo` re-exports
            \\the component files with `#export`, as `Memory` and `Time` do. Users
            \\can then import the whole or one part (see Modules, Imports, and the
            \\Prelude, and Appendix D: Standard Library Modules).
    );
    bullet(
        32,
        #string,oneline
            \\Give the vocabulary that several components share, typically the
            \\error type, a component of its own, as `Container/Error` and
            \\`Net/Types` are.
    );
    subheading(33, "Imports");
    bullet(
        34,
        #string,oneline
            \\Write the `#import` lines at the top of the file, one per line.
    );
    bullet(
        35,
        #string,oneline
            \\Import every module whose names the file uses, even when another
            \\import loads it; imports do not chain, so nothing else works anyway.
    );
    bullet(
        36,
        #string,oneline
            \\Import the component a file needs (`Memory/Ownership`) rather than
            \\its umbrella when one component is enough.
    );
    bullet(
        37,
        #string,oneline
            \\Plain imports are the rule in the standard library. Use an import
            \\list or a namespace alias (`Native :: #import "native.glo";`) when
            \\names collide, or when a module's names are too generic to read well
            \\unqualified.
    );
    subheading(38, "Visibility");
    bullet(
        39,
        #string,oneline
            \\A declaration is private to its module until it is marked. Put the API
            \\in `#public { }` groups and leave helpers outside them (see Who Can
            \\Use a Declaration: Visibility and Units).
    );
    bullet(
        40,
        #string,oneline
            \\Use `#public,unit` for names that the files of one library share but
            \\its users should not see; the platform files of the `Os` module are
            \\declared this way.
    );
    bullet(
        41,
        #string,oneline
            \\Mark fields `#private` when they hold an invariant. When fields must
            \\stay public, for instance so that a zero value is valid, say in the
            \\type's documentation that they are internal.
    );
    bullet(
        42,
        #string,oneline
            \\A public signature may only use types at least as visible as itself;
            \\the compiler enforces this.
    );
    subheading(43, "Errors");
    bullet(
        44,
        #string,oneline
            \\Report a failure the caller can act on as a result `E!T`, and pass it
            \\up with `?`. Use `?T` for a value that may be absent without anything
            \\having gone wrong, as `HashMap.get` does for a missing key (see `?T`
            \\and `E!T`).
    );
    bullet(
        45,
        #string,oneline
            \\Make an error type an enum when a list of reasons is enough, and a
            \\struct with a `_Kind` enum and the details (the operation, a native
            \\error code) when callers need more.
    );
    bullet(
        46,
        #string,oneline
            \\Implement `Error` from `Typeclass/Error` for an error type that can
            \\reach `main`, so that `main :: () -> E!void` reports it and exits with
            \\status 1 (see `Try`, `?`, `#try`, and `Termination`).
    );
    bullet(
        47,
        #string,oneline
            \\Treat a broken precondition, a mistake in the calling code rather than
            \\a condition of the environment, as fatal: check it with `#assert` or
            \\let a runtime check stop the program, and document it (see Feature
            \\Gates and Runtime Checks).
    );
    bullet(
        48,
        #string,oneline
            \\The compiler lets a statement drop a result. When dropping one is
            \\intended, say so with `_ := f();`, as the standard library does.
    );
    code_block(
        49,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\#import "Typeclass/Error";
            \\
            \\Parse_Error :: enum {
            \\    Empty;
            \\    Not_A_Digit;
            \\}
            \\
            \\Parse_Error ::: instance Error {
            \\    report_error :: (error: Parse_Error) {
            \\        ("parse").error_report_line(tprint("{}", error));
            \\    }
            \\}
            \\
            \\parse_digit :: (text: str) -> Parse_Error!s64 {
            \\    if text.count == 0 return .Err(.Empty);
            \\    c := text[0];
            \\    if c < #char "0" || c > #char "9" return .Err(.Not_A_Digit);
            \\    return .Ok(cast(s64) (c - #char "0"));
            \\}
            \\
            \\sum_digits :: (a: str, b: str) -> Parse_Error!s64 {
            \\    return .Ok(parse_digit(a)? + parse_digit(b)?);
            \\}
            \\
            \\main :: () -> Parse_Error!void {
            \\    print("{}\n", sum_digits("4", "5")?);
            \\    print("{}\n", sum_digits("4", "x")?);
            \\    return .Ok;
            \\}
    );
    code_block(
        50,
        "text",
        #string
            \\$ glosso compile --run digits.glo 2>&1 | tail -3
            \\9
            \\parse: Not_A_Digit
            \\glosso: program exited with status 1
    );
    subheading(51, "Ownership");
    bullet(
        52,
        #string,oneline
            \\Release every owner explicitly, and register the release with `defer`
            \\on the line after the owner is created, where a reader checks for it
            \\(see `Freeable`, Copies, and Ownership Transfer).
    );
    bullet(
        53,
        #string,oneline
            \\To hand an owner to the caller, keep the `defer` and return
            \\`value_take(&x)`: the caller receives the contents and the deferred
            \\`free` releases an empty value.
    );
    bullet(
        54,
        #string,oneline
            \\Give a procedure that allocates on its caller's behalf a last
            \\parameter `allocator := context.allocator`, as `format` and the
            \\container constructors have (see `Allocator` and Allocation
            \\Procedures).
    );
    bullet(
        55,
        #string,oneline
            \\State ownership in the documentation: who owns the result and how to
            \\release it, how long a returned view stays valid, and whether a
            \\result lives in temporary memory.
    );
    code_block(
        56,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Memory/Ownership";
            \\
            \\/// The squares of 1 to `n`. The caller owns the result; release it
            \\/// with `free`.
            \\squares :: (n: s64) -> [..]s64 {
            \\    result: [..]s64;
            \\    defer result.free();
            \\    for i: 1..=n result.push(i * i);
            \\    return value_take(&result);
            \\}
            \\
            \\main :: () {
            \\    values := squares(4);
            \\    defer values.free();
            \\    print("{} values, last {}\n", values.count, values[values.count - 1]);
            \\}
    );
    code_block(
        57,
        "text",
        #string
            \\4 values, last 16
    );
    subheading(58, "Compile time");
    bullet(
        59,
        #string,oneline
            \\A top-level constant is computed while compiling whatever its value
            \\is, so `LIMIT :: 4 * 1024;` needs no directive. Write `#comptime`
            \\before a value that runs real code, such as a table built by a loop,
            \\to make that visible (see Compile-Time Evaluation).
    );
    bullet(
        60,
        #string,oneline
            \\Select platform code with `#if OUT.os == Target_OS.Windows { ... }`,
            \\the form the standard library uses (see `#if`, `#assert`, and
            \\`#compile_error`), and keep larger platform implementations in files
            \\of their own, as the `Os` module keeps `Linux.glo`, `Windows.glo` and
            \\`Wasm.glo`.
    );
    bullet(
        61,
        #string,oneline
            \\Make a parameter `#comptime` only when the procedure must know it
            \\while compiling, as `print` does with its format string (see
            \\`noalias`, `#lazy`, `#comptime`, and Type Parameters).
    );
    bullet(
        62,
        #string,oneline
            \\Reach for generic procedures and typeclasses first. Use `#insert` and
            \\`#expand` when source text must itself be computed, as for bindings
            \\and derive macros (see `#code`, `#insert`, and `#expand`).
    );
    subheading(63, "Operators");
    bullet(
        64,
        #string,oneline
            \\Give a type an operator through an instance of the prelude's class,
            \\such as `Add` or `PartialEq`, so that it works wherever that class is
            \\used, and keep the usual meaning: `+` combines, `==` is an equivalence
            \\(see Operator Declarations and `PartialEq`, `PartialOrd`, and `Hash`).
    );
    bullet(
        65,
        #string,oneline
            \\Declare a new operator spelling only for a notation readers already
            \\know; otherwise a named procedure is clearer.
    );
    bullet(
        66,
        #string,oneline
            \\Parenthesize a bitwise operator mixed with a comparison; the compiler
            \\warns about the mix (see Precedence Levels and Associativity).
    );
    bullet(
        67,
        #string,oneline
            \\Where overflow is intended, say so with the wrapping (`+%`) or
            \\saturating (`+|`) operators rather than a cast (see Integer
            \\Arithmetic, Overflow, and Traps).
    );
    subheading(68, "Comments and documentation");
    bullet(
        69,
        #string,oneline
            \\Put a `///` comment directly above each public declaration: what it
            \\does and returns, who owns the result, how it fails, and what the
            \\caller must guarantee. Write sentences, with code in backticks.
            \\Encoding, Comments, and Tokens describes the comment forms.
    );
    bullet(
        70,
        #string,oneline
            \\Open a module file with a `//!` comment that says what the module is
            \\for and, for a component, how to import it.
    );
    bullet(
        71,
        #string,oneline
            \\Use plain `//` comments for implementation notes: why the code does
            \\what it does, not a restatement of it.
    );
    paragraph(
        72,
        #string,oneline
            \\To the compiler all three are ordinary comments. The generator of
            \\this site's Standard library reference reads them. It takes a
            \\module's summary from the `//!` lines of the comment block that opens
            \\the file, and a declaration's summary from the `///` lines directly
            \\above it: plain `//` lines may be mixed in and are skipped, and a
            \\blank line ends the block. A comment that starts with four slashes is
            \\not documentation. The lines are joined into one paragraph, and only
            \\public declarations are listed, not `#public,unit` ones.
    );
}

}
