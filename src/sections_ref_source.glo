#import "Format";
#import "String_Builder";
#import "Math/Core";
#import "clay_ui.glo";

#public {

// Chapters 21-24: Source Text.

render_section_21 :: () {
    paragraph(
        0,
        #string,oneline
            \\A Glosso source file is UTF-8 text. The compiler decodes it into
            \\Unicode code points and cuts the code points into tokens: names and
            \\keywords, literals, directives, punctuation and operators. Whitespace
            \\and comments only separate tokens and leave nothing behind once the
            \\file is cut. This chapter describes what the compiler accepts as
            \\source text, the two forms of comment, how positions in a file are
            \\counted, and the symbols that stand between the words of a program:
            \\punctuation, whose meaning is fixed, and operators, which are
            \\declarations that the compiler collects before it parses a module.
            \\Names, keywords and directives are the subject of Identifiers,
            \\Reserved Words, and Directives; literals are described in Number
            \\Literals and in Text and Character Literals.
    );
    subheading(1, "Encoding");
    paragraph(
        2,
        #string,oneline
            \\Every source file must be valid UTF-8. No other encoding is
            \\recognized, and none is guessed. The root file is checked before
            \\anything else is done with it, and an invalid byte stops the build
            \\with the byte's offset and exit status 1:
    );
    code_block(
        3,
        "text",
        #string
            \\$ glosso latin1.glo
            \\glosso: latin1.glo is not valid UTF-8 (invalid byte at offset 19)
    );
    paragraph(
        4,
        #string,oneline
            \\A module reached through `#import` is checked when it is read. An
            \\invalid byte in it is reported at the import that names the module,
            \\as `error: could not read` followed by the module's path and `stream
            \\did not contain valid UTF-8`. The importing module then also reports
            \\every name it expected from that module.
    );
    paragraph(
        5,
        #string,oneline
            \\A UTF-8 byte order mark (U+FEFF) at the very start of a file is
            \\skipped, so a file saved by an editor that writes one compiles
            \\unchanged. Anywhere else in the file the same character is an error,
            \\like any other character that cannot start a token.
    );
    subheading(6, "Whitespace and line endings");
    paragraph(
        7,
        #string,oneline
            \\Four characters are whitespace: space, horizontal tab, line feed and
            \\carriage return. A line feed ends a line. A carriage return is
            \\skipped wherever it appears, so a file saved with CRLF line endings
            \\compiles exactly like one saved with LF. The value of a literal does
            \\not depend on the line endings either: a CRLF line break inside a
            \\quoted string is stored as one line feed, and the lines of a
            \\`#string` block drop their trailing carriage return.
    );
    paragraph(
        8,
        #string,oneline
            \\Layout has no meaning. Indentation is free, statements and
            \\declarations end with `;`, and a construct may span as many lines as
            \\it needs. Whitespace is required only where two tokens would
            \\otherwise run together: between two words, and between operator
            \\characters that are meant as separate operators, as the section on
            \\operator characters below explains.
    );
    subheading(9, "Characters that cannot start a token");
    paragraph(
        10,
        #string,oneline
            \\No other character is whitespace, the Unicode spaces included, and a
            \\character that cannot start a token is an error. When the character
            \\would be invisible in the message, the message gives its code point
            \\instead, and for the common ones also its name:
    );
    code_block(
        11,
        "text",
        #string
            \\// x := 1;   followed by a no-break space pasted from a web page
            \\error: unexpected character U+00A0 (no-break space)
            \\// a form feed left in as a page break
            \\error: unexpected character U+000C (form feed)
            \\// 🙂 := 1;
            \\error: unexpected character '🙂'
    );
    paragraph(
        12,
        #string,oneline
            \\The characters named this way include the vertical tab, the form
            \\feed, the no-break spaces, the zero-width space and the joiners, the
            \\line and paragraph separators, the ideographic space, and a byte
            \\order mark after the start of the file. A lexical error ends the scan
            \\of its file, so it is the only error reported for that file, even
            \\when later lines have mistakes of their own.
    );
    subheading(13, "Line comments");
    paragraph(
        14,
        #string,oneline
            \\`//` starts a comment that runs to the end of the line. Everything
            \\after it on that line is ignored, including quotation marks and
            \\`/*`.
    );
    code_block(
        15,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\// Prints the area of a 3 by 4 rectangle.
            \\main :: () {
            \\    width := 3;   // centimetres
            \\    height := 4;
            \\    print("{}\n", width * height);   // "12"
            \\}
    );
    code_block(
        16,
        "text",
        #string
            \\12
    );
    paragraph(
        17,
        #string,oneline
            \\Because the comment always runs to the end of the line, it can
            \\swallow code that was meant to stay. A division mistyped as `//`
            \\turns the rest of its line into a comment, and the error appears
            \\where the parser next looks for the `;` it lost:
    );
    code_block(
        18,
        "text",
        #string
            \\// main :: () {
            \\//     y := 4 //2;
            \\// }
            \\error: unexpected token '}'
    );
    subheading(19, "Block comments");
    paragraph(
        20,
        #string,oneline
            \\`/*` starts a comment that `*/` ends. Block comments nest: each `/*`
            \\inside the comment needs its own `*/`, so a region that already
            \\contains comments can be commented out as a whole. A block comment
            \\may span lines or sit between two tokens of one line.
    );
    code_block(
        21,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\/* outer
            \\   /* inner */
            \\   still inside the outer comment
            \\*/
            \\
            \\main :: () {
            \\    x := 1 /* inline */ + /* /* nested */ */ 2;
            \\    print("x = {}\n", x);
            \\    print("[{}]\n", "a // b /* c */");
            \\}
    );
    code_block(
        22,
        "text",
        #string
            \\x = 3
            \\[a // b /* c */]
    );
    paragraph(
        23,
        #string,oneline
            \\The last line of output shows that comments are recognized only
            \\between tokens: inside a string literal, `//` and `/*` are ordinary
            \\text. The reverse does not hold. A block comment is searched
            \\character by character for `/*` and `*/` and nothing else, so a `*/`
            \\written between quotation marks inside the comment still ends it:
    );
    code_block(
        24,
        "text",
        #string
            \\// /* the text "*/" ends early */
            \\error: unterminated string literal
    );
    paragraph(
        25,
        #string,oneline
            \\The comment closes after `"*`, and the quotation mark that follows
            \\opens a string literal that nothing closes. A `/*` without its `*/`
            \\is reported at the opening delimiter as `error: unterminated block
            \\comment`. A `*/` outside any comment is an operator token that
            \\nothing declares: `error: unexpected token '*/'`. Both comment forms
            \\begin only where a token can begin; written directly after an
            \\operator, `//` and `/*` become part of the operator, as described
            \\under operator characters below.
    );
    subheading(26, "Documentation comments");
    paragraph(
        27,
        #string,oneline
            \\To the compiler, `///` and `//!` are ordinary line comments. They
            \\are a convention of the standard library, and the library reference
            \\that accompanies this manual is generated from them. `//!` lines in
            \\the comment block that opens a file describe the module. `///` lines
            \\directly above a declaration describe that declaration; plain `//`
            \\lines mixed into the block are left out of the description, and a
            \\blank line ends the block. A line that starts with four slashes is an
            \\ordinary comment, which is how the standard library draws its section
            \\rulers.
    );
    code_block(
        28,
        "glosso",
        #string
            \\//! geometry.glo - points in the plane.
            \\//!
            \\//! Import with `#import "geometry.glo"`.
            \\
            \\#import "Math/Core";
            \\
            \\#public {
            \\/// A point with `f64` coordinates.
            \\Point :: struct { x: f64; y: f64; }
            \\
            \\//// ---- measuring --------------------------------------------------
            \\
            \\/// Returns the Euclidean distance between `a` and `b`.
            \\// Implementation note: kept out of the reference.
            \\distance :: (a: Point, b: Point) -> f64 {
            \\    dx := a.x - b.x;
            \\    dy := a.y - b.y;
            \\    return sqrt(dx * dx + dy * dy);
            \\}
            \\}
    );
    subheading(29, "Positions in the source");
    paragraph(
        30,
        #string,oneline
            \\A diagnostic gives a position as a line and a column. Lines are
            \\counted from 1 at each line feed. Columns are counted from 1 in code points,
            \\not in bytes or screen cells: a tab is one column, and so is a Hangul
            \\syllable, although it takes three bytes in UTF-8 and two cells on a
            \\terminal. `#source_location` produces the same numbers for its own
            \\position, as a value of the prelude type `Source_Location` with the
            \\fields `filename`, `line` and `column`:
    );
    code_block(
        31,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    이름 := "한글"; here := #source_location;
            \\    print("line {}, column {}\n", here.line, here.column);
            \\}
    );
    code_block(
        32,
        "text",
        #string
            \\line 4, column 25
    );
    paragraph(
        33,
        #string,oneline
            \\Before the `#` stand four spaces, the two-syllable name, ` := `, the
            \\four-character literal `"한글"`, `;`, a space, `here` and ` := `: 24
            \\code points, so the directive is in column 25. `filename` is the path
            \\of the source file as the compiler was given it.
    );
    subheading(34, "Punctuation");
    paragraph(
        35,
        #string,oneline
            \\Between the words and literals of a program stand two kinds of
            \\symbol. Punctuation has a fixed meaning that the parser knows without
            \\looking anything up: `;`, braces, `::`, `->`. Operators, the subject
            \\of the rest of this chapter, are declarations. These are the
            \\punctuation tokens:
    );
    table_header(36, "Spelling   —   Meaning");
    table_row(37, "`;`   |   ends a statement or a declaration");
    table_row(38, "`,`   |   separates list items; never part of an operator");
    table_row(
        39,
        "`(` `)` `{` `}` `[` `]`   |   grouping, blocks and bodies, array types and indexing"
    );
    table_row(40, "`.`   |   member access; the name must touch it");
    table_row(41, "`.{` `.[` `.(`   |   struct literal, array literal, tuple literal");
    table_row(42, "`.*` `.&`   |   dereference and address-of, written after the operand");
    table_row(43, "`..` `..=`   |   exclusive and inclusive range");
    table_row(44, "`...`   |   variadic parameter and the rest of a pattern");
    table_row(45, "`:` `::` `:=` `::=`   |   annotation, constant, variable, compile-time variable");
    table_row(
        46,
        "`:::`   |   between a type and its methods, or an instance's types and `instance`"
    );
    table_row(47, "`=`   |   assignment");
    table_row(48, "`->`   |   return type");
    table_row(49, "`$`   |   introduces a generic type parameter, as in `$T`");
    table_row(50, "`?`   |   optional type `?T` and the propagation suffix `x?`");
    table_row(51, "`!`   |   result type `E!T`; also the prefix operator `!`");
    table_row(52, "`@`   |   binds a name to a whole pattern, as in `whole @ .{ .first, ... }`");
    table_row(53, "`,,`   |   a label of another procedure, as in `worker,,'entry`");
    table_row(54, "`'name`   |   a label, when no quote closes the name");
    table_row(55, "`'op'`   |   an operator named as a procedure, described below");
    table_row(56, "`#name`   |   a directive; see Identifiers, Reserved Words, and Directives");
    table_row(57, "`\\\\` to the end of the line   |   a line of a `#string` block");
    paragraph(
        58,
        #string,oneline
            \\Two forms with a backtick before a name belong to macros and code
            \\quotes; they are described in `#code`, `#insert`, and `#expand`.
            \\Labels and their uses are described in Labels, `goto`, and
            \\Non-Local Transfers.
    );
    subheading(59, "Operator characters");
    paragraph(
        60,
        #string,oneline
            \\Unlike punctuation, operators are not fixed by the language. Almost
            \\every operator, including `+` and `==`, is declared in the standard
            \\library as a member of a typeclass, and a program can declare more
            \\(see Operator Declarations). The lexer therefore cuts operators out
            \\of the text by their characters alone. Eighteen ASCII characters are
            \\operator characters: `+ - * / < > ! @ % ^ & | ~ ? . , : =`. A run of
            \\them forms one token, as long as possible, whatever operators exist;
            \\the lexer cannot stop earlier, because a library may declare an
            \\operator of any spelling. Adjacent operators therefore need a space
            \\between them:
    );
    code_block(
        61,
        "text",
        #string
            \\// a =-1;
            \\error: unexpected token '=-'; no operator '=-' is declared, and adjacent operator characters form one token - write '= -' with spaces
            \\// y := 2*-x;
            \\error: unexpected token '*-'; no operator '*-' is declared, and adjacent operator characters form one token - write '* -' with spaces
            \\// n:s32=-5;
            \\error: unexpected token '=-'; no operator '=-' is declared, and adjacent operator characters form one token - write '= -' with spaces
    );
    paragraph(
        62,
        #string,oneline
            \\When the run is not a declared operator but can be divided into
            \\operators that are, the message suggests the division, as above.
            \\Otherwise it is a plain `error: unexpected token`. A few rules keep
            \\common spellings working without spaces:
    );
    bullet(
        63,
        #string,oneline
            \\`?` and `,` always end a run, so `x:?s32`, `p: *?s32` and `f(a,-1)`
            \\need no spaces, and `?` and `,` never appear inside a user operator.
    );
    bullet(
        64,
        #string,oneline
            \\`::`, `:::`, `:=`, `::=`, `->`, `..`, `..=`, `...`, `,,`, `.*`,
            \\`.&`, `.{` and `.[` are fixed tokens. A `:` followed by `*` stays
            \\alone, so `p:*s32` and `q:=*p` read as intended.
    );
    bullet(
        65,
        #string,oneline
            \\An operator never ends with `.`. When a run would end with a dot that
            \\is followed by a name, a digit, `(`, `{`, `[`, a quote or a backtick,
            \\the dot is left to start the next token, so `color ==.Red` works. Any
            \\other run that ends in a dot is an error: `2 *. 3` gives `error:
            \\operator token cannot end with '.'`.
    );
    bullet(
        66,
        #string,oneline
            \\A `.` that nothing can follow, as in `p . x`, is reported as `stray
            \\'.': a member name must follow '.' directly, with no space between
            \\them`; after a number, `5.` is reported as a float literal missing
            \\its fraction (see Number Literals).
    );
    note(
        67,
        #string,oneline
            \\A comment opener that touches an operator does not start a comment.
            \\`//` and `/*` begin a comment only where a token can begin; inside a
            \\run of operator characters, `/` and `*` are operator characters like
            \\any other. `x := 1 +// more` therefore reads the operator `+//` and
            \\fails with `error: unexpected token '+//'`, and `1+/* plus */2` fails
            \\the same way with `+/*`. Leave a space between an operator and a
            \\comment.
    );
    subheading(68, "The operators of the prelude");
    paragraph(
        69,
        #string,oneline
            \\The prelude declares these operators for the primitive types. Each
            \\spelling belongs to one typeclass, which is how a program extends the
            \\operator to its own types (see Operator Declarations); how strongly
            \\each one binds is listed in Precedence Levels and Associativity.
    );
    table_header(70, "Kind   —   Spellings");
    table_row(
        71,
        "Arithmetic   |   `+` `-` `*` `/` `%`; wrapping `+%` `-%` `*%`; saturating `+|` `-|` `*|`"
    );
    table_row(72, "Bits and shifts   |   `&` `|` `^` `<<` `>>` `<<|`");
    table_row(73, "Comparison   |   `==` `!=` `<` `<=` `>` `>=` `<=>`");
    table_row(74, "Logic   |   `&&` `||`, which evaluate the right operand only when needed");
    table_row(75, "Ranges   |   `..` `..=`, also as prefix (`..n`), and `..` as suffix (`n..`)");
    table_row(76, "Prefix   |   `-` `-%` `!` `~`");
    table_row(
        77,
        "Assignment   |   `+=` `-=` `*=` `/=` `%=` `&=` `|=` `^=` `<<=` `>>=` `&&=` `||=`, and `+%=` `-%=` `*%=` `+|=` `-|=` `*|=` `<<|=`"
    );
    table_row(78, "Indexing   |   `'[]'` and `'[]='`, written as `a[i]` and `a[i] = v`");
    paragraph(
        79,
        #string,oneline
            \\Prefix `*` and `&`, and spellings made only of stars or only of
            \\ampersands, are built in: they dereference and take addresses, or
            \\form pointer types when the operand is a type (see Pointer Types).
            \\There is no unary `+`.
    );
    subheading(80, "Reserved spellings");
    paragraph(
        81,
        #string,oneline
            \\These spellings are syntax and cannot be declared as operators: `=`,
            \\`.`, `,`, `,,`, `:`, `::`, `:::`, `:=`, `::=`, `->`, `.*`, `.&`,
            \\`...`, a lone `@`, and the one and two backtick forms. Declaring one
            \\is reported as `error: reserved operator token '::' (operator '::'
            \\cannot be overloaded)`. Longer spellings that merely contain them,
            \\such as `==`, `@=` or `<=>`, are not reserved.
    );
    subheading(82, "Quoted operator names");
    paragraph(
        83,
        #string,oneline
            \\An operator is named by writing its spelling between single quotation
            \\marks: `'+'`, `'<=>'`, `'[]='`. The quoted name is how an operator is
            \\declared, and it lets an operator be used like a procedure name: in a
            \\call, through a namespace, and in an import list.
    );
    code_block(
        84,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    print("{} {}\n", '+'(10, 4), '-'(10));
            \\    print("{}\n", '<=>'(1, 2));
            \\}
    );
    code_block(
        85,
        "text",
        #string
            \\14 -10
            \\Less
    );
    paragraph(
        86,
        #string,oneline
            \\A quoted name must be on one line and must not be empty, contain
            \\whitespace or a comma, end with `.`, or be a reserved spelling.
            \\Brackets are allowed only in `'[]'` and `'[]='`.
    );
    code_block(
        87,
        "text",
        #string
            \\// ''
            \\error: operator name must not be empty
            \\// '+ '
            \\error: operator name '+ ' must not contain whitespace
            \\// '+.'
            \\error: operator token cannot end with '.'
            \\// '<[>' declared in a typeclass
            \\error: operator '<[>' cannot contain '[' or ']'
    );
    paragraph(
        88,
        #string,oneline
            \\A quote followed by a name and no closing quote is a label, as in
            \\`goto('again)`; with a closing quote, `'plus'`, it is an operator
            \\name. An operator named with letters can be declared and called as
            \\`'plus'(2, 3)`, but `2 plus 3` reads `plus` as a name and fails with
            \\`error: unexpected token 'plus'`. The same holds for a spelling that
            \\starts with `//` or `/*`, which always opens a comment.
    );
    subheading(89, "The operator prescan");
    paragraph(
        90,
        #string,oneline
            \\To parse `a <-> b * c`, the parser must know whether `<->` is a
            \\binary operator and how strongly it binds compared with `*`.
            \\Operators are declarations, so the answer comes from declarations:
            \\before a module is parsed, the compiler scans the tokens of the
            \\module and of its imports for operator declarations and builds the
            \\module's operator table. This step is the operator prescan.
    );
    paragraph(
        91,
        #string,oneline
            \\The prescan does not parse. It looks for a quoted operator name
            \\followed by `::` and `(`, and reads the `#operator(...)` directive
            \\after the parameter list. `left`, `right` and `assign` with a
            \\precedence make a binary operator; `prefix` and `suffix` make a
            \\unary one. Because the whole file is scanned first, an operator can
            \\be used above the declaration that introduces it:
    );
    code_block(
        92,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    print("{}\n", 2 + 10 <-> 4);
            \\}
            \\
            \\Distance :: typeclass (L: type, R: type) {
            \\    Output :: type;
            \\    '<->' :: (a: L, b: R) -> Output #operator(left, 19);
            \\}
            \\
            \\(ssize, ssize) ::: instance Distance {
            \\    Output :: ssize;
            \\    '<->' :: (a: ssize, b: ssize) -> ssize {
            \\        if a > b return a - b;
            \\        return b - a;
            \\    }
            \\}
    );
    code_block(
        93,
        "text",
        #string
            \\8
    );
    paragraph(
        94,
        #string,oneline
            \\Precedence 19 binds tighter than `+`, so the expression is
            \\`2 + (10 <-> 4)`. Since the prescan reads tokens, the precedence
            \\must be written as an integer literal; a named constant is not
            \\evaluated at that point:
    );
    code_block(
        95,
        "text",
        #string
            \\// '<->' :: (a: L, b: R) -> Output #operator(left, LEVEL);
            \\error: unexpected token 'LEVEL'
    );
    paragraph(
        96,
        #string,oneline
            \\For the same reason, an operator declaration may not sit inside a
            \\top-level `#if`, whose condition is not known while tokens are
            \\scanned: `error: custom operator declarations must be outside module
            \\#if blocks`.
    );
    subheading(97, "Which operators a module sees");
    paragraph(
        98,
        #string,oneline
            \\A module's operator table holds the operators of the prelude, the
            \\operators the module declares itself, and the operators exported by
            \\each module it imports with a plain `#import`. A module exports the
            \\operators it declares and those of the modules it re-exports with
            \\`#export`; like other names, operators do not pass through an
            \\ordinary import of an import (see Modules, Imports, and the Prelude).
            \\An import list filters them: list the operator by its quoted name,
            \\or the typeclass that declares it, which brings all of the
            \\typeclass's members.
    );
    code_block(
        99,
        "glosso",
        #string
            \\// distance.glo
            \\#public {
            \\Distance :: typeclass (L: type, R: type) {
            \\    Output :: type;
            \\    '<->' :: (a: L, b: R) -> Output #operator(left, 19);
            \\}
            \\}
            \\
            \\(ssize, ssize) ::: instance Distance {
            \\    Output :: ssize;
            \\    '<->' :: (a: ssize, b: ssize) -> ssize {
            \\        if a > b return a - b;
            \\        return b - a;
            \\    }
            \\}
    );
    code_block(
        100,
        "glosso",
        #string
            \\#import "Io";
            \\#import "distance.glo" { '<->' };
            \\
            \\main :: () {
            \\    print("{}\n", 3 <-> 10);
            \\}
    );
    code_block(
        101,
        "text",
        #string
            \\7
    );
    paragraph(
        102,
        #string,oneline
            \\A namespace import, `Name :: #import "Module";`, adds no operators to
            \\the table: an operator has no place for a module prefix between its
            \\operands. Written between operands, its spelling is an unexpected
            \\token; the operator is still reachable by its quoted name:
    );
    code_block(
        103,
        "text",
        #string
            \\// D :: #import "distance.glo";
            \\// print("{}\n", 3 <-> 10);
            \\error: unexpected token '<->'
            \\// print("{}\n", D.'<->'(3, 10));    prints 7
    );
}

render_section_22 :: () {
    paragraph(
        0,
        #string,oneline
            \\Every word in a Glosso program is a name, a keyword or a directive.
            \\Names, called identifiers, denote variables, constants, procedures,
            \\types, fields and modules alike; even the language's own types are
            \\named by identifiers. Nineteen words are keywords, reserved for the
            \\syntax. A word written directly after `#` is a directive, an
            \\instruction to the compiler rather than a reference to a
            \\declaration. This chapter gives the rules for each kind of word,
            \\describes the blank name `_`, and ends with an index of the
            \\directives and the chapters that describe them.
    );
    subheading(1, "Identifiers");
    paragraph(
        2,
        #string,oneline
            \\An identifier starts with `_` or a letter and continues with `_`,
            \\letters and digits. Letters and digits are taken from Unicode, so
            \\names may be written in any script whose words consist of letters.
            \\There is no length limit.
    );
    table_header(3, "Position   —   Accepted characters");
    table_row(4, "First   |   `_`, or a Unicode letter: general categories Lu, Ll, Lt, Lm and Lo.");
    table_row(
        5,
        "Later   |   `_`, a letter, or any character with a numeric value: decimal digits of every script, superscript digits such as `²`, fractions such as `½`, Roman numerals."
    );
    code_block(
        6,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    λ := 1;
            \\    안녕 := 2;
            \\    _x := 3;
            \\    Ω_1 := 4;
            \\    a² := 5;
            \\    x½ := 6;
            \\    ᵃ := 7;
            \\    名前 := 8;
            \\    print("{} {} {} {} {} {} {} {}\n", λ, 안녕, _x, Ω_1, a², x½, ᵃ, 名前);
            \\}
    );
    code_block(
        7,
        "text",
        #string
            \\1 2 3 4 5 6 7 8
    );
    subheading(8, "Characters a name cannot contain");
    paragraph(
        9,
        #string,oneline
            \\Combining marks belong to neither class, and neither do emoji or
            \\punctuation other than `_`. A letter written in decomposed form, such
            \\as `e` followed by U+0301 COMBINING ACUTE ACCENT, ends the identifier
            \\at the base letter, and the mark is reported as an unexpected
            \\character. For the same reason, scripts whose words need vowel signs
            \\or other marks, such as Devanagari and Thai, cannot be used in names.
    );
    code_block(
        10,
        "text",
        #string
            \\// café := 1;   with é written as e and U+0301
            \\error: unexpected character U+0301
            \\// नमस्ते := 1;
            \\error: unexpected character U+094D
    );
    subheading(11, "How names are compared");
    paragraph(
        12,
        #string,oneline
            \\Names are compared exactly, code point by code point. `count` and
            \\`Count` are different names, and no Unicode normalization is
            \\applied: `café` written with the precomposed U+00E9 is a valid name,
            \\and it is a different sequence of code points from any other
            \\spelling.
    );
    subheading(13, "Names and numbers");
    paragraph(
        14,
        #string,oneline
            \\A digit at the start of a word begins a number, not a name. `2abc`
            \\is the integer `2` followed by the name `abc`, which the parser then
            \\rejects. A non-ASCII digit at the start of a word begins a number as
            \\well, and numbers accept only ASCII digits. In the other direction,
            \\a word that starts with `_`, such as `_1`, is always a name.
    );
    code_block(
        15,
        "text",
        #string
            \\// 2abc := 1;
            \\error: unexpected token 'abc'
            \\// ²a := 1;
            \\error: number literals must use ASCII digits
    );
    subheading(16, "Keywords");
    paragraph(
        17,
        #string,oneline
            \\Nineteen words are keywords. The compiler reads a whole word first
            \\and then checks it against this list, so a longer word that begins or
            \\ends with a keyword, such as `iffy`, `structure` or `if_`, is an
            \\ordinary name.
    );
    table_header(18, "Group   —   Keywords");
    table_row(19, "Branching and loops   |   `if`, `ifx`, `else`, `case`, `while`, `for`");
    table_row(20, "Leaving a body   |   `return`, `break`, `continue`, `defer`");
    table_row(21, "Type definitions   |   `struct`, `union`, `enum`");
    table_row(22, "Conversions   |   `cast`, `acast`");
    table_row(23, "Others   |   `using`, `context`, `where`, `noalias`");
    paragraph(
        24,
        #string,oneline
            \\A keyword cannot be used as a name. The message depends on how far
            \\the parser gets with the keyword's own syntax before it fails:
    );
    code_block(
        25,
        "text",
        #string
            \\// if := 1;
            \\error: unexpected token ':='
            \\// struct := 1;
            \\error: unexpected token 'struct'
            \\// cast := 1;
            \\error: cast requires a type in parentheses; use acast for contextual casts
    );
    subheading(26, "Words with a meaning in one position");
    paragraph(
        27,
        #string,oneline
            \\Several words that look reserved are ordinary identifiers that the
            \\parser recognizes in one particular position: `typeclass`,
            \\`instance`, `distinct` and `enum_flags` after `::` or `:::`, and the
            \\pointer qualifiers `const`, `mut` and `volatile` inside a type.
            \\Directive names are not reserved either, because a directive is
            \\always written with its `#`. All of these can be used as names
            \\elsewhere:
    );
    code_block(
        28,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    typeclass := 1;
            \\    instance := 2;
            \\    distinct := 3;
            \\    const := 4;
            \\    type := 5;
            \\    import := 6;
            \\    print("{} {} {} {} {} {}\n", typeclass, instance, distinct, const, type, import);
            \\}
    );
    code_block(
        29,
        "text",
        #string
            \\1 2 3 4 5 6
    );
    subheading(30, "`true`, `false` and `null`");
    paragraph(
        31,
        #string,oneline
            \\`true`, `false` and `null` are not keywords, but in an expression
            \\they always mean the two boolean values and the empty value. A
            \\variable with one of these names can be declared, and it can then
            \\never be read:
    );
    code_block(
        32,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    true := 1;
            \\    false := 2;
            \\    print("{} {}\n", true, false);
            \\}
    );
    code_block(
        33,
        "text",
        #string
            \\true false
    );
    subheading(34, "Built-in type names");
    paragraph(
        35,
        #string,oneline
            \\The names of the types the language provides are identifiers as
            \\well. The compiler resolves them when no declaration of the same name
            \\is in scope. Catalog of Built-in Types describes the types
            \\themselves.
    );
    table_header(36, "Kind   —   Names");
    table_row(
        37,
        "Integer types   |   `s8` `s16` `s32` `s64` `s128`, `u8` `u16` `u32` `u64` `u128`, `ssize` `usize`, and any width from `s1`/`u1` to `s65535`/`u65535`"
    );
    table_row(38, "Floating-point types   |   `f16` `f32` `f64` `f80` `f128`");
    table_row(39, "Complex types   |   `c32` `c64` `c128` `c160` `c256`");
    table_row(40, "Text types   |   `str` `cstr` `string16` `cstring16` `rune`");
    table_row(
        41,
        "Other types   |   `bool` `void` `type` `any` `label` `Code` `Pattern` `Namespace` `Library`"
    );
    table_row(42, "Written as directives   |   `#Never` `#Context` `#Self_Type`");
    paragraph(
        43,
        #string,oneline
            \\A variable with the name of a type hides the type in its scope, and
            \\a later use of the name as a type says so:
    );
    code_block(
        44,
        "text",
        #string
            \\// s32 := 5;
            \\// y : s32 = 3;
            \\error: 's32' is a variable, not a type
    );
    subheading(45, "The blank name `_`");
    paragraph(
        46,
        #string,oneline
            \\`_` is a name that binds nothing. A declaration `_ := value;` and an
            \\assignment `_ = value;` evaluate the value and discard it, which is
            \\also how the result of a `#must` procedure is dropped on purpose. A
            \\parameter, a struct field or a loop variable named `_` takes its
            \\place without a usable name, and unlike other names, `_` may be
            \\declared any number of times in one scope:
    );
    code_block(
        47,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\Header :: struct {
            \\    tag: u8;
            \\    _: u8;      // padding
            \\    _: u16;     // more padding
            \\    length: u32;
            \\}
            \\
            \\checked :: (_: s32, code: s32) -> s32 #must { return code; }
            \\
            \\main :: () {
            \\    print("{}\n", size_of(Header));
            \\    _ := checked(1, 2);
            \\    _ := checked(3, 4);
            \\    for _: 0..2 print("tick\n");
            \\}
    );
    code_block(
        48,
        "text",
        #string
            \\8
            \\tick
            \\tick
    );
    paragraph(
        49,
        #string,oneline
            \\Calling the `#must` procedure as a statement is an error that
            \\suggests `_`, and `_` cannot be read:
    );
    code_block(
        50,
        "text",
        #string
            \\// checked(1, 2);
            \\error: discarded return value of #must function 'checked'
            \\help: bind it explicitly, for example `_ := checked(...);`, if discarding is intentional
            \\// print("{}\n", _);
            \\error: unbound '_'
    );
    paragraph(
        51,
        #string,oneline
            \\`_` has two more roles. In an array type, `[_]T` takes the length
            \\from the initializer (see Arrays, Views, Dynamic Arrays, and
            \\Slicing). In a pattern, `_` matches any value without binding it (see
            \\`#pattern` Matching and Pattern Forms).
    );
    subheading(52, "Directives");
    paragraph(
        53,
        #string,oneline
            \\A directive is `#` directly followed by a name made of letters,
            \\digits and `_`. It is an instruction to the compiler: `#import` loads
            \\a module, `#if` compiles one of two branches, `#char` writes a
            \\character value. Some directives take modifiers after commas, as in
            \\`#string,oneline`, `#inline,always` or `#public,unit`. The name must
            \\touch the `#` and must name a directive that exists:
    );
    code_block(
        54,
        "text",
        #string
            \\// x := # char "a";
            \\error: expected a directive name after '#'
            \\// x := #foo;
            \\error: unexpected directive 'foo'
            \\// #foo at the top level of a file
            \\error: bad decl name 'foo'
    );
    paragraph(
        55,
        #string,oneline
            \\A `#!` line at the top of a file is not accepted either, since `!` is
            \\not a directive name; it is reported as `error: expected a directive
            \\name after '#'`.
    );
    subheading(56, "Names in macros and code quotes");
    paragraph(
        57,
        #string,oneline
            \\Two more name forms belong to macros and code quotes. A backtick
            \\directly before a name refers to a name of the scope in which the
            \\macro is expanded, and two backticks before a name inside a quote
            \\splice in the compile-time value of that name: a `str` becomes an
            \\identifier, a type that type, and a `Code` value its syntax.
            \\`#code`, `#insert`, and `#expand` describes both.
    );
    subheading(58, "Index of directives");
    paragraph(
        59,
        #string,oneline
            \\The table lists every directive, in the order of the chapters that
            \\describe them.
    );
    table_header(60, "Directives   —   Described in");
    table_row(61, "`#import` `#export` `#module_params`   |   Modules, Imports, and the Prelude");
    table_row(62, "`#public` `#private`   |   Who Can Use a Declaration: Visibility and Units");
    table_row(63, "`#source_location`   |   Encoding, Comments, and Tokens");
    table_row(64, "`#string` `#char`   |   Text and Character Literals");
    table_row(65, "`#simd` `#matrix`   |   `Simd` Vectors and `Matrix` Values");
    table_row(66, "`#empty` `#as`   |   Struct Types");
    table_row(67, "`#packed` `#align`   |   Field Order, Alignment, and Packing");
    table_row(68, "`#from` `#raw`   |   Tagged and Untagged Unions");
    table_row(69, "`#soa` `#aos`   |   `#soa` and `#aos` Storage");
    table_row(
        70,
        "`#undefined` `#thread_local` `#link_section`, and `#align` on a variable   |   Constants, Variables, and Globals"
    );
    table_row(71, "`#partial` `#falling`   |   Switch Statements");
    table_row(72, "`#inline for` `#inline while`   |   `while`, `for`, and Unrolled Loops");
    table_row(73, "`#pattern`   |   `#pattern` Matching and Pattern Forms");
    table_row(74, "`#Never`   |   Procedure Declarations and Arguments");
    table_row(75, "`#lazy`   |   `noalias`, `#lazy`, `#comptime`, and Type Parameters");
    table_row(76, "`#meaningful`   |   Generic Procedures and `where` Clauses");
    table_row(77, "`#fn_ptr`   |   Lambdas and `#fn_ptr` Values");
    table_row(78, "`#self` `#Self_Type`   |   Inherent Methods, Member Access, and Call Syntax");
    table_row(
        79,
        "`#inline` `#must` `#no_context` `#returns_twice` `#specialize` `#dump`   |   Directives That Modify Procedures"
    );
    table_row(80, "`#minimal`   |   Typeclass Declarations and Instances");
    table_row(81, "`#derive`   |   `#derive`");
    table_row(82, "`#try`   |   `Try`, `?`, `#try`, and `Termination`");
    table_row(83, "`#operator`   |   Operator Declarations");
    table_row(
        84,
        "`#Context` `#push_context` `#push_allocator`   |   `#Context` and `context`; `Allocator` and Allocation Procedures"
    );
    table_row(85, "`#temp_scope`   |   The Temporary Allocator");
    table_row(
        86,
        "`#comptime`   |   Compile-Time Evaluation; `noalias`, `#lazy`, `#comptime`, and Type Parameters"
    );
    table_row(87, "`#if` `#assert` `#compile_error`   |   `#if`, `#assert`, and `#compile_error`");
    table_row(88, "`#code` `#insert` `#expand`   |   `#code`, `#insert`, and `#expand`");
    table_row(89, "`#library` `#foreign` `#c_call`   |   `#foreign`, `#library`, and `#c_call`");
    table_row(90, "`#asm` `#bytes` `#magic`   |   `#asm`, `#bytes`, and `#magic`");
    table_row(91, "`#enable` `#disable`   |   Feature Gates and Runtime Checks");
}

render_section_23 :: () {
    paragraph(
        0,
        #string,oneline
            \\A number literal is an integer literal or a float literal. Neither
            \\kind has a sign or a type suffix: a minus sign is the prefix operator
            \\`-` applied to the literal, and the type comes from the context in
            \\which the literal is used. Integer literals can be written in any
            \\base from 2 to 36; float literals are always decimal. Both use ASCII
            \\digits only, and both accept `_` as a digit separator. This chapter
            \\gives the spelling of each kind and the rules for fitting a literal
            \\to its type. What type a literal takes when nothing gives it one, and
            \\how literals and constants combine before they have a type, is
            \\described in Literal Typing and Type Conversion.
    );
    subheading(1, "Integer literals");
    paragraph(
        2,
        #string,oneline
            \\A decimal integer literal is a run of ASCII digits. A based literal
            \\is a base, `#`, and digits in that base. Both kinds may group their
            \\digits with `_`:
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    print("{} {} {}\n", 1_000_000, 16#ff, 16#FF);
            \\    print("{} {} {}\n", 2#1011, 8#777, 36#z);
            \\    print("{} {}\n", 16#dead_beef, -1_6#10);
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\1000000 255 255
            \\11 511 35
            \\3735928559 -16
    );
    subheading(5, "Digit separators");
    paragraph(
        6,
        #string,oneline
            \\`_` may stand between two digits to group them. It carries no
            \\meaning and is ignored when the value is read. A group of digits may
            \\not begin or end with `_` or contain two in a row. The rule is
            \\checked separately for each part of a number, integer or float, and
            \\the message names the part:
    );
    table_header(7, "Part   —   Diagnostic for `1__0`, `1_`, `16#_ff` and the like");
    table_row(
        8,
        "Decimal digits, or the base before `#`   |   `invalid '_' separator in number literal`"
    );
    table_row(9, "Digits after `#`   |   `invalid '_' separator in base integer literal`");
    table_row(
        10,
        "Digits after the `.` of a float   |   `invalid '_' separator in fractional literal`"
    );
    table_row(11, "Exponent digits of a float   |   `invalid '_' separator in scientific exponent`");
    paragraph(
        12,
        #string,oneline
            \\A word that starts with `_`, such as `_1`, is a name, not a number.
    );
    subheading(13, "Bases from 2 to 36");
    paragraph(
        14,
        #string,oneline
            \\`base#digits` writes an integer in any base from 2 to 36. The base is
            \\a decimal number; the digits are `0` to `9` followed by the letters
            \\`a` to `z`, in either case, so base 16 uses `0`-`9` and `a`-`f` and
            \\base 36 uses the whole alphabet. One spelling covers every base, so
            \\there are no separate hexadecimal, octal or binary prefixes. The `#`
            \\must follow the base directly.
    );
    table_header(15, "Written   —   Diagnostic");
    table_row(
        16,
        "`1#1`, `37#z`   |   `integer literal base must be between 2 and 36, got 1` (`37`)"
    );
    table_row(17, "`2#102`   |   `digit '2' is not valid for base 2`");
    table_row(18, "`16#`   |   `base-16 integer literal needs at least one digit`");
    table_row(
        19,
        "`0xff`, `0XFF`   |   `legacy '0x' integer literals are not supported; use '16#digits'`"
    );
    table_row(
        20,
        "`0b101`, `0B1`   |   `legacy '0b' integer literals are not supported; use '2#digits'`"
    );
    table_row(21, "`0o7`   |   the literal `0` and then the name `o7`: `unexpected token 'o7'`");
    table_row(22, "`10u8`   |   the literal `10` and then the name `u8`: `unexpected token 'u8'`");
    paragraph(
        23,
        #string,oneline
            \\As the last row shows, there are no type suffixes. A literal of a
            \\particular type is written with a type annotation or a cast instead:
            \\`x : u8 = 10;` or `cast(u8) 10`.
    );
    subheading(24, "Fitting an integer literal to its type");
    paragraph(
        25,
        #string,oneline
            \\A decimal literal denotes an exact value. Where it meets a type, from
            \\an annotation, a parameter, a field or the other operand of an
            \\operator, the value must lie in that type's range; nothing is
            \\truncated or wrapped. A negative value is checked after the `-` is
            \\applied, so `-128` fits `s8`.
    );
    code_block(
        26,
        "text",
        #string
            \\// a : s8 = 255;
            \\error: 255 does not fit s8, whose range is -128..=127
            \\// a : u8 = -1;
            \\error: -1 does not fit u8, whose range is 0..=255
    );
    paragraph(
        27,
        #string,oneline
            \\A literal that nothing gives a type becomes an `ssize` when its value
            \\fits one, and a wider integer otherwise. Literal Typing and Type
            \\Conversion gives these rules in full.
    );
    subheading(28, "A based literal is a bit pattern");
    paragraph(
        29,
        #string,oneline
            \\A literal written with a base is read as a bit pattern rather than
            \\as a magnitude. It fits a type when it fits the type's width,
            \\whatever the sign: a mask is written for its bits, so `16#ff` is a
            \\valid `s8` and means -1 there, and `16#8000_0000_0000_0000` is the
            \\lowest `s64`.
    );
    code_block(
        30,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    a : s8 = 16#ff;
            \\    b : s8 = 16#80;
            \\    c : u8 = 16#ff;
            \\    d : s64 = 16#8000_0000_0000_0000;
            \\    e : s32 = 2#1111_1111_1111_1111_1111_1111_1111_1111;
            \\    print("{} {} {} {} {}\n", a, b, c, d, e);
            \\}
    );
    code_block(
        31,
        "text",
        #string
            \\-1 -128 255 -9223372036854775808 -1
    );
    paragraph(
        32,
        #string,oneline
            \\The relaxation concerns the width only. A pattern with more bits than
            \\the type is rejected with a note that says why, and a decimal literal
            \\never has the relaxation. Writing a `-` in front of a based literal
            \\turns it back into a magnitude, because a sign only makes sense for
            \\one:
    );
    code_block(
        33,
        "text",
        #string
            \\// a : s8 = 16#1ff;
            \\error: 511 does not fit s8, whose range is -128..=127
            \\note: a based literal is a bit pattern, so it may use every bit of s8 - this one is wider than that
            \\// a : s8 = -16#ff;
            \\error: -255 does not fit s8, whose range is -128..=127
    );
    subheading(34, "Literals wider than 128 bits");
    paragraph(
        35,
        #string,oneline
            \\A decimal literal has no size limit. Integer types may be up to 65535
            \\bits wide, and a decimal literal can initialize any of them exactly:
    );
    code_block(
        36,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    big : u192 = 1_000_000_000_000_000_000_000_000_000_000_000_000_000;
            \\    print("{}\n", big + 1);
            \\    print("{}\n", big / 16#ffff_ffff);
            \\}
    );
    code_block(
        37,
        "text",
        #string
            \\1000000000000000000000000000000000000001
            \\232830643708079737543146996186
    );
    paragraph(
        38,
        #string,oneline
            \\A based literal is limited to 128 bits, whatever type receives it.
            \\`16#1_0000_0000_0000_0000_0000_0000_0000_0000`, which needs 129, is
            \\rejected with `error: base-16 integer literal does not fit in 128
            \\bits` even when assigned to a `u192`. A wider value is written in
            \\decimal, or assembled with shifts.
    );
    subheading(39, "Float literals");
    paragraph(
        40,
        #string,oneline
            \\A number becomes a float literal when it has a fraction, an exponent,
            \\or both. The fraction is a `.` followed by at least one digit. The
            \\exponent is `e` or `E`, an optional `+` or `-`, and at least one
            \\digit; it may follow the integer digits directly. `_` separators are
            \\allowed in every part, under the rules given above.
    );
    code_block(
        41,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    print("{} {} {} {}\n", 1.25, 1_234.5_6, 1e3, 1E-3);
            \\    print("{} {} {}\n", 2.5e+2, 6.02e23, 1_0e1_0);
            \\}
    );
    code_block(
        42,
        "text",
        #string
            \\1.25 1234.56 1000 0.001
            \\250 6.02e+23 1e+11
    );
    subheading(43, "What is not a float literal");
    paragraph(
        44,
        #string,oneline
            \\Both sides of the `.` need a digit, there is no hexadecimal float,
            \\and there are no suffixes. These spellings are taken apart into
            \\other tokens or rejected:
    );
    table_header(45, "Written   —   Result");
    table_row(46, "`.5`   |   a `.` and then `5`: `unexpected token '5'`");
    table_row(47, "`1.`   |   `float literal '1.' needs a digit after the '.'; write '1.0'`");
    table_row(
        48,
        "`1.e3`   |   the integer `1`, then a member access `.e3`: `member of non-struct`"
    );
    table_row(
        49,
        "`1.5e`, `1e+`   |   `scientific number literal needs exponent digits after 'e' or 'E'`"
    );
    table_row(50, "`16#1.5`   |   a based integer, then a member access");
    table_row(51, "`1.5f`   |   the float `1.5` and then the name `f`: `unexpected token 'f'`");
    paragraph(
        52,
        #string,oneline
            \\The digit on each side keeps the `.` of a number apart from the other
            \\tokens that begin with a dot: member access `.`, the ranges `..` and
            \\`..=`, and the dereference `.*`. After a member-access dot, digits
            \\are always a field number, so `t.0.1` reads field 1 of field 0 of a
            \\tuple and never contains the float `0.1`:
    );
    code_block(
        53,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    t := .(.(1, 2), 3);
            \\    print("{} {}\n", t.0.1, t.1);
            \\}
    );
    code_block(
        54,
        "text",
        #string
            \\2 3
    );
    subheading(55, "The type of a float literal");
    paragraph(
        56,
        #string,oneline
            \\A float literal takes its type from the context and is an `f64` when
            \\nothing gives it one. It can become any floating-point type, but
            \\never an integer, even when its value is whole. An integer literal,
            \\on the other hand, can become a float:
    );
    code_block(
        57,
        "text",
        #string
            \\// x : s64 = 1.5;
            \\error: cannot implicitly convert comptime_float to s64
            \\// x : u8 = 1.0;
            \\error: cannot implicitly convert comptime_float to u8
            \\// x : f64 = 1;    accepted
    );
    subheading(58, "Precision and range");
    paragraph(
        59,
        #string,oneline
            \\The compiler reads every float literal as an `f64` first. For `f16`
            \\and `f32` it rounds the written decimal digits once more, directly
            \\to the narrower format, so the result is the nearest value of that
            \\format. For `f80` and `f128` the `f64` reading is the value: digits
            \\beyond the precision of `f64` are lost before the wider type is
            \\applied. The types themselves have their full precision; only the
            \\literal is limited.
    );
    code_block(
        60,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    a : f128 = 1.0000000000000000001;
            \\    b : f128 = 0.1;
            \\    c : f128 = cast(f128) (cast(f64) 0.1);
            \\    print("{} {}\n", a == 1.0, b == c);
            \\}
    );
    code_block(
        61,
        "text",
        #string
            \\true true
    );
    paragraph(
        62,
        #string,oneline
            \\A literal outside the range of `f64`, or one whose nonzero digits
            \\round to zero there, is rejected while the file is read, before any
            \\type is known. A literal that fits `f64` but not its narrower target
            \\type is rejected when the type is applied, with a note giving the
            \\limit:
    );
    code_block(
        63,
        "text",
        #string
            \\// x : f64 = 1e400;
            \\error: float literal '1e400' is out of range for f64; float literals are read as f64 values, including those given an f80 or f128 type
            \\// x : f16 = 100000.0;
            \\error: float literal '100000.0' is out of range for f16
            \\note: the largest finite f16 is 65504
            \\// x : f16 = 1e-10;
            \\error: float literal '1e-10' is out of range for f16
            \\note: the smallest positive f16 is 5.96e-8, and this literal rounds to zero
    );
    paragraph(
        64,
        #string,oneline
            \\A zero written with a large negative exponent, such as `0e-400`, is
            \\zero and is accepted.
    );
    subheading(65, "Infinity, NaN and negative zero");
    paragraph(
        66,
        #string,oneline
            \\There are no literals for infinity or NaN. The `Math/Core` module
            \\provides them as procedures, such as `positive_infinity()` and
            \\`quiet_nan()`, and builds any exact value from its bit image with
            \\`f64.from_bits` and `f32.from_bits`, which take an integer that is
            \\conveniently written as a based literal. A negative zero is `-0.0`,
            \\the prefix `-` applied to `0.0`.
    );
    code_block(
        67,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Math/Core";
            \\
            \\main :: () {
            \\    print("{} {}\n", positive_infinity(), quiet_nan());
            \\    print("{}\n", f64.from_bits(16#3ff8_0000_0000_0000));
            \\    z := -0.0;
            \\    print("{} {}\n", z, z.to_bits() == negative_zero().to_bits());
            \\}
    );
    code_block(
        68,
        "text",
        #string
            \\inf nan
            \\1.5
            \\-0 true
    );
}

render_section_24 :: () {
    paragraph(
        0,
        #string,oneline
            \\Text enters a program through three kinds of literal: a quoted
            \\string literal, with its prefixed forms `c"..."` and `b"..."`; a
            \\`#string` block, which takes whole source lines as its text; and
            \\`#char`, which writes one character as a value. This chapter gives
            \\the exact rules for each: the escapes, how line breaks are stored,
            \\which types each form can take, and the two character types `u8` and
            \\`rune`. For a first introduction to text, see Working with Text; the
            \\string types themselves are described in `str`, `cstr`, and UTF-16
            \\Text.
    );
    subheading(1, "String literals and their types");
    paragraph(
        2,
        #string,oneline
            \\A string literal is text between double quotation marks. Its type is
            \\`str` unless the context asks for one of the other string types,
            \\`cstr`, `string16` or `cstring16`; the literal is then stored in
            \\that type's encoding, with a terminating zero for the C forms. Two
            \\prefixed forms fix the result instead: `c"..."` is always a `cstr`,
            \\and `b"..."` is an array of bytes.
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\main :: () {
            \\    a := "héllo";
            \\    b : cstr = "héllo";
            \\    c : string16 = "héllo";
            \\    d : cstring16 = "héllo";
            \\    print("{} {} {} {}\n", a.count, b.count, c.count, d.count);
            \\    print("{} {} {} {}\n", a, b, c, d);
            \\    print("{} {}\n", type_name(type_of(c"héllo")), type_name(type_of(b"héllo")));
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\6 6 5 5
            \\héllo héllo héllo héllo
            \\cstr [6]u8
    );
    paragraph(
        5,
        #string,oneline
            \\`.count` is the number of code units without a terminator: six UTF-8
            \\bytes, since `é` takes two, or five UTF-16 units.
    );
    subheading(6, "Escapes");
    paragraph(
        7,
        #string,oneline
            \\A backslash starts an escape. The set of escapes is closed; any other
            \\character after a backslash is an error.
    );
    table_header(8, "Escape   —   Meaning");
    table_row(
        9,
        #string,oneline
            \\`\n` `\r` `\t`   |   line feed, carriage return, horizontal tab
    );
    table_row(
        10,
        #string,oneline
            \\`\a` `\b` `\f` `\v`   |   alert (7), backspace (8), form feed (12), vertical tab (11)
    );
    table_row(
        11,
        #string,oneline
            \\`\0`   |   the code point zero
    );
    table_row(
        12,
        #string,oneline
            \\`\\` `\"` `\'` `\?`   |   a backslash, a double quotation mark, an apostrophe, a question mark
    );
    table_row(
        13,
        #string,oneline
            \\`\xHH`   |   the code point U+00HH; exactly two hexadecimal digits
    );
    table_row(
        14,
        #string,oneline
            \\`\u{H...}`   |   any Unicode scalar value; one to six hexadecimal digits in braces
    );
    table_row(
        15,
        #string,oneline
            \\backslash before a line break   |   the line break itself
    );
    table_row(
        16,
        #string,oneline
            \\`\%`   |   a backslash and a percent sign, both kept
    );
    code_block(
        17,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    controls := "\a\b\f\n\r\t\v\0";
            \\    for i: 0..controls.count print("{},", controls[i]);
            \\    print("\n");
            \\    print("[\\ \" \' \? \x41 \u{3bb} \u{1F600}]\n");
            \\}
    );
    code_block(
        18,
        "text",
        #string
            \\7,8,12,10,13,9,11,0,
            \\[\ " ' ? A λ 😀]
    );
    paragraph(
        19,
        #string,oneline
            \\`\x` and `\u` name a code point, not a byte. The code point is
            \\stored in the literal's encoding like any other character, so
            \\`"\xff"` is U+00FF, two bytes in a `str` (195 and 191) and one unit
            \\in a `string16`. Only a byte-array literal stores `\xHH` as the
            \\single byte HH. A `\0` is kept in a counted string and ends the
            \\visible text of a C string. `\%` is accepted and keeps both of its
            \\characters; a percent sign needs no escape, and the formatting
            \\procedures give it no special meaning.
    );
    subheading(20, "Invalid escapes");
    paragraph(
        21,
        #string,oneline
            \\Escapes are checked when the file is read, so an invalid one is a
            \\lexical error that underlines the literal up to the escape:
    );
    code_block(
        22,
        "text",
        #string
            \\// "price: \$5"
            \\error: unknown string escape '\$'
            \\// "\xA"
            \\error: \x escape needs exactly two hexadecimal digits
            \\// "\u41"
            \\error: \u escape must use \u{hex-digits}
            \\// "\u{}" and "\u{41"
            \\error: \u escape needs hexadecimal digits and a closing '}'
            \\// "\u{12g}"
            \\error: \u escape contains a non-hexadecimal digit
            \\// "\u{1234567}"
            \\error: \u escape may contain at most six hexadecimal digits
            \\// "\u{d800}" and "\u{110000}"
            \\error: \u escape is not a Unicode scalar value
    );
    subheading(23, "Line breaks inside a literal");
    paragraph(
        24,
        #string,oneline
            \\A string literal may span lines; the line break is part of its text.
            \\A backslash at the end of a line is accepted and also stands for the
            \\line break, so it does not join the lines. Either way the break is a
            \\single line feed, even in a file saved with CRLF line endings, and
            \\the following lines keep their correct numbers in diagnostics.
    );
    code_block(
        25,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    a := "first
            \\second";
            \\    b := "first\
            \\second";
            \\    print("{} {} {}\n", a.count, b.count, a == b);
            \\}
    );
    code_block(
        26,
        "text",
        #string
            \\12 12 true
    );
    paragraph(
        27,
        #string,oneline
            \\Because a literal may contain line breaks, a missing closing
            \\quotation mark is noticed only at the end of the file. The error
            \\points at the opening mark: `error: unterminated string literal`.
            \\For text that spans many lines, a `#string` block, described below,
            \\is easier to read.
    );
    subheading(28, "C-string literals");
    paragraph(
        29,
        #string,oneline
            \\`c` directly before the opening quotation mark makes a `cstr`
            \\literal: UTF-8 text followed by a zero byte, in static storage that
            \\lives for the whole program and is never freed. The prefix fixes the
            \\type. Use it where no annotation says that a `cstr` is wanted, for
            \\example in `name := c"window";`. A `cstr` also converts to
            \\`[*]const u8` for C functions.
    );
    code_block(
        30,
        "text",
        #string
            \\// x : string16 = c"a";
            \\error: got cstr, expected string16
    );
    subheading(31, "Byte-array literals");
    paragraph(
        32,
        #string,oneline
            \\`b` directly before the opening quotation mark makes a fixed array of
            \\bytes, `[N]u8`, with no terminator. Text and `\u` escapes are stored
            \\as UTF-8; each `\xHH` is one byte. The array is an ordinary value: a
            \\local copy can be changed, and it converts to a `[]u8` view. Its
            \\length must match an annotated length, or `[_]u8` takes it from the
            \\literal.
    );
    code_block(
        33,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    bytes := b"A\xff\u{e9}";
            \\    print("{}: {} {} {} {}\n", bytes.count, bytes[0], bytes[1], bytes[2], bytes[3]);
            \\    magic : [_]u8 = b"\x89PNG";
            \\    magic[0] = 0;
            \\    print("{} {}\n", magic.count, magic[0]);
            \\}
    );
    code_block(
        34,
        "text",
        #string
            \\4: 65 255 195 169
            \\4 0
    );
    code_block(
        35,
        "text",
        #string
            \\// x : [4]u8 = b"abc";
            \\error: fixed array literal has 3 element(s), expected 4
    );
    paragraph(
        36,
        #string,oneline
            \\The prefix is exactly one lowercase `c` or `b` touching the
            \\quotation mark. `c "x"`, `C"x"` and `cb"x"` are a name followed by an
            \\ordinary literal, which the parser rejects.
    );
    subheading(37, "Joining literals");
    paragraph(
        38,
        #string,oneline
            \\Two literals written next to each other are not joined: `"a" "b"` is
            \\an error at the second one. `+` joins strings whose values are known
            \\at compile time, such as literals and constants, and the result is a
            \\new literal. Strings computed while the program runs are joined with
            \\a `String_Builder` instead.
    );
    code_block(
        39,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\GREETING :: "hello, " + "world";
            \\
            \\main :: () {
            \\    print("{}\n", GREETING);
            \\}
    );
    code_block(
        40,
        "text",
        #string
            \\hello, world
    );
    code_block(
        41,
        "text",
        #string
            \\// name := "x"; joined := name + "y";
            \\error: string concatenation with '+' requires constant strings; use String_Builder at runtime
    );
    paragraph(
        42,
        #string,oneline
            \\Braces have no meaning in a literal. They matter only to the
            \\formatting procedures, which read their first argument as a format
            \\and write a literal brace as `{{` or `}}`; see `Show`, `Formatter`,
            \\`FromString`, and Format Strings.
    );
    subheading(43, "`#string` blocks");
    paragraph(
        44,
        #string,oneline
            \\`#string` makes a string literal out of whole lines of source. Each
            \\line of the block begins with the marker `\\`, and the text after the
            \\marker, up to the end of the line, is one line of the string. The
            \\lines are joined with line feeds, and nothing inside them is
            \\interpreted.
    );
    code_block(
        45,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\BANNER :: #string
            \\    \\alpha
            \\    \\  beta "quoted" \t // not a comment
            \\    \\
            \\    \\gamma
            \\;
            \\
            \\main :: () {
            \\    print("[{}] {}\n", BANNER, BANNER.count);
            \\}
    );
    code_block(
        46,
        "text",
        #string
            \\[alpha
            \\  beta "quoted" \t // not a comment
            \\
            \\gamma] 48
    );
    paragraph(
        47,
        #string,oneline
            \\The example shows the rules for a line of the block:
    );
    bullet(
        48,
        #string,oneline
            \\Whitespace before the marker only places the block in the source.
            \\Whitespace after the marker belongs to the text.
    );
    bullet(
        49,
        #string,oneline
            \\Quotation marks, backslashes, `//` and `/*` are ordinary characters.
            \\`\t` is a backslash and a `t`.
    );
    bullet(
        50,
        #string,oneline
            \\A marker with nothing after it is an empty line.
    );
    bullet(
        51,
        #string,oneline
            \\The line break at the end of each line is not part of that line, and
            \\neither is a carriage return before it. The joined string therefore
            \\has no line feed after its last line, and the same text in a file
            \\saved with CRLF line endings.
    );
    paragraph(
        52,
        #string,oneline
            \\Since a line runs to its end, whatever follows the block, such as the
            \\`;` of a declaration or the `)` of a call, goes on the next line.
            \\`X :: #string \\text;` captures `text;` and leaves the declaration
            \\without its `;`, which is reported as `error: declaration must end
            \\with ';'`.
    );
    subheading(53, "Where a `#string` block ends");
    paragraph(
        54,
        #string,oneline
            \\A block is the run of marker lines that follows `#string`. Blank
            \\lines and comments between marker lines do not end the run; the
            \\first token of any other kind does.
    );
    code_block(
        55,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\STEPS :: #string
            \\    \\one
            \\
            \\    \\two
            \\    // a comment between lines
            \\    \\three
            \\;
            \\
            \\main :: () {
            \\    print("[{}]\n", STEPS);
            \\}
    );
    code_block(
        56,
        "text",
        #string
            \\[one
            \\two
            \\three]
    );
    subheading(57, "`#string` modifiers");
    paragraph(
        58,
        #string,oneline
            \\Two modifiers, written after commas in either order, change how the
            \\lines become a string. `oneline` joins the lines with a single space
            \\instead of a line feed, which suits prose wrapped in the source.
            \\`escape` decodes the escapes of quoted literals, listed above, in the
            \\joined text.
    );
    table_header(59, "Form   —   Lines joined with   —   Escapes");
    table_row(60, "`#string`   |   a line feed   |   not decoded");
    table_row(61, "`#string,oneline`   |   a space   |   not decoded");
    table_row(62, "`#string,escape`   |   a line feed   |   decoded");
    table_row(63, "`#string,oneline,escape`   |   a space   |   decoded");
    code_block(
        64,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\SENTENCE :: #string,oneline
            \\    \\A sentence wrapped
            \\    \\over three
            \\    \\source lines.
            \\;
            \\
            \\TABLE :: #string,escape
            \\    \\name\tsize
            \\    \\core\t12
            \\;
            \\
            \\main :: () {
            \\    print("[{}]\n", SENTENCE);
            \\    print("{}\n", TABLE);
            \\}
    );
    code_block(
        65,
        "text",
        #string
            \\[A sentence wrapped over three source lines.]
            \\name	size
            \\core	12
    );
    paragraph(
        66,
        #string,oneline
            \\Under `oneline` an empty marker line still counts, so the lines `a`,
            \\empty and `b` join as `a  b` with two spaces. Under `escape` the
            \\escapes are checked like those of a quoted literal, and an error
            \\points at the line that holds the bad escape. A backslash at the end
            \\of a line escapes the line feed that joins it to the next line, and
            \\the line feed is kept. Under `oneline,escape` the joining character
            \\is a space, and a backslash followed by a space is not an escape.
    );
    code_block(
        67,
        "text",
        #string
            \\// X :: #string,raw
            \\error: unknown #string modifier 'raw'; expected 'oneline' or 'escape'
            \\// X :: #string,oneline,oneline
            \\error: duplicate #string modifier 'oneline'
            \\// X :: #string;
            \\error: #string expects one or more '\\' lines
            \\// a line \\bad \q here  in a #string,escape block
            \\error: unknown string escape '\q'
            \\// a line ending in \  in a #string,oneline,escape block
            \\error: unknown string escape '\ '
    );
    subheading(68, "Using a `#string` block");
    paragraph(
        69,
        #string,oneline
            \\A `#string` block is a string literal and can appear wherever a
            \\quoted literal can: as a constant, as an argument, with an annotation
            \\that makes it a `cstr` or a `string16`, or as the format of `print`,
            \\whose placeholders are then filled as usual. A trailing empty marker
            \\line ends the text with a line feed.
    );
    code_block(
        70,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    print(#string
            \\        \\usage: {} [options] <file.glo>
            \\        \\  -o <file>   output path
            \\        \\
            \\    , "glosso");
            \\}
    );
    code_block(
        71,
        "text",
        #string
            \\usage: glosso [options] <file.glo>
            \\  -o <file>   output path
    );
    paragraph(
        72,
        #string,oneline
            \\Marker lines are tokens of their own, and only `#string` and `#asm`
            \\consume them (see `#asm`, `#bytes`, and `#magic`). Anywhere else the
            \\parser reports the captured text as an unexpected token: `x :=
            \\\\line one` gives `error: unexpected token 'line one'`. A single
            \\backslash outside a literal is not a token at all: `error: unexpected
            \\character '\'`.
    );
    subheading(73, "Characters: bytes and runes");
    paragraph(
        74,
        #string,oneline
            \\Glosso has no `char` type. Text is stored as code units, and a
            \\single character is either a byte, `u8`, or a Unicode scalar value,
            \\`rune`. `u8` is the 8-bit unsigned integer type. Indexing a `str`
            \\yields its bytes as `u8` values, and `.count` counts bytes. A `for`
            \\loop over a string decodes it instead and yields one `rune` for each
            \\Unicode scalar value, with `it_index` counting scalars rather than
            \\bytes:
    );
    code_block(
        75,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Ascii";
            \\
            \\main :: () {
            \\    text := "Grüße, 世界";
            \\    print("{} bytes\n", text.count);
            \\    letters := 0;
            \\    for i: 0..text.count {
            \\        if text[i].is_ascii_alpha() letters += 1;
            \\    }
            \\    print("{} ASCII letters\n", letters);
            \\    runes := 0;
            \\    for r: text {
            \\        runes += 1;
            \\        if r == #char "ü" print("found {c} at rune {}\n", r, it_index);
            \\    }
            \\    print("{} runes\n", runes);
            \\}
    );
    code_block(
        76,
        "text",
        #string
            \\15 bytes
            \\3 ASCII letters
            \\found ü at rune 2
            \\9 runes
    );
    paragraph(
        77,
        #string,oneline
            \\`rune` is four bytes wide and holds a code point, but it is not an
            \\integer type. Runes can be compared with `==` and ordered with `<`
            \\and the other comparisons, and that is all: there is no arithmetic on
            \\them, and no implicit conversion to or from integers. `u8` is an
            \\ordinary integer and converts to wider integers like any other.
    );
    code_block(
        78,
        "text",
        #string
            \\// l := #char "λ"; m := l + cast(rune) 1;
            \\error: no operator '+' for rune, rune
            \\// r : rune = 65;
            \\error: cannot convert comptime_int to rune
            \\// r : rune = #char "A"; n : u32 = r;
            \\error: got rune, expected u32
    );
    subheading(79, "`#char` literals");
    paragraph(
        80,
        #string,oneline
            \\`#char` followed by a quoted literal of exactly one character is
            \\that character's code point as a value. An ASCII character, U+0000
            \\to U+007F, is a `u8` unless the context asks for `s8` or `rune`. Any
            \\other character is a `rune`, and only a `rune`. No other type is
            \\accepted, even one wide enough for the value.
    );
    code_block(
        81,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\main :: () {
            \\    a := #char "A";
            \\    l := #char "λ";
            \\    print("{} {}\n", type_name(type_of(a)), type_name(type_of(l)));
            \\    signed : s8 = #char "A";
            \\    scalar : rune = #char "A";
            \\    print("{} {} {c}\n", a, signed, scalar);
            \\    digit := #char "7" - #char "0";
            \\    print("{} {}\n", digit, a + 1);
            \\}
    );
    code_block(
        82,
        "text",
        #string
            \\u8 rune
            \\65 65 A
            \\7 66
    );
    code_block(
        83,
        "text",
        #string
            \\// c : u32 = #char "A";
            \\error: #char literal can infer only as u8, s8, or rune, not u32
            \\// c : u8 = #char "λ";
            \\error: #char literal can infer only as rune, not u8
    );
    paragraph(
        84,
        #string,oneline
            \\A constant keeps this flexibility: after `SEP :: #char ",";`, `SEP`
            \\can initialize both a `u8` and a `rune`. A variable does not; it has
            \\the one type it was given.
    );
    subheading(85, "What `#char` accepts");
    paragraph(
        86,
        #string,oneline
            \\The literal may hold one character or one escape. The escapes are
            \\those of string literals, except `\%` and a backslash before a line
            \\break; the literal may not span lines. `\xHH` names the code point
            \\U+00HH, so `#char "\xff"` is the rune U+00FF, not the byte 255. A
            \\byte above 127 is written as an integer, `255` or `16#ff`. A letter
            \\with a combining mark is two code points and does not fit.
    );
    code_block(
        87,
        "text",
        #string
            \\// #char "ab"
            \\error: #char string literal must contain exactly one character
            \\// #char ""
            \\error: #char expects one character
            \\// #char x
            \\error: #char expects a string literal
            \\// #char "\q"
            \\error: unknown #char escape '\q'
            \\// #char "\x4"
            \\error: #char \x escape needs exactly two hexadecimal digits
            \\// #char "\u41"
            \\error: #char \u escape needs \u{...} with one to six hexadecimal digits
            \\// #char "a   with no closing quotation mark on the line
            \\error: unterminated #char string literal; write a line break as \n
    );
    subheading(88, "Comparing characters");
    paragraph(
        89,
        #string,oneline
            \\A `#char` compared with a byte or a rune takes that operand's type,
            \\so `text[i] == #char "c"` and `r == #char "é"` both work. A byte and
            \\a rune cannot be compared with each other, and a non-ASCII `#char` is
            \\always a rune, so it is never compared with a byte of a string:
    );
    code_block(
        90,
        "text",
        #string
            \\// found := text[3] == #char "é";
            \\error: no operator '==' for u8, rune
    );
    subheading(91, "Printing characters");
    paragraph(
        92,
        #string,oneline
            \\The default `{}` rendering prints a `u8` or a `rune` as its number.
            \\The `{c}` selector prints it as a character, writing a rune in
            \\UTF-8; a `u8` prints as the character with that code point. `{x}`
            \\and `{b}` require an integer, so a rune is converted first. `Show`,
            \\`Formatter`, `FromString`, and Format Strings lists the selectors.
    );
    code_block(
        93,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    r := #char "λ";
            \\    print("{} {c} {x}\n", r, r, cast(u32) r);
            \\}
    );
    code_block(
        94,
        "text",
        #string
            \\955 λ 3bb
    );
    subheading(95, "Converting and classifying characters");
    paragraph(
        96,
        #string,oneline
            \\`cast(u32) r` gives a rune's code point and `cast(rune) n` makes a
            \\rune from an integer; the cast does not check that the integer is a
            \\Unicode scalar value, so `cast(rune) 16#d800` is accepted.
            \\`b.char_to_rune()` turns a byte into the rune with the same number,
            \\which is the right character only for ASCII: it does not decode
            \\UTF-8.
    );
    paragraph(
        97,
        #string,oneline
            \\The `Ascii` module classifies and case-maps single bytes, as in
            \\`is_ascii_alpha` above. The `Unicode` module answers the same
            \\questions for code points with the full Unicode tables. Its queries
            \\take a code point as a `u32`, so a rune is converted first:
    );
    code_block(
        98,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Unicode";
            \\
            \\main :: () {
            \\    letters := 0;
            \\    for r: "Ωmega 42!" {
            \\        if (cast(u32) r).is_unicode_alpha() letters += 1;
            \\    }
            \\    print("{} letters\n", letters);
            \\    upper := (cast(u32) #char "ω").to_unicode_upper_rune();
            \\    print("{c}\n", cast(rune) upper);
            \\}
    );
    code_block(
        99,
        "text",
        #string
            \\5 letters
            \\Ω
    );
}

}
