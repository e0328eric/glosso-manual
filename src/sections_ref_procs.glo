#import "Format";
#import "String_Builder";
#import "Math/Core";
#import "clay_ui.glo";

#public {

// Chapters 52-58: Procedures and Generics.

render_section_52 :: () {
    paragraph(0, #string,oneline
        \\This chapter is the reference for declaring a procedure and for
        \\passing arguments to it: the parts of a signature, parameters,
        \\default values and named arguments, results, procedures that never
        \\return, and the places where a procedure may be declared. Procedures
        \\introduces the same material by example. The special kinds of
        \\parameter have chapters of their own (Variadic Procedures; `noalias`,
        \\`#lazy`, `#comptime`, and Type Parameters; Generic Procedures and `where`
        \\Clauses), and Inherent Methods, Member Access, and Call Syntax
        \\describes the call expression.
    );
    subheading(1, "The form of a declaration");
    paragraph(2, #string,oneline
        \\A procedure is declared the way every constant is: a name, `::`, and
        \\a value. The value is a procedure because it begins with a
        \\parenthesized parameter list. An optional result type after `->`
        \\and a body in braces follow the list.
    );
    code_block(3, "glosso", #string
        \\#import "Io";
        \\
        \\greet :: () {
        \\    print("hello\n");
        \\}
        \\
        \\add :: (a: s64, b: s64) -> s64 {
        \\    return a + b;
        \\}
        \\
        \\clamp :: (value, low, high: s64) -> s64 {
        \\    if value < low return low;
        \\    if value > high return high;
        \\    return value;
        \\}
        \\
        \\main :: () {
        \\    greet();
        \\    print("{} {}\n", add(2, 3), clamp(15, 0, 10));
        \\}
    );
    code_block(4, "text", #string
        \\hello
        \\5 10
    );
    paragraph(5, #string,oneline
        \\The parts of a declaration always come in the same order, and only
        \\the parameter list and, in most declarations, the body are
        \\required:
    );
    table_header(6, "Part   —   Form   —   Notes");
    table_row(7, "Parameters   |   `(a: s64, b: s64)`   |   Required; a procedure without parameters writes `()`.");
    table_row(8, "Result   |   `-> T`   |   Optional. Without it the procedure returns nothing (`void`).");
    table_row(9, "Directives   |   `#inline`, `#must`, ...   |   Optional; see Directives That Modify Procedures.");
    table_row(10, "Constraints   |   `where ...`   |   Optional, after every directive; see Generic Procedures and `where` Clauses.");
    table_row(11, "Body   |   `{ ... }`   |   Required, except for `#foreign` and `#magic` declarations and typeclass operations.");
    subheading(12, "Parameters");
    paragraph(13, #string,oneline
        \\Each parameter is written `name: Type`. Several names followed by one
        \\type share it, so `(value, low, high: s64)` declares three `s64`
        \\parameters. A trailing comma after the last parameter is allowed,
        \\which helps when a long list is written one parameter per line. Two
        \\parameters may not have the same name (`error: parameter 'a' is
        \\already declared`, with a note at the first one).
    );
    paragraph(14, #string,oneline
        \\Inside the body a parameter is a local variable that starts as a copy
        \\of the argument. Assigning to it changes the copy and nothing else. A
        \\procedure that must change a variable of its caller takes a pointer
        \\to it, as `bump` does here:
    );
    code_block(15, "glosso", #string
        \\#import "Io";
        \\
        \\bump_copy :: (counter: s64) -> s64 {
        \\    counter += 1;          // changes this call's copy only
        \\    return counter;
        \\}
        \\
        \\bump :: (counter: *s64) {
        \\    counter.* += 1;
        \\}
        \\
        \\main :: () {
        \\    n: s64 = 5;
        \\    print("{} {}\n", bump_copy(n), n);
        \\    bump(&n);
        \\    print("{}\n", n);
        \\}
    );
    code_block(16, "text", #string
        \\6 5
        \\6
    );
    subheading(17, "Default values");
    paragraph(18, #string,oneline
        \\A parameter may have a default value, written `= value` after its
        \\type. A call may leave such a parameter out, and the default takes
        \\its place. Any argument may also be passed by the name of its
        \\parameter, written `.name = value`; that is how a call skips one
        \\default and supplies a later one.
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\
        \\greet :: (name: str, greeting: str = "hello", mark: str = "!") {
        \\    print("{} {}{}\n", greeting, name, mark);
        \\}
        \\
        \\main :: () {
        \\    greet("world");
        \\    greet("world", "goodbye");
        \\    greet("world", .mark = "?");
        \\    greet(.greeting = "hi", .name = "you");
        \\}
    );
    code_block(20, "text", #string
        \\hello world!
        \\goodbye world!
        \\hello world?
        \\hi you!
    );
    table_header(21, "Form   —   Meaning");
    table_row(22, "`b: s64 = 3`   |   A parameter with a default.");
    table_row(23, "`a, b: s64 = 3`   |   Both names have the type and the default.");
    table_row(24, "`factor := 2.0`   |   A default without a written type; the type is the default's.");
    table_row(25, "`f(x, .name = v)`   |   At a call: the argument for parameter `name`.");
    paragraph(26, #string,oneline
        \\When several names share one type, a default written after the type
        \\is shared too: in `(a, b: s64 = 3)` both parameters default to 3.
        \\`name := value` declares a defaulted parameter whose type is the type
        \\of the default, the way `:=` declares a variable. A number literal
        \\there takes its default type, `ssize` for an integer and `f64` for a
        \\float. The `:=` form declares one name at a time.
    );
    code_block(27, "glosso", #string
        \\#import "Io";
        \\
        \\shared :: (a, b: s64 = 3) -> s64 { return a * 10 + b; }
        \\scaled :: (x: f64, factor := 2.0) -> f64 { return x * factor; }
        \\
        \\main :: () {
        \\    print("{} {} {}\n", shared(), shared(1), shared(1, 2));
        \\    print("{} {}\n", scaled(1.5), scaled(1.5, 3));
        \\}
    );
    code_block(28, "text", #string
        \\33 13 12
        \\3 4.5
    );
    subheading(29, "Named arguments");
    paragraph(30, #string,oneline
        \\A named argument is a dot, the parameter's name, `=` and the value.
        \\The dot is required: without it, `f(1, b = 3)` reads `b = 3` as an
        \\assignment and fails with `error: unexpected token '='`. Named and
        \\positional arguments can be mixed in any order. The positional ones
        \\fill, from left to right, the parameters that no name has claimed.
    );
    code_block(31, "glosso", #string
        \\#import "Io";
        \\
        \\volume :: (width: s64 = 1, height: s64 = 1, depth: s64 = 1) -> s64 {
        \\    return width * height * depth;
        \\}
        \\
        \\main :: () {
        \\    print("{}\n", volume(.depth = 2, .width = 3, .height = 4));
        \\    print("{}\n", volume(3, .depth = 2));
        \\    print("{}\n", volume(.width = 5, 2));      // 2 is the height
        \\}
    );
    code_block(32, "text", #string
        \\24
        \\6
        \\10
    );
    paragraph(33, #string,oneline
        \\A call that names a parameter that does not exist, names one twice,
        \\supplies a parameter both by position and by name, or leaves out a
        \\parameter without a default fails as a whole. Every one of these
        \\mistakes gives the same error, which lists the signature with `...`
        \\in place of each default:
    );
    code_block(34, "text", #string
        \\// f :: (a: s64, b: s64 = 2) -> s64 { ... }    f(1, .c = 3);
        \\error: no overload 'f' accepts these arguments
        \\note: possible candidates for 'f':
        \\candidate: f :: (a: s64, b: s64 = ...) -> s64
    );
    paragraph(35, #string,oneline
        \\Named arguments match the names of a declaration. A call through a
        \\function pointer has no declaration to match, and is passed by
        \\position (see Lambdas and `#fn_ptr` Values).
    );
    subheading(36, "Defaults before other parameters");
    paragraph(37, #string,oneline
        \\A parameter with a default does not have to come after those
        \\without one. A parameter after a defaulted one can then be reached
        \\only by name, or by passing every parameter before it:
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\
        \\span :: (start: s64 = 0, end: s64) -> s64 { return end - start; }
        \\
        \\main :: () {
        \\    print("{} {}\n", span(.end = 10), span(4, 10));
        \\}
    );
    code_block(39, "text", #string
        \\10 6
    );
    paragraph(40, #string,oneline
        \\Variadic parameters use the same rule in reverse: every parameter
        \\after a variadic one must have a default, and is passed by name (see
        \\Variadic Procedures).
    );
    subheading(41, "When a default is evaluated");
    paragraph(42, #string,oneline
        \\A default is an expression that is evaluated at every call that
        \\leaves the argument out, in the place of the missing argument. A
        \\default that calls a procedure calls it each time, and a default
        \\that reads a global reads the value the global has at the time of
        \\the call.
    );
    code_block(43, "glosso", #string
        \\#import "Io";
        \\
        \\next_id := 0;
        \\
        \\new_id :: () -> s64 {
        \\    next_id += 1;
        \\    return next_id;
        \\}
        \\
        \\label :: (name: str, id: s64 = new_id()) {
        \\    print("{} #{}\n", name, id);
        \\}
        \\
        \\main :: () {
        \\    label("first");
        \\    label("second");
        \\    label("fixed", 100);
        \\    label("third");
        \\}
    );
    code_block(44, "text", #string
        \\first #1
        \\second #2
        \\fixed #100
        \\third #3
    );
    paragraph(45, #string,oneline
        \\Because the default is evaluated where the call is, it cannot use
        \\the other parameters, which do not exist there:
    );
    code_block(46, "text", #string
        \\// span :: (start: s64, end: s64 = start + 10) -> s64 { ... }
        \\error: unbound 'start'
        \\help: the default value of parameter 'end' cannot use parameter 'start' of 'span': a default is evaluated at each call site, where the other arguments are not in scope
    );
    note(47, #string,oneline
        \\A default of `#source_location` records where the default is written,
        \\not where the call is: `#source_location` is replaced by the file,
        \\line and column of its own appearance when the source is parsed. A
        \\procedure that reports its caller's position must be passed
        \\`.location = #source_location` by the caller.
    );
    subheading(48, "Defaults belong to the declaration");
    paragraph(49, #string,oneline
        \\A default is part of the declaration, not of the procedure's type.
        \\A call through a function pointer therefore passes every argument,
        \\and no default is available there (see Lambdas and `#fn_ptr`
        \\Values).
    );
    paragraph(50, #string,oneline
        \\A typeclass operation may declare defaults. Each instance must then
        \\declare a default for the same parameters, though it may choose a
        \\different value, and a call uses the default of the instance that
        \\it selects:
    );
    code_block(51, "glosso", #string
        \\#import "Io";
        \\
        \\Render :: typeclass (T: type) {
        \\    render :: (value: T, width: s64 = 4) -> s64;
        \\}
        \\
        \\s64 ::: instance Render {
        \\    render :: (value: s64, width: s64 = 4) -> s64 { return value * width; }
        \\}
        \\
        \\bool ::: instance Render {
        \\    render :: (value: bool, width: s64 = 9) -> s64 { if value return width; return 0; }
        \\}
        \\
        \\main :: () {
        \\    n: s64 = 3;
        \\    print("{} {} {}\n", render(n), render(n, 10), render(n, .width = 5));
        \\    print("{} {}\n", render(true), render(true, 2));
        \\}
    );
    code_block(52, "text", #string
        \\12 30 15
        \\9 2
    );
    paragraph(53, #string,oneline
        \\An instance whose operation leaves out the default does not match the
        \\typeclass. With `render :: (value: s64, width: s64)` in the `s64`
        \\instance, the error shows both signatures:
    );
    code_block(54, "text", #string
        \\error: instance 's64 :: Render' does not satisfy the implicit minimal definition; missing render; render is defined, but its signature does not match the typeclass
        \\note: instance defines render :: (value: s64, width: s64) -> s64
        \\note: typeclass 'Render' declares render :: (value: T, width: s64 = ...) -> s64
    );
    paragraph(55, #string,oneline
        \\Compile-time and type parameters take defaults too; `noalias`,
        \\`#lazy`, `#comptime`, and Type Parameters shows them.
    );
    subheading(56, "The result");
    paragraph(57, #string,oneline
        \\A procedure without `->` returns `void`, and writing `-> void`
        \\means the same. Every `return` must then come without a value. With
        \\a result type, every `return` must carry a value that converts to
        \\it, and the body must not be able to reach its closing brace without
        \\returning. The compiler decides that from the control flow, not from
        \\whether a `return` appears somewhere:
    );
    code_block(58, "text", #string
        \\// greet :: () { return 1; }
        \\error: got ssize, expected void
        \\
        \\// count :: () -> s64 { return "one"; }
        \\error: got str, expected s64
        \\
        \\// sign :: (x: s64) -> s64 { if x > 0 return 1; if x < 0 return -1; }
        \\error: function 'sign' can reach the end of its body without returning a value
    );
    paragraph(59, #string,oneline
        \\An `if` whose branches all return, a switch whose cases all return,
        \\and a `while true` loop that is left only by `return` all satisfy
        \\the rule. One result type is exempt: a procedure returning `E!void`
        \\may run off the end of its body, which returns `.Ok` (see `?T` and
        \\`E!T`).
    );
    subheading(60, "Several results");
    paragraph(61, #string,oneline
        \\A procedure returns several values as a tuple. The result type lists
        \\the element types in parentheses, and `return a, b;` returns one
        \\value for each. The caller keeps the tuple or destructures it, as
        \\Tuple Types describes.
    );
    paragraph(62, #string,oneline
        \\The elements may also be named, as in `-> (low: s64, high: s64)`.
        \\Each name is then a local variable of the body, initialized to zero,
        \\and a `return;` without values, or reaching the end of the body,
        \\returns the current values of the names. `return x, y;` still works
        \\and returns what it lists. The names belong to the body only: the
        \\caller receives an ordinary tuple, whose elements are `.0` and `.1`.
    );
    code_block(63, "glosso", #string
        \\#import "Io";
        \\
        \\divide :: (a: s64, b: s64) -> (s64, s64) {
        \\    return a / b, a % b;
        \\}
        \\
        \\bounds :: (values: []s64) -> (low: s64, high: s64) {
        \\    if values.count == 0 return;         // returns 0, 0
        \\    low = values[0];
        \\    high = values[0];
        \\    for values {
        \\        if it < low low = it;
        \\        if it > high high = it;
        \\    }
        \\}
        \\
        \\main :: () {
        \\    quotient, remainder := divide(17, 5);
        \\    print("{} {}\n", quotient, remainder);
        \\    samples: [4]s64 = .[7, -2, 9, 4];
        \\    low, high := bounds(samples[..]);
        \\    print("{} {}\n", low, high);
        \\    nothing := bounds(samples[0..0]);
        \\    print("{} {}\n", nothing.0, nothing.1);
        \\}
    );
    code_block(64, "text", #string
        \\3 2
        \\-2 9
        \\0 0
    );
    paragraph(65, #string,oneline
        \\The number of values in a `return` must match the signature:
        \\`return 1;` in a procedure returning `(s64, str)` is `error: return
        \\has 1 value but the signature returns 2 values`.
    );
    subheading(66, "Procedures that do not return");
    paragraph(67, #string,oneline
        \\The result type `#Never` declares that a call never comes back: the
        \\procedure ends the process, jumps elsewhere, or loops forever. `exit`
        \\is declared this way. The compiler uses the declaration in both
        \\directions. The body of a `#Never` procedure may not return or reach
        \\its end. A call to one ends the path it is on, so the code after it
        \\needs no `return`, and the call is accepted where a value of any type
        \\is expected.
    );
    code_block(68, "glosso", #string
        \\#import "Io";
        \\
        \\fail :: (message: str) -> #Never {
        \\    print("fatal: {}\n", message);
        \\    exit(2);
        \\}
        \\
        \\digit_value :: (c: u8) -> s64 {
        \\    if c >= #char "0" && c <= #char "9" return c - #char "0";
        \\    fail("not a digit");      // no return needed after this call
        \\}
        \\
        \\main :: () {
        \\    n := digit_value(#char "7");
        \\    checked: s64 = ifx n > 5 n else fail("too small");
        \\    print("{} {}\n", n, checked);
        \\    _ := digit_value(#char "x");
        \\    print("not reached\n");
        \\}
    );
    code_block(69, "text", #string
        \\$ glosso --run never.glo 2>&1 | tail -3
        \\7 7
        \\fatal: not a digit
        \\glosso: program exited with status 2
    );
    code_block(70, "text", #string
        \\// oops :: () -> #Never { }
        \\error: #Never function 'oops' can return normally
        \\
        \\// oops :: () -> #Never { return; }
        \\error: empty return in function returning #Never
    );
    paragraph(71, #string,oneline
        \\`#Never` has no values, so a variable of that type cannot exist
        \\(`error: #Never has no values and cannot be default-initialized`).
    );
    subheading(72, "Order, recursion, and local procedures");
    paragraph(73, #string,oneline
        \\The top level of a module is one scope, so a procedure may call
        \\another that is declared further down, and procedures may call
        \\themselves and each other recursively:
    );
    code_block(74, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    print("{} {} {}\n", is_even(10), is_odd(7), factorial(20));
        \\}
        \\
        \\is_even :: (n: u64) -> bool { if n == 0 return true; return is_odd(n - 1); }
        \\is_odd :: (n: u64) -> bool { if n == 0 return false; return is_even(n - 1); }
        \\
        \\factorial :: (n: u64) -> u64 {
        \\    if n <= 1 return 1;
        \\    return n * factorial(n - 1);
        \\}
    );
    code_block(75, "text", #string
        \\true true 2432902008176640000
    );
    paragraph(76, #string,oneline
        \\A procedure declared inside a body belongs to the block that holds
        \\it. It may be called anywhere in that block, also above its
        \\declaration, and nowhere outside it (`error: unknown function
        \\twice`). It sees the top-level names of its module, as any procedure
        \\does:
    );
    code_block(77, "glosso", #string
        \\#import "Io";
        \\
        \\LIMIT :: 3;
        \\
        \\main :: () {
        \\    print("{}\n", clamp_to_limit(7));      // declared further down
        \\    clamp_to_limit :: (x: s64) -> s64 {
        \\        if x > LIMIT return LIMIT;
        \\        return x;
        \\    }
        \\    {
        \\        twice :: (x: s64) -> s64 { return x * 2; }
        \\        print("{}\n", twice(clamp_to_limit(2)));
        \\    }
        \\}
    );
    code_block(78, "text", #string
        \\3
        \\4
    );
    paragraph(79, #string,oneline
        \\A local procedure is not a closure: it cannot read the variables or
        \\parameters of the procedure around it, which do not exist when it is
        \\called on its own. With `base := 10;` in `main`, a local `add_base ::
        \\(x: s64) -> s64 { return x + base; }` is `error: unbound 'base'`.
        \\Assignment, Blocks, and Name Lookup gives the scope rules.
    );
    subheading(80, "One procedure per name");
    paragraph(81, #string,oneline
        \\A name denotes one procedure. Declaring a second procedure with the
        \\same name in the same scope is `error: function 'add' is already
        \\declared`, even when the parameter types differ. Code that must
        \\accept several types is written once, generically (Generic
        \\Procedures and `where` Clauses), or as a typeclass with one instance
        \\per type (Typeclass Declarations and Instances). Optional arguments
        \\are defaults, described above.
    );
    subheading(82, "Declarations without a body");
    paragraph(83, #string,oneline
        \\A signature followed by `;` instead of a body is rejected (`error:
        \\unexpected token ';'`), except in three places. A `#foreign`
        \\declaration names a procedure of a C library, which the linker
        \\supplies; a `#magic` declaration names an operation that the
        \\compiler implements itself; and a typeclass lists its operations as
        \\signatures that its instances implement.
    );
    code_block(84, "glosso", #string
        \\#import "Io";
        \\
        \\libc :: #library "c";
        \\
        \\c_abs :: (value: s32) -> s32 #foreign libc "abs";
        \\
        \\main :: () {
        \\    print("{}\n", c_abs(-5));
        \\}
    );
    code_block(85, "text", #string
        \\5
    );
    paragraph(86, #string,oneline
        \\`#foreign`, `#library`, and `#c_call` describes the first kind,
        \\`#asm`, `#bytes`, and `#magic` the second, and Typeclass
        \\Declarations and Instances the third.
    );
    subheading(87, "Procedures as values");
    paragraph(88, #string,oneline
        \\The name of a procedure is also a value: `operation := add;` stores
        \\a pointer to `add`, whose type is written `(s64, s64) -> s64`, and
        \\`operation(2, 3)` calls through it. Lambdas and `#fn_ptr` Values
        \\covers these values and the anonymous procedures written inside an
        \\expression.
    );
}

render_section_53 :: () {
    paragraph(0, #string,oneline
        \\A variadic parameter accepts any number of arguments, including none,
        \\and gives the body all of them as one value, the pack. This chapter
        \\describes the forms of variadic parameter, what the body receives
        \\for each, how an existing array is passed with `...`, packs whose
        \\elements must satisfy a typeclass, and the rules that a declaration
        \\must follow.
    );
    subheading(1, "Forms of a variadic parameter");
    paragraph(2, #string,oneline
        \\A variadic parameter is written with three dots before its element
        \\type, as in `values: ...s64`. What follows the dots decides what the
        \\arguments may be and what the body sees:
    );
    table_header(3, "Parameter   —   Arguments   —   The body sees");
    table_row(4, "`values: ...s64`   |   Values that convert to `s64`.   |   A view `[]s64`.");
    table_row(5, "`values: ...$T`   |   Values of one type, which becomes `T`.   |   A view `[]T`.");
    table_row(6, "`values: ...any`   |   Values of any types.   |   A tuple of the arguments, each with its own type.");
    table_row(7, "`values: ...`   |   Values of any types.   |   A view `[]any`.");
    table_row(8, "`values: ...Show`   |   Values whose types have an instance of the typeclass.   |   A tuple of the arguments; see Packs constrained by a typeclass below.");
    code_block(9, "glosso", #string
        \\#import "Io";
        \\
        \\sum :: (values: ...s64) -> s64 {
        \\    total: s64 = 0;
        \\    for values total += it;
        \\    return total;
        \\}
        \\
        \\largest :: (values: ...$T) -> T where PartialOrd(T, T) {
        \\    best := values[0];
        \\    for values if it > best best = it;
        \\    return best;
        \\}
        \\
        \\main :: () {
        \\    print("{} {} {}\n", sum(1, 2, 3), sum(10), sum());
        \\    print("{} {}\n", largest(3, 9, 4), largest("pear", "apple", "plum"));
        \\}
    );
    code_block(10, "text", #string
        \\6 10 0
        \\9 plum
    );
    paragraph(11, #string,oneline
        \\In the body the pack has a `count`, can be indexed and can be walked
        \\with `for`, like any view. For `...s64`, `...$T` and `...` it really
        \\is a view, so it can be passed on wherever a `[]s64`, `[]T` or
        \\`[]any` is expected. `largest` states with a `where` clause that `T`
        \\must support `>`; Generic Procedures and `where` Clauses explains why
        \\the clause belongs there.
    );
    paragraph(12, #string,oneline
        \\The storage behind the view belongs to the call. The body may read
        \\and write the elements, but must not keep the view after it returns.
    );
    subheading(13, "The element type");
    paragraph(14, #string,oneline
        \\The element type after the dots is a single name: a type, a `$`
        \\capture, a typeclass, or a parenthesized list of typeclasses. A
        \\type built from several parts, such as `*s64` or `[]u8`, is not
        \\accepted there (`values: ...*s64` is `error: unexpected token
        \\'*'`). Give such a type a name first:
    );
    code_block(15, "glosso", #string
        \\#import "Io";
        \\
        \\Counter_Ref :: *s64;
        \\
        \\reset_all :: (counters: ...Counter_Ref) {
        \\    for counters it.* = 0;
        \\}
        \\
        \\main :: () {
        \\    a: s64 = 4;
        \\    b: s64 = 7;
        \\    reset_all(&a, &b);
        \\    print("{} {}\n", a, b);
        \\}
    );
    code_block(16, "text", #string
        \\0 0
    );
    paragraph(17, #string,oneline
        \\Every argument must convert to a fixed element type. With `...$T` the
        \\arguments must all have one type, and `T` is decided as for any
        \\generic parameter (see Generic Procedures and `where` Clauses): an
        \\argument of a definite type decides it, and a literal adapts. When
        \\the first argument is a literal and a later one is of another kind,
        \\the message names the literal's type:
    );
    code_block(18, "text", #string
        \\// sum(1, "two");
        \\error: arg type str != s64 in call sum
        \\
        \\// largest(1, "two");
        \\error: arg type str != comptime_int in call largest
    );
    subheading(19, "Passing an array with `...`");
    paragraph(20, #string,oneline
        \\Writing `...` after an argument expands an existing array into the
        \\variadic parameter, instead of passing the array as one element. A
        \\fixed array, a view and a dynamic array can all be expanded.
        \\Parameters before the variadic one are written as usual.
    );
    code_block(21, "glosso", #string
        \\#import "Io";
        \\
        \\sum :: (label: str, values: ...s64) -> s64 {
        \\    total: s64 = 0;
        \\    for v: values total += v;
        \\    print("{}: {} values, ", label, values.count);
        \\    return total;
        \\}
        \\
        \\main :: () {
        \\    fixed: [4]s64 = .[1, 2, 3, 4];
        \\    dynamic: [..]s64;
        \\    defer dynamic.free();
        \\    dynamic.push(5, 6);
        \\    print("{}\n", sum("written", 1, 2, 3));
        \\    print("{}\n", sum("fixed", fixed...));
        \\    print("{}\n", sum("slice", fixed[1..]...));
        \\    print("{}\n", sum("dynamic", dynamic...));
        \\    print("{}\n", sum("none"));
        \\}
    );
    code_block(22, "text", #string
        \\written: 3 values, 6
        \\fixed: 4 values, 10
        \\slice: 3 values, 9
        \\dynamic: 2 values, 11
        \\none: 0 values, 0
    );
    paragraph(23, #string,oneline
        \\Expansion copies nothing: for `...T` and `...$T` the pack becomes a
        \\view of the expanded array itself, so a callee that writes to its
        \\pack writes to the caller's array.
    );
    code_block(24, "glosso", #string
        \\#import "Io";
        \\
        \\zero_first :: (values: ...s64) {
        \\    values[0] = 0;
        \\}
        \\
        \\main :: () {
        \\    a: [3]s64 = .[1, 2, 3];
        \\    zero_first(a...);           // the pack is a view of a itself
        \\    print("{} {} {}\n", a[0], a[1], a[2]);
        \\}
    );
    code_block(25, "text", #string
        \\0 2 3
    );
    paragraph(26, #string,oneline
        \\An expanded array replaces the whole pack. It cannot be combined
        \\with written-out arguments for the same parameter, even when it comes
        \\last, and a call has at most one expansion. The rules and their
        \\diagnostics, for `sum :: (values: ...s64)`:
    );
    table_header(27, "Call   —   Diagnostic");
    table_row(28, "`sum(xs..., ys...)`   |   call `sum` has more than one expanded argument");
    table_row(29, "`sum(100, xs...)`, `sum(xs..., 100)`   |   expanded argument must be the final variadic argument in call `sum`");
    table_row(30, "`sum(x...)` with `x: s64`, or a `str`, or a tuple   |   expanded variadic argument to `sum` must be an array");
    table_row(31, "`sum(xs...)` with `xs: [2]f64`   |   expanded variadic arg type `[2]f64` != `[]s64` in call `sum`");
    paragraph(32, #string,oneline
        \\Expansion only fills a variadic parameter. It does not spread an
        \\array over ordinary parameters, so `add3(xs...)` for `add3 :: (a,
        \\b, c: s64)` is `error: no overload 'add3' accepts these arguments`.
        \\Inside a variadic procedure, `values...` forwards the pack to
        \\another one. `...` belongs to call syntax only; `y := xs...;` is
        \\`error: unexpected token '...'`.
    );
    subheading(33, "Arguments of any type: `...` and `...any`");
    paragraph(34, #string,oneline
        \\`...any` and the bare `...` both accept arguments of different types,
        \\but they give the body different things. A bare `...` converts every
        \\argument to `any`, a reference to the value together with its type
        \\(see Catalog of Built-in Types), and the body sees a `[]any`.
        \\`...any` keeps each argument with its own type in a tuple. A
        \\constant index, or a `#inline for` (see `while`, `for`, and Unrolled
        \\Loops), then yields an element of its own type, while a plain `for`
        \\or an index computed at run time yields an `any`.
    );
    code_block(35, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\boxed :: (values: ...) {
        \\    print("{}:", type_name(type_of(values)));
        \\    for values print(" {}", it.type.name);
        \\    print("\n");
        \\}
        \\
        \\kept :: (values: ...any) {
        \\    print("{}:", type_name(type_of(values)));
        \\    #inline for values print(" {}", type_name(type_of(it)));
        \\    print(" | second is {}\n", type_name(type_of(values[1])));
        \\}
        \\
        \\main :: () {
        \\    boxed(1, "two", 3.5);
        \\    kept(1, "two", 3.5);
        \\}
    );
    code_block(36, "text", #string
        \\[]any: ssize str f64
        \\(ssize, str, f64): ssize str f64 | second is str
    );
    paragraph(37, #string,oneline
        \\The tuple of a `...any` pack exists only for written-out arguments,
        \\whose number and types belong to the call. An expanded array arrives
        \\as a `[]any`, with every element boxed, because its length belongs
        \\to the array. A bare `...` boxes the elements of an expanded array
        \\in the same way, whatever their type.
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\describe :: (values: ...any) {
        \\    print("{} with {} values\n", type_name(type_of(values)), values.count);
        \\}
        \\
        \\main :: () {
        \\    numbers: [3]s64 = .[7, 8, 9];
        \\    describe(1, "two", 3.0);
        \\    describe(numbers...);
        \\}
    );
    code_block(39, "text", #string
        \\(ssize, str, f64) with 3 values
        \\[]any with 3 values
    );
    paragraph(40, #string,oneline
        \\Because `...any` keeps the types, it is the form for passing
        \\arguments on to a procedure that needs them, such as `print`. The
        \\pack is forwarded with `values...`:
    );
    code_block(41, "glosso", #string
        \\#import "Io";
        \\
        \\log :: (#comptime format: str, values: ...any) {
        \\    print("[log] ");
        \\    print(format, values...);
        \\}
        \\
        \\main :: () {
        \\    log("{} + {} = {x}\n", 2, 3, 255);
        \\}
    );
    code_block(42, "text", #string
        \\[log] 2 + 3 = ff
    );
    paragraph(43, #string,oneline
        \\The format is a `#comptime` parameter (see `noalias`, `#lazy`, `#comptime`,
        \\and Type Parameters) because `print` checks the placeholders
        \\against the arguments while compiling. For the same reason `print`
        \\and the other formatting procedures need their arguments written
        \\out, or forwarded as a tuple as here. An expanded array, as in
        \\`print("{} {}\n", xs...)`, is rejected, with an error raised inside
        \\the standard library (`error: comptime variable initializer must be
        \\compile-time evaluable` and `note: unknown const args`).
    );
    subheading(44, "Packs constrained by a typeclass");
    paragraph(45, #string,oneline
        \\A variadic parameter may name a typeclass instead of a type.
        \\`values: ...Named` accepts any number of arguments of any types,
        \\provided each has a `Named` instance, and `...(Show && PartialEq)`
        \\requires every class in the list. Each argument keeps its own type,
        \\so in the example `name_of(it)` reaches a different instance in each
        \\iteration:
    );
    code_block(46, "glosso", #string
        \\#import "Io";
        \\#import "Format";
        \\#import "Meta";
        \\
        \\Named :: typeclass (T: type) {
        \\    name_of :: (value: T) -> str;
        \\}
        \\$T ::: instance Named where Is_Integer(T) {
        \\    name_of :: (value: T) -> str { return tprint("int {}", value); }
        \\}
        \\str ::: instance Named {
        \\    name_of :: (value: str) -> str { return tprint("text \"{}\"", value); }
        \\}
        \\bool ::: instance Named {
        \\    name_of :: (value: bool) -> str { return "flag"; }
        \\}
        \\
        \\describe_all :: (values: ...Named) {
        \\    for values print("{}: {}\n", it_index, name_of(it));
        \\}
        \\
        \\count_both :: (values: ...(Show && PartialEq)) -> ssize {
        \\    return values.count;
        \\}
        \\
        \\main :: () {
        \\    describe_all(1, "two", true, cast(u8) 4);
        \\    print("{}\n", count_both(10, "y", 2.5));
        \\}
    );
    code_block(47, "text", #string
        \\0: int 1
        \\1: text "two"
        \\2: flag
        \\3: int 4
        \\3
    );
    paragraph(48, #string,oneline
        \\A list may join classes only with `&&`: `...(Show || PartialEq)` is
        \\`error: unexpected token '||'`, since the body could then call no
        \\method on every element.
    );
    paragraph(49, #string,oneline
        \\The constraint is checked for each argument at the call, and the
        \\error names the argument's type, the missing class and the call. For
        \\a list, it names the first class the argument lacks. Expanding an
        \\array with `xs...` checks the element type once:
    );
    code_block(50, "text", #string
        \\// take_show :: (xs: ...Show) {}   take_show(1, foo);   (Foo has no Show)
        \\error: variadic arg type `Foo` does not implement `Show` in call `take_show`
        \\// both :: (xs: ...(Show && PartialEq)) {}   both(1, Foo.{ 1 });   (Foo derives only Show)
        \\error: variadic arg type `Foo` does not implement `PartialEq` in call `both`
        \\// take_show(foos...);
        \\error: expanded variadic element type `Foo` does not implement `Show` in call `take_show`
    );
    subheading(51, "The shape of a constrained pack");
    paragraph(52, #string,oneline
        \\A constrained pack takes its shape from the call, as a `...any` pack
        \\does. Arguments written out in the call form a tuple of their types,
        \\known at compile time: a `for` over it is unrolled, so `it` has each
        \\element's own type, and `values.count` and the type of `values[1]`
        \\are compile-time facts. An expanded array arrives as a `[]any` view.
    );
    code_block(53, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\inspect :: (values: ...Show) {
        \\    print("{} values in a {}\n", values.count, type_name(type_of(values)));
        \\    for values print("  [{}] {}\n", it_index, it);
        \\}
        \\
        \\forward :: (values: ...Show) {
        \\    inspect(values...);
        \\}
        \\
        \\main :: () {
        \\    inspect(1, "two", 3.5);
        \\    xs: [2]s32 = .[7, 8];
        \\    inspect(xs...);
        \\    forward(true, cast(u8) 9);
        \\}
    );
    code_block(54, "text", #string
        \\3 values in a (ssize, str, f64)
        \\  [0] 1
        \\  [1] two
        \\  [2] 3.5
        \\2 values in a []any
        \\  [0] 7
        \\  [1] 8
        \\2 values in a (bool, u8)
        \\  [0] true
        \\  [1] 9
    );
    paragraph(55, #string,oneline
        \\`forward` passes its pack on with `values...`, and `inspect` receives
        \\the same tuple. Formatting works on both shapes, since `{}` accepts an
        \\`any`. A class method does not: called on an element of the `[]any`
        \\view, `name_of(it)` in `describe_all` above has no instance to
        \\choose, and `describe_all(xs...)` fails with `error: no overload
        \\'name_of' accepts these arguments` and `note: in instantiation of
        \\'describe_all'`, although the constraint was checked for the
        \\element type at the call. A procedure that calls class methods on
        \\its elements is meant to be called with the arguments written out;
        \\for an array, loop over it and call the method on each element
        \\instead.
    );
    subheading(56, "Per-element code with `#inline for`");
    paragraph(57, #string,oneline
        \\`#inline for` over a pack of written-out arguments expands its body
        \\once per argument with the element's type known. The body can bind
        \\that type to a constant, ask for evidence with `#if`, and keep code
        \\that only some elements can compile in the branch that only they
        \\reach:
    );
    code_block(58, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Unit :: typeclass (T: type) {
        \\    unit_of :: (value: T) -> str;
        \\}
        \\
        \\Meters :: struct #derive(Show) { n: f64; }
        \\Seconds :: struct { n: f64; }
        \\Meters ::: instance Unit { unit_of :: (value: Meters) -> str { return "m"; } }
        \\Seconds ::: instance Unit { unit_of :: (value: Seconds) -> str { return "s"; } }
        \\
        \\label_all :: (values: ...Unit) {
        \\    #inline for values {
        \\        T :: type_of(it);
        \\        #if Show(T) print("{} {} shows as {}\n", type_name(T), unit_of(it), it);
        \\        else print("{} {} has no Show\n", type_name(T), unit_of(it));
        \\    }
        \\}
        \\
        \\main :: () {
        \\    label_all(Meters.{ 3 }, Seconds.{ 4 });
        \\}
    );
    code_block(59, "text", #string
        \\Meters m shows as {3}
        \\Seconds s has no Show
    );
    paragraph(60, #string,oneline
        \\`unit_of(it)` needs no test because the pack's constraint guarantees
        \\`Unit` for every element; `Show` is tested per element. Over an
        \\expanded array, `#inline for` is `error: #inline for needs a
        \\compile-time iterable; a runtime-length array expansion cannot be
        \\unrolled`. `while`, `for`, and Unrolled Loops describes the loop
        \\itself.
    );
    subheading(61, "Parameters after a variadic one");
    paragraph(62, #string,oneline
        \\A variadic parameter takes every remaining positional argument, so a
        \\parameter declared after it can be passed only by name, and must
        \\have a default:
    );
    code_block(63, "glosso", #string
        \\#import "Io";
        \\
        \\report :: (values: ...s64, label: str = "sum") {
        \\    total: s64 = 0;
        \\    for values total += it;
        \\    print("{} = {}\n", label, total);
        \\}
        \\
        \\main :: () {
        \\    report(1, 2, 3);
        \\    report(4, 5, .label = "subtotal");
        \\}
    );
    code_block(64, "text", #string
        \\sum = 6
        \\subtotal = 9
    );
    subheading(65, "Rules");
    table_header(66, "Declaration   —   Diagnostic");
    table_row(67, "`(values: ...s64, count: s64)`   |   `parameters after a variadic parameter must have default values`");
    table_row(68, "`(a, b: ...s64)`   |   `variadic parameter must have one name`");
    table_row(69, "`(values: ...s64 = 1)`   |   `variadic parameter cannot have a default value`");
    table_row(70, "`(values: ..s64)`   |   `variadic parameter uses '...T'; '..' is the range operator`");
    table_row(71, "`(#lazy values: ...s64)`   |   `#lazy cannot qualify a variadic parameter`");
    table_row(72, "`(#comptime values: ...s64)`   |   `unexpected token '...'`");
    table_row(73, "`(values: ...(Show || Eq))`   |   `unexpected token '||'`: typeclasses are combined with `&&` only");
    paragraph(74, #string,oneline
        \\Because of the first rule a procedure has at most one variadic
        \\parameter: a second one would need a default, which a variadic
        \\parameter cannot have. A bare `...` as the last entry of a parameter
        \\list, without a name, is a different thing: the C variable-argument
        \\marker. It is accepted only on `#foreign` declarations and `#c_call`
        \\procedures (`error: C vararg marker '...' on 'f' is only supported on
        \\#foreign declarations or #c_call definitions`); see `#foreign`,
        \\`#library`, and `#c_call`.
    );
}

render_section_54 :: () {
    paragraph(0, #string,oneline
        \\Most parameters receive a value when the procedure is called. This
        \\chapter describes the parameters that change that contract. A
        \\`noalias` pointer carries a promise from the caller to the
        \\optimizer. A `#lazy` parameter delays the evaluation of its argument
        \\until the body reads it, which is how `&&` and `||` short-circuit.
        \\`#comptime` parameters, type parameters and `#empty` slots receive
        \\their arguments while the program is compiled.
    );
    subheading(1, "Parameter markers");
    paragraph(2, #string,oneline
        \\A marker is written on a single parameter, before its name. `noalias`
        \\and `using` come first, then `#comptime` and `#lazy` in either
        \\order, as in `(using v: Vec2, #lazy #comptime k: s64)`. A marker in
        \\the wrong place is a parse error: `(#comptime noalias p: *s64)` is
        \\`error: unexpected token 'noalias'`.
    );
    table_header(3, "Marker   —   Meaning   —   Described in");
    table_row(4, "`noalias p: *T`   |   Nothing else reaches this memory during the call.   |   `noalias` pointer parameters, below");
    table_row(5, "`using v: T`   |   The fields of the struct `v` are in scope by name in the body.   |   Struct Types");
    table_row(6, "`#lazy v: T`   |   The argument is evaluated when the body first reads it.   |   Lazy parameters, below");
    table_row(7, "`#comptime n: T`   |   The argument is a compile-time constant.   |   `#comptime` parameters, below");
    table_row(8, "`#empty: $T`   |   A slot that passes only a type.   |   Type-only slots with `#empty`, below");
    subheading(9, "`noalias` pointer parameters");
    paragraph(10, #string,oneline
        \\`noalias` before a parameter name promises that, for the duration of
        \\the call, the memory reached through that pointer is not reached
        \\through any other parameter or pointer the procedure uses. The
        \\compiler hands the promise to the optimizer, which may then keep a
        \\value in a register instead of reading it again after each store.
        \\The promise is not checked. A call that breaks it has undefined
        \\behaviour, and the result may change with the optimization level:
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\
        \\add_twice :: (noalias target: *s64, amount: *const s64) {
        \\    target.* += amount.*;
        \\    target.* += amount.*;
        \\}
        \\
        \\main :: () {
        \\    a: s64 = 1;
        \\    b: s64 = 10;
        \\    add_twice(&a, &b);
        \\    print("{}\n", a);
        \\    add_twice(&a, &a);      // breaks the promise: both point at a
        \\    print("{}\n", a);
        \\}
    );
    code_block(12, "text", #string
        \\$ glosso --run alias.glo 2>/dev/null
        \\21
        \\84
        \\$ glosso -O2 --run alias.glo 2>/dev/null
        \\21
        \\63
    );
    paragraph(13, #string,oneline
        \\At `-O2` the second call read `amount.*` once and reused it, which
        \\the promise allowed. The standard library uses `noalias` on its
        \\copy of non-overlapping memory and leaves it off the copy that
        \\permits overlap; that is the typical use.
    );
    paragraph(14, #string,oneline
        \\`noalias` applies to pointer types: `*T`, `[*]T` and function
        \\pointers. It may be written on a method receiver, `noalias *#self`,
        \\and on a lambda parameter, `|noalias p: *s64| ...`. In a generic
        \\procedure the parameter's type is checked when the procedure is
        \\instantiated.
    );
    table_header(15, "Declaration   —   Diagnostic");
    table_row(16, "`(noalias count: s64)`   |   `noalias parameter 'count' must have a pointer type, got s64`");
    table_row(17, "`(noalias values: []s64)`   |   `noalias parameter 'values' must have a pointer type, got []s64`");
    table_row(18, "`(noalias p: ?*s64)`   |   `noalias parameter 'p' must have a pointer type, got ?*s64`");
    table_row(19, "`(noalias p: $T)` called with `1`   |   `noalias parameter 'p' instantiated with non-pointer type ssize`");
    table_row(20, "`(noalias #comptime n: s64)`   |   `noalias cannot qualify a #comptime parameter`");
    table_row(21, "`(noalias #empty: $T)`   |   `noalias cannot qualify a #empty parameter`");
    table_row(22, "`p: noalias *s64;` as a variable   |   `unexpected token 'noalias'`");
    paragraph(23, #string,oneline
        \\`noalias` is part of a procedure's type. A procedure converts to a
        \\function-pointer type only if both mark the same parameters (see
        \\Lambdas and `#fn_ptr` Values).
    );
    subheading(24, "Lazy parameters");
    paragraph(25, #string,oneline
        \\An argument for a parameter marked `#lazy` is not evaluated before
        \\the call. It is evaluated the first time the procedure reads the
        \\parameter, and that value is reused for every later read. If the
        \\procedure never reads the parameter, the argument is never
        \\evaluated.
    );
    code_block(26, "glosso", #string
        \\#import "Io";
        \\
        \\evaluations := 0;
        \\
        \\probe :: (label: str) -> bool {
        \\    evaluations += 1;
        \\    print("  evaluated {}\n", label);
        \\    return true;
        \\}
        \\
        \\ignore :: (#lazy value: bool) -> s64 { return 0; }
        \\use_once :: (#lazy value: bool) -> s64 { if value return 1; return 2; }
        \\use_twice :: (#lazy value: bool) -> s64 { if value { if value return 3; } return 4; }
        \\
        \\main :: () {
        \\    r := ignore(probe("a"));
        \\    print("ignore = {}, {} evaluations\n", r, evaluations);
        \\    evaluations = 0;
        \\    r = use_once(probe("b"));
        \\    print("use_once = {}, {} evaluations\n", r, evaluations);
        \\    evaluations = 0;
        \\    r = use_twice(probe("c"));
        \\    print("use_twice = {}, {} evaluations\n", r, evaluations);
        \\}
    );
    code_block(27, "text", #string
        \\ignore = 0, 0 evaluations
        \\  evaluated b
        \\use_once = 1, 1 evaluations
        \\  evaluated c
        \\use_twice = 3, 1 evaluations
    );
    paragraph(28, #string,oneline
        \\The argument is evaluated inside the callee, at the point of the
        \\first read. It therefore sees what the callee has done before that
        \\point, which an ordinary argument does not:
    );
    code_block(29, "glosso", #string
        \\#import "Io";
        \\
        \\counter: s64 = 1;
        \\
        \\delayed :: (#lazy value: s64) -> s64 {
        \\    counter = 100;
        \\    return value;
        \\}
        \\
        \\eager :: (value: s64) -> s64 {
        \\    counter = 100;
        \\    return value;
        \\}
        \\
        \\main :: () {
        \\    counter = 1;
        \\    a := delayed(counter);
        \\    counter = 1;
        \\    b := eager(counter);
        \\    print("delayed={} eager={}\n", a, b);
        \\}
    );
    code_block(30, "text", #string
        \\delayed=100 eager=1
    );
    paragraph(31, #string,oneline
        \\The single evaluation holds however the parameter is used. Passing a
        \\lazy parameter on to another lazy parameter does not evaluate it,
        \\and the first read anywhere along the chain is the one evaluation. A
        \\read inside a loop, such as `while i < limit` with a lazy `limit`,
        \\evaluates the argument on the first test and compares against the
        \\same value afterwards. A lazy parameter is therefore not a macro
        \\argument, which is substituted and evaluated at every use; `#code`,
        \\`#insert`, and `#expand` describes those.
    );
    subheading(32, "How a lazy call is compiled");
    paragraph(33, #string,oneline
        \\A procedure with a `#lazy` parameter is expanded into each call, with
        \\the argument expression placed where the parameter is first read. It
        \\has no separate compiled body of its own, and that is why some uses
        \\are rejected:
    );
    table_header(34, "Use   —   Diagnostic");
    table_row(35, "Taking it as a value, `f := delayed;`   |   `lazy function 'delayed' cannot be used as an ordinary function pointer`");
    table_row(36, "A recursive call   |   `recursive call to lazy function 'f' is not supported`");
    table_row(37, "With `#c_call` or `#foreign`   |   `#lazy parameters on 'f' are not part of a foreign ABI`");
    table_row(38, "With `#magic`   |   `#lazy parameters on #magic function 'f' require compiler-defined lazy semantics`");
    table_row(39, "On a variadic parameter   |   `#lazy cannot qualify a variadic parameter`");
    table_row(40, "On a `#empty` parameter   |   `#lazy cannot qualify a #empty parameter`");
    table_row(41, "On a lambda parameter   |   `unexpected token 'lazy'`");
    paragraph(42, #string,oneline
        \\The recursion error is reported after type checking, while the
        \\program is translated, so its message begins with `while lowering
        \\demanded function 'main':`.
    );
    paragraph(43, #string,oneline
        \\`#lazy` combines with `#comptime` in either order. The argument must
        \\then be a compile-time constant expression, and it is still
        \\evaluated only if the body reads it:
    );
    code_block(44, "glosso", #string
        \\#import "Io";
        \\
        \\ignore_value :: (#lazy #comptime value: s64) -> s64 { return 7; }
        \\double_value :: (#comptime #lazy value: s64) -> s64 { return value * 2; }
        \\
        \\UNUSED :: #comptime ignore_value(1 / 0);    // 1 / 0 is never evaluated
        \\USED :: #comptime double_value(21);
        \\
        \\main :: () {
        \\    print("{} {}\n", UNUSED, USED);
        \\}
    );
    code_block(45, "text", #string
        \\7 42
    );
    subheading(46, "How `&&` and `||` short-circuit");
    paragraph(47, #string,oneline
        \\`&&` and `||` are the operators of the prelude typeclasses
        \\`LogicalAnd` and `LogicalOr`, and their right operand is a `#lazy`
        \\parameter. The prelude declares them as follows:
    );
    code_block(48, "glosso", #string
        \\LogicalAnd :: typeclass (L: type, R: type) {
        \\    Output :: type;
        \\    '&&' :: (left: L, #lazy right: R) -> Output #operator(left, 6);
        \\}
        \\
        \\LogicalOr :: typeclass (L: type, R: type) {
        \\    Output :: type;
        \\    '||' :: (left: L, #lazy right: R) -> Output #operator(left, 4);
        \\}
    );
    paragraph(49, #string,oneline
        \\The instances for `bool` are implemented by the compiler. They read
        \\the right operand only when the left one does not decide the result,
        \\so the right operand of `&&` runs only after a `true`, and that of
        \\`||` only after a `false`. The compound assignments `&&=` and `||=`
        \\are defined through `&&` and `||` and short-circuit the same way.
    );
    code_block(50, "glosso", #string
        \\#import "Io";
        \\
        \\side :: (label: str, value: bool) -> bool {
        \\    print("{} ", label);
        \\    return value;
        \\}
        \\
        \\main :: () {
        \\    a := side("L", false) && side("R", true);
        \\    print("= {}\n", a);
        \\    b := side("L", true) && side("R", false);
        \\    print("= {}\n", b);
        \\    c := side("L", true) || side("R", false);
        \\    print("= {}\n", c);
        \\    d := false;
        \\    d ||= side("R", true);
        \\    print("= {}\n", d);
        \\
        \\    values: [3]s64 = .[1, 2, 3];
        \\    i := 5;
        \\    if i < values.count && values[i] > 0 print("positive\n");
        \\    else print("out of range\n");
        \\}
    );
    code_block(51, "text", #string
        \\L = false
        \\L R = false
        \\L = true
        \\R = true
        \\out of range
    );
    paragraph(52, #string,oneline
        \\The last test is the usual guard: `values[i]` is never evaluated,
        \\so it never goes out of bounds. An instance for another type gets
        \\the same behaviour by reading its lazy operand only when it needs
        \\it. This one stops at the first failed check:
    );
    code_block(53, "glosso", #string
        \\#import "Io";
        \\
        \\Check :: struct {
        \\    passed: bool;
        \\    message: str;
        \\}
        \\
        \\(Check, Check) ::: instance LogicalAnd {
        \\    Output :: Check;
        \\    '&&' :: (left: Check, #lazy right: Check) -> Check {
        \\        if !left.passed return left;
        \\        return right;
        \\    }
        \\}
        \\
        \\check :: (passed: bool, message: str) -> Check {
        \\    print("checking: {}\n", message);
        \\    return .{ passed, message };
        \\}
        \\
        \\main :: () {
        \\    result := check(true, "file exists")
        \\        && check(false, "file is readable")
        \\        && check(true, "file is small");
        \\    print("passed={} at: {}\n", result.passed, result.message);
        \\}
    );
    code_block(54, "text", #string
        \\checking: file exists
        \\checking: file is readable
        \\passed=false at: file is readable
    );
    paragraph(55, #string,oneline
        \\An instance must declare `#lazy` on the same parameters as its
        \\typeclass, so that a caller can rely on the typeclass to know
        \\whether an argument is evaluated. Leaving it out is an error, here
        \\for a user typeclass `Pick`: `error: function 'pick' must match the
        \\#lazy parameter contract of typeclass 'Pick'`. Operator Declarations
        \\describes operator typeclasses in general.
    );
    subheading(56, "Arguments fixed at compile time");
    paragraph(57, #string,oneline
        \\The remaining parameters receive their argument while the program is
        \\compiled rather than when it runs. A `#comptime` parameter receives
        \\a constant value, a parameter of type `type` receives a type, and a
        \\`#empty` slot receives only the type of what is written there. None
        \\of them is passed at run time. Instead, the compiler makes a separate
        \\copy of the procedure for each distinct set of such arguments, with
        \\the arguments built in. A `type` parameter that only the body uses
        \\is the exception, described under Type parameters below.
    );
    subheading(58, "`#comptime` parameters");
    paragraph(59, #string,oneline
        \\`#comptime` before a parameter name makes the parameter a
        \\compile-time constant inside the body. It can then appear wherever a
        \\constant is required: as the count of `#inline for`, the length of
        \\an array, the condition of `#if`, or in `#assert`.
    );
    code_block(60, "glosso", #string
        \\#import "Io";
        \\
        \\power :: (#comptime exponent: s64, x: s64) -> s64 {
        \\    result: s64 = 1;
        \\    #inline for 0..exponent result *= x;     // unrolled: exponent is known
        \\    return result;
        \\}
        \\
        \\sum_of_squares :: (#comptime count: s64 = 4) -> s64 {
        \\    #assert count > 0, "count must be positive";
        \\    squares: [count]s64;
        \\    for 0..count squares[it] = it * it;
        \\    total: s64 = 0;
        \\    for squares total += it;
        \\    return total;
        \\}
        \\
        \\main :: () {
        \\    CUBE :: 3;
        \\    print("{} {}\n", power(2, 5), power(CUBE, 2));
        \\    print("{} {}\n", sum_of_squares(), sum_of_squares(.count = 6));
        \\}
    );
    code_block(61, "text", #string
        \\25 8
        \\14 55
    );
    paragraph(62, #string,oneline
        \\The argument must be something the compiler can evaluate: a literal,
        \\a `::` constant, or a compile-time expression. A variable is not one,
        \\even if its value never changes:
    );
    code_block(63, "text", #string
        \\// k := 3; n := power(k, 2);
        \\error: argument for #comptime parameter 'exponent' must be known at compile time
        \\note: unknown const k
    );
    paragraph(64, #string,oneline
        \\Otherwise a `#comptime` parameter behaves like any other: it may
        \\have a default and be passed by name, as `count` is above, and one
        \\`#comptime` applies to every name of a group such as `(#comptime
        \\rows, columns: s64)`. A failed `#assert` in the body is reported
        \\with the call that instantiated it: `sum_of_squares(0)` gives `error:
        \\assertion failed: count must be positive` and `note: in
        \\instantiation of 'sum_of_squares'`.
    );
    paragraph(65, #string,oneline
        \\Each distinct argument produces another compiled copy of the
        \\procedure, which takes only the run-time parameters. `power(2, x)`
        \\and `power(3, x)` are two functions of one parameter each. A
        \\`#comptime` parameter is therefore a trade: the body is specialized
        \\for the constant, and the program grows with every constant used.
    );
    note(66, #string,oneline
        \\The constant exists in the body only. The signature cannot use it,
        \\so `squares :: (#comptime n: s64) -> [n]s64` is `error: array count
        \\'n' is not compile-time known` at the call. Compute such a result
        \\type in a `#modify` block instead (see Directives That Modify
        \\Procedures).
    );
    table_header(67, "Declaration   —   Diagnostic");
    table_row(68, "`(#comptime #comptime n: s64)`   |   `duplicate #comptime parameter directive`");
    table_row(69, "`(noalias #comptime p: *s64)`   |   `noalias cannot qualify a #comptime parameter`");
    table_row(70, "`(using #comptime v: Vec2)`   |   `using cannot qualify a #comptime parameter`");
    table_row(71, "`(#comptime values: ...s64)`   |   `unexpected token '...'`");
    subheading(72, "Type parameters");
    paragraph(73, #string,oneline
        \\A parameter of type `type` receives a type. The caller writes the
        \\type as the argument, and in the body the parameter can be used
        \\wherever a type can. Such a parameter is a type parameter, and the
        \\procedure generic, when its name also appears in another parameter's
        \\type or in the result type, or when it is declared `#comptime T:
        \\type`. Each type then gets its own compiled copy, which runs when the
        \\program runs:
    );
    code_block(74, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\identity :: (T: type, value: T) -> T { return value; }
        \\
        \\filled :: (T: type, value: s64) -> [3]T {
        \\    out: [3]T;
        \\    for 0..3 out[it] = cast(T) value;
        \\    return out;
        \\}
        \\
        \\byte_count :: (#comptime T: type, count: s64) -> s64 { return size_of(T) * count; }
        \\
        \\convert :: (value: s64, Target := f64) -> Target { return cast(Target) value; }
        \\
        \\main :: () {
        \\    n := 7;
        \\    print("{}\n", type_name(type_of(identity(u8, 200))));
        \\    print("{} {}\n", filled(u8, n)[2], byte_count(f64, n));
        \\    print("{} {}\n", type_name(type_of(convert(3))), type_name(type_of(convert(3, f32))));
        \\}
    );
    code_block(75, "text", #string
        \\u8
        \\7 56
        \\f64 f32
    );
    paragraph(76, #string,oneline
        \\A `T: type` parameter that is used only in the body, without
        \\`#comptime`, is different. It is not a type parameter but an
        \\ordinary parameter whose type is `type`, and a value of type `type`
        \\exists only while the program is compiled (see `type` Values and
        \\Type Reflection). The procedure therefore has no run-time form: the
        \\compiler evaluates every call to it during the build and puts the
        \\result in the call's place. Its other arguments must be compile-time
        \\constants too, and what it prints appears in the build's output:
    );
    code_block(77, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\describe :: (T: type, count: s64) -> s64 {
        \\    print("describing {}\n", type_name(T));
        \\    return size_of(T) * count;
        \\}
        \\
        \\main :: () {
        \\    print("start\n");
        \\    print("{}\n", describe(f64, 4));
        \\}
    );
    code_block(78, "text", #string
        \\$ glosso --run describe.glo
        \\glosso: compile describe.glo (target=x86_64-pc-linux-gnu)
        \\describing f64
        \\glosso: link describe (target=x86_64-pc-linux-gnu, -O1)
        \\glosso: done describe  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
        \\start
        \\32
    );
    paragraph(79, #string,oneline
        \\With `n := 4;` the call `describe(f64, n)` is `error: unknown const
        \\n`. This form is meant for procedures that compute something about a
        \\type, such as the `(T: type) -> bool` predicates used in `where`
        \\clauses (see Generic Procedures and `where` Clauses). A procedure
        \\that should run at run time declares `#comptime T: type`, or takes
        \\the type through a `#empty` slot, described below.
    );
    paragraph(80, #string,oneline
        \\Type parameters come before the run-time parameters. The exception is
        \\a defaulted type parameter written `Name := Type`, like `Target`
        \\above, which may come last. For this form the name must begin with
        \\an uppercase letter; with a lowercase name the parameter is not a
        \\type parameter. A type argument must be a type the compiler knows,
        \\so a variable holding a type is not accepted (`error: unknown const
        \\t`).
    );
    table_header(81, "Declaration   —   Diagnostic");
    table_row(82, "`(value: s64, T: type)`   |   `type parameter 'T' must appear before runtime parameters unless it has a default`");
    table_row(83, "`(value: s64, T: type = f64)`   |   The same; write `T := f64` instead.");
    table_row(84, "`(T: type, T: type)`   |   `parameter 'T' is already declared`");
    table_row(85, "`(T: type, value: $T)`   |   `type parameter 'T' is already declared; use plain T after the declaration`");
    subheading(86, "Type-only slots with `#empty`");
    paragraph(87, #string,oneline
        \\`#empty: $T` declares an argument position that carries a type and
        \\no value. The slot has no name. The caller writes a type there, and
        \\the procedure learns `T`. One `#empty` may list several captures,
        \\as in `#empty: $K, $V`.
    );
    code_block(88, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\zero_of :: (#empty: $T) -> T {
        \\    value: T;
        \\    return value;
        \\}
        \\
        \\pair_size :: (#empty: $A, $B) -> s64 { return size_of(A) + size_of(B); }
        \\
        \\calls := 0;
        \\measure :: () -> f32 { calls += 1; return 1.5; }
        \\
        \\main :: () {
        \\    print("{} {} {}\n", zero_of(s64), zero_of(bool), pair_size(u8, s64));
        \\    z := zero_of(measure());      // only the type of measure() is used
        \\    print("{} {} {}\n", type_name(type_of(z)), z, calls);
        \\}
    );
    code_block(89, "text", #string
        \\0 false 9
        \\f32 0 0
    );
    paragraph(90, #string,oneline
        \\As the second call shows, any expression may stand in the slot: the
        \\slot takes its type and the expression is not evaluated. A type name
        \\states the intent more clearly.
    );
    table_header(91, "Declaration   —   Diagnostic");
    table_row(92, "`(x: s64, #empty: $T)`   |   `#empty parameters must appear before runtime parameters`");
    table_row(93, "`(#empty: $T = s64)`   |   `unexpected token '='`: a slot has no default");
    table_row(94, "`(noalias #empty: $T)`, `(using #empty: $T)`   |   `noalias cannot qualify a #empty parameter`, and the same for `using`");
    table_row(95, "`(#lazy #empty: $T)`   |   `#lazy cannot qualify a #empty parameter`");
    paragraph(96, #string,oneline
        \\The slot exists for procedures whose interesting type appears only in
        \\the result. Without it a call would have nothing to infer the type
        \\from. The standard library's `FromString` typeclass is declared
        \\with `from_string :: (#empty: T, text: str) -> ?T`, so the caller
        \\names the type to parse, and that type selects the instance:
    );
    code_block(97, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    count := from_string(s64, "-42");
        \\    ratio := from_string(f64, "2.5");
        \\    flag := from_string(bool, "maybe");
        \\    print("{} {} {}\n", count, ratio, flag);
        \\}
    );
    code_block(98, "text", #string
        \\Some(-42) Some(2.5) None
    );
    paragraph(99, #string,oneline
        \\`print` shows an empty optional as `None`; in source it is `null`
        \\(see `?T` and `E!T`). The same `#empty` marker on a struct field
        \\declares a type parameter that the struct does not store, as Struct
        \\Types describes.
    );
    subheading(100, "Choosing a form");
    table_header(101, "Parameter   —   The caller writes   —   At run time");
    table_row(102, "`#comptime n: s64`   |   A constant value   |   Nothing; each value is a separate copy.");
    table_row(103, "`T: type`, `#comptime T: type`   |   A type   |   Nothing; each type is a separate copy. Used only in the body without `#comptime`: the call is evaluated during compilation.");
    table_row(104, "`#empty: $T`   |   A type, or an expression whose type is used   |   Nothing; each type is a separate copy.");
    table_row(105, "`value: $T`   |   A value; its type is captured as `T`   |   The value; each type is a separate copy.");
    paragraph(106, #string,oneline
        \\The last form, the `$` capture that infers a type from an ordinary
        \\argument, is the most common one, and Generic Procedures and `where`
        \\Clauses describes it.
    );
}

render_section_55 :: () {
    paragraph(0, #string,oneline
        \\A generic procedure is written once and compiled separately for each
        \\combination of types that it is called with. This chapter describes
        \\how type parameters are declared with `$` captures and inferred at a
        \\call, how they can be supplied explicitly, how a generic body is
        \\checked, and how `where` clauses and `#meaningful` probes restrict
        \\the types a procedure accepts. Generic Code and Typeclasses
        \\introduces generic procedures by example.
    );
    subheading(1, "Captures declare type parameters");
    paragraph(2, #string,oneline
        \\A procedure is generic when a parameter's type contains a capture, a
        \\name written with `$` such as `$T`. The capture declares a type
        \\parameter, and each call infers it from the argument in that
        \\position. After the capture the name is an ordinary type in the rest
        \\of the signature and in the body.
    );
    code_block(3, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\larger :: (a: $T, b: T) -> T where PartialOrd(T, T) {
        \\    if a > b return a;
        \\    return b;
        \\}
        \\
        \\first :: (values: []$T) -> T { return values[0]; }
        \\
        \\describe :: (key: $K, value: $V) {
        \\    print("{} -> {}\n", type_name(K), type_name(V));
        \\}
        \\
        \\main :: () {
        \\    print("{} {}\n", larger(3, 9), larger("pear", "apple"));
        \\    primes: [3]u16 = .[2, 3, 5];
        \\    print("{}\n", first(primes[..]));
        \\    describe("weight", 2.5);
        \\}
    );
    code_block(4, "text", #string
        \\9 pear
        \\2
        \\str -> f64
    );
    paragraph(5, #string,oneline
        \\`larger` uses `>` on values of type `T`, so it states with a `where`
        \\clause that `T` must support comparison; the second half of this
        \\chapter explains why the clause belongs there. `describe` has two
        \\independent type parameters. A type parameter can also be written
        \\out as `T: type` (see `noalias`, `#lazy`, `#comptime`, and
        \\Type Parameters), and a struct can be generic too (see Struct Types).
    );
    subheading(6, "Where a capture may appear");
    paragraph(7, #string,oneline
        \\A capture may stand anywhere inside a parameter's type. The compiler
        \\matches the shape of the type against the argument's type and binds
        \\the capture to the part in its position:
    );
    table_header(8, "Parameter type   —   `T` is bound to");
    table_row(9, "`$T`   |   The type of the argument.");
    table_row(10, "`[]$T`, `[4]$T`, `*[..]$T`   |   The element type of the array.");
    table_row(11, "`*$T`, `*const $T`, `[*]$T`   |   The type pointed to.");
    table_row(12, "`?$T`   |   The type of the optional's value.");
    table_row(13, "`$E!$T`   |   `E` to the error type and `T` to the success type.");
    table_row(14, "`Pair($T)`   |   The argument of a generic struct or union.");
    table_row(15, "`($A) -> $R`   |   `A` to the parameter type and `R` to the result type of a procedure.");
    code_block(16, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Pair :: struct { first: $T; second: T; }
        \\
        \\pointee :: (p: *$T) -> str { return type_name(T); }
        \\payload :: (o: ?$T) -> str { return type_name(T); }
        \\outcome :: (r: $E!$T) -> str { return type_name(E); }
        \\paired :: (p: Pair($T)) -> str { return type_name(T); }
        \\returned :: (f: ($A) -> $R) -> str { return type_name(R); }
        \\
        \\halve :: (x: f64) -> s64 { return cast(s64) (x / 2); }
        \\
        \\main :: () {
        \\    n: s32 = 1;
        \\    maybe: ?bool = .Some(true);
        \\    parsed: str!s64 = .Ok(4);
        \\    print("{} {} {}\n", pointee(&n), payload(maybe), outcome(parsed));
        \\    print("{} {}\n", paired(Pair(u8).{ 1, 2 }), returned(halve));
        \\}
    );
    code_block(17, "text", #string
        \\s32 bool str
        \\u8 s64
    );
    paragraph(18, #string,oneline
        \\Only types are captured. The length of a fixed array cannot be:
        \\`(values: [$N]$T)` is `error: bracket type expects [], [*], [..],
        \\[N], or [_]`. A procedure that accepts fixed arrays of any length
        \\takes a view and reads its `count`.
    );
    subheading(19, "One `$` per type parameter");
    paragraph(20, #string,oneline
        \\The `$` declares the type parameter, so it appears once. Every later
        \\mention, in the same signature or in the body, is the plain name:
        \\`(a: $T, b: T)` takes two values of one type, while `(a: $A, b:
        \\$B)` takes two values whose types may differ. Writing `$T` twice is
        \\`error: polymorph $T is already bound; use plain T after the first
        \\$T`.
    );
    subheading(21, "How a type parameter is inferred");
    paragraph(22, #string,oneline
        \\When several arguments determine one type parameter, an argument with
        \\a definite type decides it and a literal converts to it, wherever the
        \\literal stands. With `x: s32`, both `larger(x, 2)` and `larger(2, x)`
        \\are calls with `T = s32`. When only literals determine it, `T` is
        \\their default type: `larger(3, 9)` uses `ssize`. Arguments that
        \\disagree are reported at the call: `larger(1, "two")` is `error: arg
        \\type ssize != str in call larger`.
    );
    subheading(23, "Supplying the type arguments");
    paragraph(24, #string,oneline
        \\Type parameters can also be given explicitly, as types written before
        \\the ordinary arguments, in the order the captures first appear. A
        \\capture that appears only in the result type, as in `-> $R`, cannot
        \\be inferred from the arguments. It comes after the others and is
        \\written explicitly, or taken from the type that the call's value is
        \\assigned to.
    );
    code_block(25, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\same :: (value: $T) -> T { return value; }
        \\zero :: () -> $R { value: R; return value; }
        \\convert :: (value: $T) -> $R { return cast(R) value; }
        \\
        \\main :: () {
        \\    print("{}\n", type_name(type_of(same(s16, 3))));
        \\    print("{}\n", type_name(type_of(zero(u8))));
        \\    ratio: f32 = zero();
        \\    print("{} {}\n", ratio, type_name(type_of(convert(s64, f64, 3))));
        \\}
    );
    code_block(26, "text", #string
        \\s16
        \\u8
        \\0 f64
    );
    paragraph(27, #string,oneline
        \\A call that leaves a result-only capture with nothing to decide it,
        \\or supplies fewer explicit types than the captures it must cover,
        \\is rejected:
    );
    code_block(28, "text", #string
        \\// z := zero();
        \\error: cannot infer generic type R in call zero
        \\
        \\// y := convert(f64, 3);
        \\error: call convert supplies 1 compact generic type(s), but unresolved order is (T, R)
    );
    subheading(29, "One copy per type");
    paragraph(30, #string,oneline
        \\A generic procedure is compiled separately for each combination of
        \\type arguments it is called with, and every call with the same
        \\combination uses the same copy. Each copy is ordinary code for its
        \\types, with no run-time cost for the genericity, and the program
        \\grows with every combination used.
    );
    paragraph(31, #string,oneline
        \\The body is type-checked for each combination when that copy is
        \\made. A mistake that only some types expose is therefore reported
        \\for the first call that uses such a type, with a note that points at
        \\the call:
    );
    code_block(32, "glosso", #string
        \\total_length :: (items: []$T) -> s64 {
        \\    sum: s64 = 0;
        \\    for items sum += it.count;
        \\    return sum;
        \\}
        \\
        \\main :: () {
        \\    words: [2]str = .["ab", "cde"];
        \\    numbers: [2]s64 = .[1, 2];
        \\    a := total_length(words[..]);      // fine: a str has a count
        \\    b := total_length(numbers[..]);
        \\}
    );
    code_block(33, "text", #string
        \\error: member of non-struct
        \\  --> generic.glo:3:25
        \\  |
        \\3 |     for items sum += it.count;
        \\  |                         ^^^^^
        \\note: in instantiation of 'total_length'
        \\   --> generic.glo:11:10
        \\   |
        \\11 |     b := total_length(numbers[..]);
        \\   |          ^^^^^^^^^^^^
    );
    paragraph(34, #string,oneline
        \\The other side of the rule is that a generic procedure nobody calls
        \\is never checked beyond its signature, so its body may contain
        \\errors that go unnoticed (see Inside a Build: Stages and Caches). The
        \\one exception is the check of operators against the `where` clauses,
        \\described under Constraints and the body below.
    );
    subheading(35, "Different code for different types");
    paragraph(36, #string,oneline
        \\There is no overloading: two procedures cannot share a name, even if
        \\their parameter types differ. A generic body selects code by type
        \\with `#if`, which keeps only the branch that applies to each copy
        \\(see `#if`, `#assert`, and `#compile_error`). Behaviour that each
        \\type provides for itself is a typeclass (see Typeclass Declarations
        \\and Instances).
    );
    code_block(37, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\describe :: (value: $T) -> str {
        \\    #if Is_Float(T) return "a float";
        \\    else #if Is_Integer(T) return "an integer";
        \\    else return type_name(T);
        \\}
        \\
        \\main :: () {
        \\    print("{}, {}, {}\n", describe(2.5), describe(cast(u8) 1), describe("text"));
        \\}
    );
    code_block(38, "text", #string
        \\a float, an integer, str
    );
    subheading(39, "`where` clauses");
    paragraph(40, #string,oneline
        \\A `where` clause is a condition on a generic procedure's type and
        \\compile-time parameters. It is evaluated at compile time for every
        \\call once the call's type arguments are known, and a call for which
        \\it is false is rejected. The condition is part of the procedure's
        \\interface: it says which arguments the procedure accepts, and the
        \\compiler checks it before it looks at the body.
    );
    code_block(41, "glosso", #string
        \\#import "Io";
        \\#import "Format";
        \\#import "Meta";
        \\
        \\is_wide :: (T: type) -> bool { return size_of(T) >= 4; }
        \\
        \\doubled :: (x: $T) -> T where Is_Integer(T) where is_wide(T) {
        \\    return x + x;
        \\}
        \\
        \\repeat :: (#comptime count: s64, text: str) -> str where count > 0 {
        \\    result := "";
        \\    #inline for 0..count result = tprint("{}{}", result, text);
        \\    return result;
        \\}
        \\
        \\main :: () {
        \\    print("{}\n", doubled(cast(s32) 21));
        \\    print("{}\n", repeat(3, "ab"));
        \\}
    );
    code_block(42, "text", #string
        \\42
        \\ababab
    );
    paragraph(43, #string,oneline
        \\A call that fails a clause is reported at the call, naming the
        \\procedure:
    );
    code_block(44, "text", #string
        \\// small: s8 = 1;  n := doubled(small);
        \\error: constraint failed for doubled
        \\
        \\// s := repeat(0, "ab");
        \\error: constraint failed for repeat
    );
    paragraph(45, #string,oneline
        \\The message does not say which clause failed. When a procedure has
        \\several conditions, separate `where` clauses at least keep each one
        \\short enough to check by eye.
    );
    subheading(46, "Placement");
    paragraph(47, #string,oneline
        \\The clauses come after the result type and after every procedure
        \\directive, immediately before the body. A directive written after a
        \\`where` is an error (`error: function directives must appear before
        \\where clauses`). A procedure may have any number of clauses, and all
        \\of them must hold: `where A where B` means the same as `where A &&
        \\B`. Inherent blocks and typeclass instances take `where` clauses in
        \\the same way, which then apply to every member (see Inherent Methods,
        \\Member Access, and Call Syntax and Typeclass Declarations and
        \\Instances).
    );
    subheading(48, "What a clause can test");
    paragraph(49, #string,oneline
        \\A clause is any expression that the compiler can evaluate to a `bool`
        \\at compile time, with the procedure's type parameters and
        \\`#comptime` parameters as constants in it. That includes comparisons
        \\of types such as `T != bool`, the predicates of the `Meta` module
        \\such as `Is_Integer(T)` (see `type` Values and Type Reflection),
        \\procedures of the program that take a `type` and return a `bool`,
        \\like `is_wide` above, and tests on `#comptime` values, like `count >
        \\0`. Ordinary parameters are not constants, so `(x: s64) -> s64 where
        \\x > 0` is `error: unsupported constant binary expression`.
    );
    paragraph(50, #string,oneline
        \\A typeclass name applied to types asks whether they have an instance:
        \\`Show(T)` is true when `T` can be shown, and `PartialEq(T, T)` when
        \\two values of `T` can be compared with `==`. Such a test is an
        \\ordinary `bool` and combines with `&&`, `||` and `!`. The same test
        \\works in `#if` inside a body.
    );
    code_block(51, "glosso", #string
        \\#import "Io";
        \\#import "Format";
        \\#import "Meta";
        \\
        \\Opaque :: struct { id: s64; }
        \\
        \\shown :: (x: $T) -> str where Show(T) { return tprint("<{}>", x); }
        \\hidden :: (x: $T) -> str where !Show(T) { return "(hidden)"; }
        \\number :: (x: $T) -> str where Is_Integer(T) || Is_Float(T) { return "number"; }
        \\
        \\label :: (x: $T) -> str {
        \\    #if Show(T) return tprint("<{}>", x);
        \\    else return "(hidden)";
        \\}
        \\
        \\main :: () {
        \\    secret: Opaque = .{ 7 };
        \\    print("{} {}\n", shown(7), hidden(secret));
        \\    print("{} {}\n", number(1), number(2.5));
        \\    print("{} {}\n", label("text"), label(secret));
        \\}
    );
    code_block(52, "text", #string
        \\<7> (hidden)
        \\number number
        \\<text> (hidden)
    );
    note(53, #string,oneline
        \\A clause is not checked when the procedure is declared. A clause that
        \\names something that does not exist, such as `where Show(U)` in a
        \\procedure whose type parameter is `T`, compiles, and then every call
        \\fails with `constraint failed`. A constraint that no argument
        \\satisfies usually has a misspelled name.
    );
    subheading(54, "Constraints and the body");
    paragraph(55, #string,oneline
        \\A generic body is fully checked only for each set of types it is
        \\called with, as described above. In addition, the compiler checks
        \\every operator that the body applies to a type parameter against the
        \\typeclasses named in the procedure's `where` clauses, once, at the
        \\declaration. An operator that those typeclasses do not provide draws
        \\a warning, even when the procedure is never called:
    );
    code_block(56, "glosso", #string
        \\#import "Io";
        \\
        \\total :: (a: $T, b: T) -> T where Show(T) {
        \\    return a + b;
        \\}
        \\
        \\main :: () {
        \\    print("{}\n", total(2, 3));
        \\}
    );
    code_block(57, "text", #string
        \\$ glosso --run total.glo
        \\glosso: compile total.glo (target=x86_64-pc-linux-gnu)
        \\warning: no '+' for <T>: the where-clause only provides Show
        \\  --> total.glo:4:14
        \\  |
        \\4 |     return a + b;
        \\  |              ^
        \\note: reported at the definition; add the class to the 'where' clause
        \\glosso: link total (target=x86_64-pc-linux-gnu, -O1)
        \\glosso: done total  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
        \\5
    );
    paragraph(58, #string,oneline
        \\The program still compiles and runs, because `s64` has `+`; the
        \\warning says that the clause does not promise it. A procedure without
        \\any `where` clause gets the same warning, ending in "provides
        \\nothing". The fix is to name the typeclass that owns the operator:
        \\`Add(T, T)` for `+`, `PartialEq(T, T)` for `==`, `PartialOrd(T, T)`
        \\for `<` and the other comparisons, or `Num(T)`, which covers `+`,
        \\`-`, `*` and negation. Operator Declarations describes the
        \\typeclasses behind the operators.
    );
    code_block(59, "glosso", #string
        \\#import "Io";
        \\
        \\sum :: (values: []$T) -> T where Num(T) {
        \\    total: T = 0;
        \\    for values total += it;
        \\    return total;
        \\}
        \\
        \\main :: () {
        \\    lengths: [3]f32 = .[1, 2, 3.5];
        \\    print("{}\n", sum(lengths[..]));
        \\}
    );
    code_block(60, "text", #string
        \\6.5
    );
    paragraph(61, #string,oneline
        \\The check reports only what it can prove. When a `where` clause
        \\contains anything other than typeclass tests, such as a `Meta`
        \\predicate or a `#meaningful` probe, it does not know what the clause
        \\guarantees and stays silent. Calls, field accesses and other uses
        \\that are not operators are left to the check of each copy.
    );
    subheading(62, "`#meaningful`");
    paragraph(63, #string,oneline
        \\`#meaningful` asks the compiler whether some code would type-check.
        \\It takes a block, checks its statements in the current scope, and
        \\is replaced by the compile-time constant `true` if they all pass and
        \\`false` if any fails. The code is checked and then discarded; it is
        \\never run, at compile time or at run time.
    );
    code_block(64, "glosso", #string
        \\#import "Io";
        \\
        \\Vec :: struct { x: s64; y: s64; }
        \\Plain :: struct { a: s64; }
        \\
        \\(Vec, Vec) ::: instance Add {
        \\    Output :: Vec;
        \\    '+' :: (a: Vec, b: Vec) -> Vec { return .{ a.x + b.x, a.y + b.y }; }
        \\}
        \\
        \\VEC_ADDS :: #meaningful { p, q: Vec; p + q; };
        \\PLAIN_ADDS :: #meaningful { p, q: Plain; p + q; };
        \\
        \\calls := 0;
        \\count :: () -> s64 { calls += 1; return calls; }
        \\
        \\main :: () {
        \\    has_x := #meaningful { v: Vec; v.x; count(); };
        \\    has_z := #meaningful { v: Vec; v.z; };
        \\    print("{} {}\n", VEC_ADDS, PLAIN_ADDS);
        \\    print("{} {} calls={}\n", has_x, has_z, calls);
        \\}
    );
    code_block(65, "text", #string
        \\true false
        \\true false calls=0
    );
    paragraph(66, #string,oneline
        \\Variables declared in the block exist only inside it. Without braces,
        \\`#meaningful` takes a single operand and binds as tightly as a unary
        \\operator: `#meaningful v.x == 3` is `(#meaningful v.x) == 3`, which
        \\compares a `bool` with a number. Write `#meaningful { v.x == 3; }`
        \\to probe the whole comparison.
    );
    paragraph(67, #string,oneline
        \\A probe tests the code that a body actually writes, while a typeclass
        \\test asks whether an instance exists. They can disagree. A
        \\`distinct` type without derived operators (see Nominal Types with
        \\`distinct`) has no `+` of its own, but the standard `Show` instance
        \\for floating point covers it:
    );
    code_block(68, "glosso", #string
        \\#import "Io";
        \\
        \\Meters :: distinct f64;
        \\
        \\SHOWS :: Show(Meters);
        \\ADDS :: #meaningful { a, b: Meters; a + b; };
        \\
        \\main :: () {
        \\    print("{} {}\n", SHOWS, ADDS);
        \\}
    );
    code_block(69, "text", #string
        \\true false
    );
    paragraph(70, #string,oneline
        \\A probe can test what no typeclass expresses, such as the presence
        \\of a field or a call to an ordinary procedure. In a `where` clause,
        \\a probe may be written directly and sees the procedure's parameters.
        \\Wrapped in a procedure that takes a `type`, it gets a name and
        \\combines with other tests like any `bool`.
    );
    code_block(71, "glosso", #string
        \\#import "Io";
        \\
        \\Left :: struct { left: s64; }
        \\Right :: struct { right: s64; }
        \\
        \\Has_Left :: (T: type) -> bool { return #meaningful { v: T; v.left; }; }
        \\Has_Right :: (T: type) -> bool { return #meaningful { v: T; v.right; }; }
        \\
        \\read_left :: (v: $T) -> s64 where #meaningful { v.left; } {
        \\    return v.left;
        \\}
        \\
        \\either :: (v: $T) -> s64 where Has_Left(T) || Has_Right(T) {
        \\    #if Has_Left(T) return v.left;
        \\    else return v.right;
        \\}
        \\
        \\main :: () {
        \\    l: Left = .{ 1 };
        \\    r: Right = .{ 2 };
        \\    print("{} {} {}\n", read_left(l), either(l), either(r));
        \\}
    );
    code_block(72, "text", #string
        \\1 1 2
    );
    paragraph(73, #string,oneline
        \\A failed probe in a `where` clause gives the usual `constraint
        \\failed`. In `#assert`, the compiler also prints why the probe failed
        \\(see `#if`, `#assert`, and `#compile_error`):
    );
    code_block(74, "text", #string
        \\// #assert #meaningful { p, q: Plain; p + q; }, "Plain does not support +";
        \\error: assertion failed: Plain does not support +
        \\note: constraint is not meaningful for these types
        \\note: no operator '+' for Plain, Plain
    );
    paragraph(75, #string,oneline
        \\Nothing a probe does survives it. Generic procedures that it
        \\instantiates are not compiled into the program unless real code
        \\calls them too, and an error raised inside it, including one from
        \\`#compile_error`, only makes the answer `false`. A generic procedure
        \\that rejects unsuitable types with `#compile_error` can therefore
        \\still be asked about:
    );
    code_block(76, "glosso", #string
        \\#import "Io";
        \\
        \\strict_left :: (v: $T) -> s64 {
        \\    #if !#meaningful { v.left; } #compile_error "needs a left field";
        \\    return v.left;
        \\}
        \\
        \\Left :: struct { left: s64; }
        \\
        \\WORKS_FOR_S64 :: #meaningful { n: s64; strict_left(n); };
        \\
        \\main :: () {
        \\    l: Left = .{ 4 };
        \\    print("{} {}\n", WORKS_FOR_S64, strict_left(l));
        \\}
    );
    code_block(77, "text", #string
        \\false 4
    );
    subheading(78, "Generic procedures are not values");
    paragraph(79, #string,oneline
        \\A generic procedure is not one procedure until its types are known,
        \\so it cannot be stored as a value: `f := larger;` is `error: generic
        \\function 'larger' needs a call context`, even when the variable has
        \\a function type. Lambdas and `#fn_ptr` Values shows how to pass one
        \\of its copies. A `#modify` block can compute or rewrite type
        \\parameters after the arguments are matched (see Directives That
        \\Modify Procedures), and methods of generic types are described in
        \\Inherent Methods, Member Access, and Call Syntax.
    );
}

render_section_56 :: () {
    paragraph(0, #string,oneline
        \\A function pointer is a value that refers to a procedure. The name of
        \\a procedure used without a call produces one, and so does a lambda,
        \\a procedure written inside an expression. Calling a function pointer
        \\calls the procedure it refers to. Function pointers are how a
        \\procedure receives a callback, how a struct holds behaviour, and how
        \\Glosso code is handed to C. This chapter describes function types and
        \\their `#fn_ptr` names, lambdas, the conversions between procedures
        \\and function types, calls through a pointer, and pointers that may
        \\be absent.
    );
    subheading(1, "Function types");
    paragraph(2, #string,oneline
        \\The type of a function pointer is written like a signature without
        \\names: the parameter types in parentheses, an arrow, and the result
        \\type. `(s64, s64) -> s64` takes two `s64` and returns one, and `()
        \\-> s64` takes nothing. Parameter names may be added for
        \\documentation, as in `(x: s64, y: s64) -> s64`. This form can appear
        \\wherever a type can: as a parameter, a field, a result, or an
        \\element type.
    );
    code_block(3, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\add :: (a: s64, b: s64) -> s64 { return a + b; }
        \\negate :: (x: s64) -> s64 { return -x; }
        \\square :: (x: s64) -> s64 { return x * x; }
        \\
        \\twice :: (f: (s64) -> s64, x: s64) -> s64 { return f(f(x)); }
        \\
        \\chosen :: (squaring: bool) -> (s64) -> s64 {
        \\    if squaring return square;
        \\    return negate;
        \\}
        \\
        \\main :: () {
        \\    operation := add;
        \\    print("{} {}\n", operation(2, 3), type_name(type_of(operation)));
        \\    print("{} {}\n", twice(square, 3), chosen(false)(5));
        \\}
    );
    code_block(4, "text", #string
        \\5 (s64, s64) -> s64
        \\81 -5
    );
    paragraph(5, #string,oneline
        \\A generic procedure can also take a procedure whose types it infers,
        \\as in `(f: ($A) -> $R)` (see Generic Procedures and `where`
        \\Clauses).
    );
    subheading(6, "Named function types with `#fn_ptr`");
    paragraph(7, #string,oneline
        \\`Name :: #fn_ptr(parameters) -> Result;` declares a name for a
        \\function type. Each parameter is written `name: Type`, and the names
        \\are required here although they do not affect the type. Without an
        \\arrow the result is `void`. A `#c_call` after the signature makes
        \\the type use the C calling convention.
    );
    code_block(8, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Binary_Op :: #fn_ptr(left: s64, right: s64) -> s64;
        \\Listener :: #fn_ptr(value: s64);
        \\C_Callback :: #fn_ptr(value: s32) -> s32 #c_call;
        \\
        \\Button :: struct {
        \\    label: str;
        \\    on_press: Listener;
        \\}
        \\
        \\subtract :: (a: s64, b: s64) -> s64 { return a - b; }
        \\report :: (value: s64) { print("pressed {}\n", value); }
        \\
        \\main :: () {
        \\    op: Binary_Op = subtract;
        \\    same: (s64, s64) -> s64 = op;          // the same type
        \\    button := Button.{ "ok", report };
        \\    button.on_press(same(10, 3));
        \\    print("{}\n", type_name(Binary_Op));
        \\    print("{}\n", type_name(C_Callback));
        \\}
    );
    code_block(9, "text", #string
        \\pressed 7
        \\(s64, s64) -> s64
        \\(s32) -> s32 #c_call
    );
    paragraph(10, #string,oneline
        \\The name is an alias: `Binary_Op` and `(s64, s64) -> s64` are the
        \\same type. `#fn_ptr(...)` is accepted only as the value of such a
        \\declaration. Written directly as a field or parameter type, as in
        \\`on_press: #fn_ptr(value: s64);`, it is `error: unexpected token
        \\'fn_ptr'`; use the anonymous form or a name there. A list of bare
        \\types such as `#fn_ptr(s64) -> s64` is `error: unexpected token
        \\')'`.
    );
    subheading(11, "Lambda expressions");
    paragraph(12, #string,oneline
        \\A lambda is a procedure written inside an expression, without a
        \\name. Its parameters stand between vertical bars and its body
        \\follows them: `|x| x + 1`. Its value is a function pointer, so it
        \\can be stored in a variable, passed to a procedure or put in a
        \\table, and it is called like any procedure.
    );
    code_block(13, "glosso", #string
        \\#import "Io";
        \\
        \\apply :: (f: (s64, s64) -> s64, a: s64, b: s64) -> s64 {
        \\    return f(a, b);
        \\}
        \\
        \\main :: () {
        \\    increment: (s64) -> s64 = |x| x + 1;
        \\    double := |x: s64| -> s64 { return x * 2; };
        \\    five := || 5;
        \\    print("{} {} {}\n", increment(4), double(21), five());
        \\    print("{} {}\n", apply(|a, b| a * b, 6, 7), apply(|a, b| a - b, 6, 7));
        \\}
    );
    code_block(14, "text", #string
        \\5 42 5
        \\42 -1
    );
    table_header(15, "Lambda   —   Parameters   —   Body");
    table_row(16, "`|x| x + 1`   |   One; its type comes from the use.   |   One expression, which is the result.");
    table_row(17, "`|x: s64| x + 1`   |   One, with a written type.   |   One expression.");
    table_row(18, "`|a, b| a * b`   |   Two.   |   One expression.");
    table_row(19, "`|| 5`   |   None.   |   One expression.");
    table_row(20, "`|x: s64| -> s64 { ... }`   |   One.   |   A block with `return`; the result type is written.");
    table_row(21, "`|x: s64| { ... }`   |   One.   |   A block; the result type comes from its `return`s.");
    table_row(22, "`|noalias p: *s64| ...`   |   A `noalias` pointer.   |   Either form.");
    paragraph(23, #string,oneline
        \\An expression body is a single expression whose value is returned. A
        \\written result type needs a block body: `|x: s64| -> s64 x * 2` is
        \\`error: a lambda with an explicit return type requires a block`. A
        \\block body may also declare named results, `|v: s64| -> (low: s64,
        \\high: s64) { ... }`, which behave as in Procedure Declarations and
        \\Arguments.
    );
    paragraph(24, #string,oneline
        \\Lambda parameters are names with optional types and `noalias`.
        \\Defaults, `#comptime`, `#lazy` and `$` captures are not accepted
        \\(`|x: s64 = 1|` is `error: expected ',' or '|' after lambda
        \\parameter`, `|#comptime x: s64|` is `error: unexpected token
        \\'comptime'`), and repeating a name is `error: duplicate lambda
        \\parameter 'x'`. A lambda cannot call itself, because it has no name.
    );
    subheading(25, "Where a lambda's types come from");
    paragraph(26, #string,oneline
        \\A parameter without a written type gets its type from the place the
        \\lambda is used. There are three such places:
    );
    table_header(27, "Source   —   Example");
    table_row(28, "The declared type of the variable   |   `increment: (s64) -> s64 = |x| x + 1;`");
    table_row(29, "The parameter type of the procedure it is passed to   |   `apply(|a, b| a * b, 6, 7)`");
    table_row(30, "The arguments of the first call through it   |   `add := |a, b| a + b;  add(1, 2);`");
    paragraph(31, #string,oneline
        \\A generic procedure counts as a source once its own type parameters
        \\are known. In `find_index` below, `T` is inferred from the array, and
        \\the lambda's parameter becomes a `T`:
    );
    code_block(32, "glosso", #string
        \\#import "Io";
        \\
        \\find_index :: (values: []$T, predicate: (T) -> bool) -> s64 {
        \\    for values if predicate(it) return it_index;
        \\    return -1;
        \\}
        \\
        \\main :: () {
        \\    readings: [5]s64 = .[3, 9, 12, 5, 30];
        \\    print("{}\n", find_index(readings[..], |v| v > 10));
        \\    names: [3]str = .["ada", "grace", "linus"];
        \\    print("{}\n", find_index(names[..], |n| n.count == 5));
        \\}
    );
    code_block(33, "text", #string
        \\2
        \\1
    );
    paragraph(34, #string,oneline
        \\When the first call decides the types, it decides them for good, and
        \\a literal argument gives the parameter the literal's default type.
        \\After `add := |a, b| a + b; add(1, 2);` the parameters are `ssize`,
        \\so a later `add(1.5, 2.5)` is `error: callback argument
        \\comptime_float != ssize`. A lambda that nothing gives a type to is
        \\rejected where it is written: `f := |a| a + 1;` alone is `error:
        \\cannot infer a type here; annotate it or give it a use that fixes
        \\one`.
    );
    paragraph(35, #string,oneline
        \\The result type comes from the body once the parameter types are
        \\known, so `|x: s64| tprint("{}!", x)` returns a `str` without saying
        \\so. When both a written result type and the type of the variable are
        \\present, they must agree: assigning `|x: s64| -> str { ... }` to a
        \\`(s64) -> s64` variable is `error: lambda return type is str, but
        \\the expected type is s64`.
    );
    subheading(36, "No captures");
    paragraph(37, #string,oneline
        \\A lambda can use what exists independently of any call: top-level
        \\constants, global variables, procedures and types. It cannot use
        \\the local variables or parameters of the procedure it is written
        \\in. A lambda is a plain code pointer, and there is no place in it to
        \\carry a copy of a local. A local procedure has the same restriction
        \\(see Procedure Declarations and Arguments).
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\
        \\SCALE :: 10;
        \\offset := 3;
        \\
        \\main :: () {
        \\    scaled := |x: s64| x * SCALE + offset;
        \\    print("{}\n", scaled(4));
        \\    offset = 5;
        \\    print("{}\n", scaled(4));
        \\}
    );
    code_block(39, "text", #string
        \\43
        \\45
    );
    paragraph(40, #string,oneline
        \\The global is read when the lambda runs, so the second call sees the
        \\new value. Reading a local is an error. With a block body the
        \\compiler says what happened; with an expression body the name is
        \\not found:
    );
    code_block(41, "text", #string
        \\// limit := 10;  f := |x: s64| -> bool { return x < limit; };
        \\error: lambda captures local 'limit', but captured closures are not supported
        \\help: pass the value as an explicit callback or context argument
        \\
        \\// limit := 10;  f := |x: s64| x < limit;
        \\error: unbound 'limit'
    );
    paragraph(42, #string,oneline
        \\The usual remedy is an extra parameter: a procedure that calls a
        \\callback passes it the data it needs along with each element, and
        \\the lambda receives that data as an argument. Inside an inherent
        \\method, a lambda cannot use the method's `#self` either (`error:
        \\#self requires a receiver parameter in an inherent method`).
    );
    subheading(43, "Lambdas and named procedures together");
    paragraph(44, #string,oneline
        \\A lambda and a named procedure with the same signature produce the
        \\same kind of value, a pointer of type `(s64) -> s64` or of a named
        \\`#fn_ptr` type, and they can be mixed freely. A lambda assigned to a
        \\`#c_call` function-pointer type is compiled with the C calling
        \\convention, so it can be handed to C code.
    );
    code_block(45, "glosso", #string
        \\#import "Io";
        \\
        \\Step :: #fn_ptr(value: s64) -> s64;
        \\
        \\next :: (value: s64) -> s64 { return value + 1; }
        \\
        \\halve: Step = |value| value / 2;           // a global initialized with a lambda
        \\
        \\main :: () {
        \\    steps: [3]Step = .[next, halve, |value| value * value];
        \\    for steps print("[{}]", it(6));
        \\    print("\n");
        \\    split := |value: s64| -> (tens: s64, ones: s64) {
        \\        tens = value / 10;
        \\        ones = value % 10;
        \\    };
        \\    tens, ones := split(47);
        \\    print("{} {}\n", tens, ones);
        \\}
    );
    code_block(46, "text", #string
        \\[7][3][36]
        \\4 7
    );
    paragraph(47, #string,oneline
        \\A lambda is a value computed when the program runs, not a
        \\compile-time constant: `HALVE :: |value: s64| value / 2;` is
        \\`error: a lambda is not a compile-time constant`. Declare a named
        \\procedure for that purpose, which is a constant.
    );
    subheading(48, "Conversions");
    paragraph(49, #string,oneline
        \\A procedure converts to a function type only if the parameter types
        \\and the result type are exactly the same. No conversion is applied to
        \\the arguments of a call through a pointer, so a procedure that takes
        \\an `s32` cannot stand in for one that takes an `s64`. The calling
        \\convention and the `noalias` markers must match too. Parameter names
        \\do not matter.
    );
    code_block(50, "text", #string
        \\// Unary :: #fn_ptr(value: s64) -> s64;
        \\// narrow :: (value: s32) -> s64 { ... }   f: Unary = narrow;
        \\error: got #fn_ptr(s32) -> s64, expected #fn_ptr(s64) -> s64: parameter 1 is s32 here but s64 in the pointer type; arguments pass through a function pointer unconverted
        \\
        \\// C_Unary :: #fn_ptr(value: s64) -> s64 #c_call;
        \\// plain :: (value: s64) -> s64 { ... }   g: C_Unary = plain;
        \\error: got #fn_ptr(s64) -> s64, expected #fn_ptr(s64) -> s64 #c_call: the calling conventions differ (#c_call)
        \\
        \\// Copy :: #fn_ptr(noalias to: *s64, from: *const s64);
        \\// copy :: (to: *s64, from: *const s64) { ... }   h: Copy = copy;
        \\error: cannot implicitly convert #fn_ptr(*s64, *const s64) to #fn_ptr(noalias *s64, *const s64) because their noalias parameter contracts differ
    );
    paragraph(51, #string,oneline
        \\A `#foreign` declaration has a plain function type unless `#c_call`
        \\is written on it too, as in `c_abs :: (x: s32) -> s32 #c_call
        \\#foreign libc "abs";`. Only then does it convert to a `#c_call`
        \\function type (see C Types, Callbacks, and Bindgen). A procedure
        \\marked `#no_context` converts to a plain function type, since the
        \\marker does not change how it is called (see Directives That Modify
        \\Procedures).
    );
    subheading(52, "Procedures that cannot become pointers");
    paragraph(53, #string,oneline
        \\A generic procedure is not one procedure until its types are known,
        \\so `f := larger;` is `error: generic function 'larger' needs a call
        \\context`, even when the variable has a function type. Wrap the call
        \\you need in a lambda: `f: (s64) -> s64 = |x| larger(x, 0);`. A
        \\procedure with `#lazy` parameters (`error: lazy function 'delayed'
        \\cannot be used as an ordinary function pointer`) and an inherent
        \\method (`error: inherent method 'grow' requires a call; method values
        \\are not supported`) cannot become pointers either; a lambda that
        \\makes the call serves for them too.
    );
    subheading(54, "Calling through a pointer");
    paragraph(55, #string,oneline
        \\A call through a function pointer passes exactly the parameters of
        \\the function type, in order. Defaults belong to a procedure's
        \\declaration and are not part of its type, so a call through a pointer
        \\must supply every argument: with `f := label;` for `label :: (name:
        \\str, id: s64 = 0)`, `f("x")` is `error: callback expects 2
        \\argument(s), got 1`.
    );
    note(56, #string,oneline
        \\Pass arguments to a function pointer by position. Argument names in
        \\such a call are not checked against the parameter names: with `op:
        \\Binary_Op = subtract;`, `op(.right = 1, .left = 5)` passes 1 as the
        \\first argument and returns -4.
    );
    paragraph(57, #string,oneline
        \\Two function pointers compare equal with `==` when they refer to the
        \\same procedure.
    );
    subheading(58, "Absent function pointers");
    paragraph(59, #string,oneline
        \\A function pointer always refers to a procedure; the zero address is
        \\not one of its values. A slot that may be empty has the optional type
        \\`?Op`, whose empty value is `null`. Because the zero address is free,
        \\`?Op` is no larger than `Op`, and the standard library uses it for
        \\hooks such as the procedure of an allocator.
    );
    code_block(60, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Transform :: #fn_ptr(value: s64) -> s64;
        \\
        \\Stage :: struct {
        \\    name: str;
        \\    transform: ?Transform;
        \\}
        \\
        \\double :: (value: s64) -> s64 { return value * 2; }
        \\
        \\run :: (stage: Stage, value: s64) -> s64 {
        \\    if stage.transform == {
        \\        case .Some(f); return f(value);
        \\        case null; return value;
        \\    }
        \\}
        \\
        \\main :: () {
        \\    print("{} {}\n", run(.{ "pass", null }, 5), run(.{ "double", double }, 5));
        \\    print("{} {}\n", size_of(Transform), size_of(?Transform));
        \\}
    );
    code_block(61, "text", #string
        \\5 10
        \\8 8
    );
    paragraph(62, #string,oneline
        \\Assigning `null` to a plain function type is an error that points to
        \\the optional type:
    );
    code_block(63, "text", #string
        \\// f: Transform = null;
        \\error: 'null' is not a value of #fn_ptr(s64) -> s64
        \\note: a plain pointer excludes zero - write ?#fn_ptr(s64) -> s64 for a pointer that may be absent
        \\note: then 'null' is the absent ?#fn_ptr(s64) -> s64
    );
    paragraph(64, #string,oneline
        \\A cast turns an address into a function pointer. At `-O0` and `-O1`
        \\a zero address stops the program with "cast to fnptr of an address
        \\that is zero". A function-pointer variable declared without a value
        \\holds an invalid address, and calling it crashes the program, so
        \\initialize it, or use `?Op` when there may be nothing to call.
    );
    subheading(65, "Function pointers and C");
    paragraph(66, #string,oneline
        \\A C library that takes a callback expects the C calling convention,
        \\so the type is declared `#c_call` and the procedure passed to it is
        \\a `#c_call` procedure or a lambda assigned to that type. A function
        \\type may end with a bare `...` for a C function with variable
        \\arguments; it then requires `#c_call` (`error: C vararg function
        \\pointer 'Printer' requires #c_call`). `#foreign`, `#library`, and
        \\`#c_call` and C Types, Callbacks, and Bindgen describe both
        \\directions in detail.
    );
}

render_section_57 :: () {
    paragraph(0, #string,oneline
        \\This chapter describes the postfix forms that follow an expression,
        \\member access with a dot and calls with an argument list, and the
        \\procedures that belong to a type: inherent methods and associated
        \\functions, declared in `Type ::: { ... }` blocks. It ends with the
        \\order in which `value.name(...)` is resolved when a field, a method
        \\and a typeclass operation could all answer it. Structs and Methods
        \\introduces methods by example.
    );
    subheading(1, "Member access");
    paragraph(2, #string,oneline
        \\A dot followed by a name selects a member of the value, type or
        \\module before the dot. What a member can be depends on what is in
        \\front of the dot:
    );
    table_header(3, "Before the dot   —   Members");
    table_row(4, "A struct or raw union   |   Its fields, by name.");
    table_row(5, "A pointer to a struct or union   |   The fields of the pointee (see Pointer Types).");
    table_row(6, "A tuple   |   `.0`, `.1`, ... and `.count` (see Tuple Types).");
    table_row(7, "`[N]T`, `[]T`, `[..]T`   |   `.count` and `.data`; `[..]T` also `.capacity`.");
    table_row(8, "A `#soa` array or view   |   `.count`, one column view per element field; `#soa [..]T` also `.capacity`.");
    table_row(9, "`str`, `cstr`, `string16`, `cstring16`   |   `.count` and `.data`, both read-only.");
    table_row(10, "`any`   |   `.type` (a `*const Type_Info`) and `.value` (see `type` Values and Type Reflection).");
    table_row(11, "A type   |   Its associated functions, and for an enum its members, as in `Color.Green`.");
    table_row(12, "A module alias   |   The module's public names (see Modules, Imports, and the Prelude).");
    table_row(13, "A value whose type has inherent methods   |   Those methods, called with `value.name(...)`; see Inherent blocks below.");
    paragraph(14, #string,oneline
        \\Member access is a postfix operation like indexing and calling, and
        \\the three chain from left to right in any order, on any expression:
    );
    code_block(15, "glosso", #string
        \\#import "Io";
        \\
        \\Vec2 :: struct { x: s64; y: s64; }
        \\Line :: struct { from: Vec2; to: Vec2; }
        \\
        \\diagonal :: () -> Line { return .{ .from = .{ 1, 2 }, .to = .{ 3, 4 } }; }
        \\
        \\main :: () {
        \\    line := diagonal();
        \\    points: [3]Vec2 = .[.{ 1, 2 }, .{ 3, 4 }, .{ 5, 6 }];
        \\    pair: (s64, str) = .(7, "seven");
        \\    boxed: any = 2.5;
        \\    print("{} {}\n", line.to.y, diagonal().from.x);     // fields of fields, of a call
        \\    print("{} {} {}\n", points[1].x, points[1..][1].y, points.data[2].x);
        \\    print("{} {} {}\n", pair.0, pair.1, pair.count);
        \\    print("{} {}\n", points.count, boxed.type.name);
        \\}
    );
    code_block(16, "text", #string
        \\4 1
        \\3 6 5
        \\7 seven 2
        \\3 f64
    );
    paragraph(17, #string,oneline
        \\A name that is not a member is an error that names the type. For a
        \\struct the compiler suggests a field with a similar name when there
        \\is one:
    );
    code_block(18, "text", #string
        \\// Vec2 :: struct { width: s64; y: s64; }   n := v.widht;
        \\error: no field 'widht' in 'Vec2'
        \\help: did you mean 'width'?
        \\
        \\// pair.first
        \\error: tuple member must be a numeric field like .0
        \\
        \\// pair.5
        \\error: tuple index .5 is out of range for 2-value tuple
        \\
        \\// boxed.size
        \\error: any has fields type and value, not 'size'
    );
    paragraph(19, #string,oneline
        \\The payload of a tagged union's variant is not read with a dot.
        \\`t.Number` is `error: tagged-union payload '.Number' may only be
        \\bound by a pattern match`, because the variant may not be the active
        \\one; a pattern binds the payload of the variant that is (see Tagged
        \\and Untagged Unions). A note with the error names the unchecked
        \\alternative, `#enable(allow_union_unwrap)` (see Feature Gates and
        \\Runtime Checks).
    );
    subheading(20, "Calls");
    paragraph(21, #string,oneline
        \\A call is any expression followed by a parenthesized argument list:
        \\a procedure name, a member, an element of an array of function
        \\pointers, or the result of another call. Arguments are separated by
        \\commas, a trailing comma is allowed, and they are evaluated from left
        \\to right before the call.
    );
    code_block(22, "glosso", #string
        \\#import "Io";
        \\
        \\Op :: #fn_ptr(x: s64) -> s64;
        \\
        \\double :: (x: s64) -> s64 { return x * 2; }
        \\negate :: (x: s64) -> s64 { return -x; }
        \\pick :: (doubling: bool) -> Op { if doubling return double; return negate; }
        \\note :: (label: str, value: s64) -> s64 { print("{} ", label); return value; }
        \\add3 :: (a: s64, b: s64, c: s64) -> s64 { return a + b + c; }
        \\
        \\main :: () {
        \\    table: [2]Op = .[double, negate];
        \\    print("{} {}\n", pick(true)(21), table[1](4));   // any expression can be called
        \\    sum := add3(
        \\        note("a", 1),
        \\        note("b", 2),
        \\        note("c", 3),        // a trailing comma is allowed
        \\    );
        \\    print("= {}\n", sum);
        \\}
    );
    code_block(23, "text", #string
        \\42 -4
        \\a b c = 6
    );
    paragraph(24, #string,oneline
        \\Arguments are passed by value: the callee receives copies, so a
        \\procedure that must change the caller's variable takes a pointer.
        \\An argument may also be given by its parameter's name, `.name =
        \\value`, and a parameter with a default may be left out; Procedure
        \\Declarations and Arguments gives the rules. An array argument
        \\followed by `...` is expanded into a variadic parameter (see
        \\Variadic Procedures).
    );
    subheading(25, "Inherent blocks");
    paragraph(26, #string,oneline
        \\Procedures can belong to a type. They are declared in an inherent
        \\block, the type's name followed by `:::` and braces, and called
        \\through a value of the type or through the type itself. A procedure
        \\whose first parameter is the receiver `#self` is a method; one
        \\without a receiver is an associated function, such as a constructor.
    );
    code_block(27, "glosso", #string
        \\#import "Io";
        \\#import "Math/Core";
        \\
        \\Vec2 :: struct { x: f64; y: f64; }
        \\
        \\Vec2 ::: {
        \\    make :: (x: f64, y: f64) -> Vec2 { return .{ x, y }; }
        \\    zero :: () -> #Self_Type { return .{ 0, 0 }; }
        \\
        \\    length :: (#self) -> f64 { return sqrt(#self.x * #self.x + #self.y * #self.y); }
        \\    plus :: (#self, other: Vec2) -> Vec2 { return .{ #self.x + other.x, #self.y + other.y }; }
        \\    scale :: (*#self, factor: f64) { #self.x *= factor; #self.y *= factor; }
        \\}
        \\
        \\main :: () {
        \\    v := Vec2.make(3, 4);          // an associated function: through the type
        \\    print("{}\n", v.length());     // a method: through a value
        \\    v.scale(2);                    // &v is taken automatically
        \\    print("{} {}\n", v.x, v.y);
        \\    w := v.plus(Vec2.zero()).plus(.{ 1, 1 });
        \\    print("{} {}\n", w.x, Vec2.length(v));
        \\}
    );
    code_block(28, "text", #string
        \\5
        \\6 8
        \\7 10
    );
    paragraph(29, #string,oneline
        \\`value.name(arguments)` passes `value` as the receiver and the
        \\written arguments after it. `Type.name(value, arguments)` is the same
        \\call with the receiver written out. An associated function has no
        \\receiver, so it is called only through the type: `v.make(1, 2)` is
        \\`error: static inherent function 'make' must be called through its
        \\type`.
    );
    subheading(30, "Receivers");
    paragraph(31, #string,oneline
        \\The receiver is always the first parameter. It is written without a
        \\type, in one of three forms, and inside the method it is read as
        \\`#self`. The fields of the type are reached as `#self.x`, never by
        \\their bare names.
    );
    table_header(32, "Receiver   —   The method receives   —   Called on");
    table_row(33, "`#self`   |   A copy of the value. Changing it changes only the copy.   |   A value, or a pointer, which is dereferenced.");
    table_row(34, "`*#self`   |   A pointer to the value; the method can change it.   |   A value, whose address is taken, or a writable pointer.");
    table_row(35, "`*const #self`   |   A read-only pointer; nothing is copied.   |   A value or any pointer.");
    paragraph(36, #string,oneline
        \\A `*#self` method can be called on a temporary, such as the result of
        \\a call, and returning `#self` from it allows calls to be chained. It
        \\cannot be called through a `*const` pointer (`error: mutable
        \\receiver for 'add' cannot use a const pointer`). `noalias *#self`
        \\makes the receiver a `noalias` pointer (see `noalias`, `#lazy`, `#comptime`,
        \\and Type Parameters).
    );
    code_block(37, "glosso", #string
        \\#import "Io";
        \\
        \\Tally :: struct { total: s64; }
        \\
        \\Tally ::: {
        \\    make :: () -> Tally { return .{ 0 }; }
        \\    add :: (*#self, amount: s64) -> *Tally {
        \\        #self.total += amount;
        \\        return #self;
        \\    }
        \\    report :: (*const #self) { print("total {}\n", #self.total); }
        \\}
        \\
        \\main :: () {
        \\    t := Tally.make();
        \\    t.add(1).add(2).add(3);
        \\    t.report();
        \\    Tally.make().add(10).report();      // a temporary receiver
        \\    p := &t;
        \\    p.add(4);
        \\    p.report();
        \\}
    );
    code_block(38, "text", #string
        \\total 6
        \\total 10
        \\total 10
    );
    table_header(39, "Mistake   —   Diagnostic");
    table_row(40, "`(count: s64, #self)`   |   `#self must be the first parameter of an inherent method`");
    table_row(41, "`(#self: Vec2)`   |   `#self cannot have an annotation, default, or variadic marker`");
    table_row(42, "`(#self, #self)`   |   `an inherent method may declare at most one #self receiver`");
    table_row(43, "`#self` outside an inherent block   |   `#self parameters are only valid in inherent methods`");
    table_row(44, "A method with a field's or variant's name   |   `inherent method 'x' conflicts with a field or variant`");
    table_row(45, "The same method declared twice   |   `duplicate or overlapping inherent method 'length' for 'Vec2'`");
    subheading(46, "`#Self_Type`");
    paragraph(47, #string,oneline
        \\`#Self_Type` is the type that owns the method, as `zero` uses it
        \\above. It is most useful in a block for a generic type, where it is
        \\the type with its arguments. It is also available in a typeclass
        \\instance (see Typeclass Declarations and Instances) and nowhere else
        \\(`error: #Self_Type is only available inside an inherent method or
        \\instance`).
    );
    subheading(48, "Methods of generic types");
    paragraph(49, #string,oneline
        \\The owner of a block for a generic struct or union is written with
        \\captures, as in `Stack($T) ::: { ... }`. The captured names are in
        \\scope in every member. A block may have `where` clauses after the
        \\`:::`; its members then exist only for the types that satisfy them,
        \\and a call on any other type fails with `constraint failed`. Methods
        \\may be generic themselves, with captures in their own parameters.
    );
    code_block(50, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Stack :: struct {
        \\    items: [8]$T;
        \\    count: s64;
        \\}
        \\
        \\Stack($T) ::: {
        \\    push :: (*#self, value: T) {
        \\        #self.items[#self.count] = value;
        \\        #self.count += 1;
        \\    }
        \\    push_all :: (*#self, values: ...T) { for values #self.push(it); }
        \\    copy :: (#self) -> #Self_Type { return #self; }
        \\    element :: (#self) -> str { return type_name(T); }
        \\}
        \\
        \\Stack($T) ::: where Num(T) {
        \\    total :: (#self) -> T {
        \\        sum: T = 0;
        \\        for 0..#self.count sum += #self.items[it];
        \\        return sum;
        \\    }
        \\}
        \\
        \\main :: () {
        \\    numbers: Stack(f64);
        \\    numbers.push_all(1.5, 2, 3);
        \\    print("{} {} {}\n", numbers.element(), numbers.copy().count, numbers.total());
        \\    words: Stack(str);
        \\    words.push("a");
        \\    print("{} {}\n", words.element(), words.count);
        \\}
    );
    code_block(51, "text", #string
        \\f64 3 6.5
        \\str 1
    );
    paragraph(52, #string,oneline
        \\`words.total()` would be `error: constraint failed for total`. Enums,
        \\unions and `distinct` types have inherent blocks in the same way as
        \\structs; a union's methods must not reuse the names of its variants.
    );
    subheading(53, "Where a block may be declared");
    paragraph(54, #string,oneline
        \\An inherent block must belong to the same ownership unit as its type
        \\(see Who Can Use a Declaration: Visibility and Units). For a type of
        \\the program, any module of the program's unit may add a block, and
        \\its methods are found through the type once that module is part of
        \\the program, even where it is not imported. Types that the program
        \\did not declare, the primitive types and the standard library's
        \\types, as well as built-up types such as `[3]Vec2` or `*Vec2`,
        \\cannot receive methods from the program:
    );
    code_block(55, "text", #string
        \\// s64 ::: { squared :: (#self) -> s64 { return #self * #self; } }
        \\error: inherent methods for 's64' belong to ownership unit 'builtin:std'; this block belongs to 'project:'
    );
    paragraph(56, #string,oneline
        \\Behaviour for such types is given through a typeclass instead (see
        \\Typeclass Declarations and Instances), or through an ordinary
        \\procedure that takes the value as an argument.
    );
    subheading(57, "Visibility of members");
    paragraph(58, #string,oneline
        \\Members of an inherent block are private to their module by default,
        \\even when the type is public. `#public` before a member exports that
        \\member, and `#public` after the `:::` makes every member of the
        \\block public unless it is marked `#private`:
    );
    code_block(59, "glosso", #string
        \\// account.glo
        \\#public Account :: struct { balance: s64; }
        \\
        \\Account ::: {
        \\    audit :: (#self) -> bool { return #self.balance >= 0; }     // private
        \\    #public deposit :: (*#self, amount: s64) { #self.balance += amount; }
        \\}
        \\
        \\Account ::: #public {
        \\    open :: () -> Account { return .{ 0 }; }
        \\    balance_of :: (#self) -> s64 { return #self.balance; }
        \\}
    );
    code_block(60, "glosso", #string
        \\#import "Io";
        \\#import "account.glo";
        \\
        \\main :: () {
        \\    a := Account.open();
        \\    a.deposit(25);
        \\    print("{}\n", a.balance_of());
        \\}
    );
    code_block(61, "text", #string
        \\25
    );
    paragraph(62, #string,oneline
        \\`a.audit()` in the importing module is `error: 'audit' is private to
        \\its defining source and module`, and so is a member marked
        \\`#private` inside a `#public` block. Who Can Use a Declaration:
        \\Visibility and Units describes the other audiences.
    );
    subheading(63, "How `value.name(...)` is resolved");
    paragraph(64, #string,oneline
        \\`value.name(arguments)` is a call. The compiler looks for `name` in
        \\this order:
    );
    bullet(65, #string,oneline
        \\a field of `value` that holds a function pointer, which is then
        \\called with exactly the written arguments (a type may not have an
        \\inherent method with the same name as a field);
    );
    bullet(66, #string,oneline
        \\an inherent method of the value's type, which receives `value` as
        \\its `#self` argument;
    );
    bullet(67, #string,oneline
        \\an operation of a typeclass that the type has an instance of, with
        \\`value` as its first argument (see Typeclass Declarations and
        \\Instances).
    );
    code_block(68, "glosso", #string
        \\#import "Io";
        \\
        \\Shape :: typeclass (T: type) {
        \\    area :: (shape: T) -> f64;
        \\}
        \\
        \\Listener :: #fn_ptr(side: f64);
        \\
        \\Square :: struct {
        \\    side: f64;
        \\    on_change: Listener;        // a field that holds a procedure
        \\}
        \\
        \\report :: (side: f64) { print("side is now {}\n", side); }
        \\
        \\Square ::: instance Shape {
        \\    area :: (shape: Square) -> f64 { return shape.side * shape.side; }
        \\}
        \\
        \\Square ::: {
        \\    make :: (side: f64) -> Square { return .{ side, report }; }
        \\    grow :: (*#self, by: f64) {
        \\        #self.side += by;
        \\        #self.on_change(#self.side);    // a call through the field
        \\    }
        \\}
        \\
        \\main :: () {
        \\    s := Square.make(2);        // an associated function, through the type
        \\    s.grow(1);                  // an inherent method; &s is taken automatically
        \\    print("{} {}\n", s.area(), Shape.area(s));   // a typeclass operation
        \\}
    );
    code_block(69, "text", #string
        \\side is now 3
        \\9 9
    );
    paragraph(70, #string,oneline
        \\When a type has an inherent method and a typeclass operation of the
        \\same name, the inherent method wins; the typeclass operation is still
        \\reachable as `Shape.area(s)`. When two typeclasses both offer the
        \\name, the call is ambiguous and must be qualified:
    );
    code_block(71, "text", #string
        \\// Loud and Quiet both declare describe, and Thing has instances of both
        \\error: ambiguous typeclass operation 'describe' for these argument types
        \\note: first matching instance is declared here
        \\note: another matching instance is declared here
    );
    paragraph(72, #string,oneline
        \\An ordinary procedure does not become a method because its first
        \\parameter has the right type. With `length2 :: (v: Vec2) -> s64`,
        \\`v.length2()` is `error: no field 'length2' in 'Vec2'`; call it as
        \\`length2(v)`, or declare it in an inherent block.
    );
    subheading(73, "Methods are called, not taken");
    paragraph(74, #string,oneline
        \\A method is not a value: `f := v.length;` is `error: inherent method
        \\'length' requires a call; method values are not supported`. A lambda
        \\that makes the call, `|v: Vec2| v.length()`, serves where a function
        \\pointer is needed (see Lambdas and `#fn_ptr` Values).
    );
}

render_section_58 :: () {
    paragraph(0, #string,oneline
        \\A procedure directive changes how a procedure is compiled or called:
        \\whether calls are inlined, whether a result may be dropped, which
        \\calling convention it uses, or what compile-time code checks its
        \\type parameters. Directives are written after the result type and
        \\before any `where` clause and the body, and a procedure may carry
        \\several, in any order. This chapter describes each of them; the
        \\markers written on single parameters are described in `noalias`,
        \\`#lazy`, `#comptime`, and Type Parameters.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\scale :: (value: s64, factor: s64) -> s64 #inline #must where true {
        \\    return value * factor;
        \\}
        \\
        \\main :: () {
        \\    print("{}\n", scale(6, 7));
        \\}
    );
    code_block(2, "text", #string
        \\42
    );
    subheading(3, "The directives");
    table_header(4, "Directive   —   Effect");
    table_row(5, "`#inline`, `#inline,always`, `#inline,never`   |   Asks for, forces or forbids inlining of calls.");
    table_row(6, "`#must`   |   A call whose result is discarded is an error.");
    table_row(7, "`#c_call`   |   The C calling convention; the procedure can be called from C.");
    table_row(8, "`#no_context`   |   The body does not use the implicit context.");
    table_row(9, "`#returns_twice`   |   A call may return more than once, like C's `setjmp`.");
    table_row(10, "`#dump`   |   Prints the procedure's intermediate code while compiling.");
    table_row(11, "`#modify`   |   Compile-time code that checks or computes type parameters for each call.");
    table_row(12, "`#foreign`   |   The procedure is in a C library; no body. See `#foreign`, `#library`, and `#c_call`.");
    table_row(13, "`#magic`   |   The compiler implements the procedure; no body. See `#asm`, `#bytes`, and `#magic`.");
    table_row(14, "`#expand`   |   The procedure is a macro. See `#code`, `#insert`, and `#expand`.");
    table_row(15, "`#operator`   |   The procedure defines an operator. See Operator Declarations.");
    paragraph(16, #string,oneline
        \\A directive after a `where` clause is an error, because the clauses
        \\end the signature: `f :: (a: s64) where true #inline { }` gives
        \\`error: function directives must appear before where clauses`. A
        \\name the parser does not know in this position is reported as the
        \\token it is, so `f :: () #bogus { }` is `error: unexpected token
        \\'bogus'`. A repeated directive is accepted without comment.
    );
    paragraph(17, #string,oneline
        \\A procedure that does not return declares the result type `#Never`
        \\(see Procedure Declarations and Arguments); there is no directive for
        \\it, and `#noreturn` gives `error: #noreturn has been replaced by the
        \\return type '-> #Never'`.
    );
    subheading(18, "`#inline`");
    paragraph(19, #string,oneline
        \\`#inline` asks the optimizer to inline calls to the procedure.
        \\`#inline,always` requires it, and `#inline,never` forbids it, which
        \\keeps a rarely used path out of its callers or keeps a procedure
        \\visible in a profile. The optimizer inlines small procedures on its
        \\own at `-O2` and above, so `#inline` is a hint for the cases it would
        \\otherwise decline. Any other word after the comma is `error: #inline
        \\expects always or never after ','`.
    );
    paragraph(20, #string,oneline
        \\`#inline` before a `for` or `while` loop is a different directive,
        \\which unrolls the loop at compile time; see `while`, `for`, and
        \\Unrolled Loops.
    );
    subheading(21, "`#must`");
    paragraph(22, #string,oneline
        \\`#must` makes it an error to call the procedure as a statement and
        \\drop its result. It suits procedures whose result is the whole point,
        \\such as one that returns an owned value or an error. Binding the
        \\result to `_` states that dropping it is intended:
    );
    code_block(23, "text", #string
        \\// make :: (n: s64) -> s64 #must { return n; }
        \\// main :: () { make(1); }
        \\error: discarded return value of #must function 'make'
        \\help: bind it explicitly, for example `_ := make(...);`, if discarding is intentional
    );
    paragraph(24, #string,oneline
        \\`#must` belongs on procedures with a result. On a procedure without
        \\one, every call statement gives the same error, and there is no
        \\value to bind instead.
    );
    subheading(25, "`#c_call` and `#no_context`");
    paragraph(26, #string,oneline
        \\`#c_call` compiles the procedure with the C calling convention of the
        \\target, so C code can call it through a function pointer, and a
        \\library build exports it under the name `glo_` followed by the
        \\procedure's name (see Compiler Options and Output Kinds and
        \\`#foreign`, `#library`, and `#c_call`). Only a `#c_call` procedure,
        \\or a `#foreign` declaration, may end its parameter list with the C
        \\variable-argument marker `...`.
    );
    paragraph(27, #string,oneline
        \\The body of a `#c_call` procedure cannot use the implicit `context`
        \\(see `#Context` and `context`), because a caller in C knows nothing
        \\about it. `#no_context` states the same restriction for a procedure
        \\that keeps the ordinary calling convention. In both, naming
        \\`context` is an error; the procedures they call still find the
        \\context as usual.
    );
    code_block(28, "glosso", #string
        \\#import "Io";
        \\
        \\user_tag :: () -> s64 { return context.user_index; }
        \\
        \\callback :: (value: s32) -> s32 #c_call { return value + cast(s32) user_tag(); }
        \\fast_double :: (value: s64) -> s64 #no_context { return value * 2; }
        \\
        \\main :: () {
        \\    context.user_index = 100;
        \\    print("{} {}\n", callback(5), fast_double(21));
        \\}
    );
    code_block(29, "text", #string
        \\105 42
    );
    code_block(30, "text", #string
        \\// fast_double :: (value: s64) -> s64 #no_context { return value + context.user_index; }
        \\error: cannot access 'context' in a #c_call / #no_context procedure
    );
    paragraph(31, #string,oneline
        \\`#c_call` is part of a procedure's type, so a `#c_call` procedure and
        \\a plain one do not convert to each other's function-pointer types
        \\(see Lambdas and `#fn_ptr` Values). `#no_context` is not part of the
        \\type and does not change how the procedure is called.
    );
    subheading(32, "`#returns_twice`");
    paragraph(33, #string,oneline
        \\`#returns_twice` declares that a call may return more than once:
        \\first normally, and later again when some other code transfers
        \\control back to the point of the call, as C's `setjmp` does. The
        \\compiler then keeps the caller's variables in memory rather than in
        \\registers, so that they hold their latest values after the second
        \\return. It is needed on declarations of such C functions:
    );
    code_block(34, "glosso", #string
        \\#import "Io";
        \\
        \\libc :: #library "c";
        \\
        \\Jump_Buffer :: struct { words: [64]u64; }
        \\
        \\c_setjmp :: (buffer: *Jump_Buffer) -> s32 #returns_twice #foreign libc "_setjmp";
        \\c_longjmp :: (buffer: *Jump_Buffer, value: s32) -> #Never #foreign libc "longjmp";
        \\
        \\buffer: Jump_Buffer;
        \\attempts := 0;
        \\
        \\main :: () {
        \\    code := c_setjmp(&buffer);
        \\    attempts += 1;
        \\    print("setjmp returned {} (attempt {})\n", code, attempts);
        \\    if code < 2 c_longjmp(&buffer, code + 1);
        \\}
    );
    code_block(35, "text", #string
        \\setjmp returned 0 (attempt 1)
        \\setjmp returned 1 (attempt 2)
        \\setjmp returned 2 (attempt 3)
    );
    paragraph(36, #string,oneline
        \\Glosso programs normally use the `Jump` module for such transfers,
        \\whose capture operation is declared `#returns_twice` in the same way
        \\(see Labels, `goto`, and Non-Local Transfers).
    );
    subheading(37, "`#dump`");
    paragraph(38, #string,oneline
        \\`#dump` prints the procedure's intermediate code on the compiler's
        \\standard error when the procedure is translated, which shows what the
        \\compiler made of the body. A procedure that nothing calls is not
        \\translated and prints nothing, and neither does a build that is
        \\restored from the artifact cache. The procedure in the example is
        \\`#public` so that the header shows its plain name; a module-private
        \\procedure appears under its internal, mangled name.
    );
    code_block(39, "glosso", #string
        \\#public add :: (a: s64, b: s64) -> s64 #dump { return a + b; }
        \\
        \\main :: () { _ := add(1, 2); }
    );
    code_block(40, "text", #string
        \\$ glosso dump.glo
        \\glosso: compile dump.glo (target=x86_64-pc-linux-gnu)
        \\; ---- #dump typed-ir add(a: s64, b: s64) -> s64  [3 ins] ----
        \\   0  magic v2 'int_add' [v0,v1]
        \\   1  move v3 v2
        \\   2  ret v3
        \\; ---- end add ----
        \\glosso: link dump (target=x86_64-pc-linux-gnu, -O1)
        \\glosso: done dump  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
    );
    subheading(41, "`#modify`");
    paragraph(42, #string,oneline
        \\`#modify` attaches compile-time code to a generic procedure. For each
        \\call, after the arguments have been matched and the type parameters
        \\inferred, the compiler runs the code with the type parameters and
        \\`#comptime` parameters as values. The code may assign new types to
        \\type parameters, and it returns a `bool`: `false` rejects the call
        \\as a failed constraint. The code is either a block or, for a simple
        \\test, a single expression.
    );
    code_block(43, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\// R appears only in the result; #modify computes it.
        \\as_float :: (value: $T) -> $R
        \\#modify {
        \\    if !Is_Numeric(T) return false;
        \\    #if Is_Float(T) { R = T; } else { R = f64; }
        \\    return true;
        \\}
        \\{
        \\    return cast(R) value;
        \\}
        \\
        \\// The result's length depends on a #comptime parameter.
        \\squares :: (#comptime count: s64) -> $R
        \\#modify {
        \\    R = [count]s64;
        \\    return true;
        \\}
        \\{
        \\    result: R;
        \\    for 0..count result[it] = it * it;
        \\    return result;
        \\}
        \\
        \\main :: () {
        \\    print("{} {}\n", type_name(type_of(as_float(3))), type_name(type_of(as_float(cast(f32) 1.5))));
        \\    s := squares(4);
        \\    print("{} {}\n", type_name(type_of(s)), s[3]);
        \\}
    );
    code_block(44, "text", #string
        \\f64 f32
        \\[4]s64 9
    );
    paragraph(45, #string,oneline
        \\A `where` clause can only accept or reject a call; `#modify` can also
        \\decide types that the arguments do not determine, such as `R` above,
        \\or a result type that depends on a `#comptime` parameter, which the
        \\signature itself cannot name. A call that the code rejects reports
        \\the `#modify` block:
    );
    code_block(46, "text", #string
        \\// as_float("text");
        \\error: constraint failed for as_float
        \\note: the #modify constraint fails here: #modify returned false
    );
    paragraph(47, #string,oneline
        \\When `#modify` assigns a type parameter that a parameter's type
        \\uses, the arguments are then converted to the new type as in an
        \\ordinary call. An `s8` argument widens to an `s64` parameter, but an
        \\`f64` is not accepted for one:
    );
    code_block(48, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\widen :: (value: $T) -> T
        \\#modify {
        \\    T = s64;
        \\    return true;
        \\}
        \\{
        \\    return value;
        \\}
        \\
        \\main :: () {
        \\    small: s8 = -3;
        \\    print("{} {}\n", widen(small), type_name(type_of(widen(small))));
        \\}
    );
    code_block(49, "text", #string
        \\-3 s64
    );
    code_block(50, "text", #string
        \\// ratio: f64 = 1.5;  _ := widen(ratio);
        \\error: arg type f64 != s64 in call widen
        \\note: #modify changes the type of parameter 'value' from f64 to s64
    );
    paragraph(51, #string,oneline
        \\The standard library's `Math/Matrix` module uses `#modify` to compute
        \\the result types of matrix operations.
    );
    subheading(52, "`#modify` on a generic struct");
    paragraph(53, #string,oneline
        \\A generic struct takes `#modify` between `struct` and its fields. The
        \\code runs for each set of type arguments the struct is used with,
        \\and can reject them or replace them:
    );
    code_block(54, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Counter :: struct #modify Is_Integer(T) {
        \\    value: $T;
        \\}
        \\
        \\Wide :: struct #modify {
        \\    #if Is_Integer(T) && size_of(T) < 8 { T = s64; }
        \\    return true;
        \\} {
        \\    value: $T;
        \\}
        \\
        \\main :: () {
        \\    c: Counter(u8);
        \\    w: Wide(s8);
        \\    print("{} {}\n", type_name(type_of(c.value)), type_name(type_of(w.value)));
        \\}
    );
    code_block(55, "text", #string
        \\u8 s64
    );
    code_block(56, "text", #string
        \\// c: Counter(f64);
        \\error: #modify returned false for struct Counter
        \\note: #modify returned false
    );
    subheading(57, "Directives on parameters");
    paragraph(58, #string,oneline
        \\`noalias`, `using`, `#comptime`, `#lazy` and `#empty` are written on
        \\a single parameter rather than on the procedure. `noalias`, `#lazy`,
        \\`#comptime`, and Type Parameters lists them with their order and describes
        \\each, except `using`, which Struct Types describes.
    );
}

}
