// Shared by the embedded files in the manual ownership unit.
#public(unit) {
// Shared Clay declarations and manual content primitives.


GLOSSO_SOURCE_MARKER :: "glosso-source";
CODE_GLOSSO_MARKER :: "code-glosso";
CODE_SOURCE_MARKER :: "code-source";
CODE_COPY_MARKER :: "code-copy";
SOURCE_LINK_MARKER :: "source-link";
SYMBOL_ANCHOR_MARKER :: "symbol-anchor";
FONT_SANS : u16 : 0;
FONT_SANS_BOLD : u16 : 1;
FONT_MONO : u16 : 2;
FONT_MONO_BOLD : u16 : 3;
FONT_HEADING : u16 : 4;
FONT_BODY : u16 : 5;
FRAME_TEXT_CAPACITY : ssize : 2 * 1024 * 1024;
frame_text_storage: [FRAME_TEXT_CAPACITY]u8;
frame_text_cursor: ssize = 0;
content_table_open: bool = false;
// Kept here because content tables are emitted by the shared primitives,
// before the manual and reference views split into their own modules.
document_viewport_width: f32 = 1280.0;

frame_string_from_raw_parts :: (
    data: [*]const u8,
    count: ssize,
) -> string #magic "string_from_raw_parts";

reset_frame_text_storage :: () {
    frame_text_cursor = 0;
}

frame_text_copy :: (value: string) -> string {
    if value.count <= 0 return "";
    if frame_text_cursor + value.count > FRAME_TEXT_CAPACITY return "";

    start := frame_text_cursor;
    storage := cast([*]u8)&frame_text_storage;
    index: ssize = 0;
    while index < value.count {
        storage[start + index] = value[index];
        index += 1;
    }
    frame_text_cursor += value.count;

    return frame_string_from_raw_parts(
        storage + start,
        value.count,
    );
}

clay_string :: (value: string) -> Clay_String {
    result: Clay_String;
    // Glosso strings can come from frame-local formatting as well as literals.
    // Hash the contents so Clay's text cache never treats reused temporary
    // addresses as stable string identities.
    result.isStaticallyAllocated = false;
    result.length = cast(s32)value.count;
    result.chars = cast([*]const s8)value.data;
    return result;
}

color :: (r: f32, g: f32, b: f32, a: f32 = 255) -> Clay_Color {
    result: Clay_Color;
    result.r = r; result.g = g; result.b = b; result.a = a;
    return result;
}

axis :: (kind: u8, minimum: f32, maximum: f32) -> Clay_SizingAxis {
    result: Clay_SizingAxis;
    result.size_abi_0 = minimum;
    result.size_abi_1 = maximum;
    result.type_ = kind;
    return result;
}

fixed_axis :: (size: f32) -> Clay_SizingAxis {
    return axis(CLAY__SIZING_TYPE_FIXED, size, size);
}

grow_axis :: (minimum: f32 = 0, maximum: f32 = 1000000) -> Clay_SizingAxis {
    return axis(CLAY__SIZING_TYPE_GROW, minimum, maximum);
}

fit_axis :: (minimum: f32 = 0, maximum: f32 = 1000000) -> Clay_SizingAxis {
    return axis(CLAY__SIZING_TYPE_FIT, minimum, maximum);
}

padding :: (horizontal: u16, vertical: u16) -> Clay_Padding {
    result: Clay_Padding;
    result.left = horizontal; result.right = horizontal;
    result.top = vertical; result.bottom = vertical;
    return result;
}

radius :: (amount: f32) -> Clay_CornerRadius {
    result: Clay_CornerRadius;
    result.topLeft = amount; result.topRight = amount;
    result.bottomLeft = amount; result.bottomRight = amount;
    return result;
}

text_style :: (
    size: u16,
    ink: Clay_Color,
    font: u16 = 0,
    line_height: u16 = 0,
    wrap: u8 = CLAY_TEXT_WRAP_WORDS,
) -> Clay_TextElementConfig {
    config: Clay_TextElementConfig;
    config.textColor = ink;
    config.fontId = font;
    config.fontSize = size;
    if line_height == 0 {
        config.lineHeight = cast(u16)(cast(f32)size * 1.55);
    } else {
        config.lineHeight = line_height;
    }
    config.wrapMode = wrap;
    return config;
}

// userData is preserved on Clay render commands. The browser host uses tag 1
// to identify Glosso source that should be tokenized by tree-sitter WASM.
tagged_text_style :: (
    size: u16,
    ink: Clay_Color,
    font: u16 = 0,
    line_height: u16 = 0,
    wrap: u8 = CLAY_TEXT_WRAP_WORDS,
    tag: u32 = 0,
) -> Clay_TextElementConfig {
    config := text_style(size, ink, font, line_height, wrap);
    if tag != 0 config.userData = cast([*]void)GLOSSO_SOURCE_MARKER.data;
    return config;
}

// Text markers give the browser native headings and keyboard-accessible links.
heading_text_style :: (size: u16 = 22, page_title: bool = false) -> Clay_TextElementConfig {
    config := text_style(size, color(23, 26, 31), FONT_HEADING, size + 10);
    if page_title config.userData = cast([*]void)"page-title".data;
    else config.userData = cast([*]void)"doc-heading".data;
    return config;
}

route_text_style :: (view: s32, index: s32, size: u16 = 15, mono: bool = false) -> Clay_TextElementConfig {
    font := FONT_SANS;
    if mono font = FONT_MONO;
    config := text_style(size, color(36, 73, 216), font, size + 9);
    // Padding lets the host read a bounded 32-byte marker, including the index.
    config.userData = cast([*]void)frame_text_copy(tprint("route:{}:{};                                ", view, index)).data;
    return config;
}

// Item links remain native anchors in the host: they support history, copying,
// keyboard navigation, and opening documentation in a new tab.
item_text_style :: (index: s32, type_owner: bool = false, size: u16 = 15) -> Clay_TextElementConfig {
    config := text_style(size, color(36, 73, 216), FONT_MONO, size + 9);
    owner: s32 = 0;
    if type_owner owner = 1;
    config.userData = cast([*]void)frame_text_copy(tprint("item:{}:{};                                                ", index, owner)).data;
    return config;
}

// Insert display line breaks in long paths without changing their link target.
wrap_path :: (value: string, columns: ssize) -> string {
    if columns < 8 columns = 8;
    if value.count <= columns return value;
    if frame_text_cursor + value.count * 2 > FRAME_TEXT_CAPACITY return value;
    start := frame_text_cursor;
    storage := cast([*]u8)&frame_text_storage;
    line_start: ssize = 0;
    while line_start < value.count {
        end := line_start + columns;
        if end >= value.count end = value.count;
        else {
            split := end;
            while split > line_start + columns / 2 && value[split - 1] != cast(u8)(#char "/") &&
                  value[split - 1] != cast(u8)(#char "_") split -= 1;
            if split > line_start + columns / 2 end = split;
        }
        for index: line_start..end {
            storage[frame_text_cursor] = value[index];
            frame_text_cursor += 1;
        }
        if end < value.count {
            storage[frame_text_cursor] = cast(u8)(#char "\n");
            frame_text_cursor += 1;
        }
        line_start = end;
    }
    return frame_string_from_raw_parts(storage + start, frame_text_cursor - start);
}

action_text_style :: (style: Clay_TextElementConfig, enabled: bool = true) -> Clay_TextElementConfig {
    config := style;
    if enabled config.userData = cast([*]void)"action".data;
    else config.userData = cast([*]void)"disabled".data;
    return config;
}

article_content_width :: () -> f32 {
    width := document_viewport_width;
    if width >= 860.0 {
        width -= 200;
        if width > 1100 width = 1100;
        return width - 64;
    }
    return width - 32;
}

code_body_text_style :: (highlight: bool) -> Clay_TextElementConfig {
    config := text_style(
        13, color(23, 26, 31), FONT_MONO, 22,
        CLAY_TEXT_WRAP_NEWLINES,
    );
    if highlight {
        config.userData = cast([*]void)CODE_GLOSSO_MARKER.data;
    } else {
        config.userData = cast([*]void)CODE_SOURCE_MARKER.data;
    }
    return config;
}

code_copy_text_style :: () -> Clay_TextElementConfig {
    config := text_style(
        10, color(36, 73, 216), FONT_MONO, 16,
        CLAY_TEXT_WRAP_NONE,
    );
    config.userData = cast([*]void)CODE_COPY_MARKER.data;
    return config;
}

source_text_style :: (
    size: u16,
    ink: Clay_Color,
    line_height: u16 = 0,
) -> Clay_TextElementConfig {
    config := text_style(size, ink, FONT_MONO_BOLD, line_height, CLAY_TEXT_WRAP_NONE);
    config.userData = cast([*]void)SOURCE_LINK_MARKER.data;
    return config;
}

open_id :: (id: Clay_ElementId, declaration: Clay_ElementDeclaration) {
    Clay__OpenElementWithId(id);
    Clay__ConfigureOpenElement(declaration);
}

open_element :: (name: string, declaration: Clay_ElementDeclaration) {
    open_id(Clay_GetElementId(clay_string(name)), declaration);
}

open_indexed :: (
    name: string,
    index: s32,
    declaration: Clay_ElementDeclaration,
) {
    open_id(
        Clay_GetElementIdWithIndex(clay_string(name), cast(u32)index),
        declaration,
    );
}

close_element :: () { Clay__CloseElement(); }

finish_content_table :: () {
    if !content_table_open return;
    close_element();
    content_table_open = false;
}

wrap_long_words :: (value: string, columns: ssize) -> string {
    if columns < 8 columns = 8;
    if value.count <= columns return value;
    if frame_text_cursor + value.count * 2 > FRAME_TEXT_CAPACITY return value;
    start := frame_text_cursor;
    storage := cast([*]u8)&frame_text_storage;
    run: ssize = 0;
    for index: 0..value.count {
        byte := value[index];
        boundary := byte < 128 || byte >= 192;
        if byte == cast(u8)(#char " ") || byte == cast(u8)(#char "\n") || byte == cast(u8)(#char "\t") {
            run = 0;
        } else if boundary {
            if run >= columns {
                storage[frame_text_cursor] = cast(u8)(#char "\n");
                frame_text_cursor += 1;
                run = 0;
            }
            run += 1;
        }
        storage[frame_text_cursor] = byte;
        frame_text_cursor += 1;
    }
    return frame_string_from_raw_parts(storage + start, frame_text_cursor - start);
}

emit_text :: (value: string, style: Clay_TextElementConfig) {
    // Clay retains text pointers until Clay_EndLayout. Frame-local formatted
    // strings can otherwise be recycled while later elements are emitted.
    display := value;
    if style.wrapMode == CLAY_TEXT_WRAP_WORDS {
        // Clay wraps at whitespace only. Bound very long identifiers and
        // numeric literals as Rustdoc's overflow-wrap:anywhere does, while
        // preserving source and copy text in the non-wrapping code blocks.
        budget := article_content_width() - 40;
        columns := cast(ssize)(budget / (cast(f32)style.fontSize * 0.6));
        display = wrap_long_words(value, columns);
    }
    Clay__OpenTextElement(clay_string(frame_text_copy(display)), style);
}

column_box :: (gap: u16 = 0) -> Clay_ElementDeclaration {
    box: Clay_ElementDeclaration;
    box.layout.sizing.width = grow_axis();
    box.layout.sizing.height = fit_axis();
    box.layout.layoutDirection = CLAY_TOP_TO_BOTTOM;
    box.layout.childGap = gap;
    return box;
}

paragraph :: (index: s32, value: string) {
    finish_content_table();
    box := column_box();
    box.layout.padding = padding(0, 2);
    open_indexed("paragraph", index, box);
    emit_text(value, text_style(17, color(66, 65, 62), FONT_BODY, 27));
    close_element();
}

subheading :: (index: s32, value: string) {
    finish_content_table();
    box := column_box();
    box.layout.padding = padding(0, 6);
    box.border.color = color(216, 209, 197);
    box.border.width.bottom = 1;
    open_indexed("subheading", index, box);
    emit_text(value, heading_text_style());
    close_element();
}

code_block :: (index: s32, language: string, value: string) {
    finish_content_table();
    highlight := language == "glosso" || language == "glo";
    language_label := language;
    if highlight language_label = "GLOSSO";
    if language == "text" language_label = "TEXT";
    if language == "ebnf" language_label = "EBNF";

    box := column_box();
    box.backgroundColor = color(244, 241, 234);
    box.layout.sizing.width = fixed_axis(article_content_width());
    box.cornerRadius = radius(0);
    box.border.color = color(216, 209, 197);
    box.border.width.left = 1;
    box.border.width.right = 1;
    box.border.width.top = 1;
    box.border.width.bottom = 1;
    open_indexed("code", index, box);

    header: Clay_ElementDeclaration;
    header.layout.sizing.width = grow_axis();
    header.layout.sizing.height = fit_axis();
    header.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    header.layout.padding = padding(12, 6);
    header.border.color = color(216, 209, 197);
    open_indexed("code-header", index, header);

    language_box := column_box();
    language_box.layout.sizing.width = grow_axis();
    open_indexed("code-language", index, language_box);
    emit_text(language_label, text_style(10, color(36, 73, 216), FONT_MONO, 16));
    close_element();

    copy_box := column_box();
    copy_box.layout.sizing.width = fit_axis();
    open_indexed("code-copy", index, copy_box);
    // Trailing spaces reserve enough command width for the temporary
    // "Copied" confirmation without shifting the header layout.
    emit_text("Copy  ", code_copy_text_style());
    close_element();
    close_element();

    body := column_box();
    body.layout.padding = padding(12, 10);
    body.layout.sizing.width = fixed_axis(article_content_width());
    body.backgroundColor = color(244, 241, 234);
    body.userData = cast([*]void)"code-viewport".data;
    open_indexed("code-body", index, body);
    emit_text(value, code_body_text_style(highlight));
    close_element();
    close_element();
}

bullet :: (index: s32, value: string) {
    finish_content_table();
    row: Clay_ElementDeclaration;
    row.layout.sizing.width = grow_axis();
    row.layout.sizing.height = fit_axis();
    row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    row.layout.childGap = 10;
    row.layout.padding = padding(4, 2);
    open_indexed("bullet", index, row);
    emit_text("•", text_style(17, color(66, 65, 62), FONT_SANS, 27));
    emit_text(value, text_style(17, color(66, 65, 62), FONT_BODY, 27));
    close_element();
}

note :: (index: s32, value: string) {
    finish_content_table();
    box := column_box(8);
    box.layout.padding = padding(18, 16);
    box.backgroundColor = color(244, 241, 234);
    box.cornerRadius = radius(0);
    box.border.color = color(233, 104, 45);
    box.border.width.left = 3;
    open_indexed("note", index, box);
    emit_text("NOTE", text_style(10, color(36, 73, 216), FONT_MONO_BOLD, 16));
    emit_text(value, text_style(16, color(66, 65, 62), FONT_BODY, 26));
    close_element();
}

TABLE_HEADER_SEPARATOR :: "   —   ";
TABLE_ROW_SEPARATOR :: "   |   ";

content_table_column_width :: (columns: s32, column_index: s32) -> f32 {
    if columns == 2 && column_index == 0 return 224;
    if columns == 3 && column_index == 0 return 176;
    if columns == 3 && column_index == 2 return 168;
    return 0;
}

content_table_width :: () -> f32 {
    width := article_content_width();
    if width < 640 return 640;
    return width;
}

table_trim :: (value: string) -> string {
    start: ssize = 0;
    finish := value.count;
    while start < finish && (
        value[start] == cast(u8)(#char " ") || value[start] == cast(u8)(#char "\t") ||
        value[start] == cast(u8)(#char "\r") || value[start] == cast(u8)(#char "\n")
    ) start += 1;
    while finish > start && (
        value[finish - 1] == cast(u8)(#char " ") || value[finish - 1] == cast(u8)(#char "\t") ||
        value[finish - 1] == cast(u8)(#char "\r") || value[finish - 1] == cast(u8)(#char "\n")
    ) finish -= 1;
    return value[start..finish];
}

table_display_text :: (value: string, uppercase: bool) -> string {
    if frame_text_cursor + value.count > FRAME_TEXT_CAPACITY return "";
    start := frame_text_cursor;
    storage := cast([*]u8)&frame_text_storage;
    source: ssize = 0;
    while source < value.count {
        byte := value[source];
        // Table source uses Markdown-style backticks for inline code. The
        // cell's typography carries that distinction, so do not print them.
        if byte != cast(u8)(#char "`") {
            if uppercase && byte >= cast(u8)(#char "a") && byte <= cast(u8)(#char "z")
                byte = byte - 32;
            storage[frame_text_cursor] = byte;
            frame_text_cursor += 1;
        }
        source += 1;
    }
    return frame_string_from_raw_parts(
        storage + start,
        frame_text_cursor - start,
    );
}

table_text_index_from :: (
    value: string,
    needle: string,
    start: ssize = 0,
) -> ssize {
    if needle.count == 0 return 0;
    i := start;
    if i < 0 i = 0;
    last := value.count - needle.count;
    while i <= last {
        j: ssize = 0;
        while j < needle.count && value[i + j] == needle[j] j += 1;
        if j == needle.count return i;
        i += 1;
    }
    return -1;
}

render_table_cell :: (
    row_index: s32,
    column_index: s32,
    columns: s32,
    value: string,
    header: bool,
) {
    cell := column_box();
    fixed_width := content_table_column_width(columns, column_index);
    if fixed_width > 0 {
        cell.layout.sizing.width = fixed_axis(fixed_width);
    } else {
        cell.layout.sizing.width = grow_axis(72);
    }
    if header cell.layout.padding = padding(8, 8);
    else cell.layout.padding = padding(8, 12);
    cell_name := "table-data-cell";
    if header cell_name = "table-header-cell";
    open_indexed(cell_name, row_index * 4 + column_index, cell);
    display := table_display_text(table_trim(value), header);
    if fixed_width > 0 display = wrap_long_words(display, cast(ssize)((fixed_width - 16) / 8));
    if header {
        emit_text(display, text_style(10, color(109, 107, 102), FONT_SANS_BOLD, 18));
    } else if table_text_index_from(value, "`") >= 0 {
        emit_text(display, text_style(13, color(23, 50, 158), FONT_MONO, 22));
    } else {
        emit_text(display, text_style(14, color(66, 65, 62), FONT_SANS, 22));
    }
    close_element();
}

render_table_cells :: (
    row_index: s32,
    value: string,
    separator: string,
    header: bool,
) {
    first := table_text_index_from(value, separator);
    columns: s32 = 1;
    second: ssize = -1;
    if first >= 0 {
        columns = 2;
        second = table_text_index_from(value, separator, first + separator.count);
        if second >= 0 columns = 3;
    }

    if columns == 1 {
        render_table_cell(row_index, 0, columns, value, header);
        return;
    }
    render_table_cell(row_index, 0, columns, value[0..first], header);
    if columns == 2 {
        render_table_cell(
            row_index, 1, columns,
            value[first + separator.count..value.count], header,
        );
        return;
    }
    render_table_cell(
        row_index, 1, columns,
        value[first + separator.count..second], header,
    );
    render_table_cell(
        row_index, 2, columns,
        value[second + separator.count..value.count], header,
    );
}

begin_content_table :: (index: s32) {
    table := column_box();
    table.layout.sizing.width = fixed_axis(article_content_width());
    table.layout.padding.bottom = 16;
    table.backgroundColor = color(255, 253, 248);
    table.userData = cast([*]void)"table-scroll".data;
    open_indexed("content-table", index, table);
    content_table_open = true;
}

table_header :: (index: s32, value: string) {
    finish_content_table();
    begin_content_table(index);
    row: Clay_ElementDeclaration;
    row.layout.sizing.width = grow_axis();
    row.layout.sizing.height = fit_axis();
    row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    row.border.color = color(216, 209, 197);
    row.border.width.bottom = 1;
    row.layout.sizing.width = fixed_axis(content_table_width());
    open_indexed("table-head", index, row);
    render_table_cells(index, value, TABLE_HEADER_SEPARATOR, true);
    close_element();
}

table_row :: (index: s32, value: string) {
    if !content_table_open begin_content_table(index);
    row: Clay_ElementDeclaration;
    row.layout.sizing.width = grow_axis();
    row.layout.sizing.height = fit_axis();
    row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    row.border.color = color(216, 209, 197);
    row.border.width.bottom = 1;
    row.layout.sizing.width = fixed_axis(content_table_width());
    open_indexed("table-row", index, row);
    render_table_cells(index, value, TABLE_ROW_SEPARATOR, false);
    close_element();
}

#import "Strings/Utf8";

}
