#import "Format";
#import "String_Builder";
#import "Math/Core";
#import "clay_ui.glo";

#public {

// Chapters 8-14: Tutorial II: Real Programs.

render_section_8 :: () {
    paragraph(
        0,
        #string,oneline
            \\Real programs ask questions that have no answer and run operations
            \\that fail: a setting is not in the configuration, a word is not a
            \\number, a file does not exist. Glosso has no exceptions and no
            \\special "not found" values like -1. A procedure that may have no
            \\answer returns an optional, `?T`, and a procedure that can fail
            \\returns a result, `E!T`, so the possibility is part of its type and
            \\the caller cannot overlook it. This chapter builds a small reader for
            \\settings written as `key=value` lines and makes it report every
            \\problem precisely.
    );
    subheading(1, "A value that may be missing");
    paragraph(
        2,
        #string,oneline
            \\The first procedure looks a key up and returns its value. A key may
            \\not be there, so the result type is `?str`: either a `str` or
            \\nothing.
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\
            \\// The value of `key` in text made of `key=value` lines, if it is there.
            \\find_setting :: (text: str, key: str) -> ?str {
            \\    lines := text.split("\n");
            \\    defer lines.free();
            \\    for line: lines {
            \\        if #pattern ?pair = line.split_once("=") {
            \\            if pair.before == key return pair.after;
            \\        }
            \\    }
            \\    return null;
            \\}
            \\
            \\main :: () {
            \\    settings := "width=80\nheight=24\ntitle=Report";
            \\    width := find_setting(settings, "width");
            \\    color := find_setting(settings, "color");
            \\    print("{} {}\n", width, color);
            \\    if find_setting(settings, "title") == {
            \\        case ?title; print("title: {}\n", title);
            \\        case null;   print("no title\n");
            \\    }
            \\    print("color: {}\n", color.unwrap_or("black"));
            \\    print("{} {}\n", width == null, color == null);
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\?80 null
            \\title: Report
            \\color: black
            \\false true
    );
    paragraph(
        5,
        #string,oneline
            \\An optional holds either `?value` or nothing, which is written `null`.
            \\Inside a procedure that returns `?str`, `return pair.after;` makes the
            \\`str` a present value, `?pair.after`, for you, and `return null;` says
            \\there is no answer. The standard library uses the same type:
            \\`split_once` returns `?String_Split` because the text may not contain
            \\`=` at all, and the `if #pattern` line runs its body only when there
            \\is a piece to look at. The value that comes back is a view into
            \\`settings`, so freeing the array of lines does not affect it.
    );
    paragraph(
        6,
        #string,oneline
            \\The caller decides what absence means. A switch with `case
            \\?title;` and `case null;` handles both cases and names the
            \\payload; `unwrap_or` substitutes a default; `x == null` asks only
            \\whether a value is there. What the caller cannot do is pretend the
            \\value is always present:
    );
    code_block(
        7,
        "text",
        #string
            \\// width: str = find_setting(settings, "width");
            \\error: got ?str, expected str
    );
    paragraph(
        8,
        #string,oneline
            \\The compiler refuses because `?str` and `str` are different types.
            \\There is no implicit unwrapping; every use of the payload goes
            \\through one of the forms above, so every "not there" case is handled
            \\somewhere you can see.
    );
    subheading(9, "Operations that can fail");
    paragraph(
        10,
        #string,oneline
            \\Reading a setting as a number can go wrong in two ways: the key is
            \\missing, or its value is not a number. The caller may want to treat
            \\them differently, and `?s64` cannot say which one happened. A result
            \\can. `Setting_Error!s64` is either `.Ok(n)` with an `s64`, or
            \\`.Err(e)` with a `Setting_Error`. The error type comes first and the
            \\success type after the `!`.
    );
    code_block(
        11,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\
            \\Setting_Error :: enum { Missing; Not_A_Number; }
            \\
            \\find_setting :: (text: str, key: str) -> ?str {
            \\    lines := text.split("\n");
            \\    defer lines.free();
            \\    for line: lines {
            \\        if #pattern ?pair = line.split_once("=") {
            \\            if pair.before == key return pair.after;
            \\        }
            \\    }
            \\    return null;
            \\}
            \\
            \\// The value of `key` as a whole number.
            \\number_setting :: (text: str, key: str) -> Setting_Error!s64 {
            \\    #pattern ?value := find_setting(text, key) else {
            \\        return .Err(.Missing);
            \\    };
            \\    #pattern ?n := from_string(s64, value) else {
            \\        return .Err(.Not_A_Number);
            \\    };
            \\    return .Ok(n);
            \\}
            \\
            \\main :: () {
            \\    settings := "width=80\nheight=24\ntitle=Report\ndepth=deep";
            \\    keys: [4]str = .["width", "color", "depth", "height"];
            \\    for key: keys {
            \\        if number_setting(settings, key) == {
            \\            case .Ok(n);  print("{} = {}\n", key, n);
            \\            case .Err(e); print("{}: {}\n", key, e);
            \\        }
            \\    }
            \\}
    );
    code_block(
        12,
        "text",
        #string
            \\width = 80
            \\color: Missing
            \\depth: Not_A_Number
            \\height = 24
    );
    paragraph(
        13,
        #string,oneline
            \\`from_string(s64, value)` is the prelude's text-to-number
            \\conversion, and it returns `?s64` because the text may not be a
            \\number. Each `#pattern ... else` line takes the payload out of an
            \\optional or leaves the procedure with the matching error. `.Err(.Missing)`
            \\and `.Ok(n)` build the two sides of the result; as with optionals, a
            \\plain `return n;` would also mean `.Ok(n)`. The caller switches on
            \\`.Ok` and `.Err` and must handle both, and an enum error prints as
            \\the name of its member.
    );
    subheading(14, "Passing errors on with `?`");
    paragraph(
        15,
        #string,oneline
            \\Most code that receives an error cannot do anything about it except
            \\hand it to its own caller. Writing a switch for every call would bury
            \\the logic, so Glosso has an operator for it. Postfix `?` on a result
            \\gives the success value, or, on failure, returns the error from the
            \\enclosing procedure at once:
    );
    code_block(
        16,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\
            \\Setting_Error :: enum { Missing; Not_A_Number; }
            \\
            \\find_setting :: (text: str, key: str) -> ?str {
            \\    lines := text.split("\n");
            \\    defer lines.free();
            \\    for line: lines {
            \\        if #pattern ?pair = line.split_once("=") {
            \\            if pair.before == key return pair.after;
            \\        }
            \\    }
            \\    return null;
            \\}
            \\
            \\number_setting :: (text: str, key: str) -> Setting_Error!s64 {
            \\    value := find_setting(text, key).ok_or(Setting_Error.Missing)?;
            \\    return from_string(s64, value).ok_or(Setting_Error.Not_A_Number)?;
            \\}
            \\
            \\// The area of the window the settings describe.
            \\area :: (text: str) -> Setting_Error!s64 {
            \\    width := number_setting(text, "width")?;
            \\    height := number_setting(text, "height")?;
            \\    return width * height;
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", area("width=80\nheight=24").unwrap_or(-1));
            \\    if area("width=80\nheight=tall") == {
            \\        case .Ok(a);  print("area {}\n", a);
            \\        case .Err(e); print("cannot compute the area: {}\n", e);
            \\    }
            \\}
    );
    code_block(
        17,
        "text",
        #string
            \\1920
            \\cannot compute the area: Not_A_Number
    );
    paragraph(
        18,
        #string,oneline
            \\`area` reads as if nothing could fail, yet a missing width stops it
            \\at the first line and a bad height at the second, each time with the
            \\error that `number_setting` produced. `number_setting` got shorter
            \\too: `ok_or(error)` turns an optional into a result, `.Ok` with the
            \\payload or `.Err` with the error you give it, and the `?` that follows
            \\passes that error on. Results have `unwrap_or` as optionals do.
    );
    paragraph(
        19,
        #string,oneline
            \\`?` only works where it has somewhere to send the failure. Two
            \\mistakes are common. Using it on an optional inside a procedure that
            \\returns a result fails, because an absent value carries no error to
            \\pass on; and using it in a procedure that returns neither, such as a
            \\`main` without a result type, has nowhere to return to:
    );
    code_block(
        20,
        "text",
        #string
            \\// value := find_setting(text, key)?;     in number_setting
            \\error: no overload '?' accepts these arguments
            \\note: constraint failed for ?
            \\// w := number_setting(settings, "width")?;     in main :: ()
            \\error: postfix '?' requires a Try-returning function or an enclosing #try block
    );
    paragraph(
        21,
        #string,oneline
            \\The first is fixed with `ok_or`, which supplies the error. On an
            \\optional, `?` does work inside a procedure that itself returns an
            \\optional: there it passes the `null` on. The second is fixed by
            \\handling the error with a switch or `unwrap_or`, or by letting `main`
            \\return a result, as the last section shows.
    );
    subheading(22, "Errors that carry details");
    paragraph(
        23,
        #string,oneline
            \\`Not_A_Number` does not say which setting was bad. An error type can
            \\be any type, so a tagged union can carry the key along with the kind
            \\of failure. The next version also decides that a missing depth is
            \\not an error at all, while every other failure still is:
    );
    code_block(
        24,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\
            \\// What went wrong, and with which setting.
            \\Setting_Error :: union #derive(Show) {
            \\    Missing: str;          // the key that was not found
            \\    Not_A_Number: str;     // the key whose value is not a number
            \\}
            \\
            \\find_setting :: (text: str, key: str) -> ?str {
            \\    lines := text.split("\n");
            \\    defer lines.free();
            \\    for line: lines {
            \\        if #pattern ?pair = line.split_once("=") {
            \\            if pair.before == key return pair.after;
            \\        }
            \\    }
            \\    return null;
            \\}
            \\
            \\number_setting :: (text: str, key: str) -> Setting_Error!s64 {
            \\    value := find_setting(text, key).ok_or(Setting_Error.Missing(key))?;
            \\    return from_string(s64, value).ok_or(Setting_Error.Not_A_Number(key))?;
            \\}
            \\
            \\// Like number_setting, but a missing setting has the value `fallback`.
            \\number_or :: (text: str, key: str, fallback: s64) -> Setting_Error!s64 {
            \\    if number_setting(text, key) == {
            \\        case .Ok(n);            return n;
            \\        case .Err(.Missing(_)); return fallback;
            \\        case .Err(e);           return .Err(e);
            \\    }
            \\}
            \\
            \\volume :: (text: str) -> Setting_Error!s64 {
            \\    width := number_setting(text, "width")?;
            \\    height := number_setting(text, "height")?;
            \\    depth := number_or(text, "depth", 1)?;
            \\    return width * height * depth;
            \\}
            \\
            \\main :: () {
            \\    inputs: [4]str = .[
            \\        "width=2\nheight=3\ndepth=4",
            \\        "width=2\nheight=3",
            \\        "width=2\ndepth=4",
            \\        "width=2\nheight=3\ndepth=x",
            \\    ];
            \\    for text: inputs {
            \\        if volume(text) == {
            \\            case .Ok(v);  print("volume {}\n", v);
            \\            case .Err(e); print("skipped: {}\n", e);
            \\        }
            \\    }
            \\}
    );
    code_block(
        25,
        "text",
        #string
            \\volume 24
            \\volume 6
            \\skipped: Missing(height)
            \\skipped: Not_A_Number(depth)
    );
    paragraph(
        26,
        #string,oneline
            \\`ok_or` is generic, so it cannot infer which union `.Missing(key)`
            \\belongs to; writing `Setting_Error.Missing(key)` names it.
            \\`#derive(Show)` lets the union be printed. In `number_or`, the
            \\pattern `.Err(.Missing(_))` matches only a missing key, whatever the
            \\key is, and turns it into the fallback; the last case passes every
            \\other error on unchanged. Handling the errors you can handle and
            \\passing on the rest is the usual shape of error code in Glosso.
    );
    subheading(27, "Letting `main` report the error");
    paragraph(
        28,
        #string,oneline
            \\At the top of the program, something has to tell the user. `main`
            \\may return `E!void` when the error type `E` implements the `Error`
            \\typeclass from the `Typeclass` module. Then `?` works in `main` too:
            \\an error that reaches it is reported on standard error and the
            \\program exits with status 1. The instance has one procedure,
            \\`report_error`, which writes the message:
    );
    code_block(
        29,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\#import "Format";
            \\#import "Typeclass";
            \\
            \\Setting_Error :: union #derive(Show) {
            \\    Missing: str;
            \\    Not_A_Number: str;
            \\}
            \\
            \\Setting_Error ::: instance Error {
            \\    report_error :: (error: Setting_Error) {
            \\        if error == {
            \\            case .Missing(key);
            \\                ("settings").error_report_line(tprint("'{}' is missing", key));
            \\            case .Not_A_Number(key);
            \\                ("settings").error_report_line(tprint("'{}' is not a number", key));
            \\        }
            \\    }
            \\}
            \\
            \\find_setting :: (text: str, key: str) -> ?str {
            \\    lines := text.split("\n");
            \\    defer lines.free();
            \\    for line: lines {
            \\        if #pattern ?pair = line.split_once("=") {
            \\            if pair.before == key return pair.after;
            \\        }
            \\    }
            \\    return null;
            \\}
            \\
            \\number_setting :: (text: str, key: str) -> Setting_Error!s64 {
            \\    value := find_setting(text, key).ok_or(Setting_Error.Missing(key))?;
            \\    return from_string(s64, value).ok_or(Setting_Error.Not_A_Number(key))?;
            \\}
            \\
            \\number_or :: (text: str, key: str, fallback: s64) -> Setting_Error!s64 {
            \\    if number_setting(text, key) == {
            \\        case .Ok(n);            return n;
            \\        case .Err(.Missing(_)); return fallback;
            \\        case .Err(e);           return .Err(e);
            \\    }
            \\}
            \\
            \\volume :: (text: str) -> Setting_Error!s64 {
            \\    width := number_setting(text, "width")?;
            \\    height := number_setting(text, "height")?;
            \\    depth := number_or(text, "depth", 1)?;
            \\    return width * height * depth;
            \\}
            \\
            \\main :: () -> Setting_Error!void {
            \\    print("box: {}\n", volume("width=2\nheight=3\ndepth=4")?);
            \\    print("sheet: {}\n", volume("width=2\nheight=3")?);
            \\    print("bad: {}\n", volume("width=2\nheight=3\ndepth=x")?);
            \\    print("not reached\n");
            \\    return .Ok;
            \\}
    );
    code_block(
        30,
        "text",
        #string
            \\$ ./volume; echo "status $?"
            \\box: 24
            \\sheet: 6
            \\settings: 'depth' is not a number
            \\status 1
    );
    paragraph(
        31,
        #string,oneline
            \\`category.error_report_line(message)` writes `category: message` and
            \\a newline to standard error. The third `?` in `main` received the
            \\error, so `main` returned it, the error reported itself, and the exit
            \\status became 1. Had every call succeeded, `return .Ok;` would have
            \\ended the program with status 0. In an `E!void` procedure a bare
            \\`return;` is an error, because it does not say which of the two it
            \\means; reaching the closing brace counts as `.Ok`.
    );
    paragraph(
        32,
        #string,oneline
            \\The standard library's error types already implement `Error`, so a
            \\`main` that returns `Fs_Error!void`, the error type of the
            \\`File_System` modules, can use `?` on file operations without writing
            \\an instance; the project in Project: A Word-Frequency Counter does
            \\this. Without an instance, `main` is rejected where it is declared:
    );
    code_block(
        33,
        "text",
        #string
            \\// main :: () -> Setting_Error!void {...}     with no Error instance
            \\error: main return type Setting_Error!void does not implement Termination
    );
    subheading(34, "Choosing the right tool");
    bullet(
        35,
        #string,oneline
            \\Return `?T` when "no answer" is an ordinary outcome that needs no
            \\explanation: a search that finds nothing, a lookup of an absent key.
    );
    bullet(
        36,
        #string,oneline
            \\Return `E!T` when the caller may need to know why the operation did
            \\not succeed. Give the error type one member per failure the caller
            \\could act on, with the details it needs.
    );
    bullet(
        37,
        #string,oneline
            \\Handle an error where you can do something sensible about it, such as
            \\substituting a default; pass the rest on with `?`.
    );
    bullet(
        38,
        #string,oneline
            \\Report errors once, at the top: in `main`, either through an `Error`
            \\instance or with a switch that prints a message and decides how to
            \\continue.
    );
    subheading(39, "Where to go next");
    bullet(
        40,
        #string,oneline
            \\`?T` and `E!T`: every way to build and read optionals and results,
            \\and the full table of helpers such as `map`, `and_then` and
            \\`map_error`.
    );
    bullet(
        41,
        #string,oneline
            \\`Try`, `?`, `#try`, and `Termination`: how `?` works, `#try` blocks,
            \\error unions that convert with `#from`, and exit statuses.
    );
    bullet(
        42,
        #string,oneline
            \\Tagged and Untagged Unions and `#pattern` Matching and Pattern Forms:
            \\the union and pattern rules used above.
    );
}

render_section_9 :: () {
    paragraph(
        0,
        #string,oneline
            \\Glosso releases nothing behind your back. There is no garbage
            \\collector and there are no destructors: memory that a value holds
            \\stays allocated until your code gives it back. A value that holds
            \\something to give back is called an owner, and the whole discipline
            \\fits in one sentence: release every owner exactly once, after its last
            \\use. This chapter shows where memory comes from, how to release it,
            \\the mistakes that break the rule, and how to let the compiler's debug
            \\allocator check your work.
    );
    subheading(1, "Where memory comes from");
    paragraph(
        2,
        #string,oneline
            \\Numbers, structs of numbers, fixed arrays and views live in
            \\variables and need nothing. Memory from the heap comes from
            \\operations that build something of a size not known in advance: a
            \\`push` that grows a `[..]T`, `format`, `split` (for the array of
            \\pieces), `to_lower` and `clone` on strings, and writes to a
            \\`String_Builder`. String literals and views into existing text
            \\allocate nothing. This program allocates and never gives anything
            \\back:
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\
            \\// Builds `count` labels: "item-0", "item-1", ...
            \\make_labels :: (count: s64) -> [..]str {
            \\    out: [..]str;
            \\    for i: 0..count out.push(format("item-{}", i));
            \\    return out;
            \\}
            \\
            \\main :: () {
            \\    labels := make_labels(3);
            \\    for label: labels print("{}\n", label);
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\item-0
            \\item-1
            \\item-2
    );
    paragraph(
        5,
        #string,oneline
            \\The output is right, and for a program this short the operating
            \\system reclaims everything at exit anyway. In a program that runs for
            \\hours, or calls `make_labels` in a loop, the memory would pile up.
            \\Setting the environment variable `GLOSSO_DEBUG_ALLOCATOR=1` while
            \\compiling builds the program with the debug allocator, which records
            \\every allocation and reports what is still live when the program
            \\ends. (The `grep` drops the compiler's own lines and the trace lines
            \\inside the standard library.)
    );
    code_block(
        6,
        "text",
        #string
            \\$ GLOSSO_DEBUG_ALLOCATOR=1 glosso compile --run labels.glo 2>&1 | grep -v -e '^glosso:' -e 'std/'
            \\item-0
            \\item-1
            \\item-2
            \\glosso debug allocator: leaked 4 allocation(s), 152 byte(s)
            \\  leak: 8 byte(s)
            \\    allocated at:
            \\      labels.glo:7:30
            \\      labels.glo:12:15
            \\  leak: 8 byte(s)
            \\    allocated at:
            \\      labels.glo:7:30
            \\      labels.glo:12:15
            \\  leak: 128 byte(s)
            \\    allocated at:
            \\      labels.glo:7:21
            \\      labels.glo:12:15
            \\  leak: 8 byte(s)
            \\    allocated at:
            \\      labels.glo:7:30
            \\      labels.glo:12:15
    );
    paragraph(
        7,
        #string,oneline
            \\Each leak comes with the calls that made it, innermost first. Three
            \\are the strings from `format` (line 7, column 30), one is the array's
            \\buffer from `push` (column 21), and all four happened during the
            \\call of `make_labels` on line 12.
    );
    subheading(8, "Releasing with `free` and `defer`");
    paragraph(
        9,
        #string,oneline
            \\A `[..]T` is an owner: `free` releases its buffer. A `str` is never
            \\an owner, even when its bytes were allocated, because most strings
            \\are views into memory someone else owns. Freeing the array therefore
            \\does not free the strings in it; strings that your code allocated
            \\are released one by one with their own `free` first:
    );
    code_block(
        10,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\
            \\// Builds `count` labels: "item-0", "item-1", ...
            \\// The caller owns the array and every string in it.
            \\make_labels :: (count: s64) -> [..]str {
            \\    out: [..]str;
            \\    for i: 0..count out.push(format("item-{}", i));
            \\    return out;
            \\}
            \\
            \\main :: () {
            \\    labels := make_labels(3);
            \\    defer {
            \\        for label: labels label.free();     // each string from format
            \\        labels.free();                      // then the array's own buffer
            \\    }
            \\    for label: labels print("{}\n", label);
            \\}
    );
    code_block(
        11,
        "text",
        #string
            \\item-0
            \\item-1
            \\item-2
    );
    paragraph(
        12,
        #string,oneline
            \\Built with the debug allocator, this version prints no report: a
            \\silent debug allocator means nothing leaked. The release is written
            \\with `defer` directly after the owner is created, so it runs when
            \\`main` ends, by whatever path, and the code that uses the labels sits
            \\between the two without having to remember them. The comment on
            \\`make_labels` says who owns the result; Glosso has no other way to
            \\record it, so that comment is part of the procedure's contract.
    );
    paragraph(
        13,
        #string,oneline
            \\`x.free()` can also be written `free(&x)`: `free` receives the
            \\owner's address, and a method call takes that address itself. `free`
            \\exists only for owners. Calling it on a value that holds nothing to
            \\release is a compile-time error, so you cannot write a release that
            \\does nothing by mistake:
    );
    code_block(
        14,
        "text",
        #string
            \\// p: Point;  p.free();     with Point :: struct { x: s64; y: s64; }
            \\error: no typeclass method 'free' accepts this receiver and these arguments
            \\note: got Point, expected *Arena
    );
    subheading(15, "Structs that own memory");
    paragraph(
        16,
        #string,oneline
            \\A struct with an owner among its fields is an owner too, and its
            \\`free` releases those fields. The rest of the chapter grows a small
            \\program that keeps teams of people:
    );
    code_block(
        17,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Team :: struct {
            \\    name: str;
            \\    members: [..]str;
            \\}
            \\
            \\// Changes the team, so it takes a pointer to it.
            \\add_member :: (team: *Team, member: str) {
            \\    team.members.push(member);
            \\}
            \\
            \\main :: () {
            \\    team: Team = .{ .name = "red" };
            \\    defer team.free();                 // releases `members`; `name` owns nothing
            \\    add_member(&team, "ana");
            \\    add_member(&team, "ben");
            \\    print("{}: {} members\n", team.name, team.members.count);
            \\
            \\    other := team;                     // copies the struct, not the members
            \\    other.members[0] = "zoe";
            \\    print("{} {}\n", team.members[0], other.members.data == team.members.data);
            \\}
    );
    code_block(
        18,
        "text",
        #string
            \\red: 2 members
            \\zoe true
    );
    paragraph(
        19,
        #string,oneline
            \\The second half shows the most important fact about owners.
            \\Assignment copies a value's bytes, as in C. For a `[..]str` those
            \\bytes are a count, a capacity and a pointer to the buffer, so
            \\`other` and `team` describe the same buffer: a change through
            \\one is visible through the other. Glosso does not copy what an owner
            \\owns, and it does not track which copy is responsible for it. That is
            \\up to the program, and exactly one copy may be released:
    );
    code_block(
        20,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Team :: struct {
            \\    name: str;
            \\    members: [..]str;
            \\}
            \\
            \\main :: () {
            \\    team: Team = .{ .name = "red" };
            \\    defer team.free();
            \\    team.members.push("ana", "ben");
            \\    other := team;
            \\    defer other.free();                // wrong: a second release of the same buffer
            \\    print("{} members\n", other.members.count);
            \\}
    );
    code_block(
        21,
        "text",
        #string
            \\$ glosso compile --run twice.glo 2>&1 | tail -2
            \\free(): double free detected in tcache 2
            \\glosso: program exited with status 134
            \\$ GLOSSO_DEBUG_ALLOCATOR=1 glosso compile --run twice.glo 2>&1 | grep -v '^glosso:'
            \\2 members
            \\glosso debug allocator: double free
            \\    allocated at:
            \\      twice.glo:11:5
            \\    first free at:
            \\      twice.glo:13:11
            \\    second free at:
            \\      twice.glo:10:11
            \\glosso debug allocator: 1 allocator error(s)
    );
    paragraph(
        22,
        #string,oneline
            \\Here the C library happened to notice and stopped the program; with a
            \\different allocation pattern it might not have, and the program would
            \\go on with a corrupted heap. The debug allocator names the allocation
            \\and both releases. Deferred releases run in reverse order, so
            \\`other.free()` on line 13 came first.
    );
    paragraph(
        23,
        #string,oneline
            \\The same sharing explains why `add_member` takes `*Team`. A procedure
            \\that receives an owner by value receives a copy of its descriptor, and
            \\a `push` that has to grow the buffer moves it, releases the old one,
            \\and records the new address only in the copy:
    );
    code_block(
        24,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\// wrong: grows a copy of the caller's array
            \\add_score :: (scores: [..]s64, score: s64) {
            \\    scores.push(score);
            \\}
            \\
            \\main :: () {
            \\    scores: [..]s64;
            \\    defer scores.free();
            \\    for i: 0..8 scores.push(i);        // full: the next push moves the buffer
            \\    add_score(scores, 100);
            \\    print("{} scores\n", scores.count);
            \\}
    );
    code_block(
        25,
        "text",
        #string
            \\$ GLOSSO_DEBUG_ALLOCATOR=1 glosso compile --run scores.glo 2>&1 | grep 'debug allocator'
            \\glosso debug allocator: double free
            \\glosso debug allocator: leaked 1 allocation(s), 128 byte(s)
            \\glosso debug allocator: 1 allocator error(s)
    );
    paragraph(
        26,
        #string,oneline
            \\`main` still holds the old address, releases it a second time, and
            \\the new buffer leaks. With `scores: *[..]s64` and `add_score(&scores,
            \\100)` all of it goes away. A procedure that only reads an owner can
            \\take a view or a `*const` pointer; one that changes it takes a
            \\pointer.
    );
    subheading(27, "Teaching a type to free itself");
    paragraph(
        28,
        #string,oneline
            \\The next version names each team with `format`, so the name is
            \\allocated too. The automatic release of a struct only covers fields
            \\that are owners, and `str` is not one, so `Team` gets its own
            \\`Freeable` instance. The version also adds `load_team`, which builds
            \\a team from a comma-separated list and gives up when a name is empty.
            \\It contains a mistake:
    );
    code_block(
        29,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\#import "Strings";
            \\
            \\Team :: struct {
            \\    name: str;              // made by format, so the team must free it
            \\    members: [..]str;
            \\}
            \\
            \\Team ::: instance Freeable {
            \\    free :: (x: *Team) {
            \\        defer free_fields(x);          // afterwards, the owner fields: `members`
            \\        x.name.free();
            \\    }
            \\}
            \\
            \\// A team from a comma-separated list of names, or null if a name is empty.
            \\load_team :: (number: s64, list: str) -> ?Team {
            \\    team: Team = .{ .name = format("team-{}", number) };
            \\    defer team.free();                 // releases a half-built team on failure
            \\    names := list.split(",");
            \\    defer names.free();
            \\    for name: names {
            \\        if name.count == 0 return null;
            \\        team.members.push(name);
            \\    }
            \\    return team;                       // wrong: the defer releases what is returned
            \\}
            \\
            \\main :: () {
            \\    #pattern ?team := load_team(1, "ana,ben,cy") else { return; };
            \\    defer team.free();
            \\    print("{}: {}\n", team.name, team.members.count);
            \\}
    );
    code_block(
        30,
        "text",
        #string
            \\$ GLOSSO_DEBUG_ALLOCATOR=1 glosso compile --run team.glo 2>&1 | grep 'debug allocator' | uniq -c
            \\      6 glosso debug allocator: use after free
            \\      2 glosso debug allocator: double free
            \\      1 glosso debug allocator: 8 allocator error(s)
    );
    paragraph(
        31,
        #string,oneline
            \\The instance first: `Freeable` is the typeclass behind every `free`,
            \\and an instance for `Team` replaces the automatic release with its own
            \\body. Like every `free`, it receives the owner's address, `x: *Team`,
            \\and reaches the fields through it. It frees the name and then,
            \\through `defer free_fields(x)`, runs the automatic release of the
            \\owner fields, here `members`. Without that line the members' buffer
            \\would leak.
    );
    paragraph(
        32,
        #string,oneline
            \\The mistake is in `load_team`. The deferred `team.free()` is right
            \\for the failure path, where a half-built team must not leak. But a
            \\deferred statement runs on every way out of the procedure, including
            \\`return team;`, so the caller receives a team whose name and members
            \\have already been released. `main` then reads them and releases them
            \\a second time.
    );
    subheading(33, "Handing an owner over with `value_take`");
    paragraph(
        34,
        #string,oneline
            \\`value_take(&x)` from the `Memory/Ownership` module returns the value
            \\of `x` and leaves `x` holding its default value, which owns nothing.
            \\Returning `value_take(&team)` gives the caller the only copy that
            \\holds the memory, and the deferred `free` releases an empty team. The
            \\same move is needed for `String_Builder.into_string`, which turns a
            \\builder's buffer into a `str`: it takes the builder by value, so a
            \\builder with a deferred `free` is handed over with
            \\`value_take(&b).into_string()`. The finished program:
    );
    code_block(
        35,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\#import "Strings";
            \\#import "String_Builder";
            \\#import "Memory/Ownership";
            \\
            \\Team :: struct {
            \\    name: str;              // made by format, so the team must free it
            \\    members: [..]str;
            \\}
            \\
            \\Team ::: instance Freeable {
            \\    free :: (x: *Team) {
            \\        defer free_fields(x);          // afterwards, the owner fields: `members`
            \\        x.name.free();
            \\    }
            \\}
            \\
            \\// A team from a comma-separated list of names, or null if a name is empty.
            \\load_team :: (number: s64, list: str) -> ?Team {
            \\    team: Team = .{ .name = format("team-{}", number) };
            \\    defer team.free();                 // releases a half-built team on failure
            \\    names := list.split(",");
            \\    defer names.free();
            \\    for name: names {
            \\        if name.count == 0 return null;
            \\        team.members.push(name);
            \\    }
            \\    return value_take(&team);          // hand the team over; the defer frees an empty one
            \\}
            \\
            \\// "ana, ben and cy". The caller frees the result.
            \\roster :: (team: *const Team) -> str {
            \\    b: String_Builder;
            \\    defer b.free();
            \\    for member, i: team.members {
            \\        if i > 0 && i == team.members.count - 1 b.write_string(" and ");
            \\        else if i > 0 b.write_string(", ");
            \\        b.write_string(member);
            \\    }
            \\    return value_take(&b).into_string();
            \\}
            \\
            \\main :: () {
            \\    lists: [3]str = .["ana,ben,cy", "dee,,eli", "fay,gus"];
            \\    for list, i: lists {
            \\        #pattern ?team := load_team(i + 1, list) else {
            \\            print("list {} has an empty name\n", i + 1);
            \\            continue;
            \\        };
            \\        defer team.free();
            \\        names := roster(&team);
            \\        defer names.free();
            \\        print("{}: {}\n", team.name, names);
            \\    }
            \\}
    );
    code_block(
        36,
        "text",
        #string
            \\team-1: ana, ben and cy
            \\list 2 has an empty name
            \\team-3: fay and gus
    );
    paragraph(
        37,
        #string,oneline
            \\Follow one team through it. `load_team` creates it and owns it until
            \\`value_take` hands it to `main`, which releases it with the `defer`
            \\in the loop body; such a `defer` runs at the end of each iteration.
            \\For the second list, `load_team` returns `null` and its own `defer`
            \\releases the half-built team. The member names are pieces of the
            \\list literals, which live as long as the program, so nothing frees
            \\them, and `names.free()` in `load_team` releases only the array of
            \\pieces. Built with `GLOSSO_DEBUG_ALLOCATOR=1`, the program prints the
            \\same three lines and no report.
    );
    subheading(38, "Short-lived text: the temporary allocator");
    paragraph(
        39,
        #string,oneline
            \\Much text is needed only for a moment: a line to print, a message to
            \\pass on. Freeing each one is tedious, so the runtime has a second
            \\allocator for such values. `tprint` is `format` that allocates from
            \\the temporary allocator, an arena that hands out memory by advancing
            \\an offset and is reclaimed all at once when it is rewound.
            \\`reset_temporary_storage()` from the `Context` module rewinds it to
            \\the start, and a natural place for it is the end of each round of a
            \\program's main loop:
    );
    code_block(
        40,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\#import "Context";
            \\
            \\main :: () {
            \\    for round: 1..4 {
            \\        defer reset_temporary_storage();       // nothing temporary outlives a round
            \\        line := tprint("round {} of {}", round, 3);
            \\        print("{} ({} bytes)\n", line, line.count);
            \\    }
            \\}
    );
    code_block(
        41,
        "text",
        #string
            \\round 1 of 3 (12 bytes)
            \\round 2 of 3 (12 bytes)
            \\round 3 of 3 (12 bytes)
    );
    paragraph(
        42,
        #string,oneline
            \\A value from `tprint` is never freed: it is not yours. Freeing it
            \\hands an address to the heap allocator that the heap never gave out:
    );
    code_block(
        43,
        "text",
        #string
            \\// line := tprint("{} items", 3);  line.free();
            \\$ glosso compile --run tfree.glo 2>&1 | tail -2
            \\free(): invalid size
            \\glosso: program exited with status 134
            \\$ GLOSSO_DEBUG_ALLOCATOR=1 glosso compile --run tfree.glo 2>&1 | grep 'debug allocator'
            \\glosso debug allocator: invalid free
            \\glosso debug allocator: 1 allocator error(s)
    );
    paragraph(
        44,
        #string,oneline
            \\The opposite mistake is keeping a temporary value past the rewind
            \\that reclaims it. A temporary string that must live longer is copied
            \\with `clone()`, and the copy is an ordinary allocation that you free.
    );
    subheading(45, "Rules of thumb");
    bullet(
        46,
        #string,oneline
            \\Write the `defer x.free();` on the line after the owner is created.
    );
    bullet(
        47,
        #string,oneline
            \\Release exactly one copy of each owner. Pass owners to procedures as
            \\`*T` or views, and take a pointer whenever the procedure changes them.
    );
    bullet(
        48,
        #string,oneline
            \\When an owner leaves a procedure, by `return` or by being stored
            \\somewhere, take it out of its variable with `value_take`.
    );
    bullet(
        49,
        #string,oneline
            \\Strings from `format`, `clone` or `to_lower` are freed with their
            \\own `free`; strings from `tprint` and pieces of other strings are not.
    );
    bullet(
        50,
        #string,oneline
            \\Say in a comment who owns what a procedure returns, and run your
            \\tests with `GLOSSO_DEBUG_ALLOCATOR=1` from time to time.
    );
    subheading(51, "Where to go next");
    bullet(
        52,
        #string,oneline
            \\`Freeable`, Copies, and Ownership Transfer: the release rules in
            \\full, `reset` and `clear`, and every transfer operation.
    );
    bullet(
        53,
        #string,oneline
            \\`Allocator` and Allocation Procedures: allocators as values and the
            \\complete list of debug allocator reports.
    );
    bullet(
        54,
        #string,oneline
            \\The Temporary Allocator: `#temp_scope`, marks, and what lives in the
            \\arena.
    );
    bullet(
        55,
        #string,oneline
            \\Container Buffers, Arenas, and Pools, Deferred Statements, and Files,
            \\Handles, and Non-Memory Resources for buffers that move, `defer` in
            \\detail, and resources other than memory.
    );
}

render_section_10 :: () {
    paragraph(
        0,
        #string,oneline
            \\Many procedures do the same thing whatever the type of their data:
            \\finding the largest element works the same for numbers and for
            \\strings. Glosso writes such code once as a generic procedure, and
            \\describes what the code needs from a type with a typeclass: a named
            \\set of operations that a type provides through an instance. Operators
            \\like `+` and `<` are typeclass members too, so the same mechanism lets
            \\your own types use them. This chapter builds the pieces of a shop's
            \\receipt.
    );
    subheading(1, "One procedure for many types");
    code_block(
        2,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\// The largest element of a non-empty view.
            \\largest :: (values: []$T) -> T where PartialOrd(T, T) {
            \\    best := values[0];
            \\    for value: values {
            \\        if value > best best = value;
            \\    }
            \\    return best;
            \\}
            \\
            \\main :: () {
            \\    counts: [4]s64 = .[3, 17, 8, 12];
            \\    weights: [3]f64 = .[1.5, 0.25, 2.75];
            \\    names: [3]str = .["pear", "apple", "plum"];
            \\    print("{}\n", largest(counts[..]));
            \\    print("{}\n", largest(weights[..]));
            \\    print("{}\n", largest(names[..]));
            \\}
    );
    code_block(
        3,
        "text",
        #string
            \\17
            \\2.75
            \\plum
    );
    paragraph(
        4,
        #string,oneline
            \\`$T` declares a type parameter. Each call infers it from the argument
            \\in that position: `[]s64` makes `T` be `s64`, and so on. After the
            \\`$`, the name is an ordinary type, so the result type and the
            \\variable `best` are written with a plain `T`. The compiler makes one
            \\copy of `largest` for each type it is called with, each as fast as a
            \\hand-written version for that type.
    );
    paragraph(
        5,
        #string,oneline
            \\The `where` clause states what the body needs: `PartialOrd(T, T)`
            \\holds when two values of `T` can be compared with `<`, `>` and the
            \\other comparisons, because `PartialOrd` is the typeclass that defines
            \\those operators. Leave the clause out and the compiler warns, at the
            \\declaration, that the body uses an operator nothing promised:
    );
    code_block(
        6,
        "text",
        #string
            \\// largest :: (values: []$T) -> T { ... }     without the where clause
            \\warning: no '>' for <T>: the where-clause only provides nothing
            \\note: reported at the definition; add the class to the 'where' clause
    );
    paragraph(
        7,
        #string,oneline
            \\With the clause, a call with a type that cannot be compared is
            \\rejected at the call, in terms of the procedure's interface, instead
            \\of somewhere inside its body:
    );
    code_block(
        8,
        "text",
        #string
            \\// points: [2]Point = ...;  largest(points[..])     with Point :: struct { x: s64; y: s64; }
            \\error: constraint failed for largest
    );
    subheading(9, "Your own type with operators");
    paragraph(
        10,
        #string,oneline
            \\Prices on a receipt should not be floating-point numbers, which
            \\cannot represent 0.10 exactly. A `Money` type that counts whole cents
            \\avoids that, and with a few instances it behaves like a number:
    );
    code_block(
        11,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\// An amount of money, kept in whole cents so that sums are exact.
            \\Money :: struct #derive(PartialEq) { cents: s64; }
            \\
            \\(Money, Money) ::: instance Add {
            \\    Output :: Money;
            \\    '+' :: (a: Money, b: Money) -> Money { return .{ a.cents + b.cents }; }
            \\}
            \\
            \\(Money, s64) ::: instance Mul {
            \\    Output :: Money;
            \\    '*' :: (a: Money, n: s64) -> Money { return .{ a.cents * n }; }
            \\}
            \\
            \\(Money, Money) ::: instance PartialOrd {
            \\    '<=>' :: (a: Money, b: Money) -> Ordering { return a.cents <=> b.cents; }
            \\}
            \\
            \\// Prints 1250 cents as 12.50.
            \\Money ::: instance Show {
            \\    show :: (value: *const Money, out: *$W) -> Io_Error!void where Writer(W) {
            \\        cents := value.cents % 100;
            \\        if cents < 10 out.write_format("{}.0{}", value.cents / 100, cents)?;
            \\        else out.write_format("{}.{}", value.cents / 100, cents)?;
            \\        return .Ok;
            \\    }
            \\}
            \\
            \\largest :: (values: []$T) -> T where PartialOrd(T, T) {
            \\    best := values[0];
            \\    for value: values {
            \\        if value > best best = value;
            \\    }
            \\    return best;
            \\}
            \\
            \\// Adds up a view of anything that has `+`.
            \\total :: (values: []$T) -> T where Add(T, T) {
            \\    sum: T;
            \\    for value: values sum = sum + value;
            \\    return sum;
            \\}
            \\
            \\main :: () {
            \\    tea := Money.{ 450 };
            \\    cake := Money.{ 325 };
            \\    prices: [3]Money = .[tea, cake, tea * 2];
            \\    print("{} {} {}\n", tea + cake, largest(prices[..]), total(prices[..]));
            \\    print("{} {}\n", tea == Money.{ 450 }, cake < tea);
            \\    counts: [3]s64 = .[1, 2, 3];
            \\    print("{}\n", total(counts[..]));
            \\    print("{}\n", Money.{ 5 });
            \\}
    );
    code_block(
        12,
        "text",
        #string
            \\7.75 9.00 16.75
            \\true true
            \\6
            \\0.05
    );
    paragraph(
        13,
        #string,oneline
            \\An operator instance names the operand types in its head:
            \\`(Money, Money) ::: instance Add` is `+` with a `Money` on each side,
            \\and `(Money, s64) ::: instance Mul` is `*` with a number on the right,
            \\which is what `tea * 2` uses. The member is the operator's spelling
            \\in single quotes, and `Output` is the type of the result. For
            \\comparisons you write only `<=>`, which returns an `Ordering`
            \\(`.Less`, `.Equal` or `.Greater`), and `PartialOrd` derives `<`, `<=`,
            \\`>` and `>=` from it. `#derive(PartialEq)` on the struct writes `==`
            \\and `!=` for you, comparing field by field.
    );
    paragraph(
        14,
        #string,oneline
            \\`Show` is the typeclass that `{}` in `print` and `format` uses. Its
            \\`show` receives the value by pointer and a destination `out` of any
            \\type `W` that is a `Writer`, so the same instance serves `print`,
            \\`format` and files; `write_format` formats into it, and `?` passes on
            \\a failed write. A `Show` instance has to be declared in the same
            \\module as its type.
    );
    paragraph(
        15,
        #string,oneline
            \\The point of all this shows in the last lines of `main`. `largest`
            \\and `total` were written without knowing about `Money`, yet they
            \\accept it, because `Money` satisfies their `where` clauses.
            \\`total` also works on plain numbers; `sum: T;` starts at the type's
            \\default value, zero cents or 0.
    );
    subheading(16, "Defining a typeclass");
    paragraph(
        17,
        #string,oneline
            \\The standard typeclasses describe operators and printing. Your own
            \\describe what your program needs. A receipt lists items that have a
            \\label and a price, and books and fruit compute their price
            \\differently:
    );
    code_block(
        18,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Money :: struct #derive(PartialEq) { cents: s64; }
            \\
            \\(Money, Money) ::: instance Add {
            \\    Output :: Money;
            \\    '+' :: (a: Money, b: Money) -> Money { return .{ a.cents + b.cents }; }
            \\}
            \\
            \\Money ::: instance Show {
            \\    show :: (value: *const Money, out: *$W) -> Io_Error!void where Writer(W) {
            \\        cents := value.cents % 100;
            \\        if cents < 10 out.write_format("{}.0{}", value.cents / 100, cents)?;
            \\        else out.write_format("{}.{}", value.cents / 100, cents)?;
            \\        return .Ok;
            \\    }
            \\}
            \\
            \\// Anything that can appear on a receipt.
            \\Priced :: typeclass (T: type) {
            \\    label :: (item: T) -> str;
            \\    price :: (item: T) -> Money;
            \\}
            \\
            \\Book :: struct #derive(Show) { title: str; cost: Money; }
            \\Fruit :: struct #derive(Show) { name: str; grams: s64; per_kilo: Money; }
            \\
            \\Book ::: instance Priced {
            \\    label :: (item: Book) -> str { return item.title; }
            \\    price :: (item: Book) -> Money { return item.cost; }
            \\}
            \\
            \\Fruit ::: instance Priced {
            \\    label :: (item: Fruit) -> str { return item.name; }
            \\    price :: (item: Fruit) -> Money { return .{ item.per_kilo.cents * item.grams / 1000 }; }
            \\}
            \\
            \\// One line per item, then the total.
            \\receipt :: (items: []$T) -> Money where Priced(T) {
            \\    sum: Money;
            \\    for item: items {
            \\        print("  {}: {}\n", label(item), price(item));
            \\        sum = sum + item.price();
            \\    }
            \\    print("  total {}\n", sum);
            \\    return sum;
            \\}
            \\
            \\main :: () {
            \\    books: [2]Book = .[.{ "Dune", .{ 1299 } }, .{ "Emma", .{ 850 } }];
            \\    fruit: [2]Fruit = .[.{ "apples", 1500, .{ 320 } }, .{ "plums", 250, .{ 600 } }];
            \\    print("books\n");
            \\    a := receipt(books[..]);
            \\    print("fruit\n");
            \\    b := receipt(fruit[..]);
            \\    print("paid {}\n", a + b);
            \\    print("{}\n", books[0]);
            \\}
    );
    code_block(
        19,
        "text",
        #string
            \\books
            \\  Dune: 12.99
            \\  Emma: 8.50
            \\  total 21.49
            \\fruit
            \\  apples: 4.80
            \\  plums: 1.50
            \\  total 6.30
            \\paid 27.79
            \\{Dune, 12.99}
    );
    paragraph(
        20,
        #string,oneline
            \\`Priced :: typeclass (T: type)` declares a class with one type
            \\parameter and two members, written as signatures without bodies. Each
            \\instance fixes `T` and supplies the bodies. Inside `receipt`, the
            \\calls `label(item)` and `item.price()` (both call forms work) reach
            \\the instance for whatever `T` is, so the books' copy of `receipt`
            \\calls `Book`'s members and the fruit's copy calls `Fruit`'s. The last
            \\line prints a `Book` through its derived `Show`, which shows the
            \\fields in order and uses `Money`'s own instance for `cost`.
    );
    paragraph(
        21,
        #string,oneline
            \\The two usual mistakes are reported precisely. Passing a view of a
            \\type that has no instance fails the `where` clause at the call, as
            \\with `largest`, and an instance that leaves out a member is rejected
            \\at the instance:
    );
    code_block(
        22,
        "text",
        #string
            \\// nums: [2]s64 = .[1, 2];  receipt(nums[..])
            \\error: constraint failed for receipt
            \\// Fruit ::: instance Priced { label :: ... }     with no `price`
            \\error: instance 'Fruit :: Priced' does not satisfy the implicit minimal definition; missing price
    );
    paragraph(
        23,
        #string,oneline
            \\When the program also calls the missing member, as `receipt` does, an
            \\error saying that `price` "can reach the end of its body without
            \\returning a value" is printed before the instance error; the
            \\instance error is the one that names the cause. A view holds elements
            \\of one type, so books and fruit need separate calls. A receipt that mixes them would use a tagged union with one
            \\variant per kind of item, and give the union its own `Priced`
            \\instance that switches on the variant.
    );
    subheading(24, "Instances written for you: `#derive`");
    paragraph(
        25,
        #string,oneline
            \\Writing `Show` and `PartialEq` by hand is only needed when the
            \\default does not suit, as for `Money`'s decimal point.
            \\`#derive(...)` after `struct` or `union` asks the compiler to write
            \\the instances: `Show` prints a struct as its fields in braces and a
            \\union as its variant, and `PartialEq` compares field by field or
            \\variant and payload. Enums have both without asking.
    );
    code_block(
        26,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Size :: enum { Small; Large; }
            \\
            \\Order :: struct #derive(Show, PartialEq) {
            \\    item: str;
            \\    size: Size;
            \\    count: s64;
            \\}
            \\
            \\Status :: union #derive(Show, PartialEq) {
            \\    Waiting: void;
            \\    Shipped: str;          // the tracking code
            \\}
            \\
            \\main :: () {
            \\    a := Order.{ "tea", .Large, 2 };
            \\    b := Order.{ "tea", .Large, 2 };
            \\    print("{} {} {}\n", a, a == b, a == Order.{ "tea", .Small, 2 });
            \\    s: Status = .Shipped("ZX-41");
            \\    print("{} {} {}\n", s, s == Status.Waiting, Size.Small);
            \\}
    );
    code_block(
        27,
        "text",
        #string
            \\{tea, Large, 2} true false
            \\Shipped(ZX-41) false Small
    );
    paragraph(
        28,
        #string,oneline
            \\Not every typeclass can be derived. An order between values or a hash
            \\is a decision about your type, so `PartialOrd` and `Hash` are written
            \\by hand, as `Money`'s `<=>` was:
    );
    code_block(
        29,
        "text",
        #string
            \\// Order :: struct #derive(Show, PartialOrd) { ... }
            \\error: typeclass 'PartialOrd' does not declare a derive macro
    );
    subheading(30, "Generic types");
    paragraph(
        31,
        #string,oneline
            \\A struct can have type parameters too: a `$T` in a field's type makes
            \\the struct generic, and `Stack(str)` names the version for strings.
            \\The containers of the standard library are built this way, such as
            \\`HashMap(K, V)`, which the project in Project: A Word-Frequency
            \\Counter uses. Methods for every version go in a block whose head
            \\repeats the parameter, `Stack($T) ::: { ... }`:
    );
    code_block(
        32,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\// A last-in, first-out stack of any element type.
            \\Stack :: struct {
            \\    items: [..]$T;
            \\}
            \\
            \\Stack($T) ::: {
            \\    push :: (*#self, item: T) {
            \\        #self.items.push(item);
            \\    }
            \\
            \\    // The top item, removed; null when the stack is empty.
            \\    pop :: (*#self) -> ?T {
            \\        if #self.items.count == 0 return null;
            \\        return #self.items.pop();
            \\    }
            \\}
            \\
            \\main :: () {
            \\    words: Stack(str);
            \\    defer words.free();
            \\    words.push("first");
            \\    words.push("second");
            \\    numbers: Stack(f64);
            \\    defer numbers.free();
            \\    numbers.push(2.5);
            \\    print("{} {}\n", words.pop(), numbers.pop());
            \\    print("{} {}\n", words.pop(), words.pop());
            \\}
    );
    code_block(
        33,
        "text",
        #string
            \\?second ?2.5
            \\?first null
    );
    paragraph(
        34,
        #string,oneline
            \\A `Stack` holds a dynamic array, so it is an owner and is released
            \\with `free` like any struct that contains one (see Owning and Freeing
            \\Memory). `pop` returns an optional because an empty stack has nothing
            \\to give.
    );
    subheading(35, "Where to go next");
    bullet(
        36,
        #string,oneline
            \\Generic Procedures and `where` Clauses: how type parameters are
            \\inferred and everything a `where` clause can test.
    );
    bullet(
        37,
        #string,oneline
            \\Typeclass Declarations and Instances, and Instance Resolution and
            \\Negative Instances: default members, `#minimal`, generic instances,
            \\and how the compiler chooses one.
    );
    bullet(
        38,
        #string,oneline
            \\Operator Declarations, `PartialEq`, `PartialOrd`, and `Hash`, and
            \\`Show`, `Formatter`, `FromString`, and Format Strings for the standard
            \\classes used here.
    );
    bullet(
        39,
        #string,oneline
            \\`#derive` for the derivable classes and writing derive macros, and
            \\Struct Types for generic structs.
    );
}

render_section_11 :: () {
    paragraph(
        0,
        #string,oneline
            \\The programs so far fit in one file. Real programs grow, and parts of
            \\them are worth reusing in the next program. In Glosso every source
            \\file is a module: it decides which of its declarations other files
            \\may use, and it sees other files only through its imports. This
            \\chapter turns the `Money` type of Generic Code and Typeclasses into a
            \\small library, builds a second module on top of it, and shows the
            \\import forms that keep names apart.
    );
    subheading(1, "A module per file");
    paragraph(
        2,
        #string,oneline
            \\The library file holds the type, its instances, a parser for amounts
            \\such as `12.50`, and a helper that the parser uses:
    );
    code_block(
        3,
        "glosso",
        #string
            \\// money.glo
            \\// Amounts of money in whole cents.
            \\#import "Io";
            \\#import "Strings";
            \\
            \\#public {
            \\
            \\Money :: struct #derive(PartialEq) { cents: s64; }
            \\
            \\// "12.50" or "12" as money; null for anything else.
            \\parse :: (text: str) -> ?Money {
            \\    #pattern ?parts := text.split_once(".") else {
            \\        return Money.{ whole_number(text)? * 100 };
            \\    };
            \\    if parts.after.count != 2 return null;
            \\    return Money.{ whole_number(parts.before)? * 100 + whole_number(parts.after)? };
            \\}
            \\
            \\}
            \\
            \\(Money, Money) ::: instance Add {
            \\    Output :: Money;
            \\    '+' :: (a: Money, b: Money) -> Money { return .{ a.cents + b.cents }; }
            \\}
            \\
            \\(Money, Money) ::: instance PartialOrd {
            \\    '<=>' :: (a: Money, b: Money) -> Ordering { return a.cents <=> b.cents; }
            \\}
            \\
            \\Money ::: instance Show {
            \\    show :: (value: *const Money, out: *$W) -> Io_Error!void where Writer(W) {
            \\        cents := value.cents % 100;
            \\        if cents < 10 out.write_format("{}.0{}", value.cents / 100, cents)?;
            \\        else out.write_format("{}.{}", value.cents / 100, cents)?;
            \\        return .Ok;
            \\    }
            \\}
            \\
            \\// A non-empty string of digits as a number. Private: only this file uses it.
            \\whole_number :: (text: str) -> ?s64 {
            \\    if text.count == 0 return null;
            \\    for i: 0..text.count {
            \\        if text[i] < #char "0" || text[i] > #char "9" return null;
            \\    }
            \\    return from_string(s64, text);
            \\}
    );
    paragraph(
        4,
        #string,oneline
            \\Top-level declarations are private to their file unless they are
            \\marked `#public`, either one by one (`#public parse :: ...`) or, as
            \\here, by a `#public { ... }` group around several of them. `Money` and
            \\`parse` are the library's interface; `whole_number` is a detail that
            \\other files cannot see, so it can change without breaking them.
            \\Instances have no name and need no `#public`: they are available
            \\wherever the module is imported. `?` on the optionals from
            \\`whole_number` passes a `null` on, since `parse` itself returns an
            \\optional. A program uses the library by importing the file:
    );
    code_block(
        5,
        "glosso",
        #string
            \\// main.glo
            \\#import "Io";
            \\#import "money.glo";
            \\
            \\main :: () {
            \\    inputs: [4]str = .["12.50", "3", "4.5", "ten"];
            \\    total: Money;
            \\    for text: inputs {
            \\        if parse(text) == {
            \\            case ?amount;
            \\                print("{} -> {}\n", text, amount);
            \\                total = total + amount;
            \\            case null;
            \\                print("{} -> not an amount\n", text);
            \\        }
            \\    }
            \\    print("total {}\n", total);
            \\}
    );
    code_block(
        6,
        "text",
        #string
            \\12.50 -> 12.50
            \\3 -> 3.00
            \\4.5 -> not an amount
            \\ten -> not an amount
            \\total 15.50
    );
    paragraph(
        7,
        #string,oneline
            \\An import ending in `.glo` is a path, relative to the directory of
            \\the importing file; a name without `.glo`, like `"Io"`, is a module of
            \\the standard library or of a directory given with `--module-path`. You compile only the file with `main`, and the
            \\compiler follows the imports from there:
    );
    code_block(
        8,
        "text",
        #string
            \\$ ls
            \\main.glo  money.glo
            \\$ glosso compile --run main.glo
            \\glosso: compile main.glo (target=x86_64-pc-linux-gnu)
            \\glosso: link main (target=x86_64-pc-linux-gnu, -O1)
            \\glosso: done main  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
            \\12.50 -> 12.50
            \\3 -> 3.00
            \\4.5 -> not an amount
            \\ten -> not an amount
            \\total 15.50
    );
    subheading(9, "What stays private");
    paragraph(
        10,
        #string,oneline
            \\Using a private name from another file is an error that says why the
            \\name is out of reach:
    );
    code_block(
        11,
        "text",
        #string
            \\// print("{}\n", whole_number("42"));     in main.glo
            \\error: unknown function whole_number
            \\note: 'whole_number' is private to its defining source and module
    );
    paragraph(
        12,
        #string,oneline
            \\Methods follow the same rule, and this one surprises people who
            \\wrote all their methods in one file: methods in a `Money ::: { ...
            \\}` block are private to `money.glo` even though `Money` is public.
            \\Write the block as `Money ::: #public { ... }` to export all of its
            \\methods, or mark single methods `#public`:
    );
    code_block(
        13,
        "text",
        #string
            \\// Money ::: { dollars :: (#self) -> s64 { ... } }     in money.glo
            \\// m.dollars()     in main.glo
            \\error: 'dollars' is private to its defining source and module
            \\note: declared here
    );
    paragraph(
        14,
        #string,oneline
            \\Instances, on the other hand, belong to the module of their type.
            \\`{}` looks for a type's `Show` instance from the module that declares
            \\the type, so an instance written in the importing file instead is not
            \\found. The error is reported at the type's declaration and names
            \\`show_text`, a member of `Show`:
    );
    code_block(
        15,
        "text",
        #string
            \\// #public Tag :: struct { id: s64; }     in plain.glo
            \\// Tag ::: instance Show { ... }          in main.glo, which imports plain.glo
            \\error: no overload 'show_text' accepts these arguments
            \\  --> plain.glo:1:1
    );
    paragraph(
        16,
        #string,oneline
            \\Put a `Show`, `Freeable` or operator instance next to its type, as
            \\`money.glo` does.
    );
    subheading(17, "A module built on another");
    paragraph(
        18,
        #string,oneline
            \\A shop's catalog reads items from lines such as `tea=4.50`. Its
            \\parser is naturally called `parse` too, and it needs `money.glo`'s
            \\`parse` for the price. Two procedures with the same name and the same
            \\parameter types would clash, so the catalog imports the money module
            \\under a name of its own:
    );
    code_block(
        19,
        "glosso",
        #string
            \\// catalog.glo
            \\// Items for sale, read from "name=price" lines.
            \\#import "Strings";
            \\Cash :: #import "money.glo";
            \\
            \\#public {
            \\
            \\Item :: struct #derive(Show) {
            \\    name: str;
            \\    price: Cash.Money;
            \\}
            \\
            \\// "tea=4.50" as an item; null when the line is not of that form.
            \\parse :: (line: str) -> ?Item {
            \\    #pattern ?parts := line.split_once("=") else { return null; };
            \\    price := Cash.parse(parts.after)?;
            \\    return Item.{ parts.before, price };
            \\}
            \\
            \\}
    );
    paragraph(
        20,
        #string,oneline
            \\`Cash :: #import "money.glo";` is a namespace import: it loads the
            \\module but brings none of its names into scope directly. They are
            \\written with the prefix instead, `Cash.Money` and `Cash.parse`, so
            \\inside `catalog.glo` the plain name `parse` means the catalog's own
            \\procedure. The instances of `money.glo` still apply, so `#derive(Show)`
            \\on `Item` finds `Money`'s `Show`.
    );
    paragraph(
        21,
        #string,oneline
            \\The shop program imports the catalog. It also needs the `Money` type
            \\for its total, and that is where the next rule comes in.
    );
    code_block(
        22,
        "glosso",
        #string
            \\// shop.glo
            \\#import "Io";
            \\#import "catalog.glo";
            \\#import "money.glo" { Money };
            \\
            \\main :: () {
            \\    lines: [4]str = .["tea=4.50", "cake=3.25", "jam", "bread=2.80"];
            \\    total: Money;
            \\    for line: lines {
            \\        #pattern ?item := parse(line) else {
            \\            print("skipped '{}'\n", line);
            \\            continue;
            \\        };
            \\        print("{}\n", item);
            \\        total = total + item.price;
            \\    }
            \\    print("total {}\n", total);
            \\}
    );
    code_block(
        23,
        "text",
        #string
            \\{tea, 4.50}
            \\{cake, 3.25}
            \\skipped 'jam'
            \\{bread, 2.80}
            \\total 10.55
    );
    subheading(24, "Imports do not chain");
    paragraph(
        25,
        #string,oneline
            \\`catalog.glo` imports `money.glo`, but that import is the catalog's
            \\business: it does not make `Money` visible in `shop.glo`. Every file
            \\imports what it uses itself. Without the third import line:
    );
    code_block(
        26,
        "text",
        #string
            \\// total: Money;     with only catalog.glo imported
            \\error: unknown type 'Money'
            \\note: 'Money' is not available through this module's imports; import its module directly, or include it in the import selector
    );
    paragraph(
        27,
        #string,oneline
            \\Importing all of `money.glo` would fix that and cause the clash the
            \\catalog avoided, because `shop.glo` would then see two procedures
            \\named `parse`. The compiler refuses to guess, and lists the
            \\candidates:
    );
    code_block(
        28,
        "text",
        #string
            \\// #import "money.glo";     instead of the import list
            \\error: ambiguous imported name 'parse'
            \\note: candidate declared in money.glo
            \\note: candidate declared in catalog.glo
            \\note: qualify the name with its module alias, or select a single import
    );
    paragraph(
        29,
        #string,oneline
            \\The import list `{ Money }` brings exactly the listed names, so
            \\`shop.glo` gets the type and not the parser. A list may name only
            \\public declarations, and a wrong one is answered with the names that
            \\are available:
    );
    code_block(
        30,
        "text",
        #string
            \\// #import "money.glo" { Money, whole_number };
            \\error: #import names unknown public declaration 'whole_number' in module "money.glo"
            \\note: public names: Money, parse
    );
    subheading(31, "Choosing an import form");
    table_header(32, "Form   —   Brings into scope");
    table_row(33, "`#import \"money.glo\";`   |   Every public name of the module.");
    table_row(34, "`#import \"money.glo\" { Money, parse };`   |   Only the listed names.");
    table_row(
        35,
        "`Cash :: #import \"money.glo\";`   |   Only `Cash`; the names are written `Cash.Money`."
    );
    table_row(36, "`Cash :: #import \"money.glo\" { Money };`   |   Only `Cash.Money`.");
    paragraph(
        37,
        #string,oneline
            \\A plain import is the usual choice for a module you use heavily.
            \\Import lists document what a file depends on and avoid clashes;
            \\namespace imports keep two modules with similar vocabularies apart,
            \\as `Cash` did. Every form loads the whole module, so its instances
            \\are available whichever form you choose.
    );
    subheading(38, "Where to go next");
    bullet(
        39,
        #string,oneline
            \\Modules, Imports, and the Prelude: module paths, directories as
            \\modules, re-exporting with `#export`, cycles, and what every file
            \\sees without an import.
    );
    bullet(
        40,
        #string,oneline
            \\Who Can Use a Declaration: Visibility and Units: private fields and
            \\variants, `#public,unit`, `#public,to(...)`, and the rule that a
            \\public interface cannot expose a private type.
    );
    bullet(
        41,
        #string,oneline
            \\Typeclass Declarations and Instances for where instances may be
            \\declared and how they are found.
    );
}

render_section_12 :: () {
    paragraph(
        0,
        #string,oneline
            \\The compiler can run Glosso code while it builds your program. A
            \\value that never changes can be computed once, at compile time,
            \\instead of every time the program starts; an assumption can be
            \\checked before the program exists; code for another operating system
            \\can be left out; and a procedure can be generated from the fields of
            \\a struct. None of this needs a second language: compile-time code is
            \\ordinary Glosso. This chapter applies each technique to pieces of a
            \\word counter and ends with a script that builds the program.
    );
    subheading(1, "Constants the compiler computes");
    code_block(
        2,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\// The number of primes below `limit`, by trial division.
            \\count_primes :: (limit: s64) -> s64 {
            \\    count := 0;
            \\    for n: 2..limit {
            \\        prime := true;
            \\        d := 2;
            \\        while d * d <= n {
            \\            if n % d == 0 { prime = false; break; }
            \\            d += 1;
            \\        }
            \\        if prime count += 1;
            \\    }
            \\    return count;
            \\}
            \\
            \\SECONDS_PER_DAY :: 24 * 60 * 60;
            \\PRIMES_BELOW_10000 :: #comptime count_primes(10000);
            \\
            \\main :: () {
            \\    print("{} {}\n", SECONDS_PER_DAY, PRIMES_BELOW_10000);
            \\    print("{}\n", count_primes(100));
            \\}
    );
    code_block(
        3,
        "text",
        #string
            \\86400 1229
            \\25
    );
    paragraph(
        4,
        #string,oneline
            \\A top-level constant declared with `::` is always computed by the
            \\compiler, so `SECONDS_PER_DAY` is the number 86400 in the program.
            \\`#comptime` extends that to any expression, including a call of an
            \\ordinary procedure: the compiler runs `count_primes(10000)` while it
            \\compiles, and the executable contains only the result. The same
            \\procedure is also called at run time in `main`; nothing marks it as
            \\a compile-time procedure. Inside a procedure, `n := #comptime f();`
            \\works the same way.
    );
    subheading(5, "A lookup table");
    paragraph(
        6,
        #string,oneline
            \\A word counter has to decide for every byte of its input whether it
            \\belongs to a word. A table with one entry per byte value answers that
            \\with a single indexing operation, and the compiler can fill it:
    );
    code_block(
        7,
        "glosso",
        #string
            \\// count.glo
            \\#import "Io";
            \\
            \\// Whether a byte can be part of a word: a letter, a digit, or an apostrophe.
            \\is_word_byte :: (c: u8) -> bool {
            \\    letter := (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z");
            \\    digit := c >= #char "0" && c <= #char "9";
            \\    return letter || digit || c == #char "'";
            \\}
            \\
            \\// The same answer for all 256 byte values, computed by the compiler.
            \\WORD_BYTE :: #comptime -> [256]bool {
            \\    table: [256]bool;
            \\    for i: 0..256 table[i] = is_word_byte(cast(u8) i);
            \\    return table;
            \\};
            \\
            \\count_words :: (text: str) -> s64 {
            \\    words := 0;
            \\    inside := false;
            \\    for i: 0..text.count {
            \\        is_word := WORD_BYTE[text[i]];
            \\        if is_word && !inside words += 1;
            \\        inside = is_word;
            \\    }
            \\    return words;
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", count_words("It's 9 o'clock, and the cat sleeps."));
            \\}
    );
    code_block(
        8,
        "text",
        #string
            \\7
    );
    paragraph(
        9,
        #string,oneline
            \\`#comptime -> [256]bool { ... };` is the block form: a body that runs
            \\in the compiler and returns a value of the stated type. The finished
            \\table is stored in the executable as constant data, so the program
            \\does no work at startup to build it. Because the table is computed
            \\from `is_word_byte`, the two cannot disagree: change the rule and the
            \\table follows at the next build. `count_words` counts a word each
            \\time a word byte follows a byte that is not one. (`#char "a"` is the
            \\byte value of a character, and `cast(u8) i` converts the loop's
            \\`ssize` index to a byte, since Glosso does not mix integer types
            \\implicitly.)
    );
    subheading(10, "Checking assumptions with `#assert`");
    paragraph(
        11,
        #string,oneline
            \\`#assert condition, "message";` states something that must be true.
            \\When the compiler can decide the condition, it does so and stops the
            \\build if it is false. When the condition depends on run-time values,
            \\the assertion becomes a check that stops the program with the
            \\message. This version asserts a property of the table and a
            \\precondition of a procedure:
    );
    code_block(
        12,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\is_word_byte :: (c: u8) -> bool {
            \\    letter := (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z");
            \\    digit := c >= #char "0" && c <= #char "9";
            \\    return letter || digit || c == #char "'";
            \\}
            \\
            \\WORD_BYTE :: #comptime -> [256]bool {
            \\    table: [256]bool;
            \\    for i: 0..256 table[i] = is_word_byte(cast(u8) i);
            \\    space: u8 = #char " ";
            \\    apostrophe: u8 = #char "'";
            \\    #assert !table[space] && table[apostrophe], "the word table is wrong";
            \\    return table;
            \\};
            \\
            \\// The average word length; there must be at least one word.
            \\average :: (letters: s64, words: s64) -> s64 {
            \\    #assert words > 0, "average of no words";
            \\    return letters / words;
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", average(20, 4));
            \\    print("{}\n", average(5, 0));
            \\}
    );
    code_block(
        13,
        "text",
        #string
            \\$ glosso compile --run assert.glo 2>&1 | tail -3
            \\5
            \\assert.glo:20:5: assertion failed: average of no words
            \\glosso: program exited with status 134
    );
    paragraph(
        14,
        #string,oneline
            \\The assertion in `average` could only be checked at run time, and the
            \\second call failed it: the program printed where the assertion is and
            \\its message, and stopped with status 134. The assertion inside the
            \\table's block ran while the table was computed. Had someone added the
            \\space to `is_word_byte`, the program would not have been built at
            \\all:
    );
    code_block(
        15,
        "text",
        #string
            \\// return letter || digit || c == #char "'" || c == #char " ";
            \\error: assertion failed: the word table is wrong
    );
    subheading(16, "Choosing code for the target with `#if`");
    paragraph(
        17,
        #string,oneline
            \\`#if` is an `if` that the compiler decides. Only the selected branch
            \\is compiled; the others need only be syntactically correct, so they
            \\may call procedures that exist only on another system. `OUT`
            \\describes the target the program is being built for, with fields such
            \\as `OUT.os` and `OUT.cpu`. At the top level `#if` chooses between
            \\declarations, inside a procedure between statements:
    );
    code_block(
        18,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\#if OUT.os == Target_OS.Windows {
            \\    NEWLINE :: "\r\n";
            \\    SYSTEM :: "Windows";
            \\} else {
            \\    NEWLINE :: "\n";
            \\    SYSTEM :: "a Unix-like system";
            \\}
            \\
            \\main :: () {
            \\    print("built for {}; a newline is {} byte(s){}", SYSTEM, NEWLINE.count, NEWLINE);
            \\    #if OUT.cpu == Target_CPU.X86_64 print("on an x86-64 processor\n");
            \\}
    );
    code_block(
        19,
        "text",
        #string
            \\built for a Unix-like system; a newline is 1 byte(s)
            \\on an x86-64 processor
    );
    paragraph(
        20,
        #string,oneline
            \\The output is from a build for x86-64 Linux; a build for Windows
            \\declares the other constants and prints something else. The
            \\condition must be known to the compiler, so a variable does not
            \\work, even one that never changes:
    );
    code_block(
        21,
        "text",
        #string
            \\// windows := false;  #if windows print("x\n");
            \\error: unknown const windows
    );
    subheading(22, "Code that reads a type");
    paragraph(
        23,
        #string,oneline
            \\The compiler knows every struct's fields, and the `Meta` module lets
            \\code ask about them: `field_count(T)`, `field_name(T, i)` and
            \\`field_type(T, i)`. Combined with a loop that the compiler unrolls,
            \\this writes a procedure that prints any struct, field by field:
    );
    code_block(
        24,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\Stats :: struct {
            \\    words: s64;
            \\    lines: s64;
            \\    bytes: s64;
            \\}
            \\
            \\Book :: struct {
            \\    title: str;
            \\    pages: s64;
            \\}
            \\
            \\// Prints every field of a struct as "name: value", one per line.
            \\print_fields :: (value: $T) {
            \\    print("{}\n", type_name(T));
            \\    #inline for i: 0..#comptime field_count(T) {
            \\        NAME :: field_name(T, i);
            \\        print("  {}: {}\n", NAME, #insert #code value.``NAME);
            \\    }
            \\}
            \\
            \\main :: () {
            \\    print_fields(Stats.{ .words = 7, .lines = 1, .bytes = 36 });
            \\    print_fields(Book.{ .title = "Dune", .pages = 412 });
            \\}
    );
    code_block(
        25,
        "text",
        #string
            \\Stats
            \\  words: 7
            \\  lines: 1
            \\  bytes: 36
            \\Book
            \\  title: Dune
            \\  pages: 412
    );
    paragraph(
        26,
        #string,oneline
            \\`#inline for` copies its body once for each value of `i`, so `i` is a
            \\constant in every copy, as the queries require; the loop's bound is
            \\computed with `#comptime` for the same reason. `field_name` gives the
            \\name as a string, and the `#insert #code` expression splices that
            \\string back in as a field name after `value.`, which makes the field
            \\accesses `value.words`, `value.lines`, and so on.
            \\Each version of `print_fields` is a straight sequence of `print`
            \\calls; nothing about the struct is looked up while the program runs.
    );
    subheading(27, "A first build script");
    paragraph(
        28,
        #string,oneline
            \\A top-level `#comptime { ... }` block runs once per build, and the
            \\`Compiler` module lets it start other compilations. A file whose only
            \\job is such a block is a build script, written in Glosso instead of a
            \\separate build language. This one builds `count.glo` from the lookup
            \\table section with optimization into a `bin` directory:
    );
    code_block(
        29,
        "glosso",
        #string
            \\// build.glo
            \\#import "Io";
            \\#import "Compiler";
            \\#import "Typeclass";
            \\
            \\#comptime {
            \\    set_current_output(false);      // this file builds nothing itself
            \\
            \\    profile := Build_Profile.create("count");
            \\    options := profile.options();
            \\    options.output_directory = "bin";
            \\    options.set_optimization_level(.O2);
            \\    profile.set_options(options);
            \\
            \\    if compile_file("count.glo", profile) == {
            \\        case .Ok(output);
            \\            print("{}", output);
            \\        case .Err(failure);
            \\            report_error(failure);
            \\            exit(1);
            \\    }
            \\}
    );
    code_block(
        30,
        "text",
        #string
            \\$ glosso compile build.glo
            \\glosso: compile build.glo (target=x86_64-pc-linux-gnu)
            \\glosso: compile count.glo (target=x86_64-pc-linux-gnu)
            \\glosso: link bin/count (target=x86_64-pc-linux-gnu, -O2)
            \\glosso: done bin/count  (backend=llvm, target=x86_64-pc-linux-gnu, -O2)
            \\$ bin/count
            \\7
            \\$ glosso compile build.glo
            \\glosso: compile build.glo (target=x86_64-pc-linux-gnu)
            \\glosso: restored bin/count from the native artifact cache
    );
    paragraph(
        31,
        #string,oneline
            \\`set_current_output(false)` tells the compilation of `build.glo`
            \\itself to produce nothing, so the script needs no `main`. A build
            \\profile holds the options for a nested compilation; the script
            \\copies them, changes the output directory and the optimization level,
            \\and installs them. `compile_file` runs the nested compilation and
            \\returns what it printed, or an error that `report_error` describes.
            \\The second run shows that the script runs on every build, while the
            \\program it builds comes from the compiler's cache when nothing has
            \\changed.
    );
    subheading(32, "Where to go next");
    bullet(
        33,
        #string,oneline
            \\Compile-Time Evaluation: what runs when, the forms of `#comptime`,
            \\and what a compile-time value can be.
    );
    bullet(
        34,
        #string,oneline
            \\`#if`, `#assert`, and `#compile_error`: static branching in generic
            \\code, `OUT` and `HOST`, and `#assert #comptime`.
    );
    bullet(
        35,
        #string,oneline
            \\`type` Values and Type Reflection, and `#code`, `#insert`, and
            \\`#expand`, for every reflection query and for generating code.
    );
    bullet(
        36,
        #string,oneline
            \\Build Scripts and Compile-Time Arguments: build profiles, build options,
            \\running commands, and compiling C code from a script.
    );
}

render_section_13 :: () {
    paragraph(
        0,
        #string,oneline
            \\Decades of useful code exist as C libraries, and every operating
            \\system exposes its services through a C interface. Glosso calls C
            \\functions directly: you declare a function with a Glosso signature,
            \\say which library defines it, and call it like any procedure. No
            \\wrapper is generated and nothing is converted on the way, so the
            \\declaration has to match what C expects. This chapter calls functions
            \\of the C library, passes text and a callback across, and compiles a
            \\C file of its own into the program.
    );
    subheading(1, "Declaring C functions");
    code_block(
        2,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\libc     :: #library "c";
            \\c_strlen :: (text: cstr) -> usize #foreign libc "strlen";
            \\abs      :: (value: s32) -> s32 #foreign libc;
            \\atoi     :: (text: cstr) -> s32 #foreign libc;
            \\
            \\main :: () {
            \\    print("{} {} {}\n", c_strlen("glosso"), abs(-7), atoi("42 apples"));
            \\}
    );
    code_block(
        3,
        "text",
        #string
            \\6 7 42
    );
    paragraph(
        4,
        #string,oneline
            \\`libc :: #library "c";` declares a constant that stands for the C
            \\library. A `#foreign` declaration has a signature and no body, and
            \\ends with a semicolon. `#foreign libc "strlen"` binds the C function
            \\`strlen` under the Glosso name `c_strlen`; without the string, as for
            \\`abs` and `atoi`, the C name is the Glosso name. Choosing your own
            \\name is useful when the C name is taken: a declaration called `free`
            \\would hide the `free` you use for your own memory.
    );
    paragraph(
        5,
        #string,oneline
            \\Nothing compares the declaration with the C header. The compiler
            \\checks your calls against the signature you wrote, and a wrong
            \\signature is a wrong call at run time, so translate each C type with
            \\care:
    );
    table_header(6, "C type   —   Glosso type");
    table_row(7, "`int`, `unsigned`   |   `s32`, `u32`");
    table_row(8, "`long`   |   `s64` on 64-bit Linux and macOS, `s32` on Windows");
    table_row(9, "`size_t`   |   `usize`");
    table_row(10, "`double`, `float`   |   `f64`, `f32`");
    table_row(11, "`const char *` holding text   |   `cstr`");
    table_row(
        12,
        "`T *`, or `T *` that may be null   |   `*T`, `?*T`; `[*]T` when it points at several elements"
    );
    table_row(13, "`void *`   |   `*void`, `?*void`");
    table_row(14, "a function pointer   |   a `#fn_ptr(...) #c_call` type, shown below");
    paragraph(
        15,
        #string,oneline
            \\Glosso does not convert between `ssize` and `usize` implicitly, so a
            \\Glosso count passed as a C `size_t` needs `cast(usize)`; the
            \\compiler reports `arg type ssize != usize` when you forget.
    );
    subheading(16, "Text: `str` and `cstr`");
    paragraph(
        17,
        #string,oneline
            \\A C string is a pointer to bytes that end with a zero. A Glosso `str`
            \\is a pointer and a count with no terminator, so it cannot be passed
            \\where C expects a `char *`. `cstr` is the C kind of string. String
            \\literals are stored with a terminator and convert to `cstr` by
            \\themselves; any other `str` is copied with `.c_string()`, which makes
            \\a zero-terminated copy in the temporary allocator that lasts long
            \\enough for the call. In the other direction, `.to_string()` on a
            \\`cstr` gives a `str` view of C's bytes without copying them:
    );
    code_block(
        18,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\
            \\libc   :: #library "c";
            \\setenv :: (name: cstr, value: cstr, overwrite: s32) -> s32 #foreign libc;
            \\getenv :: (name: cstr) -> cstr #foreign libc;
            \\strdup :: (text: cstr) -> cstr #foreign libc;
            \\c_free :: (memory: ?*void) #foreign libc "free";
            \\
            \\main :: () {
            \\    name := "GREETING";                            // a str: no terminating zero
            \\    setenv(name.c_string(), "hello from C", 1);
            \\    value := getenv(name.c_string());
            \\    print("{} ({} bytes)\n", value, value.count);
            \\    words := value.to_string().split(" ");
            \\    defer words.free();
            \\    print("{} words, the last is '{}'\n", words.count, words[words.count - 1]);
            \\
            \\    missing := getenv("NO_SUCH_VARIABLE");
            \\    print("{} {}\n", missing == null, missing.count);
            \\
            \\    copy := strdup(value);                         // allocated by C's malloc
            \\    defer c_free(cast(*void) copy);                // so it goes back to C's free
            \\    print("{}\n", copy);
            \\}
    );
    code_block(
        19,
        "text",
        #string
            \\hello from C (12 bytes)
            \\3 words, the last is 'C'
            \\true 0
            \\hello from C
    );
    paragraph(
        20,
        #string,oneline
            \\`getenv` returns C's null pointer for a variable that is not set; the
            \\`cstr` then compares equal to `null` and has a count of 0. `strdup`
            \\allocates its copy with C's `malloc`, so the copy is released with
            \\C's `free`, declared here as `c_free`. Memory always goes back to the
            \\side that allocated it: handing C's memory to a Glosso `free` gives
            \\it to an allocator that never allocated it. Forgetting the conversion
            \\of a `str` is caught at compile time:
    );
    code_block(
        21,
        "text",
        #string
            \\// name := "HOME";  value := getenv(name);
            \\error: arg type str != cstr in call getenv
    );
    subheading(22, "Passing a callback");
    paragraph(
        23,
        #string,oneline
            \\Some C functions take a function to call back. C's `qsort` sorts an
            \\array of any element type and calls a comparison function with
            \\pointers to two elements. The callback is called by C, so it must use
            \\C's calling convention, which `#c_call` selects, and its type is a
            \\function pointer type written with `#fn_ptr`:
    );
    code_block(
        24,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\// The type of the comparison procedure that C's qsort calls.
            \\Compare :: #fn_ptr(a: *const void, b: *const void) -> s32 #c_call;
            \\
            \\libc  :: #library "c";
            \\qsort :: (base: *void, count: usize, size: usize, compare: Compare) #foreign libc;
            \\
            \\// Called by C, so it uses C's calling convention.
            \\by_length :: (a: *const void, b: *const void) -> s32 #c_call {
            \\    left := (cast(*const str) a).*;
            \\    right := (cast(*const str) b).*;
            \\    return cast(s32) (left.count - right.count);
            \\}
            \\
            \\main :: () {
            \\    words: [5]str = .["banana", "fig", "elderberry", "kiwi", "apple"];
            \\    qsort(&words, cast(usize) words.count, cast(usize) size_of(str), by_length);
            \\    for word, i: words {
            \\        if i > 0 print(" ");
            \\        print("{}", word);
            \\    }
            \\    print("\n");
            \\}
    );
    code_block(
        25,
        "text",
        #string
            \\fig kiwi apple banana elderberry
    );
    paragraph(
        26,
        #string,oneline
            \\C knows nothing of the element type, so `qsort` receives the
            \\array's address as `*void`, its element count, and the size of one
            \\element from `size_of` (from the `Meta` module). The callback casts
            \\the untyped pointers back to `*const str` and reads the elements with
            \\`.*`. C only moves the bytes around, so Glosso values such as `str`
            \\can be sorted this way. Leaving out `#c_call` makes the procedure's
            \\type differ from the one `qsort` expects:
    );
    code_block(
        27,
        "text",
        #string
            \\// by_length :: (a: *const void, b: *const void) -> s32 { ... }
            \\error: arg type #fn_ptr(*const void, *const void) -> s32 != #fn_ptr(*const void, *const void) -> s32 #c_call: the calling conventions differ (#c_call) in call qsort
    );
    paragraph(
        28,
        #string,oneline
            \\A `#c_call` procedure may not use the implicit `context` that holds
            \\the allocators, not even through a default argument such as the
            \\`allocator` parameter of many standard procedures; `#Context` and
            \\`context` shows how such a procedure installs one with
            \\`#push_context`. Within a Glosso program, the `Sort` module is the
            \\usual way to sort.
    );
    subheading(29, "Compiling a C file into the program");
    paragraph(
        30,
        #string,oneline
            \\C code of your own can be compiled as part of the Glosso build. Here
            \\is a small C file next to the program:
    );
    code_block(
        31,
        "text",
        #string
            \\/* stats.c */
            \\#include <stddef.h>
            \\
            \\/* The mean of `count` values. */
            \\double stats_mean(const double *values, size_t count) {
            \\    double sum = 0;
            \\    for (size_t i = 0; i < count; i++) sum += values[i];
            \\    return count ? sum / count : 0;
            \\}
            \\
            \\/* The largest of `count` values; 0 when there are none. */
            \\double stats_max(const double *values, size_t count) {
            \\    double max = count ? values[0] : 0;
            \\    for (size_t i = 1; i < count; i++) if (values[i] > max) max = values[i];
            \\    return max;
            \\}
    );
    paragraph(
        32,
        #string,oneline
            \\The program compiles it while it is itself compiled, with the
            \\techniques of Code That Runs at Compile Time. `compile_c_archive`
            \\from the `Compiler` module runs the C compiler that comes with the
            \\Glosso toolchain and returns the path of the resulting archive, and
            \\`#insert` adds a `#library` declaration for that path to the program:
    );
    code_block(
        33,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\#import "Compiler";
            \\
            \\// Compiles stats.c while this program is compiled, and declares the library.
            \\stats_library :: () -> str {
            \\    if Native_Compile_Output.compile_c_archive("stats", .["stats.c"]) == {
            \\        case .Ok(built);
            \\            return tprint("stats :: #library \"{}\";", built.artifact);
            \\        case .Err(error);
            \\            print("{}", error.message);
            \\            return "#comptime { #assert false, \"stats.c did not compile\"; }";
            \\    }
            \\}
            \\
            \\#insert stats_library();
            \\
            \\stats_mean :: (values: [*]const f64, count: usize) -> f64 #foreign stats;
            \\stats_max  :: (values: [*]const f64, count: usize) -> f64 #foreign stats;
            \\
            \\main :: () {
            \\    times: [5]f64 = .[2.5, 3.1, 2.8, 3.6, 3.0];
            \\    view := times[..];
            \\    count := cast(usize) view.count;
            \\    print("mean {}, longest {}\n", stats_mean(view.data, count), stats_max(view.data, count));
            \\}
    );
    code_block(
        34,
        "text",
        #string
            \\$ ls
            \\stats.c  stats.glo
            \\$ glosso compile --run stats.glo
            \\glosso: compile stats.glo (target=x86_64-pc-linux-gnu)
            \\glosso: link stats (target=x86_64-pc-linux-gnu, -O1)
            \\glosso: done stats  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
            \\mean 3, longest 3.6
    );
    paragraph(
        35,
        #string,oneline
            \\`#insert` takes a string computed at compile time and compiles it as
            \\if it had been written there, so on success the program contains
            \\`stats :: #library "..."` with the archive's path, and the two
            \\`#foreign` declarations bind to it. When the C file does not compile,
            \\the C compiler's messages are printed and the inserted `#assert`
            \\stops the build. The archive is kept in the compiler's cache and
            \\recompiled only when `stats.c` changes. A view's `data` field is the
            \\many-pointer `[*]f64` that the C functions expect for their
            \\`const double *`.
    );
    subheading(36, "Rules at the boundary");
    bullet(
        37,
        #string,oneline
            \\The declaration is the contract. Copy the types from the C header
            \\carefully, or generate the declarations with the bindings generator.
    );
    bullet(
        38,
        #string,oneline
            \\Pass `str` values as `.c_string()`, and remember that a `cstr` from
            \\C, and the `str` that `.to_string()` makes of it, are valid only as
            \\long as C keeps the bytes.
    );
    bullet(
        39,
        #string,oneline
            \\Release memory on the side that allocated it, and wrap a C resource
            \\that must be closed in a type with a `Freeable` instance, as Files,
            \\Handles, and Non-Memory Resources shows.
    );
    bullet(
        40,
        #string,oneline
            \\Mark every procedure that C calls `#c_call`.
    );
    subheading(41, "Where to go next");
    bullet(
        42,
        #string,oneline
            \\`#foreign`, `#library`, and `#c_call`: library kinds, linker
            \\arguments, C variadic functions, and making Glosso procedures callable
            \\from C.
    );
    bullet(
        43,
        #string,oneline
            \\C Types, Callbacks, and Bindgen: the full type mapping, structs that
            \\C reads, callbacks with user data, and generating bindings from a
            \\header.
    );
    bullet(
        44,
        #string,oneline
            \\Build Scripts and Compile-Time Arguments for compiling C code from a
            \\build script.
    );
}

render_section_14 :: () {
    paragraph(
        0,
        #string,oneline
            \\This last tutorial chapter puts the earlier ones to work in one complete
            \\tool. `wordfreq` reads the text files named on its command line, counts
            \\how often each word occurs, and prints the most frequent words in an
            \\aligned table. Along the way it uses a hash map from the standard
            \\library, sorting, the file system, a compile-time table, error types of
            \\its own, and explicit ownership of everything it allocates. The program
            \\is built in three runnable steps, each of which isolates one part, and
            \\then assembled.
    );
    paragraph(
        1,
        #string,oneline
            \\What the finished tool does:
    );
    bullet(
        2,
        #string,oneline
            \\A word is a run of ASCII letters, digits and apostrophes, and case does
            \\not matter: `The` and `the` are the same word.
    );
    bullet(
        3,
        #string,oneline
            \\All files named on the command line are counted together, and the ten
            \\most frequent words are printed, with equal counts in alphabetical
            \\order.
    );
    bullet(
        4,
        #string,oneline
            \\A file that cannot be read is reported and skipped; the other files are
            \\still counted, and the exit status is 1.
    );
    bullet(
        5,
        #string,oneline
            \\Every allocation is released, which the debug allocator confirms.
    );
    subheading(6, "Step 1: counting the words of a string");
    paragraph(
        7,
        #string,oneline
            \\A hash map from words to counts does the counting. `HashMap(K, V)` is a
            \\generic type from the `Container/HashMap` module, so `HashMap(str, s64)`
            \\maps strings to numbers. The word splitting reuses the compile-time
            \\table of Code That Runs at Compile Time:
    );
    code_block(
        8,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Container/HashMap";
            \\#import "Container/Error";
            \\
            \\// Whether a byte can be part of a word: a letter, a digit, or an apostrophe.
            \\is_word_byte :: (c: u8) -> bool {
            \\    letter := (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z");
            \\    digit := c >= #char "0" && c <= #char "9";
            \\    return letter || digit || c == #char "'";
            \\}
            \\
            \\WORD_BYTE :: #comptime -> [256]bool {
            \\    table: [256]bool;
            \\    for i: 0..256 table[i] = is_word_byte(cast(u8) i);
            \\    return table;
            \\};
            \\
            \\// Adds every word of `text` to `counts`. The keys are views into `text`,
            \\// so `text` must outlive the map.
            \\count_words :: (text: str, counts: *HashMap(str, s64)) -> Container_Error!void {
            \\    i := 0;
            \\    while i < text.count {
            \\        if !WORD_BYTE[text[i]] { i += 1; continue; }
            \\        start := i;
            \\        while i < text.count && WORD_BYTE[text[i]] i += 1;
            \\        count := counts.get_or_insert(text[start..i], 0)?;
            \\        count.* += 1;
            \\    }
            \\    return .Ok;
            \\}
            \\
            \\main :: () -> Container_Error!void {
            \\    text := "the cat sat on the mat. the dog sat on the log.";
            \\    counts := HashMap(str, s64).new()?;
            \\    defer counts.free();
            \\    count_words(text, &counts)?;
            \\    print("{} different words\n", counts.len());
            \\    for word: .["the", "sat", "cat", "bird"] {
            \\        if #pattern ?n = counts.get(word) print("{}: {}\n", word, n.*);
            \\        else print("{}: none\n", word);
            \\    }
            \\    return .Ok;
            \\}
    );
    code_block(
        9,
        "text",
        #string
            \\7 different words
            \\the: 4
            \\sat: 2
            \\cat: 1
            \\bird: none
    );
    paragraph(
        10,
        #string,oneline
            \\`HashMap(str, s64).new()` returns a result, because it asks the
            \\operating system for a random seed for its hash function; a seed that an
            \\attacker cannot predict keeps specially chosen input from making the map
            \\slow. Its error type is `Container_Error` from the `Container/Error`
            \\module, which is also what `main` returns here. The map is an owner,
            \\released by the `defer` on the next line.
    );
    paragraph(
        11,
        #string,oneline
            \\`get_or_insert(key, 0)` finds the count stored for a word, or first
            \\stores 0 for a new word, and returns a pointer to the count in the map,
            \\so `count.* += 1` updates it in place. The pointer stays valid only
            \\until the next insertion, which is why it is used at once. `get` looks a
            \\word up without inserting and returns `?*s64`, `null` for a word that
            \\never occurred.
    );
    paragraph(
        12,
        #string,oneline
            \\Notice what the map stores as keys: `text[start..i]` is a view into
            \\`text`, not a copy. A `str` is not an owner, so the map neither copies
            \\nor frees the words, and the text they point into must stay alive as
            \\long as the map. Here the text is a literal, which lives as long as the
            \\program; in the finished tool it is the contents of a file, and the
            \\program has to keep that memory for as long as the map exists.
    );
    subheading(13, "Step 2: sorting and printing a table");
    paragraph(
        14,
        #string,oneline
            \\A hash map keeps its entries in no useful order. To print the most
            \\frequent words first, the program copies the entries into a dynamic
            \\array and sorts it with `sort_by` from the `Sort` module, which takes a
            \\comparison procedure. The `Format` module has no option for column
            \\widths, so a small helper pads the counts to align them. This step also
            \\lowercases the text first, so that `The` and `the` count as one word:
    );
    code_block(
        15,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\#import "Strings";
            \\#import "Container/HashMap";
            \\#import "Container/Error";
            \\#import "Sort";
            \\
            \\Word_Count :: struct { word: str; count: s64; }
            \\
            \\is_word_byte :: (c: u8) -> bool {
            \\    letter := (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z");
            \\    digit := c >= #char "0" && c <= #char "9";
            \\    return letter || digit || c == #char "'";
            \\}
            \\
            \\WORD_BYTE :: #comptime -> [256]bool {
            \\    table: [256]bool;
            \\    for i: 0..256 table[i] = is_word_byte(cast(u8) i);
            \\    return table;
            \\};
            \\
            \\count_words :: (text: str, counts: *HashMap(str, s64)) -> Container_Error!void {
            \\    i := 0;
            \\    while i < text.count {
            \\        if !WORD_BYTE[text[i]] { i += 1; continue; }
            \\        start := i;
            \\        while i < text.count && WORD_BYTE[text[i]] i += 1;
            \\        count := counts.get_or_insert(text[start..i], 0)?;
            \\        count.* += 1;
            \\    }
            \\    return .Ok;
            \\}
            \\
            \\// Higher counts first; equal counts in alphabetical order.
            \\by_count :: (a: Word_Count, b: Word_Count) -> Ordering {
            \\    if a.count != b.count return b.count <=> a.count;
            \\    return a.word <=> b.word;
            \\}
            \\
            \\// Writes `text` right-aligned in a column `width` bytes wide.
            \\print_right :: (text: str, width: s64) {
            \\    for 0..width - text.count print(" ");
            \\    print("{}", text);
            \\}
            \\
            \\// Prints the first `limit` rows as a table with the counts aligned.
            \\print_table :: (rows: []const Word_Count, limit: s64) {
            \\    width := "count".count;
            \\    for row: rows {
            \\        digits := tprint("{}", row.count).count;
            \\        if digits > width width = digits;
            \\    }
            \\    print_right("count", width);
            \\    print("  word\n");
            \\    for row, i: rows {
            \\        if i == limit break;
            \\        print_right(tprint("{}", row.count), width);
            \\        print("  {}\n", row.word);
            \\    }
            \\}
            \\
            \\main :: () -> Container_Error!void {
            \\    text := "The cat sat on the mat. The dog sat on the log. The end.".to_lower();
            \\    defer text.free();
            \\    counts := HashMap(str, s64).new()?;
            \\    defer counts.free();
            \\    count_words(text, &counts)?;
            \\
            \\    rows: [..]Word_Count;
            \\    defer rows.free();
            \\    for entry: counts rows.push(.{ entry.key.*, entry.value.* });
            \\    if rows[..].sort_by(by_count) == {
            \\        case .Ok;     print_table(rows.view(), 5);
            \\        case .Err(e); print("cannot sort: {}\n", e);
            \\    }
            \\    return .Ok;
            \\}
    );
    code_block(
        16,
        "text",
        #string
            \\count  word
            \\    5  the
            \\    2  on
            \\    2  sat
            \\    1  cat
            \\    1  dog
    );
    paragraph(
        17,
        #string,oneline
            \\`for entry: counts` walks the map; each entry holds read-only pointers
            \\to a key and its value. `by_count` returns an `Ordering`: for different
            \\counts, `b.count <=> a.count` compares them the other way round, which
            \\puts larger counts first, and equal counts fall back to comparing the
            \\words, which compares strings byte by byte. `sort_by` returns a result
            \\because a comparison may answer `.Unordered`, which the standard
            \\comparisons do only for floating-point NaN values; this one never
            \\does, but the result is still handled.
    );
    paragraph(
        18,
        #string,oneline
            \\`print_table` measures the widest count with `tprint`, whose temporary
            \\strings need no `free` (see Owning and Freeing Memory), and
            \\`print_right` writes the missing spaces with `for 0..n`, a loop that
            \\needs no loop variable. The order of the two `defer` lines in `main`
            \\matters: the map holds views into `text`, and deferred statements run in
            \\reverse, so `counts` is released before `text`.
    );
    subheading(19, "Step 3: reading a file");
    paragraph(
        20,
        #string,oneline
            \\The `File_System/File` module opens and reads files. `File.open(path)`
            \\returns `Fs_Error!File`, and `file.read()` reads everything up to the
            \\end of the file into a new string, returned as `Fs_Error!str`. A `File`
            \\is an owner whose `free` closes it. To be runnable anywhere, this step
            \\first writes the file it then reads, with `write_file`, and also tries a
            \\file that does not exist:
    );
    code_block(
        21,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Strings";
            \\#import "File_System/File";
            \\
            \\// The contents of the file at `path`, lowercased. The caller frees the result.
            \\read_lowercase :: (path: str) -> Fs_Error!str {
            \\    file := File.open(path)?;
            \\    defer file.free();
            \\    text := file.read()?;
            \\    defer text.free();
            \\    return text.to_lower();
            \\}
            \\
            \\main :: () {
            \\    // A file to read: this program writes its own sample first.
            \\    if write_file("sample.txt", "One FISH,\ntwo Fish.\n") == {
            \\        case .Ok(n);  print("wrote {} bytes\n", n);
            \\        case .Err(e); print("cannot write: {}\n", e.kind.reason());
            \\    }
            \\    paths: [2]str = .["sample.txt", "missing.txt"];
            \\    for path: paths {
            \\        if read_lowercase(path) == {
            \\            case .Ok(text);
            \\                defer text.free();
            \\                print("{}: {}", path, text);
            \\            case .Err(error);
            \\                print("{}: {} ({})\n", path, error.kind.reason(), error.kind);
            \\        }
            \\    }
            \\}
    );
    code_block(
        22,
        "text",
        #string
            \\wrote 20 bytes
            \\sample.txt: one fish,
            \\two fish.
            \\missing.txt: path was not found (Not_Found)
    );
    paragraph(
        23,
        #string,oneline
            \\`read_lowercase` follows the patterns of Missing Values and Errors and
            \\Owning and Freeing Memory together. Each `?` returns the error of a
            \\failed step at once, and the two `defer` lines close the file and free
            \\the original text on every way out, including those early returns. What
            \\the procedure returns is the lowercase copy, which the caller owns.
            \\`Fs_Error` is a struct whose `kind` field says what went wrong, as a
            \\member of the enum `Fs_Error_Kind`, and `kind.reason()` gives a short
            \\English description.
    );
    subheading(24, "The complete program");
    paragraph(
        25,
        #string,oneline
            \\The finished `main` has more ways to fail than the steps had. A file
            \\that cannot be read is handled on the spot: it is reported and skipped.
            \\The map can fail with a `Container_Error`, sorting with a `Sort_Error`,
            \\and the tool itself fails when it is given no files or when a file was
            \\skipped. One error type collects them all:
    );
    bullet(
        26,
        #string,oneline
            \\`Failure` is the tool's own error: a message, with an `Error` instance
            \\that reports it as `wordfreq: message`.
    );
    bullet(
        27,
        #string,oneline
            \\`Word_Error` is a tagged union with one variant per kind of failure.
            \\`#from` marks variants that `?` fills automatically: when `count_words`
            \\fails with a `Container_Error`, `?` in `main` turns it into the `table`
            \\variant. `#derive(Error)` writes the union's `Error` instance, which
            \\reports whichever error the union holds, so `main` can return
            \\`Word_Error!void`.
    );
    paragraph(
        28,
        #string,oneline
            \\This is the whole program:
    );
    code_block(
        29,
        "glosso",
        #string
            \\// wordfreq.glo
            \\// Counts the words in the files named on the command line.
            \\#import "Io";
            \\#import "Format";
            \\#import "Strings";
            \\#import "Typeclass";
            \\#import "File_System/File";
            \\#import "Container/HashMap";
            \\#import "Container/Error";
            \\#import "Sort";
            \\
            \\TOP :: 10;     // how many rows the table shows
            \\
            \\Word_Count :: struct { word: str; count: s64; }
            \\
            \\// A failure of the tool itself, with the message to show.
            \\Failure :: struct { message: str; }
            \\
            \\Failure ::: instance Error {
            \\    report_error :: (error: Failure) {
            \\        ("wordfreq").error_report_line(error.message);
            \\    }
            \\}
            \\
            \\// Everything that can make the program fail.
            \\Word_Error :: union #derive(Error) {
            \\    #from failure: Failure;
            \\    #from table: Container_Error;
            \\    #from order: Sort_Error;
            \\}
            \\
            \\// Whether a byte can be part of a word: a letter, a digit, or an apostrophe.
            \\is_word_byte :: (c: u8) -> bool {
            \\    letter := (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z");
            \\    digit := c >= #char "0" && c <= #char "9";
            \\    return letter || digit || c == #char "'";
            \\}
            \\
            \\WORD_BYTE :: #comptime -> [256]bool {
            \\    table: [256]bool;
            \\    for i: 0..256 table[i] = is_word_byte(cast(u8) i);
            \\    return table;
            \\};
            \\
            \\// The contents of the file at `path`, lowercased. The caller frees the result.
            \\read_lowercase :: (path: str) -> Fs_Error!str {
            \\    file := File.open(path)?;
            \\    defer file.free();
            \\    text := file.read()?;
            \\    defer text.free();
            \\    return text.to_lower();
            \\}
            \\
            \\// Adds every word of `text` to `counts`. The keys are views into `text`,
            \\// so `text` must outlive the map.
            \\count_words :: (text: str, counts: *HashMap(str, s64)) -> Container_Error!void {
            \\    i := 0;
            \\    while i < text.count {
            \\        if !WORD_BYTE[text[i]] { i += 1; continue; }
            \\        start := i;
            \\        while i < text.count && WORD_BYTE[text[i]] i += 1;
            \\        count := counts.get_or_insert(text[start..i], 0)?;
            \\        count.* += 1;
            \\    }
            \\    return .Ok;
            \\}
            \\
            \\// Higher counts first; equal counts in alphabetical order.
            \\by_count :: (a: Word_Count, b: Word_Count) -> Ordering {
            \\    if a.count != b.count return b.count <=> a.count;
            \\    return a.word <=> b.word;
            \\}
            \\
            \\// Writes `text` right-aligned in a column `width` bytes wide.
            \\print_right :: (text: str, width: s64) {
            \\    for 0..width - text.count print(" ");
            \\    print("{}", text);
            \\}
            \\
            \\// Prints the first `limit` rows as a table with the counts aligned.
            \\print_table :: (rows: []const Word_Count, limit: s64) {
            \\    width := "count".count;
            \\    for row: rows {
            \\        digits := tprint("{}", row.count).count;
            \\        if digits > width width = digits;
            \\    }
            \\    print_right("count", width);
            \\    print("  word\n");
            \\    for row, i: rows {
            \\        if i == limit break;
            \\        print_right(tprint("{}", row.count), width);
            \\        print("  {}\n", row.word);
            \\    }
            \\}
            \\
            \\main :: () -> Word_Error!void {
            \\    paths := get_cmdline_args();
            \\    if paths.count < 2 return .Err(.failure(.{ "usage: wordfreq FILE..." }));
            \\
            \\    texts: [..]str;                    // the lowercased contents of every file
            \\    defer {
            \\        for text: texts text.free();
            \\        texts.free();
            \\    }
            \\    counts := HashMap(str, s64).new()?;
            \\    defer counts.free();               // freed before `texts`, whose words it holds
            \\
            \\    failed := 0;
            \\    for i: 1..paths.count {
            \\        if read_lowercase(paths[i]) == {
            \\            case .Ok(text);
            \\                texts.push(text);
            \\                count_words(text, &counts)?;
            \\            case .Err(error);
            \\                report_error(error);
            \\                failed += 1;
            \\        }
            \\    }
            \\
            \\    rows: [..]Word_Count;
            \\    defer rows.free();
            \\    total := 0;
            \\    for entry: counts {
            \\        rows.push(.{ entry.key.*, entry.value.* });
            \\        total += entry.value.*;
            \\    }
            \\    rows[..].sort_by(by_count)?;
            \\
            \\    print_table(rows.view(), TOP);
            \\    print("{} words, {} different\n", total, rows.count);
            \\    if failed > 0 return .Err(.failure(.{ tprint("{} file(s) could not be read", failed) }));
            \\    return .Ok;
            \\}
    );
    paragraph(
        30,
        #string,oneline
            \\`get_cmdline_args()` returns the command line as a `[]const str` whose
            \\first element is the program's own path, so the files start at index 1.
            \\`.Err(.failure(.{ ... }))` builds a `Word_Error` holding the `failure`
            \\variant directly. The lowercased contents of every file go into `texts`,
            \\which is declared before `counts` and so released after it: the map's
            \\keys point into those strings until the end. A file error is not
            \\propagated; `report_error(error)` prints the report that the `Error`
            \\instance of `Fs_Error` writes, and the loop goes on. Only at the
            \\end, after the table, does the program fail if any file was skipped.
    );
    subheading(31, "Running it");
    paragraph(
        32,
        #string,oneline
            \\Two small text files to count:
    );
    code_block(
        33,
        "text",
        #string
            \\$ cat poem.txt
            \\The cat sat on the mat.
            \\The dog sat on the log,
            \\and the cat's dog sat too.
            \\$ cat notes.txt
            \\A dog is not a cat.
            \\The cat is not on the log.
    );
    code_block(
        34,
        "text",
        #string
            \\$ glosso compile wordfreq.glo
            \\glosso: compile wordfreq.glo (target=x86_64-pc-linux-gnu)
            \\glosso: link wordfreq (target=x86_64-pc-linux-gnu, -O1)
            \\glosso: done wordfreq  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
            \\$ ./wordfreq poem.txt notes.txt
            \\count  word
            \\    7  the
            \\    3  cat
            \\    3  dog
            \\    3  on
            \\    3  sat
            \\    2  a
            \\    2  is
            \\    2  log
            \\    2  not
            \\    1  and
            \\31 words, 13 different
    );
    paragraph(
        35,
        #string,oneline
            \\The numbers can be checked by hand: `the` occurs five times in the poem
            \\(twice capitalized) and twice in the notes, and `cat's` is one word of
            \\its own because the apostrophe is a word byte. Thirteen different words
            \\were counted, and the table shows the first ten; `cat's`, `mat` and
            \\`too` would come next. Words with the same count appear in alphabetical
            \\order. When a file is missing, or no file is given, the reports go to
            \\standard error and the exit status says that something failed:
    );
    code_block(
        36,
        "text",
        #string
            \\$ ./wordfreq poem.txt nosuch.txt notes.txt > table.txt; echo "status $?"
            \\filesystem error: path was not found: nosuch.txt
            \\wordfreq: 1 file(s) could not be read
            \\status 1
            \\$ ./wordfreq; echo "status $?"
            \\wordfreq: usage: wordfreq FILE...
            \\status 1
    );
    paragraph(
        37,
        #string,oneline
            \\The first line comes from `report_error` in the loop, the second from
            \\the `Failure` that `main` returned at the end, after the table had been
            \\written to `table.txt`. Finally, a build with the debug allocator checks
            \\the claim that everything is released:
    );
    code_block(
        38,
        "text",
        #string
            \\$ GLOSSO_DEBUG_ALLOCATOR=1 glosso compile wordfreq.glo 2>/dev/null
            \\$ ./wordfreq poem.txt nosuch.txt notes.txt > /dev/null
            \\filesystem error: path was not found: nosuch.txt
            \\wordfreq: 1 file(s) could not be read
    );
    paragraph(
        39,
        #string,oneline
            \\No report follows, so nothing leaked and nothing was freed twice, even
            \\on the run with an error. Deleting the line `texts.free();` from the
            \\program and running the same check prints `glosso debug allocator:
            \\leaked 1 allocation(s), 128 byte(s)`: the array's buffer, while the
            \\strings in it were still freed one by one.
    );
    subheading(40, "Ideas for extending it");
    bullet(
        41,
        #string,oneline
            \\Accept `--top N` to choose the number of rows, converting `N` with
            \\`from_string(s64, text)` and reporting a bad number through `Failure`.
    );
    bullet(
        42,
        #string,oneline
            \\Read standard input when no file is named, through `File.stdin()`.
    );
    bullet(
        43,
        #string,oneline
            \\Count words in any script by decoding runes and classifying them with
            \\the `Unicode` module instead of the ASCII table.
    );
    bullet(
        44,
        #string,oneline
            \\Move the counting and the table into a module of their own, as in
            \\Splitting a Program into Modules, and build the tool with a build
            \\script.
    );
    subheading(45, "Where to go next");
    bullet(
        46,
        #string,oneline
            \\Files, Handles, and Non-Memory Resources: closing files, close errors,
            \\and handles of other kinds.
    );
    bullet(
        47,
        #string,oneline
            \\Container Buffers, Arenas, and Pools: what containers own, and which
            \\operations invalidate pointers into them.
    );
    bullet(
        48,
        #string,oneline
            \\`Try`, `?`, `#try`, and `Termination` and Tagged and Untagged Unions for
            \\error unions with `#from` and the exit status of `main`.
    );
    bullet(
        49,
        #string,oneline
            \\Appendix D: Standard Library Modules for the other modules of the
            \\standard library.
    );
}

}
