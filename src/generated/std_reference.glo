    .{ .name = "Prelude/Show_and_Read", .summary = "Public declarations from std/Prelude/Show_and_Read.glo.", .compact_summary = "Public declarations from std/Prelude/Show_and_Read.glo.", .source_path = "std/Prelude/Show_and_Read.glo", .first_symbol = 2086, .symbol_count = 7 },
