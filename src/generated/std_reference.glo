    .{ .name = "Html", .summary = "lightweight HTML parsing, crawling, and extraction helpers. Documents and returned collections use context.allocator by default. The low-level html_unescape and URL-scanning helpers use context.temp_allocator unless an allocator is supplied explicitly.", .compact_summary = "lightweight HTML parsing, crawling, and extraction helpers. Documents and returned collections use context.allocator by default. The low-level...", .source_path = "std/Html.glo", .first_symbol = 710, .symbol_count = 29 },
    .{ .name = "Io", .summary = "compatibility output helpers and generic stream umbrella. Existing File-based print/write/read_line procedures remain source compatible. Importing Io also exposes the portable stream contracts, transfers, adapters, buffering/scanning, vector I/O, binary codecs, direct-to-writer formatting, hashing, and terminal capability contracts.", .compact_summary = "compatibility output helpers and generic stream umbrella. Existing File-based print/write/read_line procedures remain source compatible. Importing Io...", .source_path = "std/Io.glo", .first_symbol = 739, .symbol_count = 6 },
    .{ .name = "Io/Adapters", .summary = "composable static stream adapters. Import with: #import \"Io/Adapters\"; Adapters borrow their underlying streams through pointers. The caller keeps those streams alive for the lifetime of the adapter. Memory_Writer is the sole owning adapter here. It captures its allocator and its deinit operation is safe to repeat.", .compact_summary = "composable static stream adapters. Import with: #import \"Io/Adapters\"; Adapters borrow their underlying streams through pointers. The caller keeps...", .source_path = "std/Io/Adapters.glo", .first_symbol = 745, .symbol_count = 41 },
    .{ .name = "Io/Binary", .summary = "allocation-light binary stream codecs. Import with: #import \"Io/Binary\"; The codecs use the static Reader/Writer protocols from Io/Core. Integer and floating-point functions preserve the exact on-wire byte order. The generic packed helpers accept widths from one through 128 bits.", .compact_summary = "allocation-light binary stream codecs. Import with: #import \"Io/Binary\"; The codecs use the static Reader/Writer protocols from Io/Core. Integer and...", .source_path = "std/Io/Binary.glo", .first_symbol = 786, .symbol_count = 62 },
    .{ .name = "Io/Buffer", .summary = "reusable buffered stream adapters. Buffered readers and writers own their byte storage. Their underlying stream is borrowed through a pointer and must outlive the adapter. Reader peek results are borrowed views which remain valid until the next reader operation, reset, or deinit. Byte arrays returned by delimiter and line helpers are owned by the caller and must be released with array_free. Buffered writer deinit does not flush unless explicitly requested. This makes loss of pending output a deliberate choice rather than a destructor side effect.", .compact_summary = "reusable buffered stream adapters. Buffered readers and writers own their byte storage. Their underlying stream is borrowed through a pointer and...", .source_path = "std/Io/Buffer.glo", .first_symbol = 848, .symbol_count = 24 },
    .{ .name = "Io/Core", .summary = "allocation-free stream contracts and common result types. The interfaces in this module are static typeclasses. Implementations keep their state in an ordinary value and receive a pointer to that value, so a call does not require a heap-allocated interface object or a runtime vtable.", .compact_summary = "allocation-free stream contracts and common result types. The interfaces in this module are static typeclasses. Implementations keep their state in...", .source_path = "std/Io/Core.glo", .first_symbol = 872, .symbol_count = 40 },
    .{ .name = "Io/Format", .summary = "formatting directly into a Writer. The formatter never builds one aggregate output string. Literal text, strings, booleans, and integers are emitted through fixed stack buffers. Other Show implementations are supported as a compatibility fallback and may allocate their individual textual representation.", .compact_summary = "formatting directly into a Writer. The formatter never builds one aggregate output string. Literal text, strings, booleans, and integers are emitted...", .source_path = "std/Io/Format.glo", .first_symbol = 912, .symbol_count = 11 },
    .{ .name = "Io/Hash", .summary = "streams which hash bytes successfully transferred.", .compact_summary = "streams which hash bytes successfully transferred.", .source_path = "std/Io/Hash.glo", .first_symbol = 923, .symbol_count = 6 },
    .{ .name = "Io/Scan", .summary = "reusable allocation-light token scanning. A scanner owns one reusable byte buffer. A token is a borrowed view into that buffer and remains valid until the next call to io_scanner_scan, reset, or deinit. Split procedures never allocate: they describe how many source bytes to advance and which subrange is the next token.", .compact_summary = "reusable allocation-light token scanning. A scanner owns one reusable byte buffer. A token is a borrowed view into that buffer and remains valid...", .source_path = "std/Io/Scan.glo", .first_symbol = 929, .symbol_count = 20 },
    .{ .name = "Io/Terminal", .summary = "portable terminal capability and mode contracts. The concrete File instance uses the Os terminal boundary. This module contains no public libc dependency and keeps ANSI output separate from capability discovery.", .compact_summary = "portable terminal capability and mode contracts. The concrete File instance uses the Os terminal boundary. This module contains no public libc...", .source_path = "std/Io/Terminal.glo", .first_symbol = 949, .symbol_count = 16 },
    .{ .name = "Io/Transfer", .summary = "allocation-light transfer algorithms over Io/Core.", .compact_summary = "allocation-light transfer algorithms over Io/Core.", .source_path = "std/Io/Transfer.glo", .first_symbol = 965, .symbol_count = 8 },
    .{ .name = "Io/Vector", .summary = "portable gather/scatter and positional vector I/O. Io_Byte_Vector deliberately stores a mutable byte view because Glosso does not yet have a distinct const-slice type. Writers do not modify the bytes.", .compact_summary = "portable gather/scatter and positional vector I/O. Io_Byte_Vector deliberately stores a mutable byte view because Glosso does not yet have a distinct...", .source_path = "std/Io/Vector.glo", .first_symbol = 973, .symbol_count = 11 },
    .{ .name = "Jump", .summary = "explicit control transfer built on resumable contexts. A label is only a code address. Execution_Context owns the resumable machine state, payload inbox, and logical execution-local state. goto is the sole public transfer operation used by setjmp, exceptions, coroutines, and the scheduler.", .compact_summary = "explicit control transfer built on resumable contexts. A label is only a code address. Execution_Context owns the resumable machine state, payload...", .source_path = "std/Jump.glo", .first_symbol = 984, .symbol_count = 50 },
    .{ .name = "Lua", .summary = "Lua 5.5 C API with a source-built static runtime. Importing this module compiles the bundled target-independent C sources for the output target, caches a static archive, and inserts target-aware bindings.", .compact_summary = "Lua 5.5 C API with a source-built static runtime. Importing this module compiles the bundled target-independent C sources for the output target,...", .source_path = "std/Lua/module.glo", .first_symbol = 1034, .symbol_count = 0 },
    .{ .name = "Lua/Build", .summary = "source-level Lua 5.5 binding/build helpers. This component has no top-level build side effects. `#import \"Lua\"` uses static_bindings_source() below. Applications which deliberately ship a shared Lua runtime can `#import \"Lua/Build\"` and insert dynamic_bindings_source(path) from an application-owned bindings module.", .compact_summary = "source-level Lua 5.5 binding/build helpers. This component has no top-level build side effects. `#import \"Lua\"` uses static_bindings_source() below....", .source_path = "std/Lua/Build.glo", .first_symbol = 1034, .symbol_count = 2 },
    .{ .name = "Math/Bignum", .summary = "explicitly owned arbitrary-precision integers and floats. Import this component with: #import \"Math/Bignum\"; BigInt and BigFloat contain dynamic arrays. Assignment copies their backing pointers; it does not clone the allocation. Treat values returned by this module as owned, use bigint_clone/bigfloat_clone for an independent copy, and call bigint_deinit/bigfloat_deinit exactly once for every owned value. Arithmetic operators allocate with context.allocator. The named functions accept an allocator when the caller needs explicit lifetime control. Custom allocators used here must provide Resize and Free because Glosso's dynamic-array value does not retain its allocator. Allocation failure is not currently representable by the array API.", .compact_summary = "explicitly owned arbitrary-precision integers and floats. Import this component with: #import \"Math/Bignum\"; BigInt and BigFloat contain dynamic...", .source_path = "std/Math/Bignum/module.glo", .first_symbol = 1036, .symbol_count = 0 },
    .{ .name = "Math/Bignum/BigFloat", .summary = "Arbitrary-precision binary floating-point values. A finite value is mantissa * 2^exponent. The mantissa is an owned BigInt and precision is the maximum retained magnitude bit count. Normalization rounds to nearest, ties to even, then removes exact powers of two from the mantissa. This initial core intentionally has no NaN/infinity/subnormal classifications, decimal parser/formatter, selectable rounding modes, or status flags. f64 construction rejects non-finite inputs; division reports a zero divisor. Exponent arithmetic is s64 and presently unchecked. Addition and comparison align operands by materializing a BigInt shift, so an extreme exponent gap can require a correspondingly large allocation. Show is diagnostic: it converts through f64 and can therefore lose arbitrary precision.", .compact_summary = "Arbitrary-precision binary floating-point values. A finite value is mantissa * 2^exponent. The mantissa is an owned BigInt and precision is the...", .source_path = "std/Math/Bignum/BigFloat.glo", .first_symbol = 1036, .symbol_count = 18 },
    .{ .name = "Math/Bignum/BigInt", .summary = "Arbitrary-precision signed integers. Representation: little-endian base-2^32 magnitude limbs plus a sign bit. Canonical zero has no limbs and is never negative. Division uses a portable binary long-division reference algorithm; multiplication is quadratic. These algorithms are deliberately architecture-neutral and VM-compatible. Faster carry/multiply kernels can replace the private magnitude routines without changing the public ownership or arithmetic contracts.", .compact_summary = "Arbitrary-precision signed integers. Representation: little-endian base-2^32 magnitude limbs plus a sign bit. Canonical zero has no limbs and is...", .source_path = "std/Math/Bignum/BigInt.glo", .first_symbol = 1054, .symbol_count = 33 },
    .{ .name = "Math/Bit", .summary = "portable finite-width bit and checked arithmetic helpers. The compatibility API below operates primarily on u64. BitArithmetic is the width-preserving generic API; every built-in signed and unsigned integer type has an instance. LLVM recognizes the branch-free helper idioms and selects target instructions when the output ISA provides them.", .compact_summary = "portable finite-width bit and checked arithmetic helpers. The compatibility API below operates primarily on u64. BitArithmetic is the...", .source_path = "std/Math/Bit.glo", .first_symbol = 1087, .symbol_count = 37 },
    .{ .name = "Math/Complex", .summary = "fixed-width primitive complex numbers. c32, c64, c128, c160, and c256 pair f16, f32, f64, f80, and f128 components respectively. Construction is explicit: Glosso intentionally has no complex literal or implicit scalar/complex conversion. The compile-time VM follows its scalar representation: c32 and c64 component operations round to binary16 and binary32 with round-to-nearest, ties-to-even; c128 uses binary64; and c160/c256 calculations have binary64 precision. Native LLVM uses x87 extended precision for f80/c160 on x86 and x86-64. Other CPUs use an fp128 storage carrier, but incoming values and arithmetic results are explicitly rounded to binary80 precision. This preserves f80's 16-byte size and c160's 32-byte size; alignment is 16 on most targets and follows the target fp128 ABI (8 on s390x). The non-x86 carrier byte representation is IEEE binary128, not an x87-compatible image. Primitive complex and Simd values deliberately have no portable by-value C ABI: #c_call rejects them recursively in aggregates and callable signatures. Opaque pointers remain allowed; otherwise pass real and imaginary components.", .compact_summary = "fixed-width primitive complex numbers. c32, c64, c128, c160, and c256 pair f16, f32, f64, f80, and f128 components respectively. Construction is...", .source_path = "std/Math/Complex.glo", .first_symbol = 1124, .symbol_count = 25 },
    .{ .name = "Math/Constants", .summary = "mathematical and IEEE-754 binary floating constants. Constants without a type suffix are f64. Mathematical constants use an `_F16`/`_F32`/`_F64`/`_F80`/`_F128` suffix for an explicitly typed alternative. Format metadata keeps the established `Fxx_` prefix.", .compact_summary = "mathematical and IEEE-754 binary floating constants. Constants without a type suffix are f64. Mathematical constants use an...", .source_path = "std/Math/Constants.glo", .first_symbol = 1149, .symbol_count = 46 },
    .{ .name = "Math/Core", .summary = "portable scalar mathematics and Haskell-inspired numeric classes. Import this component explicitly; there is intentionally no umbrella `#import \"Math\"` module. Glosso typeclasses are statically monomorphized. Fractional, Floating, and RealFloat mirror the useful shape of Haskell's hierarchy while keeping conversions explicit. Scalar transcendental functions currently have f32 and f64 implementations; Fractional covers every primitive float width.", .compact_summary = "portable scalar mathematics and Haskell-inspired numeric classes. Import this component explicitly; there is intentionally no umbrella `#import...", .source_path = "std/Math/Core.glo", .first_symbol = 1195, .symbol_count = 80 },
    .{ .name = "Math/Matrix", .summary = "statically shaped, inline, row-major matrices. Matrix(T, Row, Col) is a compiler-provided value type, not a dynamic container. Row and Col are non-negative compile-time integers. A matrix has exactly Row * Col inline T values and no allocator, capacity, owner, or view state. Matrix values use ordinary value semantics. The flat index of (row, column) is row * Col + column. Large matrices are correspondingly large values. Pass a pointer when a caller should mutate or avoid copying one, and pass scalar storage through a pointer at C ABI boundaries; Matrix has no portable by-value C ABI.", .compact_summary = "statically shaped, inline, row-major matrices. Matrix(T, Row, Col) is a compiler-provided value type, not a dynamic container. Row and Col are...", .source_path = "std/Math/Matrix.glo", .first_symbol = 1275, .symbol_count = 24 },
    .{ .name = "Math/NumberTheory", .summary = "finite-width integer algorithms. This component is deliberately separate from Math/Core. Algorithms whose result may exceed u64 return Checked_U64 instead of silently wrapping.", .compact_summary = "finite-width integer algorithms. This component is deliberately separate from Math/Core. Algorithms whose result may exceed u64 return Checked_U64...", .source_path = "std/Math/NumberTheory.glo", .first_symbol = 1299, .symbol_count = 18 },
    .{ .name = "Math/SpecialFunctions", .summary = "Math/SpecialFunctions is a multi-file module. All direct .glo siblings in this marked directory form the module; this file intentionally has no declarations.", .compact_summary = "Math/SpecialFunctions is a multi-file module. All direct .glo siblings in this marked directory form the module; this file intentionally has no...", .source_path = "std/Math/SpecialFunctions/module.glo", .first_symbol = 1317, .symbol_count = 0 },
    .{ .name = "Math/SpecialFunctions/Airy", .summary = "Math/SpecialFunctions Airy Ai/Bi and first derivatives. Central values use convergent ODE power series. The tails use the full-double Cephes rational minimax approximations, avoiding the severe Ai cancellation and low-order asymptotic truncation of the former implementation. Cephes Math Library Release 2.8, Copyright 1984-2000 S. L. Moshier. Netlib permits free use without support or guarantee: https://www.netlib.org/cephes/readme", .compact_summary = "Math/SpecialFunctions Airy Ai/Bi and first derivatives. Central values use convergent ODE power series. The tails use the full-double Cephes rational...", .source_path = "std/Math/SpecialFunctions/Airy.glo", .first_symbol = 1317, .symbol_count = 5 },
    .{ .name = "Math/SpecialFunctions/Bessel", .summary = "Math/SpecialFunctions cylindrical and modified Bessel functions. The order-zero and order-one kernels use the full-double Cephes rational/Chebyshev approximations. Cephes Math Library Release 2.8, Copyright 1984-2000 S. L. Moshier. Netlib permits free use without support or guarantee: https://www.netlib.org/cephes/readme Integer J uses stable forward recurrence when x dominates the order and Miller backward recurrence otherwise. Modified functions use scaled Chebyshev kernels so the exponential is applied only once.", .compact_summary = "Math/SpecialFunctions cylindrical and modified Bessel functions. The order-zero and order-one kernels use the full-double Cephes rational/Chebyshev...", .source_path = "std/Math/SpecialFunctions/Bessel.glo", .first_symbol = 1322, .symbol_count = 14 },
    .{ .name = "Math/SpecialFunctions/Common", .summary = "Math/SpecialFunctions common definitions. Portable f64 and c128 special functions. This component deliberately uses ordinary finite-precision algorithms: results are not interval enclosures and do not claim FLINT/Arb-style rigor. Iterative APIs expose a status, iteration count, and heuristic truncation/residual estimate so callers can distinguish a domain error from a convergence cap.", .compact_summary = "Math/SpecialFunctions common definitions. Portable f64 and c128 special functions. This component deliberately uses ordinary finite-precision...", .source_path = "std/Math/SpecialFunctions/Common.glo", .first_symbol = 1336, .symbol_count = 18 },
    .{ .name = "Math/SpecialFunctions/Complex", .summary = "Math/SpecialFunctions principal-branch c128 functions. These routines are finite precision and return convergence status where a capped series is involved. Series APIs state their natural convergence limits through status instead of pretending to provide arbitrary-precision analytic continuation.", .compact_summary = "Math/SpecialFunctions principal-branch c128 functions. These routines are finite precision and return convergence status where a capped series is...", .source_path = "std/Math/SpecialFunctions/Complex.glo", .first_symbol = 1354, .symbol_count = 31 },
    .{ .name = "Math/SpecialFunctions/Gamma", .summary = "Math/SpecialFunctions gamma-family functions. The real gamma kernel is a direct, compensated 13-term Lanczos evaluation (the double-precision Pugh/Boost coefficients used by musl), rather than exp(log_gamma(x)). log-gamma uses that kernel on the small interval and a minimax Stirling correction for large arguments. Reflection always reduces the argument before multiplying by pi; this is essential close to negative integer poles and for large representable arguments.", .compact_summary = "Math/SpecialFunctions gamma-family functions. The real gamma kernel is a direct, compensated 13-term Lanczos evaluation (the double-precision...", .source_path = "std/Math/SpecialFunctions/Gamma.glo", .first_symbol = 1385, .symbol_count = 26 },
    .{ .name = "Math/SpecialFunctions/Hypergeometric", .summary = "Math/SpecialFunctions generalized hypergeometric series and specializations. pFq reports No_Convergence for a structurally divergent p > q + 1 series. The real 2F1 API covers x < 1 and the convergent Gauss value at x = 1; analytic continuation across the [1, infinity) branch cut belongs to the complex API.", .compact_summary = "Math/SpecialFunctions generalized hypergeometric series and specializations. pFq reports No_Convergence for a structurally divergent p > q + 1...", .source_path = "std/Math/SpecialFunctions/Hypergeometric.glo", .first_symbol = 1411, .symbol_count = 7 },
    .{ .name = "Math/SpecialFunctions/Integrals", .summary = "Math/SpecialFunctions exponential, logarithmic, trigonometric, hyperbolic, and Fresnel integrals. Real-valued APIs use their conventional real domains. In particular Ci, Chi, E1, and li return Domain/Pole status rather than silently selecting a complex branch.", .compact_summary = "Math/SpecialFunctions exponential, logarithmic, trigonometric, hyperbolic, and Fresnel integrals. Real-valued APIs use their conventional real...", .source_path = "std/Math/SpecialFunctions/Integrals.glo", .first_symbol = 1418, .symbol_count = 17 },
    .{ .name = "Math/SpecialFunctions/Zeta", .summary = "Math/SpecialFunctions zeta, eta, and polylogarithm. Euler--Maclaurin is used directly on the complete positive half-line, not only for s > 1. This avoids dividing a cancellation-prone finite Euler transform by 1-2^(1-s). Negative arguments use a logarithmically scaled functional equation, so individually overflowing powers and Gamma factors do not destroy a representable final result.", .compact_summary = "Math/SpecialFunctions zeta, eta, and polylogarithm. Euler--Maclaurin is used directly on the complete positive half-line, not only for s > 1. This...", .source_path = "std/Math/SpecialFunctions/Zeta.glo", .first_symbol = 1435, .symbol_count = 9 },
    .{ .name = "Memory", .summary = "raw memory operations and generic slice algorithms. Import this component with: #import \"Memory\"; A []T is a borrowed view. Procedures whose name contains \"in_place\", and procedures such as slice_reverse, slice_rotate_left, slice_partition, and slice_fill, mutate the storage behind that view. Every [..]T returned by this module is an owned dynamic array allocated with the current context allocator. The caller must eventually call array_free(*result). Slice_Range values are half-open [start, end) indexes into the original input and never own the underlying elements. Raw memory procedures use byte counts. A negative count is rejected. A zero count succeeds even when a pointer is null. memory_move and memory_copy are safe for arbitrary overlap; the explicitly directional/non-overlapping variants validate their overlap contract and return false on misuse. Runtime-backed native targets and WebAssembly lower raw copy/move/fill to memcpy/memmove/memset. Other libc-free targets use internal byte-loop helpers. Generic slice copies retain element-sized counts, and the VM preserves their value semantics. Non-overlapping raw entry points use noalias pointer parameters after retaining the public validation behavior. Pattern(P, E) unifies forward searches over []E. Built-in patterns are one element, a contiguous []E subsequence, a noncapturing (E) -> bool predicate, and Any_Of(E). ReversePattern(P, E) adds reverse search without requiring every custom forward pattern to be reversible. Matches use half-open [start, end) indexes. Empty subsequences match boundaries for find/contains, retain the legacy count of zero, and act as no separator when splitting.", .compact_summary = "raw memory operations and generic slice algorithms. Import this component with: #import \"Memory\"; A []T is a borrowed view. Procedures whose name...", .source_path = "std/Memory/module.glo", .first_symbol = 1444, .symbol_count = 2 },
    .{ .name = "Memory/Functional", .summary = "Allocation-returning transforms and folds.", .compact_summary = "Allocation-returning transforms and folds.", .source_path = "std/Memory/Functional.glo", .first_symbol = 1446, .symbol_count = 9 },
    .{ .name = "Memory/Pattern", .summary = "Rust-inspired, slice-generic pattern searching. Pattern(P, E) deliberately has two parameters: the same pattern type may represent one element in one haystack and a subsequence in another.", .compact_summary = "Rust-inspired, slice-generic pattern searching. Pattern(P, E) deliberately has two parameters: the same pattern type may represent one element in one...", .source_path = "std/Memory/Pattern.glo", .first_symbol = 1455, .symbol_count = 10 },
    .{ .name = "Memory/Ranges", .summary = "Range-producing split/chunk/window operations and explicit-type flattening.", .compact_summary = "Range-producing split/chunk/window operations and explicit-type flattening.", .source_path = "std/Memory/Ranges.glo", .first_symbol = 1465, .symbol_count = 8 },
    .{ .name = "Memory/Raw", .summary = "Raw byte-memory operations.", .compact_summary = "Raw byte-memory operations.", .source_path = "std/Memory/Raw.glo", .first_symbol = 1473, .symbol_count = 8 },
    .{ .name = "Memory/Search", .summary = "Equality, search, subsequence, and lexicographic algorithms.", .compact_summary = "Equality, search, subsequence, and lexicographic algorithms.", .source_path = "std/Memory/Search.glo", .first_symbol = 1481, .symbol_count = 19 },
    .{ .name = "Memory/Set", .summary = "Ordered deduplication and equality-based set operations. Set results preserve first-occurrence order and contain no duplicates. These generic implementations use linear membership checks and therefore take O(n^2) time in the worst case without requiring hashing or allocation beyond the returned dynamic array.", .compact_summary = "Ordered deduplication and equality-based set operations. Set results preserve first-occurrence order and contain no duplicates. These generic...", .source_path = "std/Memory/Set.glo", .first_symbol = 1500, .symbol_count = 12 },
    .{ .name = "Memory/Slice", .summary = "Core mutation and copy operations for borrowed slices.", .compact_summary = "Core mutation and copy operations for borrowed slices.", .source_path = "std/Memory/Slice.glo", .first_symbol = 1512, .symbol_count = 13 },
    .{ .name = "Meta", .summary = "Public declarations from std/Meta/module.glo.", .compact_summary = "Public declarations from std/Meta/module.glo.", .source_path = "std/Meta/module.glo", .first_symbol = 1525, .symbol_count = 0 },
    .{ .name = "Meta/Types", .summary = "std/types.glo — core type metadata and compile-time type introspection. A type is a first-class compile-time value: it can be compared (T == s32, T != f64). These predicates classify a type variable, the way Jai uses type_info(T).tag. They are evaluated at compile time (in where clauses).", .compact_summary = "std/types.glo — core type metadata and compile-time type introspection. A type is a first-class compile-time value: it can be compared (T == s32, T...", .source_path = "std/Meta/Types.glo", .first_symbol = 1525, .symbol_count = 20 },
    .{ .name = "Meta/Utilities", .summary = "std/Meta/Utilities.glo: compile-time type introspection (metaprogramming), Jai-style. Every procedure here is a compile-time intrinsic: each call is folded to a constant by the compiler while it still knows the type. They are meant to be used in compile-time positions: `#comptime`, `#insert`, `#if`, constant initialisers, and `where` clauses. They inspect and traverse types and generate code from them. A `type` value is obtained by naming a type (`size_of(s32)`) or via a `T: type` parameter. Type identity. The static type of an expression.", .compact_summary = "std/Meta/Utilities.glo: compile-time type introspection (metaprogramming), Jai-style. Every procedure here is a compile-time intrinsic: each call is...", .source_path = "std/Meta/Utilities.glo", .first_symbol = 1545, .symbol_count = 13 },
    .{ .name = "Net/Address", .summary = "Structured Internet, endpoint, subnet, host/port, and Unix-domain addresses.", .compact_summary = "Structured Internet, endpoint, subnet, host/port, and Unix-domain addresses.", .source_path = "std/Net/Address.glo", .first_symbol = 1558, .symbol_count = 47 },
    .{ .name = "Net/Async", .summary = "Nonblocking operation helpers. Buffers and sockets remain caller-owned.", .compact_summary = "Nonblocking operation helpers. Buffers and sockets remain caller-owned.", .source_path = "std/Net/Async.glo", .first_symbol = 1605, .symbol_count = 8 },
    .{ .name = "Net/Certificate", .summary = "Minimal strict DER X.509 parser used for inspection and hostname checks. Returned fields are borrowed views into the caller-owned DER bytes.", .compact_summary = "Minimal strict DER X.509 parser used for inspection and hostname checks. Returned fields are borrowed views into the caller-owned DER bytes.", .source_path = "std/Net/Certificate.glo", .first_symbol = 1613, .symbol_count = 7 },
    .{ .name = "Net/Dns", .summary = "DNS client with explicit record results and UDP-to-TCP truncation fallback.", .compact_summary = "DNS client with explicit record results and UDP-to-TCP truncation fallback.", .source_path = "std/Net/Dns.glo", .first_symbol = 1620, .symbol_count = 12 },
    .{ .name = "Net/Dns_Types", .summary = "Shared DNS record and result types. Import explicitly.", .compact_summary = "Shared DNS record and result types. Import explicitly.", .source_path = "std/Net/Dns_Types.glo", .first_symbol = 1632, .symbol_count = 7 },
    .{ .name = "Net/Encoding", .summary = "Percent encoding for URI components. Base64URL lives in Crypto/Encoding.", .compact_summary = "Percent encoding for URI components. Base64URL lives in Crypto/Encoding.", .source_path = "std/Net/Encoding.glo", .first_symbol = 1639, .symbol_count = 5 },
    .{ .name = "Net/Hosts", .summary = "hosts-file parsing and lookup, independent of the DNS transport.", .compact_summary = "hosts-file parsing and lookup, independent of the DNS transport.", .source_path = "std/Net/Hosts.glo", .first_symbol = 1644, .symbol_count = 9 },
    .{ .name = "Net/Http", .summary = "Blocking HTTP/1.1 client transport with framing and redirect handling.", .compact_summary = "Blocking HTTP/1.1 client transport with framing and redirect handling.", .source_path = "std/Net/Http.glo", .first_symbol = 1653, .symbol_count = 10 },
    .{ .name = "Net/Http_Auth", .summary = "HTTP Authorization header helpers. Import explicitly.", .compact_summary = "HTTP Authorization header helpers. Import explicitly.", .source_path = "std/Net/Http_Auth.glo", .first_symbol = 1663, .symbol_count = 5 },
    .{ .name = "Net/Http_Server", .summary = "Small blocking HTTP/1.1 server building blocks.", .compact_summary = "Small blocking HTTP/1.1 server building blocks.", .source_path = "std/Net/Http_Server.glo", .first_symbol = 1668, .symbol_count = 11 },
    .{ .name = "Net/Http_Types", .summary = "HTTP request, response, method, status, and owned header types.", .compact_summary = "HTTP request, response, method, status, and owned header types.", .source_path = "std/Net/Http_Types.glo", .first_symbol = 1679, .symbol_count = 27 },
    .{ .name = "Net/Https", .summary = "Blocking HTTPS client. Windows uses WinHTTP and the native certificate store; other hosted targets use the verified TLS stream from Net/Tls.", .compact_summary = "Blocking HTTPS client. Windows uses WinHTTP and the native certificate store; other hosted targets use the verified TLS stream from Net/Tls.", .source_path = "std/Net/Https.glo", .first_symbol = 1706, .symbol_count = 3 },
    .{ .name = "Net/Interface", .summary = "Interface metadata types. Interface enumeration is capability-gated because WASI preview1 and some freestanding targets expose no link-layer interface API. Native backends currently report Unsupported rather than synthesize inaccurate interface or physical-address data.", .compact_summary = "Interface metadata types. Interface enumeration is capability-gated because WASI preview1 and some freestanding targets expose no link-layer...", .source_path = "std/Net/Interface.glo", .first_symbol = 1709, .symbol_count = 4 },
    .{ .name = "Net/Platform", .summary = "Internal socket ABI bridge for Linux, Windows, macOS, and FreeBSD. WASI preview1 has no socket ABI, so wrappers report unsupported there.", .compact_summary = "Internal socket ABI bridge for Linux, Windows, macOS, and FreeBSD. WASI preview1 has no socket ABI, so wrappers report unsupported there.", .source_path = "std/Net/Platform.glo", .first_symbol = 1713, .symbol_count = 0 },
    .{ .name = "Net/Poll", .summary = "Portable readiness polling over explicit socket entries.", .compact_summary = "Portable readiness polling over explicit socket entries.", .source_path = "std/Net/Poll.glo", .first_symbol = 1713, .symbol_count = 2 },
    .{ .name = "Net/Resolver", .summary = "DNS resolver configuration parsing and system discovery.", .compact_summary = "DNS resolver configuration parsing and system discovery.", .source_path = "std/Net/Resolver.glo", .first_symbol = 1715, .symbol_count = 6 },
    .{ .name = "Net/Socket", .summary = "Cross-platform TCP, UDP, Unix-domain, options, deadlines, and partial I/O.", .compact_summary = "Cross-platform TCP, UDP, Unix-domain, options, deadlines, and partial I/O.", .source_path = "std/Net/Socket.glo", .first_symbol = 1721, .symbol_count = 54 },
    .{ .name = "Net/Tls", .summary = "Verified TLS client stream backed by the platform OpenSSL-compatible ABI. The API is declared directly in Glosso (no generated C header). Peer-chain and hostname verification are mandatory by default. Callers may supply an explicit PEM trust bundle or directory; otherwise the provider's native default trust paths are loaded.", .compact_summary = "Verified TLS client stream backed by the platform OpenSSL-compatible ABI. The API is declared directly in Glosso (no generated C header). Peer-chain...", .source_path = "std/Net/Tls.glo", .first_symbol = 1775, .symbol_count = 15 },
    .{ .name = "Net/Trust_Store", .summary = "PEM trust-bundle loading and parsed certificate storage.", .compact_summary = "PEM trust-bundle loading and parsed certificate storage.", .source_path = "std/Net/Trust_Store.glo", .first_symbol = 1790, .symbol_count = 6 },
    .{ .name = "Net/Types", .summary = "Shared networking status and operation types. Import explicitly.", .compact_summary = "Shared networking status and operation types. Import explicitly.", .source_path = "std/Net/Types.glo", .first_symbol = 1796, .symbol_count = 17 },
    .{ .name = "Net/Url", .summary = "RFC 3986-style URI/URL parsing, formatting, reference resolution, and query.", .compact_summary = "RFC 3986-style URI/URL parsing, formatting, reference resolution, and query.", .source_path = "std/Net/Url.glo", .first_symbol = 1813, .symbol_count = 16 },
    .{ .name = "Net/WebSocket", .summary = "RFC 6455 client upgrade and framing over plain TCP or verified TLS.", .compact_summary = "RFC 6455 client upgrade and framing over plain TCP or verified TLS.", .source_path = "std/Net/WebSocket.glo", .first_symbol = 1829, .symbol_count = 14 },
    .{ .name = "Os", .summary = "target OS primitive boundary. Higher-level std modules call this module for host services. Platform files hold the low-level bindings/intrinsics; File_System/File, File_System, and Thread do not.", .compact_summary = "target OS primitive boundary. Higher-level std modules call this module for host services. Platform files hold the low-level bindings/intrinsics;...", .source_path = "std/Os/module.glo", .first_symbol = 1843, .symbol_count = 91 },
