    .{ .name = "File_System", .summary = "essential filesystem prelude and compatibility API. The typed handle/error API, lazy directory cursor, and complete lexical path grammar are included here. Larger facilities (Metadata, Copy, Temporary, Atomic, Walk, Map, Watch, and Sandbox) remain explicit imports so a simple filesystem import does not pull every platform service into the program.", .compact_summary = "essential filesystem prelude and compatibility API. The typed handle/error API, lazy directory cursor, and complete lexical path grammar are included...", .source_path = "std/File_System.glo", .first_symbol = 409, .symbol_count = 26 },
