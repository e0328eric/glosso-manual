    .{ .name = "Crypto/Random", .summary = "Cryptographic random byte and key generation. This deliberately delegates only to Random/Entropy, whose implementations use the operating system CSPRNG (BCryptGenRandom, getentropy/getrandom, or WASI random_get). Deterministic Random engines are never accepted here.", .compact_summary = "Cryptographic random byte and key generation. This deliberately delegates only to Random/Entropy, whose implementations use the operating system...", .source_path = "std/Crypto/Random.glo", .first_symbol = 356, .symbol_count = 4 },
    .{ .name = "Crypto/Sha1", .summary = "SHA-1 (FIPS 180-4). SHA-1 is retained for protocol compatibility (notably WebSocket's opening handshake). New authentication and signature designs must use SHA-2 or SHA-3.", .compact_summary = "SHA-1 (FIPS 180-4). SHA-1 is retained for protocol compatibility (notably WebSocket's opening handshake). New authentication and signature designs...", .source_path = "std/Crypto/Sha1.glo", .first_symbol = 360, .symbol_count = 6 },
