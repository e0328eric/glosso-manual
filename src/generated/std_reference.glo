    .{ .name = "Random", .summary = "deterministic generators, OS entropy, sampling, and distributions.", .compact_summary = "deterministic generators, OS entropy, sampling, and distributions.", .source_path = "std/Random/module.glo", .first_symbol = 2240, .symbol_count = 58 },
    .{ .name = "Random/Additional_Engines", .summary = "Additional deterministic, non-cryptographic engines. The algorithms and vectors below match Zig's std.Random implementations: std/Random/Xoroshiro128.zig std/Random/Sfc64.zig std/Random/Isaac64.zig", .compact_summary = "Additional deterministic, non-cryptographic engines. The algorithms and vectors below match Zig's std.Random implementations:...", .source_path = "std/Random/Additional_Engines.glo", .first_symbol = 2298, .symbol_count = 19 },
    .{ .name = "Random/Ascon", .summary = "Reverie CSPRNG instantiated with the little-endian Ascon(128,12,8) permutation, matching Zig 0.16 std/Random/Ascon.zig. References: A Robust and Sponge-Like PRNG with Improved Efficiency, ePrint 2016/886 Ascon v1.2 / NIST lightweight-cryptography permutation Exact Zig 0.16 vectors (one 64-byte fill): seed 00*32: ac1cc35e97c91e713604acf63a9ba474c074792c958554f23ef2c0a3c2f3546b b8da56b9827d54b621d21bb301bfb9202619e1fd5175b7b4f68d2759b91e966f seed 000102...1f: d8911ae81c0518fb489bff7d93e880515299d23ef91520fbe3b863ccaa846ace 79fd2891d72d584041a6996b9b8224b472e53ab4d97620c33bcd0802f0ef08c6 After adding bytes a0..c4 to seed 000102...1f, a 32-byte fill is: 55b33334b18312af8c9d7ad61d5a9b75b031ec5a3f17423929f167834a9d5391", .compact_summary = "Reverie CSPRNG instantiated with the little-endian Ascon(128,12,8) permutation, matching Zig 0.16 std/Random/Ascon.zig. References: A Robust and...", .source_path = "std/Random/Ascon.glo", .first_symbol = 2317, .symbol_count = 13 },
    .{ .name = "Random/Distributions", .summary = "Probability distributions built on Random_Generator. Every try_random_* sampler validates its parameters, writes zero on failure, and returns false when either validation or the underlying entropy read fails. Convenience random_* samplers return that zero value when sampling fails.", .compact_summary = "Probability distributions built on Random_Generator. Every try_random_* sampler validates its parameters, writes zero on failure, and returns false...", .source_path = "std/Random/Distributions.glo", .first_symbol = 2330, .symbol_count = 26 },
    .{ .name = "Random/Engines", .summary = "Deterministic engines. Constructors retain their initial seed so the Context vtable Reset operation is reproducible.", .compact_summary = "Deterministic engines. Constructors retain their initial seed so the Context vtable Reset operation is reproducible.", .source_path = "std/Random/Engines.glo", .first_symbol = 2356, .symbol_count = 29 },
    .{ .name = "Random/Entropy", .summary = "Fills memory from the operating system cryptographic random source. Freestanding WebAssembly has no ambient entropy capability and returns false; WASI calls the random_get capability through a compiler-provided import.", .compact_summary = "Fills memory from the operating system cryptographic random source. Freestanding WebAssembly has no ambient entropy capability and returns false;...", .source_path = "std/Random/Entropy.glo", .first_symbol = 2385, .symbol_count = 2 },
    .{ .name = "Serialization/Core", .summary = "format-neutral serialization data model. Serialization is a family of peer modules. There is intentionally no `Serialization` umbrella import; programs import this file or one of Serialization/Json, Serialization/Toml, Serialization/Yaml, and Serialization/MessagePack directly.", .compact_summary = "format-neutral serialization data model. Serialization is a family of peer modules. There is intentionally no `Serialization` umbrella import;...", .source_path = "std/Serialization/Core.glo", .first_symbol = 2387, .symbol_count = 47 },
    .{ .name = "Serialization/Json", .summary = "JSON serialization and deserialization.", .compact_summary = "JSON serialization and deserialization.", .source_path = "std/Serialization/Json.glo", .first_symbol = 2434, .symbol_count = 9 },
    .{ .name = "Serialization/MessagePack", .summary = "MessagePack binary serialization. Encoded MessagePack is arbitrary binary data. Serializers therefore return an owned `[..]u8`; deserializers borrow a `[]u8` view. MessagePack extension records are preserved as Serialization_Value.extension.", .compact_summary = "MessagePack binary serialization. Encoded MessagePack is arbitrary binary data. Serializers therefore return an owned `[..]u8`; deserializers borrow...", .source_path = "std/Serialization/MessagePack.glo", .first_symbol = 2443, .symbol_count = 11 },
    .{ .name = "Serialization/Toml", .summary = "TOML document serialization and deserialization. The root is a table. Nested structures are emitted as inline tables, which keeps derived values deterministic and permits a streaming, allocation-light implementation without hiding table ordering behind an umbrella module.", .compact_summary = "TOML document serialization and deserialization. The root is a table. Nested structures are emitted as inline tables, which keeps derived values...", .source_path = "std/Serialization/Toml.glo", .first_symbol = 2454, .symbol_count = 9 },
    .{ .name = "Serialization/Yaml", .summary = "YAML 1.2 core-schema serialization. Root structs/maps use block mappings. Child values use JSON-compatible flow style, which YAML 1.2 accepts and which avoids YAML 1.1's surprising scalar coercions (for example yes/no booleans).", .compact_summary = "YAML 1.2 core-schema serialization. Root structs/maps use block mappings. Child values use JSON-compatible flow style, which YAML 1.2 accepts and...", .source_path = "std/Serialization/Yaml.glo", .first_symbol = 2463, .symbol_count = 9 },
    .{ .name = "Simd", .summary = "portable fixed-width vectors. Simd(T, N) is a first-class value type. T is currently any integer lane up to 64 bits, or f32/f64, and N is a literal in 1..64. The compile-time VM executes each lane scalarly. LLVM receives a fixed vector and selects native instructions when the target has them, otherwise it legalizes/scalarizes. A SIMD literal is `#simd` followed by a dot-bracket literal, for example `#simd .[1, 2, 3]`, and requires a contextual `Simd(T, N)` type. Bracket contents are ordinary comma-separated expressions; `...` in schematic documentation is not a source token. An unprefixed dot-bracket literal constructs an ordinary fixed array and is never implicitly reinterpreted as SIMD. Exact-shape `[N]T` and `Simd(T, N)` values can be converted explicitly with cast/acast. `value[index]` extracts one lane and `value[index] = lane` replaces one lane in the value. They use the ordinary `[]` and `[]=` operators and lower to LLVM extractelement/insertelement, with scalar VM implementations. The internal ABI is deliberately not a C ABI: vector register/padding rules differ between targets. Pass an ordinary scalar pointer across an FFI and use simd_load/simd_store. Unlike lane indexing, these transfer every lane between a Simd value and contiguous scalar memory. They support unaligned addresses; the LLVM lowering uses alignment 1. Simd has .count but intentionally no .data field and cannot be sliced or passed to array_view.", .compact_summary = "portable fixed-width vectors. Simd(T, N) is a first-class value type. T is currently any integer lane up to 64 bits, or f32/f64, and N is a literal...", .source_path = "std/Simd.glo", .first_symbol = 2472, .symbol_count = 11 },
    .{ .name = "Sort", .summary = "Generic sorting, ordered searching, heaps, and deterministic permutations. `sort`/`sort_by` are stable. `sort_unstable`/`sort_unstable_by` use a pattern-defeating introsort. Explicit insertion, heap, merge, block, and PDQ-style entry points are also available. Natural-order entry points require PartialOrd because Glosso does not yet have a total `Ord` typeclass. They return false when a comparison is `Ordering.Unordered` (notably for a NaN). Comparator entry points follow the same rule. A false result means the slice may already be partially rearranged; callers that need transactional behavior should validate their ordering first with `is_sorted_by` or use a total comparator. Comparator conventions are shared throughout this module: compare(a, b) == Ordering.Less means that `a` belongs before `b`. Heap APIs build a max-heap, so Greater values rise to the root.", .compact_summary = "Generic sorting, ordered searching, heaps, and deterministic permutations. `sort`/`sort_by` are stable. `sort_unstable`/`sort_unstable_by` use a...", .source_path = "std/Sort/module.glo", .first_symbol = 2483, .symbol_count = 0 },
    .{ .name = "Sort/Algorithms", .summary = "Sorting algorithms.", .compact_summary = "Sorting algorithms.", .source_path = "std/Sort/Algorithms.glo", .first_symbol = 2483, .symbol_count = 24 },
    .{ .name = "Sort/Heap", .summary = "Mutable max-heap operations. A comparison result of Ordering.Greater means that the left value rises toward the root. Every comparison-driven operation reports `ordered=false` if a comparator produces Ordering.Unordered; it is never treated as Equal.", .compact_summary = "Mutable max-heap operations. A comparison result of Ordering.Greater means that the left value rises toward the root. Every comparison-driven...", .source_path = "std/Sort/Heap.glo", .first_symbol = 2507, .symbol_count = 24 },
    .{ .name = "Sort/Permutation", .summary = "Lexicographic permutations, combinations, and small subset enumeration. next/previous permutation use the standard wrap convention: when no next (or previous) ordering exists they restore the first (or last) ordering and return `advanced=false`. Ordering.Unordered is reported without performing the final swap/reversal.", .compact_summary = "Lexicographic permutations, combinations, and small subset enumeration. next/previous permutation use the standard wrap convention: when no next (or...", .source_path = "std/Sort/Permutation.glo", .first_symbol = 2531, .symbol_count = 20 },
    .{ .name = "Sort/Search", .summary = "Searching, order validation, and extrema for slices. Comparator-based procedures accept a three-way comparator. An Ordering.Unordered result invalidates the operation instead of being treated as Ordering.Equal.", .compact_summary = "Searching, order validation, and extrema for slices. Comparator-based procedures accept a three-way comparator. An Ordering.Unordered result...", .source_path = "std/Sort/Search.glo", .first_symbol = 2551, .symbol_count = 32 },
    .{ .name = "String_Builder", .summary = "compile-time and runtime string builder helpers. String_Builder mirrors the useful core:strings builder shape from Odin, adapted to Glosso's pointer-mutating dynamic-array style. The lower-level str_cat/str_repeat helpers remain available for compile-time codegen.", .compact_summary = "compile-time and runtime string builder helpers. String_Builder mirrors the useful core:strings builder shape from Odin, adapted to Glosso's...", .source_path = "std/String_Builder.glo", .first_symbol = 2583, .symbol_count = 37 },
    .{ .name = "Strings/Utf16", .summary = "UTF-16 string helpers. string16 and cstring16 are distinct growable built-in UTF-16 types. Counts and capacities are code-unit counts. cstring16 stores an additional zero code unit at data[count], outside the live count and capacity.", .compact_summary = "UTF-16 string helpers. string16 and cstring16 are distinct growable built-in UTF-16 types. Counts and capacities are code-unit counts. cstring16...", .source_path = "std/Strings/Utf16.glo", .first_symbol = 2620, .symbol_count = 11 },
    .{ .name = "Strings/Utf8", .summary = "UTF-8 string helpers.", .compact_summary = "UTF-8 string helpers.", .source_path = "std/Strings/Utf8.glo", .first_symbol = 2631, .symbol_count = 37 },
    .{ .name = "Terminal", .summary = "a high-level, dependency-free terminal/TUI toolkit. Io/Terminal owns the portable OS boundary (capability discovery and raw mode). This module adds ANSI/VT presentation, structured input, sessions, styling, mouse events, and a buffered cell canvas suitable for games.", .compact_summary = "a high-level, dependency-free terminal/TUI toolkit. Io/Terminal owns the portable OS boundary (capability discovery and raw mode). This module adds...", .source_path = "std/Terminal.glo", .first_symbol = 2668, .symbol_count = 59 },
    .{ .name = "Thread", .summary = "std/Thread.glo: native threading primitives through std/Os. This module is opt-in. WASI currently exposes inert primitives so programs can compile target-gated code, but it does not provide native guest threads.", .compact_summary = "std/Thread.glo: native threading primitives through std/Os. This module is opt-in. WASI currently exposes inert primitives so programs can compile...", .source_path = "std/Thread.glo", .first_symbol = 2727, .symbol_count = 31 },
    .{ .name = "Time", .summary = "clocks, durations, civil calendars, text formats, and TZif zones. Durations and instants use signed nanoseconds. Calendar and Unix timestamp types retain a split seconds/nanoseconds representation so their useful range is not limited by nanosecond multiplication.", .compact_summary = "clocks, durations, civil calendars, text formats, and TZif zones. Durations and instants use signed nanoseconds. Calendar and Unix timestamp types...", .source_path = "std/Time/module.glo", .first_symbol = 2758, .symbol_count = 24 },
    .{ .name = "Time/Calendar", .summary = "Public declarations from std/Time/Calendar.glo.", .compact_summary = "Public declarations from std/Time/Calendar.glo.", .source_path = "std/Time/Calendar.glo", .first_symbol = 2782, .symbol_count = 18 },
    .{ .name = "Time/Core", .summary = "Public declarations from std/Time/Core.glo.", .compact_summary = "Public declarations from std/Time/Core.glo.", .source_path = "std/Time/Core.glo", .first_symbol = 2800, .symbol_count = 52 },
    .{ .name = "Time/Format", .summary = "Public declarations from std/Time/Format.glo.", .compact_summary = "Public declarations from std/Time/Format.glo.", .source_path = "std/Time/Format.glo", .first_symbol = 2852, .symbol_count = 7 },
    .{ .name = "Time/Timezone", .summary = "Public declarations from std/Time/Timezone.glo.", .compact_summary = "Public declarations from std/Time/Timezone.glo.", .source_path = "std/Time/Timezone.glo", .first_symbol = 2859, .symbol_count = 13 },
    .{ .name = "Typeclass", .summary = "Public declarations from std/Typeclass/module.glo.", .compact_summary = "Public declarations from std/Typeclass/module.glo.", .source_path = "std/Typeclass/module.glo", .first_symbol = 2872, .symbol_count = 0 },
    .{ .name = "Typeclass/Applicative", .summary = "Public declarations from std/Typeclass/Applicative.glo.", .compact_summary = "Public declarations from std/Typeclass/Applicative.glo.", .source_path = "std/Typeclass/Applicative.glo", .first_symbol = 2872, .symbol_count = 5 },
    .{ .name = "Typeclass/Derive", .summary = "- support metadata for user-written derive macros. These are generic reflection hooks, not builtin deriving for any typeclass.", .compact_summary = "- support metadata for user-written derive macros. These are generic reflection hooks, not builtin deriving for any typeclass.", .source_path = "std/Typeclass/Derive.glo", .first_symbol = 2877, .symbol_count = 16 },
    .{ .name = "Typeclass/Error", .summary = "Error marks values that can explain themselves at a reporting boundary. Implementations decide how and where to report; command-line errors should normally write a concise diagnostic to stderr.", .compact_summary = "Error marks values that can explain themselves at a reporting boundary. Implementations decide how and where to report; command-line errors should...", .source_path = "std/Typeclass/Error.glo", .first_symbol = 2893, .symbol_count = 2 },
    .{ .name = "Typeclass/Functor", .summary = "Public declarations from std/Typeclass/Functor.glo.", .compact_summary = "Public declarations from std/Typeclass/Functor.glo.", .source_path = "std/Typeclass/Functor.glo", .first_symbol = 2895, .symbol_count = 8 },
    .{ .name = "Typeclass/Monad", .summary = "Public declarations from std/Typeclass/Monad.glo.", .compact_summary = "Public declarations from std/Typeclass/Monad.glo.", .source_path = "std/Typeclass/Monad.glo", .first_symbol = 2903, .symbol_count = 4 },
    .{ .name = "Typeclass/Termination", .summary = "Values returned by main are converted to the process status through this protocol. Implementing Termination for an application-specific result type is enough to make that type a valid main return type.", .compact_summary = "Values returned by main are converted to the process status through this protocol. Implementing Termination for an application-specific result type...", .source_path = "std/Typeclass/Termination.glo", .first_symbol = 2907, .symbol_count = 2 },
    .{ .name = "Typeclass/Try", .summary = "The control-flow split used by the postfix ? operator.", .compact_summary = "The control-flow split used by the postfix ? operator.", .source_path = "std/Typeclass/Try.glo", .first_symbol = 2909, .symbol_count = 6 },
    .{ .name = "Unicode", .summary = "Public declarations from std/Unicode/module.glo.", .compact_summary = "Public declarations from std/Unicode/module.glo.", .source_path = "std/Unicode/module.glo", .first_symbol = 2915, .symbol_count = 0 },
    .{ .name = "Unicode/generated", .summary = "generated by tools/unicode_gen from UnicodeData.txt; do not edit. Private lookup helpers and tables for std/Unicode/utilities.glo.", .compact_summary = "generated by tools/unicode_gen from UnicodeData.txt; do not edit. Private lookup helpers and tables for std/Unicode/utilities.glo.", .source_path = "std/Unicode/generated.glo", .first_symbol = 2915, .symbol_count = 0 },
    .{ .name = "Unicode/utilities", .summary = "Pure Glosso Unicode helpers for UTF-8 strings. The table data and private lookup helpers live in generated.glo.", .compact_summary = "Pure Glosso Unicode helpers for UTF-8 strings. The table data and private lookup helpers live in generated.glo.", .source_path = "std/Unicode/utilities.glo", .first_symbol = 2915, .symbol_count = 26 },
    .{ .name = "VarArg", .summary = "std/VarArg.glo: C ABI va_list support. `Va_List` is opaque target ABI storage. The LLVM backend gives this type the libc-compatible size/layout for the target and lowers the v*printf wrappers with the right va_list passing ABI.", .compact_summary = "std/VarArg.glo: C ABI va_list support. `Va_List` is opaque target ABI storage. The LLVM backend gives this type the libc-compatible size/layout for...", .source_path = "std/VarArg.glo", .first_symbol = 2941, .symbol_count = 9 },
