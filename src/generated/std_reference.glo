    .{ .name = "Prelude/Primitive_Operators", .summary = "============================================================================ Primitive operation typeclasses and instances. Every operator/fixity/arity has one nominal owner. Implementations are selected by the complete operand-type tuple and may choose an associated Output type. There are no free operator overloads and no fallback tier. ============================================================================", .compact_summary = "============================================================================ Primitive operation typeclasses and instances. Every...", .source_path = "std/Prelude/Primitive_Operators.glo", .first_symbol = 1950, .symbol_count = 112 },
