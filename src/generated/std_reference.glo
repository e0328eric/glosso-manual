    .{ .name = "File_System/Copy", .summary = "streaming file and recursive tree copies.", .compact_summary = "streaming file and recursive tree copies.", .source_path = "std/File_System/Copy.glo", .first_symbol = 437, .symbol_count = 4 },
    .{ .name = "File_System/Directory", .summary = "typed lazy native directory iteration. Directory owns a native cursor. Opening does not enumerate the directory; each call to directory_next asks the OS for one entry. Entry count is therefore unbounded and closing early releases the native cursor promptly.", .compact_summary = "typed lazy native directory iteration. Directory owns a native cursor. Opening does not enumerate the directory; each call to directory_next asks the...", .source_path = "std/File_System/Directory.glo", .first_symbol = 441, .symbol_count = 11 },
    .{ .name = "File_System/File", .summary = "unified cross-platform file-handle operations. This component provides typed allocation-free primitives, allocating string conveniences, and the generic Io contracts over one File handle. Import it explicitly with: #import \"File_System/File\"; Native error values remain available in Fs_Error.os_code. Portable code should normally branch on Fs_Error.kind.", .compact_summary = "unified cross-platform file-handle operations. This component provides typed allocation-free primitives, allocating string conveniences, and the...", .source_path = "std/File_System/File.glo", .first_symbol = 452, .symbol_count = 35 },
    .{ .name = "File_System/Map", .summary = "native mapped-file views with an explicit heap-backed fallback for targets without virtual-memory mappings.", .compact_summary = "native mapped-file views with an explicit heap-backed fallback for targets without virtual-memory mappings.", .source_path = "std/File_System/Map.glo", .first_symbol = 487, .symbol_count = 4 },
    .{ .name = "File_System/Metadata", .summary = "typed native metadata and file controls.", .compact_summary = "typed native metadata and file controls.", .source_path = "std/File_System/Metadata.glo", .first_symbol = 491, .symbol_count = 13 },
    .{ .name = "File_System/Native", .summary = "private filesystem compiler boundary. These declarations deliberately return native error codes. Public wrappers translate them to Fs_Error while preserving the original code.", .compact_summary = "private filesystem compiler boundary. These declarations deliberately return native error codes. Public wrappers translate them to Fs_Error while...", .source_path = "std/File_System/Native.glo", .first_symbol = 504, .symbol_count = 22 },
    .{ .name = "File_System/Path", .summary = "portable lexical path operations. The functions in this component never touch the filesystem. Supplying an explicit Path_Style makes Windows paths testable on any host. Allocating functions accept an allocator and return owned strings; borrowed operations (root/volume/split/basename/dirname/extension) return views into their input. `path_lexically_contains` is useful for display, build graphs, and other already-trusted paths. It is NOT a sandbox boundary: it cannot account for symlinks, junctions, mount points, per-directory case sensitivity, or path replacement races. `path_secure_contains` delegates Native-style checks to the handle-relative filesystem boundary.", .compact_summary = "portable lexical path operations. The functions in this component never touch the filesystem. Supplying an explicit Path_Style makes Windows paths...", .source_path = "std/File_System/Path.glo", .first_symbol = 526, .symbol_count = 63 },
    .{ .name = "File_System/Sandbox", .summary = "race-resistant handle-relative filesystem API. Sandbox owns a native directory capability. Every operation below is relative to that capability and is resolved without consulting the process working directory. Relative paths containing `..`, embedded NUL bytes, or a platform root/volume are rejected before entering the OS boundary. The native boundary repeats those checks and rejects symlinks, junctions, magic links, and other reparse traversal in every component. For portability, sandbox operations do not follow symlinks. This is more restrictive than Linux openat2(RESOLVE_BENEATH), but gives the same security contract on POSIX, Windows, and WASI without a check-then-use race.", .compact_summary = "race-resistant handle-relative filesystem API. Sandbox owns a native directory capability. Every operation below is relative to that capability and...", .source_path = "std/File_System/Sandbox.glo", .first_symbol = 589, .symbol_count = 17 },
    .{ .name = "File_System/System", .summary = "cwd, canonical paths, capacity, and globbing.", .compact_summary = "cwd, canonical paths, capacity, and globbing.", .source_path = "std/File_System/System.glo", .first_symbol = 606, .symbol_count = 8 },
    .{ .name = "File_System/Temporary", .summary = "collision-resistant temporary lifecycles.", .compact_summary = "collision-resistant temporary lifecycles.", .source_path = "std/File_System/Temporary.glo", .first_symbol = 614, .symbol_count = 6 },
    .{ .name = "File_System/Types", .summary = "portable filesystem contracts. This component deliberately contains no operating-system bindings. It is shared by File_System/File, Metadata, Directory, Atomic, Map, and Watch. Fs_Error is carried only by the error variant of Result. `os_code` preserves the target's native errno/WASI errno/GetLastError value; callers should normally branch on `kind` and retain `os_code` for logging.", .compact_summary = "portable filesystem contracts. This component deliberately contains no operating-system bindings. It is shared by File_System/File, Metadata,...", .source_path = "std/File_System/Types.glo", .first_symbol = 620, .symbol_count = 43 },
    .{ .name = "File_System/Walk", .summary = "recursive directory traversal with pruning.", .compact_summary = "recursive directory traversal with pruning.", .source_path = "std/File_System/Walk.glo", .first_symbol = 663, .symbol_count = 1 },
    .{ .name = "File_System/Watch", .summary = "portable polling change notifications. The API deliberately models events independently of inotify/kqueue/IOCP. This implementation compares snapshots when polled, so it works on every backend and never starts a hidden thread. Native backends may later replace its internals while preserving the public event contract.", .compact_summary = "portable polling change notifications. The API deliberately models events independently of inotify/kqueue/IOCP. This implementation compares...", .source_path = "std/File_System/Watch.glo", .first_symbol = 664, .symbol_count = 4 },
