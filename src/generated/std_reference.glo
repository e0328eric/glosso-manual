    .{ .name = "Crypto/ConstantTime", .summary = "Constant-time byte operations and best-effort secret erasure. The equality routines run for the complete input length and never branch on byte values. secure_zero ends with a compiler memory barrier on native targets so dead-store elimination cannot discard the wipe.", .compact_summary = "Constant-time byte operations and best-effort secret erasure. The equality routines run for the complete input length and never branch on byte...", .source_path = "std/Crypto/ConstantTime.glo", .first_symbol = 313, .symbol_count = 9 },
