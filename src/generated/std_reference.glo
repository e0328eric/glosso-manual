    .{ .name = "Container/BinaryHeap", .summary = "owning max-heap container. BinaryHeap stores the allocator that owns its dynamic-array storage. The value itself is shallow and single-owner: copying a BinaryHeap aliases its allocation, so exactly one copy may be passed to binary_heap_deinit. The current language only provides PartialOrd. A BinaryHeap therefore requires a stable total order in practice. Every comparison-driven operation preflights the comparisons it will need and reports `ordered=false` without changing the logical heap if `<=>` returns Ordering.Unordered.", .compact_summary = "owning max-heap container. BinaryHeap stores the allocator that owns its dynamic-array storage. The value itself is shallow and single-owner: copying...", .source_path = "std/Container/BinaryHeap.glo", .first_symbol = 71, .symbol_count = 21 },
    .{ .name = "Container/BTreeMap", .summary = "ordered owning map backed by a B-tree with B=6. Every node stores at most 11 key/value pairs and 12 child pointers. Every non-root node stores at least 5 pairs after a public operation completes. Glosso currently exposes PartialOrd rather than a total Ord typeclass. Keys used here must nevertheless have a stable total order. Search-driven operations report `ordered=false` and leave the map structurally unchanged when `<=>` produces Ordering.Unordered. BTreeMap is shallow and single-owner. Copying the struct aliases all nodes; exactly one copy may be deinitialized. Deinitialization releases node storage but does not recursively deinitialize resources referenced by K/V.", .compact_summary = "ordered owning map backed by a B-tree with B=6. Every node stores at most 11 key/value pairs and 12 child pointers. Every non-root node stores at...", .source_path = "std/Container/BTreeMap.glo", .first_symbol = 92, .symbol_count = 24 },
    .{ .name = "Container/BTreeSet", .summary = "ordered owning set backed by BTreeMap(T, u8). BTreeSet is shallow and single-owner: copying the value aliases the map's nodes, so exactly one copy may be deinitialized. T must provide a stable total order through PartialOrd. Operations report `ordered=false` and leave the set structurally unchanged if comparison returns Ordering.Unordered.", .compact_summary = "ordered owning set backed by BTreeMap(T, u8). BTreeSet is shallow and single-owner: copying the value aliases the map's nodes, so exactly one copy...", .source_path = "std/Container/BTreeSet.glo", .first_symbol = 116, .symbol_count = 22 },
    .{ .name = "Container/Deque", .summary = "an explicitly owned, growable double-ended queue. Import this component with: #import \"Container/Deque\"; Deque(T) stores values in a ring. Assignment copies the backing pointer; it does not clone the allocation. Treat a Deque as a single-owner value, use deque_clone for an independent backing allocation, and call deque_deinit once for every owned value. Element copies are shallow because Glosso does not yet have automatic move/drop semantics.", .compact_summary = "an explicitly owned, growable double-ended queue. Import this component with: #import \"Container/Deque\"; Deque(T) stores values in a ring. Assignment...", .source_path = "std/Container/Deque.glo", .first_symbol = 138, .symbol_count = 28 },
    .{ .name = "Container/Hash", .summary = "generic hashing contracts and the default keyed hasher. Hash and Eq must agree: a == b => hash(a) == hash(b) A Hash implementation must also make the sequence of calls it feeds to a Hasher prefix-free. In particular, variable-length collections must write a length/domain prefix before their elements. Violating either law is a logic error for HashMap/HashSet, but must never by itself cause memory unsafety. Hasher's typed default writers use canonical little-endian bytes. This differs intentionally from hashing an integer's native in-memory representation and makes the DefaultHasher results independent of target endianness.", .compact_summary = "generic hashing contracts and the default keyed hasher. Hash and Eq must agree: a == b => hash(a) == hash(b) A Hash implementation must also make the...", .source_path = "std/Container/Hash.glo", .first_symbol = 166, .symbol_count = 27 },
    .{ .name = "Container/HashMap", .summary = "open-addressed owned hash map. Import this component with: #import \"Container/HashMap\"; HashMap(K, V) is a shallow, single-owner value. Copying it aliases its backing allocation; call hash_map_deinit exactly once for each owned table. Keys and values are copied bit-for-bit on insert/rehash. The map does not recursively clone or deinitialize resources owned by K or V; use the *_with cleanup variants when those types need explicit destruction. K must obey Eq/Hash's law for the entire time it is stored: a == b => hash(a) == hash(b) Mutating a stored key so its equality/hash changes is a logic error. The API therefore exposes stored keys only through read-only-by-convention pointers. Any structural mutation may invalidate pointers and iterators.", .compact_summary = "open-addressed owned hash map. Import this component with: #import \"Container/HashMap\"; HashMap(K, V) is a shallow, single-owner value. Copying it...", .source_path = "std/Container/HashMap.glo", .first_symbol = 193, .symbol_count = 28 },
    .{ .name = "Container/HashSet", .summary = "hash set implemented as HashMap(T, u8). HashSet(T) has the same shallow single-owner and Eq/Hash requirements as HashMap. Iteration order is arbitrary, and structural mutation invalidates pointers and iterators.", .compact_summary = "hash set implemented as HashMap(T, u8). HashSet(T) has the same shallow single-owner and Eq/Hash requirements as HashMap. Iteration order is...", .source_path = "std/Container/HashSet.glo", .first_symbol = 221, .symbol_count = 23 },
    .{ .name = "Container/LinkedList", .summary = "an explicitly owned doubly linked list. Import this component with: #import \"Container/LinkedList\"; Each element has a separately allocated node. Assignment of LinkedList(T) is shallow and aliases all nodes; treat the value as a single owner, use linked_list_clone for an independent node chain, and call linked_list_deinit once for every owned list. Element copies remain shallow because Glosso does not yet have automatic move/drop semantics.", .compact_summary = "an explicitly owned doubly linked list. Import this component with: #import \"Container/LinkedList\"; Each element has a separately allocated node....", .source_path = "std/Container/LinkedList.glo", .first_symbol = 244, .symbol_count = 21 },
    .{ .name = "Context", .summary = "std/Context.glo: the implicit context's allocators, modelled on Odin's `base:runtime` (https://pkg.odin-lang.org/base/runtime/). The Context struct and the Print_Style / Allocator / Random_Generator / Logger field types are built into the compiler (available as #Context with no import). This module supplies the concrete allocator *procedures* and the constructors that build an Allocator value, plus the `alloc`/`free` entry points that dispatch through `context.allocator`. An Allocator is `{ procedure, data }`. `context.allocator` defaults to the debug allocator at -O0 and to the heap allocator otherwise; install a different Allocator (directly or with #push_allocator) to redirect every allocation, like Odin's context.", .compact_summary = "std/Context.glo: the implicit context's allocators, modelled on Odin's `base:runtime` (https://pkg.odin-lang.org/base/runtime/). The Context struct...", .source_path = "std/Context.glo", .first_symbol = 265, .symbol_count = 31 },
