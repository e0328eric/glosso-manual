    .{ .name = "Prelude/Array", .summary = "std/array.glo — Jai-style arrays. []T a view { count, data } [..]T a dynamic array { count, data, capacity } Mutators take a pointer and update the dynamic array in place. Adding may replace the backing allocation, invalidating existing views, but the dynamic-array descriptor passed through `a` remains at the same address.", .compact_summary = "std/array.glo — Jai-style arrays. []T a view { count, data } [..]T a dynamic array { count, data, capacity } Mutators take a pointer and update the...", .source_path = "std/Prelude/Array.glo", .first_symbol = 1934, .symbol_count = 6 },
    .{ .name = "Prelude/Assembly", .summary = "Portable frontend vocabulary for structured inline assembly. These values describe operand allocation semantics. The compiler translates them to the selected backend's constraint language; user code never embeds LLVM/GCC constraint strings.", .compact_summary = "Portable frontend vocabulary for structured inline assembly. These values describe operand allocation semantics. The compiler translates them to the...", .source_path = "std/Prelude/Assembly.glo", .first_symbol = 1940, .symbol_count = 3 },
