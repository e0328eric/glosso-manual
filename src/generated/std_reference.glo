    .{ .name = "Process", .summary = "essential runtime process services. This is intentionally a small import. More specialized facilities live in explicit components such as Process/Environment, Process/System, Process/User, Process/Command, Process/Signals, and Process/Limits.", .compact_summary = "essential runtime process services. This is intentionally a small import. More specialized facilities live in explicit components such as...", .source_path = "std/Process.glo", .first_symbol = 2102, .symbol_count = 19 },
    .{ .name = "Process/Arguments", .summary = "command-line and response-file argument helpers. This component is intentionally not imported by the small Process prelude. Response files have no universal toolchain grammar, so the helpers below use a documented, round-trippable UTF-8 grammar: whitespace separates tokens, double quotes preserve whitespace and empty arguments, and backslash escapes \\, \", n, r, t, and 0.", .compact_summary = "command-line and response-file argument helpers. This component is intentionally not imported by the small Process prelude. Response files have no...", .source_path = "std/Process/Arguments.glo", .first_symbol = 2121, .symbol_count = 12 },
    .{ .name = "Process/Child", .summary = "explicit child-process component. Process/Command owns the Child representation and lifecycle primitives so command_run and callers share exactly one wait/close implementation.", .compact_summary = "explicit child-process component. Process/Command owns the Child representation and lifecycle primitives so command_run and callers share exactly one...", .source_path = "std/Process/Child.glo", .first_symbol = 2133, .symbol_count = 2 },
    .{ .name = "Process/Command", .summary = "command construction and child lifecycle. command_spawn and command_exec pass the program and argument vector directly to the operating system. run_command_line is the explicit shell entry point.", .compact_summary = "command construction and child lifecycle. command_spawn and command_exec pass the program and argument vector directly to the operating system....", .source_path = "std/Process/Command.glo", .first_symbol = 2135, .symbol_count = 34 },
