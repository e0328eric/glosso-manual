    .{ .name = "Process/Inspection", .summary = "explicit process handles and basic inspection.", .compact_summary = "explicit process handles and basic inspection.", .source_path = "std/Process/Inspection.glo", .first_symbol = 2189, .symbol_count = 9 },
    .{ .name = "Process/Limits", .summary = "current-process resource limits.", .compact_summary = "current-process resource limits.", .source_path = "std/Process/Limits.glo", .first_symbol = 2198, .symbol_count = 4 },
    .{ .name = "Process/Pipe", .summary = "owned anonymous pipes for child redirection.", .compact_summary = "owned anonymous pipes for child redirection.", .source_path = "std/Process/Pipe.glo", .first_symbol = 2202, .symbol_count = 6 },
    .{ .name = "Process/Scheduling", .summary = "priority and CPU-affinity controls.", .compact_summary = "priority and CPU-affinity controls.", .source_path = "std/Process/Scheduling.glo", .first_symbol = 2208, .symbol_count = 4 },
