#import "Format";
#import "String_Builder";
#import "Math/Core";
#import "clay_ui.glo";

#public {

// Chapters 43-51: Declarations and Control Flow.

render_section_43 :: () {
    paragraph(
        0,
        #string,oneline
            \\This chapter covers every declaration that gives a name to a value:
            \\constants, variables and compile-time variables inside a procedure,
            \\and the global and thread-local variables declared at the top level
            \\of a module. Values, Variables, and Arithmetic introduces the
            \\everyday forms by example; this chapter gives the complete rules.
    );
    paragraph(
        1,
        #string,oneline
            \\Glosso has no `let`, `var` or `const` keyword. The punctuation
            \\between the name and the value says what is declared: a single colon
            \\introduces a type, `::` binds a constant, and `=` binds a variable,
            \\written `:=` when the type is left out.
    );
    code_block(
        2,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    LIMIT :: 64;          // a constant; its type comes from the value
            \\    WIDTH: s32 : 80;      // a constant with a written type
            \\    total := 0;           // a variable; its type comes from the value
            \\    scale: f64 = 1.5;     // a variable with a written type
            \\    seen: s64;            // a variable holding its type's default value
            \\    total = LIMIT / 2;
            \\    print("{} {} {} {}\n", total, WIDTH, scale, seen);
            \\}
    );
    code_block(
        3,
        "text",
        #string
            \\32 80 1.5 0
    );
    table_header(4, "Form   —   Declares");
    table_row(5, "`name :: value;`   |   A constant.");
    table_row(6, "`name : T : value;` or `name : T :: value;`   |   A constant of type `T`.");
    table_row(7, "`name := value;`   |   A variable with the type of the value.");
    table_row(8, "`name : T = value;`   |   A variable of type `T`, initialized from the value.");
    table_row(9, "`name : T;`   |   A variable of type `T` holding the default value of `T`.");
    table_row(
        10,
        "`name : T = #undefined;`   |   A variable of type `T` whose contents start unspecified."
    );
    table_row(
        11,
        "`name ::= value;` or `name : T := value;`   |   Inside a procedure, a compile-time variable; at the top level, an ordinary global variable."
    );
    paragraph(
        12,
        #string,oneline
            \\Every form ends with `;`. The same forms declare local names inside a
            \\procedure and global names at the top level of a module, and only the
            \\last row of the table changes meaning between the two places.
            \\Procedures, structs and the other definitions are constants as well
            \\(`main :: () {}` is one); a definition whose body is braced ends at
            \\its closing brace, without a semicolon.
    );
    subheading(13, "Constants");
    paragraph(
        14,
        #string,oneline
            \\A constant cannot change after its declaration, and it has no storage
            \\of its own. At the top level of a module its value is computed while
            \\the program is compiled, so it can appear wherever a compile-time
            \\value is required, such as the condition of a `#if`. The value may be
            \\any expression the compiler can evaluate, including a call to an
            \\ordinary procedure, which then runs inside the compiler (see
            \\Compile-Time Evaluation).
    );
    code_block(
        15,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Point :: struct { x: s64; y: s64; }
            \\Index :: s32;
            \\
            \\ORIGIN :: Point.{ .x = 0, .y = 0 };
            \\PRIMES :: .[2, 3, 5, 7, 11];
            \\GREETING :: "hello";
            \\AREA :: square(12);
            \\
            \\square :: (value: s64) -> s64 { return value * value; }
            \\
            \\main :: () {
            \\    i: Index = 3;
            \\    print("{} {} {} {}\n", ORIGIN.x, PRIMES[i], GREETING, AREA);
            \\    #if AREA == 144 print("AREA is known at compile time\n");
            \\}
    );
    code_block(
        16,
        "text",
        #string
            \\0 7 hello 144
            \\AREA is known at compile time
    );
    paragraph(
        17,
        #string,oneline
            \\Types and procedures are constants too: `Point` and `square` above
            \\are, and `Index :: s32;` gives a second name to an existing type. A
            \\number written without a type stays a compile-time number until a use
            \\needs a type, so `K :: 200;` can initialize a `u8`, an `s64` and an
            \\`f64` alike (see Literal Typing and Type Conversion). An annotation
            \\fixes the type, and the value then has to fit it:
    );
    code_block(
        18,
        "text",
        #string
            \\// TIMEOUT: u8 : 300;
            \\error: 300 does not fit u8, whose range is 0..=255
    );
    subheading(19, "What a constant can hold");
    paragraph(
        20,
        #string,oneline
            \\A constant can hold any value the compiler can represent: numbers,
            \\strings, arrays, struct values, types and procedures, and also the
            \\values that exist only during compilation, such as module namespaces
            \\from `#import`, foreign libraries, typeclasses, macros, patterns and
            \\code. Those have no run-time representation, so no variable can hold
            \\them and they are always bound with `::`. The same is true of types:
            \\a variable cannot hold a type that annotations then use.
    );
    code_block(
        21,
        "text",
        #string
            \\// digits := #pattern 0..9;
            \\error: a 'Pattern' value is compile-time only; bind it with '::' rather than ':='
            \\// Count := s64;
            \\// total: Count = 3;
            \\error: 'Count' is a variable, not a type
    );
    paragraph(
        22,
        #string,oneline
            \\A constant has no address: `&LIMIT` is `error: cannot take a pointer
            \\to a non-addressable expression: 'LIMIT'`. Copy the value into a
            \\variable when the program needs storage that holds it.
    );
    paragraph(
        23,
        #string,oneline
            \\A definition may carry an annotation too, written between the two
            \\colons. It states what kind of value is being defined: `type` for a
            \\struct, the procedure type for a procedure, `Namespace` for an import.
            \\The compiler checks the annotation against the definition.
    );
    code_block(
        24,
        "glosso",
        #string
            \\Point : type : struct { x: s64; y: s64; }
            \\double : (s64) -> s64 : (value: s64) -> s64 { return value * 2; }
            \\Out : Namespace : #import "Io";
    );
    code_block(
        25,
        "text",
        #string
            \\// Wrong : s64 : struct {}
            \\error: declaration 'Wrong' has type type, not declared type s64
    );
    subheading(26, "Constants inside a procedure");
    paragraph(
        27,
        #string,oneline
            \\Inside a procedure, `::` binds a compile-time constant when the
            \\compiler can evaluate the value. Otherwise it binds a constant that is
            \\computed at run time: the value is evaluated once, when the
            \\declaration is reached, and the name keeps that value for the rest of
            \\its scope. Later changes to the variables it was computed from do not
            \\reach the constant.
    );
    code_block(
        28,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    n := 7;
            \\    FROZEN :: n * 2;
            \\    print("FROZEN={}\n", FROZEN);
            \\    n = 100;
            \\    print("FROZEN={}\n", FROZEN);
            \\}
    );
    code_block(
        29,
        "text",
        #string
            \\FROZEN=14
            \\FROZEN=14
    );
    paragraph(
        30,
        #string,oneline
            \\Such a constant is not a compile-time value, so `#if FROZEN == 14` is
            \\`error: unknown const FROZEN`. Writing `#comptime` before the value
            \\demands evaluation while compiling; a value that depends on `n` is
            \\then an error instead of a run-time constant (see Compile-Time
            \\Evaluation).
    );
    subheading(31, "Assigning to a constant");
    paragraph(
        32,
        #string,oneline
            \\Assigning to a constant, or to a field or an element of one, is an
            \\error. For a constant declared inside a procedure, a help line names
            \\the change that turns the binding into a variable:
    );
    code_block(
        33,
        "text",
        #string
            \\// limit :: 9;
            \\// limit = 10;
            \\error: constant cannot be modified
            \\help: change '::' to ':=' to make the binding mutable
            \\// size: s64 : 9;
            \\// size += 1;
            \\error: constant cannot be modified
            \\help: change ':' to '=' to make the binding mutable
    );
    paragraph(
        34,
        #string,oneline
            \\For a top-level constant the error points at the declaration:
    );
    code_block(
        35,
        "text",
        #string
            \\// K :: 7;
            \\// main :: () { K = 3; }
            \\error: cannot assign to constant 'K'
            \\constant declared here: '::' bindings are immutable
    );
    subheading(36, "Variables");
    paragraph(
        37,
        #string,oneline
            \\`name := value;` declares a variable with the type of its value, and
            \\`name : T = value;` writes the type and converts the value to it. A
            \\numeric literal has no type of its own, so a variable initialized
            \\from one takes the type that its first use requires. When no use
            \\decides, an integer variable is an `ssize` and a floating-point one an
            \\`f64`.
    );
    code_block(
        38,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\take :: (value: u16) {}
            \\
            \\main :: () {
            \\    count := 7;
            \\    take(count);
            \\    other := 7;
            \\    print("{} {}\n", type_of(count), type_of(other));
            \\}
    );
    code_block(
        39,
        "text",
        #string
            \\u16 ssize
    );
    paragraph(
        40,
        #string,oneline
            \\Some values get their type only from the place they are written in:
            \\`null`, a struct literal without a type name, and an enum member
            \\written `.Name`. A variable initialized from one of them needs an
            \\annotation.
    );
    code_block(
        41,
        "text",
        #string
            \\// p := null;
            \\error: cannot infer a type for null; add a type annotation
            \\// origin := .{ .x = 0 };
            \\error: struct literal needs a type
            \\// color := .Red;
            \\error: enum shorthand needs an enum context
    );
    subheading(42, "Default values");
    paragraph(
        43,
        #string,oneline
            \\`name : T;` initializes the variable with the default value of `T`:
            \\zero for numbers, `false` for `bool`, the empty string for `str`,
            \\`null` for an optional, the first member for an enum, and an empty
            \\array for a dynamic array. A struct gets the default written on each
            \\field, and zero for a field that has none. A union holds its first
            \\variant with a default payload.
    );
    code_block(
        44,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Color :: enum { Red; Green; Blue; }
            \\
            \\Settings :: struct {
            \\    width: s64 = 80;
            \\    height: s64;
            \\    title: str = "untitled";
            \\}
            \\
            \\main :: () {
            \\    count: s64;
            \\    ratio: f64;
            \\    done: bool;
            \\    name: str;
            \\    maybe: ?s64;
            \\    color: Color;
            \\    values: [..]s64;
            \\    settings: Settings;
            \\    print("{} {} {} [{}] {} {}\n",
            \\        count, ratio, done, name, maybe == null, color);
            \\    print("{} {} {} {}\n",
            \\        values.count, settings.width, settings.height, settings.title);
            \\}
    );
    code_block(
        45,
        "text",
        #string
            \\0 0 false [] true Red
            \\0 80 0 untitled
    );
    paragraph(
        46,
        #string,oneline
            \\A type without values has no default: `n: #Never;` is `error: #Never
            \\has no values and cannot be default-initialized`. Neither has a
            \\struct with a field that is private to another module (see Who Can
            \\Use a Declaration: Visibility and Units). A name with neither a type
            \\nor a value is not a declaration at all: `tally;` alone is a statement
            \\that reads `tally`, and is `error: unbound 'tally'` when no such name
            \\exists.
    );
    subheading(47, "Uninitialized variables: `#undefined`");
    paragraph(
        48,
        #string,oneline
            \\`#undefined` as the value skips the default. The contents of the
            \\variable are unspecified until the program writes them, which saves
            \\clearing a buffer that is about to be filled anyway: at `-O0` the code
            \\generated for `b: [64]u8;` begins by filling 64 bytes with zero, and
            \\the code for `b: [64]u8 = #undefined;` does not.
    );
    code_block(
        49,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    buffer: [64]u8 = #undefined;
            \\    for i: 0..64 buffer[i] = cast(u8) (i * 2);
            \\    print("{}\n", buffer[63]);
            \\}
    );
    code_block(
        50,
        "text",
        #string
            \\126
    );
    paragraph(
        51,
        #string,oneline
            \\Reading an element before it has been written gives whatever the
            \\memory held. `#undefined` takes the type of the declaration it
            \\initializes, so that declaration has to write the type. For a global
            \\variable it changes nothing: `table: [8]u8 = #undefined;` starts
            \\zeroed, like `table: [8]u8;`. The directive needs its `#`:
            \\`undefined` alone is an unknown name, and `---` is not accepted.
    );
    subheading(52, "Declaring several names");
    paragraph(
        53,
        #string,oneline
            \\A declaration inside a procedure may list several names. When the
            \\value is a tuple, such as the result of a procedure with several
            \\return values, the names take its elements in order, and `_`
            \\discards an element. Any other value is given to every name, and an
            \\annotation that is not a tuple type is the type of each name.
    );
    code_block(
        54,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\divide :: (a: s64, b: s64) -> (s64, s64) {
            \\    return a / b, a % b;
            \\}
            \\
            \\main :: () {
            \\    quotient, remainder := divide(17, 5);
            \\    _, last := divide(7, 2);
            \\    x, y: s64;
            \\    low, high: f64 = 0.5;
            \\    a, b := .(1, "two");
            \\    print("{} {} {}\n", quotient, remainder, last);
            \\    print("{} {} {} {} {} {}\n", x, y, low, high, a, b);
            \\}
    );
    code_block(
        55,
        "text",
        #string
            \\3 2 1
            \\0 0 0.5 0.5 1 two
    );
    paragraph(
        56,
        #string,oneline
            \\The number of names has to match the number of elements. Elements are
            \\not converted, so with an annotation each element must already have
            \\the annotated type. The value is a single expression: `a, b := 1, 2;`
            \\is a syntax error, and the tuple literal `.(1, 2)` is the form that
            \\works. Name lists are not accepted at the top level, and no assignment
            \\stores into several places at once (see Assignment, Blocks, and Name
            \\Lookup).
    );
    code_block(
        57,
        "text",
        #string
            \\// a, b, c := divide(7, 2);
            \\error: destructuring binds 3 names from a 2-value result
            \\// a, b := 1, 2;
            \\error: unexpected token ','
    );
    subheading(58, "Compile-time variables");
    paragraph(
        59,
        #string,oneline
            \\Inside a procedure, `name ::= value;` and `name : T := value;`
            \\declare a compile-time variable. Its value has to be computable while
            \\compiling, and the compiler carries out the assignments to it while
            \\it checks the procedure, so a later `#if` or `#inline while` sees the
            \\updated value. It has no storage at run time. At the top level of a
            \\module the same spellings declare an ordinary global variable.
    );
    code_block(
        60,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    width ::= 4;
            \\    width = width * 2;
            \\    #if width == 8 print("the static branch saw {}\n", width);
            \\}
    );
    code_block(
        61,
        "text",
        #string
            \\the static branch saw 8
    );
    note(
        62,
        #string,oneline
            \\An assignment to a compile-time variable happens once, when the
            \\compiler reaches it in the source, whatever the run-time control flow.
            \\After `n ::= 0; for 0..3 { n += 1; }` the value of `n` is 1, and an
            \\assignment inside an `if` takes effect even when the condition is
            \\false at run time. Use `:=` for a value that the running program
            \\changes, and `#inline for` or `#inline while` for a loop that runs
            \\while compiling (see `while`, `for`, and Unrolled Loops).
    );
    subheading(63, "Global variables");
    paragraph(
        64,
        #string,oneline
            \\A variable declared at the top level of a module is a global
            \\variable. It has static storage: the program has exactly one instance
            \\of it, which exists from the program's start to its end. Any of the
            \\variable forms above declares one, and like every top-level
            \\declaration it can be used anywhere in its module, above or below the
            \\declaration.
    );
    code_block(
        65,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    record("first");
            \\    record("second");
            \\    print("{} calls, last was {}\n", calls, last);
            \\}
            \\
            \\record :: (name: str) {
            \\    calls += 1;
            \\    last = name;
            \\}
            \\
            \\calls := 0;
            \\last: str;
    );
    code_block(
        66,
        "text",
        #string
            \\2 calls, last was second
    );
    paragraph(
        67,
        #string,oneline
            \\A global is private to its module unless it is marked `#public`, and
            \\then every module that imports it reads and writes the same variable.
            \\Who Can Use a Declaration: Visibility and Units describes the
            \\audiences, and Modules, Imports, and the Prelude shows two modules
            \\sharing a global.
    );
    subheading(68, "Initial values are computed at compile time");
    paragraph(
        69,
        #string,oneline
            \\The compiler computes the initial value of every global and stores it
            \\in the executable's data, so no code runs before `main` to set the
            \\globals up. The initializer may be any expression the compiler can
            \\evaluate: literals, constants, and calls to ordinary procedures
            \\declared anywhere in the program, which run inside the compiler. A
            \\global without an initializer holds the default value of its type,
            \\field defaults included.
    );
    code_block(
        70,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Settings :: struct {
            \\    width: s64 = 80;
            \\    title: str = "untitled";
            \\}
            \\
            \\table: [4]s64 = .[1, 4, 9, square(4)];
            \\settings: Settings;
            \\answer := compute();
            \\
            \\square :: (value: s64) -> s64 { return value * value; }
            \\
            \\compute :: () -> s64 {
            \\    print("compute ran\n");
            \\    return 6 * 7;
            \\}
            \\
            \\main :: () {
            \\    print("{} {} {} {}\n",
            \\        table[3], settings.width, settings.title, answer);
            \\}
    );
    code_block(
        71,
        "text",
        #string
            \\16 80 untitled 42
    );
    paragraph(
        72,
        #string,oneline
            \\The running program printed nothing from `compute`. The procedure ran
            \\once, inside the compiler, and its output is part of the build's
            \\output:
    );
    code_block(
        73,
        "text",
        #string
            \\$ glosso --run settings.glo
            \\glosso: compile settings.glo (target=x86_64-pc-linux-gnu)
            \\compute ran
            \\glosso: link settings (target=x86_64-pc-linux-gnu, -O1)
            \\glosso: done settings  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
            \\16 80 untitled 42
    );
    paragraph(
        74,
        #string,oneline
            \\A build restored from the artifact cache does not run the initializer
            \\again, so `compute ran` does not appear; the compiler prints only
            \\`glosso: restored settings from the native artifact cache`. Work that
            \\has to happen each time the program starts, such as reading the
            \\environment, belongs at the top of `main` or in a procedure that
            \\`main` calls.
    );
    subheading(75, "What an initializer cannot use");
    paragraph(
        76,
        #string,oneline
            \\A global variable's value exists only while the program runs, so it
            \\is not a compile-time value. A top-level constant and a global's
            \\initializer are both computed while compiling, and neither can read a
            \\global variable: `HALF :: first / 2;` is rejected with the same
            \\message as `second` below. Nor can an initializer take the address of
            \\another global, or do anything else that needs the running program,
            \\such as allocating memory (`alloc` comes from the `Context` module):
    );
    code_block(
        77,
        "text",
        #string
            \\// first: s64 = 1;
            \\// second: s64 = first + 1;
            \\error: global 'first' is a runtime variable, so its value is not a compile-time constant
            \\note: a '#comptime' evaluation reads the global's initial value
            \\// target: s64 = 5;
            \\// pointer: *s64 = &target;
            \\error: constant evaluation cannot take the address of the runtime global 'target'
            \\// buffer: ?*void = alloc(64);
            \\error: #magic intrinsic 'ctx_alloc' is not available during compile-time evaluation
    );
    paragraph(
        78,
        #string,oneline
            \\As the note says, `#comptime` reads another global's initial value
            \\explicitly: `second: s64 = #comptime first + 1;` starts at 2 whatever
            \\the program later stores in `first`. A global that has to point at
            \\another global or own memory starts out `null` or empty, and `main`
            \\sets it. That includes containers: declare a global dynamic array
            \\without an initializer and fill it at run time, so that its buffer
            \\comes from an allocator.
    );
    paragraph(
        79,
        #string,oneline
            \\Because every initial value is a constant, there is no initialization
            \\order to get wrong. Each global holds its initial value from the
            \\program's first instruction, whichever module declares it and
            \\wherever the declaration stands in its file. The constants that
            \\initializers depend on are evaluated in dependency order, and a cycle
            \\among them is an error:
    );
    code_block(
        80,
        "text",
        #string
            \\// A :: B + 1;
            \\// B :: A + 1;
            \\error: cyclic constant definition involving 'A'
            \\note: dependency path: main.glo::A -> main.glo::B -> main.glo::A
    );
    subheading(81, "Globals in compile-time code");
    paragraph(
        82,
        #string,oneline
            \\Compile-time code can read and assign globals as well, but it works
            \\on the compiler's own copy of them, which starts from their initial
            \\values. What it writes never reaches the program:
    );
    code_block(
        83,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\counter: s64 = 1;
            \\
            \\#comptime {
            \\    counter += 10;
            \\    print("compile time: counter = {}\n", counter);
            \\}
            \\
            \\main :: () {
            \\    print("run time: counter = {}\n", counter);
            \\}
    );
    code_block(
        84,
        "text",
        #string
            \\$ glosso --run counter.glo
            \\glosso: compile counter.glo (target=x86_64-pc-linux-gnu)
            \\compile time: counter = 11
            \\glosso: link counter (target=x86_64-pc-linux-gnu, -O1)
            \\glosso: done counter  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
            \\run time: counter = 1
    );
    subheading(85, "Thread-local storage");
    paragraph(
        86,
        #string,oneline
            \\`#thread_local` before a global variable gives every thread its own
            \\instance of the variable. Each instance starts with the declared
            \\initial value, and what one thread writes to its instance is
            \\invisible to the others. Everything else about the declaration stays
            \\the same, and the directive combines with `#public` in either order.
    );
    code_block(
        87,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Thread/Task";
            \\
            \\#thread_local calls: s64 = 100;
            \\
            \\count :: (times: s64) -> s64 {
            \\    for 0..times calls += 1;
            \\    return calls;
            \\}
            \\
            \\main :: () {
            \\    calls = 0;
            \\    #pattern .Ok(task) := spawn_owned(5, count) else { exit(1); };
            \\    #pattern .Ok(seen) := task.join() else { exit(1); };
            \\    print("worker saw {}\n", seen);
            \\    print("main has {}\n", calls);
            \\}
    );
    code_block(
        88,
        "text",
        #string
            \\worker saw 105
            \\main has 0
    );
    paragraph(
        89,
        #string,oneline
            \\The worker thread's `calls` started from the initial value 100, not
            \\from the 0 that `main` had stored in its own instance, and the
            \\worker's five increments stayed in the worker's instance. `spawn_owned`
            \\is described in `spawn_owned`, `thread_scope`, and `Thread_Pool`. The
            \\directive applies to global variables only:
    );
    code_block(
        90,
        "text",
        #string
            \\// #thread_local LIMIT :: 5;
            \\error: #thread_local can only prefix a global variable declaration
            \\// main :: () { #thread_local depth: s64; }
            \\error: unexpected directive 'thread_local'
    );
    paragraph(
        91,
        #string,oneline
            \\On targets whose runtime has no thread-local storage, freestanding
            \\x86-64 Linux and bare-metal targets, a `#thread_local` global is an
            \\ordinary global. Compile-time code runs on a single thread and also
            \\sees a single instance. Freestanding, UEFI, and Wasm Programs
            \\describes those targets.
    );
    subheading(92, "Alignment and linker sections: `#align` and `#link_section`");
    paragraph(
        93,
        #string,oneline
            \\Two directives change where a variable is stored without changing its
            \\type. `#align N` places the variable at an address that is a multiple
            \\of `N` bytes, at least; `N` is a compile-time integer and a power of
            \\two from 1 to 268435456. It applies to global, thread-local and local
            \\variables. `#link_section "name"` puts a global variable into the
            \\named section of the object file, initialized or not, so that a
            \\linker script or another tool can find it there. Either directive
            \\follows the type or the initial value, and a declaration may carry
            \\both, in either order:
    );
    code_block(
        94,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\CACHE_LINE :: 64;
            \\
            \\counters: [8]u64 #align CACHE_LINE;                  // after the type
            \\table: [4]s32 #link_section ".lookup" = .[1, 2, 3, 4];
            \\version: s64 = 3 #align 16;                          // after the initializer
            \\
            \\main :: () {
            \\    scratch: [256]u8 #align (CACHE_LINE / 2);
            \\    value := 7 #align 64;
            \\    print("{} {} {}\n", cast(usize) &counters % 64, cast(usize) &scratch % 32, cast(usize) &value % 64);
            \\    print("{} {} {}\n", version, value, table[3]);
            \\}
    );
    code_block(
        95,
        "text",
        #string
            \\0 0 0
            \\3 7 4
    );
    paragraph(
        96,
        #string,oneline
            \\An `N` that is an expression with operators is written in
            \\parentheses, as `scratch` shows. The type's own alignment is kept
            \\when it is larger. The section of `table` is visible in the
            \\executable:
    );
    code_block(
        97,
        "text",
        #string
            \\$ glosso storage.glo -o storage
            \\glosso: compile storage.glo (target=x86_64-pc-linux-gnu)
            \\glosso: link storage (target=x86_64-pc-linux-gnu, -O1)
            \\glosso: done storage  (backend=llvm, target=x86_64-pc-linux-gnu, -O1)
            \\$ readelf -SW storage | grep lookup
            \\  [26] .lookup           PROGBITS        000000000001f698 01c698 000010 00  WA  0   0  4
    );
    paragraph(
        98,
        #string,oneline
            \\Section names follow the conventions of the target's object format
            \\(ELF, COFF, Mach-O or Wasm), which the compiler does not check. Both
            \\directives belong to variable declarations only: a constant or a
            \\parameter takes neither, and `#link_section` is rejected on a local
            \\variable:
    );
    code_block(
        99,
        "text",
        #string
            \\// x: s64 #align 48;
            \\error: #align expects a compile-time integer power of two between 1 and 268435456
            \\// main :: () { y: s64 #link_section ".foo"; }
            \\error: #link_section requires a global variable
            \\// x: s64 #link_section "";
            \\error: #link_section expects a nonempty section name without NUL bytes
            \\// x: s64 #align 8 #align 16;
            \\error: duplicate #align on variable declaration
    );
    paragraph(
        100,
        #string,oneline
            \\A struct type can raise its own alignment with `#align(N)` instead,
            \\which then holds for every variable, field and array element of that
            \\type (see Field Order, Alignment, and Packing).
    );
}

render_section_44 :: () {
    paragraph(
        0,
        #string,oneline
            \\This chapter covers storing a value into a place that already exists,
            \\with `=` and with compound operators such as `+=`, and then the rules
            \\that decide which declaration a name refers to: blocks and the scopes
            \\they open, shadowing, local procedures and types, and the scope of a
            \\whole module. The declarations themselves are described in Constants,
            \\Variables, and Globals.
    );
    subheading(1, "Assignment");
    paragraph(
        2,
        #string,oneline
            \\An assignment `place = value;` stores a value into a place. It is a
            \\statement and has no value of its own, so it cannot be nested in an
            \\expression or used as a condition. An `=` written where `==` was
            \\meant is therefore a syntax error, never a silent assignment.
    );
    code_block(
        3,
        "text",
        #string
            \\// y := (x = 2);
            \\error: unexpected token '='
            \\// if x = 1 { }
            \\error: unexpected token '='
    );
    paragraph(
        4,
        #string,oneline
            \\The value has to have the type of the place or convert to it
            \\implicitly. Widening an integer is implicit and narrowing is not;
            \\Literal Typing and Type Conversion gives the rules.
    );
    code_block(
        5,
        "text",
        #string
            \\// small: s32 = 1;
            \\// big: s64 = 2;
            \\// small = big;
            \\error: assign s64 to s32
            \\// small = "one";
            \\error: assign str to s32
    );
    subheading(6, "What can be assigned");
    paragraph(
        7,
        #string,oneline
            \\The left side has to denote storage: a variable (a local, a global or
            \\a parameter), a field of an assignable struct, an element of an array,
            \\a view or a dynamic array, or the target of a pointer, written `p.*`.
            \\A field is reached through a pointer without `.*`, so `p.y = 20`
            \\writes the struct that `p` points to. A parameter is a copy of the
            \\argument, and assigning to it changes nothing for the caller.
    );
    code_block(
        8,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Point :: struct { x: s64; y: s64; }
            \\
            \\shift :: (p: Point, by: s64) -> Point {
            \\    p.x += by;
            \\    return p;
            \\}
            \\
            \\main :: () {
            \\    arr: [4]s64 = .[1, 2, 3, 4];
            \\    arr[1] += 10;
            \\
            \\    x := 5;
            \\    p := &x;
            \\    p.* += 2;
            \\
            \\    view := arr[0..2];
            \\    view[0] += 100;
            \\
            \\    pt := Point.{ .x = 1, .y = 2 };
            \\    pp := &pt;
            \\    pp.y = 20;
            \\
            \\    moved := shift(pt, 5);
            \\    print("arr = {} {} {} {}  x = {}\n",
            \\        arr[0], arr[1], arr[2], arr[3], x);
            \\    print("pt = {} {}  moved = {} {}\n", pt.x, pt.y, moved.x, moved.y);
            \\}
    );
    code_block(
        9,
        "text",
        #string
            \\arr = 101 12 3 4  x = 7
            \\pt = 1 20  moved = 6 20
    );
    paragraph(
        10,
        #string,oneline
            \\Writing through `view` changed `arr`, because a view refers to the
            \\elements of the array it was taken from. Nothing else can be
            \\assigned: not a literal, not the result of a call or an operator, not
            \\an element reached through a `[]const T` view or a `*const T`
            \\pointer, and not a byte of a `str`. Assigning to a constant has
            \\messages of its own, shown in Constants, Variables, and Globals.
    );
    code_block(
        11,
        "text",
        #string
            \\// f() = 3;
            \\error: left side of assignment is not assignable
            \\// read_only: *const s64 = &value;
            \\// read_only.* = 3;
            \\error: left side of assignment is not assignable
    );
    subheading(12, "Assignment copies");
    paragraph(
        13,
        #string,oneline
            \\Assigning a struct or a fixed-size array copies all of it, and the two
            \\values are independent afterwards. A pointer, a view or a dynamic
            \\array is copied too, but not what it refers to, so both copies refer
            \\to the same elements. `Freeable`, Copies, and Ownership Transfer
            \\explains what that means for values that own memory.
    );
    code_block(
        14,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Point :: struct { x: s64; y: s64; }
            \\
            \\main :: () {
            \\    a := Point.{ .x = 1, .y = 2 };
            \\    b := a;
            \\    b.x = 99;
            \\    c: [3]s64 = .[1, 2, 3];
            \\    d := c;
            \\    d[0] = 99;
            \\    e := c[..];
            \\    e[1] = 50;
            \\    print("a.x={} b.x={}\n", a.x, b.x);
            \\    print("c={} {} d[0]={}\n", c[0], c[1], d[0]);
            \\}
    );
    code_block(
        15,
        "text",
        #string
            \\a.x=1 b.x=99
            \\c=1 50 d[0]=99
    );
    subheading(16, "Compound assignment");
    paragraph(
        17,
        #string,oneline
            \\`place op= value` combines the current value of the place with
            \\`value` and stores the result, as `place = place op value` would,
            \\except that the place is evaluated only once.
    );
    table_header(18, "Operators   —   Meaning");
    table_row(
        19,
        "`+=` `-=` `*=` `/=` `%=`   |   Arithmetic; integer overflow stops the program at `-O0` and `-O1` (see Integer Arithmetic, Overflow, and Traps)."
    );
    table_row(20, "`+%=` `-%=` `*%=`   |   Wrapping arithmetic.");
    table_row(21, "`+|=` `-|=` `*|=` `<<|=`   |   Saturating arithmetic and left shift.");
    table_row(22, "`<<=` `>>=`   |   Shifts.");
    table_row(23, "`&=` `|=` `^=`   |   Bitwise and, or and exclusive or.");
    table_row(
        24,
        "`&&=` `||=`   |   Logical and and or; the right side is evaluated only when it can change the result."
    );
    code_block(
        25,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    total := 50;
            \\    total += 2;
            \\    total -= 1;
            \\    total *= 3;
            \\    total /= 2;
            \\    total %= 7;
            \\    small: u8 = 250;
            \\    wrapped := small;
            \\    wrapped +%= 10;
            \\    saturated := small;
            \\    saturated +|= 10;
            \\    bits: u8 = 2#1010;
            \\    bits |= 2#0101;
            \\    bits &= 2#0110;
            \\    bits ^= 2#0011;
            \\    bits <<= 2;
            \\    bits >>= 1;
            \\    ready := true;
            \\    ready &&= total > 0;
            \\    print("total={} wrapped={} saturated={} bits={} ready={}\n",
            \\        total, wrapped, saturated, bits, ready);
            \\}
    );
    code_block(
        26,
        "text",
        #string
            \\total=6 wrapped=4 saturated=255 bits=10 ready=true
    );
    paragraph(
        27,
        #string,oneline
            \\Because the place is evaluated once, a call in its index runs once:
    );
    code_block(
        28,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\calls := 0;
            \\
            \\next_index :: () -> s64 {
            \\    calls += 1;
            \\    return 1;
            \\}
            \\
            \\main :: () {
            \\    counts: [3]s64;
            \\    counts[next_index()] += 5;
            \\    print("counts[1]={} calls={}\n", counts[1], calls);
            \\}
    );
    code_block(
        29,
        "text",
        #string
            \\counts[1]=5 calls=1
    );
    paragraph(
        30,
        #string,oneline
            \\Unlike `=`, a compound assignment is an operator and forms an
            \\expression: it produces the value it stored and groups from the
            \\right, so it may appear inside a larger expression. Two separate
            \\statements are usually clearer.
    );
    code_block(
        31,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    x := 1;
            \\    y := (x += 4);
            \\    print("x={} y={}\n", x, y);
            \\    a := 1;
            \\    b := 2;
            \\    a += b *= 3;
            \\    print("a={} b={}\n", a, b);
            \\}
    );
    code_block(
        32,
        "text",
        #string
            \\x=5 y=5
            \\a=7 b=6
    );
    paragraph(
        33,
        #string,oneline
            \\Each compound operator belongs to a typeclass of the prelude, such as
            \\`AddAssign` for `+=`. The prelude derives every one of them from the
            \\corresponding binary operator, so a type that implements `Add` has
            \\`+=` with no further work. Compound Assignment and Indexing Typeclasses
            \\describes the classes.
    );
    code_block(
        34,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Vec2 :: struct { x: f64; y: f64; }
            \\
            \\(Vec2, Vec2) ::: instance Add {
            \\    Output :: Vec2;
            \\    '+' :: (left: Vec2, right: Vec2) -> Vec2 {
            \\        return .{ .x = left.x + right.x, .y = left.y + right.y };
            \\    }
            \\}
            \\
            \\main :: () {
            \\    position := Vec2.{ .x = 1, .y = 2 };
            \\    position += Vec2.{ .x = 0.5, .y = -1 };
            \\    print("{} {}\n", position.x, position.y);
            \\}
    );
    code_block(
        35,
        "text",
        #string
            \\1.5 1
    );
    paragraph(
        36,
        #string,oneline
            \\A type without the operator, and a pair of types that the operator
            \\does not combine, are reported with the operator's name:
    );
    code_block(
        37,
        "text",
        #string
            \\// a: Point; b: Point;
            \\// a += b;
            \\error: no operator '+=' for Point, Point
            \\// small: s32 = 1; big: s64 = 2;
            \\// small += big;
            \\error: no operator '+=' for s32, s64
    );
    subheading(38, "One place per assignment");
    paragraph(
        39,
        #string,oneline
            \\An assignment has exactly one place on its left. A list of places is
            \\a syntax error, so neither the several results of a call nor a swap
            \\can be assigned in one statement. A list of names is accepted only
            \\when it declares the names, as described in Constants, Variables, and
            \\Globals.
    );
    code_block(
        40,
        "text",
        #string
            \\// quotient, remainder = divide(9, 4);
            \\error: unexpected token '='
            \\// x, y = y, x;
            \\error: unexpected token '='
    );
    paragraph(
        41,
        #string,oneline
            \\To exchange two values, `value_swap` from the `Memory/Ownership`
            \\module takes pointers to both:
    );
    code_block(
        42,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Memory/Ownership";
            \\
            \\main :: () {
            \\    a := 1;
            \\    b := 2;
            \\    value_swap(&a, &b);
            \\    print("a={} b={}\n", a, b);
            \\}
    );
    code_block(
        43,
        "text",
        #string
            \\a=2 b=1
    );
    paragraph(
        44,
        #string,oneline
            \\Assigning to an element of a container type, as in
            \\`table[key] = value`, calls the container's `[]=` operator, which
            \\Compound Assignment and Indexing Typeclasses also describes.
    );
    subheading(45, "Blocks and scopes");
    paragraph(
        46,
        #string,oneline
            \\A block is a list of statements in braces. It may stand wherever a
            \\statement can, and it is a scope: a name declared in it is visible
            \\from its declaration to the closing brace, and neither before nor
            \\after.
    );
    code_block(
        47,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    a := 1;
            \\    {
            \\        print("inner sees outer a={}\n", a);
            \\        a := 99;
            \\        print("inner a={}\n", a);
            \\        hidden := 5;
            \\    }
            \\    print("outer a={}\n", a);
            \\}
    );
    code_block(
        48,
        "text",
        #string
            \\inner sees outer a=1
            \\inner a=99
            \\outer a=1
    );
    paragraph(
        49,
        #string,oneline
            \\The first `print` sees the outer `a` because the inner declaration has
            \\not been reached yet. `a := 99;` declares a second variable that hides
            \\the first until the block ends; it does not assign to the outer one.
            \\After the closing brace the names declared in the block are gone, and
            \\a misspelled name gets a suggestion when one is close:
    );
    code_block(
        50,
        "text",
        #string
            \\// { hidden := 5; }
            \\// x := hidden;
            \\error: unbound 'hidden'
            \\// counter := 1;
            \\// x := countr + 1;
            \\error: unbound 'countr'
            \\help: did you mean 'counter'?
    );
    subheading(51, "What opens a scope");
    paragraph(
        52,
        #string,oneline
            \\Every body is a scope: the body of a procedure, a block, each branch
            \\of an `if` and its `else`, each `case` of a switch, the `else` block
            \\of a `#pattern` binding, and the body of a loop, which is a new scope
            \\on every iteration. A body written without braces is a scope as well.
            \\A procedure's parameters live in a scope that directly encloses its
            \\body, and the variables of a `for` loop in a scope that directly
            \\encloses the loop body.
    );
    code_block(
        53,
        "text",
        #string
            \\// if ready  tally := 5;
            \\// total := tally;
            \\error: unbound 'tally'
            \\// for i: 0..3 { }
            \\// last := i;
            \\error: unbound 'i'
    );
    paragraph(
        54,
        #string,oneline
            \\Names bound by a pattern belong to the branch that the pattern
            \\selects (see `#pattern` Matching and Pattern Forms). The exception is
            \\`#pattern P := value else { ... }`, which binds its names in the
            \\enclosing scope (see Coverage, Binding Forms, and Pattern Constants).
    );
    subheading(55, "Redeclaration and shadowing");
    paragraph(
        56,
        #string,oneline
            \\One statement list declares a name at most once. A nested scope may
            \\declare the name again, and the new declaration hides the outer one
            \\until the nested scope ends. In the same way a procedure body may hide
            \\a parameter, a loop body a loop variable, and any local a top-level
            \\name of the module.
    );
    code_block(
        57,
        "text",
        #string
            \\// total := 1;
            \\// total := 2;
            \\error: 'total' is already declared in this scope
            \\note: first declared here
    );
    code_block(
        58,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\LIMIT :: 100;
            \\counter := 10;
            \\
            \\scale :: (value: s64) -> s64 {
            \\    value := value * 2;
            \\    return value;
            \\}
            \\
            \\main :: () {
            \\    LIMIT := 5;
            \\    counter := counter + 1;
            \\    print("{} {} {}\n", LIMIT, counter, scale(4));
            \\    {
            \\        LIMIT := "inner";
            \\        print("{}\n", LIMIT);
            \\    }
            \\    print("{} {}\n", LIMIT, global_counter());
            \\}
            \\
            \\global_counter :: () -> s64 { return counter; }
    );
    code_block(
        59,
        "text",
        #string
            \\5 11 8
            \\inner
            \\5 10
    );
    paragraph(
        60,
        #string,oneline
            \\In `counter := counter + 1;` the value still refers to the global,
            \\because the new name is in scope only after its declaration, and the
            \\global keeps its own value, as `global_counter` shows. A local also
            \\hides a procedure of the same name in calls, and can even hide a type
            \\name such as `s64`, so local names should not reuse the names that a
            \\procedure needs:
    );
    code_block(
        61,
        "text",
        #string
            \\// print := 3;
            \\// print("{}\n", print);
            \\error: cannot call value of type ssize
    );
    subheading(62, "`#if` opens no scope");
    paragraph(
        63,
        #string,oneline
            \\A `#if` inside a procedure keeps only the statements of the selected
            \\branch, and its braces only delimit the branches; they do not open a
            \\scope. A name declared in the selected branch stays visible after the
            \\`#if`, which lets a procedure declare a value differently for
            \\different targets (see `#if`, `#assert`, and `#compile_error`). For
            \\the same reason, a `defer` in a branch belongs to the enclosing scope
            \\(see Deferred Statements).
    );
    code_block(
        64,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    #if OUT.os == Target_OS.Windows {
            \\        separator := "\\";
            \\    } else {
            \\        separator := "/";
            \\    }
            \\    print("separator {}\n", separator);
            \\}
    );
    code_block(
        65,
        "text",
        #string
            \\separator /
    );
    note(
        66,
        #string,oneline
            \\Because a branch of `#if` is not a scope, the compiler does not
            \\report a declaration in it that repeats a name of the enclosing
            \\scope: the branch's declaration hides the earlier one from that point
            \\on. Do not reuse a name across a `#if` boundary.
    );
    subheading(67, "Local procedures and types");
    paragraph(
        68,
        #string,oneline
            \\Procedures, structs, enums, unions and `distinct` types may be
            \\declared inside a body. Such a name belongs to the enclosing block and
            \\can be used anywhere in it, even above its declaration. Separate
            \\blocks and separate procedures may declare the same local name
            \\independently.
    );
    code_block(
        69,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\collect :: () {
            \\    print("collect {}\n", twice(Sample.{ .value = 3 }));
            \\    Sample :: struct { value: s64; }
            \\    twice :: (sample: Sample) -> s64 { return sample.value * 2; }
            \\}
            \\
            \\report :: () {
            \\    Sample :: struct { value: s64; scale: s64; }
            \\    sample := Sample.{ .value = 3, .scale = 3 };
            \\    print("report {}\n", sample.value * sample.scale);
            \\}
            \\
            \\main :: () {
            \\    collect();
            \\    report();
            \\}
    );
    code_block(
        70,
        "text",
        #string
            \\collect 6
            \\report 9
    );
    paragraph(
        71,
        #string,oneline
            \\A local procedure is not a closure. Its body sees the top-level names
            \\of the module and the local procedures and types of the blocks around
            \\it, but none of the enclosing procedure's variables or value
            \\constants: not even a `K :: 5;` or a type alias such as
            \\`Row :: [4]s64;`. Such values are passed as arguments. A lambda
            \\cannot read the enclosing procedure's locals either (see Lambdas and
            \\`#fn_ptr` Values).
    );
    code_block(
        72,
        "text",
        #string
            \\// base := 10;
            \\// add :: (x: s64) -> s64 { return x + base; }
            \\error: unbound 'base'
    );
    subheading(73, "The module scope");
    paragraph(
        74,
        #string,oneline
            \\The top level of a module is one scope that covers the whole file,
            \\whatever the order of its declarations. A procedure may call one
            \\declared below it, a global may have a type declared later, and the
            \\imports may come last:
    );
    code_block(
        75,
        "glosso",
        #string
            \\main :: () {
            \\    print("later() = {}\n", later());
            \\    print("origin.x = {}\n", origin.x);
            \\}
            \\
            \\later :: () -> s64 { return LIMIT / 2; }
            \\origin: Point = .{ .x = 3, .y = 4 };
            \\Point :: struct { x: s64; y: s64; }
            \\LIMIT :: 64;
            \\
            \\#import "Io";
    );
    code_block(
        76,
        "text",
        #string
            \\later() = 32
            \\origin.x = 3
    );
    paragraph(
        77,
        #string,oneline
            \\A module declares each top-level name once. A second declaration is an
            \\error even for a procedure with other parameters, and also when the
            \\two declarations are of different kinds:
    );
    code_block(
        78,
        "text",
        #string
            \\// f :: (x: s64) {}
            \\// f :: (x: str) {}
            \\error: function 'f' is already declared
            \\// K :: 1;
            \\// K := 2;
            \\error: 'K' is already declared with a different declaration kind
            \\note: previous declaration is here
    );
    paragraph(
        79,
        #string,oneline
            \\Imported names share the module scope with the module's own
            \\declarations. A top-level declaration may reuse a name of the prelude,
            \\and then takes precedence over it (see Modules, Imports, and the
            \\Prelude). A name that the module both declares and imports from
            \\another module is ambiguous where it is used. Binding the import to a
            \\namespace, or leaving the name out of its import list, resolves the
            \\ambiguity.
    );
    code_block(
        80,
        "text",
        #string
            \\// #import "Math/Core";
            \\// sqrt :: (x: f64) -> f64 { return x; }
            \\// main :: () { y := sqrt(2.0); }
            \\error: ambiguous imported name 'sqrt'
            \\note: candidate declared in std/Math/Core.glo
            \\note: candidate declared in main.glo
            \\note: qualify the name with its module alias, or select a single import
    );
    subheading(81, "How a name is found");
    paragraph(
        82,
        #string,oneline
            \\Taken together, these rules look up a name used in a procedure body
            \\in the following places, and the first one that has it wins:
    );
    bullet(
        83,
        #string,oneline
            \\The scopes around the use, from the innermost one out to the
            \\procedure's parameters: the enclosing blocks and bodies, and the
            \\variables of each enclosing `for` loop. A variable or constant counts
            \\only below its declaration; a local procedure or type counts in its
            \\whole block.
    );
    bullet(
        84,
        #string,oneline
            \\Inside a local procedure, the enclosing procedure's variables and
            \\value constants are skipped; only the local procedures and types of
            \\the blocks around it are found.
    );
    bullet(
        85,
        #string,oneline
            \\The module scope: the module's own top-level declarations and the
            \\names its imports bring in. A name found both ways is ambiguous.
    );
    bullet(
        86,
        #string,oneline
            \\The prelude, whose names a top-level declaration of the module
            \\hides.
    );
    paragraph(
        87,
        #string,oneline
            \\Two kinds of name follow rules of their own. Labels belong to the
            \\whole procedure rather than to a block (see Labels, `goto`, and
            \\Non-Local Transfers), and the field names that a `using` statement
            \\brings in last until the end of its scope (see Struct Types).
    );
}

render_section_45 :: () {
    paragraph(
        0,
        #string,oneline
            \\A deferred statement runs when the scope it is written in is left,
            \\not where it is written. This chapter describes the order in which
            \\deferred statements run, which ways of leaving a scope run them, when
            \\their expressions are evaluated, what they may contain, the
            \\`#try defer` form that runs only when a failure propagates, and the
            \\form a macro uses to defer a statement into its caller.
    );
    subheading(1, "Pending statements run in reverse order");
    paragraph(
        2,
        #string,oneline
            \\`defer statement;` does not run the statement. It adds the statement
            \\to the list of pending statements of the enclosing scope, and when the
            \\scope is left the list runs in reverse order, last added first.
            \\`defer { ... }` defers a whole block as one entry.
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    defer print("end of main\n");
            \\    {
            \\        defer print("A\n");
            \\        defer print("B\n");
            \\        defer {
            \\            print("C1\n");
            \\            print("C2\n");
            \\        }
            \\        print("block body\n");
            \\    }
            \\    print("after block\n");
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\block body
            \\C1
            \\C2
            \\B
            \\A
            \\after block
            \\end of main
    );
    paragraph(
        5,
        #string,oneline
            \\Each entry belongs to the scope it is written in. The inner block's
            \\entries run at its closing brace, while the entry in `main` waits
            \\until `main` ends. Running them in reverse undoes work in the opposite
            \\order from the one in which it was done.
    );
    subheading(6, "Releasing what a scope acquired");
    paragraph(
        7,
        #string,oneline
            \\The common use of `defer` is to release a resource on the line after
            \\acquiring it. The release then runs on every way out of the scope, and
            \\it stays next to the acquisition however the code between them
            \\changes. `Freeable`, Copies, and Ownership Transfer describes `free`.
    );
    code_block(
        8,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\sum_of_squares :: (n: s64) -> s64 {
            \\    values: [..]s64;
            \\    defer values.free();
            \\    for i: 0..n values.push(i * i);
            \\    total: s64 = 0;
            \\    for v: values total += v;
            \\    return total;
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", sum_of_squares(4));
            \\}
    );
    code_block(
        9,
        "text",
        #string
            \\14
    );
    subheading(10, "Which exits run the pending statements");
    table_header(11, "Leaving the scope by   —   Pending statements");
    table_row(12, "Reaching the closing brace   |   Run.");
    table_row(
        13,
        "`return`   |   Run, for every scope from the `return` out to the procedure body."
    );
    table_row(14, "`break` and `continue`   |   Run, for every scope out to the loop body.");
    table_row(15, "The end of a loop iteration   |   Run, once per iteration.");
    table_row(16, "`?` propagating a failure   |   Run, as for `return`.");
    table_row(17, "`goto`   |   Not run.");
    table_row(18, "A jump to a saved state, such as `longjmp` or `throw`   |   Not run.");
    table_row(
        19,
        "`exit` or another `#Never` call, or a failed runtime check   |   Not run; the process ends."
    );
    paragraph(
        20,
        #string,oneline
            \\A `return` from inside a loop runs the entries of the loop body and
            \\then those of the procedure body:
    );
    code_block(
        21,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\find :: (values: []s64, wanted: s64) -> s64 {
            \\    defer print("find returns\n");
            \\    for value, index: values {
            \\        defer print("  checked {}\n", index);
            \\        if value == wanted return index;
            \\    }
            \\    return -1;
            \\}
            \\
            \\main :: () {
            \\    values: [4]s64 = .[5, 7, 9, 11];
            \\    print("found at {}\n", find(values[..], 9));
            \\}
    );
    code_block(
        22,
        "text",
        #string
            \\  checked 0
            \\  checked 1
            \\  checked 2
            \\find returns
            \\found at 2
    );
    paragraph(
        23,
        #string,oneline
            \\The loop body is a scope, so its entry is added and run once per
            \\iteration, including an iteration that `continue` or `break` cuts
            \\short:
    );
    code_block(
        24,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    i := 0;
            \\    while i < 4 {
            \\        i += 1;
            \\        defer print("leaving iteration {}\n", i);
            \\        if i == 2 continue;
            \\        if i == 3 break;
            \\        print("body {}\n", i);
            \\    }
            \\    print("done i={}\n", i);
            \\}
    );
    code_block(
        25,
        "text",
        #string
            \\body 1
            \\leaving iteration 1
            \\leaving iteration 2
            \\leaving iteration 3
            \\done i=3
    );
    paragraph(
        26,
        #string,oneline
            \\`goto` transfers control to its label without unwinding the scopes it
            \\leaves, so their pending statements are skipped. The scopes that are
            \\still active at the label run theirs as usual. Labels, `goto`, and
            \\Non-Local Transfers describes `goto`, and also the jumps to saved
            \\states, which skip pending statements in the same way.
    );
    code_block(
        27,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\main :: () {
            \\    defer print("main defer\n");
            \\    {
            \\        defer print("block defer\n");
            \\        print("before goto\n");
            \\        goto('out);
            \\    }
            \\'out;
            \\    print("after goto\n");
            \\}
    );
    code_block(
        28,
        "text",
        #string
            \\before goto
            \\after goto
            \\main defer
    );
    paragraph(
        29,
        #string,oneline
            \\A procedure whose return type is `#Never`, such as `exit`, does not
            \\return, and the process ends inside it without running any pending
            \\statement. The program below prints its message and exits with
            \\status 2, and `cleanup` is never printed:
    );
    code_block(
        30,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\fail :: (message: str) -> #Never {
            \\    print("fatal: {}\n", message);
            \\    exit(2);
            \\}
            \\
            \\main :: () {
            \\    defer print("cleanup\n");
            \\    fail("disk full");
            \\}
    );
    code_block(
        31,
        "text",
        #string
            \\fatal: disk full
    );
    subheading(32, "When the deferred statement is evaluated");
    paragraph(
        33,
        #string,oneline
            \\A deferred statement is evaluated when it runs, not when it is
            \\written, so it sees every change made after the `defer`. A `return`
            \\computes its value before the pending statements run, so a deferred
            \\assignment to the returned variable does not change the result.
    );
    code_block(
        34,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\answer :: () -> s64 {
            \\    x: s64 = 1;
            \\    defer x = 99;
            \\    defer print("deferred print sees x={}\n", x);
            \\    x = 2;
            \\    return x;
            \\}
            \\
            \\main :: () {
            \\    print("answer returned {}\n", answer());
            \\}
    );
    code_block(
        35,
        "text",
        #string
            \\deferred print sees x=2
            \\answer returned 2
    );
    subheading(36, "What a deferred statement may contain");
    paragraph(
        37,
        #string,oneline
            \\Any statement can be deferred: a call, an assignment, an `if`, a loop
            \\or a block. Since it runs while its scope is being left, it cannot
            \\leave that scope itself. `return`, `goto`, and a `break` or `continue`
            \\that would leave the deferred statement are errors, and so is `?`. A
            \\loop inside the deferred statement may still use `break` and
            \\`continue` for itself.
    );
    code_block(
        38,
        "text",
        #string
            \\// defer return;
            \\error: `return` cannot leave a deferred statement
            \\// for 0..3 { defer break; }
            \\error: `break` cannot leave a deferred statement
            \\// defer _ := flush()?;
            \\error: `?` cannot be used inside a deferred statement
            \\help: discard the result explicitly instead, for example `defer _ := f.close();`
    );
    paragraph(
        39,
        #string,oneline
            \\A `#if` opens no scope (see Assignment, Blocks, and Name Lookup), so
            \\a `defer` in one of its branches belongs to the scope around the
            \\`#if`:
    );
    code_block(
        40,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    #if true {
            \\        defer print("deferred inside #if\n");
            \\        print("in #if\n");
            \\    }
            \\    print("after #if\n");
            \\}
    );
    code_block(
        41,
        "text",
        #string
            \\in #if
            \\after #if
            \\deferred inside #if
    );
    subheading(42, "`#try defer`: undoing work on failure");
    paragraph(
        43,
        #string,oneline
            \\`#try defer statement;` adds an entry that runs only when the scope
            \\is left by `?` propagating a failure. It undoes work that only a
            \\successful completion keeps, next to a plain `defer` that releases
            \\resources on every path. Propagation with `?` is described in `Try`,
            \\`?`, `#try`, and `Termination`.
    );
    code_block(
        44,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\step :: (fail: bool) -> str!s64 {
            \\    if fail return .Err("step failed");
            \\    return .Ok(1);
            \\}
            \\
            \\transfer :: (fail: bool) -> str!s64 {
            \\    print("  reserve\n");
            \\    #try defer print("  roll back the reservation\n");
            \\    defer print("  close the log\n");
            \\    amount := step(fail)?;
            \\    print("  commit\n");
            \\    return .Ok(amount);
            \\}
            \\
            \\main :: () {
            \\    print("success:\n");
            \\    _ := transfer(false);
            \\    print("failure:\n");
            \\    _ := transfer(true);
            \\}
    );
    code_block(
        45,
        "text",
        #string
            \\success:
            \\  reserve
            \\  commit
            \\  close the log
            \\failure:
            \\  reserve
            \\  close the log
            \\  roll back the reservation
    );
    paragraph(
        46,
        #string,oneline
            \\Both kinds of entry share one list. On the success path the rollback
            \\is skipped. On the failure path it runs at its place in the list, and
            \\so it runs last, because it was written first.
    );
    note(
        47,
        #string,oneline
            \\Only `?` counts as a failure. `return .Err(...)` written by hand is an
            \\ordinary return: the plain entries run and the `#try defer` entries
            \\do not. A procedure that fails by returning `.Err` directly needs its
            \\rollback written out on that path.
    );
    paragraph(
        48,
        #string,oneline
            \\The procedure may return any type with a `Try` instance, such as an
            \\optional, and then `?` on `null` counts as the failure. A `#try defer`
            \\in a nested block belongs to that block, and leaving the block
            \\normally discards it, so a failure after the block does not run it:
    );
    code_block(
        49,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\lookup :: (key: s64) -> ?s64 {
            \\    if key > 2 return null;
            \\    return .Some(key * 10);
            \\}
            \\
            \\sum :: (a: s64, b: s64) -> ?s64 {
            \\    #try defer print("  sum failed\n");
            \\    x := lookup(a)?;
            \\    {
            \\        #try defer print("  never printed\n");
            \\        print("  first key found\n");
            \\    }
            \\    y := lookup(b)?;
            \\    return .Some(x + y);
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", sum(1, 2).unwrap_or(-1));
            \\    print("{}\n", sum(1, 5).unwrap_or(-1));
            \\}
    );
    code_block(
        50,
        "text",
        #string
            \\  first key found
            \\30
            \\  first key found
            \\  sum failed
            \\-1
    );
    paragraph(
        51,
        #string,oneline
            \\In a procedure whose result cannot fail, a `#try defer` could never
            \\run, and it is rejected:
    );
    code_block(
        52,
        "text",
        #string
            \\// main :: () { #try defer print("rolled back\n"); }
            \\error: #try defer requires a Try-returning function or an enclosing #try block
    );
    subheading(53, "Deferring into the caller");
    paragraph(
        54,
        #string,oneline
            \\Inside a macro (see `#code`, `#insert`, and `#expand`), a plain
            \\`defer` belongs to the macro's own body and runs when the expansion
            \\ends. Written with a backtick in front of the keyword, as in `trace`
            \\below, the statement is added to the scope of the code that called
            \\the macro instead, and runs when that scope is left:
    );
    code_block(
        55,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\trace :: (name: str) #expand {
            \\    print("enter {}\n", name);
            \\    `defer print("leave {}\n", name);
            \\}
            \\
            \\work :: () {
            \\    trace("work");
            \\    print("working\n");
            \\}
            \\
            \\main :: () {
            \\    work();
            \\    print("back in main\n");
            \\}
    );
    code_block(
        56,
        "text",
        #string
            \\enter work
            \\working
            \\leave work
            \\back in main
    );
}

render_section_46 :: () {
    paragraph(
        0,
        #string,oneline
            \\This chapter covers the syntax that every procedure body shares: how
            \\statements are written and terminated, expression statements, and
            \\the two conditional forms, the `if` statement with its `else` and the
            \\`ifx` expression. Branching and Looping introduces them by example.
            \\The switch forms, which are also written with `if` and `ifx`, are
            \\described in Switch Statements, and the last section lists every
            \\statement form with the chapter that describes it.
    );
    subheading(1, "Simple statements and statements with bodies");
    paragraph(
        2,
        #string,oneline
            \\A procedure body is a sequence of statements, run in order. They come
            \\in two kinds. A simple statement, such as a declaration, an assignment
            \\or a call, ends with a semicolon. A statement that has a body of its
            \\own, such as `if`, `while`, `for` or a block, ends where its body ends
            \\and takes no semicolon.
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    total := 0;                  // declaration
            \\    total += 5;                  // compound assignment
            \\    print("{}\n", total);        // expression statement
            \\    if total > 3 {               // ends with its body
            \\        print("large\n");
            \\    }
            \\    for i: 0..3 total += i;      // a body of one statement
            \\    print("{}\n", total);
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\5
            \\large
            \\8
    );
    subheading(5, "Newlines are not terminators");
    paragraph(
        6,
        #string,oneline
            \\A line break is ordinary whitespace. Nothing is inserted at the end of
            \\a line, so a statement continues over as many lines as it needs, and
            \\a token that can continue the expression on the line above does
            \\continue it. A parenthesis at the start of a line is a call of what
            \\came before, and a leading `-` is a subtraction:
    );
    code_block(
        7,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\double :: (n: s64) -> s64 { return n * 2; }
            \\
            \\main :: () {
            \\    a := double
            \\        (3);
            \\    b := 10
            \\        - 4;
            \\    print("{} {}\n", a, b);
            \\}
    );
    code_block(
        8,
        "text",
        #string
            \\6 6
    );
    paragraph(
        9,
        #string,oneline
            \\The other side of the rule is that a missing semicolon is noticed
            \\only at the next token that cannot continue the statement, which is
            \\usually the first token of the following line:
    );
    code_block(
        10,
        "text",
        #string
            \\// main :: () {
            \\//     a := 1
            \\//     b := 2;
            \\// }
            \\error: unexpected token 'b'
            \\  --> main.glo:3:5
    );
    subheading(11, "Where a semicolon is required");
    table_header(12, "Statement   —   Examples");
    table_row(
        13,
        "A local declaration   |   `x := 1;`, `x: s64;`, `LIMIT :: 64;`, `a, b := pair();`"
    );
    table_row(14, "An assignment   |   `x = 2;`, `total += x;`");
    table_row(15, "`return`   |   `return;`, `return value;`, `return a, b;`");
    table_row(16, "An expression statement   |   `work();`, `count + 1;`");
    table_row(17, "A label   |   `'retry;`");
    table_row(
        18,
        "A `case` label or `else` in a switch   |   `case 1;`, `case .Red, .Green;`, `else;`"
    );
    paragraph(
        19,
        #string,oneline
            \\A few statements accept a semicolon but do not need one: `break`,
            \\`continue`, `using name`, `#push_allocator(a)`, the compile-time
            \\statements `#comptime`, `#assert`, `#compile_error` and `#insert`, and
            \\`#pattern P := value else { ... }`. Writing the semicolon is the
            \\common style for all of them except the last, which ends with a block
            \\as `if` does.
    );
    subheading(20, "Statements that end with their body");
    paragraph(
        21,
        #string,oneline
            \\`if` with its `else`, a switch, `while`, `for`, `#if`, a block
            \\`{ ... }`, `#push_context` and `#temp_scope` end with their body.
            \\When the body is a single statement, that statement brings its own
            \\terminator, so `if ready count += 1;` ends at the semicolon of
            \\`count += 1;`. When the body is a block, nothing follows the closing
            \\brace. `defer` takes one statement in the same way: `defer
            \\file.close();` ends with the call's semicolon and `defer { ... }`
            \\with the brace.
    );
    paragraph(
        22,
        #string,oneline
            \\There is no empty statement, so a semicolon that no statement asks
            \\for is an error, whether it follows a closing brace, doubles another
            \\semicolon or stands alone:
    );
    code_block(
        23,
        "text",
        #string
            \\// if ready { count += 1; };
            \\error: unexpected token ';'
            \\// x := 1;;
            \\error: unexpected token ';'
    );
    paragraph(
        24,
        #string,oneline
            \\At the top level of a file the same mistake has a message of its own,
            \\because a top-level `;` cannot start a declaration:
    );
    code_block(
        25,
        "text",
        #string
            \\// main :: () {};
            \\error: expected a declaration, found ';'
            \\help: a declaration whose body is braced ends at its '}', and is not followed by a semicolon; remove it
    );
    subheading(26, "Expression statements");
    paragraph(
        27,
        #string,oneline
            \\Any expression followed by a semicolon is a statement. Its value is
            \\computed and discarded. The compiler does not warn about a discarded
            \\value, not even about a result `E!T` whose error then goes unnoticed,
            \\so handle such a result with `?` or a pattern, or discard it visibly
            \\with `_ := operation();`.
    );
    subheading(28, "`if` and `else`");
    paragraph(
        29,
        #string,oneline
            \\`if` runs its body when its condition holds, and `else` gives the body
            \\for the other case. The condition is written without parentheses, and
            \\each body is either a block or a single statement.
    );
    code_block(
        30,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    n := 5;
            \\    if n > 3 print("greater than 3\n");
            \\    if n > 100 print("huge\n"); else print("not huge\n");
            \\    if n == 5 {
            \\        print("five\n");
            \\    } else if n == 6 {
            \\        print("six\n");
            \\    } else {
            \\        print("something else\n");
            \\    }
            \\    if (n > 3) && (n < 10) print("between\n");
            \\}
    );
    code_block(
        31,
        "text",
        #string
            \\greater than 3
            \\not huge
            \\five
            \\between
    );
    paragraph(
        32,
        #string,oneline
            \\Parentheses in a condition are ordinary grouping, as in the last
            \\`if`. `else if` is an `else` whose body is another `if`, so a chain
            \\may be as long as needed. Every body is a scope of its own, braced or
            \\not (see Assignment, Blocks, and Name Lookup).
    );
    paragraph(
        33,
        #string,oneline
            \\The condition of an `if` may be a `bool` or any value with a
            \\truthiness rule, such as an integer, a string or an optional pointer;
            \\`bool` and Conditions lists the rules. Two other conditions have
            \\chapters of their own: `if #pattern P = value`, which tests a value
            \\against a pattern (see `#pattern` Matching and Pattern Forms), and
            \\`if value == { ... }`, which is a switch (see Switch Statements).
    );
    subheading(34, "Which `if` an `else` belongs to");
    paragraph(
        35,
        #string,oneline
            \\An `else` belongs to the nearest `if` that does not have one yet.
            \\Indentation does not change that:
    );
    code_block(
        36,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    n := 5;
            \\    if n > 0
            \\        if n > 100 print("inner\n");
            \\    else print("this else belongs to the inner if\n");
            \\}
    );
    code_block(
        37,
        "text",
        #string
            \\this else belongs to the inner if
    );
    paragraph(
        38,
        #string,oneline
            \\To give the `else` to the outer `if`, put the inner one in braces:
            \\`if n > 0 { if n > 100 print("inner\n"); } else ...`.
    );
    subheading(39, "`ifx`");
    paragraph(
        40,
        #string,oneline
            \\`if` is a statement and produces no value. `ifx` is its expression
            \\form: `ifx condition a else b` evaluates the condition, then evaluates
            \\and yields either `a` or `b`. Only the selected arm is evaluated.
    );
    code_block(
        41,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    enabled := true;
            \\    print("{}\n", ifx enabled "on" else "off");
            \\    n := 5;
            \\    size := ifx n > 10 "big" else ifx n > 3 "medium" else "small";
            \\    print("{}\n", size);
            \\}
    );
    code_block(
        42,
        "text",
        #string
            \\on
            \\medium
    );
    paragraph(
        43,
        #string,oneline
            \\An `ifx` has to yield a value on every path, so the `else` arm is
            \\required:
    );
    code_block(
        44,
        "text",
        #string
            \\// x := ifx ready "yes";
            \\error: cannot decide a value: an 'ifx' needs an 'else' arm
            \\note: add 'else <expr>', or use the switch form 'ifx <subject> == { ... }'
    );
    paragraph(
        45,
        #string,oneline
            \\The condition of an `ifx` must be a `bool`; the truthiness rules of
            \\`if` do not apply to it. Its arms are expressions, not blocks, and a
            \\brace cannot start an expression:
    );
    code_block(
        46,
        "text",
        #string
            \\// n := 3; x := ifx n "a" else "b";
            \\error: got ssize, expected bool
            \\// x := ifx ready { 1 } else { 2 };
            \\error: unexpected token '{'
    );
    paragraph(
        47,
        #string,oneline
            \\The `else` arm extends as far to the right as an expression can, so
            \\`ifx b 1 else 2 + 10` means `ifx b 1 else (2 + 10)`. Parentheses
            \\around the whole `ifx` make it an operand:
    );
    code_block(
        48,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    b := false;
            \\    v := ifx b 1 else 2 + 10;
            \\    w := (ifx b 1 else 2) + 10;
            \\    x := 100 + ifx b 1 else 2;
            \\    print("{} {} {}\n", v, w, x);
            \\}
    );
    code_block(
        49,
        "text",
        #string
            \\12 12 102
    );
    note(
        50,
        #string,oneline
            \\The condition also extends as far as it can. An arm that begins with
            \\a token that could continue the condition, such as `-`, `(`, `&` or
            \\`*`, becomes part of it: `ifx b -1 else 1` reads `b - 1` as the
            \\condition and then fails with `error: unexpected token 'else'`. Put
            \\such an arm second (`ifx !b 1 else -1`) or name its value first. The
            \\single-statement body of an `if` has the same problem, and braces
            \\avoid it.
    );
    subheading(51, "The type of an `ifx`");
    paragraph(
        52,
        #string,oneline
            \\The arms must agree on one type. An untyped number literal in one arm
            \\takes its type from the other arm, so an integer literal next to a
            \\float becomes the float type and a literal next to an `s32` becomes an
            \\`s32`. Two literals of different kinds join the way they would in
            \\arithmetic (see Literal Typing and Type Conversion).
    );
    code_block(
        53,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\main :: () {
            \\    b := true;
            \\    m: s32 = 4;
            \\    a := ifx b 1 else 2.5;
            \\    c := ifx b m else 7;
            \\    d := ifx b 7 else m;
            \\    e := ifx b cast(f32) 1.0 else 2.0;
            \\    print("{} {} {} {}\n", type_name(type_of(a)), type_name(type_of(c)),
            \\        type_name(type_of(d)), type_name(type_of(e)));
            \\}
    );
    code_block(
        54,
        "text",
        #string
            \\f64 s32 s32 f32
    );
    paragraph(
        55,
        #string,oneline
            \\Arms whose types cannot meet are reported at the arm that does not
            \\fit:
    );
    code_block(
        56,
        "text",
        #string
            \\// x := ifx b 1 else "two";
            \\error: got ssize, expected str
    );
    subheading(57, "Jumps as values: arms that leave");
    paragraph(
        58,
        #string,oneline
            \\`return`, `break` and `continue` are statements, and they are also
            \\expressions of type `#Never`, the type of an expression that does not
            \\produce a value. `#Never` converts to every type, so a jump may stand
            \\where a value is expected, most usefully as an arm of an `ifx`, which
            \\then leaves instead of producing a value. In a loop this filters and
            \\binds in one statement, and `v := ifx x > 0 x else return -1;` does
            \\the same in a procedure:
    );
    code_block(
        59,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    xs: [5]s64 = .[1, 3, 4, 6, 7];
            \\    total := 0;
            \\    for v: xs {
            \\        w := ifx v < 6 v else break;
            \\        total += w;
            \\    }
            \\    evens := 0;
            \\    for v: xs {
            \\        w := ifx v % 2 == 0 v else continue;
            \\        evens += w;
            \\    }
            \\    print("total={} evens={}\n", total, evens);
            \\}
    );
    code_block(
        60,
        "text",
        #string
            \\total=8 evens=10
    );
    paragraph(
        61,
        #string,oneline
            \\`ifx` also has a switch form, `ifx value == { case ...; }`, which
            \\yields the value of the arm that matches (see Switch Statements). When
            \\the value to choose depends on the shape of an optional or a union,
            \\use that form: a `#pattern` test can be the condition of an `ifx`, but
            \\its captures are not visible in the arms.
    );
    subheading(62, "Index of statement forms");
    paragraph(
        63,
        #string,oneline
            \\Every statement form, and the chapter that describes it:
    );
    table_header(64, "Form   —   Described in");
    table_row(
        65,
        "`x := e;`, `x: T = e;`, `X :: e;`, `a, b := e;`   |   Constants, Variables, and Globals"
    );
    table_row(66, "`target = e;`, `target += e;`   |   Assignment, Blocks, and Name Lookup");
    table_row(67, "`{ ... }`, local procedures and types   |   Assignment, Blocks, and Name Lookup");
    table_row(68, "`if`, `else`, and the expression `ifx`   |   This chapter");
    table_row(69, "`if subject == { case ...; }`, `ifx subject == { ... }`   |   Switch Statements");
    table_row(
        70,
        "`while`, `for`, `break`, `continue`, `#inline for`, `#inline while`   |   `while`, `for`, and Unrolled Loops"
    );
    table_row(71, "`'name;`   |   Labels, `goto`, and Non-Local Transfers");
    table_row(72, "`return`   |   Procedure Declarations and Arguments");
    table_row(73, "`defer`, `#try defer`   |   Deferred Statements");
    table_row(74, "`using name;`   |   Struct Types");
    table_row(
        75,
        "`if #pattern P = e`, `while #pattern P = e`   |   `#pattern` Matching and Pattern Forms"
    );
    table_row(
        76,
        "`#pattern P := e else { ... }`   |   Coverage, Binding Forms, and Pattern Constants"
    );
    table_row(77, "`#if`, `#assert`, `#compile_error`   |   `#if`, `#assert`, and `#compile_error`");
    table_row(78, "`#comptime`   |   Compile-Time Evaluation");
    table_row(79, "`#insert`   |   `#code`, `#insert`, and `#expand`");
    table_row(80, "`#push_context`   |   `#Context` and `context`");
    table_row(81, "`#push_allocator`   |   `Allocator` and Allocation Procedures");
    table_row(82, "`#temp_scope { ... }`   |   The Temporary Allocator");
    table_row(83, "`#asm`, `#bytes`   |   `#asm`, `#bytes`, and `#magic`");
    paragraph(
        84,
        #string,oneline
            \\Visibility directives belong to top-level declarations only: a
            \\`#public` or `#private` in front of a local statement is `error:
            \\visibility directives are not allowed on local statements or
            \\declarations`.
    );
}

render_section_47 :: () {
    paragraph(
        0,
        #string,oneline
            \\A switch runs one of several arms, chosen by matching a value against
            \\the patterns of its case labels. Glosso has no `switch` keyword. A
            \\switch statement is an `if` whose condition is a subject followed by
            \\`==` and a brace, and a switch expression is the same thing written
            \\with `ifx`. Branching and Looping and Enums, Unions, and Matching
            \\introduce switches by example. This chapter gives the complete rules;
            \\the patterns themselves are described in `#pattern` Matching and
            \\Pattern Forms, and the analysis that checks a switch for missing and
            \\unreachable arms in Coverage, Binding Forms, and Pattern Constants.
    );
    code_block(
        1,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\classify :: (n: s64) -> str {
            \\    if n == {
            \\    case ..=0;     return "not positive";
            \\    case 1, 2, 3;  return "small";
            \\    case 4..=9;    return "one digit";
            \\    case 10..;     return "large";
            \\    }
            \\}
            \\
            \\main :: () {
            \\    print("{}, {}, {}, {}\n", classify(-5), classify(2), classify(7), classify(99));
            \\}
    );
    code_block(
        2,
        "text",
        #string
            \\not positive, small, one digit, large
    );
    subheading(3, "The shape of a switch");
    paragraph(
        4,
        #string,oneline
            \\The brace after `==` holds `case` arms, each a pattern and a semicolon
            \\followed by the arm's statements, and an optional `else;` arm for
            \\every value no case matches. The semicolons after a `case` label and
            \\after `else` are required, because they mark where the label ends and
            \\the arm's body begins. An arm's body is a list of statements and needs
            \\no braces of its own.
    );
    code_block(
        5,
        "text",
        #string
            \\if subject == {
            \\case pattern;
            \\    statements
            \\case pattern, pattern;
            \\    statements
            \\case pattern if condition;
            \\    statements
            \\else;
            \\    statements
            \\}
    );
    code_block(
        6,
        "text",
        #string
            \\// if n == { case 1 print("one\n"); else; }
            \\error: unexpected token 'print'
    );
    paragraph(
        7,
        #string,oneline
            \\Only an `==` that is directly followed by `{` makes a switch, so
            \\`if a == b { ... }` is an ordinary comparison. A brace can never start
            \\an expression (an aggregate literal is written `.{ ... }`), so the two
            \\cannot be confused. To switch on the result of a comparison,
            \\parenthesize it: `if (a == b) == { case true; ... }`.
    );
    subheading(8, "How a switch runs");
    paragraph(
        9,
        #string,oneline
            \\The subject is evaluated once, and the cases are tried from top to
            \\bottom. The first case that matches runs and the switch ends: control
            \\does not fall through into the next arm, and no `break` is needed to
            \\prevent it. Inside a loop, `break` and `continue` in an arm apply to
            \\the loop.
    );
    code_block(
        10,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\next_code :: () -> s64 {
            \\    print("subject evaluated\n");
            \\    return 2;
            \\}
            \\
            \\main :: () {
            \\    if next_code() == {
            \\    case 1;  print("one\n");
            \\    case 2;  print("two\n");
            \\    else;    print("other\n");
            \\    }
            \\    for i: 0..5 {
            \\        if i == {
            \\        case 1;  continue;
            \\        case 3;  break;
            \\        else;
            \\        }
            \\        print("{}\n", i);
            \\    }
            \\}
    );
    code_block(
        11,
        "text",
        #string
            \\subject evaluated
            \\two
            \\0
            \\2
    );
    paragraph(
        12,
        #string,oneline
            \\Each arm is a scope of its own (see Assignment, Blocks, and Name
            \\Lookup), and the names its pattern binds exist only in that arm.
    );
    subheading(13, "Case labels");
    paragraph(
        14,
        #string,oneline
            \\Every case label is a pattern, matched against the subject. These are
            \\the labels a switch uses most; `#pattern` Matching and Pattern Forms
            \\describes them all.
    );
    table_header(15, "Subject   —   Labels");
    table_row(
        16,
        "integer   |   `case 7;`, `case -1;`, `case 1, 2, 3;`, `case ..=0;`, `case 4..=9;`, `case 10..;`"
    );
    table_row(17, "`u8` character   |   `case #char \"q\";`, `case #char \"a\" ..= #char \"z\";`");
    table_row(18, "float, `str`   |   `case 2.5;`, `case \"red\", \"green\";`");
    table_row(19, "`bool`   |   `case true;`, `case false;`");
    table_row(20, "enum   |   `case Color.Red;`, `case .Red;`, `case Red;`");
    table_row(
        21,
        "tagged union   |   `case Shape.Circle(r);`, `case .Circle(r);`, `case Circle(r);`, `case .Empty;`"
    );
    table_row(22, "`?T`   |   `case .Some(x);`, `case null;`");
    table_row(23, "`E!T`   |   `case .Ok(x);`, `case .Err(e);`");
    table_row(24, "any   |   `case LIMIT;` or `case == LIMIT;` for a constant, `case _;`, `else;`");
    code_block(
        25,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Level :: enum { Info; Warn; Error; }
            \\Token :: union { Name: str; Code: s64; Eof: void; }
            \\
            \\main :: () {
            \\    level := Level.Warn;
            \\    if level == {
            \\    case .Info;           print("info\n");
            \\    case .Warn, .Error;   print("warn or error\n");
            \\    }
            \\    t: Token = .Code(42);
            \\    if t == {
            \\    case .Name(text);  print("name {}\n", text);
            \\    case .Code(code);  print("code {}\n", code);
            \\    case .Eof;         print("end\n");
            \\    }
            \\    color := "green";
            \\    if color == {
            \\    case "red";             print("stop\n");
            \\    case "green", "blue";   print("cool\n");
            \\    else;                   print("unknown\n");
            \\    }
            \\    found: ?s64 = .Some(5);
            \\    if found == {
            \\    case .Some(x);  print("found {}\n", x);
            \\    case null;      print("nothing\n");
            \\    }
            \\}
    );
    code_block(
        26,
        "text",
        #string
            \\warn or error
            \\code 42
            \\cool
            \\found 5
    );
    paragraph(
        27,
        #string,oneline
            \\A union arm such as `case .Code(code);` tests the tag and binds the
            \\payload to `code` for that arm's body. Matching is the only way to
            \\read a tagged union's payload (see Tagged and Untagged Unions). A
            \\variant or an enum member may be written with its type, with a
            \\leading dot, or bare.
    );
    note(
        28,
        #string,oneline
            \\A bare name in a label is a test only when it names an enum member, a
            \\union variant or a compile-time constant. Any other name is a capture
            \\that matches every value: with a variable `limit`, `case limit;` binds
            \\a new `limit` and always runs. Write `case == limit;` to compare
            \\against a variable.
    );
    paragraph(
        29,
        #string,oneline
            \\A union declared `#raw` has no tag, so its variants cannot be
            \\matched: `error: cannot match a variant of raw union Raw (it has no
            \\tag)`. Its members are read directly instead (see Tagged and Untagged
            \\Unions). The arms of a switch can also be generated while compiling,
            \\by an `#inline for` in the case list (see `while`, `for`, and
            \\Unrolled Loops).
    );
    subheading(30, "Every value needs an arm");
    paragraph(
        31,
        #string,oneline
            \\A switch has to handle every value its subject can have. The compiler
            \\proves this from the labels, and when it cannot, it lists the values
            \\that no arm handles:
    );
    code_block(
        32,
        "text",
        #string
            \\// Color :: enum { Red; Green; Blue; }
            \\// if c == { case .Red; print("r\n"); case .Green; print("g\n"); }
            \\error: non-exhaustive switch
            \\note: missing case: Color.Blue
            \\note: cover them, or add 'else' or '#partial'
    );
    paragraph(
        33,
        #string,oneline
            \\Enums, tagged unions, `bool` and integer ranges can be covered case by
            \\case, as `classify` above covers every `s64`. A float or `str` subject
            \\has too many values to list, so a switch on one always needs `else;`
            \\(its missing case is reported as `_`). Coverage, Binding Forms, and
            \\Pattern Constants describes the analysis, guards, and the warning for
            \\an arm that can never run.
    );
    subheading(34, "`#partial`");
    paragraph(
        35,
        #string,oneline
            \\`if #partial subject == { ... }` lifts the requirement: when no arm
            \\matches, nothing runs and execution continues after the switch.
            \\`#partial` is written directly after `if`. It does not apply to an
            \\ordinary `if`, nor to `ifx`, which must always produce a value.
    );
    code_block(
        36,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    n := 7;
            \\    if #partial n == {
            \\    case 1;  print("one\n");
            \\    case 2;  print("two\n");
            \\    }
            \\    print("after the switch\n");
            \\}
    );
    code_block(
        37,
        "text",
        #string
            \\after the switch
    );
    code_block(
        38,
        "text",
        #string
            \\// if #partial ready { }
            \\error: #partial can only modify an if-switch
    );
    paragraph(
        39,
        #string,oneline
            \\Prefer `else;` to `#partial` on an enum or union subject. With
            \\`#partial`, a member added to the enum later is silently skipped by
            \\the switch; without it, every switch that does not handle the new
            \\member is reported.
    );
    subheading(40, "Values outside an enum");
    paragraph(
        41,
        #string,oneline
            \\An enum value made with `cast` from an integer that names no member
            \\is not covered by any member's arm. At `-O0` and `-O1` the cast itself
            \\stops the program. At `-O2` and above the cast is not checked; a
            \\switch with `else;` then runs its `else` arm, and a switch without one
            \\stops the program:
    );
    code_block(
        42,
        "text",
        #string
            \\// raw: u32 = 7;
            \\// c := cast(Color) raw;
            \\// if c == { case .Red; print("r\n"); case .Green, .Blue; print("gb\n"); }
            \\$ glosso -O2 --run colors.glo 2>&1 | tail -2
            \\colors.glo:6:5: switch matched no case: undeclared enum value
            \\glosso: program exited with status 134
    );
    subheading(43, "Several patterns in one arm");
    paragraph(
        44,
        #string,oneline
            \\`case A, B, C;` is one arm for several patterns, the same as the
            \\or-pattern `case A | B | C;`. The patterns may bind names when every
            \\one of them binds the same names at the same types, as in
            \\`case .Circle(r), .Square(r);`.
    );
    subheading(45, "`#falling`");
    paragraph(
        46,
        #string,oneline
            \\`#falling` as the last statement of an arm continues into the body of
            \\the next arm without testing its pattern. It is for an arm that does
            \\some extra work and then everything the next arm does:
    );
    code_block(
        47,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Level :: enum { Trace; Debug; Info; Warn; }
            \\
            \\describe :: (level: Level) {
            \\    if level == {
            \\    case .Trace;  print("T"); #falling;
            \\    case .Debug;  print("D"); #falling;
            \\    case .Info;   print("I");
            \\    case .Warn;   print("W");
            \\    }
            \\    print("\n");
            \\}
            \\
            \\main :: () {
            \\    describe(.Trace);
            \\    describe(.Debug);
            \\    describe(.Info);
            \\    describe(.Warn);
            \\}
    );
    code_block(
        48,
        "text",
        #string
            \\TDI
            \\DI
            \\I
            \\W
    );
    paragraph(
        49,
        #string,oneline
            \\A falling arm still covers its own case for the exhaustiveness check.
            \\Three restrictions apply, each reported by its own message:
    );
    bullet(
        50,
        #string,oneline
            \\It must be the last statement of its arm: `error: '#falling' must be
            \\the last statement of a case`.
    );
    bullet(
        51,
        #string,oneline
            \\It needs a following `case` to fall into. On the last case, even when
            \\an `else` arm follows, it is `error: '#falling' on the last case has
            \\no body to fall into`, and on the `else` arm `error: '#falling' on an
            \\'else' arm has nothing to fall into`.
    );
    bullet(
        52,
        #string,oneline
            \\The arm it falls into must neither bind names nor carry a guard,
            \\because that arm's body would run without its captures, or without
            \\its guard having been checked: `error: '#falling' enters the next
            \\case's body without running its test, so it is not allowed in a
            \\switch whose cases can bind`, with a note that says which of the two
            \\applies. The arm that falls may bind names of its own.
    );
    subheading(53, "Switching without a subject");
    paragraph(
        54,
        #string,oneline
            \\`if #pattern == { ... }` has no subject. Each label is a `bool`
            \\condition, and the first one that is true selects its arm, which makes
            \\the form a flat replacement for a long `else if` chain. The compiler
            \\cannot prove that a list of conditions covers everything, so this form
            \\needs `else;` or `#partial`.
    );
    code_block(
        55,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    for n: 9..16 {
            \\        if #pattern == {
            \\        case n % 15 == 0;  print("fizzbuzz\n");
            \\        case n % 3 == 0;   print("fizz\n");
            \\        case n % 5 == 0;   print("buzz\n");
            \\        else;              print("{}\n", n);
            \\        }
            \\    }
            \\}
    );
    code_block(
        56,
        "text",
        #string
            \\fizz
            \\buzz
            \\11
            \\fizz
            \\13
            \\14
            \\fizzbuzz
    );
    paragraph(
        57,
        #string,oneline
            \\A label of this form may also be a group of pattern tests in braces,
            \\`case { P = a; Q = b; };`, which is true when every value matches its
            \\pattern (see `#pattern` Matching and Pattern Forms).
    );
    subheading(58, "Switch expressions");
    paragraph(
        59,
        #string,oneline
            \\`ifx subject == { ... }` is a switch that yields a value. Each arm is
            \\a list of statements whose last one is an expression, and that
            \\expression is the arm's value. The arms agree on a type as the arms of
            \\a conditional `ifx` do (see Statements and Conditional Expressions).
    );
    code_block(
        60,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Shape :: union { Circle: f64; Square: f64; Empty: void; }
            \\
            \\main :: () {
            \\    score := 85;
            \\    grade := ifx score == {
            \\    case 90..;      "A";
            \\    case 80..=89;   "B";
            \\    else;           "C";
            \\    };
            \\    s: Shape = .Square(3.0);
            \\    area := ifx s == {
            \\    case .Circle(r);  print("a circle\n"); 3.14159 * r * r;
            \\    case .Square(w);  print("a square\n"); w * w;
            \\    case .Empty;      0.0;
            \\    };
            \\    print("{} {}\n", grade, area);
            \\}
    );
    code_block(
        61,
        "text",
        #string
            \\a square
            \\B 9
    );
    paragraph(
        62,
        #string,oneline
            \\A switch expression must produce a value for every subject, so it
            \\cannot be `#partial`, and a gap is an error of its own. An arm that
            \\does not end in an expression is rejected too:
    );
    code_block(
        63,
        "text",
        #string
            \\// name := ifx c == { case .Red; "red"; case .Green; "green"; };
            \\error: cannot decide a value for this ifx
            \\note: missing case: Color.Blue
            \\note: cover every case, or add an 'else' arm
            \\// x := ifx n == { case 1; 1; else; y := 2; };
            \\error: an ifx arm must end in an expression
    );
}

render_section_48 :: () {
    paragraph(
        0,
        #string,oneline
            \\Glosso has two loops. `while` repeats its body as long as a condition
            \\holds, and `for` runs its body once for each element of a range, an
            \\array, a string or any other iterable value. Both take a block or a
            \\single statement as the body, and neither puts parentheses around its
            \\header. Written with `#inline` in front, either loop is unrolled: the
            \\compiler repeats the body while compiling instead of looping at run
            \\time. Branching and Looping introduces the loops by example, and
            \\Iteration: Cursors and `for_expansion` describes how a type of the
            \\program's own becomes something `for` can walk.
    );
    subheading(1, "`while`");
    paragraph(
        2,
        #string,oneline
            \\`while condition body` tests the condition before every pass,
            \\including the first. The condition follows the same rules as the one
            \\of `if`, so it may be any value with a truthiness rule (see `bool` and
            \\Conditions).
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    n := 3;
            \\    while n > 0 {
            \\        print("{} ", n);
            \\        n -= 1;
            \\    }
            \\    print("liftoff\n");
            \\    remaining := 2;
            \\    while remaining remaining -= 1;
            \\    print("remaining {}\n", remaining);
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\3 2 1 liftoff
            \\remaining 0
    );
    paragraph(
        5,
        #string,oneline
            \\`while #pattern P = value` repeats while the value matches the
            \\pattern, binding its captures afresh on each pass; `#pattern` Matching
            \\and Pattern Forms shows it walking a linked list. An endless loop is
            \\`while true`, left with `break` or `return`.
    );
    subheading(6, "`for`");
    paragraph(
        7,
        #string,oneline
            \\The header of a `for` names the value to walk and, optionally, the
            \\names through which the body reads each element:
    );
    code_block(
        8,
        "ebnf",
        #string
            \\for_statement = "for" [ "<" ] [ ":" expansion ]
            \\                [ [ "*" ] element [ "," index ] ":" ] iterable body ;
    );
    table_header(9, "Header   —   Effect");
    table_row(10, "`for xs`   |   The element is `it`, the step count `it_index`.");
    table_row(11, "`for x: xs`   |   Also names the element `x`.");
    table_row(12, "`for x, i: xs`   |   Also names the step count `i`.");
    table_row(13, "`for *p: xs`   |   Binds a pointer to each element instead of a copy.");
    table_row(14, "`for < x: xs`   |   Walks from the last element to the first.");
    table_row(
        15,
        "`for :name x: xs`   |   Walks with the expansion `name`; see Iteration: Cursors and `for_expansion`."
    );
    paragraph(
        16,
        #string,oneline
            \\The iterable may be a range, a fixed array, a view or a dynamic array
            \\(see Arrays, Views, Dynamic Arrays, and Slicing), a string, a `Simd`
            \\vector, or a matrix, which is walked row by row. A tuple is unrolled
            \\rather than looped over, as described below. Any other type becomes
            \\iterable through an instance (see Iteration: Cursors and
            \\`for_expansion`); without one the loop is `error: 'P' is not
            \\iterable; it needs an Iterable instance`.
    );
    code_block(
        17,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    for 0..3 print("it={} it_index={}\n", it, it_index);
            \\    names: [3]str = .["ada", "bob", "cy"];
            \\    for name, i: names print("{}: {}\n", i, name);
            \\    for n: 10..12 print("n={} it={} it_index={}\n", n, it, it_index);
            \\}
    );
    code_block(
        18,
        "text",
        #string
            \\it=0 it_index=0
            \\it=1 it_index=1
            \\it=2 it_index=2
            \\0: ada
            \\1: bob
            \\2: cy
            \\n=10 it=10 it_index=0
            \\n=11 it=11 it_index=1
    );
    paragraph(
        19,
        #string,oneline
            \\Naming the element does not hide `it`: both names are bound, and so
            \\are `it_index` and the index name. In a nested loop the inner loop's
            \\`it` hides the outer one, so name the outer loop's element when the
            \\inner body needs it. The loop variables live in a scope around the
            \\body and are gone after the loop (see Assignment, Blocks, and Name
            \\Lookup).
    );
    subheading(20, "The loop variables are copies");
    paragraph(
        21,
        #string,oneline
            \\Each pass binds fresh copies of the element and the step count, and
            \\assigning to them changes neither the container nor the walk. A
            \\range's bounds are read once, when the loop starts, and a loop over an
            \\array walks the elements that were there when it started:
    );
    code_block(
        22,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    xs: [3]s64 = .[1, 2, 3];
            \\    for v: xs v += 100;
            \\    print("array: {} {} {}\n", xs[0], xs[1], xs[2]);
            \\    print("range:");
            \\    for i: 0..5 {
            \\        print(" {}", i);
            \\        i += 2;
            \\    }
            \\    print("\nbounds:");
            \\    limit := 3;
            \\    for i: 0..limit {
            \\        print(" {}", i);
            \\        limit = 1;
            \\    }
            \\    print("\n");
            \\    d: [..]s64;
            \\    defer d.free();
            \\    d.push(5);
            \\    d.push(6);
            \\    for x: d {
            \\        if x == 5 d.push(7);
            \\        print("{} ", x);
            \\    }
            \\    print("count {}\n", d.count);
            \\}
    );
    code_block(
        23,
        "text",
        #string
            \\array: 1 2 3
            \\range: 0 1 2 3 4
            \\bounds: 0 1 2
            \\5 6 count 3
    );
    note(
        24,
        #string,oneline
            \\A loop over a view or a dynamic array reads the elements through the
            \\array's buffer. Growing the array in the body can move the buffer, and
            \\releasing it leaves the loop reading freed memory, so do not change
            \\the size of an array while a loop walks it.
    );
    subheading(25, "Strings");
    paragraph(
        26,
        #string,oneline
            \\A loop over a string yields Unicode scalar values as `rune`, decoding
            \\UTF-8 (or UTF-16 for the 16-bit string types), so a character that
            \\takes several bytes is one element. `it_index` counts characters, not
            \\bytes, while indexing a string with `s[i]` still reads one code unit.
            \\A malformed sequence yields U+FFFD.
    );
    code_block(
        27,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\main :: () {
            \\    text := "A가!";
            \\    print("{} bytes\n", text.count);
            \\    for r, i: text print("{}: {} {}\n", i, cast(u32) r, type_name(type_of(r)));
            \\}
    );
    code_block(
        28,
        "text",
        #string
            \\5 bytes
            \\0: 65 rune
            \\1: 44032 rune
            \\2: 33 rune
    );
    subheading(29, "Reverse: `for <`");
    paragraph(
        30,
        #string,oneline
            \\`for <` walks from the end: a range from its last value down to its
            \\first, an array from its last element, a string from its last
            \\character. `it_index` still counts the steps taken, 0, 1, 2, and is
            \\therefore not the element's position. A range with no end, such as
            \\`0..`, has no last value: `error: reverse for cannot use an
            \\open-ended RangeFrom`.
    );
    code_block(
        31,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    xs: [3]s64 = .[10, 20, 30];
            \\    for < x, i: xs print("step {}: {}\n", i, x);
            \\    print("down:");
            \\    for < n: 0..4 print(" {}", n);
            \\    print("\n");
            \\}
    );
    code_block(
        32,
        "text",
        #string
            \\step 0: 30
            \\step 1: 20
            \\step 2: 10
            \\down: 3 2 1 0
    );
    subheading(33, "Walking by pointer: `for *p`");
    paragraph(
        34,
        #string,oneline
            \\`for *p: xs` binds `p` to the address of each element, so the body can
            \\change the elements in place through `p.*`. Over a read-only view
            \\`[]const T` the pointer is `*const T`. `for *p, i: xs` names the step
            \\count as well, and `for < *p: xs` walks backwards.
    );
    code_block(
        35,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    xs: [4]s64 = .[10, 20, 30, 40];
            \\    for *p, i: xs p.* += i;
            \\    print("{} {} {} {}\n", xs[0], xs[1], xs[2], xs[3]);
            \\}
    );
    code_block(
        36,
        "text",
        #string
            \\10 21 32 43
    );
    paragraph(
        37,
        #string,oneline
            \\Only a container with storage has addresses to hand out. A range
            \\computes its values and a string's bytes are read-only, so both are
            \\rejected:
    );
    code_block(
        38,
        "text",
        #string
            \\// for *p: 0..3 { }
            \\error: 'for *x:' needs a container to point into; a range computes its elements
            \\// s := "abc";
            \\// for *c: s { }
            \\error: 'for *x:' needs a PointerIterable instance for str
            \\note: a string's code units are read-only - there is no 'IndexSet' instance for string - so there is nothing to write through the pointer
    );
    subheading(39, "`break` and `continue`");
    paragraph(
        40,
        #string,oneline
            \\`break` leaves the innermost loop, and `continue` ends the current
            \\pass and starts the next one, after testing the condition again in a
            \\`while`. Both apply to the innermost `while` or `for`, also when they
            \\are written inside a switch arm. A `defer` in the loop body runs at the
            \\end of every pass, including one ended by `continue` or `break` (see
            \\Deferred Statements).
    );
    code_block(
        41,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    for i: 0..4 {
            \\        defer print("end of pass {}\n", i);
            \\        if i == 1 continue;
            \\        if i == 3 break;
            \\        print("body {}\n", i);
            \\    }
            \\}
    );
    code_block(
        42,
        "text",
        #string
            \\body 0
            \\end of pass 0
            \\end of pass 1
            \\body 2
            \\end of pass 2
            \\end of pass 3
    );
    paragraph(
        43,
        #string,oneline
            \\Loops have no labels, and `break` and `continue` take no operand, so
            \\neither can leave an outer loop directly. Move the nested loops into a
            \\procedure and `return`, or jump to a label after the outer loop with
            \\`goto` (see Labels, `goto`, and Non-Local Transfers). Outside every
            \\loop, `break` is `error: break outside loop`. Both are also
            \\expressions of type `#Never`, so they can be an arm of an `ifx` (see
            \\Statements and Conditional Expressions).
    );
    subheading(44, "Unrolled loops: `#inline for`");
    paragraph(
        45,
        #string,oneline
            \\`#inline` in front of a `for` or a `while` repeats the body while the
            \\program is compiled: the compiler writes one copy of the body for each
            \\pass and checks each copy on its own. That makes two things possible
            \\that a run-time loop cannot do. The elements may have different types,
            \\as in a tuple, and the loop variable may be a compile-time constant
            \\that `#if` and `#insert` can use.
    );
    code_block(
        46,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    row :: .(7, "seven", 7.5);
            \\    #inline for row print("{}\n", it);
            \\    #inline for n: 0..4 {
            \\        #if n % 2 == 0 print("{} even\n", n);
            \\        else print("{} odd\n", n);
            \\    }
            \\    xs: [3]s64 = .[10, 20, 30];
            \\    total := 0;
            \\    #inline for x: xs total += x;
            \\    print("total {}\n", total);
            \\}
    );
    code_block(
        47,
        "text",
        #string
            \\7
            \\seven
            \\7.5
            \\0 even
            \\1 odd
            \\2 even
            \\3 odd
            \\total 60
    );
    paragraph(
        48,
        #string,oneline
            \\What `#inline for` does depends on what it walks:
    );
    table_header(49, "Iterable   —   `#inline for`");
    table_row(
        50,
        "A tuple   |   One copy per element; each copy sees its element's own type. A plain `for` over a tuple does the same."
    );
    table_row(
        51,
        "A fixed array `[N]T`   |   N copies; the element is an ordinary value, not a constant."
    );
    table_row(
        52,
        "A range with constant integer bounds   |   One copy per value; the loop variables are compile-time constants."
    );
    table_row(
        53,
        "A view or a dynamic array   |   `error: #inline for needs a compile-time iterable; a runtime-length array expansion cannot be unrolled`"
    );
    table_row(
        54,
        "A range stored in a variable, any other type   |   `error: #inline for expects a compile-time array`"
    );
    paragraph(
        55,
        #string,oneline
            \\Every copy is a block of its own. Locals declared in the body do not
            \\collide between copies, and a `defer` in the body runs at the end of
            \\its copy:
    );
    code_block(
        56,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    xs :: .[1, 2, 3];
            \\    #inline for xs {
            \\        doubled := it * 2;
            \\        defer print("leaving {}\n", it);
            \\        print("doubled {}\n", doubled);
            \\    }
            \\}
    );
    code_block(
        57,
        "text",
        #string
            \\doubled 2
            \\leaving 1
            \\doubled 4
            \\leaving 2
            \\doubled 6
            \\leaving 3
    );
    subheading(58, "Unrolling over a tuple");
    paragraph(
        59,
        #string,oneline
            \\A tuple's elements need not share a type, so there is no run-time loop
            \\over one; `for` over a tuple is always unrolled, with or without
            \\`#inline`. Each copy is checked against its own element's type, so
            \\`#if` on `type_of(it)` picks a different branch per element:
    );
    code_block(
        60,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\
            \\main :: () {
            \\    row :: .(cast(s64) 7, "seven", 7.5, true);
            \\    #inline for row {
            \\        #if type_of(it) == str print("a string: {}\n", it);
            \\        else print("{}: {}\n", type_name(type_of(it)), it);
            \\    }
            \\}
    );
    code_block(
        61,
        "text",
        #string
            \\s64: 7
            \\a string: seven
            \\f64: 7.5
            \\bool: true
    );
    paragraph(
        62,
        #string,oneline
            \\A tuple element has no address of its own, so `for *p` over a tuple
            \\is `error: 'for *x:' is not defined for a tuple`.
    );
    subheading(63, "Unrolling over a range: compile-time loop variables");
    paragraph(
        64,
        #string,oneline
            \\Over an integer range whose bounds are compile-time constants, each
            \\copy binds the element, `it` and `it_index` as constants. The body can
            \\then branch on them with `#if` or build code from them with `#insert`
            \\(see `#code`, `#insert`, and `#expand`):
    );
    code_block(
        65,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Format";
            \\
            \\main :: () {
            \\    #inline for n: 1..4 {
            \\        #insert tprint("square_{} :: {}; print(\"{{}}\\n\", square_{});", n, n * n, n);
            \\    }
            \\}
    );
    code_block(
        66,
        "text",
        #string
            \\1
            \\4
            \\9
    );
    paragraph(
        67,
        #string,oneline
            \\Since each copy is a block, `square_1` exists only inside its own
            \\copy. A declaration that has to outlive the loop is made with
            \\`#inline while`, below.
    );
    paragraph(
        68,
        #string,oneline
            \\The copies must be able to stand for the loop, so a range is compiled
            \\as an ordinary run-time loop when they cannot: when the body uses
            \\`break` or `continue`, assigns to or takes the address of a loop
            \\variable, or defines a label; when the bounds are not compile-time
            \\constants or call a function; when the bounds are not integers; or
            \\when unrolling would make more than 1024 copies, counting nested
            \\unrolled loops together. The loop then still runs correctly, but its
            \\variable is not a constant, and a use that needs one says why:
    );
    code_block(
        69,
        "text",
        #string
            \\// n := 3;
            \\// #inline for x: 0..n { #insert tprint("a_{} := 1;", x); }
            \\error: unbound 'x'
            \\note: this '#inline for' stays a run-time loop, whose loop variable is not a compile-time constant, because its bounds are not compile-time constants
    );
    subheading(70, "Unrolling over a fixed array");
    paragraph(
        71,
        #string,oneline
            \\Over a fixed array, the copies read the elements at run time, so the
            \\element is an ordinary value even when the array is a constant.
            \\Something that needs a compile-time value, such as `#if x == 4` or a
            \\type in an array of types passed to `size_of`, is `error: unknown
            \\const x`; `#inline while` over a constant index, below, is the way to
            \\do that. `#inline for *p: xs` binds the address of each element, so
            \\the copies can change the array.
    );
    paragraph(
        72,
        #string,oneline
            \\The copies of an array loop are not a loop, so `break` and `continue`
            \\in them are `error: break outside loop`. Under `#inline for <` the
            \\index of an array copy is the element's position, counting down,
            \\while over a range `it_index` counts the copies up from zero:
    );
    code_block(
        73,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    xs: [3]s64 = .[10, 20, 30];
            \\    #inline for < x, i: xs print("{} at {}\n", x, i);
            \\    #inline for < n: 0..3 print("n={} it_index={}\n", n, it_index);
            \\}
    );
    code_block(
        74,
        "text",
        #string
            \\30 at 2
            \\20 at 1
            \\10 at 0
            \\n=2 it_index=0
            \\n=1 it_index=1
            \\n=0 it_index=2
    );
    subheading(75, "`#inline while`");
    paragraph(
        76,
        #string,oneline
            \\`#inline while condition body` repeats the body as long as the
            \\condition, evaluated while compiling, is true. The condition usually
            \\reads a compile-time variable, declared with `::=` (see Constants,
            \\Variables, and Globals), that the body advances. Each pass is checked
            \\with the variable's value of that pass, so the variable can index a
            \\constant array or feed `#insert`:
    );
    code_block(
        77,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Meta";
            \\#import "Format";
            \\
            \\main :: () {
            \\    Ts :: .[s64, f64, bool];
            \\    i ::= 0;
            \\    #inline while i < Ts.count {
            \\        print("{} is {} bytes\n", type_name(Ts[i]), size_of(Ts[i]));
            \\        i += 1;
            \\    }
            \\    k ::= 0;
            \\    #inline while k < 3 {
            \\        #insert tprint("level_{} :: {};", k, k * 10);
            \\        k += 1;
            \\    }
            \\    print("{} {} {}\n", level_0, level_1, level_2);
            \\}
    );
    code_block(
        78,
        "text",
        #string
            \\s64 is 8 bytes
            \\f64 is 8 bytes
            \\bool is 1 bytes
            \\0 10 20
    );
    paragraph(
        79,
        #string,oneline
            \\Unlike `#inline for`, the passes of `#inline while` are not wrapped in
            \\blocks. Their statements are placed directly in the enclosing scope,
            \\which is why `level_0` to `level_2` are visible after the loop. When
            \\two passes declare the same local, the declaration of the last pass is
            \\the one visible afterwards.
    );
    paragraph(
        80,
        #string,oneline
            \\The condition must be computable while compiling, each pass must
            \\change something the condition reads, and the loop may make at most
            \\100000 passes:
    );
    code_block(
        81,
        "text",
        #string
            \\// i := 0; #inline while i < 3 { i += 1; }
            \\error: #inline while condition must be compile-time evaluable
            \\// i ::= 0; #inline while i < 3 { print("x\n"); }
            \\error: #inline while made no compile-time progress; update a compile-time variable used by the condition
    );
    subheading(82, "`#inline` in a case list");
    paragraph(
        83,
        #string,oneline
            \\`#inline` before any other statement is `error: #inline can only
            \\prefix while or for`. One more position accepts `#inline for`: the
            \\case list of a switch, where each copy contributes `case` arms that an
            \\`#insert` produces from `#code` values. Derive macros generate
            \\switches this way (see `#code`, `#insert`, and `#expand`, and
            \\`#derive`).
    );
}

render_section_49 :: () {
    paragraph(
        0,
        #string,oneline
            \\A label marks a position in a procedure, and `goto` continues
            \\execution there. This chapter covers labels and jumps within one
            \\procedure, labels as values, and the transfers of the `Jump` module
            \\that cross procedure boundaries: returning to a saved state,
            \\exceptions, coroutines, and entering another procedure at a label.
            \\No jump of either kind runs the deferred statements of the scopes it
            \\leaves.
    );
    subheading(1, "Labels and jumps within a procedure");
    paragraph(
        2,
        #string,oneline
            \\A label is written as a quote followed by a name, `'name`, and as a
            \\statement it ends with a semicolon: `'retry;`. `goto('retry)`
            \\continues execution at the label. `goto` is not a keyword but a
            \\procedure of the `Jump` module, so a program that jumps imports
            \\`Jump`; without it, the call is `error: unknown function goto`.
    );
    code_block(
        3,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\main :: () {
            \\    attempts := 0;
            \\'retry;
            \\    attempts += 1;
            \\    if attempts < 3 goto('retry);
            \\    goto('report);
            \\    print("skipped\n");
            \\'report;
            \\    print("{} attempts\n", attempts);
            \\}
    );
    code_block(
        4,
        "text",
        #string
            \\3 attempts
    );
    paragraph(
        5,
        #string,oneline
            \\Labels are usually written at the start of the line, outside the
            \\indentation, so that they stand out. A label belongs to the whole
            \\procedure rather than to the block it is written in: a `goto` may jump
            \\forwards or backwards, out of any number of blocks and loops, and to a
            \\label that appears later in the text. A procedure defines each label
            \\once, and a `goto` must name a label of its own procedure:
    );
    code_block(
        6,
        "text",
        #string
            \\// 'again; ... 'again;
            \\error: label 'again' is defined more than once in this function
            \\// goto('nowhere);
            \\error: no label 'nowhere' in this procedure (define it with `'nowhere:`)
    );
    paragraph(
        7,
        #string,oneline
            \\The suggestion in the second message shows the other spelling of a
            \\label statement, `'nowhere:`, which the parser accepts as well. The
            \\semicolon form is the usual one.
    );
    subheading(8, "Leaving nested loops");
    paragraph(
        9,
        #string,oneline
            \\`break` and `continue` take no label and act only on the innermost
            \\loop (see `while`, `for`, and Unrolled Loops). A jump to a label after
            \\the outer loop leaves both:
    );
    code_block(
        10,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\main :: () {
            \\    for i: 1..10 {
            \\        for j: 1..10 {
            \\            if i * j == 42 {
            \\                print("found {} * {}\n", i, j);
            \\                goto('done);
            \\            }
            \\        }
            \\    }
            \\    print("not found\n");
            \\'done;
            \\}
    );
    code_block(
        11,
        "text",
        #string
            \\found 6 * 7
    );
    note(
        12,
        #string,oneline
            \\`break 'outer;` is not a labelled break. It is a `break` followed by a
            \\label statement `'outer;`, and when the program also defines `'outer`
            \\elsewhere the result is the duplicate-label error above.
    );
    subheading(13, "What a jump skips");
    paragraph(
        14,
        #string,oneline
            \\A `goto` moves execution and does nothing else. Unlike `break`,
            \\`continue` and `return`, it does not run the `defer` statements of the
            \\blocks it leaves (Deferred Statements lists every exit). A jump over a
            \\declaration skips its initializer: the variable exists after the
            \\label, but it holds no meaningful value until it is assigned.
    );
    code_block(
        15,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\main :: () {
            \\    {
            \\        defer print("not printed\n");
            \\        goto('out);
            \\    }
            \\'out;
            \\    goto('assign);
            \\    y := 42;
            \\'assign;
            \\    y = 7;
            \\    print("y={}\n", y);
            \\}
    );
    code_block(
        16,
        "text",
        #string
            \\y=7
    );
    paragraph(
        17,
        #string,oneline
            \\A `goto` may also enter a block or a loop body from outside. The jump
            \\lands at the label, and the loop then continues normally, testing its
            \\condition at the end of the pass:
    );
    code_block(
        18,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\main :: () {
            \\    i := 0;
            \\    goto('inside);
            \\    while i < 3 {
            \\        print("top {}\n", i);
            \\'inside;
            \\        print("inside {}\n", i);
            \\        i += 1;
            \\    }
            \\}
    );
    code_block(
        19,
        "text",
        #string
            \\inside 0
            \\top 1
            \\inside 1
            \\top 2
            \\inside 2
    );
    paragraph(
        20,
        #string,oneline
            \\Jumps like these make a procedure hard to follow and are easy to get
            \\wrong; a loop, a switch or a helper procedure usually says the same
            \\thing more clearly. The common legitimate uses are leaving nested
            \\loops and jumping to shared failure handling at the end of a
            \\procedure.
    );
    subheading(21, "Labels as values");
    paragraph(
        22,
        #string,oneline
            \\A label used in an expression is a value of the built-in type
            \\`label`: a code address. It can be stored in a variable or a struct
            \\field, passed to a procedure and handed to `goto` later, which jumps
            \\to whatever address the value holds. `#undefined` is the empty label.
            \\The `Jump` module adds two methods: `is_valid()` is false for the
            \\empty label, and `is_local()` is true when the label belongs to the
            \\procedure that makes the call.
    );
    code_block(
        23,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\Handler :: struct { landing: label; name: str; }
            \\
            \\main :: () {
            \\    target := 'first;
            \\    target = 'second;
            \\    goto(target);
            \\'first;
            \\    print("first\n");
            \\'second;
            \\    print("second\n");
            \\    h := Handler.{ .landing = 'stop, .name = "stop" };
            \\    absent: label = #undefined;
            \\    print("{} {} {}\n", h.landing.is_valid(), h.landing.is_local(), absent.is_valid());
            \\    goto(h.landing);
            \\    print("skipped\n");
            \\'stop;
            \\    print("stopped\n");
            \\}
    );
    code_block(
        24,
        "text",
        #string
            \\second
            \\true true false
            \\stopped
    );
    paragraph(
        25,
        #string,oneline
            \\A jump through a stored label is not checked against the procedure's
            \\labels, so it can only be as correct as the value it uses. A label of
            \\another procedure is written `procedure,,'name`; jumping to it is a
            \\non-local transfer, described at the end of this chapter.
    );
    subheading(26, "Non-local transfers");
    paragraph(
        27,
        #string,oneline
            \\A `goto` to a label of the same procedure is a local jump. The `Jump`
            \\module goes further: it can record the state of a running procedure
            \\and return to it later from anywhere, including from the procedures it
            \\called. On that one ability it builds `save` and `longjmp`,
            \\exceptions, stackful coroutines and a small scheduler. These tools are
            \\for unusual control flow, such as leaving a deep recursion at once or
            \\writing a producer and a consumer as two coroutines that take turns.
            \\Ordinary errors are values, handled with results and `?` (see `Try`,
            \\`?`, `#try`, and `Termination`).
    );
    note(
        28,
        #string,oneline
            \\Nothing is unwound. A jump to a saved state does not run the `defer`
            \\statements of the procedures and blocks it abandons, so anything they
            \\would have released stays allocated. Release such resources before
            \\the jump, or keep them outside the code that can be left this way.
    );
    note(
        29,
        #string,oneline
            \\Saving and restoring a state is implemented for x86-64, with the
            \\System V and Windows calling conventions. On other processors a
            \\program that uses it fails to compile with `error: context_save is
            \\not yet supported for this target CPU`; guard such code with
            \\`#if OUT.cpu == Target_CPU.X86_64`. Jumps to labels that do not
            \\restore a saved state do not need this support.
    );
    subheading(30, "`save` and `longjmp`");
    paragraph(
        31,
        #string,oneline
            \\An `Execution_Context`, also named `Jump_Buffer`, holds a saved state.
            \\`buffer.save()` records the current state and returns 0.
            \\`buffer.longjmp(value)` later returns to that point: the `save` call
            \\returns a second time, this time with `value`. A `value` of 0 becomes
            \\1, so the two returns can always be told apart.
    );
    code_block(
        32,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\buffer: Jump_Buffer;
            \\
            \\search :: (depth: s32) {
            \\    if depth == 0 buffer.longjmp(42);
            \\    search(depth - 1);
            \\}
            \\
            \\main :: () {
            \\    code := buffer.save();
            \\    if code == 0 {
            \\        print("saved\n");
            \\        search(5);
            \\    }
            \\    print("back with {}\n", code);
            \\}
    );
    code_block(
        33,
        "text",
        #string
            \\saved
            \\back with 42
    );
    paragraph(
        34,
        #string,oneline
            \\The procedure that called `save` must still be running when `longjmp`
            \\is called. Returning to a state whose procedure has already returned
            \\is undefined behaviour.
    );
    subheading(35, "The forms of `goto`");
    paragraph(
        36,
        #string,oneline
            \\Every transfer in the module goes through one procedure, `goto`,
            \\whose optional parameters turn a jump into a change of state. It is a
            \\compiler intrinsic, declared as:
    );
    code_block(
        37,
        "glosso",
        #string
            \\goto :: (
            \\    target: label,
            \\    ctx: ?*Execution_Context = null,
            \\    value: any = false,
            \\    return_code: s32 = 1,
            \\) -> #Never #magic "jump_goto";
    );
    table_header(38, "Target   —   `ctx`   —   Effect");
    table_row(39, "a label   |   absent   |   Jump to the label in the current state.");
    table_row(
        40,
        "`#undefined`   |   given   |   Restore the saved state: its `save` returns again."
    );
    table_row(41, "a label   |   given   |   Restore the state, but continue at the label.");
    paragraph(
        42,
        #string,oneline
            \\When a state is restored, `value` is stored in the context's `inbox`
            \\field, and `return_code` becomes the result of the `save` that
            \\recorded it. `longjmp` is `goto(#undefined, .ctx = buffer,
            \\.return_code = value)`.
    );
    code_block(
        43,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\resume :: (saved: *Execution_Context) -> #Never {
            \\    goto(#undefined, .ctx = saved, .value = "carried", .return_code = 7);
            \\}
            \\
            \\main :: () {
            \\    saved: Execution_Context;
            \\    code := saved.save();
            \\    if code == 0 resume(&saved);
            \\    print("code={} inbox={}\n", code, saved.inbox);
            \\}
    );
    code_block(
        44,
        "text",
        #string
            \\code=7 inbox=carried
    );
    paragraph(
        45,
        #string,oneline
            \\`ctx.prepare(stack, local)` sets up a fresh state that runs on a stack
            \\the caller provides, entered with the third form. Coroutines are built
            \\on it; a program rarely calls it directly.
    );
    subheading(46, "Exceptions");
    paragraph(
        47,
        #string,oneline
            \\`try(target, body, handler)` runs `body`, and when a `throw` selects
            \\it, runs `handler` instead of the rest of `body`. It is a macro that
            \\takes the two blocks as `#code` values, and `target` is a `label`
            \\variable, initialized to `#undefined`, that receives the identity of
            \\this `try`. `throw(target, payload)` jumps to the `try` named by
            \\`target`, even past inner ones, and `catch()` in the handler returns
            \\the payload as an `any`.
    );
    code_block(
        48,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\divide :: (handler: label, a: s64, b: s64) -> s64 {
            \\    if b == 0 throw(handler, "division by zero");
            \\    return a / b;
            \\}
            \\
            \\main :: () {
            \\    outer: label = #undefined;
            \\    inner: label = #undefined;
            \\    try(outer, #code {
            \\        print("first result {}\n", divide(outer, 40, 5));
            \\        try(inner, #code {
            \\            print("before the failing call\n");
            \\            divide(outer, 10, 0);
            \\            print("not reached\n");
            \\        }, #code {
            \\            print("inner caught {}\n", catch());
            \\        });
            \\        print("not reached either\n");
            \\    }, #code {
            \\        print("outer caught {}\n", catch());
            \\    });
            \\    print("after the try\n");
            \\}
    );
    code_block(
        49,
        "text",
        #string
            \\first result 8
            \\before the failing call
            \\outer caught division by zero
            \\after the try
    );
    paragraph(
        50,
        #string,oneline
            \\The failing call names `outer`, so the inner handler is passed over.
            \\`throw_current(payload)` throws to the innermost `try` instead.
            \\`body.try_call(handler, data)`, a method of the function pointer type
            \\`Try_Body`, is the form for callbacks: it calls `body(data)` and, on a
            \\throw, `handler(data, payload)`. A throw that no `try` catches runs
            \\the handler installed with `set_unhandled_exception_handler`, if any,
            \\and then ends the process with status 1.
    );
    paragraph(
        51,
        #string,oneline
            \\The payload is an `any`, which points at the value it was made from.
            \\The procedure that threw is gone when the handler runs, so throw a
            \\value that outlives it: a string literal, a global, or storage owned
            \\by the code around the `try`.
    );
    subheading(52, "Coroutines");
    paragraph(
        53,
        #string,oneline
            \\A coroutine is a procedure that runs on a stack of its own and can
            \\stop in the middle and be continued later. Each `resume` runs it until
            \\it yields or returns; `co_yield(value)` stops it, hands `value` to the
            \\caller, and returns the value of the next `resume`.
    );
    table_header(54, "Call   —   Effect");
    table_row(
        55,
        "`Coroutine.coroutine_create(body, data)`   |   Makes a coroutine for `body :: (data: ?*void) -> any`; `null` when memory runs out."
    );
    table_row(
        56,
        "`co.resume(input)`   |   Runs until the next stop and returns a `Coroutine_Event`."
    );
    table_row(
        57,
        "`co_yield(value)`   |   Inside the coroutine: stops, and returns the next `input`."
    );
    table_row(
        58,
        "`co_return(value)`   |   Inside the coroutine: ends it, as `return value` from the body does."
    );
    table_row(59, "`co.destroy()`   |   Releases the stack and the coroutine.");
    code_block(
        60,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\counter :: (data: ?*void) -> any {
            \\    input := co_yield(10);
            \\    print("coroutine received {}\n", input);
            \\    input = co_yield(20);
            \\    print("coroutine received {}\n", input);
            \\    return 30;
            \\}
            \\
            \\report :: (event: Coroutine_Event) {
            \\    if event == {
            \\    case .Yielded(value);   print("yielded {}\n", value);
            \\    case .Awaiting;         print("awaiting\n");
            \\    case .Returned(value);  print("returned {}\n", value);
            \\    case .Failed(error);    print("failed {}\n", error);
            \\    }
            \\}
            \\
            \\main :: () {
            \\    #pattern .Some(co) := Coroutine.coroutine_create(counter) else {
            \\        print("out of memory\n");
            \\        return;
            \\    }
            \\    defer co.destroy();
            \\    report(co.resume());
            \\    report(co.resume(100));
            \\    report(co.resume(200));
            \\    print("done: {}\n", co.status == .Done);
            \\}
    );
    code_block(
        61,
        "text",
        #string
            \\yielded 10
            \\coroutine received 100
            \\yielded 20
            \\coroutine received 200
            \\returned 30
            \\done: true
    );
    paragraph(
        62,
        #string,oneline
            \\The `status` field moves through `Fresh`, `Running`, `Suspended`,
            \\`Waiting`, `Done` and `Failed`. A throw that escapes the body ends the
            \\coroutine with a `Failed` event carrying the payload. Resuming a
            \\coroutine that is running, done or failed is not an error value: it
            \\ends the process with status 1.
    );
    paragraph(
        63,
        #string,oneline
            \\`Awaitable` and `Scheduler` build cooperative scheduling on top. A
            \\coroutine created with `.scheduler = &scheduler` and enqueued with
            \\`scheduler_enqueue` is run by `scheduler.run()`. Inside it,
            \\`awaitable.co_await()` stops the coroutine in the `Waiting` state
            \\until another part of the program calls `awaitable.complete(result)`,
            \\which queues the waiting coroutines again; `co_await` then returns
            \\`result`.
    );
    subheading(64, "Entering another procedure at a label");
    paragraph(
        65,
        #string,oneline
            \\`procedure,,'name` is a `label` value for the label `'name` inside
            \\`procedure`. A jump to it enters the procedure in the middle, without
            \\a call: there are no arguments and no caller to return to, so the
            \\procedure must not return, and it is declared `#Never`.
            \\`long_goto(target, arguments...)` passes values along. When the
            \\target is in another procedure, it publishes the arguments, which the
            \\code at the label reads with `payload()` or the typed
            \\`payload_get(T, index)` and then releases with `clear_payload()`.
            \\When the target is local, it jumps without evaluating the arguments.
    );
    code_block(
        66,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\worker :: () -> #Never {
            \\'entry;
            \\    print("arrived with {} arguments\n", payload().count);
            \\    if #pattern {
            \\        .Some(n) = payload_get(s64, 0);
            \\        .Some(flag) = payload_get(bool, 1);
            \\    } {
            \\        print("n={} flag={}\n", n, flag);
            \\    }
            \\    clear_payload();
            \\    long_goto(main,,'back, "returning");
            \\}
            \\
            \\main :: () {
            \\    entry := worker,,'entry;
            \\    print("local: {} valid: {}\n", entry.is_local(), entry.is_valid());
            \\    value: s64 = 40;
            \\    long_goto(entry, value, true);
            \\'back;
            \\    if #pattern .Some(message) = payload_get(str, 0) print("back: {}\n", message);
            \\    clear_payload();
            \\    exit(0);
            \\}
    );
    code_block(
        67,
        "text",
        #string
            \\local: false valid: true
            \\arrived with 2 arguments
            \\n=40 flag=true
            \\back: returning
    );
    paragraph(
        68,
        #string,oneline
            \\`payload_get` returns `null` when the index is out of range or when
            \\the value there has another type. The published values point at the
            \\sender's storage, so read them promptly. `main` ends with `exit`
            \\because the jump back entered it at `'back`, outside the call that
            \\started it.
    );
}

render_section_50 :: () {
    paragraph(
        0,
        #string,oneline
            \\A pattern describes the shape of a value: a particular variant of a
            \\union, a range of integers, a struct whose fields have certain values,
            \\a slice of a certain length. Matching tests a value against a pattern
            \\and, when it matches, binds the names written in the pattern to the
            \\parts it found. Those names are the pattern's captures. Matching is
            \\how a program reads a tagged union's payload, unwraps an optional or a
            \\result, and takes structs and slices apart. Enums, Unions, and
            \\Matching introduces it by example.
    );
    paragraph(
        1,
        #string,oneline
            \\This chapter covers the forms that test a value against a pattern,
            \\the rules that every pattern position shares, and then every kind of
            \\pattern. The other places a pattern can appear are described
            \\elsewhere:
    );
    table_header(2, "Form   —   Meaning");
    table_row(
        3,
        "`if #pattern P = value body`   |   Runs the body, with the captures, when the value matches."
    );
    table_row(4, "`while #pattern P = value body`   |   Repeats while the value matches.");
    table_row(
        5,
        "`if #pattern { P = a; Q = b; } body`   |   Runs the body when every value matches its pattern."
    );
    table_row(6, "`ok := #pattern P = value;`   |   A `bool` that says whether the value matches.");
    table_row(7, "`if value == { case P; ... }`   |   A switch; see Switch Statements.");
    table_row(
        8,
        "`case P if condition;`   |   A guarded arm; see Coverage, Binding Forms, and Pattern Constants."
    );
    table_row(
        9,
        "`#pattern P := value else { ... }`   |   Binds the captures for the rest of the block; see Coverage, Binding Forms, and Pattern Constants."
    );
    table_row(
        10,
        "`#pattern P`   |   The pattern itself as a value; see Coverage, Binding Forms, and Pattern Constants."
    );
    subheading(11, "Testing a value: `if #pattern` and `while #pattern`");
    paragraph(
        12,
        #string,oneline
            \\`if #pattern P = value` runs its body when the value matches `P`, with
            \\the captures bound, and may have an `else`. `while #pattern P = value`
            \\evaluates the value again before each pass and repeats while it
            \\matches:
    );
    code_block(
        13,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Shape :: union { Circle: f64; Rect: f64; Empty: void; }
            \\Node :: struct { value: s64; next: ?*Node; }
            \\
            \\main :: () {
            \\    s: Shape = .Circle(2.0);
            \\    if #pattern .Circle(r) = s print("circle of radius {}\n", r);
            \\    if #pattern .Rect(w) = s {
            \\        print("rectangle {}\n", w);
            \\    } else {
            \\        print("not a rectangle\n");
            \\    }
            \\    c: Node = .{ .value = 3, .next = null };
            \\    b: Node = .{ .value = 2, .next = &c };
            \\    a: Node = .{ .value = 1, .next = &b };
            \\    cursor: ?*Node = &a;
            \\    while #pattern .Some(node) = cursor {
            \\        print("node {}\n", node.value);
            \\        cursor = node.next;
            \\    }
            \\}
    );
    code_block(
        14,
        "text",
        #string
            \\circle of radius 2
            \\not a rectangle
            \\node 1
            \\node 2
            \\node 3
    );
    paragraph(
        15,
        #string,oneline
            \\`.Circle(r)` matches a `Shape` whose active variant is `Circle` and
            \\binds its payload to `r`. `.Some(node)` matches an optional that holds
            \\a value, so the `while` stops at the first `null`.
    );
    subheading(16, "A test is a condition");
    paragraph(
        17,
        #string,oneline
            \\`#pattern P = value` is an expression of type `bool`. The value side
            \\is read at a precedence above `&&` and `||`, so in
            \\`#pattern .Rect(w) = s && w > 1.0` the test is `#pattern .Rect(w) = s`
            \\and `w > 1.0` is a second condition that already sees the capture.
            \\Several tests can be chained this way, each seeing the captures of the
            \\ones before it.
    );
    code_block(
        18,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Shape :: union { Circle: f64; Rect: f64; Empty: void; }
            \\
            \\main :: () {
            \\    s: Shape = .Rect(3.0);
            \\    if #pattern .Rect(w) = s && w > 1.0 print("wide rectangle {}\n", w);
            \\    if #pattern .Rect(w) = s && w > 100.0 print("huge\n"); else print("not huge\n");
            \\    o: ?Shape = .Some(s);
            \\    if #pattern .Some(inner) = o && #pattern .Rect(w) = inner
            \\        print("an optional rectangle {}\n", w);
            \\    is_rect := #pattern .Rect(_) = s;
            \\    print("is_rect = {}\n", is_rect);
            \\}
    );
    code_block(
        19,
        "text",
        #string
            \\wide rectangle 3
            \\not huge
            \\an optional rectangle 3
            \\is_rect = true
    );
    paragraph(
        20,
        #string,oneline
            \\A test can be neither an operand of `||` nor negated. Either way some
            \\path would reach code that names the captures without the match
            \\having bound them:
    );
    code_block(
        21,
        "text",
        #string
            \\// if #pattern .Some(v) = o || ready { }
            \\error: a '#pattern' test cannot be an operand of '||'
            \\note: only one side runs, so its captures would not exist on the other side's path
            \\note: chain the tests with '&&', or write one arm per alternative in a switch
            \\// if !(#pattern .Some(v) = o) { }
            \\error: a '#pattern' test cannot be negated
            \\note: its captures would have no scope to bind into - '!' inverts the value, not the branch they belong to
            \\note: to bind and leave on failure, write '#pattern P := subject else { ... };'
    );
    paragraph(
        22,
        #string,oneline
            \\The rule holds even for a pattern without captures. To act when a
            \\value does not match, use the `else` of the `if`, the bind-or-diverge
            \\form, or a switch arm. For one subject with several acceptable shapes,
            \\an or-pattern `P | Q` (below) does what `||` cannot.
    );
    subheading(23, "Where captures live");
    paragraph(
        24,
        #string,oneline
            \\A capture exists only in the code that runs because the match
            \\succeeded: the body of the `if` or `while`, the later operands of an
            \\`&&` chain, or the arm of a switch. It is not visible in the `else`
            \\and not after the statement; using it there is `error: unbound 'r'`.
            \\The exception is the bind-or-diverge form, whose captures stay for the
            \\rest of the block (see Coverage, Binding Forms, and Pattern
            \\Constants).
    );
    paragraph(
        25,
        #string,oneline
            \\The captures are bound only when the whole pattern matches. If a later
            \\part of the pattern fails, nothing is bound, and a variable of the
            \\same name outside the pattern keeps its value. Within one pattern, a
            \\later part may compare against an earlier capture with `==`:
    );
    code_block(
        26,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Pair :: struct { first: s64; second: s64; }
            \\
            \\main :: () {
            \\    d := 7;
            \\    p: Pair = .{ .first = 5, .second = 9 };
            \\    if #pattern Pair.{ .first = d, .second = 0 } = p {
            \\        print("matched, d = {}\n", d);
            \\    } else {
            \\        print("no match, d = {}\n", d);
            \\    }
            \\    q: Pair = .{ .first = 4, .second = 4 };
            \\    if #pattern Pair.{ .first = a, .second = == a } = q print("both are {}\n", a);
            \\}
    );
    code_block(
        27,
        "text",
        #string
            \\no match, d = 7
            \\both are 4
    );
    subheading(28, "Copies and pointer captures");
    paragraph(
        29,
        #string,oneline
            \\A capture is a copy of the matched part. Assigning to it changes the
            \\copy, not the value that was matched. A pointer capture, written
            \\`*name`, binds the address of the part instead, so the body can change
            \\the matched value in place:
    );
    code_block(
        30,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Shape :: union { Circle: f64; Rect: f64; Empty: void; }
            \\
            \\main :: () {
            \\    count: ?s64 = .Some(4);
            \\    if #pattern .Some(v) = count v += 1;
            \\    if #pattern .Some(v) = count print("still {}\n", v);
            \\    if #pattern .Some(*p) = count p.* += 10;
            \\    if #pattern .Some(v) = count print("now {}\n", v);
            \\    s: Shape = .Circle(1.5);
            \\    if #pattern .Circle(*r) = s r.* *= 2.0;
            \\    if #pattern .Circle(r) = s print("radius {}\n", r);
            \\}
    );
    code_block(
        31,
        "text",
        #string
            \\still 4
            \\now 14
            \\radius 3
    );
    subheading(32, "Several values at once");
    paragraph(
        33,
        #string,oneline
            \\`if #pattern { P = a; Q = b; }` matches several values, each against
            \\its own pattern, and succeeds only when all of them match. The
            \\captures of all the parts are visible together in the body, and a
            \\later part may refer to an earlier part's captures:
    );
    code_block(
        34,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Pair :: struct { first: s64; second: s64; }
            \\
            \\main :: () {
            \\    p: Pair = .{ .first = 4, .second = 9 };
            \\    q: Pair = .{ .first = 4, .second = 1 };
            \\    if #pattern {
            \\        Pair.{ .first = a, ... } = p;
            \\        Pair.{ .first = == a, .second = last } = q;
            \\    } {
            \\        print("both start at {}; q ends at {}\n", a, last);
            \\    }
            \\}
    );
    code_block(
        35,
        "text",
        #string
            \\both start at 4; q ends at 1
    );
    paragraph(
        36,
        #string,oneline
            \\The braces after `#pattern` hold the parts and the next braces are the
            \\body. The switch without a subject accepts such groups as labels:
            \\`if #pattern == { case { P = a; Q = b; }; ... }` (see Switch
            \\Statements).
    );
    subheading(37, "The tag is tested first");
    paragraph(
        38,
        #string,oneline
            \\A variant pattern tests the union's tag before it looks at the
            \\payload, and a slice pattern tests the length before it reads an
            \\element. A nested pattern therefore only ever sees the payload of the
            \\variant that is active. A union's storage read as another variant is
            \\not a value of that variant's type, and matching never forms one:
    );
    code_block(
        39,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Value :: union { Number: s64; Text: str; Nothing: void; }
            \\
            \\describe :: (v: Value) -> str {
            \\    if #pattern .Number(0..=9) = v  return "small number";
            \\    if #pattern .Number(_) = v      return "big number";
            \\    if #pattern .Text(t) = v        return t;
            \\    return "nothing";
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", describe(.Number(3)));
            \\    print("{}\n", describe(.Number(400)));
            \\    print("{}\n", describe(.Text("hello")));
            \\    print("{}\n", describe(.Nothing));
            \\}
    );
    code_block(
        40,
        "text",
        #string
            \\small number
            \\big number
            \\hello
            \\nothing
    );
    paragraph(
        41,
        #string,oneline
            \\For the same reason a tagged union's payload cannot be read as a
            \\field: `t.Code` is `error: tagged-union payload '.Code' may only be
            \\bound by a pattern match` (see Tagged and Untagged Unions).
    );
    subheading(42, "The pattern forms");
    paragraph(
        43,
        #string,oneline
            \\Every pattern position accepts the same patterns, and they nest: a
            \\variant's payload pattern may be a struct pattern whose field pattern
            \\is a range, and an or-pattern may join two of those.
    );
    table_header(44, "Pattern   —   Written   —   Matches");
    table_row(
        45,
        "Literal   |   `3`, `-1`, `2.5`, `\"hi\"`, `true`, `#char \"q\"`, `null`   |   A value equal to it."
    );
    table_row(
        46,
        "Constant   |   `LIMIT`, `== limit`, `== n * 2`   |   A value equal to the constant or expression."
    );
    table_row(47, "Capture   |   `name`   |   Anything; binds a copy.");
    table_row(48, "Pointer capture   |   `*name`   |   Anything; binds its address.");
    table_row(49, "Wildcard   |   `_`   |   Anything; binds nothing.");
    table_row(
        50,
        "Whole and parts   |   `name @ P`   |   What `P` matches; binds the whole value too."
    );
    table_row(51, "Enum member   |   `Color.Red`, `.Red`, `Red`   |   That member.");
    table_row(
        52,
        "Variant   |   `Shape.Empty`, `.Circle(r)`, `Circle(P)`   |   That variant, and its payload if `P` matches."
    );
    table_row(53, "Struct   |   `Pair.{ .first = P, ... }`, `.{ a, b }`   |   Every given field.");
    table_row(
        54,
        "Slice   |   `.[a, b]`, `.[head, ..., tail]`   |   An array of that length, or longer with `...`."
    );
    table_row(
        55,
        "Range   |   `0..=9`, `10..`, `..0`, `..`   |   An integer or enum member in the range."
    );
    table_row(56, "Or   |   `P | Q`   |   What either alternative matches.");
    table_row(57, "Splice   |   `#insert e`   |   The pattern `e` evaluates to.");
    subheading(58, "Literals and constants");
    paragraph(
        59,
        #string,oneline
            \\A literal matches a value equal to it. A pattern that contains an
            \\operator or a directive, such as `-1`, `#char "q"` or `LOW + 1`, is an
            \\ordinary expression, evaluated while compiling and compared with the
            \\value. `== expression` compares with any expression, which may read
            \\variables and the captures made earlier in the same pattern.
    );
    code_block(
        60,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\LIMIT :: 255;
            \\
            \\main :: () {
            \\    n := 3; f := 2.5; s := "hi"; c := #char "q"; m := -1;
            \\    if #pattern 3 = n          print("integer\n");
            \\    if #pattern 2.5 = f        print("float\n");
            \\    if #pattern "hi" = s       print("string\n");
            \\    if #pattern #char "q" = c  print("character\n");
            \\    if #pattern -1 = m         print("negative\n");
            \\    if #pattern LIMIT - 252 = n print("constant expression\n");
            \\    limit := 3;
            \\    if #pattern == limit = n   print("equal to a variable\n");
            \\    b := 255;
            \\    if #pattern LIMIT = b      print("named constant\n");
            \\}
    );
    code_block(
        61,
        "text",
        #string
            \\integer
            \\float
            \\string
            \\character
            \\negative
            \\constant expression
            \\equal to a variable
            \\named constant
    );
    paragraph(
        62,
        #string,oneline
            \\A literal must have the subject's type and fit it: `#pattern "a" = n`
            \\with `n: s64` is `error: got str, expected s64`, and `300` against a
            \\`u8` is `error: 300 does not fit u8, whose range is 0..=255`.
    );
    subheading(63, "Captures and the wildcard");
    paragraph(
        64,
        #string,oneline
            \\A bare name is a capture: it matches anything and binds a copy of it.
            \\The exceptions are names that already mean a value of the subject's
            \\type: a member of the subject's enum, a variant of its union, or a
            \\compile-time constant. Those are compared, which is why `LIMIT` above
            \\is a test.
    );
    note(
        65,
        #string,oneline
            \\A variable is not a constant, so its name in a pattern makes a new
            \\capture that matches everything and hides the variable. With
            \\`limit := 3;`, `case limit;` always matches. Compare with
            \\`case == limit;`.
    );
    paragraph(
        66,
        #string,oneline
            \\`_` matches anything and binds nothing; it marks a part that must be
            \\there but is not used. `*name` matches anything and binds a pointer to
            \\the matched part, as shown above; it works in variant payloads and
            \\struct fields, but not inside a slice pattern. `name @ P` matches what
            \\`P` matches and also binds the whole value as `name`. A capture may
            \\appear only once in a pattern:
    );
    code_block(
        67,
        "text",
        #string
            \\// if #pattern Pair.{ .first = a, .second = a } = p { }
            \\error: pattern capture 'a' is bound more than once
            \\note: to require the two values to be equal, bind one and write '== a' at the other
    );
    subheading(68, "Enum members and variants");
    paragraph(
        69,
        #string,oneline
            \\An enum member or a union variant may be written with its type
            \\(`Token.Name`), with a leading dot (`.Name`) or bare (`Name`).
            \\Parentheses after a variant hold the pattern for its payload, which is
            \\often a capture. A variant without parentheses tests the tag and
            \\ignores the payload. A `void` payload can still be captured; the
            \\capture holds the empty tuple `.()`.
    );
    paragraph(
        70,
        #string,oneline
            \\An optional `?T` is matched with `.Some(P)` and `null`, and a result
            \\`E!T` with `.Ok(P)` and `.Err(P)`. They nest like any other variant:
            \\`.Ok(.Some(q))` matches a successful result that holds a present
            \\value.
    );
    code_block(
        71,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Token :: union { Number: f64; Name: str; Eof: void; }
            \\Color :: enum { Red; Green; Blue; }
            \\Fault :: enum { Bad; }
            \\
            \\lookup :: (hit: bool) -> Fault!?s64 {
            \\    if hit return .Ok(.Some(7));
            \\    return .Ok(null);
            \\}
            \\
            \\main :: () {
            \\    t: Token = .Name("total");
            \\    if #pattern Token.Name(text) = t  print("qualified: {}\n", text);
            \\    if #pattern .Name(text) = t       print("leading dot: {}\n", text);
            \\    if #pattern .Name = t             print("tag only\n");
            \\    e: Token = .Eof;
            \\    if #pattern .Eof(nothing) = e     print("void payload: {}\n", nothing == .());
            \\    c := Color.Green;
            \\    if #pattern .Blue = c print("blue\n"); else print("not blue\n");
            \\    if #pattern .Ok(.Some(q)) = lookup(true) print("found {}\n", q);
            \\    if #pattern .Ok(null) = lookup(false)    print("found nothing\n");
            \\}
    );
    code_block(
        72,
        "text",
        #string
            \\qualified: total
            \\leading dot: total
            \\tag only
            \\void payload: true
            \\not blue
            \\found 7
            \\found nothing
    );
    paragraph(
        73,
        #string,oneline
            \\The empty optional is spelled `null` in a pattern too; `case .None;`
            \\is rejected with an error that says to use `null`.
    );
    subheading(74, "Struct patterns");
    paragraph(
        75,
        #string,oneline
            \\A struct pattern uses the punctuation of a struct literal:
            \\`Pair.{ ... }` names the type and `.{ ... }` takes it from the
            \\subject. Fields are given by name (`.first = P`), by name alone
            \\(`.second`, which captures the field under its own name), or by
            \\position in declaration order. A field that is not mentioned matches
            \\anything, and `...` at the end says so explicitly. Positional fields
            \\may stop before the last field.
    );
    code_block(
        76,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Pair :: struct { first: s64; second: s64; }
            \\
            \\main :: () {
            \\    p: Pair = .{ .first = 4, .second = 9 };
            \\    if #pattern Pair.{ .first = a, .second = b } = p  print("named {} {}\n", a, b);
            \\    if #pattern Pair.{ .second, ... } = p             print("shorthand {}\n", second);
            \\    if #pattern .{ x, y } = p                         print("positional {} {}\n", x, y);
            \\    if #pattern .{ 4 } = p                            print("first field is 4\n");
            \\    if #pattern whole @ .{ .first = 0..=9, ... } = p  print("whole {} {}\n", whole.first, whole.second);
            \\}
    );
    code_block(
        77,
        "text",
        #string
            \\named 4 9
            \\shorthand 9
            \\positional 4 9
            \\first field is 4
            \\whole 4 9
    );
    paragraph(
        78,
        #string,oneline
            \\The fields are checked against the struct: `error: no field 'third'
            \\in pattern for Pair`, `error: field 'first' is matched more than once
            \\in struct pattern for Pair`, and `error: positional field after named
            \\field in struct pattern for Pair`. A struct pattern against a value
            \\that is not a struct is `error: struct pattern needs a struct value,
            \\got s64`.
    );
    subheading(79, "Slice patterns");
    paragraph(
        80,
        #string,oneline
            \\A slice pattern `.[ ... ]` matches a fixed array, a view or a dynamic
            \\array. Without `...` it requires exactly as many elements as it lists.
            \\With `...` it requires at least the listed ones and skips any number
            \\in between, so `.[head, ..., tail]` matches every array of two or more
            \\elements. `...` may appear once, since two gaps would leave the
            \\elements between them at no fixed position.
    );
    code_block(
        81,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\describe :: (xs: []const s64) {
            \\    if xs == {
            \\    case .[];                print("empty\n");
            \\    case .[only];            print("one: {}\n", only);
            \\    case .[0, ...];          print("starts with zero\n");
            \\    case .[head, ..., tail]; print("{} .. {}\n", head, tail);
            \\    }
            \\}
            \\
            \\main :: () {
            \\    a: [4]s64 = .[10, 20, 30, 40];
            \\    b: [3]s64 = .[0, 1, 2];
            \\    describe(a[..]);
            \\    describe(b[..]);
            \\    describe(a[1..2]);
            \\    describe(a[0..0]);
            \\}
    );
    code_block(
        82,
        "text",
        #string
            \\10 .. 40
            \\starts with zero
            \\one: 20
            \\empty
    );
    paragraph(
        83,
        #string,oneline
            \\A `str` is not an array for this purpose: `error: slice pattern needs
            \\an array or slice value, got str`. A second `...` is `error: a slice
            \\pattern may use '...' at most once`, and `name @ ...` is rejected
            \\because `...` is a marker, not a pattern that could be bound.
    );
    subheading(84, "Ranges");
    paragraph(
        85,
        #string,oneline
            \\Each of the range forms (see Arrays, Views, Dynamic Arrays, and
            \\Slicing) is a pattern that matches the integers it contains. A form
            \\without a start begins at the smallest value of the subject's type, a
            \\form without an end runs to its largest value, and `..` matches
            \\everything.
    );
    code_block(
        86,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\report :: (n: s64) {
            \\    print("{}:", n);
            \\    if #pattern 0..3 = n   print(" 0..3");
            \\    if #pattern 0..=3 = n  print(" 0..=3");
            \\    if #pattern 5.. = n    print(" 5..");
            \\    if #pattern ..3 = n    print(" ..3");
            \\    if #pattern .. = n     print(" ..");
            \\    print("\n");
            \\}
            \\
            \\main :: () {
            \\    report(-1);
            \\    report(3);
            \\    report(7);
            \\}
    );
    code_block(
        87,
        "text",
        #string
            \\-1: ..3 ..
            \\3: 0..=3 ..
            \\7: 5.. ..
    );
    paragraph(
        88,
        #string,oneline
            \\The subject must be an integer or an enum, whose members are ranged by
            \\their values: `.Red..=.Blue`. `#char` literals are `u8`, so
            \\`#char "a" ..= #char "z"` matches lower-case ASCII bytes. A `rune`, a
            \\float or a string cannot be matched against a range. The bounds are
            \\expressions that must be integer constants: a bound that is a
            \\variable is `error: a range bound must be known at compile time:
            \\unknown const hi`, and `0.0..=1.0` is `error: a range bound must be an
            \\integer`.
    );
    subheading(89, "Or-patterns");
    paragraph(
        90,
        #string,oneline
            \\`P | Q` matches when either alternative matches; `case P, Q;` in a
            \\switch is the same thing. The alternatives may contain captures if
            \\every alternative binds the same names at the same types, so that the
            \\body can use them whichever alternative matched:
    );
    code_block(
        91,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Shape :: union { Circle: f64; Square: f64; Empty: void; }
            \\
            \\size :: (s: Shape) -> f64 {
            \\    if #pattern .Circle(r) | .Square(r) = s return r;
            \\    return 0.0;
            \\}
            \\
            \\main :: () {
            \\    print("{} {} {}\n", size(.Circle(2.0)), size(.Square(0.5)), size(.Empty));
            \\    n := 25;
            \\    if #pattern 0..=9 | 20..=29 = n print("in one of the ranges\n");
            \\}
    );
    code_block(
        92,
        "text",
        #string
            \\2 0.5 0
            \\in one of the ranges
    );
    paragraph(
        93,
        #string,oneline
            \\Each way the alternatives can disagree has its own message:
    );
    code_block(
        94,
        "text",
        #string
            \\// Shape :: union { Circle: f64; Square: f64; Count: s64; }
            \\// #pattern .Circle(r) | .Square(q) = s
            \\error: or-pattern alternative binds 'q', which the other alternatives do not
            \\// #pattern .Circle(r) | .Count(r) = s
            \\error: or-pattern binds 'r' as s64 here but as f64 in another alternative
            \\// #pattern .Circle(r) | .Square = s
            \\error: or-pattern alternative does not bind 'r', which another alternative does
    );
    subheading(95, "Splices");
    paragraph(
        96,
        #string,oneline
            \\`#insert e` in a pattern position evaluates `e` while compiling and
            \\uses the pattern it yields. `e` may be a pattern value made with
            \\`#pattern P`, or a value whose type knows how to describe itself as a
            \\pattern. Both are described under pattern constants in Coverage,
            \\Binding Forms, and Pattern Constants.
    );
}

render_section_51 :: () {
    paragraph(
        0,
        #string,oneline
            \\This chapter completes the description of patterns. It covers the
            \\coverage analysis that every switch goes through, which proves that
            \\each value has an arm and finds arms that can never run; guards; the
            \\bind-or-diverge form `#pattern P := value else { ... }`, whose
            \\captures stay for the rest of the block; and patterns as compile-time
            \\values, which can be named, passed to procedures and built by them.
            \\Switch Statements describes the switch itself, and `#pattern`
            \\Matching and Pattern Forms the patterns.
    );
    subheading(1, "Coverage");
    paragraph(
        2,
        #string,oneline
            \\A switch must handle every value of its subject. The compiler checks
            \\this from the patterns themselves, so a switch that names every
            \\variant needs no `else`, and a switch that misses one is an error that
            \\names what is missing. The analysis splits the subject's values into
            \\cases it can list and checks that the arms, taken together, match all
            \\of them. A capture, `_` and `else;` cover everything that remains.
    );
    table_header(3, "Subject   —   Covered by");
    table_row(
        4,
        "Tagged union   |   Every variant, each with a payload pattern that covers the payload."
    );
    table_row(5, "Enum   |   Every member, listed or in ranges such as `.Red..=.Green`.");
    table_row(6, "`bool`   |   `true` and `false`.");
    table_row(
        7,
        "Integer   |   Literals, constants and ranges that together contain every value of the type."
    );
    table_row(
        8,
        "Struct   |   Field patterns whose combinations cover every combination of field values."
    );
    table_row(
        9,
        "Array, view   |   Slice patterns that cover every length, such as `.[]`, `.[a]` and `.[a, b, ...]`."
    );
    table_row(10, "`?T`, `E!T`   |   `.Some(_)` and `null`; `.Ok(_)` and `.Err(_)`.");
    table_row(11, "Float, `str`, pointer   |   Only a capture, `_` or `else;`.");
    paragraph(
        12,
        #string,oneline
            \\The last row matters most in practice. A float or string literal
            \\matches at run time but cannot cover anything, because no list of
            \\literals exhausts all floats or all strings.
    );
    subheading(13, "Reading the missing-case report");
    paragraph(
        14,
        #string,oneline
            \\The error is reported at the `if` of the switch and lists the values
            \\that no arm matches, written as patterns. `_` in a missing case stands
            \\for any value. At most six are listed, and the rest are counted.
    );
    code_block(
        15,
        "text",
        #string
            \\// Shape :: union { Circle: f64; Rect: f64; Empty: void; }
            \\// if s == { case .Circle(1.0); case .Rect(w); case .Empty; }
            \\error: non-exhaustive switch
            \\note: missing case: Shape.Circle(_)
            \\note: cover them, or add 'else' or '#partial'
            \\
            \\// n: u8; if n == { case 0..=9; case 100..; }
            \\error: non-exhaustive switch
            \\note: missing case: 10..=99
            \\note: cover them, or add 'else' or '#partial'
            \\
            \\// Pair :: struct { first: bool; second: bool; }
            \\// if p == { case .{ false, false }; case .{ true, true }; }
            \\error: non-exhaustive switch
            \\note: missing case: Pair.{ .first = false, .second = true }
            \\note: missing case: Pair.{ .first = true, .second = false }
            \\note: cover them, or add 'else' or '#partial'
            \\
            \\// Big :: enum { A; B; C; D; E; F; G; H; I; J; }
            \\// if v == { case .A; }
            \\error: non-exhaustive switch
            \\note: missing case: Big.B
            \\note: missing case: Big.C
            \\note: missing case: Big.D
            \\note: missing case: Big.E
            \\note: missing case: Big.F
            \\note: missing case: Big.G
            \\note: ...and 3 more
            \\note: cover them, or add 'else' or '#partial'
    );
    paragraph(
        16,
        #string,oneline
            \\The first report shows that `Circle(1.0)` does not cover `Circle`: one
            \\float does not cover all floats. An integer subject is reported as
            \\intervals rather than values, limited to the subject's type, and a
            \\`str` or float subject as `_`. A switch expression reports the same
            \\missing cases under `error: cannot decide a value for this ifx`. The
            \\empty optional appears in a missing case as `(?s64).None`, although a
            \\pattern writes it `null`.
    );
    paragraph(
        17,
        #string,oneline
            \\There are three ways out: add arms for the missing cases, add an
            \\`else;` arm, or mark the statement `if #partial` so that unmatched
            \\values skip the switch (see Switch Statements). An `else;` arm also
            \\handles enum values that name no member.
    );
    subheading(18, "Guards");
    paragraph(
        19,
        #string,oneline
            \\A case may carry a guard: `case P if condition;`. The arm is taken
            \\when the pattern matches and then the condition, which sees the
            \\pattern's captures, is true. When the guard is false, matching
            \\continues with the next case, which a plain `if` inside the arm's body
            \\cannot do, because by then the case has been chosen. The guard must be
            \\a `bool` (`error: case guard must be bool, got f64`). It may use `&&`,
            \\and it may contain `#pattern` tests whose captures join the arm.
    );
    code_block(
        20,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Shape :: union { Circle: f64; Rect: f64; Empty: void; }
            \\Size :: union { Small: void; Big: f64; }
            \\
            \\classify :: (r: f64) -> Size {
            \\    if r > 10.0 return .Big(r * 2.0);
            \\    return .Small;
            \\}
            \\
            \\describe :: (s: Shape) -> str {
            \\    if s == {
            \\    case .Circle(r) if r > 100.0;
            \\        return "huge circle";
            \\    case .Circle(r) if #pattern .Big(scale) = classify(r) && scale < 150.0;
            \\        return "big circle";
            \\    case .Circle(r);
            \\        return "circle";
            \\    case .Rect(w) if w > 0.0;
            \\        return "rectangle";
            \\    case .Rect(w);
            \\        return "flat rectangle";
            \\    case .Empty;
            \\        return "empty";
            \\    }
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", describe(.Circle(500.0)));
            \\    print("{}\n", describe(.Circle(50.0)));
            \\    print("{}\n", describe(.Circle(1.0)));
            \\    print("{}\n", describe(.Rect(0.0)));
            \\}
    );
    code_block(
        21,
        "text",
        #string
            \\huge circle
            \\big circle
            \\circle
            \\flat rectangle
    );
    paragraph(
        22,
        #string,oneline
            \\A guarded arm covers nothing, because its guard may be false at run
            \\time. Each variant above is also handled by an unguarded arm; without
            \\`case .Circle(r);` the switch would be incomplete:
    );
    code_block(
        23,
        "text",
        #string
            \\// if s == { case .Circle(r) if r > 1.0; case .Rect(w); case .Empty; }
            \\error: non-exhaustive switch
            \\note: missing case: Shape.Circle(_)
            \\note: cover them, or add 'else' or '#partial'
    );
    paragraph(
        24,
        #string,oneline
            \\A `#falling` arm is different. It does not decline its match; it only
            \\adds the next arm's body to its own, so it covers its case like any
            \\other arm.
    );
    subheading(25, "Unreachable arms");
    paragraph(
        26,
        #string,oneline
            \\An arm whose patterns are all covered by the arms before it can never
            \\run. The compiler reports it as a warning and still compiles the
            \\program:
    );
    code_block(
        27,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    n: u8 = 55;
            \\    if n == {
            \\    case 0..=99;   print("low\n");
            \\    case 50..=60;  print("never chosen\n");
            \\    else;          print("high\n");
            \\    }
            \\}
    );
    code_block(
        28,
        "text",
        #string
            \\$ glosso --run bands.glo 2>&1 | grep -v '^glosso:'
            \\warning: unreachable pattern - already covered by an earlier case
            \\  --> bands.glo:7:10
            \\  |
            \\7 |     case 50..=60;  print("never chosen\n");
            \\  |          ^^
            \\low
    );
    paragraph(
        29,
        #string,oneline
            \\The warning goes to standard error with the compiler's other
            \\diagnostics, and `low` is the program's output. Common causes are a
            \\range that overlaps an earlier one, a capture or `_` placed before
            \\more specific arms, and a constant that is accidentally a capture
            \\(`case limit;` with a variable `limit`, see `#pattern` Matching and
            \\Pattern Forms). A guarded arm never makes a later arm unreachable,
            \\since it may decline.
    );
    paragraph(
        30,
        #string,oneline
            \\An `else;` arm after arms that already cover everything is not
            \\reported. For an enum subject, `else;` is also the way to handle a
            \\value that names no member, so prefer it to a final `case _;`, which
            \\the analysis reports as unreachable once every member has an arm.
    );
    subheading(31, "The binding form: `#pattern P := value else`");
    paragraph(
        32,
        #string,oneline
            \\`#pattern P := value else { ... }` matches the value against the
            \\pattern. When it matches, the captures are bound in the enclosing
            \\block, from this statement to the end of the block. When it does not
            \\match, the `else` block runs, and that block must leave: it ends in
            \\`return`, `break`, `continue` or another jump.
    );
    code_block(
        33,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Config :: struct { name: str; port: s64; }
            \\
            \\lookup :: (found: bool) -> ?Config {
            \\    if found return .Some(.{ .name = "svc", .port = 8080 });
            \\    return null;
            \\}
            \\
            \\serve :: (found: bool) -> s64 {
            \\    #pattern .Some(config) := lookup(found) else {
            \\        print("no configuration\n");
            \\        return -1;
            \\    }
            \\    print("serving {} on {}\n", config.name, config.port);
            \\    return config.port;
            \\}
            \\
            \\main :: () {
            \\    print("{}\n", serve(true));
            \\    print("{}\n", serve(false));
            \\}
    );
    code_block(
        34,
        "text",
        #string
            \\serving svc on 8080
            \\8080
            \\no configuration
            \\-1
    );
    paragraph(
        35,
        #string,oneline
            \\The test form `if #pattern .Some(config) = lookup(found) { ... }`
            \\would put everything that uses `config` one block deeper, and each
            \\further value to unwrap would add another level. The bind form states
            \\the failure case once, up front, and the rest of the procedure
            \\continues at the same depth with the captures as ordinary locals.
    );
    paragraph(
        36,
        #string,oneline
            \\In a loop the `else` block may `continue`, which skips the elements
            \\that do not match:
    );
    code_block(
        37,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\main :: () {
            \\    values: [4]?s64 = .[.Some(1), null, .Some(3), null];
            \\    total := 0;
            \\    for values {
            \\        #pattern .Some(n) := it else { continue; }
            \\        total += n;
            \\    }
            \\    print("total = {}\n", total);
            \\}
    );
    code_block(
        38,
        "text",
        #string
            \\total = 4
    );
    subheading(39, "The `else` block must leave");
    paragraph(
        40,
        #string,oneline
            \\The captures can be bound in the enclosing block only because no path
            \\reaches the code after the statement without a match. The compiler
            \\therefore requires that the end of the `else` block cannot be reached:
    );
    code_block(
        41,
        "text",
        #string
            \\// #pattern .Some(v) := o else { print("missing\n"); }
            \\error: the 'else' of a '#pattern ... :=' binding must not return normally
            \\note: it has to be #Never - end it with 'return', 'break', 'continue', or a call to a #Never function
    );
    paragraph(
        42,
        #string,oneline
            \\Besides `return`, `break` and `continue`, a block leaves when it ends
            \\with a call to a procedure whose return type is `#Never`, such as
            \\`exit` or `goto`; with an `if` and `else` that both leave; with a
            \\switch whose arms all leave; or with a loop that never ends, such as
            \\`while true { }`.
    );
    code_block(
        43,
        "glosso",
        #string
            \\#import "Io";
            \\#import "Jump";
            \\
            \\fail :: (message: str) -> #Never {
            \\    print("fatal: {}\n", message);
            \\    exit(2);
            \\}
            \\
            \\by_branches :: (o: ?s64, strict: bool) -> s64 {
            \\    #pattern .Some(v) := o else { if strict return -1; else return -2; }
            \\    return v;
            \\}
            \\
            \\by_switch :: (o: ?s64, mode: s64) -> s64 {
            \\    #pattern .Some(v) := o else {
            \\        if mode == { case 0; return -3; else; return -4; }
            \\    }
            \\    return v;
            \\}
            \\
            \\by_goto :: (o: ?s64) -> s64 {
            \\    #pattern .Some(v) := o else { goto('missing); }
            \\    return v;
            \\'missing;
            \\    return -9;
            \\}
            \\
            \\main :: () {
            \\    print("{} {} {} {}\n", by_branches(null, true), by_branches(null, false),
            \\        by_switch(null, 0), by_goto(null));
            \\    port: ?s64 = .Some(80);
            \\    #pattern .Some(p) := port else { fail("no port"); }
            \\    print("port {}\n", p);
            \\    port = null;
            \\    #pattern .Some(q) := port else { fail("no port"); }
            \\    print("unreachable {}\n", q);
            \\}
    );
    code_block(
        44,
        "text",
        #string
            \\-1 -2 -3 -9
            \\port 80
            \\fatal: no port
    );
    paragraph(
        45,
        #string,oneline
            \\The program ends with status 2 from `fail`. The `else` block runs
            \\without the captures, since nothing matched; naming one there is
            \\`error: unbound 'v'`.
    );
    subheading(46, "Writing the binding form");
    paragraph(
        47,
        #string,oneline
            \\The `else` and its braces are required. Without them the statement
            \\does not parse: `#pattern .Some(v) := o;` is `error: unexpected token
            \\';'`, and `else return;` is `error: unexpected token 'return'`. A
            \\semicolon after the closing brace is allowed but not needed.
    );
    paragraph(
        48,
        #string,oneline
            \\Any pattern may be used, and the value may be any expression. Struct
            \\and slice patterns bind several names at once:
    );
    code_block(
        49,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Pair :: struct { first: s64; second: s64; }
            \\
            \\first_if_digit :: (p: Pair) -> s64 {
            \\    #pattern Pair.{ .first = a, .second = 0..=9 } := p else { return -1; }
            \\    return a;
            \\}
            \\
            \\head_of :: (xs: []const s64) -> s64 {
            \\    #pattern .[head, ...] := xs else { return -1; }
            \\    return head;
            \\}
            \\
            \\main :: () {
            \\    print("{} {}\n", first_if_digit(.{ 4, 5 }), first_if_digit(.{ 4, 50 }));
            \\    a: [2]s64 = .[7, 8];
            \\    print("{} {}\n", head_of(a[..]), head_of(a[0..0]));
            \\}
    );
    code_block(
        50,
        "text",
        #string
            \\4 -1
            \\7 -1
    );
    paragraph(
        51,
        #string,oneline
            \\With a result, `#pattern .Ok(value) := parse(text) else { ... }`
            \\handles the error where it happens instead of passing it on; the `?`
            \\operator, which passes it on, is described in `Try`, `?`, `#try`, and
            \\`Termination`.
    );
    note(
        52,
        #string,oneline
            \\The compiler does not report a capture that reuses the name of a local
            \\already declared in the same block: from this statement on, the name
            \\refers to the capture. Give captures names of their own.
    );
    subheading(53, "Pattern constants");
    paragraph(
        54,
        #string,oneline
            \\`#pattern P` with neither `= value` nor `:= value` after it does not
            \\test anything. It is a quote: a compile-time value of the type
            \\`Pattern` that holds the pattern itself. `#insert` in a pattern
            \\position puts a quoted pattern back, so a pattern that several places
            \\match against can be written once and given a name.
    );
    code_block(
        55,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Token :: union { Number: f64; Name: str; Eof: void; }
            \\
            \\NUMBER :: #pattern Token.Number(n);
            \\NAME   :: #pattern Token.Name(text);
            \\
            \\describe :: (t: Token) {
            \\    if t == {
            \\    case #insert NUMBER;  print("number {}\n", n);
            \\    case #insert NAME;    print("name {}\n", text);
            \\    case .Eof;            print("end\n");
            \\    }
            \\}
            \\
            \\main :: () {
            \\    describe(.Number(2.5));
            \\    describe(.Name("hi"));
            \\    describe(.Eof);
            \\    t: Token = .Name("x");
            \\    if #pattern #insert NAME = t print("a name again: {}\n", text);
            \\}
    );
    code_block(
        56,
        "text",
        #string
            \\number 2.5
            \\name hi
            \\end
            \\a name again: x
    );
    paragraph(
        57,
        #string,oneline
            \\A quote brings its captures along: an arm that splices `NUMBER` reads
            \\`n`, under the name the quote wrote. A splice works in every pattern
            \\position: a test, a case label, the bind-or-diverge form, and inside
            \\another quote. It binds more tightly than `|`, so
            \\`#insert CIRCLE | #insert SQUARE` is an or-pattern of two splices. Any
            \\pattern can be quoted, including or-patterns and ranges:
            \\`SMALL :: #pattern 1..=3 | 7;`.
    );
    subheading(58, "A pattern exists only while compiling");
    paragraph(
        59,
        #string,oneline
            \\`Pattern` has no run-time representation: `size_of(Pattern)` is 0. A
            \\pattern is bound with `::`, never stored in a variable or a field, and
            \\attempts to do so are rejected where they are written:
    );
    code_block(
        60,
        "text",
        #string
            \\// p := #pattern .Some(v);
            \\error: a 'Pattern' value is compile-time only; bind it with '::' rather than ':='
            \\// Holder :: struct { p: Pattern; }
            \\error: field 'p' has the compile-time-only type 'Pattern', which has no storage
    );
    paragraph(
        61,
        #string,oneline
            \\A quote written where a test was meant, as in `if #pattern n { ... }`
            \\with the `= value` forgotten, is not caught by the checker; it fails
            \\later with `error: while lowering demanded function 'main': cannot
            \\lower PatternQuote expression`.
    );
    subheading(62, "Patterns as parameters");
    paragraph(
        63,
        #string,oneline
            \\A procedure receives a pattern through a `#comptime` parameter and
            \\splices it like a constant. The procedure is compiled once for each
            \\distinct pattern it is called with, and the pattern is not passed at
            \\run time. A procedure can also build and return a pattern; it is then
            \\called while compiling, with `#comptime` or from a constant (see
            \\`noalias`, `#lazy`, `#comptime`, and Type Parameters).
    );
    code_block(
        64,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Token :: union { Number: f64; Name: str; Eof: void; }
            \\
            \\matches :: (#comptime p: Pattern, t: Token) -> bool {
            \\    return #pattern #insert p = t;
            \\}
            \\
            \\exactly :: (#comptime v: f64) -> Pattern {
            \\    return #pattern Token.Number(== ``v);
            \\}
            \\
            \\TWO_AND_A_HALF :: #comptime exactly(2.5);
            \\
            \\main :: () {
            \\    t: Token = .Number(2.5);
            \\    print("{} {}\n", matches(#pattern .Number(_), t), matches(#pattern .Eof, t));
            \\    print("{}\n", matches(TWO_AND_A_HALF, t));
            \\    print("{}\n", #pattern #insert exactly(1.0) = t);
            \\}
    );
    code_block(
        65,
        "text",
        #string
            \\true false
            \\true
            \\false
    );
    subheading(66, "Names inside a quote");
    paragraph(
        67,
        #string,oneline
            \\A quote is checked where it is spliced, against the subject there. A
            \\bare name in it is therefore a capture, or a constant visible at the
            \\splice. That would not work in `exactly` above: `v` is a parameter of
            \\the procedure that builds the pattern, and it does not exist where the
            \\pattern is used. Two markers, the same ones `#code` quotes use (see
            \\`#code`, `#insert`, and `#expand`), say what a name in a quote means.
            \\A name with one backtick in front is always a name and never a
            \\capture; it is compared like a constant, and it may also name a
            \\variable where the pattern is used. A name with two backticks in
            \\front is replaced by the value it has where the quote is written,
            \\which is what `exactly` needs:
    );
    code_block(
        68,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\MAX :: 255;
            \\
            \\main :: () {
            \\    n := 255;
            \\    limit := 7;
            \\    print("{}\n", #pattern `MAX = n);      // the constant MAX
            \\    print("{}\n", #pattern `limit = n);    // compared with the variable
            \\    print("{}\n", #pattern limit = n);     // a new capture
            \\}
    );
    code_block(
        69,
        "text",
        #string
            \\true
            \\false
            \\true
    );
    paragraph(
        70,
        #string,oneline
            \\With a plain `== v` in `exactly`, the splice reports `error: unbound
            \\'v'`. With two backticks, each call of `exactly` returns a pattern
            \\with its own number copied into it.
    );
    paragraph(
        71,
        #string,oneline
            \\A name the quote does not mark is resolved where the pattern is
            \\spliced. `P :: #pattern == K;` at the top of a file works in a
            \\procedure that declares `K :: 5;` and splices `P`, although no `K`
            \\exists where `P` is written.
    );
    paragraph(
        72,
        #string,oneline
            \\In short: a bare name binds unless it is a constant at the splice, one
            \\backtick always compares, and two backticks copy a value from where
            \\the pattern was made.
    );
    subheading(73, "Types that describe themselves as patterns");
    paragraph(
        74,
        #string,oneline
            \\`#insert value` also accepts a value that is not a pattern, if its
            \\type has an instance of the prelude's `ToPattern` typeclass. The six
            \\range types have instances for integer bounds, which is how a range
            \\becomes a pattern in the first place.
    );
    code_block(
        75,
        "glosso",
        #string
            \\ToPattern :: typeclass (T: type) {
            \\    to_pattern :: (#comptime value: T) -> Pattern;
            \\}
    );
    paragraph(
        76,
        #string,oneline
            \\A type of the program's own can join. Below, the members of an enum
            \\stand for classes of ASCII bytes, and the instance builds each class's
            \\pattern from range patterns and an or-pattern:
    );
    code_block(
        77,
        "glosso",
        #string
            \\#import "Io";
            \\
            \\Ascii_Class :: enum { Digit; Alpha; }
            \\
            \\Ascii_Class ::: instance ToPattern {
            \\    to_pattern :: (#comptime c: Ascii_Class) -> Pattern {
            \\        if c == {
            \\        case .Digit;
            \\            return to_pattern(#char "0" ..= #char "9");
            \\        case .Alpha;
            \\            return #pattern #insert to_pattern(#char "a" ..= #char "z")
            \\                          | #insert to_pattern(#char "A" ..= #char "Z");
            \\        }
            \\    }
            \\}
            \\
            \\describe :: (byte: u8) {
            \\    if byte == {
            \\    case #insert Ascii_Class.Digit;  print("digit\n");
            \\    case #insert Ascii_Class.Alpha;  print("letter\n");
            \\    else;                            print("other\n");
            \\    }
            \\}
            \\
            \\main :: () {
            \\    describe(#char "x");
            \\    describe(#char "7");
            \\    describe(#char "!");
            \\}
    );
    code_block(
        78,
        "text",
        #string
            \\letter
            \\digit
            \\other
    );
    paragraph(
        79,
        #string,oneline
            \\The `#insert` is required: written bare, `Ascii_Class.Digit` is an
            \\enum-member pattern and is checked against the `u8` subject, which
            \\gives `error: got Ascii_Class, expected u8`. Patterns produced this
            \\way take part in the coverage analysis like any other. Without the
            \\`else` arm above, the compiler lists the byte ranges that remain:
            \\`0..=47`, `58..=64`, `91..=96` and `123..=255`.
    );
    paragraph(
        80,
        #string,oneline
            \\Compile-time code can also inspect patterns: count and name their
            \\captures, or ask which cases a list of patterns misses. Pattern
            \\Reflection Intrinsics describes those intrinsics.
    );
}

}
