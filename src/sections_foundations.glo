// Sections 0-17: compiler fundamentals and language syntax.

render_section_0 :: () {
    paragraph(0, #string,oneline
        \\A Glosso build begins from one source file named on the command line.
        \\The compiler runs the phases below in order, and each phase either
        \\completes or stops the build. The phase that reports a diagnostic
        \\therefore says which facts were already established: a lexical
        \\complaint knows nothing about types, and a checker complaint has
        \\already seen every declaration in the program.
    );
    table_header(1, "Phase   —   What it establishes, and what it rejects");
    table_row(2, #string,oneline
        \\Lexing   |   Unicode-aware token boundaries, literal magnitudes,
        \\nested block comments. The 128-bit cap on an integer literal is
        \\enforced here, before any destination type exists.
    );
    table_row(3, #string,oneline
        \\Operator prescan   |   Every operator declaration reachable from the
        \\prelude, the imported modules, and the file itself is collected
        \\before the file's expressions are parsed, so a user-defined operator
        \\can change how later expressions group.
    );
    table_row(4, #string,oneline
        \\Parsing   |   Declaration kinds, directive placement, and feature-gate
        \\state. `#enable` and `#disable` are applied here and are legal only at
        \\file scope.
    );
    table_row(5, #string,oneline
        \\Checking and monomorphization   |   Types, overload and typeclass
        \\instance selection, `where` conditions, and one specialization per
        \\distinct generic argument tuple.
    );
    table_row(6, #string,oneline
        \\Compile-time execution   |   Top-level `#comptime` blocks, `#comptime`
        \\constants, `#insert`, and `#expand`. A top-level `#comptime` block
        \\runs no matter which backend is selected, including `llvm-ir`.
    );
    table_row(7, #string,oneline
        \\Temporal memory analysis   |   Release obligations, aliasing, storage
        \\generations, and escape facts. Advisory by default; see Memory
        \\Contracts and Temporal Checking.
    );
    table_row(8, #string,oneline
        \\IR lowering and optimization   |   The `-O` level is applied here.
        \\`-O0` and `-O1` keep the arithmetic overflow checks that `-O2` and
        \\`-O3` remove.
    );
    table_row(9, #string,oneline
        \\Backend emission   |   The artifact chosen by `--backend`: a linked
        \\executable, an object file, a static or shared library, or LLVM IR.
    );
    paragraph(10, #string,oneline
        \\The prescan exists because Glosso lets a library introduce operator
        \\spellings and precedences. Parsing cannot know how `a ** b ** c`
        \\groups until every visible `#operator` declaration has been read, so
        \\the scan is a separate pass over the same files rather than a step
        \\inside parsing.
    );
    paragraph(11, #string,oneline
        \\`std/Prelude/module.glo` is loaded automatically and cannot be opted
        \\out of on a hosted target. It supplies primitive typeclasses,
        \\primitive operators, range iteration, dynamic-array helpers, target
        \\descriptors, `get_cmdline_args()`, `exit()`, and the numeric constants
        \\such as `PI`, which are therefore usable with no import at all. Other
        \\standard modules are opt-in.
    );
    code_block(12, "glosso", #string
        \\#import "Io";
        \\#import "Strings/Utf8";
        \\
        \\main :: () {
        \\    args := get_cmdline_args();
        \\    if args.count > 1 {
        \\        print("first arg lowercased: %\n", to_lower(args[1]));
        \\    }
        \\}
    );
    code_block(13, "text", #string
        \\$ glosso hello.glo && ./hello.exe HeLLo
        \\first arg lowercased: hello
    );
    note(14, #string,oneline
        \\`Strings` is a namespace directory with no `module.glo` marker, so it
        \\is not importable: `#import "Strings";` fails with `error: cannot find
        \\module "Strings" (looked for std/Strings.glo or
        \\std/Strings/module.glo)`. Import the component that holds the
        \\operation, here `Strings/Utf8`.
    );
    subheading(15, "Reading a diagnostic by phase");
    paragraph(16, #string,oneline
        \\The four diagnostics below come from four different phases of the same
        \\pipeline. The first fires without a type, the second without a
        \\declaration table, the third with the whole program checked, and the
        \\fourth only when the program runs.
    );
    code_block(17, "text", #string
        \\// x : u128 = 340_282_366_920_938_463_463_374_607_431_768_211_456;
        \\error: integer literal '340282366920938463463374607431768211456' does not fit in 128 bits
        \\
        \\// main :: () { #enable(lossy_numerics); }
        \\error: unexpected directive 'enable'
        \\
        \\// describe("text"), with only an Is_Integer instance in scope
        \\error: no overload 'describe' accepts these arguments
        \\
        \\// w : u32 = -1;  at the default -O1
        \\(no diagnostic; the process aborts with status 134)
    );
}

render_section_1 :: () {
    paragraph(0, #string,oneline
        \\The driver takes exactly one source file plus options. `glosso
        \\--help` prints the listing below; `glosso <file>` with no other
        \\option links an executable at `-O1`. Every option that takes a value
        \\also accepts the `=`-joined spelling, so `--backend=object`,
        \\`--target=wasm32-wasi`, `--color=never`, `--cache-dir=<dir>`,
        \\`--linker-arg=<arg>`, and `--temp-allocator-size=<bytes>` are
        \\equivalent to the separated forms.
    );
    code_block(1, "text", #string
        \\glosso [options] <file.glo>
        \\--backend <llvm|object|static-lib|shared-lib|llvm-ir>
        \\--target <os-cpu-abi>          (also cpu-os-abi, and wasm shorthands)
        \\--print-targets | --targets
        \\-O0 | -O1 | -O2 | -O3          speed levels; -O1 is the default
        \\-Os | -Oz | -Ozz               size levels; -Ozz also strips symbols
        \\-o <file>
        \\--linker-arg <arg>
        \\--memory-sanitizer
        \\--thread-sanitizer
        \\--borrow-check <off|warning|error>
        \\--temp-allocator-size <bytes>  initial temporary arena; default 4 MiB
        \\--no-main                      #c_call exports become runtime roots
        \\--run                          build and run; --backend llvm only
        \\--cache-dir <absolute-dir>
        \\--print-cache-dir
        \\--show-generated
        \\--color <auto|always|never>
        \\--std <dir>
        \\-- <args...>                   arguments for compile-time execution
        \\-h | --help
    );
    subheading(2, "Backends");
    paragraph(3, #string,oneline
        \\`--backend` selects what the last phase writes. The default output
        \\name is the source stem with a target-appropriate extension; the
        \\names below are what `glosso dflt.glo --backend <b>` produced on
        \\`x86_64-pc-windows-msvc`.
    );
    table_header(4, "Backend   —   Artifact");
    table_row(5, #string,oneline
        \\`llvm`   |   `dflt.exe`, fully linked. The only backend `--run`
        \\accepts.
    );
    table_row(6, #string,oneline
        \\`object`   |   `dflt.obj`, a single relocatable object; no link step
        \\runs.
    );
    table_row(7, "`static-lib`   |   `dflt.lib`, an archive.");
    table_row(8, #string,oneline
        \\`shared-lib`   |   `dflt.dll` plus the import library `dflt.dll.lib`
        \\on the MSVC target.
    );
    table_row(9, "`llvm-ir`   |   `dflt.ll`, textual LLVM IR.");
    note(10, #string,oneline
        \\There is no `llvm-obj` backend. It is rejected before compilation
        \\starts: `glosso: unknown backend 'llvm-obj' (choose llvm, object,
        \\static-lib, shared-lib, or llvm-ir)`. Asking for `--run` with any
        \\other backend is `glosso: --run is available only for --backend
        \\llvm`.
    );
    subheading(11, "Optimization levels");
    paragraph(12, #string,oneline
        \\`-O0` through `-O3` are speed levels; `-Os`, `-Oz`, and `-Ozz` are
        \\size levels that additionally enable dead-section elimination and
        \\identical-code folding where the target supports them, and `-Ozz`
        \\strips non-runtime symbols. The level is not cosmetic: `-O0` and `-O1`
        \\keep the trapping overflow checks on `+`, `-`, and `*`, so a program
        \\that aborts unoptimized can produce a wrapped value at `-O2`. `-O0`
        \\also installs the debug context allocator instead of the heap
        \\allocator.
    );
    code_block(13, "text", #string
        \\$ for level in -O0 -O1 -O2 -O3 -Os -Oz -Ozz; do ... done   # hello.glo
        \\-O0   164864
        \\-O1   146432
        \\-O2   146432
        \\-O3   146432
        \\-Os    62976
        \\-Oz    59904
        \\-Ozz   59904
    );
    subheading(14, "Arguments for compile-time execution");
    paragraph(15, #string,oneline
        \\Everything after `--` belongs to the compiler's own compile-time
        \\execution, not to the produced program. A top-level `#comptime` block
        \\sees those strings through `get_cmdline_args()`; without `--` the
        \\count is 0. The arguments are part of the artifact cache identity, so
        \\changing them forces a rebuild.
    );
    code_block(16, "glosso", #string
        \\#import "Io";
        \\
        \\#comptime {
        \\    a := get_cmdline_args();
        \\    print("comptime saw % args\n", a.count);
        \\    for x, i: a { print("  [%] %\n", i, x); }
        \\}
        \\
        \\main :: () {}
    );
    code_block(17, "text", #string
        \\$ glosso build.glo -- alpha beta
        \\comptime saw 2 args
        \\  [0] alpha
        \\  [1] beta
    );
    note(18, #string,oneline
        \\Only the top-level block form has that access. Calling
        \\`get_cmdline_args()` from a function folded into a `#comptime`
        \\constant runs on the compile-time evaluator instead, which rejects it:
        \\`error: #magic intrinsic 'get_cmdline_args' is not available during
        \\compile-time evaluation`.
    );
    subheading(19, "Targets");
    paragraph(20, #string,oneline
        \\`--print-targets`, spelled `--targets` as well, lists the target names
        \\this compiler can emit together with the triple each one expands to.
        \\Names are accepted in `os-cpu-abi` and `cpu-os-abi` order, plus the
        \\Zig-style wasm shorthands.
    );
    table_header(21, "Freestanding target   —   Triple and artifact");
    table_row(22, #string,oneline
        \\`wasm32-freestanding`   |   `wasm32-unknown-unknown`. Browser or
        \\embedded WebAssembly with no WASI and no C standard library.
    );
    table_row(23, #string,oneline
        \\`x86_64-freestanding`   |   `x86_64-unknown-none-elf`, a bare-metal
        \\ELF executable.
    );
    table_row(24, #string,oneline
        \\`x86_64-freestanding-uefi`   |   A UEFI PE/COFF object, not a
        \\linkable executable.
    );
    paragraph(25, #string,oneline
        \\On a freestanding target a `#c_call` `main` may take host parameters
        \\and return a C-ABI value; it is exported under the symbol `glo_main`.
        \\The trapping arithmetic of `-O0` and `-O1` calls `abort`, which does
        \\not exist there, so a plain `+` in a freestanding entry point fails at
        \\link time. Use the wrapping operators, or build at `-O2`. The
        \\Bare-Metal and Freestanding Targets chapter covers the rest.
    );
    code_block(26, "glosso", #string
        \\main :: (a: s32, b: s32) -> s32 #c_call { return a +% b; }
    );
    code_block(27, "text", #string
        \\$ glosso --target wasm32-freestanding w.glo -o w.wasm
        \\glosso: done w.wasm  (backend=llvm, target=wasm32-unknown-unknown, -O1)
        \\
        \\// with a plain `a + b` instead:
        \\error: wasm-ld: error: ...w.o: undefined symbol: abort
    );
    subheading(28, "A minimal workflow");
    code_block(29, "text", #string
        \\glosso hello.glo --run
        \\glosso hello.glo -O2 -o hello
        \\glosso hello.glo --backend llvm-ir -o hello.ll
        \\glosso hello.glo --borrow-check error
    );
}

render_section_2 :: () {
    paragraph(0, #string,oneline
        \\Glosso stores purgeable compiler artifacts in a per-user cache, never
        \\in the source checkout. `--cache-dir <absolute-dir>` has highest
        \\precedence, followed by `GLOSSO_CACHE_DIR`. Without either override
        \\the cache root is:
    );
    bullet(1, "Windows: `%LOCALAPPDATA%\\glosso\\cache`");
    bullet(2, #string,oneline
        \\POSIX with an absolute `XDG_CACHE_HOME`: `$XDG_CACHE_HOME/glosso`
    );
    bullet(3, "macOS without that XDG setting: `~/Library/Caches/glosso`");
    bullet(4, "other POSIX hosts without it: `~/.cache/glosso`");
    paragraph(5, #string,oneline
        \\`glosso --print-cache-dir` prints the effective root and exits. Both
        \\overrides must be absolute, and each rejects a relative path with its
        \\own message.
    );
    code_block(6, "text", #string
        \\$ glosso --print-cache-dir
        \\C:\Users\almag\AppData\Local\glosso\cache
        \\
        \\$ glosso --cache-dir=relative --print-cache-dir
        \\glosso: --cache-dir: cache directory override must be an absolute path
        \\
        \\$ GLOSSO_CACHE_DIR=relative glosso --print-cache-dir
        \\glosso: cache directory unavailable: GLOSSO_CACHE_DIR must contain an absolute path
    );
    subheading(7, "What lives under the root");
    table_header(8, "Subtree   —   Contents");
    table_row(9, #string,oneline
        \\`generated/insert/v1/<sha256>.glo`   |   String-valued `#insert`
        \\output, cached verbatim and reused by content hash.
    );
    table_row(10, #string,oneline
        \\`native/v6/<name>/<target>/<key>/`   |   Archives built from bundled C
        \\sources, one directory per library, target, and configuration key;
        \\`<name>.lib` on Windows targets and `lib<name>.a` elsewhere.
    );
    table_row(11, #string,oneline
        \\`native/artifacts/v1/<key>.artifact` and `.manifest`   |   The final
        \\build output of a whole compilation, plus the dependency stamps that
        \\validate it.
    );
    note(12, #string,oneline
        \\Older roots may still contain a `native/v4` tree from a previous
        \\compiler. Nothing reads it; deleting it is safe.
    );
    subheading(13, "The whole-build artifact cache");
    paragraph(14, #string,oneline
        \\`native/artifacts/v1` is not a compilation cache in the incremental
        \\sense. It stores the finished output of a build under a key derived
        \\from the canonical source path, the standard-library path, the target
        \\triple and its component fields, the backend, the speed and size
        \\levels, the sanitizer selection, the borrow-check mode, the
        \\temporary-arena size, `--no-main`, every `--linker-arg`, and every
        \\argument after `--`. Beside it, the manifest records the length and
        \\modification time of every file source resolution touched, plus the
        \\compiler executable.
    );
    paragraph(15, #string,oneline
        \\On the next build the driver validates the manifest before it reads
        \\the source at all. If every stamp still matches, the stored artifact
        \\is copied to the output path and no phase runs. Only the `llvm`,
        \\`object`, and `static-lib` backends participate, and `--show-generated`
        \\opts out so that the generated-source paths are actually printed.
    );
    code_block(16, "text", #string
        \\$ glosso hello.glo
        \\glosso: compile hello.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link hello.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done hello.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\
        \\$ glosso hello.glo
        \\glosso: restored hello.exe from the native artifact cache
        \\
        \\$ GLOSSO_DISABLE_ARTIFACT_CACHE=1 glosso hello.glo
        \\glosso: compile hello.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link hello.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done hello.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
    );
    note(17, #string,oneline
        \\Setting `GLOSSO_DISABLE_ARTIFACT_CACHE` to any value, including the
        \\empty string, disables both restore and store. Use it when timing a
        \\full build, or when an editor rewrites a file without changing its
        \\length or modification time. `GLOSSO_NATIVE_CACHE_DIR` is a separate
        \\legacy override that relocates only the `native/v6` archives; it does
        \\not move generated Glosso source or the artifact cache.
    );
    subheading(18, "Generated sources and their diagnostics");
    paragraph(19, #string,oneline
        \\`--show-generated` prints the cached path of every generated file a
        \\successful compilation used.
    );
    code_block(20, "text", #string
        \\$ glosso insert_demo.glo --show-generated
        \\glosso: compile insert_demo.glo (target=x86_64-pc-windows-msvc)
        \\glosso: generated source C:\Users\almag\AppData\Local\glosso\cache\generated\insert\v1\6a8a20...ffae.glo
        \\glosso: done insert_demo.exe  (backend=llvm, ...)
    );
    paragraph(21, #string,oneline
        \\When generated code fails, the primary diagnostic points at the
        \\outermost editable `#insert`, because that is the text a reader can
        \\change. Source-framed notes then point into the cached generated file
        \\and through each intermediate `#insert` of a nested expansion chain.
        \\The cache is never the source of truth and may be deleted at any time;
        \\Glosso recreates entries when they are needed again.
    );
}

render_section_3 :: () {
    paragraph(0, #string,oneline
        \\`#import "Name"` loads a module by import name. `#load "file.glo"`
        \\loads a concrete source file relative to the loading file. Either form
        \\may be aliased so later code can qualify names through the alias.
    );
    paragraph(1, #string,oneline
        \\A standard module is stored either as one file, `std/Name.glo`, or as
        \\a multi-file directory marked by `std/Name/module.glo`. A marked
        \\directory loads all direct `.glo` siblings. An unmarked directory is
        \\only a namespace for component modules, so `Container` and `Strings`
        \\cannot become accidental umbrella imports.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\#import "Strings/Utf8";
        \\Local :: #load "local_helpers.glo";
        \\
        \\main :: () {
        \\    print("%\n", to_lower("MiXeD"));
        \\    print("%\n", Local.helper());
        \\}
    );
    code_block(3, "text", #string
        \\// #import "Container";
        \\error: cannot find module "Container" (looked for std/Container.glo or std/Container/module.glo)
    );
    subheading(4, "What an alias can qualify");
    paragraph(5, #string,oneline
        \\An alias is a namespace-like handle, not a runtime value, and its
        \\reach depends on how the unit was brought in. Through `#load`, an
        \\alias qualifies functions, constants, and types alike. Through
        \\`#import` of a standard module, only functions currently resolve
        \\through the alias; a type or a constant reached that way is not found.
    );
    code_block(6, "glosso", #string
        \\// local_helpers.glo
        \\LIMIT :: 12;
        \\Point :: struct { x: int = 3; y: int; }
        \\helper :: () -> int { return 7; }
        \\
        \\// main.glo
        \\L :: #load "local_helpers.glo";
        \\main :: () {
        \\    p: L.Point;                    // ok
        \\    print("% % %\n", L.helper(), L.LIMIT, p.x);   // 7 12 3
        \\}
    );
    code_block(7, "text", #string
        \\// M :: #import "Math/SpecialFunctions";  M.bessel_j0(1.0)
        \\0.765198
        \\
        \\// H :: #import "Html";  d: H.Html_Document;
        \\error: unknown type 'H.Html_Document'
        \\
        \\// M :: #import "Math/Constants";  M.PI
        \\error: unbound 'M'
    );
    note(8, #string,oneline
        \\Import the module unqualified when its types or constants are needed:
        \\`#import "Html";` makes `Html_Document` a plain name. Reserve the
        \\alias form for call-heavy modules, or narrow the surface with `only`
        \\instead.
    );
    subheading(9, "Selective imports");
    paragraph(10, #string,oneline
        \\`only` exposes exactly the listed public declarations; `hide` exposes
        \\every public declaration except those listed. Lists may name
        \\functions, constants, globals, types, typeclasses, and quoted operator
        \\declarations, and work with qualified and unqualified imports alike.
    );
    code_block(11, "glosso", #string
        \\#import,only (PI, TAU) "Math/Constants";
        \\#import,hide (HALF_PI) "Math/Constants";
        \\SF :: #import,only (bessel_j0) "Math/SpecialFunctions";
        \\Cx :: #import,only ('/', complex128, real_part128) "Math/Complex";
    );
    paragraph(12, #string,oneline
        \\Selection affects the importing scope, not compilation. Dependencies
        \\still load, and a hidden declaration remains usable as an
        \\implementation helper by a selected one. Repeated imports of the same
        \\module and alias combine their exposed names, so a second `only`
        \\import widens rather than replaces the first. An unselected import
        \\exposes the complete public API.
    );
    bullet(13, #string,oneline
        \\An unknown entry is rejected with `error: #import,only names unknown
        \\public declaration 'NOT_A_NAME' in module "Math/Constants"`, followed
        \\by a note listing the public names.
    );
    bullet(14, #string,oneline
        \\A repeated entry is rejected with `error: duplicate name 'PI' in
        \\#import,only`.
    );
    bullet(15, #string,oneline
        \\An operator entry must be spelled exactly as the module declares it.
        \\`Math/Complex` declares `'+'`, `'*'`, and `'/'` inside a typeclass
        \\instance rather than as public module declarations, so `only ('+')`
        \\reports the same unknown-declaration error; select the typeclass
        \\instead.
    );
    bullet(16, #string,oneline
        \\Names produced by a top-level `#insert` are not known until checker
        \\time, so generated declarations stay hidden under a selective import.
    );
    bullet(17, #string,oneline
        \\Typeclass instances remain available as global instance evidence,
        \\following Haskell's instance-import behavior, but their method names
        \\stay hidden unless the class itself is selected. Selecting a class
        \\also selects its methods; under an aliased import both use the alias.
    );
    subheading(18, "The Math namespace");
    paragraph(19, #string,oneline
        \\There is no `std/Math/module.glo`, so `Math` is a namespace rather
        \\than a real module: import the components `Math/Core`,
        \\`Math/Constants`, `Math/Bit`, `Math/NumberTheory`, `Math/Complex`,
        \\`Math/Bignum`, `Math/Matrix`, and `Math/SpecialFunctions`. Portable
        \\fixed-lane vectors live in the separate top-level `Simd` module.
    );
    note(20, #string,oneline
        \\`#import "Math"` is nevertheless accepted in a full-standard-library
        \\build, where the driver rewrites it to `Math/Core` for compatibility
        \\with two long-standing examples. It is not a general umbrella and
        \\brings in none of the other components; do not rely on it.
    );
}

render_section_4 :: () {
    paragraph(0, #string,oneline
        \\A source file is a sequence of declarations and compile-time actions.
        \\Imports, loads, library handles, type declarations, constants, mutable
        \\globals, functions, typeclasses, instances, memory overlays, top-level
        \\`#insert`, and top-level `#comptime` are all valid file items. A
        \\runtime expression statement is not: the parser reaches the call's
        \\parenthesis with no declaration under construction.
    );
    code_block(1, "text", #string
        \\// print("nope\n");   at file scope
        \\error: unexpected token '('
    );
    paragraph(2, "The binding punctuation determines the declaration kind:");
    bullet(3, "`Name :: expression;` declares a compile-time constant.");
    bullet(4, #string,oneline
        \\`name: Type : expression;` declares a typed compile-time constant.
    );
    bullet(5, #string,oneline
        \\`name: Type = expression;` or `name: Type := expression;` declares a
        \\mutable global.
    );
    bullet(6, #string,oneline
        \\`name := expression;` and `name ::= expression;` are inferred mutable
        \\globals at file scope. Both accept later assignment; `::=` differs
        \\only in evaluating its initializer at compile time.
    );
    bullet(7, #string,oneline
        \\`name: Type;` declares a typed mutable global with default
        \\initialization.
    );
    code_block(8, "glosso", #string
        \\Page_Size :: 4096;
        \\Mask: u32 : 16#ff00;
        \\request_count: u64 = 0;
        \\cache: [..]string;
        \\inferred := 7;
        \\folded ::= Page_Size / 8;
    );
    paragraph(9, #string,oneline
        \\A file-scope `::` initializer must be foldable by the compile-time
        \\evaluator. The evaluator refuses to read a mutable binding, so a
        \\constant that names one reports `error: unknown const n` rather than a
        \\type error.
    );
    subheading(10, "Thread-local storage");
    paragraph(11, #string,oneline
        \\`#thread_local` may prefix only a top-level mutable global. Each
        \\runtime thread receives a separate instance of that storage. Applying
        \\it to a constant, function, type, or import is rejected during
        \\parsing, and it is not a statement, so a local declaration cannot
        \\carry it.
    );
    code_block(12, "glosso", #string
        \\#thread_local current_worker: s32 = -1;
        \\#thread_local scratch: [..]u8;
    );
    code_block(13, "text", #string
        \\// #thread_local C :: 5;
        \\error: #thread_local can only prefix a global variable declaration
        \\
        \\// inside a procedure body:  #thread_local x: s32 = 1;
        \\error: unexpected directive 'thread_local'
    );
    paragraph(14, #string,oneline
        \\Initialization must still obey the ordinary global-initializer rules
        \\for the selected backend. Thread-local storage does not make the
        \\referenced objects or pointers thread-safe; only the declared global
        \\slot becomes thread-specific, and a pointer stored in one thread's
        \\slot still names memory every thread can reach.
    );
}

render_section_5 :: () {
    paragraph(0, #string,oneline
        \\`#enable(feature)` and `#disable(feature)` switch parser state for the
        \\declarations that follow them in the same file. Braces do not delimit
        \\the region and the state does not stack: the directive stays in force
        \\until the matching `#disable`, or until the end of the file.
    );
    paragraph(1, #string,oneline
        \\The parser accepts exactly five feature names. Anything else is
        \\`error: unknown feature '<name>'`, reported at the name rather than at
        \\the directive.
    );
    table_header(2, "Feature   —   Default and effect");
    table_row(3, #string,oneline
        \\`private_section`   |   Public. Following declarations are private to
        \\the defining source unit.
    );
    table_row(4, #string,oneline
        \\`private_sections`   |   Accepted plural spelling of the same gate.
    );
    table_row(5, #string,oneline
        \\`lossy_numerics`   |   Off. Restores implicit narrowing, sign
        \\reinterpretation, and precision-losing float conversions.
    );
    table_row(6, #string,oneline
        \\`pointer_punning`   |   Off. Restores pointee-unchecked pointer
        \\conversions and `*T`/`[*]T` interchange.
    );
    table_row(7, #string,oneline
        \\`union_unwrap`   |   On. Permits direct union payload access outside a
        \\match, compiled as a checked unwrap. `#disable(union_unwrap)` is the
        \\strict direction.
    );
    paragraph(8, #string,oneline
        \\Two of the five default off and one defaults on, so `#enable` is the
        \\relaxing direction for `lossy_numerics` and `pointer_punning` and
        \\`#disable` is the strict direction for `union_unwrap`. The Strict
        \\Conversions and Feature Gates chapter covers what the numeric and
        \\pointer gates change; Union Payload Access and Checked Unwrap covers
        \\the third.
    );
    code_block(9, "glosso", #string
        \\#import "Io";
        \\#enable(pointer_punning);
        \\
        \\main :: () {
        \\    x : s64 = 7;
        \\    q : *u8 = *x;      // rejected without the gate
        \\    print("%\n", q.*);
        \\}
    );
    code_block(10, "text", #string
        \\// the same body with the gate absent:
        \\error: got *int, expected *u8
        \\
        \\// u.A on a union, under #disable(union_unwrap):
        \\error: union value is not known to hold '.A' here
        \\note: match on it first, or enable #enable(union_unwrap) for a checked unwrap
        \\
        \\// #enable(strict_numerics);
        \\error: unknown feature 'strict_numerics'
    );
    subheading(11, "Scope of a feature directive");
    paragraph(12, #string,oneline
        \\The gate is file-scoped in the strict sense. It is a file item, so it
        \\cannot appear inside a procedure body, and it does not travel across a
        \\`#load` or `#import` boundary: every file begins at the defaults no
        \\matter what enabled the gate in the file that pulled it in. A helper
        \\that needs relaxed rules must enable them itself.
    );
    code_block(13, "text", #string
        \\// inside a procedure body:  #enable(lossy_numerics);
        \\error: unexpected directive 'enable'
        \\
        \\// main.glo enables pointer_punning, then #loads a file that punns:
        \\error: got *int, expected *u8
    );
    subheading(14, "Visibility and import filtering");
    paragraph(15, #string,oneline
        \\A private section does not introduce a runtime scope. The declarations
        \\still belong to the file and still link; the compiler gives them
        \\stable internal names and rewrites implementation references, so
        \\private types, typeclass methods, operators, instances, and `#foreign`
        \\library handles keep working internally without leaking their source
        \\spelling. What changes is the name table another file sees.
    );
    code_block(16, "glosso", #string
        \\// module.glo
        \\public_before :: () {}
        \\
        \\#enable(private_section);
        \\helper :: () {}
        \\Hidden :: struct { value: s64; }
        \\#disable(private_section);
        \\
        \\public_after :: () { helper(); }
        \\
        \\// consumer.glo
        \\M :: #load "module.glo";
        \\main :: () { M.public_after(); }   // M.helper() is not a name here
    );
    code_block(17, "text", #string
        \\// M.helper()
        \\error: unknown function M.helper
    );
    paragraph(18, #string,oneline
        \\`siblings` widens the boundary to the other files of the same logical
        \\module and is legal only on the two private-section spellings. On any
        \\other gate the whole `name,mode` text is reported as the unknown
        \\feature, because the parser only looks for a second word after those
        \\two names.
    );
    code_block(19, "glosso", #string
        \\#enable(private_section, siblings);
        \\shared_module_helper :: () {}
        \\#disable(private_section);
    );
    code_block(20, "text", #string
        \\// #enable(lossy_numerics, siblings);
        \\error: unknown feature 'lossy_numerics,siblings'
    );
    bullet(21, #string,oneline
        \\A leading `__` is a naming convention for implementation details, not
        \\an access-control mechanism. Use a private section when the compiler
        \\must enforce the boundary.
    );
    bullet(22, #string,oneline
        \\`only(...)` and `hide(...)` at an import make dependencies explicit,
        \\but they cannot restore a declaration the defining file already hid.
    );
    bullet(23, #string,oneline
        \\Declare the public API before enabling private mode or after disabling
        \\it, since the directive applies to what follows it in source order.
    );
}
render_section_6 :: () {
    paragraph(0, #string,oneline
        \\Free functions and operation names are unique. Declaring the same
        \\function twice in one program is an error, and every overloadable
        \\operation is owned by exactly one typeclass, so a second typeclass
        \\cannot claim the same spelling. Both rules are enforced while the
        \\declaration table is built, before any call is looked at, which is why
        \\an import can never change behavior by changing declaration order.
    );
    code_block(1, "text", #string
        \\// f :: (a: int) -> int { ... }   f :: (a: f64) -> f64 { ... }
        \\error: function 'f' is already declared
        \\
        \\// A :: typeclass (T: type) { shape_area :: (v: T) -> f64; }
        \\// B :: typeclass (T: type) { shape_area :: (v: T) -> f64; }
        \\error: function 'shape_area' is already owned by typeclass 'A'
    );
    paragraph(2, #string,oneline
        \\Overloading therefore happens inside one typeclass, across its
        \\instances. Operation typeclasses take the complete argument-type tuple
        \\as parameters and normally expose an associated `Output` type.
        \\Candidate selection first discards signatures and `where` clauses that
        \\do not apply, then ranks the survivors by witness use and specificity.
    );
    code_block(3, "glosso", #string
        \\#import "Io";
        \\
        \\C :: typeclass (T: type) { describe :: (v: T) -> string; }
        \\
        \\s32 :: instance C {
        \\    describe :: (v: s32) -> string { return "exact s32"; }
        \\}
        \\
        \\$T :: instance C where Is_Integer(T) {
        \\    describe :: (v: T) -> string { return "any integer"; }
        \\}
        \\
        \\main :: () {
        \\    print("%\n", describe(cast(s32)1));
        \\    print("%\n", describe(cast(s64)1));
        \\}
    );
    code_block(4, "text", #string
        \\exact s32
        \\any integer
    );
    subheading(5, "Candidate selection");
    paragraph(6, #string,oneline
        \\An operation spelling is owned by one typeclass, but a call may still
        \\have several concrete and generic implementation candidates. The
        \\checker matches arguments and constraints, scores the survivors, and
        \\rejects a tie at the best score. Source and import order are not
        \\tiebreakers.
    );
    bullet(7, #string,oneline
        \\Collect visible declarations for the spelling, or only the explicitly
        \\scoped typeclass when a scope is written.
    );
    bullet(8, #string,oneline
        \\Normalize named arguments when all overloaded interfaces agree on
        \\parameter names; otherwise require positional arguments.
    );
    bullet(9, #string,oneline
        \\Reject candidates whose arity, defaults, variadic position, parameter
        \\types, generic bindings, or coercions do not fit.
    );
    bullet(10, #string,oneline
        \\Evaluate `#modify` and every `where` clause using the inferred
        \\compile-time bindings; a false condition removes the candidate. This
        \\is how `Is_Integer(T)` and `Is_Float(T)` instances of the same class
        \\coexist without ambiguity.
    );
    bullet(11, #string,oneline
        \\Sort applicable candidates by implicit empty-witness use, then by
        \\descending specificity score. An exact non-generic signature receives
        \\a large advantage, and a parameter more specific than `any` scores
        \\above an erased match. Select the top candidate only when it beats the
        \\next one.
    );
    bullet(12, #string,oneline
        \\A typeclass requirement declaration is discarded once a real
        \\implementation candidate survives for the call.
    );
    subheading(13, "The two failure modes");
    paragraph(14, #string,oneline
        \\When no candidate survives, the diagnostic names the constraint that
        \\failed and then lists the candidates it considered, so the reader can
        \\see which `where` clause rejected the argument.
    );
    code_block(15, "text", #string
        \\// only a `where Is_Integer(T)` instance is in scope
        \\// describe("text")
        \\error: no overload 'describe' accepts these arguments
        \\note: constraint failed for describe
        \\note: possible candidates for 'describe':
        \\candidate: describe :: (v: T) -> string
        \\candidate: describe :: (v: T) -> string
    );
    paragraph(16, #string,oneline
        \\When two candidates survive with the same witness status and score,
        \\the compiler refuses to guess and names both instances. Overlapping
        \\constraints are the usual cause: `Is_Integer(T)` and `Is_Numeric(T)`
        \\both admit `s32`, and neither is more specific than the other.
    );
    code_block(17, "glosso", #string
        \\C :: typeclass (T: type) { op :: (v: T) -> int; }
        \\$T :: instance C where Is_Integer(T) { op :: (v: T) -> int { return 1; } }
        \\$T :: instance C where Is_Numeric(T) { op :: (v: T) -> int { return 2; } }
        \\
        \\main :: () { _ := op(cast(s32)1); }
    );
    code_block(18, "text", #string
        \\error: ambiguous typeclass operation 'op' for these argument types
        \\note: first matching instance is declared here
        \\note: another matching instance is declared here
    );
    note(19, #string,oneline
        \\The scoring rules describe the current implementation, not permission
        \\to build fragile overload sets. An ambiguity is only detected at the
        \\call, so an instance added far from the call site can break code that
        \\compiled yesterday. Prefer constraint sets that are disjoint by
        \\construction, as `Is_Integer` and `Is_Float` are.
    );
}

render_section_7 :: () {
    paragraph(0, #string,oneline
        \\`#memory` is Glosso's compile-time language for describing ownership,
        \\aliasing, release, relocation, and escape behavior. It applies to
        \\regular functions, magic functions, foreign declarations, selected
        \\call sites, lexical or top-level overlays, and intentional-leak
        \\bindings. It never changes runtime representation, ABI, pointer
        \\syntax, assignment, or parameter passing. Values still copy as
        \\ordinary Glosso values.
    );
    paragraph(1, #string,oneline
        \\After type checking, the analyzer attaches invisible resource
        \\identities and storage generations to memory-bearing values. It uses
        \\those facts to diagnose use after release, double release, stale views
        \\after relocation, incomplete release paths, local-address escape,
        \\unknown foreign retention, incompatible releasers, and unintended
        \\leaks for resources with a known cleanup function.
    );
    paragraph(2, #string,oneline
        \\This is an advisory analysis, not a move system. Copies remain valid
        \\aliases; there is no moved-from state and no lifetime syntax.
        \\Releasing through one alias changes the shared abstract resource state
        \\observed through every alias, which is exactly what makes a
        \\use-after-release finding possible without ownership transfer.
    );
    subheading(3, "Complete grammar");
    paragraph(4, #string,oneline
        \\The following EBNF is the complete source grammar specific to
        \\`#memory`, and it is enforced during parsing. `identifier` and
        \\`integer` use the ordinary Glosso lexical grammar.
    );
    code_block(5, "text", #string
        \\memory-directive =
        \\    "#memory" memory-effect
        \\  | "#memory" "(" memory-effect ("," memory-effect)* ")"
        \\
        \\memory-effect =
        \\    "returns_fresh"
        \\  | "returns_fresh" "(" return-place ")"
        \\  | "returns_borrow" "(" parameter-ref ")"
        \\  | "returns_borrow" "(" return-place "," parameter-ref ")"
        \\  | "returns_static"
        \\  | "returns_static" "(" return-place ")"
        \\  | "released_by" "(" qualified-name ")"
        \\  | "released_by" "(" return-place "," qualified-name ")"
        \\  | "resource" "(" "released_by" ":" qualified-name ")"
        \\  | "resource" "(" return-place "," "released_by" ":"
        \\        qualified-name ")"
        \\  | "leak"
        \\  | "kills" "(" parameter-ref ")"
        \\  | "invalidates" "(" parameter-ref ")"
        \\  | "noescape" "(" parameter-ref ")"
        \\  | "escapes" "(" parameter-ref ")"
        \\  | "reads" "(" parameter-ref ")"
        \\  | "writes" "(" parameter-ref ")"
        \\  | "unknown"
        \\  | "unknown" "(" return-place ")"
        \\
        \\parameter-ref =
        \\    identifier
        \\  | "arg" "(" integer ")"
        \\
        \\return-place =
        \\    "returned" "." identifier ("." identifier)*
        \\  | identifier ("." identifier)*
        \\
        \\qualified-name =
        \\    identifier ("." identifier)*
    );
    paragraph(6, #string,oneline
        \\`returns_fresh`, `returns_static`, and `unknown` are the three effects
        \\whose parentheses are optional; every other parenthesized effect
        \\requires its argument, and `leak` rejects one. An effect list must not
        \\be empty, and the grouped form does not accept a trailing comma. A
        \\bare directive contains exactly one effect. Directives may be
        \\repeated, and repetition is equivalent to concatenating grouped effect
        \\lists in source order, so the two spellings below are the same
        \\contract.
    );
    code_block(7, "glosso", #string
        \\mk :: () -> *Obj #foreign "c" "mk"
        \\    #memory returns_fresh
        \\    #memory released_by(kill_it);
        \\
        \\mk :: () -> *Obj #foreign "c" "mk"
        \\    #memory(returns_fresh, released_by(kill_it));
    );
    paragraph(8, #string,oneline
        \\`returned` is contextual only inside a return-place argument; it is
        \\not a keyword and creates no binding. A different leading identifier
        \\must name a result variable from a fully named multiple-return tuple.
        \\Every return-origin effect and every result releaser accepts the same
        \\return-place notation.
    );
    code_block(9, "text", #string
        \\// #memory returns_borrowed
        \\error: unknown #memory effect 'returns_borrowed'
        \\
        \\// #memory()
        \\error: #memory effect list cannot be empty
        \\
        \\// #memory(noescape(p),)
        \\error: unexpected token ')'
        \\
        \\// #memory(noescape(arg(-1)))
        \\error: unexpected token '-'
    );
    paragraph(10, "Memory overlays use a separate statement form:");
    code_block(11, "text", #string
        \\memory-overlay =
        \\    "#memory" qualified-name "{"
        \\        memory-effect ("," memory-effect)* [","]
        \\    "}" [";"]
    );
    paragraph(12, #string,oneline
        \\Unlike a grouped directive, an overlay may have a trailing comma. An
        \\overlay body must not be empty.
    );
    subheading(13, "Attachment sites");
    paragraph(14, "There are four valid attachment sites.");
    subheading(15, "Function contract");
    paragraph(16, #string,oneline
        \\Place one or more directives after the parameter and return signature,
        \\among the other function directives, and before any `where` clause or
        \\body.
    );
    code_block(17, "glosso", #string
        \\Object_Create :: () -> *Object
        \\    #foreign "objectlib" "Object_Create"
        \\    #memory(returns_fresh, released_by(Object_Destroy));
        \\
        \\Object_Destroy :: (object: *Object)
        \\    #foreign "objectlib" "Object_Destroy"
        \\    #memory(kills(object), noescape(object));
        \\
        \\open_fs :: (path: string) -> Result(File, Fs_Error)
        \\    #memory(returns_fresh(returned.Ok),
        \\            released_by(returned.Ok, close_it));
        \\
        \\pair :: () -> (x: Result(File, Fs_Error), y: Option(File))
        \\    #memory(returns_fresh(x.Ok), released_by(x.Ok, close_it),
        \\            returns_static(y.Some));
    );
    paragraph(18, #string,oneline
        \\The same syntax is valid on regular, `#magic`, `#foreign`, `#c_call`,
        \\prefix, suffix, binary, and assignment-operator functions. A regular
        \\body is still analyzed; an explicit contract seeds inference rather
        \\than disabling it.
    );
    subheading(19, "Call-site contract");
    paragraph(20, #string,oneline
        \\A memory directive may follow a call expression. The call must resolve
        \\statically to one function.
    );
    code_block(21, "glosso", #string
        \\object := Unannotated_Create()
        \\    #memory resource(released_by: Object_Destroy);
    );
    paragraph(22, #string,oneline
        \\At a call site, `released_by(f)` and `resource(released_by: f)` both
        \\imply `returns_fresh` and create the same release obligation.
        \\`resource(...)` exists only at call sites. Other effects can refine one
        \\call without changing the declaration:
    );
    code_block(23, "glosso", #string
        \\result := opaque_call(pointer)
        \\    #memory(returns_borrow(arg(0)), reads(arg(0)), noescape(arg(0)));
    );
    paragraph(24, #string,oneline
        \\A call-site contract augments the resolved function contract. It
        \\cannot contradict the declaration's result origin, releaser, or escape
        \\facts.
    );
    subheading(25, "Intentional-leak binding");
    paragraph(26, #string,oneline
        \\Only `leak` may annotate a variable declaration, and the primary
        \\binding form is an uninitialized aggregate owner. This is a local
        \\declaration form; a file-scope global cannot carry it, because the
        \\global parser expects `;`, `=`, `:=`, or `:` after the type.
    );
    code_block(27, "glosso", #string
        \\rooms: [..]Room #memory leak;
        \\state: Game_State #memory leak;
        \\choice: Resource_Union #memory leak;
    );
    paragraph(28, #string,oneline
        \\The accepted owner types are arrays, tuples, structs, and unions, and
        \\the policy also covers owned resources assigned later into nested
        \\fields. This lets a Glosso struct or union intentionally retain
        \\dynamic arrays, C objects, or other resource-bearing aggregates.
    );
    paragraph(29, #string,oneline
        \\To intentionally leak a newly acquired result directly, annotate the
        \\call:
    );
    code_block(30, "glosso", #string,oneline
        \\process_singleton := Process_Create() #memory leak;
    );
    paragraph(31, #string,oneline
        \\The effective call contract must already identify a fresh result and a
        \\known releaser. `#memory leak` cannot turn an unknown pointer into an
        \\owned resource, and says so.
    );
    code_block(32, "text", #string
        \\// o := unannotated() #memory leak;   with no contract on `unannotated`
        \\error: #memory leak requires an owned result with a known releaser
        \\note: add released_by(...) to the acquisition contract or remove #memory leak
    );
    subheading(33, "Overlay statement");
    paragraph(34, #string,oneline
        \\An overlay attaches effects to an existing declaration without editing
        \\it, which is what makes generated bindings usable: regenerating the
        \\binding does not erase the reviewed contract.
    );
    code_block(35, "glosso", #string
        \\#memory Vendor.Image_Load {
        \\    returns_fresh,
        \\    released_by(Vendor.Image_Unload),
        \\}
        \\
        \\#memory Vendor.Image_Unload {
        \\    kills(arg(0)),
        \\    noescape(arg(0)),
        \\}
    );
    paragraph(36, #string,oneline
        \\A top-level overlay augments the target declaration globally in the
        \\current compilation. An overlay inside a block affects subsequent calls
        \\in that lexical scope. The target must resolve uniquely; qualify the
        \\name when namespaces would otherwise be ambiguous. There is currently
        \\no syntax for selecting between true overloads that share a qualified
        \\name.
    );
    code_block(37, "text", #string
        \\// #memory nothing_here { returns_fresh, }
        \\error: #memory overlay names unknown function 'nothing_here'
    );
    subheading(38, "Effect reference");
    paragraph(39, "`returns_fresh` and `returns_fresh(return-place)`");
    bullet(40, "Valid on functions, overlays, and calls.");
    bullet(41, #string,oneline
        \\The bare form says the whole result is a new abstract resource rather
        \\than an alias of an argument or of static storage. The return-place
        \\form makes only the named result or tagged-union payload fresh:
        \\`returned.Ok` selects an anonymous result payload, `x.Ok` the `Ok`
        \\payload of named result `x`.
    );
    bullet(42, #string,oneline
        \\Both forms describe provenance and name no cleanup by themselves.
    );
    paragraph(43, #string,oneline
        \\`returns_borrow(parameter)` and
        \\`returns_borrow(return-place, parameter)`
    );
    bullet(44, "Valid on functions, overlays, and calls.");
    bullet(45, #string,oneline
        \\The bare form says the whole result aliases memory reachable from the
        \\selected argument. The return-place form applies that borrowed origin
        \\only to the selected named result or union payload.
    );
    bullet(46, #string,oneline
        \\Multiple compatible borrowed origins combine into a parameter set.
    );
    paragraph(47, "`returns_static` and `returns_static(return-place)`");
    bullet(48, "Valid on functions, overlays, and calls.");
    bullet(49, #string,oneline
        \\The bare form says all returned memory remains valid for the program
        \\lifetime. The return-place form applies that fact only to the selected
        \\named result or union payload.
    );
    paragraph(50, #string,oneline
        \\`released_by(function)` and `released_by(return-place, function)`
    );
    bullet(51, "Valid on functions, overlays, and calls.");
    bullet(52, #string,oneline
        \\Names the cleanup function for a fresh whole result or selected union
        \\payload, and creates a must-release obligation at each acquisition.
    );
    bullet(53, #string,oneline
        \\On a function or overlay it must be combined with the corresponding
        \\bare or return-place `returns_fresh`; alone it is `error: #memory
        \\released_by requires a fresh returned resource`.
    );
    bullet(54, #string,oneline
        \\At a call site it implies the corresponding `returns_fresh`.
    );
    bullet(55, #string,oneline
        \\The releaser must resolve and accept a memory-capable first parameter.
    );
    paragraph(56, #string,oneline
        \\`resource(released_by: function)` and
        \\`resource(return-place, released_by: function)`
    );
    bullet(57, #string,oneline
        \\Valid only on a call expression; on a declaration it is `error:
        \\#memory resource(...) is only valid on an acquisition expression`.
    );
    bullet(58, #string,oneline
        \\Explicit call-site shorthand for a fresh whole result or return place
        \\released by the named function, equivalent to the corresponding
        \\call-site `released_by` spelling.
    );
    paragraph(59, "`leak`");
    bullet(60, #string,oneline
        \\Valid only on an acquisition call or an owner binding; on a function
        \\it is `error: #memory leak is only valid on an acquisition expression
        \\or variable declaration`.
    );
    bullet(61, #string,oneline
        \\Marks a known release obligation as intentionally undischargeable.
    );
    bullet(62, #string,oneline
        \\Suppresses only the missing-release finding. Use after release, double
        \\release, stale-reference, and contract findings still apply.
    );
    bullet(63, "On a call it requires an effective `released_by(...)` fact.");
    paragraph(64, "`kills(parameter)`");
    bullet(65, "Valid on functions, overlays, and calls.");
    bullet(66, #string,oneline
        \\Says the call releases or permanently invalidates the selected
        \\resource. All aliases then observe Dead, and a later use or another
        \\release is diagnosed.
    );
    paragraph(67, "`invalidates(parameter)`");
    bullet(68, "Valid on functions, overlays, and calls.");
    bullet(69, #string,oneline
        \\Keeps the resource alive but advances its storage generation. The
        \\argument used as the owner is refreshed after the call; values still
        \\observing an older generation become stale.
    );
    bullet(70, #string,oneline
        \\Use it for operations that may relocate backing storage, such as
        \\growth. `array_add` carries this effect, which is why the stale-alias
        \\example below needs no annotation at all.
    );
    paragraph(71, "`noescape(parameter)`");
    bullet(72, "Valid on functions, overlays, and calls.");
    bullet(73, #string,oneline
        \\Promises the callee does not retain the selected argument beyond the
        \\call. This is the effect that lets a local address be passed into an
        \\opaque C boundary without a retention finding.
    );
    paragraph(74, "`escapes(parameter)`");
    bullet(75, "Valid on functions, overlays, and calls.");
    bullet(76, #string,oneline
        \\Says the selected argument may outlive the call through storage, a
        \\callback, a global, or another retained location.
    );
    bullet(77, #string,oneline
        \\Conflicts with `noescape` for the same parameter: `error: #memory
        \\noescape(p) conflicts with escapes(p)`.
    );
    paragraph(78, "`reads(parameter)` and `writes(parameter)`");
    bullet(79, "Valid on functions, overlays, and calls.");
    bullet(80, #string,oneline
        \\Record accesses to reachable memory for interprocedural checking.
    );
    bullet(81, #string,oneline
        \\They imply no ownership transfer, retention, relocation, or release.
    );
    paragraph(82, "`unknown` and `unknown(return-place)`");
    bullet(83, "Valid on functions, overlays, and calls.");
    bullet(84, #string,oneline
        \\Records that the boundary cannot provide a stronger result or lifetime
        \\fact. The return-place form limits that uncertainty to the selected
        \\named result or union payload.
    );
    bullet(85, #string,oneline
        \\For a memory-capable result with no other origin it produces an
        \\Unknown result rather than pretending the value is fresh, borrowed, or
        \\static.
    );
    subheading(86, "Parameter references and memory-capable types");
    paragraph(87, #string,oneline
        \\A parameter effect may use the declared name or `arg(n)`, where
        \\indexing is zero-based. Positional references suit generated bindings
        \\whose parameter names may change:
    );
    code_block(88, "glosso", #string
        \\#memory Vendor.Release {
        \\    kills(arg(0)),
        \\    noescape(arg(0)),
        \\}
    );
    paragraph(89, #string,oneline
        \\The index must be within the target signature and the selected
        \\parameter must be memory-capable. The checker treats pointers,
        \\many-pointers, strings, `any`, arrays, memory-bearing tuples, and
        \\structs or unions conservatively as memory-capable; a scalar is not.
        \\Return-origin effects likewise require a memory-capable result.
    );
    code_block(90, "text", #string
        \\// take :: (n: s64) #foreign "c" "take" #memory(noescape(n));
        \\error: #memory noescape parameter 'n' of 'take' is not memory-capable
        \\
        \\// take :: (p: *u8) #foreign "c" "take" #memory(noescape(arg(3)));
        \\error: #memory noescape names unknown parameter 'arg(3)' of 'take'
        \\
        \\// take :: (p: *u8) #foreign "c" "take" #memory returns_fresh;
        \\error: #memory returns_fresh requires 'take' to return a memory-capable value
        \\
        \\// #memory(returns_fresh, returns_borrow(p))
        \\error: conflicting #memory return origins 'returns_fresh' and 'returns_borrow'
    );
    subheading(91, "Release obligations and unintended leaks");
    paragraph(92, #string,oneline
        \\A must-release obligation is attached to an abstract resource, not to
        \\a variable name. Copies of a pointer, dynamic-array descriptor,
        \\struct, or union may share that resource identity. The named releaser,
        \\or another applicable function whose contract explicitly `kills` the
        \\value, discharges the obligation directly or through `defer`.
    );
    code_block(93, "glosso", #string
        \\object := Object_Create();
        \\defer Object_Destroy(object);
        \\
        \\alias := object; // copy, not move
        \\use(alias);
    );
    paragraph(94, #string,oneline
        \\Defers are analyzed at scope exit in reverse registration order. Every
        \\normal or early return executes the abstract deferred cleanup before
        \\outstanding obligations are reported.
    );
    paragraph(95, "The checker creates obligations in three implemented ways:");
    bullet(96, "A call returns fresh memory and has `released_by(f)`.");
    bullet(97, #string,oneline
        \\A call site supplies `released_by(f)` or `resource(released_by: f)`.
    );
    bullet(98, #string,oneline
        \\`array_add` establishes that a dynamic array owns storage requiring
        \\`array_free`.
    );
    paragraph(99, #string,oneline
        \\If an obligation remains Alive at scope exit, the checker reports that
        \\the resource must be released. If only some paths release it, the
        \\report says it may remain unreleased. A call that neither matches the
        \\named releaser nor has an applicable `kills` contract does not
        \\discharge the obligation.
    );
    subheading(100, "Dynamic arrays");
    paragraph(101, #string,oneline
        \\Dynamic-array ownership is checked without any annotation. The
        \\following program is clean; removing the `defer` produces the warning
        \\underneath it, anchored at the declaration rather than at
        \\`array_add`.
    );
    code_block(102, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    values: [..]s64;
        \\    array_add(*values, 1);
        \\    defer array_free(*values);
        \\    print("%\n", values[0]);
        \\}
    );
    code_block(103, "text", #string
        \\warning: resource must be released by 'array_free' before leaving scope
        \\note: release obligation was created here
    );
    paragraph(104, #string,oneline
        \\The obligation follows arrays stored in local structs and unions:
    );
    code_block(105, "glosso", #string
        \\Bucket :: struct {
        \\    values: [..]s64;
        \\}
        \\
        \\bucket: Bucket;
        \\array_add(*bucket.values, 1);
        \\defer array_free(*bucket.values);
    );
    paragraph(106, #string,oneline
        \\A higher-level aggregate constructor should name its public
        \\deinitializer rather than expose an implementation field's
        \\`array_free` requirement:
    );
    code_block(107, "glosso", #string
        \\bucket_make :: () -> Bucket
        \\    #memory(returns_fresh, released_by(bucket_free)) {
        \\    bucket: Bucket;
        \\    array_add(*bucket.values, 1);
        \\    return bucket;
        \\}
        \\
        \\bucket_free :: (bucket: *Bucket)
        \\    #memory(kills(bucket), noescape(bucket)) {
        \\    array_free(*bucket.*.values);
        \\}
    );
    paragraph(108, #string,oneline
        \\The analyzer tracks owned member paths separately. Releasing one
        \\dynamic-array field does not release sibling fields or the aggregate
        \\descriptor. A deinitializer that releases parameter members discharges
        \\the corresponding member obligations at its callers.
    );
    subheading(109, "C libraries");
    paragraph(110, #string,oneline
        \\Foreign code has no body from which ownership can be inferred.
        \\Annotate both the acquisition and the release boundary:
    );
    code_block(111, "glosso", #string
        \\C_Object_Create :: () -> *C_Object
        \\    #foreign "clib" "c_object_create"
        \\    #memory(returns_fresh, released_by(C_Object_Destroy));
        \\
        \\C_Object_Destroy :: (object: *C_Object)
        \\    #foreign "clib" "c_object_destroy"
        \\    #memory(kills(object), noescape(object));
    );
    paragraph(112, "Then ordinary use is checked:");
    code_block(113, "glosso", #string
        \\normal :: () {
        \\    object := C_Object_Create();
        \\    defer C_Object_Destroy(object);
        \\}
        \\
        \\process_lifetime_singleton :: () {
        \\    object := C_Object_Create() #memory leak;
        \\}
    );
    paragraph(114, #string,oneline
        \\Getting it wrong produces the findings below, each with a note
        \\pointing at the release that made the state Dead and another at the
        \\origin of the resource.
    );
    code_block(115, "text", #string
        \\// destroy(o); use(o);
        \\warning: use after release while reading memory
        \\note: resource was released here
        \\note: resource originated here
        \\
        \\// destroy(o); destroy(o);
        \\warning: double release of resource
        \\note: first release occurred here
    );
    paragraph(116, #string,oneline
        \\For generated declarations, prefer a top-level companion overlay so
        \\that regeneration does not erase reviewed contracts. Use call-site
        \\`resource(released_by: ...)` only as a local fallback.
    );
    subheading(117, "Struct and union leak policy");
    paragraph(118, #string,oneline
        \\An aggregate leak binding marks current and later owned descendants as
        \\intentional:
    );
    code_block(119, "glosso", #string
        \\Registry :: struct {
        \\    objects: [..]*C_Object;
        \\    cache: [..]u8;
        \\}
        \\
        \\registry: Registry #memory leak;
        \\array_add(*registry.cache, 0);
        \\registry.objects = load_process_lifetime_objects();
    );
    paragraph(120, #string,oneline
        \\The same rule applies to unions. A return-place contract tracks an
        \\obligation only while its tagged alternative is active, including
        \\through exhaustive switches, payload extraction, and postfix `?`, so
        \\an `Err` path produces no false missing-release finding for
        \\`returned.Ok`. Named multiple results are tracked positionally when a
        \\call is destructured, so facts for `x.Ok` cannot leak into the binding
        \\for `y`. `#memory leak` remains a policy for the whole annotated
        \\owner, including nested Glosso structs or unions reached through its
        \\fields.
    );
    subheading(121, "Aliases, generations, and control flow");
    paragraph(122, #string,oneline
        \\Tracked resources have the states Alive, MaybeDead, and Dead. If one
        \\branch releases a resource and another keeps it alive, the joined
        \\state is MaybeDead and a later use reports a conditional finding. An
        \\inactive tagged-union payload is absent rather than alive.
    );
    paragraph(123, #string,oneline
        \\Invalidation increments a generation instead of killing the resource.
        \\The program below is a complete demonstration: `array_add` may
        \\reallocate, so the copy taken before it observes an older generation.
        \\It still runs and prints `1 0`, because this is a warning about a
        \\stale view, not a memory error the runtime detects.
    );
    code_block(124, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    values: [..]s64;
        \\    defer array_free(*values);
        \\    alias := values;
        \\    array_add(*values, 1);
        \\    print("% %\n", values.count, alias.count);
        \\}
    );
    code_block(125, "text", #string
        \\warning: stale reference used after storage invalidation
        \\note: resource originated here
        \\note: storage was invalidated here
        \\
        \\$ ./stale.exe
        \\1 0
    );
    paragraph(126, #string,oneline
        \\Loops join their entry state with an analyzed iteration. Branch and
        \\loop joins preserve owner refreshes while retaining stale generations
        \\on independent aliases.
    );
    subheading(127, "Inference and composition");
    paragraph(128, #string,oneline
        \\Regular function bodies are analyzed symbolically. Effects on
        \\parameters and returned values become an interprocedural summary, so
        \\wrappers inherit effects from their callees. Summaries are recomputed
        \\to a fixed point, which is what lets recursive and mutually recursive
        \\call graphs stabilize.
    );
    paragraph(129, #string,oneline
        \\Explicit function effects seed the summary and document a public
        \\guarantee; they do not hide inferred behavior. Compatible inferred
        \\facts are merged, and contradictions such as a body retaining a
        \\parameter declared `noescape` are diagnosed.
    );
    paragraph(130, #string,oneline
        \\Top-level overlays augment a declaration before body analysis. Lexical
        \\overlays augment calls after the overlay statement in that scope.
        \\Call-site facts merge last for that call. No layer may silently weaken
        \\a known result origin, releaser, or escape fact.
    );
    subheading(131, "Contract validation");
    paragraph(132, #string,oneline
        \\The following are compile-time contract errors in every borrow-check
        \\mode, because they are checked while the contract is read rather than
        \\by the dataflow pass:
    );
    bullet(133, #string,oneline
        \\Unknown effects, empty effect lists, missing punctuation, or arguments
        \\on parameterless effects.
    );
    bullet(134, "An unknown or out-of-range parameter reference.");
    bullet(135, "A parameter effect applied to a non-memory-capable scalar.");
    bullet(136, "A return-origin effect on a void or scalar result.");
    bullet(137, "Conflicting fresh, borrowed, or static return origins.");
    bullet(138, "`noescape(p)` combined with `escapes(p)`.");
    bullet(139, #string,oneline
        \\`released_by(f)` without a fresh result on a function or overlay.
    );
    bullet(140, "An unknown, ambiguous, or incompatible releaser.");
    bullet(141, "`resource(...)` on anything other than a call.");
    bullet(142, "`leak` on a function or overlay.");
    bullet(143, #string,oneline
        \\A call-site contract that conflicts with its resolved declaration.
    );
    bullet(144, "A call-site `leak` without a known releaser.");
    bullet(145, "Any variable effect except one non-duplicated `leak`.");
    bullet(146, "`leak` on an uninitialized scalar or pointer binding.");
    bullet(147, "An overlay with an unknown or ambiguous target.");
    code_block(148, "text", #string
        \\$ glosso conflict.glo --borrow-check off
        \\error: #memory noescape(p) conflicts with escapes(p)
    );
    subheading(149, "Diagnostics and checker modes");
    paragraph(150, #string,oneline
        \\`--borrow-check warning` is the default: findings are rendered as
        \\warnings and compilation continues. `--borrow-check error` promotes
        \\the same findings to errors, so the build stops. `--borrow-check off`
        \\skips the temporal dataflow entirely after validating every contract,
        \\which is why the example above still fails under `off`.
    );
    paragraph(151, "The analyzer can report:");
    bullet(152, "use after release and possible use after release;");
    bullet(153, "double release and possible double release;");
    bullet(154, "release through a stale reference;");
    bullet(155, "stale alias use after invalidation;");
    bullet(156, "missing or path-conditional release;");
    bullet(157, "incompatible releaser calls;");
    bullet(158, "returning or storing pointers to local storage;");
    bullet(159, "local-pointer retention through an opaque foreign call;");
    bullet(160, "unknown lifetime for an opaque memory-bearing result; and");
    bullet(161, "explicit-contract contradictions.");
    code_block(162, "text", #string
        \\// bad :: () -> *s64 { x : s64 = 5; return *x; }
        \\warning: pointer to local storage escapes through return
        \\note: local storage was created here
        \\
        \\// a function whose contract makes only one branch release the result
        \\warning: resource in 'returned.Ok' may not be released by 'close_it' on every path
        \\note: release obligation was created here
    );
    paragraph(163, #string,oneline
        \\Diagnostics point at the failing operation and, when available, at the
        \\resource origin, the invalidation, the first release, or the site that
        \\created the obligation.
    );
    subheading(164, "Recommended contract patterns");
    paragraph(165, "Fresh C object:");
    code_block(166, "glosso", #string
        \\make :: () -> *T
        \\    #foreign "c" "make"
        \\    #memory(returns_fresh, released_by(free));
        \\
        \\free :: (value: *T)
        \\    #foreign "c" "free"
        \\    #memory(kills(value), noescape(value));
    );
    paragraph(167, "Borrowed view:");
    code_block(168, "glosso", #string
        \\view :: (buffer: []u8) -> []u8
        \\    #memory(returns_borrow(buffer), reads(buffer), noescape(buffer)) {
        \\    return buffer;
        \\}
    );
    paragraph(169, "Relocating mutation:");
    code_block(170, "glosso", #string
        \\reserve :: (buffer: *Buffer, capacity: s64)
        \\    #foreign "bufferlib" "reserve"
        \\    #memory(invalidates(buffer), writes(buffer), noescape(buffer));
    );
    paragraph(171, "Retaining callback data:");
    code_block(172, "glosso", #string
        \\register :: (data: *void)
        \\    #foreign "c" "register"
        \\    #memory(escapes(data));
    );
    paragraph(173, "Unspecified foreign boundary:");
    code_block(174, "glosso", #string
        \\opaque :: (data: *void) -> *void
        \\    #foreign "c" "opaque"
        \\    #memory unknown;
    );
    subheading(175, "Trust model and limits");
    paragraph(176, #string,oneline
        \\For regular Glosso bodies, inference checks much of an explicit
        \\promise. For opaque foreign code a `#memory` contract is trusted like
        \\the foreign signature itself, so an incorrect FFI contract can hide a
        \\bug rather than reveal one.
    );
    paragraph(177, #string,oneline
        \\This checker is not a proof of memory safety or leak freedom.
        \\Untracked allocator APIs create no obligations. Integer-pointer casts,
        \\arbitrary pointer arithmetic, type punning, concurrency, and
        \\path-dependent foreign ownership may become Unknown or stay outside
        \\the model. Add precise contracts at stable boundaries, and use runtime
        \\allocators or the sanitizers when stronger coverage is required.
    );
}

render_section_8 :: () {
    paragraph(0, #string,oneline
        \\A compiled program starts at the top-level, zero-parameter `main`. It
        \\may omit its result type, or return a type that implements the prelude
        \\`Termination` typeclass. Command-line arguments are read with
        \\`get_cmdline_args()`, never through parameters.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    print("Hello, World!\n");
        \\}
    );
    code_block(2, "text", #string
        \\// main :: (argc: s32) { ... }
        \\error: main must not take parameters; use get_cmdline_args() for command-line arguments
    );
    paragraph(3, #string,oneline
        \\`get_cmdline_args()` returns a borrowed `[]string`. Element 0 is the
        \\executable as the runtime platform constructed it, so a program with
        \\no arguments still sees a count of 1.
    );
    code_block(4, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    args := get_cmdline_args();
        \\    if args.count < 2 {
        \\        print("usage: % <input>\n", args[0]);
        \\        exit(2);
        \\    }
        \\    print("input: %\n", args[1]);
        \\}
    );
    paragraph(5, #string,oneline
        \\`exit` is marked `#noreturn`, so the compiler treats code after a
        \\guaranteed `exit` as unreachable and the process status is the value
        \\passed to it. In the program above, running with no argument prints
        \\the usage line and exits with status 2.
    );
    subheading(6, "Termination and process status");
    paragraph(7, #string,oneline
        \\A `main` with no result type produces status 0 when execution reaches
        \\the end. Any other result type must have a `Termination` instance; the
        \\runtime passes the returned value to `termination_status` and uses the
        \\`s32` it produces. The check happens at the entry point, so the
        \\diagnostic names the return type rather than a call.
    );
    table_header(8, "Entry signature   —   Normal process status");
    table_row(9, "`main :: ()`   |   0 when execution reaches the end");
    table_row(10, #string,oneline
        \\`main :: () -> I` where `Is_Integer(I)`   |   The returned integer
        \\cast to `s32`, then subjected to the host's exit-code rules
    );
    table_row(11, #string,oneline
        \\`main :: () -> Result(void, E)` where `Error(E)`   |   0 for `Ok`;
        \\`report_error` then status 1 for `Err`
    );
    table_row(12, #string,oneline
        \\`main :: () -> T` where `Termination(T)`   |   The `s32` produced by
        \\`termination_status`
    );
    code_block(13, "text", #string
        \\// main :: () -> string { return "no"; }
        \\error: main return type string does not implement Termination
        \\
        \\// Result(void, E) where E has no Error instance
        \\error: main return type Result_void_E does not implement Termination
    );
    subheading(14, "Returning an integer status");
    code_block(15, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () -> int {
        \\    print("bye\n");
        \\    return 3;
        \\}
    );
    code_block(16, "text", #string
        \\$ ./status.exe; echo $?
        \\bye
        \\3
    );
    note(17, #string,oneline
        \\The integer instance is a plain `cast(s32)value`, so it truncates
        \\rather than clamps, and every integer width therefore satisfies
        \\`Termination` including `u8` and the 128-bit types. `main :: () -> u8
        \\{ return 200; }` exits with status 200 on
        \\`x86_64-pc-windows-msvc`; what a host does with a value outside its
        \\own status range is the host's rule, not Glosso's.
    );
    subheading(18, "Propagating a typed error");
    paragraph(19, #string,oneline
        \\The prelude declares one instance, `Result(void, $E) :: instance
        \\Termination where Error(E)`. Its `termination_status` returns 0 for
        \\`Ok` and, for `Err`, calls the error type's own `report_error` before
        \\returning 1. That is what makes `?` usable directly in an entry point:
        \\the error stays fully typed while it propagates and is rendered only
        \\at the process boundary.
    );
    code_block(20, "glosso", #string
        \\#import "Io";
        \\#import "File_System";
        \\
        \\main :: () -> Result(void, Fs_Error) {
        \\    file := open_read("missing.txt")?;
        \\    _ := close(*file)?;
        \\    print("read it\n");
        \\}
    );
    code_block(21, "text", #string
        \\$ ./readfile.exe; echo $?
        \\filesystem error: path was not found: missing.txt
        \\1
    );
    note(22, #string,oneline
        \\Falling through the end of a `Result(void, E)` entry point is the
        \\successful `void` result and becomes `Ok`, so no `return .Ok()` is
        \\needed. The error type must have an `Error` instance; without one, the
        \\`Termination` instance does not apply and `main` is rejected.
    );
    subheading(23, "Defining an application-specific status");
    paragraph(24, #string,oneline
        \\Implementing `Termination` is enough to make any type a valid entry
        \\result. The instance head repeats the type name, which is the ordinary
        \\instance syntax and not a redeclaration of the struct.
    );
    code_block(25, "glosso", #string
        \\Exit_Status :: struct { code: s32; }
        \\
        \\Exit_Status :: instance Termination {
        \\    termination_status :: (value: Exit_Status) -> s32 {
        \\        return value.code;
        \\    }
        \\}
        \\
        \\main :: () -> Exit_Status {
        \\    return .{ .code = 9 };
        \\}
    );
    code_block(26, "text", #string
        \\$ ./custom.exe; echo $?
        \\9
        \\
        \\// the same struct with the instance removed
        \\error: main return type Exit_Status does not implement Termination
    );
    note(27, #string,oneline
        \\The prelude and the ordinary implicit context are available in `main`
        \\unless the declaration is deliberately changed to a no-context or
        \\C-ABI form. On a freestanding target the entry point is instead a
        \\`#c_call` procedure exported as `glo_main`, and `--no-main` drops the
        \\requirement for a `main` entirely; see Bare-Metal and Freestanding
        \\Targets.
    );
}

render_section_9 :: () {
    paragraph(0, #string,oneline
        \\Line comments start at `//` and continue to the end of the line. Block
        \\comments start with `/*`, end with `*/`, and nest, so commenting out a
        \\region that already contains block comments stays well formed.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\// A line comment.
        \\
        \\/*
        \\    A block comment.
        \\    /* A nested block comment. */
        \\*/
        \\
        \\main :: () { print("ok\n"); } // trailing
    );
    paragraph(2, #string,oneline
        \\Comments are lexical whitespace. The lexer discards them, so they
        \\never create declarations, never attach metadata to the following
        \\symbol, and never carry documentation the compiler reads. A directive
        \\written inside a comment is inert; keep required build, memory, and
        \\calling-convention directives in code where the compiler can validate
        \\them.
    );
    subheading(3, "The unterminated block comment");
    paragraph(4, #string,oneline
        \\Nesting is tracked by a depth counter with no recovery at end of file,
        \\so an unclosed `/*` silently swallows the rest of the file rather than
        \\producing a lexical error. Nothing after it is parsed, and the failure
        \\appears much later as a missing declaration. The example below is the
        \\link failure that results when the comment eats `main`.
    );
    code_block(5, "glosso", #string
        \\#import "Io";
        \\/* never closed
        \\main :: () { print("ok\n"); }
    );
    code_block(6, "text", #string
        \\error: rust-lld: error: could not open 'pthread.lib': no such file or directory
    );
    note(7, #string,oneline
        \\The same text placed after `main` compiles cleanly, which is what
        \\makes the mistake hard to spot: whether an unterminated comment is
        \\fatal depends only on how much source follows it. When a file stops
        \\seeing declarations it obviously contains, search for an unbalanced
        \\`/*` above them.
    );
    bullet(8, #string,oneline
        \\Use `//` for short local intent and `/* ... */` for multi-line prose
        \\or temporary exclusion of a region.
    );
    bullet(9, #string,oneline
        \\Explain invariants and surprising decisions rather than restating the
        \\syntax on the next line.
    );
}

render_section_10 :: () {
    paragraph(0, #string,oneline
        \\Identifiers are Unicode-aware. The first character is `_` or
        \\alphabetic and later characters may also be numeric, so `λα` is an
        \\ordinary name. Keywords cannot be used as plain identifiers.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\ordinary_name := 1;
        \\_compiler_visible := 2;
        \\λα :: 3;
        \\
        \\main :: () { print("%\n", λα); }
    );
    code_block(2, "text", #string
        \\// struct := 1;
        \\error: unexpected token 'struct'
    );
    paragraph(3, #string,oneline
        \\There is no separate identifier lexer rule for a leading digit,
        \\because the number lexer wins: `1abc := 1;` is read as the integer `1`
        \\followed by a declaration of `abc`, and the file compiles. Verify a
        \\suspicious spelling by naming the value later rather than by assuming
        \\the lexer rejected it.
    );
    subheading(4, "Qualification");
    paragraph(5, #string,oneline
        \\Qualified names use dot syntax through an import alias. What an alias
        \\can reach depends on how the unit arrived: through `#load` it
        \\qualifies functions, constants, and types alike, while an aliased
        \\`#import` of a standard module currently resolves only functions.
        \\Source Files, Imports, and Loads shows both.
    );
    code_block(6, "glosso", #string
        \\#import "Io";
        \\L :: #load "local_helpers.glo";
        \\
        \\main :: () {
        \\    p: L.Point;
        \\    print("% % %\n", L.helper(), L.LIMIT, p.x);
        \\}
    );
    subheading(7, "Backtick names in generated code");
    paragraph(8, #string,oneline
        \\A backtick identifier asks a macro-like facility to resolve the name
        \\in the insertion environment instead of where the code value was
        \\created. It is the deliberate escape from hygiene, so it belongs only
        \\in `#code`, `#expand`, and generated fragments that intend to capture
        \\a caller-side binding.
    );
    code_block(9, "glosso", #string
        \\make_counter :: () #expand {
        \\    #insert #code {
        \\        `counter := 0;
        \\        counter += 1;
        \\    };
        \\}
    );
    bullet(10, #string,oneline
        \\Use module qualification when two imports expose the same spelling, or
        \\when ownership matters to the reader.
    );
    bullet(11, #string,oneline
        \\Keep ordinary names stable across generated and handwritten code;
        \\qualification is safer than relying on incidental import order.
    );
    bullet(12, #string,oneline
        \\A leading `__` communicates implementation-only intent by convention
        \\and does not make a declaration private. Use a private section when
        \\the compiler must enforce the boundary.
    );
}
render_section_11 :: () {
    paragraph(0, #string,oneline
        \\Decimal integer literals use digits and may contain underscores
        \\between digits. Based integers use `base#digits`, where the base is
        \\from 2 through 36 and alphabetic digits are case-insensitive. The `0x`
        \\and `0b` prefixes are not part of Glosso syntax.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    decimal := 1_032_000;
        \\    five := 2#101;
        \\    packed := 16#4865_316F_774F_6C64;
        \\    max_digit := 36#Z;
        \\    print("% % % %\n", decimal, five, packed, max_digit);
        \\}
    );
    code_block(2, "text", #string
        \\1032000 5 5216630098191412324 35
    );
    subheading(3, "Base and digit validation");
    paragraph(4, #string,oneline
        \\The base and the digits are checked in the lexer, so these errors fire
        \\before the literal has a type and regardless of where it appears.
        \\Underscores are grouping only; they never change a value and may
        \\appear in either part of a based literal.
    );
    code_block(5, "text", #string
        \\// x := 1#0;
        \\error: integer literal base must be between 2 and 36, got 1
        \\
        \\// x := 37#10;
        \\error: integer literal base must be between 2 and 36, got 37
        \\
        \\// x := 16#Z;
        \\error: digit 'Z' is not valid for base 16
    );
    subheading(6, "The value is fitted, not checked");
    paragraph(7, #string,oneline
        \\A literal's magnitude is accumulated at up to 128 bits and is then
        \\truncated or reinterpreted to fit the destination type. There is no
        \\range check against the destination and no diagnostic: `u8 = 300` is
        \\44, `s16 = 70_000` is 4464, and the largest `u128` magnitude written
        \\into an `s128` is -1. Selecting a width is therefore a decision about
        \\what the program means, not a request for validation.
    );
    code_block(8, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    a : u8  = 300;
        \\    b : s16 = 70_000;
        \\    c : s128 = 340_282_366_920_938_463_463_374_607_431_768_211_455;
        \\    print("% % %\n", a, b, c);
        \\}
    );
    code_block(9, "text", "44 4464 -1");
    paragraph(10, #string,oneline
        \\The single enforced limit is the 128-bit magnitude cap. It is a
        \\lexical rule, so it applies in every base, and the two spellings
        \\produce two different messages: the decimal form quotes the digits
        \\while the based form names the base. The 128-Bit Integers chapter
        \\covers what fits inside that cap.
    );
    code_block(11, "text", #string
        \\// x : u128 = 340_282_366_920_938_463_463_374_607_431_768_211_456;
        \\error: integer literal '340282366920938463463374607431768211456' does not fit in 128 bits
        \\
        \\// x : u128 = 16#1_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff;
        \\error: base-16 integer literal does not fit in 128 bits
    );
    subheading(12, "The type of an unannotated literal");
    paragraph(13, #string,oneline
        \\Without an annotation, the literal's own magnitude picks the type. A
        \\magnitude that fits in 64 bits keeps the default `int` and is stored
        \\as a wrapped 64-bit payload; a magnitude that does not fit becomes
        \\`s128`. The boundary is the trap, because a 64-bit-wide bit pattern is
        \\an `int` holding a negative value, and widening a signed source
        \\sign-extends.
    );
    code_block(14, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    print("%\n", type_name(type_of(255)));
        \\    print("%\n", type_name(type_of(18_446_744_073_709_551_615)));
        \\    print("%\n", type_name(type_of(18_446_744_073_709_551_616)));
        \\    print("%\n", type_name(type_of(16#1_0000_0000_0000_0000)));
        \\    wrong : u128 = 18_446_744_073_709_551_615;
        \\    print("%\n", wrong);
        \\}
    );
    code_block(15, "text", #string
        \\int
        \\int
        \\s128
        \\s128
        \\340282366920938463463374607431768211455
    );
    note(16, #string,oneline
        \\Writing the largest 64-bit unsigned value into a `u128` initializer
        \\therefore yields 2^128-1 with no diagnostic. Name the limit instead:
        \\`cast(u128)U64_MAX` from `Math/Constants` gives
        \\18446744073709551615.
    );
    subheading(17, "There are no literal suffixes");
    paragraph(18, #string,oneline
        \\Glosso has no `255u8`, `1u128`, or `1_u128` form. Width and signedness
        \\come from an annotation, a `cast`, or the type of the other operand. A
        \\suffix is not a lexical error, because the number token ends at the
        \\digits and the trailing letters are parsed as a separate type name, so
        \\the message that follows does not name the real problem.
    );
    code_block(19, "text", #string
        \\// x := 255u8;
        \\error: type value used as a statement
        \\
        \\// c := 255u8 +% 1u8;
        \\error: no operator '+%' for type, int
    );
    subheading(20, "A minus sign is an operation");
    paragraph(21, #string,oneline
        \\Negation is not part of the literal. `-9_223_372_036_854_775_808` is a
        \\negation applied to a positive magnitude that is one past `S64_MAX`,
        \\so at `-O0` and `-O1` it is a checked operation that overflows and
        \\aborts the process. The declaration compiles; nothing is printed after
        \\it and the exit status is 134. At `-O2` and `-O3` the check is gone
        \\and the same source produces the intended value, so this is a program
        \\that works optimized and dies unoptimized.
    );
    code_block(22, "glosso", #string
        \\#import "Io";
        \\#import "Math/Constants";
        \\
        \\MY_MIN : s64 : -9_223_372_036_854_775_808;
        \\
        \\main :: () {
        \\    ok1 : s64 = S64_MIN;
        \\    ok2 : s64 = MY_MIN;
        \\    ok3 : s64 = -%9_223_372_036_854_775_808;
        \\    print("% % %\n", ok1, ok2, ok3);
        \\
        \\    // aborts at -O0 and -O1:
        \\    // bad : s64 = -9_223_372_036_854_775_808;
        \\}
    );
    code_block(23, "text", #string
        \\-9223372036854775808 -9223372036854775808 -9223372036854775808
        \\
        \\$ ./bad.exe          # with the commented line restored, -O1
        \\before
        \\(exit status 134, no message)
    );
    paragraph(24, #string,oneline
        \\A `::` or typed `:` constant is folded by the compile-time evaluator
        \\instead, which wraps rather than traps, so `MY_MIN` above is legal.
        \\The three portable spellings for a most-negative value are the limit
        \\constant from `Math/Constants`, a constant declaration, and the
        \\wrapping negation `-%`. Numeric Operations states the general trap
        \\rule; 128-Bit Integers repeats it at the widest type.
    );
}

render_section_12 :: () {
    paragraph(0, #string,oneline
        \\Floating-point literals use a decimal fraction, an `e` or `E`
        \\exponent, or both. The exponent may carry a leading plus or minus
        \\sign, and both the significand and the exponent may contain
        \\underscores. There is no based form: `base#digits` is integer syntax
        \\only.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    pi := 3.141_592;
        \\    milli := 1e-3;
        \\    large := 2E+10;
        \\    print("% % %\n", pi, milli, large);
        \\    print("%\n", type_name(type_of(1.5)));
        \\    narrow : f32 = 0.1;
        \\    print("%\n", narrow);
        \\}
    );
    code_block(2, "text", #string
        \\3.141592 0.001 20000000000
        \\f64
        \\0.1
    );
    code_block(3, "text", #string
        \\// x := 16#1.8;
        \\error: member of non-struct
        \\
        \\// x : s32 = 1.5;
        \\error: got f64, expected s32
    );
    subheading(4, "Typing and precision");
    paragraph(5, #string,oneline
        \\An unannotated floating literal is `f64`. Conversion to the selected
        \\floating type happens at compile time, which is where the decimal text
        \\acquires the binary rounding it will keep for the rest of the program.
        \\Unlike an integer literal, a float has no implicit conversion into an
        \\integer type: the checker reports the type mismatch rather than
        \\truncating, so a deliberate truncation needs a `cast`.
    );
    paragraph(6, #string,oneline
        \\Rounding is why equality on computed floats is a bug rather than a
        \\style question. The sum below prints as `0.3` and is not equal to the
        \\literal `0.3`, because printing rounds and comparison does not.
    );
    code_block(7, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    print("%\n", 0.1 + 0.2);
        \\    print("%\n", 0.1 + 0.2 == 0.3);
        \\}
    );
    code_block(8, "text", #string
        \\0.3
        \\0
    );
    subheading(9, "Printing large magnitudes");
    paragraph(10, #string,oneline
        \\The `Show` instance for a floating value renders exactly only while
        \\the magnitude stays below about 2^64. Beyond that it saturates and
        \\prints 9223372036854775809 whatever the real value is, for `f32` and
        \\`f64` alike. A large constant is still stored and computed correctly;
        \\only its rendering is wrong, so do not read a printed value as
        \\evidence about a large float.
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    print("1e18 = %\n", 1.0e18);
        \\    print("1e19 = %\n", 1.0e19);
        \\    print("1e20 = %\n", 1.0e20);
        \\    print("avogadro = %\n", 6.022_140_76e23);
        \\}
    );
    code_block(12, "text", #string
        \\1e18 = 1000000000000000000
        \\1e19 = 10000000000000000000
        \\1e20 = 9223372036854775809
        \\avogadro = 9223372036854775809
    );
    bullet(13, #string,oneline
        \\Annotate `f32`, `f64`, or a wider type at API and storage boundaries;
        \\an unannotated literal in a generic call binds the parameter to `f64`.
    );
    bullet(14, #string,oneline
        \\Underscores may group digits in the significand or the exponent, so
        \\`1_000.000_1e1_0` is legal. Group by decimal scale, not arbitrarily.
    );
    bullet(15, #string,oneline
        \\Compare with a tolerance, or compare the exact integers the domain
        \\actually uses, rather than testing computed floats for equality.
    );
}

render_section_13 :: () {
    paragraph(0, #string,oneline
        \\Strings are double quoted and store UTF-8 bytes. The supported
        \\C-style escapes are `\a`, `\b`, `\f`, `\n`, `\r`, `\t`, `\v`, `\0`,
        \\`\\`, `\"`, `\'`, `\?`, and two-digit hexadecimal `\xNN`. For any
        \\other escaped character the backslash is discarded and the character
        \\is kept, so `"\q"` is one byte, `q`.
    );
    code_block(1, "glosso", #string
        \\hello := "hello\n";
        \\quote := "\"quoted\"";
        \\zero_byte := "a\0b";       // three bytes; the string keeps a length
        \\literal_q := "\q";         // one byte: 113
    );
    note(2, #string,oneline
        \\`\%` is the one escape that survives as two bytes, 92 and 37, because
        \\the formatting library assigns meaning to percent escapes and must see
        \\the backslash. A string is a pointer and a length, so an embedded `\0`
        \\does not terminate it; only `cstring` conversion cares.
    );
    subheading(3, "String blocks");
    paragraph(4, #string,oneline
        \\`#string` introduces one or more raw lines, each marked by a leading
        \\`\\`, and ends at the first line that does not begin with the marker.
        \\Apart from removing each marker it interprets nothing: `\t` stays a
        \\backslash and a `t`. The line bodies are joined with a newline, with
        \\no separator added after the last one.
    );
    code_block(5, "glosso", #string
        \\plain :: #string
        \\\\one
        \\\\two
        \\;
        \\// plain is "one\ntwo", 7 bytes
    );
    paragraph(6, #string,oneline
        \\Two modifiers change that. `oneline` joins the bodies with a single
        \\space instead of a newline, which lets a long logical line wrap
        \\readably in source. `escape` applies the same C-style escape decoding
        \\as a quoted string. They combine in either order.
    );
    code_block(7, "glosso", #string
        \\query :: #string,oneline
        \\\\SELECT name, email
        \\\\FROM users WHERE active = 1
        \\;
        \\// "SELECT name, email FROM users WHERE active = 1"
        \\
        \\escaped :: #string,escape
        \\\\first\tcolumn
        \\\\second line
        \\;
        \\// "first<TAB>column\nsecond line"
        \\
        \\both :: #string,oneline,escape
        \\\\a\tb
        \\\\c
        \\;
        \\// "a<TAB>b c"
    );
    paragraph(8, #string,oneline
        \\Nothing is stripped from a body, so a continuation must begin
        \\immediately after the marker; leading spaces there become part of the
        \\text. The modifier list is validated at the directive, and both
        \\mistakes have their own message.
    );
    code_block(9, "text", #string
        \\// #string,oneline,oneline
        \\error: duplicate #string modifier 'oneline'
        \\
        \\// #string,raw
        \\error: unknown #string modifier 'raw'; expected 'oneline' or 'escape'
    );
    note(10, #string,oneline
        \\The marker strips the line feed but not a carriage return, so in a
        \\CRLF source file every `#string` body ends with a stray CR and the
        \\joined result is longer than it looks. Keep `.glo` sources LF-only, or
        \\expect `"alpha beta"` written across two lines to measure 24 bytes
        \\instead of 22.
    );
    subheading(11, "Encoding, length, and storage");
    paragraph(12, #string,oneline
        \\A string literal is encoded text, not an array of Unicode characters.
        \\Byte length, scalar count, and displayed width are three different
        \\measurements; indexing and slicing operate on bytes, so cutting at an
        \\arbitrary position can split a UTF-8 sequence. Use the `Strings/Utf8`
        \\and `Unicode` operations when traversing human text, and reach for
        \\`cstring` or `cstring16` only at APIs that require terminator-based
        \\strings.
    );
    code_block(13, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    s := "가나";
        \\    print("bytes %\n", s.count);   // 6
        \\}
    );
}

render_section_14 :: () {
    paragraph(0, #string,oneline
        \\`#char "x"` lexes exactly one Unicode scalar or one supported escape
        \\from a string spelling and produces an integer character value. It
        \\carries no encoding or length information, so it is a number, not a
        \\one-character string.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\newline :: #char "\n";
        \\
        \\main :: () {
        \\    ascii_byte: u8 = #char "A";
        \\    signed_ascii: s8 = #char "|";
        \\    rune: u32 = #char "가";
        \\    print("% % % %\n", ascii_byte, signed_ascii, rune, newline);
        \\}
    );
    code_block(2, "text", "65 124 44032 10");
    subheading(3, "Which types a character value may take");
    paragraph(4, #string,oneline
        \\The permitted destination types depend on whether the scalar is ASCII,
        \\and the rule is enforced against the expected type rather than against
        \\the value. An ASCII `#char` may infer as `u8`, `s8`, or `u32`; a
        \\non-ASCII one may infer only as `u32`. Any other integer type is
        \\rejected even when the value would obviously fit.
    );
    code_block(5, "text", #string
        \\// x : s32 = #char "A";
        \\error: ASCII #char literal can infer only as u8, s8, or u32, not s32
        \\
        \\// x : u8 = #char "가";
        \\error: non-ASCII #char literal can infer only as u32, not u8
        \\
        \\// x : u8 = #char "AB";
        \\error: #char string literal contains more than two characters
    );
    paragraph(6, #string,oneline
        \\The common use is byte comparison against string storage, where the
        \\element type is `u8` and the constant should be too.
    );
    code_block(7, "glosso", #string
        \\slash :: #char "/";
        \\
        \\last_segment :: (path: string) -> string {
        \\    i := path.count - 1;
        \\    while i >= 0 {
        \\        if path[i] == slash return path[i + 1 .. path.count];
        \\        i -= 1;
        \\    }
        \\    return path;
        \\}
    );
    bullet(8, #string,oneline
        \\A user-perceived character can span several Unicode scalars, so
        \\`#char` is not a grapheme-cluster literal. Comparing it against
        \\arbitrary displayed text is wrong for combining marks and emoji
        \\sequences.
    );
    bullet(9, #string,oneline
        \\Convert through the UTF facilities when appending a character value to
        \\encoded text; writing a `u32` into a byte buffer truncates the scalar.
    );
}

render_section_15 :: () {
    paragraph(0, #string,oneline
        \\A label literal starts with a single quote and has no closing quote.
        \\Labels are symbolic values consumed mainly by `std/Jump`, where a
        \\label names a code address rather than data.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    a := 'done;
        \\    b := 'other;
        \\    c : label = 'done;
        \\    print("% % %\n", type_name(type_of(a)), type_name(type_of(b)),
        \\          type_name(type_of(c)));
        \\}
    );
    code_block(2, "text", "done other label");
    paragraph(3, #string,oneline
        \\An unannotated label literal has its own singleton type, named after
        \\the label itself, and only an annotation widens it to the general
        \\`label` type. That is what lets a jump target be checked statically.
        \\`label` has no `Show` instance, so a label cannot be printed:
        \\`print("%\n", a)` is `error: variadic arg type `label` does not
        \\implement `Show` in call `print``.
    );
    subheading(4, "`#undefined`");
    paragraph(5, #string,oneline
        \\`#undefined` is contextually typed uninitialized storage. It belongs
        \\in a declaration, field, argument, or return whose surrounding
        \\construct supplies a concrete expected type; reading it before a write
        \\is a program error that the directive does not make safe.
    );
    code_block(6, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    x : s64 = #undefined;
        \\    x = 5;
        \\    print("%\n", x);
        \\}
    );
    paragraph(7, #string,oneline
        \\There is no diagnostic for the annotation-free form. `x := #undefined`
        \\compiles, silently infers the `label` type, and fails only at the
        \\first real use, with a message about `label` that says nothing about
        \\the missing annotation. Always write the type.
    );
    code_block(8, "text", #string
        \\// x := #undefined;  x = 5;
        \\error: assign int to label
    );
    bullet(9, #string,oneline
        \\Prefer a default value, a tagged union, or an `Option` representation
        \\when absence can occur during normal execution; `#undefined` is for
        \\storage that a later write is structurally guaranteed to dominate.
    );
    bullet(10, #string,oneline
        \\Keep undefined state local and short-lived so the write that makes the
        \\value valid stays visible in the same screen of code.
    );
    bullet(11, #string,oneline
        \\Do not use a label where user text is expected. Its identity is
        \\symbolic, it has no string content, and it cannot be formatted.
    );
}

render_section_16 :: () {
    paragraph(0, #string,oneline
        \\The binding punctuation states both mutability and evaluation time.
        \\`::` is a compile-time constant, `:=` is mutable storage with an
        \\inferred type, `name: Type` states the type explicitly, and `::=`
        \\inside a body is a compile-time local.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\Limit :: 64;
        \\Half : f32 : 0.5;
        \\
        \\main :: () {
        \\    count := 0;         // inferred mutable int
        \\    ratio: f32 = Half;  // explicit mutable f32
        \\    ready: bool;        // default initialized
        \\    cached ::= Limit * 2;
        \\    count += cached;
        \\    print("% % % %\n", count, ratio, ready, cached);
        \\}
    );
    code_block(2, "text", "128 0.5 0 128");
    table_header(3, "Form   —   Binding created");
    table_row(4, #string,oneline
        \\`Name :: expression;`   |   Compile-time constant; the initializer
        \\must be foldable by the compile-time evaluator.
    );
    table_row(5, #string,oneline
        \\`Name : Type : expression;`   |   Compile-time constant with an
        \\explicit type, checked against the initializer.
    );
    table_row(6, #string,oneline
        \\`name := expression;`   |   Mutable variable whose type is inferred
        \\from the initializer.
    );
    table_row(7, #string,oneline
        \\`name: Type = expression;`   |   Mutable variable with an explicit
        \\type and initializer.
    );
    table_row(8, #string,oneline
        \\`name: Type;`   |   Mutable variable initialized with the type's
        \\default value.
    );
    table_row(9, #string,oneline
        \\`name ::= expression;`   |   Compile-time binding inside a body; the
        \\initializer is evaluated during compilation.
    );
    subheading(10, "What each form rejects");
    paragraph(11, #string,oneline
        \\`::` is not a promise the compiler tries to keep; it is a request the
        \\compile-time evaluator must satisfy. The evaluator cannot read mutable
        \\storage, so naming a runtime variable in a constant is reported as an
        \\unknown constant rather than as a type error. A typed constant is
        \\checked against its annotation like any other typed initializer.
    );
    code_block(12, "text", #string
        \\// n := get_cmdline_args().count;  C :: n;
        \\error: unknown const n
        \\
        \\// Half : f32 : "no";
        \\error: got string, expected f32
    );
    paragraph(13, #string,oneline
        \\At file scope `::` also introduces named definitions: functions,
        \\structs, unions, enums, imports, libraries, function-pointer types,
        \\and typeclasses. The token after `::` selects which declaration parser
        \\runs, which is why a struct and a constant share one spelling. Inside
        \\a body, `::` creates a constant variable, `::=` marks a compile-time
        \\local, and `:=` and the typed `=` forms create mutable storage.
    );
    subheading(14, "Default initialization");
    paragraph(15, #string,oneline
        \\A declaration with no initializer is default initialized rather than
        \\left undefined. Struct field defaults apply, and the remaining scalar
        \\and aggregate storage takes its type default.
    );
    code_block(16, "glosso", #string
        \\#import "Io";
        \\
        \\Point :: struct { x: int = 10; y: int; }
        \\
        \\main :: () {
        \\    p: Point;
        \\    print("% %\n", p.x, p.y);
        \\}
    );
    code_block(17, "text", "10 0");
    note(18, #string,oneline
        \\Use `#undefined` only when deliberately bypassing that initialization
        \\and when every later read is dominated by a valid write. Label and
        \\Undefined Literals shows what the annotation-free spelling does
        \\instead.
    );
    bullet(19, #string,oneline
        \\Use `::` for constants and definitions, including functions and types.
    );
    bullet(20, #string,oneline
        \\Use `name: Type` when the declared type is part of the contract, and
        \\add an initializer only when the default is not appropriate.
    );
    bullet(21, #string,oneline
        \\Prefer the narrowest scope that contains all uses, especially for
        \\mutable variables and temporary pointers.
    );
}

render_section_17 :: () {
    paragraph(0, #string,oneline
        \\Plain assignment stores into an assignable location. Compound
        \\assignment calls the matching assignment operator and stores the
        \\result back into the left side. Assignment is a statement, not an
        \\expression: there is no value to bind and `y := (x = 2)` is a parse
        \\error.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    x := 1;
        \\    x = 2;
        \\    x += 3;
        \\    x *= 4;
        \\    x <<= 1;
        \\    x &= 255;
        \\    print("%\n", x);
        \\}
    );
    code_block(2, "text", "40");
    subheading(3, "Assignable locations");
    paragraph(4, #string,oneline
        \\The left side must denote mutable storage: a variable, a field, a
        \\dereferenced pointer, or an index whose container type has an
        \\`IndexSet` instance. Assignment changes existing storage and never
        \\introduces a binding, so the three ways to get it wrong are a constant,
        \\a value that has no address, and a type mismatch. Each has its own
        \\diagnostic, and the constant case suggests the fix.
    );
    code_block(5, "glosso", #string
        \\#import "Io";
        \\
        \\P :: struct { x: int; }
        \\
        \\main :: () {
        \\    a : [3]int;
        \\    a[1] = 7;              // fixed-array element
        \\    p : P;
        \\    p.x = 8;               // field
        \\    n := 0;
        \\    q := *n;
        \\    q.* = 9;               // through a pointer
        \\    d : [..]int;
        \\    array_add(*d, 0);
        \\    d[0] = 10;             // dynamic-array element
        \\    print("% % % %\n", a[1], p.x, n, d[0]);
        \\    array_free(*d);
        \\}
    );
    code_block(6, "text", "7 8 9 10");
    code_block(7, "text", #string
        \\// C :: 5;  C = 6;
        \\error: constant cannot be modified
        \\help: change '::' to ':=' to make the binding mutable
        \\
        \\// f() = 2;
        \\error: left side of assignment is not assignable
        \\
        \\// x : s32 = 1;  s := "hi";  x = s;
        \\error: assign string to s32
    );
    subheading(8, "Indexed assignment");
    paragraph(9, #string,oneline
        \\`container[key] = value` does not reuse the `Indexable` instance that
        \\reads. It selects `'[]='` from a separate `IndexSet(Container, Key,
        \\Value)` typeclass, so a readable index is not a writable one. The
        \\prelude supplies `IndexSet` for array views, dynamic arrays, and
        \\many-pointers, but not for `string`, whose contents are immutable.
    );
    paragraph(10, #string,oneline
        \\A missing `IndexSet` instance is currently not reported as a missing
        \\operator. Overload resolution accepts the write and the failure
        \\surfaces at lowering, with a mangled name that has to be read
        \\backwards: `op_lbrrbreq` is `'[]='`, then the container, key, and value
        \\types. Both a `string` element write and a user container with only
        \\`Indexable` produce this shape.
    );
    code_block(11, "text", #string
        \\// s := "abc";  s[0] = 100;
        \\error: internal error: 'op_lbrrbreq_string_int_u8' is called but was never lowered
        \\
        \\// a Grid with an Indexable instance but no IndexSet instance
        \\error: internal error: 'op_lbrrbreq_Grid_int_int' is called but was never lowered
    );
    paragraph(12, #string,oneline
        \\`'[]='` takes its container by value, exactly as `'[]'` does, so an
        \\instance can only write through indirection the container already
        \\carries: a dynamic-array descriptor, a pointer field, or a view. An
        \\instance whose container holds a fixed inline array compiles, runs, and
        \\silently discards every write, because it mutates a copy.
    );
    code_block(13, "glosso", #string
        \\#import "Io";
        \\
        \\Grid :: struct { cells: [..]s64; }
        \\
        \\(Grid, s64) :: instance Indexable {
        \\    Output :: s64;
        \\    '[]' :: (container: Grid, key: s64) -> s64 {
        \\        return container.cells[key];
        \\    }
        \\}
        \\
        \\(Grid, s64, s64) :: instance IndexSet {
        \\    '[]=' :: (container: Grid, key: s64, value: s64) {
        \\        container.cells[key] = value;
        \\    }
        \\}
        \\
        \\main :: () {
        \\    g : Grid;
        \\    defer array_free(*g.cells);
        \\    array_add(*g.cells, 0);
        \\    array_add(*g.cells, 0);
        \\    array_add(*g.cells, 0);
        \\    g[2] = 42;
        \\    print("%\n", g[2]);
        \\}
    );
    code_block(14, "text", #string
        \\42
        \\
        \\// the same instances with `cells: [4]s64` instead:
        \\0
    );
    subheading(15, "Update assignment");
    paragraph(16, #string,oneline
        \\Each compound form is its own typeclass operation declared
        \\`#operator(assign, 0)`: `+=` belongs to `AddAssign`, `<<=` to
        \\`ShiftLeftAssign`, `&&=` to `LogicalAndAssign`, and so on through the
        \\wrapping and saturating families. The prelude carries a blanket
        \\instance for each, `($L, $R) :: instance AddAssign where Add(L, R)`,
        \\so implementing `Add` alone already makes `+=` work. Declaring the
        \\assignment class directly, as below, is what a type does when the
        \\update must not go through the binary operator. A type with neither
        \\reports the operator rather than the assignment.
    );
    code_block(17, "glosso", #string
        \\#import "Io";
        \\
        \\Money :: struct { cents: s64; }
        \\
        \\(Money, Money) :: instance AddAssign {
        \\    Output :: Money;
        \\    '+=' :: (left: Money, right: Money) -> Money {
        \\        return .{ .cents = left.cents + right.cents };
        \\    }
        \\}
        \\
        \\main :: () {
        \\    m : Money = .{ .cents = 100 };
        \\    m += .{ .cents = 25 };
        \\    print("%\n", m.cents);
        \\}
    );
    code_block(18, "text", #string
        \\125
        \\
        \\// P :: struct { x: int; }  p : P;  p += p;
        \\error: no operator '+=' for P, P
    );
    paragraph(19, #string,oneline
        \\An assignment operator returns a value, and that value is what gets
        \\written back, so its `Output` must be coercible to the left operand's
        \\type. That is also why the update form is not merely sugar: it is one
        \\call and one store, and an implementation is free to make it cheaper
        \\than reading, combining, and writing separately.
    );
    bullet(20, #string,oneline
        \\Use plain `=` to replace a value and a compound form when the
        \\read-modify-write intent is real; do not spell `x = x + 1` when `+=`
        \\exists, and do not invent a compound operator whose result differs from
        \\the binary one.
    );
    bullet(21, #string,oneline
        \\Define `IndexSet` alongside `Indexable` whenever callers need indexed
        \\mutation, and make the container a type that carries indirection, or
        \\the writes will be discarded rather than diagnosed.
    );
}

render_section_98 :: () {
    paragraph(0, #string,oneline
        \\`s128` and `u128` are primitive integer types with the same standing
        \\as `s64` and `u64`: they can be annotated or inferred, cast, stored in
        \\fields and arrays, passed and returned by value, and folded at compile
        \\time. They exist because a 64-bit register is not wide enough for an
        \\exact 64-by-64 product, a 128-bit hash or identifier, or a fixed-point
        \\accumulator that must not drop low-order digits. The backend lowers
        \\both to a native 128-bit integer; the multiply, divide, and remainder
        \\forms the target cannot perform in one instruction become calls into
        \\the bundled compiler-builtins helpers, so they stay exact at full
        \\width rather than being approximated.
    );
    paragraph(1, #string,oneline
        \\Both types occupy 16 bytes and require 16-byte alignment on
        \\`x86_64-pc-windows-msvc`. `type_kind` reports `Type_Info_Tag.Integer`,
        \\and both satisfy `Is_Integer` and `Is_Numeric`, so every generic
        \\procedure constrained that way accepts them with no per-type instance.
        \\`__int128` is an accepted spelling that normalises to `s128`. There is
        \\no single-identifier spelling of C's `unsigned __int128`; write
        \\`u128`. The Primitive Types chapter lists these two alongside the
        \\narrower integer families.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    print("% % %\n", type_name(s128), size_of(s128),
        \\          type_info(s128).alignment);
        \\    print("% % %\n", type_name(u128), size_of(u128),
        \\          type_info(u128).alignment);
        \\    print("% %\n", Is_Integer(u128), Is_Numeric(u128));
        \\    print("%\n", type_kind(s128) == Type_Info_Tag.Integer);
        \\    print("%\n", type_name(__int128));
        \\}
    );
    code_block(3, "text", #string
        \\s128 16 16
        \\u128 16 16
        \\1 1
        \\1
        \\s128
    );
    note(4, #string,oneline
        \\Signedness is part of the type name, not of the reflected record.
        \\`type_info(s128).signed` is rejected with `error: no field 'signed' in
        \\'Type_Info'`, and the compiler suggests `size`. Distinguish the two
        \\types by comparing against the type itself rather than by querying
        \\`Type_Info`.
    );
    subheading(5, "Writing 128-bit literals");
    paragraph(6, #string,oneline
        \\Literal syntax is exactly the syntax described in the Integer Literals
        \\chapter, with no separate wide form: plain decimal digits, or
        \\`base#digits` for a base from 2 through 36, with `_` allowed between
        \\digits and alphabetic digits treated case-insensitively. What matters
        \\at 128 bits is that the lexer accumulates the magnitude into a full
        \\128-bit unsigned value before any type is known, in every base. The
        \\largest accepted magnitude is therefore 2^128-1, that is
        \\340282366920938463463374607431768211455, however it is spelled.
    );
    code_block(7, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    dec : u128 = 340_282_366_920_938_463_463_374_607_431_768_211_455;
        \\    hex : s128 = 16#7fff_ffff_ffff_ffff_ffff_ffff_ffff_ffff;
        \\    oct : u128 = 8#3777777777777777777777777777777777777777777;
        \\    bin : u128 = 2#1111_1111;
        \\    b36 : u128 = 36#F5LXX1ZZ5PNORYNQGLHZMSP33;
        \\    print("%\n%\n%\n%\n%\n", dec, hex, oct, bin, b36);
        \\}
    );
    code_block(8, "text", #string
        \\340282366920938463463374607431768211455
        \\170141183460469231731687303715884105727
        \\340282366920938463463374607431768211455
        \\255
        \\340282366920938463463374607431768211455
    );
    paragraph(9, #string,oneline
        \\A magnitude past that cap is the only range check the language
        \\performs on an integer literal. It runs in the lexer, so it fires
        \\regardless of the destination type, and the two spellings produce two
        \\different messages: the decimal form quotes the digits, while the
        \\based form names the base instead.
    );
    code_block(10, "text", #string
        \\// x : u128 = 340_282_366_920_938_463_463_374_607_431_768_211_456;
        \\error: integer literal '340282366920938463463374607431768211456' does not fit in 128 bits
        \\
        \\// x : u128 = 16#1_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff;
        \\error: base-16 integer literal does not fit in 128 bits
    );
    paragraph(11, #string,oneline
        \\A literal with no annotation to guide it takes its default type from
        \\its magnitude alone. A magnitude that does not fit in 64 bits defaults
        \\to `s128`; a magnitude that does fit keeps the ordinary `int` default
        \\and is stored as a wrapped 64-bit payload. That second half is the
        \\trap: the payload is reinterpreted, never range-checked, so a
        \\64-bit-wide bit pattern written in a 128-bit context sign-extends.
    );
    code_block(12, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\#import "Math/Constants";
        \\
        \\main :: () {
        \\    print("%\n", type_name(type_of(18_446_744_073_709_551_616)));
        \\    print("%\n", type_name(type_of(18_446_744_073_709_551_615)));
        \\    print("%\n", type_name(type_of(16#1_0000_0000_0000_0000)));
        \\    wrong : u128 = 18_446_744_073_709_551_615;   // int -1, extended
        \\    right : u128 = cast(u128)U64_MAX;
        \\    print("%\n%\n", wrong, right);
        \\}
    );
    code_block(13, "text", #string
        \\s128
        \\int
        \\s128
        \\340282366920938463463374607431768211455
        \\18446744073709551615
    );
    note(14, #string,oneline
        \\Writing the largest 64-bit unsigned value as a literal in a `u128`
        \\initializer yields 2^128-1, not 2^64-1, and no diagnostic is produced.
        \\The literal is an `int` holding -1, and widening a signed source
        \\sign-extends. Name the value instead: `cast(u128)U64_MAX` from
        \\`Math/Constants` gives 18446744073709551615.
    );
    paragraph(15, #string,oneline
        \\Glosso has no literal suffixes. There is no `1u128`, `255u8`, or
        \\`1_u128` form; width and signedness come from an annotation, a `cast`,
        \\or the type of the other operand. A suffix is not reported as a
        \\lexical error, because the number token ends at the digits and the
        \\trailing letters are read as a separate type name, which fails later
        \\and with a message that does not name the real problem.
    );
    code_block(16, "text", #string
        \\// x := 1u128;
        \\error: type value used as a statement
        \\
        \\// c := 255u8 +% 1u8;
        \\error: no operator '+%' for type, int
    );
    subheading(17, "Limit constants and the most-negative value");
    paragraph(18, #string,oneline
        \\`std/Math/Constants` declares the three 128-bit limits as typed
        \\compile-time constants: `S128_MIN`, `S128_MAX`, and `U128_MAX`. They
        \\are exact, they already carry the right type without a cast, and they
        \\are the safe way to name the most-negative `s128` value.
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\#import "Math/Constants";
        \\
        \\main :: () {
        \\    print("%\n%\n%\n", S128_MIN, S128_MAX, U128_MAX);
        \\}
    );
    code_block(20, "text", #string
        \\-170141183460469231731687303715884105728
        \\170141183460469231731687303715884105727
        \\340282366920938463463374607431768211455
    );
    paragraph(21, #string,oneline
        \\A minus sign is not part of a literal. It is a negation applied to a
        \\positive magnitude, and 170141183460469231731687303715884105728 is one
        \\past `S128_MAX`, so negating it inside a runtime initializer is an
        \\overflowing operation subject to the trap rule below. The declaration
        \\compiles and the program aborts the first time the value is produced.
        \\A `::` or typed `:` constant is folded by the compile-time evaluator
        \\instead, which wraps rather than traps, so the constant forms work.
    );
    code_block(22, "glosso", #string
        \\#import "Io";
        \\#import "Math/Constants";
        \\
        \\MY_MIN : s128 : -170_141_183_460_469_231_731_687_303_715_884_105_728;
        \\
        \\main :: () {
        \\    ok1 : s128 = S128_MIN;
        \\    ok2 : s128 = MY_MIN;
        \\    ok3 : s128 = -S128_MAX - 1;
        \\    ok4 : s128 = -%170_141_183_460_469_231_731_687_303_715_884_105_728;
        \\    print("% % % %\n", ok1, ok2, ok3, ok4);
        \\
        \\    // The same magnitude negated in a runtime initializer aborts
        \\    // at -O0 and -O1:
        \\    // bad : s128 = -170_141_183_460_469_231_731_687_303_715_884_105_728;
        \\}
    );
    note(23, #string,oneline
        \\That abort is silent: nothing is printed and the process exits with
        \\status 134 on Windows. The same spelling at `-O2` and `-O3` produces
        \\the intended value, so a program that works optimized can abort
        \\unoptimized. This is not specific to 128 bits; `b : s64 =
        \\-9_223_372_036_854_775_808;` behaves identically.
    );
    subheading(24, "Arithmetic, bitwise, comparison, and shifts");
    paragraph(25, #string,oneline
        \\`+ - * / % & | ^ << >> < > <= >= == !=`, unary `-`, and unary `~` all
        \\apply at full 128-bit width with ordinary two's-complement semantics.
        \\An untyped literal operand adapts to the 128-bit operand's type, so
        \\`b << 100` needs no cast on the shift count. `>>` is an arithmetic
        \\shift on `s128` and a logical shift on `u128`; that is decided by the
        \\operand type, not by the value's sign bit.
    );
    code_block(26, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    a : s128 = 1_000_000_000_000_000_000_000_000_000_000;
        \\    b : s128 = 7;
        \\    print("add %\n", a + b);
        \\    print("div %\n", a / b);
        \\    print("mod %\n", a % b);
        \\    print("shl %\n", b << 100);
        \\    print("shr %\n", a >> 40);
        \\    print("not %\n", ~b);
        \\    print("cmp % %\n", a > b, a == b);
        \\
        \\    u : u128 = 340_282_366_920_938_463_463_374_607_431_768_211_455;
        \\    v : u128 = 1_000_000_007;
        \\    print("udiv %\n", u / v);
        \\    print("umod %\n", u % v);
        \\    print("ushr %\n", u >> 1);
        \\}
    );
    code_block(27, "text", #string
        \\add 1000000000000000000000000000007
        \\div 142857142857142857142857142857
        \\mod 1
        \\shl 8873554201597605810476922437632
        \\shr 909494701772928237
        \\not -8
        \\cmp 1 0
        \\udiv 340282364538961911690641225597
        \\umod 279632276
        \\ushr 170141183460469231731687303715884105727
    );
    paragraph(28, #string,oneline
        \\Signed division truncates toward zero and the remainder carries the
        \\sign of the dividend, matching the narrower signed types. Unsigned
        \\division and remainder are exact for divisors that use the full width,
        \\not only for divisors that happen to fit in 64 bits.
    );
    code_block(29, "glosso", #string
        \\a : s128 = -7;
        \\b : s128 = 2;
        \\print("% %\n", a / b, a % b);   // -3 -1
    );
    paragraph(30, #string,oneline
        \\There is no implicit promotion between the two 128-bit types inside a
        \\binary operator. Both operands must already share a type, and a
        \\mismatch is reported as a missing operator rather than as a conversion
        \\failure, because operator selection runs before any coercion is
        \\considered.
    );
    code_block(31, "text", #string
        \\// a : s128 = 5;  b : u128 = 7;  print("%\n", a + b);
        \\error: no operator '+' for s128, u128
    );
    note(32, #string,oneline
        \\A shift count of 128 or more is neither diagnosed nor trapped. The
        \\count follows the target's masking behaviour, so `u << 128` was
        \\observed to act as `u << 0` on x86_64. No portable result is defined
        \\there; guard the count when it can reach the width.
    );
    subheading(33, "Overflow: trapping, wrapping, and saturating");
    paragraph(34, #string,oneline
        \\The rule the Numeric Operations chapter states for narrower integers
        \\holds unchanged at 128 bits. Plain `+ - *` and unary `-` are checked
        \\at `-O0` and `-O1`, and an overflowing result aborts the process. At
        \\`-O2` and `-O3` the checks are removed and the same expression wraps.
        \\Unsigned overflow traps just as signed overflow does.
    );
    code_block(35, "glosso", #string
        \\#import "Io";
        \\#import "Math/Constants";
        \\
        \\main :: () {
        \\    n := cast(s128)get_cmdline_args().count;   // 1 at run time
        \\    s : s128 = S128_MAX;
        \\    print("about to add\n");
        \\    print("%\n", s + n);
        \\}
    );
    code_block(36, "text", #string
        \\$ glosso over.glo && ./over.exe          # -O1, the default
        \\about to add
        \\(exit status 134, no message)
        \\
        \\$ glosso -O2 over.glo && ./over.exe
        \\about to add
        \\-170141183460469231731687303715884105728
    );
    paragraph(37, #string,oneline
        \\When wrapping or clamping is the intent, spell it. The `%` suffix
        \\family wraps and the `|` suffix family saturates, and both behave the
        \\same way at every optimization level because they are distinct
        \\operators rather than a relaxation of the checked ones. `+% -% *%` and
        \\unary `-%` wrap; `+| -| *| <<|` saturate to the type's limit.
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\#import "Math/Constants";
        \\
        \\main :: () {
        \\    n := cast(s128)get_cmdline_args().count;   // 1 at run time
        \\    s : s128 = S128_MAX;
        \\    u : u128 = U128_MAX;
        \\    print("wrap add  %\n", s +% n);
        \\    print("wrap uadd %\n", u +% cast(u128)n);
        \\    print("wrap neg  %\n", -%S128_MIN);
        \\    print("sat add   %\n", s +| n);
        \\    print("sat sub   %\n", S128_MIN -| n);
        \\    print("sat mul   %\n", s *| cast(s128)2);
        \\    print("sat shl   %\n", u <<| cast(u128)4);
        \\}
    );
    code_block(39, "text", #string
        \\wrap add  -170141183460469231731687303715884105728
        \\wrap uadd 0
        \\wrap neg  -170141183460469231731687303715884105728
        \\sat add   170141183460469231731687303715884105727
        \\sat sub   -170141183460469231731687303715884105728
        \\sat mul   170141183460469231731687303715884105727
        \\sat shl   340282366920938463463374607431768211455
    );
    note(40, #string,oneline
        \\Because the trap is a bare abort, output buffered after the failing
        \\statement is lost and nothing identifies the operation. Dividing a
        \\`u128` by zero aborts through a different path and was observed to
        \\exit with status 127. When a wide computation ends without output and
        \\without a diagnostic, suspect an overflow trap first and rebuild at
        \\`-O2` to confirm.
    );
    subheading(41, "Conversions");
    paragraph(42, #string,oneline
        \\`cast` to a narrower integer keeps the low bits and discards the rest.
        \\`cast` to a wider integer sign-extends from a signed source and
        \\zero-extends from an unsigned one. Without a `cast`, the checker
        \\accepts a widening only when it is lossless for every value of the
        \\source type, and it decides that from the declared types alone, never
        \\from the value at hand.
    );
    table_header(43, "Conversion   —   Result");
    table_row(44, #string,oneline
        \\`u64` or `u32` value into `u128`   |   Accepted with no cast;
        \\zero-extends
    );
    table_row(45, "`u64` value into `s128`   |   Accepted with no cast");
    table_row(46, #string,oneline
        \\`s64` or `int` value into `u128`   |   Accepted with no cast and
        \\reinterpreted: -5 becomes 340282366920938463463374607431768211451
    );
    table_row(47, #string,oneline
        \\`s32` value into `u128`   |   `error: got s32, expected u128`
    );
    table_row(48, #string,oneline
        \\`u128` value into `s128`   |   `error: got u128, expected s128`
    );
    table_row(49, #string,oneline
        \\`s128` value into `s64`   |   `error: got s128, expected int`
    );
    table_row(50, #string,oneline
        \\`cast(u8)wide`, `cast(u32)wide`, `cast(u64)wide`   |   Truncates to
        \\the low 8, 32, or 64 bits
    );
    table_row(51, #string,oneline
        \\`cast(s128)x` from a signed narrower type   |   Sign-extends, so -5
        \\stays -5
    );
    table_row(52, #string,oneline
        \\`cast(s128)` or `cast(u128)` from an `f64`   |   Rounds toward zero to
        \\the representable integer
    );
    table_row(53, #string,oneline
        \\`cast(f64)` from an `s128` or `u128`   |   Currently wrong at or above
        \\2^63; unusable
    );
    code_block(54, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    big : u128 = 16#dead_beef_cafe_babe_0123_4567_89ab_cdef;
        \\    print("->u64  %\n", cast(u64)big);
        \\    print("->u8   %\n", cast(u8)big);
        \\    print("->s128 %\n", cast(s128)big);
        \\    print("u8 ->u128 %\n", cast(u128)cast(u8)200);
        \\    print("s32->s128 %\n", cast(s128)cast(s32)-5);
        \\    print("s32->u128 %\n", cast(u128)cast(s32)-5);
        \\    print("f64->s128 %\n", cast(s128)1.0e30);
        \\
        \\    w  : s128 = cast(s64)-12345;         // implicit widen
        \\    uw : u128 = cast(u32)4_000_000_000;  // implicit widen
        \\    print("implicit % %\n", w, uw);
        \\}
    );
    code_block(55, "text", #string
        \\->u64  81985529216486895
        \\->u8   239
        \\->s128 -44291611843981158765213436369005982225
        \\u8 ->u128 200
        \\s32->s128 -5
        \\s32->u128 340282366920938463463374607431768211451
        \\f64->s128 1000000000000000019884624838656
        \\implicit -12345 4000000000
    );
    note(56, #string,oneline
        \\The `int` family is the one hole in the lossless rule. A value whose
        \\declared type is `int` or `s64` is accepted into `u128` with no cast
        \\and no diagnostic, because the compiler treats `int` as the unnamed
        \\default integer rather than as a named signed type. The same
        \\assignment from a named `s32` is correctly rejected. Annotate
        \\intermediate values with a named width when a negative value must not
        \\silently become a huge unsigned one.
    );
    note(57, #string,oneline
        \\Converting a 128-bit integer to `f64` is broken in this build for
        \\magnitudes at or above 2^63: `cast(f64)(cast(u128)1 << 100)` prints
        \\9223372036854775809, and dividing that result by 2.0 leaves it
        \\unchanged. Only small values round correctly. The opposite direction,
        \\`cast(s128)1.0e30`, is exact.
    );
    subheading(58, "Compile-time evaluation");
    paragraph(59, #string,oneline
        \\The compile-time evaluator carries a full 128-bit payload, so wide
        \\literals, arithmetic, comparison, shifts, and both signed and unsigned
        \\full-width division and remainder fold exactly and agree with the
        \\native backend. A `#comptime` result of 128-bit type is an ordinary
        \\constant afterwards: it can be printed, stored, and used to initialize
        \\a variable.
    );
    code_block(60, "glosso", #string
        \\#import "Io";
        \\#import "Math/Constants";
        \\
        \\check_div :: () -> string {
        \\    u : u128 = U128_MAX;
        \\    d : u128 = (cast(u128)1 << 100) + 17;
        \\    if (u / d) * d + (u % d) != u return "BAD";
        \\    return "OK";
        \\}
        \\
        \\CHECKED :: #comptime check_div();
        \\FOLDED  :: cast(u128)U64_MAX * cast(u128)U64_MAX;
        \\WRAPPED :: #comptime S128_MAX + 1;
        \\
        \\main :: () {
        \\    print("vm % native %\n", CHECKED, check_div());
        \\    print("folded %\n", FOLDED);
        \\    print("inline %\n", #comptime (cast(s128)1 << 126) + 5);
        \\    print("wrapped %\n", WRAPPED);
        \\}
    );
    code_block(61, "text", #string
        \\vm OK native OK
        \\folded 340282366920938463426481119284349108225
        \\inline 85070591730234615865843651857942052869
        \\wrapped -170141183460469231731687303715884105728
    );
    note(62, #string,oneline
        \\Overflow is the one place the evaluator and the backend disagree. The
        \\evaluator wraps silently where a runtime evaluation of the same
        \\expression aborts at `-O0` and `-O1`, which is why `WRAPPED` above
        \\folds to `S128_MIN` with no diagnostic. A constant that folded
        \\successfully is therefore not evidence that the equivalent runtime
        \\expression stays in range.
    );
    subheading(63, "Structs, arrays, ranges, and signatures");
    paragraph(64, #string,oneline
        \\A 128-bit field forces 16-byte alignment on its struct, so a struct
        \\holding one `u128` and one `s128` is 32 bytes with nothing to pack
        \\into. Fixed arrays use a 16-byte stride, `.[...]` element values wider
        \\than 64 bits are preserved, `#derive(Show)` prints wide fields at full
        \\precision, a range with `s128` bounds binds its loop variable as
        \\`s128`, and 128-bit parameters and results pass by value.
    );
    code_block(65, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Pair :: struct #derive(Show) {
        \\    lo: u128;
        \\    hi: s128;
        \\}
        \\
        \\triple :: (v: u128) -> u128 { return v * 3; }
        \\
        \\main :: () {
        \\    p := Pair.{ .lo = 16#1_0000_0000_0000_0000,
        \\                .hi = -1_000_000_000_000_000_000_000 };
        \\    print("% %\n", p, size_of(Pair));
        \\
        \\    arr : [3]u128 = .[16#1_0000_0000_0000_0000, 7, 0];
        \\    print("bytes %\n", size_of(type_of(arr)));
        \\
        \\    total : s128 = 0;
        \\    lo : s128 = 0;
        \\    hi : s128 = 4;
        \\    for i: lo..hi { total += i; }
        \\    print("total % call %\n", total,
        \\          triple(16#1_0000_0000_0000_0000));
        \\}
    );
    code_block(66, "text", #string
        \\{18446744073709551616, -1000000000000000000000} 32
        \\bytes 48
        \\total 6 call 55340232221128654848
    );
    note(67, #string,oneline
        \\An `enum` or `enum_flags` with an `s128` or `u128` backing type is 16
        \\bytes, but member values are silently truncated to their low 64 bits.
        \\A member declared `16#1_0000_0000_0000_0005` reads back as 5, and an
        \\`enum_flags u128` bit at 2^64 reads back as 0. Keep enum members
        \\within 64 bits and use plain `u128` constants for wider patterns.
    );
    note(68, #string,oneline
        \\`size_of` does not accept a bare array type: `size_of([4]u128)` is
        \\`error: unexpected token '['`, so write `size_of(type_of(arr))`.
        \\Fixed arrays and array views also have no `Show` instance at any
        \\element width, so printing a whole array reports that the argument
        \\type does not implement `Show`; print the elements individually.
    );
    subheading(69, "Printing, formatting, and typeclasses");
    paragraph(70, #string,oneline
        \\`%` in `print` and `format` is a positional placeholder with no
        \\specifier letters; it invokes the argument's `Show` instance. `s128`
        \\and `u128` are covered by the generic instance constrained on
        \\`Is_Integer`, so they print exact full-width decimal including
        \\negatives and 2^128-1. `format_int` from `std/Format` renders a value
        \\in another base.
    );
    code_block(71, "glosso", #string
        \\#import "Io";
        \\#import "Format";
        \\
        \\main :: () {
        \\    a : s128 = -123_456_789_012_345_678_901_234_567_890;
        \\    u : u128 = 340_282_366_920_938_463_463_374_607_431_768_211_455;
        \\    print("show   %\n", show(a));
        \\    print("format %\n", format("[%] [%]", a, u));
        \\    print("hex    %\n", format_int(u, 16));
        \\    print("oct    %\n", format_int(u, 8));
        \\    print("bin    %\n", format_int(cast(u128)255, 2));
        \\    print("hexbig %\n", format_int(cast(u128)1 << 100, 16));
        \\}
    );
    code_block(72, "text", #string
        \\show   -123456789012345678901234567890
        \\format [-123456789012345678901234567890] [340282366920938463463374607431768211455]
        \\hex    ffffffffffffffffffffffffffffffff
        \\oct    3777777777777777777777777777777777777777777
        \\bin    11111111
        \\hexbig 10000000000000000000000000
    );
    paragraph(73, #string,oneline
        \\No typeclass declares an `s128` or `u128` instance by name. Coverage
        \\comes from generic instances constrained on `Is_Integer` or
        \\`Is_Numeric`: `Show`, `PartialEq`, `Eq`, `PartialOrd`, and `Num` all
        \\apply, so a generic procedure carrying one of those `where` clauses
        \\accepts a 128-bit argument unchanged. `std/Math/Bit` is the exception
        \\that does declare explicit `u128` and `s128` instances of
        \\`BitArithmetic`, implemented over 64-bit halves, and
        \\`std/Container/Hash` provides `hasher_write_u128` and
        \\`hasher_write_s128` behind `hash_value`.
    );
    code_block(74, "glosso", #string
        \\#import "Io";
        \\#import "Math/Bit";
        \\#import "Container/Hash";
        \\
        \\biggest :: (a: $T, b: T) -> T where PartialOrd(T, T) {
        \\    if a < b return b;
        \\    return a;
        \\}
        \\
        \\main :: () {
        \\    x : s128 = -(cast(s128)1 << 120);
        \\    y : s128 = cast(s128)1 << 119;
        \\    print("biggest %\n", biggest(x, y));
        \\
        \\    u : u128 = 16#0f0f_0f0f_0000_0000_ffff_0000_0000_00f0;
        \\    print("width % popcnt % clz % ctz %\n",
        \\          bit_width_of(u), count_one_bits(u),
        \\          count_leading_zero_bits(u), count_trailing_zero_bits(u));
        \\    print("rotl4 %\n", rotate_bits_left(u, 4));
        \\    print("hash %\n", hash_value(cast(u128)1 << 100) !=
        \\                     hash_value(cast(u128)1 << 101));
        \\}
    );
    code_block(75, "text", #string
        \\biggest 664613997892457936451903530140172288
        \\width 128 popcnt 36 clz 4 ctz 4
        \\rotl4 320265757027492048247247184956877704960
        \\hash 1
    );
    note(76, #string,oneline
        \\`format_int` supports bases 2 through 16 only, at every width. An
        \\out-of-range base inside `#comptime` is `error: integer formatting
        \\base 36 is outside 2..=16`, but at run time the same call silently
        \\returns the decimal rendering instead: `format_int(cast(u128)1295,
        \\36)` returns "1295", not "zz". Restrict `format_int` to the bases it
        \\supports and use a hand-written conversion beyond base 16.
    );
}

render_section_99 :: () {
    paragraph(0, #string,oneline
        \\The lexer is the first pass over a `.glo` file. It turns a decoded
        \\stream of Unicode codepoints into a flat token vector in one forward
        \\scan, and it is the only pass that can report a `lex error`.
        \\Everything it decides — where a number ends, whether an apostrophe
        \\opens a label or an operator name, whether a run of punctuation is one
        \\token or two — is fixed before the operator prescan runs and before
        \\the parser sees anything, so no later phase can reinterpret a token
        \\boundary. This chapter owns tokens as a category. The individual
        \\literal kinds are described in Integer Literals, Floating-Point
        \\Literals, String Literals, Character Literals, and Label and Undefined
        \\Literals.
    );
    subheading(1, "The whitespace set");
    paragraph(2, #string,oneline
        \\Exactly four codepoints separate tokens: U+0020 space, U+0009
        \\character tabulation, U+000D carriage return, and U+000A line feed. A
        \\line feed additionally advances the line counter and resets the column
        \\origin; the other three are discarded with no bookkeeping. Because
        \\carriage return is in the set, a CRLF-encoded file compiles normally
        \\everywhere except inside a `#string` body, where the scanner stops
        \\only at the line feed and keeps the carriage return as content — the
        \\trap described in String Literals.
    );
    paragraph(3, #string,oneline
        \\No other codepoint is whitespace. Form feed U+000C, vertical tab
        \\U+000B, no-break space U+00A0, and every other Unicode space separator
        \\fall through the entire dispatch — they are not operator characters,
        \\not alphabetic, not digits, and not one of the single-character
        \\punctuation marks — and reach the unknown-character error. That
        \\diagnostic has no wording of its own: its whole message is the
        \\offending codepoint enclosed in single quotes.
    );
    code_block(4, "glosso", #string
        \\main :: () { a := 1 \ 2; }
    );
    code_block(5, "text", #string
        \\error: '\'
        \\  --> stray.glo:2:21
        \\  |
        \\2 | main :: () { a := 1 \ 2; }
        \\  |                     ^
    );
    paragraph(6, #string,oneline
        \\For an invisible codepoint the same message is close to useless. A
        \\form feed and a vertical tab both render as `error: ''` with nothing
        \\between the quotes, and a no-break space renders as `error: ' '`,
        \\indistinguishable from a diagnostic about an ordinary space. The
        \\`--> file:line:column` line and the caret are the only usable
        \\information in those cases.
    );
    subheading(7, "A byte-order mark is a lex error");
    paragraph(8, #string,oneline
        \\U+FEFF is neither whitespace nor alphabetic, so a UTF-8 byte-order
        \\mark at the start of a file is an unknown character at line 1 column
        \\1. A BOM-prefixed `.glo` file cannot compile, no matter what follows
        \\it. The message quotes the mark itself, which is invisible, so the
        \\output looks like an empty pair of quotes pointing at what appears to
        \\be a perfectly ordinary first line.
    );
    code_block(9, "text", #string
        \\error: ''
        \\  --> hello.glo:1:1
        \\  |
        \\1 | #import "Io";
        \\  | ^
    );
    note(10, #string,oneline
        \\Several Windows editors write a BOM by default when saving as UTF-8,
        \\and Windows PowerShell's `Out-File` and redirection operators have
        \\historically done the same. Save Glosso sources as UTF-8 without a
        \\signature. A file that produces this diagnostic is fixed by stripping
        \\the first three bytes; nothing about the visible source needs to
        \\change.
    );
    subheading(11, "The token categories");
    paragraph(12, #string,oneline
        \\The lexer produces 53 token kinds. Comments produce none: a `//` line
        \\comment is consumed to the next line feed and a `/* */` block comment
        \\is consumed with a depth counter, and neither leaves anything in the
        \\vector. Every remaining category is listed below with the scanner that
        \\emits it.
    );
    table_header(13, "Category   —   Members, and what produces them");
    table_row(14, #string,oneline
        \\Word tokens (20)   |   `Ident`, plus one dedicated kind for each of
        \\the nineteen reserved words: `if`, `ifx`, `else`, `while`, `for`,
        \\`return`, `break`, `continue`, `struct`, `union`, `case`, `enum`,
        \\`using`, `defer`, `context`, `cast`, `acast`, `where`, `noalias`.
        \\`scan_word` reads the text first and classifies it afterwards.
    );
    table_row(15, #string,oneline
        \\Literal tokens (4)   |   `Int`, `Float`, `Str`, `MlStr`. An `Int`
        \\token carries the decoded magnitude as a 128-bit two's-complement
        \\payload and a flag marking it a `#char` literal; a `Float` token
        \\carries the parsed `f64`. `Str` holds the raw text with escapes still
        \\undecoded; `MlStr` holds one `\\` line body.
    );
    table_row(16, #string,oneline
        \\Naming tokens (5)   |   `Directive` for `#name`, `Backtick` for
        \\`` `name ``, `DoubleBacktick` for `` ``name ``, `Label` for `'name`,
        \\`OpName` for `'op'`. Each carries the bare name with its marker
        \\stripped, so the marker is not recoverable from the token text.
    );
    table_row(17, #string,oneline
        \\Operator tokens (1)   |   `Op` covers every run of operator
        \\characters, the four hard-coded spellings `?`, `@`, `$=` and `:$=`,
        \\and the fixed `.*`. Fixity and precedence are not lexical: they come
        \\from the operator declaration found by the prescan.
    );
    table_row(18, #string,oneline
        \\Multi-character punctuation (10)   |   `Range` `..`,
        \\`RangeInclusive` `..=`, `Ellipsis` `...`, `Arrow` `->`, `ColonColon`
        \\`::`, `ColonColonEqual` `::=`, `ColonEqual` `:=`, `DotBrace` `.{`,
        \\`DotBracket` `.[`, `CommaComma` `,,`. Each is one token, so no
        \\whitespace may appear inside it.
    );
    table_row(19, #string,oneline
        \\Single-character punctuation (12)   |   `Colon`, `Equal`, `Dot`,
        \\`Semicolon`, `Comma`, `Dollar`, `LParen`, `RParen`, `LBrace`,
        \\`RBrace`, `LBracket`, `RBracket`. `Dollar` is the generic-binding
        \\marker of `$T`, not an operator character.
    );
    table_row(20, #string,oneline
        \\End of input (1)   |   `Eof`, appended exactly once after the last
        \\token with the final line and column. The parser asserts the stream is
        \\non-empty and clamps every lookahead to this token, so a truncated
        \\file always produces a parse diagnostic rather than an index error.
    );
    paragraph(21, #string,oneline
        \\There is no token kind for a comment, no token kind for whitespace,
        \\and no separate kind for `true`, `false` or `null` — those three are
        \\`Ident` tokens that the parser recognises by text. A boolean is
        \\therefore not lexically distinguishable from a variable named `true`.
    );
    subheading(22, "The span model");
    paragraph(23, #string,oneline
        \\Every token records a line, a column and a length. The line is
        \\1-based and counts line feeds only. The column is a 1-based count of
        \\codepoints from the start of the line, not of bytes and not of display
        \\cells, so a line of astral-plane characters or combining marks
        \\produces columns that do not match a terminal's cursor position. The
        \\length is likewise a codepoint count. `diagnostic_render` uses the
        \\three to draw the caret run, and strips the internal
        \\`lex error line N: ` and `parse error line N: ` prefixes before
        \\printing, which is why a lexer message appears as a bare `error:`
        \\line.
    );
    code_block(24, "glosso", #string
        \\main :: () { λλλ := 1; a := 1 \ 2; }
    );
    code_block(25, "text", #string
        \\error: '\'
        \\  --> columns.glo:2:31
        \\  |
        \\2 | main :: () { λλλ := 1; a := 1 \ 2; }
        \\  |                               ^
    );
    paragraph(26, #string,oneline
        \\The backslash is the 31st codepoint of that line and the 34th byte;
        \\the reported column is 31. A quoted string may contain raw line feeds,
        \\and the string scanner counts them, so a literal spanning three source
        \\lines leaves every later diagnostic on the correct line.
    );
    note(27, #string,oneline
        \\Source is decoded with the runtime's own UTF-8 decoder, which recovers
        \\from malformed byte sequences instead of failing, so an invalid
        \\encoding produces a replacement codepoint and then, usually, an
        \\unknown-character error at that position. A file that is entirely
        \\ASCII takes a byte-indexed fast path; the token positions are
        \\identical either way.
    );
    subheading(28, "Identifier characters");
    paragraph(29, #string,oneline
        \\An identifier starts with `_` or a codepoint for which `is_alpha`
        \\holds, and continues with `_` or a codepoint for which `is_alnum`
        \\holds. Both predicates reproduce CPython's `str.isalpha()` and
        \\`str.isalnum()` for a single codepoint: the ASCII range is a fast
        \\path, and everything above U+007F is decided by a range table. The
        \\continue set is therefore wider than letters plus ASCII digits — it
        \\includes Unicode numerics such as U+00B2 SUPERSCRIPT TWO and the
        \\vulgar fractions U+00BC through U+00BE.
    );
    code_block(30, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    λα := 3;
        \\    a² := 4;
        \\    print("% %\n", λα, a²);
        \\}
    );
    code_block(31, "text", #string
        \\3 4
    );
    paragraph(32, #string,oneline
        \\`_` alone is an ordinary identifier and an ordinary binding name;
        \\there is no wildcard token at the lexical level. A digit cannot start
        \\an identifier because the number scanner is tried first, which is why
        \\`1abc := 1;` declares `abc` rather than failing — see Identifiers and
        \\Names.
    );
    subheading(33, "The reserved words are exactly nineteen");
    paragraph(34, #string,oneline
        \\`word_kind` maps a finished word to a keyword kind, and it recognises
        \\nineteen spellings and no others.
    );
    code_block(35, "text", #string
        \\if      ifx      else     while    for
        \\return  break    continue struct   union
        \\case    enum     using    defer    context
        \\cast    acast    where    noalias
    );
    paragraph(36, #string,oneline
        \\Every other word in the language is an `Ident` token and may be used
        \\as a variable name. `true`, `false` and `null` are recognised by the
        \\parser from identifier text; `distinct`, `typeclass`, `instance`,
        \\`goto`, `in`, `out`, `inout`, `only`, `hide`, `always`, `never`,
        \\`fixed`, `left`, `right`, `prefix`, `suffix`, `assign`, `oneline`,
        \\`escape`, `siblings`, `enable`, `disable`, `const` and `volatile` are
        \\contextual: they are meaningful only in the one grammatical position
        \\that asks for them, and are plain identifiers everywhere else.
    );
    code_block(37, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    distinct := 5;
        \\    instance := 6;
        \\    typeclass := 7;
        \\    print("%\n", distinct + instance + typeclass);
        \\}
    );
    code_block(38, "text", #string
        \\18
    );
    subheading(39, "Directive names are a separate namespace");
    paragraph(40, #string,oneline
        \\`scan_directive` takes `#` followed by a run of `is_alnum` codepoints
        \\and `_`, and emits a `Directive` token carrying the bare name. The name
        \\lives in its own lexical namespace: a `Directive` token can never
        \\compare equal to an `Ident` token, so `comptime`, `derive`, `lazy`,
        \\`magic`, `raw`, `minimal`, `partial`, `falling`, `meaningful`, `empty`,
        \\`pattern`, `as` and `from` are directive spellings and simultaneously
        \\unreserved variable names.
    );
    code_block(41, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    comptime := 1; derive := 2; lazy := 3; magic := 4;
        \\    print("%\n", comptime + derive + lazy + magic);
        \\}
    );
    code_block(42, "text", #string
        \\10
    );
    paragraph(43, #string,oneline
        \\`#char` is the one directive the lexer does not hand to the parser: it
        \\is scanned as a literal on the spot and emitted as an `Int` token, so
        \\its diagnostics are lexer diagnostics rather than parser diagnostics.
    );
    subheading(44, "Backtick forms");
    paragraph(45, #string,oneline
        \\A single backtick followed by an identifier is a `Backtick` token, the
        \\non-hygienic name form used by expand procedures; a double backtick
        \\followed by an identifier is a `DoubleBacktick` token, the code-splice
        \\form that substitutes a compile-time value into that parser position.
        \\Both are described in Expand Procedures and `#insert`. The lexical rule
        \\is that the name after the marker must be a well-formed identifier: a
        \\backtick followed by anything else is not a token at all, and reaches
        \\the unknown-character error as `` error: '`' ``. Bare `` ` `` and bare
        \\`` `` `` are also reserved operator tokens, so neither can be declared
        \\as a user operator.
    );
    subheading(46, "Where a number token ends");
    paragraph(47, #string,oneline
        \\The number scanner runs before the word scanner, so any token starting
        \\with a digit is a number and the letters after it are a separate
        \\token. `255u8` is an `Int` followed by the type name `u8`, which is
        \\why a suffixed literal fails with `error: type value used as a
        \\statement` rather than a lexical complaint. There are no typed literal
        \\suffixes of any kind.
    );
    paragraph(48, #string,oneline
        \\An underscore, by contrast, is consumed as part of the number, so a
        \\word that begins with a digit and an underscore never splits. `1_abc`
        \\is the number text `1_`, which fails the separator rule: an underscore
        \\may not lead a part, trail a part, or be doubled.
    );
    code_block(49, "text", #string
        \\error: invalid '_' separator in number literal
        \\  --> sep.glo:2:19
        \\  |
        \\2 | main :: () { a := 1_abc; }
        \\  |                   ^^
    );
    subheading(50, "A float needs a digit on both sides of the point");
    paragraph(51, #string,oneline
        \\The fraction is taken only when the codepoint immediately after `.` is
        \\a digit. That single condition rules out both abbreviations that other
        \\languages allow, and neither failure names the real problem. `1.` is
        \\an `Int` followed by a `.` that reaches the operator scanner, where a
        \\lone dot is a reserved operator token; `.5` is a `Dot` followed by an
        \\`Int`, and the parser reports the digit as the unexpected token.
    );
    code_block(52, "glosso", #string
        \\main :: () { a := 1.; }     // no trailing form
        \\main :: () { a := .5; }     // no leading form
    );
    code_block(53, "text", #string
        \\error: reserved operator token '.' (operator '.' cannot be overloaded)
        \\  --> trailing.glo:2:20
        \\  |
        \\2 | main :: () { a := 1.; }
        \\  |                    ^
        \\
        \\error: unexpected token '5'
        \\  --> leading.glo:2:20
        \\  |
        \\2 | main :: () { a := .5; }
        \\  |                    ^
    );
    note(54, #string,oneline
        \\Both messages describe the token the scanner actually produced, not
        \\the float that was intended. Write `1.0` and `0.5`. An exponent alone
        \\is enough to make a token a float without any fraction, so `1e5` is a
        \\valid `f64` literal while `1.` is not.
    );
    subheading(55, "Number forms that do not exist");
    paragraph(56, #string,oneline
        \\`0x` and `0b` prefixes are not merely unsupported: they are detected
        \\before general scanning and rejected with a dedicated message that
        \\names the replacement. The based form is `base#digits` for a base from
        \\2 through 36.
    );
    code_block(57, "text", #string
        \\error: legacy '0x' integer literals are not supported; use '16#digits'
        \\error: legacy '0b' integer literals are not supported; use '2#digits'
    );
    paragraph(58, #string,oneline
        \\There is no hexadecimal float form and no `p` exponent. There is no
        \\imaginary or complex literal spelling of any kind — no `i` or `j`
        \\suffix, no separate token, nothing: the complex types in `std/Math`
        \\are ordinary aggregates built with ordinary constructors. There is no
        \\based float either, because base scanning stops at `.`, so `16#1.8` is
        \\the integer `16#1` followed by a member access and fails with
        \\`error: member of non-struct`.
    );
    note(59, #string,oneline
        \\The predicate that decides whether a token starts a number is
        \\CPython's `str.isdigit()`, which is true for Unicode numerics such as
        \\`²`. A statement beginning with one of those enters the number scanner
        \\and then fails at the end with `error: number literals must use ASCII
        \\digits`. The same codepoint inside a word is an ordinary identifier
        \\character, which is why `a²` is a legal name but `²` alone is not.
    );
    subheading(60, "String, `#char`, label and operator-name scanning");
    paragraph(61, #string,oneline
        \\`scan_string` runs from the opening quote to the next unescaped quote,
        \\stepping two codepoints over any `\` pair, and stores the raw text
        \\undecoded. The literal may contain raw line feeds. Reaching the end of
        \\the file first is `error: unterminated string literal`. Escape
        \\decoding happens later, in `decode_escapes`, and is documented in
        \\String Literals; the lexically relevant consequence is that a
        \\malformed escape is never a lex error. `\x` with fewer than two hex
        \\digits produces no diagnostic and no byte — the backslash is dropped
        \\and the remaining characters survive as themselves.
    );
    code_block(62, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () { print("short hex: [\x4][\x]\n"); }
    );
    code_block(63, "text", #string
        \\short hex: [x4][x]
    );
    paragraph(64, #string,oneline
        \\A line beginning with two backslashes is an `MlStr` token, but only
        \\three parser sites accept one: the `#string` directive, inline `#asm`,
        \\and structured `#asm`. The marker is not a literal on its own, so a
        \\bare `\\` line outside those positions is a parse error whose message
        \\quotes the body text, which reads as though a fragment of the line had
        \\become an identifier.
    );
    code_block(65, "glosso", #string
        \\main :: () { m := \\text; }
    );
    code_block(66, "text", #string
        \\error: unexpected token 'text; }'
        \\  --> bare.glo:2:19
        \\  |
        \\2 | main :: () { m := \\text; }
        \\  |                   ^^^^^^^
    );
    paragraph(67, #string,oneline
        \\`#char` skips only spaces and tabs between the directive and the
        \\opening quote, so a line feed between them is
        \\`error: #char expects a string literal`. An unescaped non-ASCII
        \\character keeps its whole codepoint, but an escaped one is truncated
        \\to its low byte, because the escape branch reads a single byte rather
        \\than a scalar. The two spellings of the same character therefore
        \\disagree.
    );
    code_block(68, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    plain  : u32 = #char "λ";
        \\    escape : u32 = #char "\λ";
        \\    print("% %\n", plain, escape);
        \\}
    );
    code_block(69, "text", #string
        \\955 187
    );
    paragraph(70, #string,oneline
        \\`scan_quote` handles both apostrophe forms, and the presence of a
        \\closing quote is the entire disambiguation. An apostrophe followed by
        \\an identifier and no closing apostrophe is a `Label`; the same text
        \\with a closing apostrophe is an `OpName`. Digits are legal after the
        \\first character of a label, so `'l1` is a label. An `OpName` becomes an
        \\ordinary identifier reference in an expression, which means a
        \\mistyped label with a stray closing quote is reported as an unbound
        \\name rather than as a syntax error.
    );
    code_block(71, "text", #string
        \\error: unbound 'foo'
        \\  --> quote.glo:2:27
        \\  |
        \\2 | main :: () { a := 1; b := 'foo'; }
        \\  |                           ^^^
        \\help: did you mean 'a'?
    );
    subheading(72, "The operator-token scanner");
    paragraph(73, #string,oneline
        \\`is_op_char` is exactly eighteen ASCII bytes:
        \\`+ - * / < > ! @ % ^ & | ~ ? . , : =`. Neither `#` nor `$` is in the
        \\set. `scan_operator_token` takes the longest run of those characters —
        \\maximal munch, with no table of known spellings — so the set of
        \\lexable operator tokens is unbounded: `~!`, `===`, `|>`, `@=`, `:+`
        \\and `.+` all lex without complaint, and rejection happens later in the
        \\checker.
    );
    paragraph(74, #string,oneline
        \\Ten cases are decided before the general scanner ever runs. They are
        \\the reason several spellings behave differently from what the operator
        \\character set alone predicts.
    );
    table_header(75, "Leading form   —   What the lexer does with it");
    table_row(76, #string,oneline
        \\`?`   |   Always emitted alone, before any operator scanning, so it
        \\never merges with a following character. `expr?.field`, `expr?,` and
        \\`expr?+1` need no separating space.
    );
    table_row(77, #string,oneline
        \\`@`   |   Emitted alone only when the next codepoint is not an
        \\operator character, and reserved in that form because it is pattern
        \\punctuation. Longer runs starting with `@` go to the general scanner
        \\and are free: `@=`, `@@` and `@>` can all be declared.
    );
    table_row(78, #string,oneline
        \\`:`   |   `::=`, `:$=`, `::` and `:=` are matched first, in that
        \\order. Otherwise, if the next codepoint is an operator character other
        \\than `*`, the whole run becomes an operator token; if it is `*` or a
        \\non-operator character, a lone `Colon` is emitted.
    );
    table_row(79, #string,oneline
        \\`$=`   |   A hard-coded two-character `Op` token, even though `$` is
        \\not an operator character and cannot appear in any other operator
        \\spelling.
    );
    table_row(80, #string,oneline
        \\`,,`   |   A fixed `CommaComma` token, matched before the rule that
        \\forbids `,` from starting an operator run.
    );
    table_row(81, #string,oneline
        \\`=`   |   Starts an operator token when followed by any operator
        \\character, which is how `==` and `=>` are lexed. Otherwise a lone
        \\`Equal`.
    );
    table_row(82, #string,oneline
        \\`..`   |   `...`, `..=` and `..` are fixed tokens taken before general
        \\scanning, so a longer run beginning with two dots can never form.
    );
    table_row(83, #string,oneline
        \\`.`   |   `.{`, `.[` and `.*` are fixed two-character tokens. A `.`
        \\followed by a backtick, an apostrophe, `(`, end of file, an
        \\alphanumeric or `_` is a lone `Dot`. Every other `.` enters the
        \\operator scanner.
    );
    table_row(84, #string,oneline
        \\`->`   |   A fixed `Arrow`, so no operator token can begin with a
        \\minus sign immediately followed by a greater-than sign.
    );
    table_row(85, #string,oneline
        \\`,`   |   Explicitly excluded from starting an operator run, and falls
        \\through to the single-character punctuation table.
    );
    subheading(86, "Two spellings the operator character set omits");
    paragraph(87, #string,oneline
        \\`$=` and `:$=` are complete, usable operator tokens whose spelling
        \\contains `$`, a character that is not in the operator set and that no
        \\general run can ever include. Both can be declared by a typeclass,
        \\implemented by an instance, and used infix like any other operator.
    );
    code_block(88, "glosso", #string
        \\#import "Io";
        \\
        \\Dol :: typeclass (L: type, R: type) {
        \\    Output :: type;
        \\    '$=' :: (left: L, right: R) -> Output #operator(left, 15);
        \\}
        \\
        \\(int, int) :: instance Dol {
        \\    Output :: int;
        \\    '$=' :: (left: int, right: int) -> Output {
        \\        return left * 100 + right;
        \\    }
        \\}
        \\
        \\main :: () { print("%\n", 3 $= 4); }
    );
    code_block(89, "text", #string
        \\304
    );
    paragraph(90, #string,oneline
        \\The same procedure with `':$='` in place of `'$='` and `3 :$= 4` in
        \\place of `3 $= 4` prints the same result. Neither spelling can be
        \\derived from the operator character list, and neither is reachable by
        \\extending an existing operator with an extra character.
    );
    paragraph(91, #string,oneline
        \\`,` is the mirror case. It is an operator character, but the dispatch
        \\refuses to let it begin an operator token. A run that began with some
        \\other operator character absorbs it all the same, so `'+,'` is a legal
        \\operator name and `3 +, 4` calls it.
    );
    code_block(92, "glosso", #string
        \\Cm :: typeclass (L: type, R: type) {
        \\    Output :: type;
        \\    '+,' :: (left: L, right: R) -> Output #operator(left, 15);
        \\}
    );
    subheading(93, "The trailing-dot strip");
    paragraph(94, #string,oneline
        \\Maximal munch would swallow a `.` that was meant to begin a member
        \\access or an aggregate literal, so the scanner pushes it back. If the
        \\run ends in `.` and the codepoint after it can begin a non-operator
        \\token — a backtick, an apostrophe, `(`, `{`, `[`, an alphanumeric, or
        \\`_` — the run is shortened by one and the `.` is left for the next
        \\token. Whether the strip happens is decided entirely by that one
        \\following codepoint, which is why a space changes the outcome.
    );
    code_block(95, "glosso", #string
        \\#import "Io";
        \\P :: struct { x: int; }
        \\Cat :: typeclass (L: type, R: type) { Output :: type;
        \\    '+++' :: (left: L, right: R) -> Output #operator(left, 17); }
        \\(P, P) :: instance Cat { Output :: P;
        \\    '+++' :: (left: P, right: P) -> Output { return left; } }
        \\main :: () { a := P.{ .x = 1 }; b := a +++.{ .x = 2 }; }
        \\
        \\// The second run replaces the last line with
        \\// main :: () { a := P.{ .x = 1 }; b := a +++. a; }
    );
    code_block(96, "text", #string
        \\error: struct literal needs a type
        \\  --> strip.glo:7:43
        \\  |
        \\7 | main :: () { a := P.{ .x = 1 }; b := a +++.{ .x = 2 }; }
        \\  |                                           ^^
        \\
        \\error: operator token cannot end with '.'
        \\  --> strip.glo:7:40
        \\  |
        \\7 | main :: () { a := P.{ .x = 1 }; b := a +++. a; }
        \\  |                                        ^^^^
    );
    paragraph(97, #string,oneline
        \\The first message is a checker complaint about the two-character `.{`
        \\token, which proves the operator token ended at `+++`. The second is
        \\the lexer refusing a four-character token. The rule the second one
        \\enforces is that no operator token may end in `.`, with exactly one
        \\exception: `..` itself. `..=` ends in `=` and is unaffected, and
        \\`.*` ends in `*`.
    );
    subheading(98, "Reserved operator tokens");
    paragraph(99, #string,oneline
        \\Fourteen spellings are refused as operator names wherever they are
        \\written, whether as a run of characters in an expression or inside an
        \\`'op'` name: `=`, `.`, `,`, `,,`, `:=`, `::`, `:`, `->`, `::=`, `.*`,
        \\`...`, `@`, `` ` `` and `` `` ``. The message is uniform.
    );
    code_block(100, "text", #string
        \\error: reserved operator token '.*' (operator '.*' cannot be overloaded)
    );
    paragraph(101, #string,oneline
        \\Everything else lexes. Whether it is usable is a checker question:
        \\a free-standing operator declaration compiles as far as the checker
        \\and then fails with `error: operator '~!' must be declared by a
        \\typeclass and implemented by its instances`. Operator Declarations
        \\covers that requirement; the lexical point is that the token itself was
        \\never in doubt.
    );
    subheading(102, "The lexer diagnostics");
    paragraph(103, #string,oneline
        \\The lexer raises errors at twenty-two sites producing twenty-three
        \\message spellings. The separator message is emitted from one site with
        \\four different part names, and two messages are emitted from two
        \\scanners each — the operator run and the `'op'` name share both the
        \\reserved-token check and the trailing-dot check. Every message below
        \\is complete as printed, after `diagnostic_render` has removed the
        \\internal `lex error line N: ` prefix.
    );
    table_header(104, "Message   —   Trigger, and where the rule is explained");
    table_row(105, #string,oneline
        \\`'<character>'`   |   Any codepoint that is not whitespace, an
        \\operator character, alphabetic, a digit, `_`, or one of the
        \\single-character punctuation marks. Covers a stray `\`, a backtick not
        \\followed by a name, a byte-order mark, a no-break space, a form feed
        \\and a vertical tab. This chapter.
    );
    table_row(106, #string,oneline
        \\`reserved operator token 'X' (operator 'X' cannot be overloaded)`   |
        \\  One of the fourteen reserved spellings appeared where an operator
        \\token was being formed. Also the message for `1.`. Operator
        \\Declarations.
    );
    table_row(107, #string,oneline
        \\`operator token cannot end with '.'`   |   A finished operator token
        \\ends in `.` and is not `..`. Fires only when the trailing-dot strip
        \\did not apply. Operator Declarations.
    );
    table_row(108, #string,oneline
        \\`unterminated string literal`   |   `scan_string` reached the end of
        \\the file without a closing quote. Raw line feeds inside the literal
        \\are legal, so the run can be long. String Literals.
    );
    table_row(109, #string,oneline
        \\`#char expects a string literal`   |   The first codepoint after
        \\`#char` and any run of spaces and tabs is not `"`. A line feed between
        \\the directive and the quote triggers this. Character Literals.
    );
    table_row(110, #string,oneline
        \\`unterminated #char string literal`   |   No closing quote before the
        \\end of the file. Also the message for a source ending in a lone
        \\backslash inside the literal. Character Literals.
    );
    table_row(111, #string,oneline
        \\`#char expects one character`   |   The literal is empty: `#char ""`.
        \\Character Literals.
    );
    table_row(112, #string,oneline
        \\`#char expects an escape character`   |   Unreachable. No source can
        \\produce it; see the note below the table.
    );
    table_row(113, #string,oneline
        \\`#char string literal contains more than two characters`   |   The
        \\scanned value did not consume the whole literal, so `#char "ab"` and
        \\`#char "\na"` both trip it. Character Literals.
    );
    table_row(114, #string,oneline
        \\`invalid '_' separator in number literal`   |   An underscore leads,
        \\trails or repeats in the leading decimal run. `1_abc` reaches this,
        \\because the underscore is consumed by the number. Integer Literals.
    );
    table_row(115, #string,oneline
        \\`invalid '_' separator in base integer literal`   |   The same rule in
        \\the digit run after `base#`, as in `16#_ff`. Integer Literals.
    );
    table_row(116, #string,oneline
        \\`invalid '_' separator in fractional literal`   |   The same rule in
        \\the digits after `.`, as in `1.2_`. Floating-Point Literals.
    );
    table_row(117, #string,oneline
        \\`invalid '_' separator in scientific exponent`   |   The same rule in
        \\the digits after `e` or `E`, as in `1e1__0`. Floating-Point Literals.
    );
    table_row(118, #string,oneline
        \\`legacy '0x' integer literals are not supported; use '16#digits'`   |
        \\  A literal beginning `0x` or `0X`. Detected before general scanning,
        \\so the whole run is spanned. Integer Literals.
    );
    table_row(119, #string,oneline
        \\`legacy '0b' integer literals are not supported; use '2#digits'`   |
        \\  A literal beginning `0b` or `0B`. Integer Literals.
    );
    table_row(120, #string,oneline
        \\`integer literal base must be between 2 and 36, got X`   |   The text
        \\before `#` is outside 2..=36 after underscores are stripped, as in
        \\`40#zz`. The message echoes the base as written. Integer Literals.
    );
    table_row(121, #string,oneline
        \\`base-N integer literal needs at least one digit`   |   Nothing
        \\followed `#`, as in `16#`. Integer Literals.
    );
    table_row(122, #string,oneline
        \\`digit 'X' is not valid for base N`   |   A digit's value is not less
        \\than the base, as in `2#5`. Letter digits fold case, so `16#FF` and
        \\`16#ff` are the same value. Integer Literals.
    );
    table_row(123, #string,oneline
        \\`base-N integer literal does not fit in 128 bits`   |   The magnitude
        \\overflows `u128` in a based literal. The cap is lexical and applies
        \\before any destination type is known. 128-Bit Integers.
    );
    table_row(124, #string,oneline
        \\`integer literal 'X' does not fit in 128 bits`   |   The same cap for
        \\a decimal literal; the message quotes the digits with underscores
        \\removed. 128-Bit Integers.
    );
    table_row(125, #string,oneline
        \\`scientific number literal needs exponent digits after 'e' or 'E'`
        \\  |   An `e` or `E` was consumed but no digits followed, as in `1e`
        \\or `1e+`. Floating-Point Literals.
    );
    table_row(126, #string,oneline
        \\`invalid scientific number literal 'X'`   |   The assembled float text
        \\failed to parse as `f64`. Not reachable by any known spelling: the
        \\scanner has already validated the digits, and an overflowing exponent
        \\such as `1e999999999999999999999` parses to infinity rather than
        \\failing.
    );
    table_row(127, #string,oneline
        \\`number literals must use ASCII digits`   |   The token started with a
        \\Unicode numeric that is not an ASCII digit, such as `²`, and no base
        \\or exponent turned it into another form. This chapter.
    );
    note(128, #string,oneline
        \\`#char expects an escape character` cannot fire. It requires a
        \\backslash at the start of the literal with exactly one codepoint left,
        \\but the scan loop always advances two codepoints over a backslash
        \\pair, so that state is never reached; a source that ends inside the
        \\escape trips `unterminated #char string literal` first. It is listed
        \\for completeness and should not be searched for.
    );
    subheading(129, "Lexical forms that do not exist");
    bullet(130, #string,oneline
        \\No `0x` or `0b` prefix, in any case combination, and no octal prefix.
        \\A leading zero carries no meaning either: `0777` is decimal 777. The
        \\based form `base#digits` replaces all of them.
    );
    bullet(131, #string,oneline
        \\No typed literal suffix. `255u8`, `1.0f` and `10L` are two tokens
        \\each, and the second one is checked as an ordinary name.
    );
    bullet(132, #string,oneline
        \\No imaginary or complex literal spelling. There is no `i` or `j`
        \\marker and no dedicated token; complex values are constructed from
        \\ordinary aggregates.
    );
    bullet(133, #string,oneline
        \\No leading-dot or trailing-dot float, and no hexadecimal float.
    );
    bullet(134, #string,oneline
        \\No doc-comment form. There is no `///`, no `/**`, and no comment
        \\directive; comments never attach metadata to a declaration.
    );
    bullet(135, #string,oneline
        \\No raw-string quote form. The only source form that suppresses escape
        \\decoding is a `#string` block, and it is the `escape` modifier that
        \\turns decoding back on.
    );
    bullet(136, #string,oneline
        \\No character-literal quote form. `'a'` is an operator name, not a
        \\character; `#char "a"` is the character literal.
    );
    bullet(137, #string,oneline
        \\No line-continuation marker. A statement spans lines because the
        \\grammar is delimited by `;` and braces, not because a line ends in a
        \\continuation character.
    );
    note(138, #string,oneline
        \\Block-comment nesting is a depth counter with no lexical awareness of
        \\line comments or string literals, so a `*/` written inside a `//` line
        \\inside a block still closes the block. `/* // */ */` closes at the
        \\first `*/` and leaves a stray one behind, reported as `error: bad decl
        \\name '*/'`. Commenting out code that contains `*/` in a comment or a
        \\string requires checking for that sequence first.
    );
}
