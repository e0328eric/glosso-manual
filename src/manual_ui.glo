// Section dispatch, navigation, document layout, and Wasm entry point.

render_section_case :: (index: s64) -> Code {
    renderer_call := tprint("render_section_%();", format_int(index, 10));
    return #code {
        case ``index;
            #insert renderer_call;
    };
}

render_selected_section :: () {
    #insert #code {
        if selected_section == {
            #inline for index: 0..SECTION_COUNT {
                #insert render_section_case(index);
            }
            else;
        }
    };
}


render_navigation_row :: (index: s32) {
    id := Clay_GetElementIdWithIndex(clay_string("nav-row"), cast(u32)index);
    row := column_box();
    row.layout.padding = padding(12, 9);
    if index == selected_section {
        row.backgroundColor = color(255, 253, 248);
        row.border.color = color(36, 73, 216);
        row.border.width.left = 2;
    } else if Clay_PointerOver(id) {
        row.backgroundColor = color(255, 253, 248);
    }
    open_id(id, row);
    if index == selected_section {
        emit_text(section_title(index), text_style(13, color(36, 73, 216), FONT_SANS_BOLD, 20));
    } else {
        emit_text(section_title(index), text_style(13, color(109, 107, 102), FONT_SANS, 20));
    }
    close_element();
}

navigation_start :: () -> s32 {
    start := selected_section - 4;
    if start < 0 start = 0;
    if start > SECTION_COUNT - 9 start = SECTION_COUNT - 9;
    if start < 0 start = 0;
    return start;
}

handle_manual_navigation :: () {
    i: s32 = 0;
    while i < SECTION_COUNT {
        id := Clay_GetElementIdWithIndex(clay_string("nav-row"), cast(u32)i);
        if Clay_PointerOver(id) selected_section = i;
        i = i + 1;
    }
    if selected_section > 0 &&
       Clay_PointerOver(Clay_GetElementId(clay_string("previous-section"))) {
        selected_section = selected_section - 1;
    }
    if selected_section + 1 < SECTION_COUNT &&
       Clay_PointerOver(Clay_GetElementId(clay_string("next-section"))) {
        selected_section = selected_section + 1;
    }
}

handle_navigation :: () {
    pointer := Clay_GetPointerState();
    if pointer.state != CLAY_POINTER_DATA_RELEASED_THIS_FRAME return;
    clear_scroll_target();
    previous_view := app_view;
    previous_section := selected_section;
    previous_module := selected_module;
    previous_module_page := module_page;
    previous_symbol_page := symbol_page;
    previous_search_page := search_page;
    if app_view == APP_VIEW_MANUAL {
        handle_manual_navigation();
    } else if app_view == APP_VIEW_STANDARD_LIBRARY {
        handle_standard_navigation();
    } else {
        handle_search_navigation();
    }
    // Anything that swapped the article for a different one starts at the top
    // unless the click asked for a specific declaration.
    if scroll_request != SCROLL_REQUEST_NONE return;
    if app_view != previous_view ||
       selected_section != previous_section ||
       selected_module != previous_module ||
       module_page != previous_module_page ||
       symbol_page != previous_symbol_page ||
       search_page != previous_search_page {
        scroll_request = SCROLL_REQUEST_TOP;
    }
}

render_manual_sidebar :: (height: f32) {
    // Navigation is rendered as a native DOM sidebar by app.js. Clay keeps
    // this lightweight placeholder so the article retains the same grid.
    sidebar := column_box();
    sidebar.layout.sizing.width = grow_axis();
    sidebar.layout.sizing.height = fixed_axis(height);
    sidebar.backgroundColor = color(238, 233, 223);
    open_element("manual-sidebar", sidebar);
    close_element();
}

render_pager_button :: (name: string, label: string, enabled: bool) {
    button := column_box();
    button.layout.sizing.width = grow_axis();
    button.layout.padding = padding(16, 13);
    button.backgroundColor = color(244, 240, 232);
    button.cornerRadius = radius(0);
    button.border.color = color(216, 209, 197);
    button.border.width.left = 1;
    button.border.width.right = 1;
    button.border.width.top = 1;
    button.border.width.bottom = 1;
    open_element(name, button);
    if enabled {
        emit_text(label, text_style(13, color(36, 73, 216), FONT_SANS_BOLD, 21));
    } else {
        emit_text(label, text_style(13, color(169, 166, 159), FONT_SANS_BOLD, 21));
    }
    close_element();
}

render_article :: () {
    article := column_box(24);
    article.layout.padding = padding(52, 42);
    article.backgroundColor = color(255, 253, 248);
    open_element("manual-article", article);

    if app_view == APP_VIEW_MANUAL {
        emit_text(#string,oneline
            \\GLOSSO LANGUAGE MANUAL
        , text_style(11, color(36, 73, 216), FONT_MONO_BOLD, 18));
        emit_text(
            section_title(selected_section),
            text_style(48, color(23, 26, 31), FONT_SERIF_BOLD, 52),
        );
        render_selected_section();
        finish_content_table();

        pager: Clay_ElementDeclaration;
        pager.layout.sizing.width = grow_axis();
        pager.layout.sizing.height = fit_axis();
        pager.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
        pager.layout.childGap = 12;
        pager.layout.padding = padding(0, 14);
        open_element("manual-pager", pager);
        render_pager_button("previous-section", #string,oneline
            \\← Previous chapter
        , selected_section > 0);
        render_pager_button("next-section", #string,oneline
            \\Next chapter →
        , selected_section + 1 < SECTION_COUNT);
        close_element();
    } else if app_view == APP_VIEW_STANDARD_LIBRARY {
        render_standard_article();
    } else {
        render_search_article();
    }
    close_element();
}

current_view_label :: () -> string {
    if app_view == APP_VIEW_STANDARD_LIBRARY return "Standard library reference";
    if app_view == APP_VIEW_SEARCH return "Documentation search";
    return "Language manual";
}

render_status_rail :: () {
    rail := column_box(22);
    rail.layout.sizing.width = grow_axis();
    rail.layout.padding = padding(28, 42);
    rail.backgroundColor = color(244, 240, 232);
    rail.border.color = color(216, 209, 197);
    rail.border.width.left = 1;
    open_element("reference-rail", rail);
    emit_text("REFERENCE STATUS", text_style(11, color(109, 107, 102), FONT_SANS_BOLD, 18));
    emit_text("Glosso + Clay", text_style(14, color(23, 26, 31), FONT_SANS_BOLD, 22));
    emit_text("Freestanding WebAssembly", text_style(13, color(109, 107, 102), FONT_SANS, 21));
    emit_text("Source links", text_style(14, color(23, 26, 31), FONT_SANS_BOLD, 22));
    emit_text("Private repository", text_style(13, color(109, 107, 102), FONT_SANS, 21));
    emit_text("Search corpus", text_style(14, color(23, 26, 31), FONT_SANS_BOLD, 22));
    emit_text(tprint("% symbols", STD_SYMBOL_COUNT), text_style(13, color(109, 107, 102), FONT_SANS, 21));
    close_element();
}

render_document :: (width: f32, height: f32) {
    reference_viewport_width = width;
    root := column_box();
    root.layout.sizing.width = fixed_axis(width);
    root.backgroundColor = color(244, 240, 232);
    open_element("manual-root", root);

    body: Clay_ElementDeclaration;
    body.layout.sizing.width = grow_axis();
    body.layout.sizing.height = fit_axis();
    body.layout.childGap = 0;
    if width < 860.0 {
        body.layout.layoutDirection = CLAY_TOP_TO_BOTTOM;
    } else {
        body.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    }
    open_element("manual-body", body);

    if app_view != APP_VIEW_SEARCH {
        sidebar_wrap := column_box();
        if width < 860.0 {
            sidebar_wrap.layout.sizing.width = grow_axis();
        } else {
            sidebar_wrap.layout.sizing.width = fixed_axis(270);
        }
        open_element("sidebar-wrap", sidebar_wrap);
        sidebar_height := height;
        if width < 860.0 sidebar_height = 320;
        if app_view == APP_VIEW_MANUAL {
            render_manual_sidebar(sidebar_height);
        } else {
            render_standard_sidebar(sidebar_height);
        }
        close_element();
    }

    article_wrap := column_box();
    if app_view == APP_VIEW_SEARCH {
        article_wrap.layout.sizing.width = grow_axis(320, 1100);
    } else {
        article_wrap.layout.sizing.width = grow_axis(320, 880);
    }
    open_element("article-wrap", article_wrap);
    render_article();
    close_element();

    if width >= 1400.0 && app_view != APP_VIEW_SEARCH {
        rail_wrap := column_box();
        rail_wrap.layout.sizing.width = grow_axis(180, 250);
        open_element("rail-wrap", rail_wrap);
        render_status_rail();
        close_element();
    }

    close_element();
    close_element();
}

main :: (
    width: f32,
    height: f32,
    pointer_x: f32,
    pointer_y: f32,
    pointer_down: bool,
    delta_time: f32,
) -> Clay_RenderCommandArray #c_call {
    if width < -1.0 manual_keep_browser_exports_reachable();

    dimensions: Clay_Dimensions;
    dimensions.width = width;
    // The browser document owns vertical scrolling. Giving Clay only the
    // viewport height makes its root compress FIT children to their one-line
    // minimums while wrapped text still emits every line, causing overlaps.
    // Use a generous document-layout ceiling; the host sizes #scene to the
    // actual final render-command bounds.
    dimensions.height = 1000000;
    Clay_SetLayoutDimensions(dimensions);

    pointer: Clay_Vector2;
    pointer.x = pointer_x;
    pointer.y = pointer_y;
    Clay_SetPointerState(pointer, pointer_down);
    handle_navigation();

    // The HTML renderer uses the browser document as the scroll container.
    // Emit off-screen commands so the host can size #scene to the full chapter.
    Clay_SetCullingEnabled(false);
    reset_frame_text_storage();
    content_table_open = false;
    Clay_BeginLayout();
    render_document(width, height);
    return Clay_EndLayout(delta_time);
}
