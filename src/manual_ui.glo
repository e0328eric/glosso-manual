// Shared by the embedded files in the manual ownership unit.
#public(unit) {
// Section dispatch, navigation, document layout, and Wasm entry point.

render_section_case :: (index: ssize) -> Code {
    // Formatting is evaluated while #insert generates the section dispatch.
    renderer_call := tprint("render_section_{}();", index);
    return #code {
        case ``index;
            #insert renderer_call;
    };
}

render_selected_section :: () {
    #insert #code {
        if selected_section == {
            #inline for index: 0..SECTION_COUNT {
                #insert render_section_case(index);
            }
            else;
        }
    };
}


render_manual_index :: () {
    emit_text("Language manual", heading_text_style(26, true));
    paragraph(9300, "The Glosso language manual describes the language from a first program to its type system, compile-time programming, memory contracts, and compiler tools.");
    subheading(9301, "How to read this manual");
    paragraph(9302, "Start with Hello World and Program Entry, then follow the chapters in order. For a particular language feature, browse the chapter list or search by name. The Standard library section documents modules and their public APIs.");
    render_section_heading(9303, "Chapters", SECTION_COUNT);
    list := column_box();
    open_element("manual-index-list", list);
    for index: 0..SECTION_COUNT {
        row := column_box(12);
        row.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
        row.layout.padding = padding(0, 5);
        open_indexed("manual-index-row", cast(s32)index, row);
        number := column_box();
        number.layout.sizing.width = fixed_axis(36);
        open_indexed("manual-index-number", cast(s32)index, number);
        emit_text(tprint("{}", index + 1), text_style(13, color(109, 107, 102), FONT_MONO, 24));
        close_element();
        emit_text(section_title(cast(s32)index), route_text_style(APP_VIEW_MANUAL, cast(s32)index));
        close_element();
    }
    close_element();
}

handle_manual_navigation :: () {
    if selected_section < 0 {
        for index: 0..SECTION_COUNT {
            if Clay_PointerOver(Clay_GetElementIdWithIndex(clay_string("manual-index-row"), cast(u32)index)) {
                manual_select_section(cast(s32)index);
                return;
            }
        }
        return;
    }
    i: s32 = 0;
    while i < SECTION_COUNT {
        id := Clay_GetElementIdWithIndex(clay_string("nav-row"), cast(u32)i);
        if Clay_PointerOver(id) selected_section = i;
        i = i + 1;
    }
    if selected_section > 0 &&
       Clay_PointerOver(Clay_GetElementId(clay_string("previous-section"))) {
        selected_section = selected_section - 1;
    }
    if selected_section + 1 < SECTION_COUNT &&
       Clay_PointerOver(Clay_GetElementId(clay_string("next-section"))) {
        selected_section = selected_section + 1;
    }
}

handle_navigation :: () {
    pointer := Clay_GetPointerState();
    if pointer.state != CLAY_POINTER_DATA_RELEASED_THIS_FRAME return;
    // The first frame starts in the released state too. A browser route may
    // already have selected an item; retain its pending scroll target.
    if scroll_request != SCROLL_REQUEST_NONE return;
    clear_scroll_target();
    previous_view := app_view;
    previous_section := selected_section;
    previous_module := selected_module;
    previous_symbol := selected_symbol;
    previous_type := selected_type;
    previous_search_page := search_page;
    if app_view == APP_VIEW_MANUAL {
        handle_manual_navigation();
    } else if app_view == APP_VIEW_STANDARD_LIBRARY {
        handle_standard_navigation();
    } else {
        handle_search_navigation();
    }
    // Anything that swapped the article for a different one starts at the top
    // unless the click asked for a specific declaration.
    if scroll_request != SCROLL_REQUEST_NONE return;
    if app_view != previous_view ||
       selected_section != previous_section ||
       selected_module != previous_module ||
       selected_symbol != previous_symbol ||
       selected_type != previous_type ||
       search_page != previous_search_page {
        scroll_request = SCROLL_REQUEST_TOP;
    }
}

render_pager_button :: (name: string, label: string, enabled: bool) {
    button := column_box();
    button.layout.sizing.width = grow_axis();
    button.layout.padding = padding(12, 9);
    button.backgroundColor = color(255, 253, 248);
    button.cornerRadius = radius(0);
    button.border.color = color(216, 209, 197);
    button.border.width.left = 1;
    button.border.width.right = 1;
    button.border.width.top = 1;
    button.border.width.bottom = 1;
    open_element(name, button);
    if enabled {
        emit_text(label, action_text_style(text_style(13, color(36, 73, 216), FONT_SANS_BOLD, 21)));
    } else {
        emit_text(label, action_text_style(text_style(13, color(169, 166, 159), FONT_SANS_BOLD, 21), false));
    }
    close_element();
}

render_article :: () {
    article := column_box(16);
    article.layout.padding = padding(32, 12);
    if document_viewport_width < 860.0 article.layout.padding = padding(16, 12);
    article.layout.sizing.width = fixed_axis(article_content_width() + 64);
    if document_viewport_width < 860.0 article.layout.sizing.width = fixed_axis(article_content_width() + 32);
    article.backgroundColor = color(255, 253, 248);
    open_element("manual-article", article);

    if app_view == APP_VIEW_MANUAL && selected_section < 0 {
        render_manual_index();
    } else if app_view == APP_VIEW_MANUAL {
        emit_text("Language manual", route_text_style(APP_VIEW_MANUAL, -1, 13));
        emit_text(section_title(selected_section), heading_text_style(26, true));
        render_selected_section();
        finish_content_table();

        pager: Clay_ElementDeclaration;
        pager.layout.sizing.width = grow_axis();
        pager.layout.sizing.height = fit_axis();
        pager.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
        pager.layout.childGap = 12;
        pager.layout.padding = padding(0, 14);
        open_element("manual-pager", pager);
        render_pager_button("previous-section", #string,oneline
            \\← Previous chapter
        , selected_section > 0);
        render_pager_button("next-section", #string,oneline
            \\Next chapter →
        , selected_section + 1 < SECTION_COUNT);
        close_element();
    } else if app_view == APP_VIEW_STANDARD_LIBRARY {
        render_standard_article();
    } else {
        render_search_article();
    }
    close_element();
}

render_document :: (width: f32, height: f32) {
    reference_viewport_width = width;
    document_viewport_width = width;
    root := column_box();
    root.layout.sizing.width = fixed_axis(width);
    root.backgroundColor = color(255, 253, 248);
    open_element("manual-root", root);

    body := column_box();
    body.layout.layoutDirection = CLAY_LEFT_TO_RIGHT;
    open_element("manual-body", body);
    // The fixed native sidebar occupies this column in every desktop view.
    // Mobile navigation overlays the document and reserves no article height.
    if width >= 860.0 {
        sidebar := column_box();
        sidebar.layout.sizing.width = fixed_axis(200);
        open_element("sidebar-wrap", sidebar);
        close_element();
    }
    article_wrap := column_box();
    article_wrap.layout.sizing.width = grow_axis(0, 1100);
    open_element("article-wrap", article_wrap);
    render_article();
    close_element();
    close_element();
    close_element();
}

main :: (
    width: f32,
    height: f32,
    pointer_x: f32,
    pointer_y: f32,
    pointer_down: bool,
    delta_time: f32,
) -> Clay_RenderCommandArray #c_call {
    if width < -1.0 manual_keep_browser_exports_reachable();

    dimensions: Clay_Dimensions;
    dimensions.width = width;
    // The browser document owns vertical scrolling. Giving Clay only the
    // viewport height makes its root compress FIT children to their one-line
    // minimums while wrapped text still emits every line, causing overlaps.
    // Use a generous document-layout ceiling; the host sizes #scene to the
    // actual final render-command bounds.
    dimensions.height = 1000000;
    Clay_SetLayoutDimensions(dimensions);

    pointer: Clay_Vector2;
    pointer.x = pointer_x;
    pointer.y = pointer_y;
    Clay_SetPointerState(pointer, pointer_down);
    handle_navigation();

    // The HTML renderer uses the browser document as the scroll container.
    // Emit off-screen commands so the host can size #scene to the full chapter.
    Clay_SetCullingEnabled(false);
    // Each layout reuses the frame text buffer for different chapter or
    // reference content. Retire cached words before reusing that storage;
    // retaining them across navigation can corrupt subsequent wrapped lines.
    Clay_ResetMeasureTextCache();
    reset_frame_text_storage();
    content_table_open = false;
    Clay_BeginLayout();
    render_document(width, height);
    return Clay_EndLayout(delta_time);
}

}
