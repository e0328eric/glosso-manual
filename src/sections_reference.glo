// Sections 142-145: reference.

render_section_142 :: () {
    paragraph(0, #string,oneline
        \\The standard library is a directory of ordinary Glosso source files
        \\that ships beside the compiler. Nothing in it is privileged: every
        \\module is written in the language the manual describes, and the
        \\compiler finds it by searching for a directory that contains
        \\`Prelude.glo` or a `Prelude/` subdirectory. Where that search looks,
        \\and how `--std` overrides it, is covered in the chapter on the
        \\environment and toolchain.
    );
    paragraph(1, #string,oneline
        \\This chapter is the map: what is in the tree, which names can be
        \\imported, and how to find the module that owns an operation. The
        \\import forms themselves belong to the chapter on source files,
        \\imports, and loads.
    );
    subheading(2, "How a module name resolves");
    paragraph(3, #string,oneline
        \\`#import "Name"` is resolved against the standard-library root by one
        \\rule, applied to the two candidate paths `std/Name.glo` and
        \\`std/Name/module.glo`.
    );
    bullet(4, #string,oneline
        \\If `std/Name.glo` exists, the module is that one file.
    );
    bullet(5, #string,oneline
        \\If `std/Name/module.glo` exists, the module is every `.glo` file
        \\directly inside `std/Name/`, in file-name order. The sweep is not
        \\recursive, so a nested directory such as `Math/Bignum` is a module of
        \\its own and is never pulled in by its parent.
    );
    bullet(6, #string,oneline
        \\If both exist the name is ambiguous, and if neither exists the name
        \\is unknown. Both outcomes are hard errors.
    );
    code_block(7, "text", #string
        \\error: cannot find module "Container" (looked for std/Container.glo or std/Container/module.glo)
        \\
        \\error: ambiguous module "Ascii": both …\mystd\Ascii.glo and …\mystd\Ascii\module.glo exist
    );
    paragraph(8, #string,oneline
        \\A module name is a relative path with `/` separators, so
        \\`Container/HashMap` names the file `std/Container/HashMap.glo` and the
        \\same rule applies one level down. The name is validated before the
        \\lookup: an absolute path, a backslash, a `..` component, or an empty
        \\component is rejected outright.
    );
    subheading(9, "Namespaces are not modules");
    paragraph(10, #string,oneline
        \\Because the rule keys on `module.glo`, a directory that does not have
        \\one is a namespace and not a module. Its components are still
        \\importable one at a time by path; the directory name itself is not.
        \\That is the whole difference between `#import "Memory"`, which works,
        \\and `#import "Container"`, which does not.
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\#import "Container/HashMap";
        \\#import "Strings/Utf8";
        \\
        \\main :: () {
        \\    counts := hash_map_with_seed(string, s64, 1, 2);
        \\    defer hash_map_deinit(*counts);
        \\    if hash_map_insert(*counts, "glosso", 42) == {
        \\    case .Ok(r);      print("inserted, len = %\n", hash_map_len(counts));
        \\    case .Err(error); print("insert failed\n");
        \\    }
        \\    print("upper = %\n", to_upper("glosso"));
        \\}
    );
    code_block(12, "text", #string
        \\inserted, len = 1
        \\upper = GLOSSO
    );
    paragraph(13, #string,oneline
        \\One name breaks the rule. `Math` is a namespace directory with no
        \\`module.glo`, but the driver rewrites the module name `Math` to
        \\`Math/Core` before the lookup runs, so scalar mathematics is reachable
        \\under its short name.
    );
    code_block(14, "glosso", #string
        \\#import "Io";
        \\#import "Math";
        \\
        \\main :: () {
        \\    print("%\n", sqrt(2.0));
        \\}
    );
    code_block(15, "text", #string
        \\1.414214
    );
    note(16, #string,oneline
        \\`Math` is the only rewritten name. No other namespace directory has a
        \\shorthand, and adding one would require a compiler change rather than
        \\a library change.
    );
    subheading(17, "Modules that are one file");
    paragraph(18, #string,oneline
        \\These fifteen names resolve to a single `.glo` file at the top of the
        \\tree, and each imports on its own.
    );
    table_header(19, "Module   —   Purpose");
    table_row(20, "`Ascii`   |   ASCII byte classification and case folding, all over `u8`.");
    table_row(21, "`Bindgen`   |   Compile-time generation of bindings from a C header.");
    table_row(22, "`Compiler`   |   The compile-time build API: nested compiles, C archives, build options.");
    table_row(23, "`Context`   |   The allocator procedures and constructors behind the implicit `context`.");
    table_row(24, "`File_System`   |   Filesystem prelude: typed handles, paths, metadata, directories.");
    table_row(25, "`Format`   |   String formatting entry points, including `format_int`.");
    table_row(26, "`Html`   |   Lightweight HTML parsing, crawling, and extraction.");
    table_row(27, "`Io`   |   The stream umbrella: `print`, writers, readers, scanning, files.");
    table_row(28, "`Jump`   |   Explicit control transfer over resumable execution contexts.");
    table_row(29, "`Process`   |   Process prelude: ids, executable path, exit status, abort.");
    table_row(30, "`Simd`   |   Portable fixed-width vector values, `Simd(T, N)`.");
    table_row(31, "`String_Builder`   |   Compile-time and runtime string building, including `str_cat`.");
    table_row(32, "`Terminal`   |   A dependency-free terminal and TUI toolkit.");
    table_row(33, "`Thread`   |   Native threading primitives layered on `Os`.");
    table_row(34, "`VarArg`   |   C ABI `va_list` support: `Va_List`, `start`, `arg`, `end`.");
    subheading(35, "Modules that are a directory");
    paragraph(36, #string,oneline
        \\These thirteen directories carry a `module.glo`, so the whole
        \\directory imports as one unit. `module.glo` is often nothing but
        \\`#load` lines, and in two cases it is a single `#insert` that builds
        \\native code on demand.
    );
    table_header(37, "Module   —   Purpose");
    table_row(38, "`Gui`   |   Cross-platform software-rendered GUI over the bundled RGFW.");
    table_row(39, "`Lua`   |   The Lua 5.5 C API, with a static runtime built from bundled sources.");
    table_row(40, "`Math/Bignum`   |   Arbitrary-precision `BigInt` and `BigFloat`.");
    table_row(41, "`Math/SpecialFunctions`   |   Airy, Bessel, gamma, hypergeometric, integrals, zeta and polylog.");
    table_row(42, "`Memory`   |   Raw memory operations and generic slice algorithms.");
    table_row(43, "`Meta`   |   Compile-time type introspection and folded intrinsics.");
    table_row(44, "`Os`   |   The target OS primitive boundary: threads, clocks, syscalls.");
    table_row(45, "`Prelude`   |   Loaded automatically for every program; see the chapter on the implicit prelude.");
    table_row(46, "`Random`   |   Deterministic engines, OS entropy, sampling, distributions.");
    table_row(47, "`Sort`   |   Sorting, ordered search, heaps, deterministic permutations.");
    table_row(48, "`Time`   |   Clocks, durations, civil calendars, text formats, TZif zones.");
    table_row(49, "`Typeclass`   |   `Functor`, `Applicative`, `Monad`, `Try`, `Error`, `Termination`, `Derive`.");
    table_row(50, "`Unicode`   |   UTF-8 helpers plus the generated character tables.");
    subheading(51, "Namespace directories");
    paragraph(52, #string,oneline
        \\These six directories have no `module.glo` and no sibling file, so the
        \\directory name is not importable at all. Every component listed is
        \\importable by path, subject to the caveat below.
    );
    table_header(53, "Directory   —   Components");
    table_row(54, "`Container`   |   `BTreeMap`, `BTreeSet`, `BinaryHeap`, `Deque`, `LinkedList`, `HashMap`, `HashSet`, `Hash`, `Error`.");
    table_row(55, "`Crypto`   |   `Aes`, `AesGcm`, `ChaCha20`, `ChaCha20Poly1305`, `Poly1305`, `Sha1`, `Sha2`, `Sha3`, `Hmac`, `Kdf`, `ConstantTime`, `Encoding`, `Random`, `Error`.");
    table_row(56, "`Math`   |   `Core`, `Constants`, `Bit`, `Complex`, `Matrix`, `NumberTheory`.");
    table_row(57, "`Net`   |   `Address`, `Socket`, `Poll`, `Async`, `Dns`, `Dns_Types`, `Resolver`, `Hosts`, `Interface`, `Platform`, `Url`, `Encoding`, `Http`, `Http_Types`, `Http_Auth`, `Http_Server`, `Https`, `Tls`, `Certificate`, `Trust_Store`, `WebSocket`, `Types`.");
    table_row(58, "`Serialization`   |   `Core`, `Json`, `Toml`, `Yaml`, `MessagePack`.");
    table_row(59, "`Strings`   |   `Utf8`, `Utf16`.");
    paragraph(60, #string,oneline
        \\Three names are both a file and a directory. The file is what
        \\`#import` resolves to, because the directory has no `module.glo`; the
        \\directory holds the components that the file deliberately leaves out.
    );
    table_header(61, "Module   —   Included by the file   —   Explicit only");
    table_row(62, "`File_System`   |   `Types`, `Path`, `File`, `Directory`, `Metadata`, `System`   |   `Copy`, `Temporary`, `Atomic`, `Walk`, `Map`, `Watch`, `Sandbox`, `Native`");
    table_row(63, "`Io`   |   `Core`, `Transfer`, `Adapters`, `Buffer`, `Scan`, `Vector`, `Binary`, `Hash`, `Format`, `Terminal`   |   none");
    table_row(64, "`Process`   |   the small prelude only   |   `Arguments`, `Child`, `Command`, `Environment`, `Inspection`, `Limits`, `Pipe`, `Scheduling`, `Signals`, `System`, `User`");
    note(65, #string,oneline
        \\A component of an aggregate module is not always importable on its
        \\own. Importing one file of a module that was written to be assembled
        \\by `module.glo` leaves the other files behind, and the missing halves
        \\surface as ordinary unknown-name errors: `#import "Time/Core"` gives
        \\`error: unknown type 'Duration'`, `#import "Random/Engines"` gives
        \\`error: unknown function __random_load_le32`, and
        \\`#import "Sort/Heap"` gives `error: unknown type 'Sort_Error'`. For
        \\`Time`, `Random`, `Sort`, `Os`, `Unicode`, `Memory` and
        \\`Math/SpecialFunctions` the module is the unit.
    );
    subheading(66, "Finding the module that owns an operation");
    paragraph(67, #string,oneline
        \\Nothing outside the prelude is in scope until it is imported, so a
        \\missing import shows up as an unbound name rather than a link error.
        \\The compiler suggests the closest name it can already see, which is a
        \\hint about spelling and not about the module.
    );
    code_block(68, "text", #string
        \\error: unknown function sqrt
        \\  --> …\miss.glo:4:18
        \\  |
        \\4 |     print("%\n", sqrt(2.0));
        \\  |                  ^^^^
        \\help: did you mean 'seek'?
    );
    paragraph(69, #string,oneline
        \\The direct way to see what a module exports is to ask for a name it
        \\does not have. A failed `#import,only` names the module's entire
        \\public surface in a note, which makes it a usable index.
    );
    code_block(70, "text", #string
        \\error: #import,only names unknown public declaration 'is_ascii_hex' in module "Ascii"
        \\note: public names: is_ascii_alpha, is_ascii_alphanumeric, is_ascii_digit,
        \\      is_ascii_lowercase, is_ascii_space, is_ascii_uppercase,
        \\      is_ascii_whitespace, to_ascii_lower_byte, to_ascii_upper_byte
    );
    paragraph(71, #string,oneline
        \\Two things that list does not show. A typeclass method is not a
        \\module-level declaration, so `sqrt` does not appear in the public
        \\names of `Math/Core` even though `#import "Math"` is what brings it
        \\into scope. And a name beginning with `_` is private to the module and
        \\is excluded from both the listing and selective import.
    );
    bullet(72, #string,oneline
        \\Operations on scalars, including the numeric typeclasses, live in
        \\`Math/Core`; bit manipulation in `Math/Bit`; the named constants in
        \\`Math/Constants`.
    );
    bullet(73, #string,oneline
        \\Operations on a borrowed slice live in `Memory`; operations that
        \\order or search one live in `Sort`; operations that own storage live
        \\under `Container`.
    );
    bullet(74, #string,oneline
        \\Anything that touches the operating system has a portable face in a
        \\top-level module and a raw face in `Os`. Prefer the portable one:
        \\`Os` is the boundary the rest of the library is built on, and its
        \\shape changes with the target.
    );
}

render_section_143 :: () {
    paragraph(0, #string,oneline
        \\Glosso is parsed by a hand-written recursive-descent parser with a
        \\precedence-climbing expression loop. The grammar below is written to
        \\match that parser production by production rather than to be fed to a
        \\generator, so where the parser makes a decision by scanning ahead the
        \\grammar says so instead of pretending to be context-free.
    );
    paragraph(1, #string,oneline
        \\Two things the notation cannot carry. Operator precedence and
        \\associativity are not in the grammar at all: they live in a table the
        \\parser fills in before parsing, from every visible `#operator` and
        \\`#precedence` declaration, which is why the expression production is
        \\one flat loop. That mechanism is described in the chapter on the
        \\operator prescan, and the standard tiers in the chapter on operator
        \\precedence. Token formation is likewise a separate pass; the chapter
        \\on punctuation and the token table owns it.
    );
    subheading(2, "Notation");
    table_header(3, "Form   —   Meaning");
    table_row(4, "`=` and `;`   |   open and close a production");
    table_row(5, "juxtaposition   |   sequence");
    table_row(6, "`|`   |   alternatives");
    table_row(7, "`[ x ]`   |   x is optional");
    table_row(8, "`{ x }`   |   x repeats zero or more times");
    table_row(9, "`( x )`   |   grouping");
    table_row(10, #string,oneline
        \\"x"   |   a literal token spelling
    );
    table_row(11, "UPPERCASE   |   a token class produced by the lexer");
    subheading(12, "Tokens");
    paragraph(13, #string,oneline
        \\The lexer produces the classes below. `#char` is the one directive the
        \\lexer itself interprets, and it yields an integer token rather than a
        \\character type. A `\\` at the start of a line yields `MLSTR`, which
        \\only `#string` and `#asm` consume.
    );
    code_block(14, "ebnf", #string
        \\IDENT     = ( letter | "_" ) { letter | digit | "_" } ;
        \\INT       = decimal | based | charlit ;
        \\decimal   = digit { digit | "_" } ;
        \\based     = decimal "#" basedigit { basedigit | "_" } ;   (* base 2 to 36 *)
        \\charlit   = "#char" STRING ;                              (* one code point *)
        \\FLOAT     = decimal "." decimal [ exponent ] | decimal exponent ;
        \\exponent  = ( "e" | "E" ) [ "+" | "-" ] digit { digit } ;
        \\STRING    = quote { any - quote | "\" any } quote ;
        \\MLSTR     = "\\" { any - newline } ;
        \\DIRECTIVE = "#" { letter | digit | "_" } ;
        \\OPNAME    = "'" { opchar } "'" ;
        \\LABEL     = "'" IDENT ;                                   (* no closing quote *)
        \\BACKTICK  = "`" IDENT ;
        \\DBACKTICK = "``" IDENT ;
        \\OP        = opchar { opchar } ;                           (* maximal munch *)
        \\opchar    = "+" | "-" | "*" | "/" | "<" | ">" | "!" | "@" | "%"
        \\          | "^" | "&" | "|" | "~" | "?" | "." | "," | ":" | "=" ;
        \\keyword   = "if" | "ifx" | "else" | "while" | "for" | "return"
        \\          | "break" | "continue" | "struct" | "union" | "case"
        \\          | "enum" | "using" | "defer" | "context" | "cast"
        \\          | "acast" | "where" | "noalias" ;
    );
    paragraph(15, #string,oneline
        \\There are exactly nineteen keywords. `typeclass`, `instance`,
        \\`distinct`, `enum_flags`, `true`, `false`, `null`, `const` and
        \\`volatile` are ordinary identifiers that the parser recognises by
        \\position, which is why each of them is still legal as a variable name.
    );
    subheading(16, "Program and declarations");
    code_block(17, "ebnf", #string
        \\program     = { feature | declaration } ;
        \\
        \\feature     = ( "#enable" | "#disable" ) "(" IDENT [ "," IDENT ] ")" [ ";" ] ;
        \\
        \\declaration = "#memory" overlay
        \\            | "#insert" expression [ ";" ]
        \\            | "#comptime" ( [ "->" type ] block | expression [ ";" ] )
        \\            | "#import" importtail
        \\            | "#load" STRING [ ";" ]
        \\            | "#thread_local" declaration
        \\            | instance
        \\            | binding ;
        \\
        \\binding     = name ( ":=" | "::=" ) expression [ ";" ]
        \\            | name ":" [ type ] globaltail
        \\            | name "::" bound ;
        \\
        \\name        = IDENT | OPNAME ;
        \\
        \\globaltail  = ( ":" | "::" ) expression [ ";" ]   (* typed constant *)
        \\            | ( "=" | ":=" ) expression [ ";" ]   (* typed global *)
        \\            | ";" ;                               (* zero initialised *)
        \\
        \\bound       = typeclass | distinct | import | load | library
        \\            | fnptr | struct | enum | enumflags | union
        \\            | procedure | expression [ ";" ] ;
        \\
        \\import      = "#import" importtail ;
        \\importtail  = [ "," ( "only" | "hide" ) "(" [ name { "," name } ] ")" ]
        \\              STRING [ ";" ] ;
        \\load        = "#load" STRING [ ";" ] ;
        \\library     = "#library" { "," ( "static" | "system" | "dyn" ) }
        \\              STRING [ ";" ] ;
        \\fnptr       = "#fn_ptr" "(" [ params ] ")" [ "->" type ]
        \\              { "#c_call" | "#no_context" } [ ";" ] ;
        \\distinct    = "distinct" type { derive } [ ";" ] ;
        \\derive      = "#derive" ( "," "all" | "(" type { "," type } ")" ) ;
    );
    paragraph(18, #string,oneline
        \\The trailing `;` is optional after every top-level form, because the
        \\parser consumes one only if it is there. `#thread_local` is checked
        \\after its inner declaration is parsed and is rejected on anything but
        \\a global variable.
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\
        \\LIMIT :: 10;
        \\WIDTH : s32 : 4;
        \\counter : s32 = 0;
        \\#thread_local depth : s32 = 0;
        \\Meters :: distinct f64 #derive(Add, Eq);
        \\Callback :: #fn_ptr(a: s32) -> s32;
        \\libc :: #library "c";
        \\c_abs :: (v: s32) -> s32 #foreign libc "abs";
        \\
        \\double :: (a: s32) -> s32 { return a * 2; }
        \\
        \\main :: () {
        \\    cb: Callback = double;
        \\    d : Meters = 1.5;
        \\    print("% % % % %\n", LIMIT, WIDTH, counter, depth, cb(21));
        \\    print("% %\n", c_abs(-7), d + d);
        \\}
    );
    code_block(20, "text", #string
        \\10 4 0 0 42
        \\7 3
    );
    subheading(21, "Aggregates");
    code_block(22, "ebnf", #string
        \\struct      = "struct" { structdir } "{" { structmember } "}" ;
        \\structdir   = "#c_call" | "#packed" | "#magic" STRING
        \\            | derive | "#modify" ( block | expression ) ;
        \\structmember= [ "using" ] [ "#as" [ "using" ] ] IDENT ":" fieldtype
        \\              [ "=" expression ] ";"
        \\            | "#empty" ":" type { "," type } ";" ;
        \\
        \\enum        = "enum" [ type ] "{" { IDENT [ "::" INT ] ";" } "}" ;
        \\enumflags   = "enum_flags" type "{" { IDENT [ "::" INT ] ";" } "}" ;
        \\
        \\union       = "union" { uniondir } "{" { unionvariant } "}" ;
        \\uniondir    = "#raw" | "#magic" STRING | derive ;
        \\unionvariant= [ "#from" ] IDENT ":" fieldtype ";" ;
        \\
        \\fieldtype   = type | struct | union | enum | enumflags ;
    );
    paragraph(23, #string,oneline
        \\Every aggregate member ends with `;`, and the diagnostic names the
        \\member: a missing one is `error: struct member 'x' must end with ';'`.
        \\An enum variant fixes its integer with `::`, not `=`; writing `=`
        \\gives `error: enum variant integer values use '::', not '='`. An
        \\aggregate written in field position is hoisted to file scope under the
        \\name `Owner.field`, which is why `fieldtype` may open a new
        \\declaration.
    );
    subheading(24, "Procedures");
    code_block(25, "ebnf", #string
        \\procedure   = "(" [ params ] ")" [ "->" rettype ]
        \\              { fndir } { where } ( block | ";" ) ;
        \\
        \\params      = param { "," param } [ "," "..." ] [ "," ] ;
        \\param       = { "using" | "noalias" } { "#comptime" | "#lazy" }
        \\              IDENT { "," IDENT } ":" ( type | variadic )
        \\              [ "=" expression ]
        \\            | IDENT ":=" expression
        \\            | "#empty" ":" type { "," type } ;
        \\variadic    = "..." [ IDENT | "$" IDENT | "(" IDENT { "&&" IDENT } ")" ] ;
        \\
        \\rettype     = type | "(" [ resultlist ] ")" ;
        \\resultlist  = [ IDENT ":" ] type { "," [ IDENT ":" ] type } ;
        \\
        \\fndir       = "#expand" [ "," "expression" ]
        \\            | "#inline" [ "," ( "always" | "never" ) ]
        \\            | "#operator" "(" mode [ "," INT ] ")"
        \\            | "#precedence" "(" mode "," INT ")"
        \\            | "#magic" STRING
        \\            | "#foreign" ( STRING | IDENT ) [ STRING ]
        \\            | "#memory" effects
        \\            | "#modify" ( block | expression )
        \\            | "#c_call" | "#no_context" | "#noreturn"
        \\            | "#returns_twice" | "#dump" | "#must" ;
        \\mode        = "left" | "right" | "assign" | "prefix" | "suffix" ;
        \\where       = "where" expression ;
        \\
        \\effects     = effect | "(" effect { "," effect } ")" ;
        \\effect      = ( "returns_fresh" | "returns_static" | "unknown" )
        \\                             [ "(" qualname ")" ]
        \\            | "returns_borrow" "(" [ qualname "," ] argref ")"
        \\            | "released_by"    "(" [ qualname "," ] qualname ")"
        \\            | "resource" "(" [ qualname "," ]
        \\                             "released_by" ":" qualname ")"
        \\            | "leak"
        \\            | ( "kills" | "invalidates" | "noescape" | "escapes"
        \\              | "reads" | "writes" ) "(" argref ")" ;
        \\qualname    = IDENT { "." IDENT } ;
        \\argref      = IDENT | "arg" "(" INT ")" ;
    );
    paragraph(26, #string,oneline
        \\The order is fixed and the parser enforces it: parameters, then the
        \\return type, then every directive, then every `where` clause, then the
        \\body. Reversing the last two is
        \\`error: function directives must appear before where clauses`. A body
        \\is required unless the declaration is `#magic`, `#foreign`, or a
        \\signature-only requirement inside a typeclass; `#precedence` accepts
        \\only `left`, `right` or `assign`, and its level must be between 0 and
        \\1000.
    );
    subheading(27, "Typeclasses and instances");
    code_block(28, "ebnf", #string
        \\typeclass   = "typeclass" "(" [ tcparams ] ")" { where }
        \\              { derive | minimal } "{" { member } "}" ;
        \\tcparams    = IDENT ":" type { "," IDENT ":" type } ;
        \\minimal     = "#minimal" "(" [ disjunction ] ")" ;
        \\disjunction = conjunction { "|" conjunction } ;
        \\conjunction = atom { "," atom } ;
        \\atom        = name | "(" disjunction ")" ;
        \\member      = name "::" ( procedure | type ";" ) ;
        \\
        \\instance    = head "::" "instance" [ "!" ] IDENT { where }
        \\              "{" { member } "}" ;
        \\head        = token { token } ;   (* every token up to the "::" *)
    );
    paragraph(29, #string,oneline
        \\An instance is found by scanning forward for a `::` at bracket depth
        \\zero whose next token is the identifier `instance`; everything before
        \\that `::` is the head, taken as raw tokens and re-parsed as a type.
        \\`#minimal` sits between the header and the body, so a `#minimal`
        \\written after the closing brace is read as a new declaration and fails
        \\with `error: bad decl name 'minimal'`. A member whose body is a type
        \\rather than a parameter list is an associated type.
    );
    code_block(30, "glosso", #string
        \\#import "Io";
        \\
        \\Scale :: typeclass (L: type, R: type) #minimal(scale_by) {
        \\    Output :: type;
        \\    scale_by :: (a: L, b: R) -> Output;
        \\}
        \\
        \\Sized :: typeclass (C: type) {
        \\    Item :: type;
        \\    measure :: (c: C) -> s64;
        \\    is_empty :: (c: C) -> bool {
        \\        return measure(c) == 0;
        \\    }
        \\}
        \\
        \\(s32, s32) :: instance Scale {
        \\    Output :: s32;
        \\    scale_by :: (a: s32, b: s32) -> s32 { return a * b; }
        \\}
        \\
        \\([]$T) :: instance Sized where Show(T) {
        \\    Item :: T;
        \\    measure :: (c: []T) -> s64 { return c.count; }
        \\}
        \\
        \\main :: () {
        \\    print("%\n", scale_by(6, 7));
        \\    values : [4]s32 = .[1, 2, 3, 4];
        \\    print("% %\n", measure(values[..]), is_empty(values[..]));
        \\}
    );
    code_block(31, "text", #string
        \\42
        \\4 0
    );
    subheading(32, "Types");
    code_block(33, "ebnf", #string
        \\type        = modified [ "!" type ] ;          (* right associative *)
        \\
        \\modified    = "?" modified
        \\            | "*" { "*" } quals modified
        \\            | "[" "*" "]" quals modified
        \\            | "[" "]" quals modified
        \\            | "[" ".." "]" modified
        \\            | "[" ( INT | IDENT ) "]" modified
        \\            | ( "#aos" | "#soa" ) modified
        \\            | "$" IDENT
        \\            | DBACKTICK
        \\            | "#Context"
        \\            | struct | union | enum | enumflags
        \\            | parentype
        \\            | named ;
        \\
        \\quals       = { "const" | "volatile" } ;
        \\named       = IDENT { "." IDENT } [ "(" typeargs ")" ] { "." IDENT } ;
        \\typeargs    = type { "," type }
        \\            | type "," dimension "," dimension     (* Matrix *)
        \\            | type "," INT ;                       (* Simd *)
        \\dimension   = INT | IDENT ;
        \\parentype   = "(" [ elem { "," elem } ] ")" [ "->" type ] ;
        \\elem        = [ "noalias" ] [ IDENT ":" ] type ;
    );
    paragraph(34, #string,oneline
        \\`E!T` binds looser than every prefix modifier and groups to the right,
        \\so `Io_Error!?*User` is one result whose payload is `?*User`, and
        \\`E1!E2!T` is `E1!(E2!T)`. A parenthesised list is a tuple type unless
        \\an `->` follows, in which case it is a procedure type; a
        \\single-element list with no name is the parenthesised type itself. An
        \\inline `struct`, `union` or `enum` is legal only where a field name is
        \\already in hand, and elsewhere gives
        \\`error: inline aggregate types are only allowed in aggregate fields`.
    );
    note(35, #string,oneline
        \\Two shapes look like grammar but are not. `T.[ ... ]` does not exist:
        \\the postfix loop has an arm for `.{` and none for `.[`, so `s64.[1,2]`
        \\is the type `s64` followed by a separate array literal, and
        \\`for v: s64.[1, 2]` reports
        \\`error: for-each needs an array, got type`. And adjacent operator
        \\characters glue into one token, so `E!*T` lexes as the single operator
        \\`!*`; the result type of a pointer must be written `E! *T` or
        \\`E!(*T)`.
    );
    subheading(36, "Expressions");
    code_block(37, "ebnf", #string
        \\expression  = unary { binop expression } ;   (* grouped by the table *)
        \\binop       = OP | OPNAME | ".." | "..=" ;
        \\
        \\unary       = "return" [ expression ] | "break" | "continue"
        \\            | "?" unary
        \\            | "#comptime" ( [ "->" type ] block | unary )
        \\            | "#try" "{" expression "}"
        \\            | "#meaningful" ( block | unary )
        \\            | "cast" "(" type ")" unary
        \\            | "acast" unary
        \\            | "*" { "*" } unary
        \\            | prefixop unary
        \\            | ifx | patternexpr | ".."
        \\            | postfix ;
        \\
        \\postfix     = primary { "." namelike | "." INT
        \\                      | "." "cast" "(" type ")" | "." "acast"
        \\                      | "(" [ args ] ")" | "[" expression "]"
        \\                      | ",," LABEL | ".{" fields "}"
        \\                      | "#memory" effects | ".*" | suffixop } ;
        \\args        = arg { "," arg } [ "," ] ;
        \\arg         = [ "." IDENT "=" ] expression [ "..." ] ;
        \\
        \\primary     = INT | FLOAT | STRING | LABEL | "context"
        \\            | "true" | "false" | "null" | IDENT | OPNAME
        \\            | BACKTICK | DBACKTICK | "$" IDENT
        \\            | "#undefined" | "#string" strmods MLSTR { MLSTR }
        \\            | "#simd" arraylit | "#code" block
        \\            | "#inline" ( "while" expression body | for )
        \\            | lambda
        \\            | "." "(" [ expression { "," expression } ] ")"
        \\            | "." namelike
        \\            | ".{" fields "}" | arraylit
        \\            | "(" expression ")" ;
        \\arraylit    = ".[" [ expression { "," expression } ] "]" ;
        \\fields      = { [ "." namelike "=" ] expression [ "," ] } ;
        \\strmods     = { "," ( "oneline" | "escape" ) } ;
        \\
        \\lambda      = ( "|" [ lparams ] ( "|" | "|->" ) | "||" | "||->" )
        \\              [ "->" type ] ( block | expression ) ;
        \\lparams     = lparam { "," lparam } ;
        \\lparam      = [ "noalias" ] IDENT [ ":" type ] ;
        \\
        \\namelike    = IDENT | BACKTICK | DBACKTICK ;
        \\prefixop    = OP | OPNAME ;   (* declared #operator(prefix) *)
        \\suffixop    = OP | OPNAME ;   (* declared #operator(suffix) *)
    );
    paragraph(38, #string,oneline
        \\The `binop` loop is precedence climbing over a table keyed by operator
        \\spelling. An operator with no entry in the table ends the
        \\expression, which is how a reserved spelling produces a plain
        \\unexpected-token error. Two operators that share a precedence level
        \\but disagree about associativity cannot be mixed without parentheses,
        \\and the parser says which two.
    );
    code_block(39, "text", #string
        \\error: operators '<+' and '+>' both have precedence 19 but different associativity, so '<+ +>' is ambiguous; add parentheses
    );
    paragraph(40, #string,oneline
        \\An infix `!` is handled by the parser directly rather than through the
        \\table, so it works even though `!` carries no precedence, and it stops
        \\at `==` followed by `{` so that the switch head is not swallowed. A
        \\`..` whose right side is missing becomes a suffix operator, which is
        \\what makes `a[2..]` and the pattern range `100..` parse.
    );
    subheading(41, "Statements");
    code_block(42, "ebnf", #string
        \\block       = "{" { statement } "}" ;
        \\body        = block | statement ;
        \\
        \\statement   = "#memory" overlay
        \\            | name "::" ( procedure | struct | enum | union | distinct )
        \\            | block
        \\            | "#bytes" expression [ ";" ]
        \\            | "#asm" asmbody
        \\            | LABEL ( ":" | ";" )
        \\            | "return" [ expression { "," expression } ] [ ";" ]
        \\            | "break" [ ";" ] | "continue" [ ";" ]
        \\            | "while" expression body
        \\            | for
        \\            | "#inline" ( "while" expression body | for )
        \\            | [ "#try" ] "defer" statement
        \\            | "using" IDENT [ ";" ]
        \\            | if | "#if" staticif
        \\            | "#push_context" [ expression ] body
        \\            | "#push_allocator" "(" expression ")" [ ";" ]
        \\            | "#comptime" ( [ "->" type ] block | expression ) [ ";" ]
        \\            | "#assert" [ "#comptime" ] expression
        \\                        [ "," expression ] [ ";" ]
        \\            | "#compile_error" expression [ ";" ]
        \\            | "#insert" expression [ ";" ]
        \\            | vardecl
        \\            | expression [ ( "=" | assignop ) expression ] [ ";" ] ;
        \\
        \\vardecl     = names ( ":=" | "::=" | "::" ) expression memdir [ ";" ]
        \\            | names ":" ":=" expression memdir [ ";" ]
        \\            | names ":" [ type ] vartail memdir [ ";" ] ;
        \\names       = namelike { "," namelike } ;
        \\vartail     = [ "=" expression | ":=" expression
        \\              | ( "::" | ":" ) expression ] ;
        \\memdir      = { "#memory" effects } ;
        \\
        \\if          = "if" [ "#partial" ]
        \\              ( patternswitch | switch | expression body
        \\                                         [ "else" ( if | body ) ] ) ;
        \\switch      = expression "==" "{" { case } [ "else" ";" casebody ] "}" ;
        \\case        = "case" expression { "," expression } ";" casebody ;
        \\casebody    = { statement } [ "#falling" [ ";" ] ] ;
        \\staticif    = expression ( body [ "else" ( "#if" staticif | body ) ]
        \\                         | "==" "{" { case }
        \\                                    [ "else" ";" casebody ] "}" ) ;
        \\ifx         = "ifx" ( patternswitch | switch
        \\                    | expression expression "else" expression ) ;
        \\for         = "for" [ "<" ] [ ":" IDENT ]
        \\              [ IDENT [ "," IDENT ] ":" ]
        \\              expression [ ( ".." | "..=" ) expression ] body ;
        \\
        \\assignop    = OP | OPNAME ;   (* declared #operator(assign) *)
        \\overlay     = qualname "{" effect { "," effect } "}" [ ";" ] ;
        \\asmbody     = "{" MLSTR { MLSTR } { asmoperand }
        \\                  [ "clobber" ":" clobber { "," clobber } ";" ]
        \\              "}" [ ";" ]
        \\            | ( MLSTR { MLSTR } | expression )
        \\              [ ":" [ legacyops ] [ ":" [ legacyops ]
        \\                    [ ":" [ STRING { "," STRING } ] ] ] ] [ ";" ] ;
        \\asmoperand  = IDENT ":" ( "in" | "out" | "inout" )
        \\              "(" constraint [ "," ".Early_Clobber" ] ")"
        \\              [ "=" ( expression | IDENT ) ] ";" ;
        \\constraint  = "." IDENT | "fixed" "(" IDENT ")" ;
        \\clobber     = IDENT | "." IDENT ;
        \\legacyops   = legacyop { "," legacyop } ;
        \\legacyop    = ( "in" | "out" | "inout" )
        \\              "(" STRING "," ( expression | IDENT ) ")" ;
    );
    paragraph(43, #string,oneline
        \\A nested `name :: (...)`, `struct`, `enum`, `union` or `distinct` is
        \\parsed as a declaration and hoisted to file scope, leaving nothing
        \\behind in the body; a nested `name :: expression` is an ordinary local
        \\constant and is not hoisted. `#falling` must be the last statement of
        \\its arm, and anything written after it is
        \\`error: '#falling' must be the last statement of a case`. An `ifx`
        \\conditional has no one-armed form, because it must produce a value on
        \\every path.
    );
    code_block(44, "glosso", #string
        \\#import "Io";
        \\
        \\Shape :: union {
        \\    Circle: f64;
        \\    Square: f64;
        \\}
        \\
        \\main :: () {
        \\    total := 0;
        \\    for i: 0..4 total += i;
        \\    for < i: 0..4 total += i;
        \\
        \\    n := 2;
        \\    if n == {
        \\    case 1, 2;
        \\        print("one or two\n");
        \\        #falling;
        \\    case 3;
        \\        print("three\n");
        \\    else;
        \\        print("other\n");
        \\    }
        \\
        \\    grade := ifx n == { case 1; "I"; case 2; "II"; else; "?"; };
        \\    s: Shape = .Square(3.0);
        \\    #pattern .Square(side) := s else { return; }
        \\    print("total=% grade=% area=%\n", total, grade, side * side);
        \\}
    );
    code_block(45, "text", #string
        \\one or two
        \\three
        \\total=12 grade=II area=9
    );
    subheading(46, "Patterns");
    code_block(47, "ebnf", #string
        \\patternexpr = "#pattern" ( pattern ":=" expression "else" block
        \\                         | "{" { arm [ ";" | "," ] } "}"
        \\                         | arm
        \\                         | pattern ) ;
        \\arm         = pattern "=" expression ;
        \\patternswitch = "#pattern" [ expression ] "==" "{"
        \\                { patterncase } [ "else" ";" casebody ] "}" ;
        \\patterncase = "case" ( pattern | "{" { arm [ ";" | "," ] } "}" )
        \\              [ "if" expression ] ";" casebody ;
        \\
        \\pattern     = element { "|" element } ;
        \\element     = rangeexpr | punary ;
        \\punary      = "#insert" expression | "==" ppostfix | ppostfix ;
        \\ppostfix    = pprimary { "." namelike
        \\                       | "(" [ pattern { "," pattern } ] ")"
        \\                       | ".{" pfields "}" } ;
        \\pprimary    = "..."
        \\            | BACKTICK | DBACKTICK
        \\            | "*" IDENT
        \\            | INT | FLOAT | STRING | "true" | "false" | "null"
        \\            | IDENT [ "@" punary ]
        \\            | "." IDENT
        \\            | ".{" pfields "}"
        \\            | ".[" [ pattern { "," pattern } ] "]"
        \\            | "(" pattern ")" ;
        \\pfields     = { ( "..." | "." namelike [ "=" pattern ] | pattern )
        \\                [ "," ] } ;
        \\rangeexpr   = expression ;   (* one containing ".." or "..=" *)
    );
    paragraph(48, #string,oneline
        \\A bare identifier in pattern position binds, which is why matching a
        \\named constant needs the `==` marker and why a backticked name refers
        \\to the quoting environment instead. A range is not pattern grammar at
        \\all: an element that contains `..` or `..=` is parsed as an ordinary
        \\expression and converted by `ToPattern`, which is how `100..`, `..=9`
        \\and a bare `..` work without a production of their own.
    );
    subheading(49, "Directives");
    paragraph(50, #string,oneline
        \\A directive is lexed as one token class and given meaning by the
        \\position it appears in, so the same spelling can mean different things
        \\in a declaration, a statement and an expression. The table gives the
        \\positions each one is accepted in.
    );
    table_header(51, "Directive   —   Position");
    table_row(52, "`#enable`, `#disable`   |   file scope, between top-level declarations");
    table_row(53, "`#import`, `#load`, `#library`, `#fn_ptr`   |   declaration position; `#import` and `#load` also bare");
    table_row(54, "`#thread_local`   |   prefix of a global variable declaration");
    table_row(55, "`#comptime`   |   top-level declaration, statement, expression prefix, parameter modifier");
    table_row(56, "`#insert`   |   top-level declaration, statement, pattern element");
    table_row(57, "`#memory`   |   top-level overlay, statement overlay, function directive, variable declaration, expression postfix");
    table_row(58, "`#if`, `#assert`, `#compile_error`, `#asm`, `#bytes`, `#push_context`, `#push_allocator`   |   statement position only");
    table_row(59, "`#inline`   |   before `while` or `for`, in statement or expression position, and as a function directive");
    table_row(60, "`#pattern`, `#partial`, `#falling`   |   pattern test or switch, after `if`, and at the end of a case arm");
    table_row(61, "`#try`   |   `#try { expression }` in expression position, and `#try defer`");
    table_row(62, "`#code`, `#string`, `#simd`, `#undefined`, `#meaningful`   |   expression position");
    table_row(63, "`#char`   |   an integer literal, recognised by the lexer");
    table_row(64, "`#derive`, `#minimal`   |   `#derive` on `struct`, `union`, `typeclass` and `distinct`; `#minimal` on `typeclass` only");
    table_row(65, "`#empty`, `#as`, `#from`, `#raw`, `#packed`   |   aggregate declarations; `#empty` also in a parameter list");
    table_row(66, "`#c_call`, `#modify`, `#magic`   |   both aggregate and procedure declarations");
    table_row(67, "`#operator`, `#precedence`, `#expand`, `#foreign`, `#no_context`, `#noreturn`, `#returns_twice`, `#dump`, `#must`, `#lazy`   |   procedure declarations; `#lazy` on a parameter");
    table_row(68, "`#Context`, `#aos`, `#soa`   |   type position");
    subheading(69, "Decisions the grammar defers to lookahead");
    paragraph(70, #string,oneline
        \\Six places in the parser scan forward before committing. Each one is
        \\listed here because no amount of factoring removes it from the
        \\grammar.
    );
    bullet(71, #string,oneline
        \\An instance is recognised by scanning for a `::` at bracket depth
        \\zero followed by the identifier `instance`. Until that is found, the
        \\head is held as raw tokens.
    );
    bullet(72, #string,oneline
        \\`#pattern` is a test when a `=` appears at depth zero before any `;`,
        \\`,` or opening `{`; a `:=` there makes it the bind-or-diverge form;
        \\otherwise it is a pattern value.
    );
    bullet(73, #string,oneline
        \\`==` followed by `{` ends an expression, so `if subject == {` opens a
        \\switch instead of comparing against a struct literal.
    );
    bullet(74, #string,oneline
        \\Inside a body, an identifier followed by `::` and one of `(`,
        \\`struct`, `enum`, `union` or `distinct` is a hoisted declaration
        \\rather than a statement.
    );
    bullet(75, #string,oneline
        \\`..` becomes a suffix operator when the token after it can only end an
        \\expression, and a `#pattern` element treats `|` as an alternative
        \\separator rather than the bitwise operator.
    );
    bullet(76, #string,oneline
        \\A named parameter list is distinguished from an expression by three
        \\tokens: `.`, an identifier, then `=`. Writing `f(name = value)` gives
        \\`error: unexpected token '='`.
    );
    note(77, #string,oneline
        \\After a parse error the parser discards tokens until it reaches one in
        \\column 1 that can start a declaration: an identifier or operator name
        \\followed by `:` or `::`, or one of a small set of top-level
        \\directives. A construct indented past column 1 is therefore never a
        \\resynchronisation point, and one bad declaration can swallow the
        \\indented declarations that follow it.
    );
}

render_section_144 :: () {
    paragraph(0, #string,oneline
        \\Glosso has no diagnostic numbers. The message text is the identifier,
        \\so the way to find an entry below is to search for the exact string
        \\the compiler printed. Every message in this chapter was produced by
        \\running the construct beside it through the compiler, and is quoted
        \\with the compiler's own wording, spacing, and quoting.
    );
    paragraph(1, #string,oneline
        \\A diagnostic is one message line, an arrow line naming the file with a
        \\1-based line and column, a framed source line with a caret run under
        \\the offending span, and then any number of `note` and `help` lines,
        \\each of which may carry its own frame. Only the message line is
        \\catalogued here, because that is the part that does not move. The
        \\frame layout, the `--color` modes, and the `--borrow-check` setting
        \\are described in the chapter on reading and configuring diagnostics.
    );
    code_block(2, "text", #string
        \\error: unknown function print
        \\  --> …\hello.glo:2:5
        \\  |
        \\2 |     print("hello\n");
        \\  |     ^^^^^
        \\help: did you mean 'tprint'?
    );
    paragraph(3, #string,oneline
        \\Internally a message may carry a `lex error line N: ` or
        \\`parse error line N: ` prefix; the renderer strips it, so the prefix
        \\never appears in output. Checker diagnostics are collected rather than
        \\fatal: several are reported in one run, separated by a blank line, and
        \\the run ends with a count. Lexical errors are not collected, because a
        \\lexical failure aborts the whole file at once.
    );
    code_block(4, "text", #string
        \\error: 300 does not fit s8, whose range is -128..=127
        \\  --> …\two.glo:1:18
        \\  |
        \\1 | a :: () { x: s8 = 300; }
        \\  |                   ^^^
        \\
        \\error: 400 does not fit s8, whose range is -128..=127
        \\  --> …\two.glo:2:18
        \\  |
        \\2 | b :: () { y: s8 = 400; }
        \\  |                   ^^^
        \\
        \\error: aborting due to 2 previous errors
    );
    paragraph(5, #string,oneline
        \\The compiler's own exit status distinguishes a usage mistake from a
        \\rejected program, and `--run` reports the child process separately.
    );
    table_header(6, "Exit status   —   Meaning");
    table_row(7, "`0`   |   The requested artifact was produced.");
    table_row(8, "`1`   |   The program was rejected, a source file could not be read, or a program run under `--run` failed.");
    table_row(9, "`2`   |   The command line was wrong; the usage block is printed with the message.");
    paragraph(10, #string,oneline
        \\A program run under `--run` that aborts is reported as
        \\`glosso: program exited with status exit code: 134` on Windows, and
        \\the compiler itself then exits `1`. Overflow and bounds traps abort
        \\with no message of their own.
    );
    subheading(11, "Driver messages");
    paragraph(12, #string,oneline
        \\Driver messages are the only ones with no source frame. They are
        \\written to standard error, prefixed `glosso: `, and are produced
        \\before any file is read.
    );
    table_header(13, "Message   —   Produced by");
    table_row(14, "`unknown option --bogus-option`   |   Any unrecognised flag. The usage block follows.");
    table_row(15, "`unknown backend 'nope' (choose llvm, object, static-lib, shared-lib, or llvm-ir)`   |   `--backend` with a name outside the set.");
    table_row(16, "`--color must be auto, always, or never`   |   `--color` with any other value.");
    table_row(17, "`borrow-check mode must be off, warning, or error`   |   `--borrow-check` with any other value.");
    table_row(18, "`--run is available only for --backend llvm`   |   `--run` combined with an object or library backend.");
    table_row(19, "`--std directory must contain Prelude.glo or Prelude/`   |   `--std` pointing at a directory that is not a standard library.");
    table_row(20, "`cannot read missing.glo`   |   The named source file does not exist. Exit status 1, not 2.");
    subheading(21, "Lexical errors");
    paragraph(22, #string,oneline
        \\A stray character is reported as the quoted character alone, with no
        \\explanatory text: an emoji used as an identifier is `error: '🙂'`, and
        \\a byte-order mark at the head of a file is `error: '\u{feff}'`. A
        \\non-breaking space and a form feed produce the same shape, and are
        \\invisible in the message; the caret under the character is the whole
        \\diagnosis. Only four code points count as whitespace, so any other
        \\space-like character lands here.
    );
    table_header(23, "Message   —   Produced by");
    table_row(24, "`reserved operator token '=' (operator '=' cannot be overloaded)`   |   Any of the fourteen reserved spellings written as an operator name or in operator position. The message names the operator twice.");
    table_row(25, "`operator token cannot end with '.'`   |   An operator run whose last character is `.` and which is not `..`, as in `2 *. 3`.");
    table_row(26, "`unterminated string literal`   |   A `\"` with no closing quote before end of file.");
    table_row(27, "`unexpected token '++'`   |   Maximal munch glued two operator characters together: `1 ++ 2`, `a =-1`, `Err!*int`.");
    table_row(28, "`unexpected directive 'frobnicate'`   |   A `#name` the parser does not recognise in that position. There is no unknown-directive message.");
    table_row(29, "`unexpected token 'line one'`   |   A `\\\\` continuation line outside a `#string` or `#asm` block.");
    subheading(30, "Number literals");
    table_header(31, "Message   —   Produced by");
    table_row(32, "`legacy '0x' integer literals are not supported; use '16#digits'`   |   `0xff`. The `0b` form has its own message naming `2#digits`.");
    table_row(33, "`integer literal base must be between 2 and 36, got 40`   |   `40#zz`. Base 1 and base 0 give the same message.");
    table_row(34, "`digit '2' is not valid for base 2`   |   `2#102`.");
    table_row(35, "`base-2 integer literal needs at least one digit`   |   `2#` with nothing after the marker.");
    table_row(36, "`integer literal '340282366920938463463374607431768211456' does not fit in 128 bits`   |   A decimal magnitude past `u128`. The base form is `base-16 integer literal does not fit in 128 bits`.");
    table_row(37, "`300 does not fit s8, whose range is -128..=127`   |   A literal outside the annotated type. The message always states the range.");
    table_row(38, "`a based literal is a bit pattern, so it may use every bit of s8 - this one is wider than that`   |   A `note` attached to the previous message when the literal was written `base#digits`, as in `16#1ff` at `s8`.");
    table_row(39, "`invalid '_' separator in number literal`   |   A leading, trailing, or doubled `_`. Fractional parts, exponents, and base digits each have their own wording.");
    table_row(40, "`scientific number literal needs exponent digits after 'e' or 'E'`   |   `1e` with no digits.");
    table_row(41, "`number literals must use ASCII digits`   |   A number scan that began on a non-ASCII digit, such as a leading superscript.");
    subheading(42, "`#char` and `#string`");
    table_header(43, "Message   —   Produced by");
    table_row(44, "`#char expects a string literal`   |   `#char 5`, or a newline between `#char` and the string.");
    table_row(45, "`unterminated #char string literal`   |   `#char \"a;`.");
    table_row(46, "`#char expects one character`   |   `#char \"\"`.");
    table_row(47, "`#char string literal contains more than two characters`   |   `#char \"ab\"`, and also `#char \"\\x41\"`, because `#char` has no hex escape.");
    table_row(48, "`ASCII #char literal can infer only as u8, s8, or u32, not int`   |   `c: s64 = #char \"A\"`. The message names the type that was asked for.");
    table_row(49, "`non-ASCII #char literal can infer only as u32, not u8`   |   `c: u8 = #char \"λ\"`.");
    table_row(50, "`#string expects one or more '\\\\' lines`   |   A `#string` immediately followed by `;`.");
    table_row(51, "`unknown #string modifier 'wrapped'; expected 'oneline' or 'escape'`   |   Any modifier outside the pair.");
    table_row(52, "`duplicate #string modifier 'oneline'`   |   The same modifier written twice.");
    subheading(53, "Declarations, procedures, and parameters");
    table_header(54, "Message   —   Produced by");
    table_row(55, "`bad decl name '1'`   |   A top-level declaration whose name does not lex as an identifier, as in `1bad :: 3;`. `#if` at file scope gives `bad decl name 'if'`.");
    table_row(56, "`a top-level constant binding uses '::'; the second ':' is missing`   |   `Foo : struct { … }`.");
    table_row(57, "`a global variable without an initializer needs a type`   |   `g: ;`.");
    table_row(58, "`function 'render' is already declared`   |   Two ordinary procedures with one name. There is no ad-hoc overloading; the constant form is `constant 'K' is already declared`.");
    table_row(59, "`constant cannot be modified`   |   Assigning to a local `::` binding. It carries `help: change '::' to ':=' to make the binding mutable`. Assigning to a top-level constant gives `unbound '<name>'` instead.");
    table_row(60, "`#thread_local can only prefix a global variable declaration`   |   `#thread_local` on a constant or a procedure.");
    table_row(61, "`main must not take parameters; use get_cmdline_args() for command-line arguments`   |   Any parameter on `main`.");
    table_row(62, "`noalias parameter 'v' must have a pointer type, got int`   |   `noalias` on a non-pointer parameter.");
    table_row(63, "`function directives must appear before where clauses`   |   A directive written after a `where`; the order in a signature is fixed.");
    table_row(64, "`polymorph $T is already bound; use plain T after the first $T`   |   `(a: $T, b: $T)`.");
    table_row(65, "`lambda captures local 'base', but captured closures are not supported`   |   A lambda reading an enclosing local. It carries `help: pass the value as an explicit callback or context argument`.");
    table_row(66, "`discarded return value of #must function 'mkval'`   |   Calling a `#must` procedure as a statement.");
    table_row(67, "`variadic parameter uses '...T'; '..' is the range operator`   |   `..T` written where `...T` was meant.");
    table_row(68, "`argument for #comptime parameter 'n' must be known at compile time`   |   A runtime value at a `#comptime` parameter; the attached `note` names the binding.");
    subheading(69, "Aggregates and built-in sugar");
    table_header(70, "Message   —   Produced by");
    table_row(71, "`struct member 'x' must end with ';'`   |   A missing member terminator. Unions and enums have the same message with their own noun.");
    table_row(72, "`enum variant integer values use '::', not '='`   |   `A = 1;` in an enum body.");
    table_row(73, "`bracket type expects [], [*], [..], or [N]`   |   Any other bracket form in a type.");
    table_row(74, "`the built-in option type is written '?T'; its variants are '.Some(x)' and '.None'`   |   Writing `Option(T)`. The result form has the matching message for `Result(E, T)`.");
    table_row(75, "`the built-in Context type is written #Context`   |   Naming `Context` without the `#`.");
    table_row(76, "`no field 'z' in 'V'`   |   An unknown member, with `help: did you mean 'x'?` when a near name exists.");
    table_row(77, "`member of non-struct`   |   A member access whose left side is not a struct, including `p.field` on a `*T`: a single pointer does not auto-dereference, so write `p.*.field`.");
    table_row(78, "`fixed array literal has 2 element(s), expected 3`   |   An array literal whose length disagrees with the annotation.");
    table_row(79, "`[]int has no field capacity`   |   Asking a view for a dynamic array's field.");
    table_row(80, "`a zero-sized 'void' member inside a struct, tuple, or array is not supported yet; remove the member, or wrap it in a single-field struct`   |   A `void` field.");
    subheading(81, "Modules and feature gates");
    table_header(82, "Message   —   Produced by");
    table_row(83, "`cannot find module \"NoSuchModule\" (looked for std/NoSuchModule.glo or std/NoSuchModule/module.glo)`   |   `#import` of a name that is neither file nor directory on the search path.");
    table_row(84, "`ambiguous module \"X\": both … and … exist`   |   A module that is both `std/X.glo` and `std/X/module.glo`.");
    table_row(85, "`#load: cannot find file \"mod/nope.glo\" (looked for …)`   |   A `#load` path that does not resolve relative to the loading file.");
    table_row(86, "`#import,only names unknown public declaration 'no_such_thing' in module \"Io\"`   |   A selector naming something the module does not export; a `note` lists the public names.");
    table_row(87, "`#import modifier must be only or hide`   |   Any other modifier after `#import,`.");
    table_row(88, "`unknown feature 'bogus_feature'`   |   `#enable` or `#disable` of a name outside the four gates. A bad mode gives `unknown feature '<feature>,<mode>'`.");
    table_row(89, "`#library modifier must be system, dyn, or static`   |   Any other link kind. Two kinds at once give `#library accepts only one link-kind modifier`.");
    table_row(90, "`#foreign refers to unknown library 'nolib' (declare it with #library)`   |   A `#foreign` naming a library handle that was never declared.");
    subheading(91, "Names and resolution");
    table_header(92, "Message   —   Produced by");
    table_row(93, "`unbound 'nosuchname'`   |   An identifier in value position with no binding, including a capture used after the `if` that bound it and a private name read from another file.");
    table_row(94, "`unknown function nosuchfn`   |   A call to a name that is not a procedure, with `help: did you mean …?` when a near name exists.");
    table_row(95, "`no overload 'f' accepts these arguments`   |   Every candidate failed. A `note` lists them, one `candidate:` line each.");
    table_row(96, "`constraint failed for double`   |   Every candidate matched on types but a `where` clause evaluated false.");
    table_row(97, "`cannot infer a type here; annotate it or give it a use that fixes one`   |   A binding with nothing to read a type from, such as a bare lambda.");
    subheading(98, "Types and conversions");
    paragraph(99, #string,oneline
        \\Coercion failures use one shape, `got A, expected B`, for every
        \\position: an annotated initialiser, an argument, a `return`, and a
        \\literal that has already been defaulted. The compile-time number kinds
        \\get their own wording, because the failure there is the conversion
        \\rule rather than a type mismatch.
    );
    table_header(100, "Message   —   Produced by");
    table_row(101, "`got u8, expected s8`   |   A conversion that is not a lossless widening. Only widening is implicit, and floats never convert implicitly in either direction.");
    table_row(102, "`cannot implicitly convert comptime_float to int`   |   A fractional literal at an integer type. The integer form names `comptime_int`.");
    table_row(103, "`cannot cast string to int`   |   A `cast` between families that have no conversion.");
    table_row(104, "`cast requires a type in parentheses; use acast for contextual casts`   |   `cast T value`.");
    table_row(105, "`acast needs a target type from context or an explicit cast type`   |   `acast` in a position that carries no expected type.");
    table_row(106, "`'null' is not a value of *int`   |   `null` at a plain pointer, with two notes naming `?*int` and `.None`.");
    table_row(107, "`cast to *int of an address that is zero at compile time`   |   `cast(*T) 0`, with notes explaining the niche that makes it illegal.");
    table_row(108, "`got int, expected Option_int`   |   `?T` does not wrap implicitly; write `.Some(x)`.");
    subheading(109, "Operators");
    table_header(110, "Message   —   Produced by");
    table_row(111, "`no operator '+' for u8, u16`   |   Operators are homogeneous: there is no implicit promotion of one operand to the other's type.");
    table_row(112, "`no operator '%' for f64, f64`   |   `%` is integer-only.");
    table_row(113, "`no operator '*' for Meters and Meters: a distinct type gets only the classes it derives; add '#derive(...)' or '#derive,all' on the declaration of 'Meters'`   |   An operator on a `distinct` type that did not derive the class.");
    table_row(114, "`shift count 8 is not less than the 8 bits of u8`   |   A compile-time shift count at or past the width, with `note: a shift by the width or more has no defined result`.");
    table_row(115, "`operator '<+>' must be declared by a typeclass and implemented by its instances`   |   A free operator function at file scope. There are no free operator overloads.");
    table_row(116, "`operator '+' is already owned by typeclass 'Add'`   |   A second class claiming a spelling at the same arity and fixity.");
    table_row(117, "`binary operator '<+>' needs #operator(left|right|assign, n)`   |   A binary operator declared with no precedence anywhere.");
    table_row(118, "`operator precedence level must be between 0 and 1000`   |   A level outside the accepted range.");
    table_row(119, "`operators '**' and '~>' both have precedence 19 but different associativity, so '** ~>' is ambiguous; add parentheses`   |   Mixing two same-tier operators that disagree on associativity.");
    subheading(120, "Typeclasses and instances");
    table_header(121, "Message   —   Produced by");
    table_row(122, "`typeclass 'Show' is already declared`   |   Re-declaring a class name. Class names live in one global namespace.");
    table_row(123, "`function 'show' is already owned by typeclass 'Show'`   |   Re-declaring a method name owned by a class, even in a user file.");
    table_row(124, "`instance 'Dog :: Greet' does not satisfy #minimal(greet)`   |   An instance short of its minimal complete definition, with `note: minimal complete definition declared here`.");
    table_row(125, "`ambiguous typeclass operation 'greet' for these argument types`   |   Two instances scored equally. Coherence is checked at the use site, not at declaration.");
    table_row(126, "`associated type 'K.Elem' is ambiguous; provide type arguments`   |   An argument-free projection with more than one supplying instance.");
    table_row(127, "`associated type arguments must follow the typeclass name; write 'K(S).Elem' instead of 'K.Elem(S)'`   |   Arguments attached to the associated type rather than the class.");
    table_row(128, "`typeclass 'Plain' does not declare a derive macro`   |   `#derive(C)` for a class with no `#derive` hook of its own.");
    table_row(129, "`non-constant function call`   |   An evidence query in a position the `where` evaluator cannot fold, such as `where !C(T)` or `where A(T) || B(T)`.");
    subheading(130, "`Try`, `Termination`, and `Show`");
    table_header(131, "Message   —   Produced by");
    table_row(132, "`postfix '?' requires a Try-returning function or an enclosing #try block`   |   `?` with no boundary to break out to.");
    table_row(133, "`no suffix operator '?' for int`   |   `?` on a value whose type has no `Try` instance. A type that has one but disagrees about the branch type gives `postfix '?' operand type T does not implement Try`.");
    table_row(134, "`cannot infer the carrier type of #try expression; propagate at least one value with '?'`   |   A `#try` block with no `?` inside it.");
    table_row(135, "`#try contains one expression; remove the semicolon`   |   A `#try` block whose single expression ends in `;`. Anything else in the block gives `#try requires one expression`, and a missing block gives `#try requires a block`.");
    table_row(136, "`#try defer requires a Try-returning function or an enclosing #try block`   |   An error-only defer with no error path to run on.");
    table_row(137, "`main return type Thing does not implement Termination`   |   A `main` result outside the integers, `E!void`, and types with a hand-written instance.");
    table_row(138, "variadic arg type `Plain` does not implement `Show` in call `print`   |   A `print` argument with no `Show` instance. The message quotes the type, the class, and the callee in backticks. Expanding a pack gives `expanded variadic element type …` instead.");
    subheading(139, "Control flow, switches, and patterns");
    table_header(140, "Message   —   Produced by");
    table_row(141, "`break outside loop`   |   `break` at function level, and also inside `#inline while` or a genuinely unrolled `#inline for`, which have no loop to leave.");
    table_row(142, "`for target is not iterable`   |   A `for` over a `string`; iterate the bytes another way.");
    table_row(143, "`for-each needs an array, got P`   |   A `for` over a type with no `Iterable` instance and no `for_expansion` macro.");
    table_row(144, "`switch is exhaustive by default; add else or #partial`   |   A tagged-union switch that leaves a variant uncovered.");
    table_row(145, "`cannot switch on a raw union (it has no tag)`   |   `if u == { … }` on a `union #raw`.");
    table_row(146, "`tagged-union payload '.Circle' may only be bound by a pattern match`   |   Reading `value.Variant` directly, with a `note` naming `#enable(allow_union_unwrap)`.");
    table_row(147, "`non-exhaustive #pattern switch`   |   A pattern switch the coverage analysis cannot prove total. Up to six `note: missing case: …` witnesses follow, then `…and N more`.");
    table_row(148, "`cannot decide a value: an 'ifx' needs an 'else' arm`   |   The conditional `ifx` without `else`. The switch forms give `cannot decide a value for this ifx` plus the missing cases.");
    table_row(149, "`an ifx arm must end in an expression`   |   An `ifx` arm whose last statement produces nothing.");
    table_row(150, "`a '#pattern' test cannot be negated`   |   `!(#pattern P = e)`, with a `note` pointing at the `#pattern P := e else { … }` form.");
    table_row(151, "`the 'else' of a '#pattern ... :=' binding must not return normally`   |   A bind-or-diverge `else` that can fall through.");
    table_row(152, "`#if condition must be bool, got comptime_int`   |   `#if` on a value that is truthy but not `bool`; `#if` is stricter than `if`.");
    table_row(153, "`no label 'nowhere' in this procedure (define it with `'nowhere:`)`   |   `goto` at a label the procedure does not declare.");
    subheading(154, "Compile-time evaluation");
    table_header(155, "Message   —   Produced by");
    table_row(156, "`unknown const i`   |   A runtime binding read in a position that must fold, such as a `#if` condition or a range bound in a pattern.");
    table_row(157, "`assertion failed: math is broken`   |   A `#assert` whose condition folds to false. Without a message the text is `assertion failed`.");
    table_row(158, "`unsupported: widget`   |   `#compile_error`; the message is the expression's value, printed with no prefix of its own.");
    table_row(159, "`#inline while condition must be compile-time evaluable`   |   A runtime condition on an unrolled loop.");
    table_row(160, "`#inline while made no compile-time progress; update a compile-time variable used by the condition`   |   A body that never changes what the condition reads.");
    table_row(161, "`#inline for expects a compile-time array`   |   `#inline for` over something other than a tuple or fixed array; a dynamic array gives its own message about runtime length.");
    table_row(162, "`#insert generated invalid source: parse error line 1: unexpected token ';'`   |   Generated text that does not parse, with a `note` and a frame pointing into the cached generated file.");
    table_row(163, "`a 'Code' value is compile-time only; bind it with '::' rather than ':='`   |   `:=` on a `Code` value. The `pattern` type has the same message.");
    subheading(164, "Memory contracts");
    paragraph(165, #string,oneline
        \\Contract validation is always fatal and ignores `--borrow-check`: a
        \\malformed `#memory` clause is an error at every setting, because the
        \\analysis cannot run against a contract it cannot read. A failed
        \\contract also removes the declaration, so a second error usually
        \\follows naming the now-unknown function.
    );
    table_header(166, "Message   —   Produced by");
    table_row(167, "`unknown #memory effect 'bogus'`   |   A clause name outside the effect vocabulary.");
    table_row(168, "`#memory effect list cannot be empty`   |   `#memory()`. The overlay form has its own wording.");
    table_row(169, "`#memory overlay names unknown function 'nope'`   |   An overlay whose target does not resolve.");
    table_row(170, "`#memory names unknown releaser 'nonexistent'`   |   `released_by` naming something that is not a reachable function.");
    table_row(171, "`#memory releaser 'notmem' must accept a memory-capable first parameter`   |   A releaser whose first parameter holds no storage.");
    table_row(172, "`#memory noescape(p) conflicts with escapes(p)`   |   Two clauses that contradict each other on one parameter.");
    table_row(173, "`#memory return place 'x' must start with contextual 'returned'`   |   A return place with the wrong root; when the signature has named results the message lists them.");
    paragraph(174, #string,oneline
        \\The temporal analysis is separate, and its findings are warnings by
        \\default. `--borrow-check error` promotes every one of them to an error
        \\and `--borrow-check off` silences them; the wording does not change.
    );
    table_header(175, "Message   —   Produced by");
    table_row(176, "`resource must be released by 'free' before leaving scope`   |   An owned value alive at scope exit, with `note: release obligation was created here`.");
    table_row(177, "`resource may not be released by 'free' on every path`   |   The same obligation surviving on some but not all paths out of a join.");
    table_row(178, "`double release of resource`   |   A second release call, with `note: first release occurred here`.");
    table_row(179, "`use after release while reading memory`   |   A read through a place that was released. The write and return forms have their own wording, as do the may-have-been variants at a join.");
    table_row(180, "`pointer escapes into global 'g'`   |   Storing the address of a local into a global, with `note: local storage 'x' originates here`.");
    table_row(181, "`resource requires release by 'my_free', but this operation requires 'array_free'`   |   An operation whose built-in releaser disagrees with the contract the value was acquired under.");
    table_row(182, "`pointer to local storage escapes through return`   |   Returning the address of a local, with `note: local storage was created here`.");
    table_row(183, "`lifetime of memory returned by opaque foreign call 'grab' is unknown`   |   A `#foreign` result with no lifetime clause; the `note` lists the four clauses that would settle it.");
    table_row(184, "`body of 'f' contradicts #memory noescape(p)`   |   A body that stores or returns a parameter its contract promised not to retain.");
    subheading(185, "Warnings");
    paragraph(186, #string,oneline
        \\Warnings use the identical layout with `warning:` in place of
        \\`error:`. Besides the temporal-analysis family above there are two,
        \\and both point at code that compiles but probably does not mean what
        \\it says.
    );
    table_header(187, "Message   —   Produced by");
    table_row(188, "`this expression changes meaning under the 0-20 precedence table: bitwise operators now bind tighter than comparisons`   |   An unparenthesised bitwise expression as an operand of a comparison, or the reverse, as in `flags & mask == 4`. It carries `note: add parentheses to say which reading you mean`.");
    table_row(189, "`unreachable pattern - already covered by an earlier case`   |   An arm of a `#pattern` switch that the arms above it already cover.");
    subheading(190, "Runtime messages");
    paragraph(191, #string,oneline
        \\A program can also print. Runtime messages come from the compiled
        \\program, not the compiler, are written to standard error, and are
        \\followed by an abort. Each names the source position of the operation
        \\that failed.
    );
    code_block(192, "text", #string
        \\…\k11.glo:5:46: union access: expected .Box, but the value holds one of .Circle | .Box
        \\glosso: program exited with status exit code: 134
    );
    table_header(193, "Message   —   Produced by");
    table_row(194, "`union access: expected .Box, but the value holds one of .Circle | .Box`   |   An `#enable(allow_union_unwrap)` payload read whose tag check failed at `-O0` or `-O1`.");
    table_row(195, "`assertion failed: x must be big`   |   A `#assert` whose condition was not compile-time known and was false at run time.");
    table_row(196, "`cast to *int of an address that is zero`   |   A runtime `cast(*T)` of a null address.");
    table_row(197, "`glosso debug allocator: leaked 1 allocation(s), 64 byte(s)`   |   The `-O0` debug allocator at exit; each leak is listed with its allocation site.");
    table_row(198, "`glosso debug allocator: double free`   |   The same allocator on a repeated release. Use-after-free, invalid free, and invalid realloc have matching lines.");
    note(199, #string,oneline
        \\Integer overflow and array bounds failures abort with no message at
        \\all: the only evidence is exit status 134. They are checked only at
        \\`-O0` and `-O1`, so the same program compiled with `-O2` runs past the
        \\overflow instead. Division by zero and the signed `MIN / -1` case trap
        \\in hardware at every level, with the operating system's own status.
    );
}

render_section_145 :: () {
    paragraph(0, #string,oneline
        \\The compiler enforces none of what follows. These are the conventions
        \\the standard library holds to, and the reason to hold to them is that
        \\a program spends most of its text calling that library: code written
        \\in the same shapes reads as one body of work rather than two.
    );
    subheading(1, "Naming");
    paragraph(2, #string,oneline
        \\There are four name shapes and the shape says what kind of thing the
        \\name binds. Nothing in the language reads a name's case, so the shape
        \\is carrying information the compiler does not: a reader who sees
        \\`Slot_Table` knows it is a type before finding the declaration.
    );
    table_header(3, "Kind   —   Shape   —   Examples");
    table_row(4, "Types: struct, union, enum, distinct   |   `Upper_Snake_Case`   |   `Slot_Table`, `Io_Error_Kind`, `Date_Time`");
    table_row(5, "Typeclasses   |   `PascalCase`, no underscores   |   `Show`, `PartialEq`, `FromString`, `Indexable`");
    table_row(6, "Enum variants   |   `Upper_Snake_Case`   |   `Read_At`, `Unexpected_Eof`, `Out_Of_Memory`");
    table_row(7, "Flag-enum members   |   `UPPER_SNAKE`   |   `POINTER`, `REVERSE`, `DIRTY`");
    table_row(8, "Constants   |   `UPPER_SNAKE`   |   `MAX_SLOTS`, `DEFAULT_TEMP_ALLOCATOR_SIZE`");
    table_row(9, "Procedures, parameters, fields, locals   |   `lower_snake_case`   |   `slot_table_new`, `capacity`, `it_index`");
    table_row(10, "Module-internal declarations   |   a `__` prefix on the usual shape   |   `__grid_index`, `__BTreeMap_Node`");
    paragraph(11, #string,oneline
        \\The library holds this line exactly: of more than three thousand
        \\top-level procedures in `std`, not one is spelled in camel case. The
        \\typeclass exception is deliberate. A class name appears inside type
        \\expressions, in `where` clauses, and as an instance head, always
        \\beside real type names, and dropping the underscores is what keeps
        \\`where Eq(T) && Hash(T, DefaultHasher)` legible.
    );
    paragraph(12, #string,oneline
        \\A procedure that operates on a type is named after that type: the
        \\module prefix comes first and the verb second, so every operation on a
        \\value sorts together in a listing and in a completion menu.
    );
    code_block(13, "glosso", #string
        \\MAX_SLOTS :: 8;
        \\DEFAULT_NAME : string : "unnamed";
        \\
        \\Slot_State :: enum { Free; Taken; Retired; }
        \\
        \\Slot_Flags :: enum_flags u32 {
        \\    PINNED :: 16#1;
        \\    DIRTY  :: 16#2;
        \\}
        \\
        \\Slot_Table :: struct {
        \\    name: string;
        \\    used: s64;
        \\}
        \\
        \\Describable :: typeclass (T: type) #minimal(describe) {
        \\    describe :: (value: T) -> string;
        \\}
        \\
        \\Slot_Table :: instance Describable {
        \\    describe :: (value: Slot_Table) -> string { return value.name; }
        \\}
        \\
        \\slot_table_new :: (name: string) -> Slot_Table {
        \\    return .{ .name = name, .used = 0 };
        \\}
        \\
        \\slot_table_is_full :: (table: Slot_Table) -> bool {
        \\    return table.used >= MAX_SLOTS;
        \\}
    );
    note(14, #string,oneline
        \\Names collide across the whole program, so the prefix habit is doing
        \\real work. A typeclass method name is reserved with no import at all:
        \\`show :: (x: int) -> int { … }` is
        \\`error: function 'show' is owned by typeclass 'Show' and cannot be
        \\redeclared`, and so are `next`, `from_string`, and every operator
        \\name. Anything an import brings in collides too: with `#import
        \\"Math";` in the file, `PI :: 3.14;` is
        \\`error: constant 'PI' is already declared` and `abs` is
        \\`error: function 'abs' is already declared`.
    );
    subheading(15, "Layout");
    bullet(16, "Four spaces per level, never a tab. There is not one tab character in `std`.");
    bullet(17, "Lines wrap near 80 columns; nine lines in ten of the library are under 76.");
    bullet(18, "The opening brace stays on the line that opened the construct, and the closing brace sits at the owner's indentation.");
    bullet(19, "One blank line between top-level declarations; none inside a short body.");
    bullet(20, "Semicolons end statements. They are optional everywhere except a `case` label, but the library writes them.");
    paragraph(21, #string,oneline
        \\A signature too long for one line breaks after the open parenthesis,
        \\puts one parameter per line, keeps a trailing comma on the last one,
        \\and returns the `)` to the declaration's indentation. Directives and
        \\`where` clauses then go on their own lines, in that order, before the
        \\body's brace.
    );
    code_block(22, "glosso", #string
        \\slot_table_reserve :: (
        \\    table: *Slot_Table,
        \\    count: s64,
        \\    label: string = "reserve",
        \\) -> s64 #memory(writes(table), noescape(table)) {
        \\    table.*.used += count;
        \\    return table.*.used;
        \\}
    );
    paragraph(23, #string,oneline
        \\A switch puts its `case` labels one level inside the braces, not at
        \\the brace's own indentation. A one-line arm follows its label on the
        \\same line; anything longer starts on the next line, indented once
        \\more. The pattern is worth keeping because a `case` label is not a
        \\block and a reader needs the indentation to see where an arm ends.
    );
    code_block(24, "glosso", #string
        \\stream_error_reason :: (kind: Stream_Error_Kind) -> string {
        \\    if kind == {
        \\        case .None; return "no error";
        \\        case .Eof;  return "end of file";
        \\        case .Short_Write;
        \\            report_short_write();
        \\            return "short write";
        \\        else; return "unknown error";
        \\    }
        \\}
    );
    subheading(25, "File and declaration order");
    paragraph(26, #string,oneline
        \\Nothing in Glosso requires an order: `main` may call a procedure
        \\declared below it, and `#import` may sit at the bottom of the file.
        \\The library still fixes one, because a file read top to bottom should
        \\introduce a name before it is used.
    );
    table_header(27, "Position   —   Contents");
    table_row(28, "1   |   A header comment naming the file and stating in one line what it is for, then a short paragraph of what a caller must know.");
    table_row(29, "2   |   `#import` and `#load` lines.");
    table_row(30, "3   |   The module's error type, then its data types, then its typeclasses and instances.");
    table_row(31, "4   |   Constructors, then queries, then mutators, then the destructor, grouped by the type they belong to.");
    table_row(32, "5   |   `#enable(private_section);` and the `__`-prefixed helpers, at the end of the file.");
    code_block(33, "glosso", #string
        \\// grid.glo - a fixed grid with checked access.
        \\//
        \\// A Grid owns no memory; grid_new copies its stride and nothing else.
        \\
        \\#import "Io";
        \\
        \\Grid_Error :: enum { Out_Of_Range; }
        \\
        \\Grid :: struct {
        \\    cells: [9]s64;
        \\    stride: s64;
        \\}
        \\
        \\grid_new :: (stride: s64) -> Grid {
        \\    return .{ .stride = stride };
        \\}
        \\
        \\grid_get :: (grid: *Grid, row: s64, col: s64) -> Grid_Error!s64 {
        \\    index := __grid_index(grid, row, col);
        \\    if index < 0 return .Err(.Out_Of_Range);
        \\    return .Ok(grid.*.cells[index]);
        \\}
        \\
        \\#enable(private_section);
        \\
        \\__grid_index :: (grid: *Grid, row: s64, col: s64) -> s64 {
        \\    if row < 0 || col < 0 || col >= grid.*.stride return -1;
        \\    return row * grid.*.stride + col;
        \\}
    );
    paragraph(34, #string,oneline
        \\`#enable(private_section)` runs to the end of the file rather than the
        \\end of a block, which is why the private region is put last. A file
        \\that needs private types as well opens a second region near the top
        \\and closes it with `#disable(private_section);` before the public
        \\declarations begin. Inside a module directory, where the helpers are
        \\shared between files, the spelling is
        \\`#enable(private_section,siblings);`.
    );
    note(35, #string,oneline
        \\A `main` left inside a private region is renamed like any other
        \\private declaration, and the program then fails at link time with an
        \\undefined-symbol error naming the platform entry point rather than
        \\anything about visibility. Close the region before `main`.
    );
    subheading(36, "When to write a memory contract");
    paragraph(37, #string,oneline
        \\The temporal analysis infers a summary for any procedure whose body it
        \\can see, so an ordinary internal helper needs nothing written down. A
        \\contract earns its place at exactly the boundaries where inference
        \\stops or where the inferred answer is not the one the caller should
        \\rely on.
    );
    bullet(38, "Every `#foreign` declaration, because there is no body to infer from. Without a lifetime clause the caller gets a warning at each call site.");
    bullet(39, "Every procedure that hands ownership out or takes it back: `returns_fresh` with `released_by` on the acquiring side, `kills` on the releasing side.");
    bullet(40, "Every generic procedure whose behaviour matters, because a template body is not analysed at all until it is instantiated.");
    bullet(41, "Any pointer parameter the callee does not retain, with `noescape`, so a caller may pass the address of a local without a warning.");
    bullet(42, "A `#magic` intrinsic, which has no body by construction.");
    paragraph(43, #string,oneline
        \\The clauses are written where the reader is already looking: on the
        \\acquire and release pair, and on anything that takes a pointer. The
        \\example below compiles clean under `--borrow-check error`, which is
        \\the setting worth adding to a build once a module's contracts are in
        \\place.
    );
    code_block(44, "glosso", #string
        \\#import "Io";
        \\
        \\Buffer :: struct {
        \\    values: [..]s64;
        \\}
        \\
        \\buffer_push :: (buffer: *Buffer, value: s64)
        \\    #memory(writes(buffer), noescape(buffer))
        \\{
        \\    array_add(*buffer.*.values, value);
        \\}
        \\
        \\buffer_sum :: (buffer: *Buffer) -> s64
        \\    #memory(reads(buffer), noescape(buffer))
        \\{
        \\    total: s64 = 0;
        \\    for v: buffer.*.values total += v;
        \\    return total;
        \\}
        \\
        \\buffer_free :: (buffer: *Buffer) #memory(kills(buffer), noescape(buffer)) {
        \\    array_free(*buffer.*.values);
        \\}
        \\
        \\main :: () {
        \\    buffer: Buffer;
        \\    defer buffer_free(*buffer);
        \\    buffer_push(*buffer, 3);
        \\    buffer_push(*buffer, 4);
        \\    print("%\n", buffer_sum(*buffer));
        \\}
    );
    code_block(45, "text", #string
        \\7
    );
    subheading(46, "When to reach for a typeclass");
    paragraph(47, #string,oneline
        \\A typeclass is the only overloading mechanism the language has, so the
        \\question is never "class or free function" but "class or generic
        \\procedure". A `where` clause on a generic procedure says what the
        \\caller's type must already be able to do; a typeclass says what a type
        \\must newly declare. Prefer the former until a second implementation
        \\exists.
    );
    bullet(48, "One behaviour, many types, each needing its own body: a typeclass. `Show` and `Hash` are this.");
    bullet(49, "One body that works for every type meeting a condition: a generic procedure with `where`. No class is needed.");
    bullet(50, "A new operator spelling: a typeclass, always. An operator must have exactly one owning class, and a free operator function is rejected.");
    bullet(51, "A name that must be callable before its implementations exist, such as a callback a library invokes: a typeclass, so the library can constrain on it.");
    bullet(52, "A marker with no methods: a typeclass with `#minimal()`, queried with `#if C(T)`.");
    paragraph(53, #string,oneline
        \\Give every class parameter a position in every method's signature. A
        \\default method that omits one cannot be dispatched, because nothing at
        \\the call site decides it; an anonymous `#empty:` witness parameter is
        \\the standard way to give a type a position without giving it a value.
        \\State the minimal definition with `#minimal` even when it is a single
        \\name, because that is what turns an incomplete instance into one
        \\error at the instance rather than a missing overload at every call.
    );
    code_block(54, "glosso", #string
        \\Byte_Size :: typeclass (T: type) #minimal(byte_size) {
        \\    byte_size :: (value: T) -> s64;
        \\}
        \\
        \\Packet :: struct { payload: s64; }
        \\
        \\Packet :: instance Byte_Size {
        \\    byte_size :: (value: Packet) -> s64 { return 8; }
        \\}
        \\
        \\$T :: instance Byte_Size where Is_Integer(T) {
        \\    byte_size :: (value: T) -> s64 { return size_of(T); }
        \\}
        \\
        \\// a class, because each type answers differently
        \\total_size :: (a: $A, b: $B) -> s64 where Byte_Size(A) && Byte_Size(B) {
        \\    return byte_size(a) + byte_size(b);
        \\}
        \\
        \\// no class, because one body serves every integer
        \\doubled :: (value: $T) -> T where Is_Integer(T) {
        \\    return value + value;
        \\}
    );
    note(55, #string,oneline
        \\Instance selection is ordinary overload resolution, so it runs through
        \\implicit coercions: a concrete `s64` instance will capture a `u32`
        \\argument, because `u32` widens losslessly and a concrete parameter
        \\scores higher than a generic one. When an instance must key on exactly
        \\one type, write a blanket instance guarded by `where T == s64` rather
        \\than a concrete head.
    );
    subheading(56, "Errors");
    paragraph(57, #string,oneline
        \\A procedure that can fail returns `E!T`; a procedure whose only
        \\failure is absence returns `?T`. The library gives each module one
        \\error type named after the module, propagates with `?` rather than
        \\hand-written branching, and widens between modules with `#from`
        \\variants so a caller's union absorbs a callee's error without a
        \\conversion function.
    );
    code_block(58, "glosso", #string
        \\#import "Io";
        \\
        \\Parse_Error :: struct { text: string; }
        \\
        \\Parse_Error :: instance Error {
        \\    report_error :: (error: Parse_Error) -> void {
        \\        error_report_line("bad number", error.text);
        \\    }
        \\}
        \\
        \\App_Error :: union #derive(Error) {
        \\    #from parse: Parse_Error;
        \\}
        \\
        \\parse_count :: (text: string) -> Parse_Error!s64 {
        \\    value := from_string(s64, text);
        \\    if #pattern .Some(n) = value return .Ok(n);
        \\    return .Err(.{ .text = text });
        \\}
        \\
        \\main :: () -> App_Error!void {
        \\    n := parse_count("17")?;
        \\    print("n = %\n", n);
        \\    bad := parse_count("nope")?;
        \\    return .Ok();
        \\}
    );
    code_block(59, "text", #string
        \\n = 17
        \\bad number: nope
    );
    paragraph(60, #string,oneline
        \\That program exits with status 1 and prints its report to standard
        \\error, without a line of exit-code handling: `main` returning
        \\`App_Error!void` dispatches through `Termination`, which reports the
        \\error and returns 1. Reserve `#assert` for conditions a caller cannot
        \\cause and an error value for everything a caller can.
    );
    subheading(61, "Comments");
    paragraph(62, #string,oneline
        \\The library comments the contract, not the mechanism. A file header
        \\states what the module is for and what a caller must guarantee; a
        \\declaration comment states the invariant a reader could not derive
        \\from the signature. Line comments inside a body are rare, and section
        \\rules divide long files.
    );
    code_block(63, "glosso", #string
        \\// std/Container/HashSet.glo - hash set implemented as HashMap(T, u8).
        \\//
        \\// HashSet(T) has the same shallow single-owner and Eq/Hash requirements
        \\// as HashMap.  Iteration order is arbitrary, and structural mutation
        \\// invalidates pointers and iterators.
        \\
        \\// ---- construction ---------------------------------------------------
    );
    bullet(64, "Say what a caller must guarantee, not what the next statement does.");
    bullet(65, "Put the ownership story in the header: who allocates, who releases, what invalidates what.");
    bullet(66, "Name a known limitation where a reader will hit it, rather than in a change log.");
    bullet(67, "A `/* */` comment nests, so it is safe to comment out a region that already contains one; an unterminated one at end of file is accepted silently, which is worth knowing before trusting a stray `/*`.");
}
