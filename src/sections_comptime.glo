// Sections 105-115: compile-time programming.

render_section_105 :: () {
    paragraph(0, #string,oneline
        \\Glosso executes code during compilation in two different engines.
        \\Which one a construct reaches is decided by where the construct is
        \\written, not by what it does, and the two do not have the same
        \\capabilities: each accepts programs the other refuses.
    );
    paragraph(1, #string,oneline
        \\The constant evaluator lives inside the type checker. It walks the
        \\syntax tree of the expression it has been asked to fold, at the moment
        \\the checker reaches that expression, and interprets the program
        \\directly from that tree. Everything it produces is a value the checker
        \\then uses immediately: an array length, a branch decision, a spliced
        \\constant.
    );
    paragraph(2, #string,oneline
        \\The compile-time machine runs later and only for one construct. Each
        \\top-level `#comptime` declaration is lowered into an ordinary IR
        \\function alongside the rest of the program, and once checking and
        \\lowering are finished the machine executes that function as bytecode,
        \\before the backend emits anything. The Compilation Pipeline places both
        \\against the full sequence of passes.
    );

    subheading(3, "Which engine runs which construct");
    paragraph(4, #string,oneline
        \\The split is one line long: a top-level `#comptime` declaration goes to
        \\the machine, and everything else goes to the constant evaluator.
        \\Everything else means every construct that needs an answer while the
        \\checker is still running, which is most of the compile-time surface.
    );
    table_header(5, "Construct   —   Engine");
    table_row(6, "`X :: e;` and `X ::= e;` initialisers, and every global initialiser   |   Constant evaluator.");
    table_row(7, "`#comptime e` and `#comptime { … }` in an expression or statement position   |   Constant evaluator.");
    table_row(8, "The condition of `#if`, `#assert`, and `#inline while`, and every `where` clause   |   Constant evaluator.");
    table_row(9, "The operand of `#insert`, and the argument for a `#comptime` parameter   |   Constant evaluator.");
    table_row(10, "`#modify` blocks, `#code` materialisation, and derive macro bodies   |   Constant evaluator.");
    table_row(11, "`#comptime { … }` and `#comptime f();` written as a top-level declaration   |   Compile-time machine.");

    subheading(12, "How often each one runs");
    paragraph(13, #string,oneline
        \\The machine runs each top-level `#comptime` exactly once, in
        \\declaration order. The constant evaluator makes no such promise. It
        \\runs whenever the checker visits the node, and the checker visits a
        \\body more than once: every body is checked even when nothing calls it,
        \\the checker makes more than one pass over the program, and a generic
        \\body is checked once per instantiation on each pass.
    );
    code_block(14, "glosso", #string
        \\#import "Io";
        \\
        \\never_called :: () { #comptime { print("[ct] never_called\n"); } }
        \\
        \\generic_fn :: (x: $T) -> T { #comptime { print("[ct] generic_fn\n"); } return x; }
        \\
        \\#comptime { print("[ct] top-level block\n"); }
        \\
        \\main :: () {
        \\    #comptime { print("[ct] main body\n"); }
        \\    y := generic_fn(1);
        \\    z := generic_fn("s");
        \\    print("runtime main\n");
        \\}
    );
    code_block(15, "text", #string
        \\glosso: compile program.glo (target=x86_64-pc-windows-msvc)
        \\[ct] never_called
        \\[ct] main body
        \\[ct] generic_fn
        \\[ct] generic_fn
        \\[ct] never_called
        \\[ct] main body
        \\[ct] generic_fn
        \\[ct] generic_fn
        \\[ct] top-level block
        \\glosso: link program.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done program.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\runtime main
    );
    paragraph(16, #string,oneline
        \\Each in-body block ran twice, `generic_fn` ran twice per pass because
        \\two instantiations exist, and the body of `never_called` ran despite
        \\never being called. The top-level block ran last and once, after
        \\checking was complete. The rule this forces is the one worth
        \\remembering: a side effect belongs in a top-level `#comptime`, and an
        \\in-body `#comptime` should be used only for the value it produces.
    );

    subheading(17, "What the constant evaluator refuses");
    paragraph(18, #string,oneline
        \\The evaluator handles statements and expressions one kind at a time,
        \\and a kind it has no case for is refused rather than guessed at.
        \\Labels and `goto` are the visible example: an unstructured jump has no
        \\meaning in a tree walk, so the evaluator stops at the label. The same
        \\body runs without complaint in the machine, because by then the label
        \\and the jump have become ordinary IR instructions.
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\#import "Jump";
        \\
        \\counted :: () -> s64 {
        \\    n := 0;
        \\'top;
        \\    n += 1;
        \\    if n < 3 goto('top);
        \\    return n;
        \\}
        \\
        \\#comptime { print("[vm] counted = %\n", counted()); }
        \\
        \\main :: () {}
    );
    code_block(20, "text", #string
        \\glosso: compile program.glo (target=x86_64-pc-windows-msvc)
        \\[vm] counted = 3
        \\glosso: link program.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done program.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
    );
    paragraph(21, #string,oneline
        \\Replacing the `#comptime` block with `X :: #comptime counted();` sends
        \\the same body to the constant evaluator instead, and it is
        \\`error: statement is not available at compile time`, reported at the
        \\label rather than at the constant. An `#asm` block in a folded body
        \\gives the same message for the same reason.
    );
    paragraph(22, #string,oneline
        \\The evaluator also polices its own running time, because a
        \\non-terminating fold would hang the compiler with no diagnostic at all.
        \\An interpreted `while` that has not finished after a million iterations
        \\is `error: compile-time while exceeded 1000000 iterations`. The machine
        \\carries no such budget; a five-million-iteration loop inside a
        \\top-level `#comptime` block simply runs to completion.
    );

    subheading(23, "Where the machine still falls short");
    paragraph(24, #string,oneline
        \\Mutation through a pointer remains a boundary between the two engines.
        \\The constant evaluator implements the standard library's compile-time
        \\`String_Builder` intrinsics, including `sb_append(*sb, ...)`. The
        \\register machine used by a top-level `#comptime` block has builder
        \\support too, and `sb_new` succeeds, but the complete variadic pointer
        \\call is not yet usable end to end: it currently panics with `value is
        \\not a string` instead of appending or producing an empty builder.
    );
    code_block(25, "glosso", #string
        \\#import "Io";
        \\#import "String_Builder";
        \\
        \\build_text :: () -> string {
        \\    sb := sb_new();
        \\    sb_append(*sb, "hello ");
        \\    sb_append(*sb, "builder");
        \\    return sb_to_string(sb);
        \\}
        \\
        \\TEXT :: #comptime build_text();
        \\
        \\main :: () { print("build_text = <%>\n", TEXT); }
    );
    code_block(26, "text", #string
        \\glosso: compile program.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link program.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done program.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\build_text = <hello builder>
    );
    note(27, #string,oneline
        \\Keep `sb_append` source construction in a `#comptime` expression for
        \\now. Inside a top-level `#comptime` block, compose strings with
        \\`str_cat` and `str_repeat`, which behave identically in both engines.
        \\Ordinary dynamic arrays are safe as well: `array_add` is implemented
        \\on both sides, so this limitation is specific to the builder call.
    );

    subheading(28, "What both engines refuse");
    paragraph(29, #string,oneline
        \\Neither engine can reach the running program's world. A `#foreign`
        \\function has no body to interpret, the context allocator has no heap to
        \\allocate from, and a mutable global has no value until the program
        \\starts. The diagnostics differ only because the two report failure
        \\differently: the evaluator points at the offending expression, while
        \\every failure inside the machine is wrapped in `#comptime stopped:`.
    );
    code_block(30, "glosso", #string
        \\libc :: #library,system "c";
        \\now_c :: () -> s32 #foreign libc "rand";
        \\
        \\counter: s64 = 5;
    );
    table_header(31, "Situation   —   Diagnostic");
    table_row(32, "`now_c()` under the constant evaluator   |   `error: 'now_c' is foreign, so its result is not compile-time known`");
    table_row(33, "`now_c()` under the machine   |   `error: #comptime stopped: VM cannot call foreign/undeclared function 'now_c'; use the LLVM backend`");
    table_row(34, "`alloc` or `free` under the constant evaluator   |   `error: #magic intrinsic 'ctx_alloc' is not available during compile-time evaluation`");
    table_row(35, "`alloc` or `free` under the machine   |   `error: #comptime stopped: VM: unknown #magic intrinsic 'ctx_alloc'`");
    table_row(36, "Reading `counter` in either engine   |   `error: unknown const counter`");
    paragraph(37, #string,oneline
        \\Reflection is the case that looks as though it should differ and does
        \\not. `size_of`, `type_name`, `field_name` and the rest of `std/Meta`
        \\are compile-time-only intrinsics with no runtime implementation at all,
        \\and the machine has no entry for any of them. They still work in a
        \\top-level `#comptime` block, because the checker folds every such call
        \\to a constant before lowering; by the time the machine runs, the call
        \\is gone and only its answer is left in the instruction stream.
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\#import "String_Builder";
        \\
        \\Vec3 :: struct { x: f32; y: f32; z: f32; }
        \\
        \\describe :: (T: type) -> string {
        \\    return str_cat(type_name(T), str_cat(".", field_name(T, 0)));
        \\}
        \\
        \\DESC :: #comptime describe(Vec3);
        \\
        \\#comptime {
        \\    print("[vm] describe = %\n", describe(Vec3));
        \\    print("[vm] size_of  = %\n", size_of(Vec3));
        \\}
        \\
        \\main :: () { print("[ceval] describe = %\n", DESC); }
    );
    code_block(39, "text", #string
        \\glosso: compile program.glo (target=x86_64-pc-windows-msvc)
        \\[vm] describe = Vec3.x
        \\[vm] size_of  = 12
        \\glosso: link program.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done program.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\[ceval] describe = Vec3.x
    );

    subheading(40, "Compile-time output");
    paragraph(41, #string,oneline
        \\Both engines send `print` output to the compiler's standard output,
        \\while the compiler's own `glosso:` progress lines go to standard error;
        \\redirecting one does not capture the other. The machine's output is
        \\buffered and flushed in a single block once every top-level `#comptime`
        \\has finished, so where it lands relative to the progress lines is not
        \\something to depend on.
    );
}

render_section_106 :: () {
    paragraph(0, #string,oneline
        \\`#comptime` asks for a piece of the program to run during compilation.
        \\There is one spelling and several positions, and the position decides
        \\both what the directive leaves behind and which engine runs it.
    );
    paragraph(1, #string,oneline
        \\In a value position `#comptime` produces a constant that is spliced
        \\into the program in place of the expression. As a top-level declaration
        \\it produces nothing: the block runs for its effects and emits no code.
        \\`#run`, the earlier spelling, no longer exists; `X :: #run 1 + 1;` is
        \\`error: unexpected directive 'run'`.
    );

    subheading(2, "The forms");
    table_header(3, "Form   —   Position   —   Meaning");
    table_row(4, "`#comptime e`   |   Expression   |   Evaluate `e` during checking and splice the constant in.");
    table_row(5, "`#comptime { … return e; }`   |   Expression   |   Run a block; the returned value is the constant, typed by inference.");
    table_row(6, "`#comptime -> T { … return e; }`   |   Expression   |   The same, with the result typed exactly `T`.");
    table_row(7, "`#comptime { … }`   |   Top-level declaration   |   Run the block in the compile-time machine for its effects.");
    table_row(8, "`#comptime f();`   |   Top-level declaration   |   The same, written as one call.");
    table_row(9, "`#comptime x: T`   |   Parameter   |   The argument must be compile-time known; see Compile-Time and Type-Only Parameters.");
    code_block(10, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Inline_Expr :: #comptime 16 * 16;
        \\Table_Size  :: #comptime { base := 16; return base * base; };
        \\Byte_Limit  :: #comptime -> u8 { return 200; };
        \\
        \\Squares :: #comptime -> [4]s64 {
        \\    out: [4]s64;
        \\    i := 0;
        \\    while i < 4 { out[i] = i * i; i += 1; }
        \\    return out;
        \\};
        \\
        \\main :: () {
        \\    local := #comptime 6 * 7;
        \\    print("Inline_Expr=% Table_Size=% local=%\n", Inline_Expr, Table_Size, local);
        \\    print("Table_Size: % (% bytes)\n",
        \\          type_name(type_of(Table_Size)), size_of(type_of(Table_Size)));
        \\    print("Byte_Limit: % (% bytes)\n",
        \\          type_name(type_of(Byte_Limit)), size_of(type_of(Byte_Limit)));
        \\    print("Squares = % % % %\n", Squares[0], Squares[1], Squares[2], Squares[3]);
        \\}
    );
    code_block(11, "text", #string
        \\Inline_Expr=256 Table_Size=256 local=42
        \\Table_Size: ssize (8 bytes)
        \\Byte_Limit: u8 (1 bytes)
        \\Squares = 0 1 4 9
    );

    subheading(12, "`-> T` and the type of the result");
    paragraph(13, #string,oneline
        \\Without the annotation the constant is typed by inference, and an
        \\integer literal returned from a block defaults to `ssize`, which is eight
        \\bytes. `#comptime -> u8 { return 200; }` is one byte instead. The
        \\annotation is checked rather than coerced, so it also refuses a value
        \\that does not belong: `#comptime -> u8 { return 500; }` is
        \\`error: 500 does not fit u8, whose range is 0..=255`. Compile-Time
        \\Numbers and Literal Defaulting explains the defaulting rule the
        \\annotation is overriding.
    );
    paragraph(14, #string,oneline
        \\Any type the evaluator can build is accepted, including aggregates.
        \\That is what `Squares` above relies on: a lookup table is computed by a
        \\loop during checking and ends up in the program as ordinary constant
        \\data, with no initialisation code and no way for the two to drift
        \\apart.
    );
    paragraph(15, #string,oneline
        \\Nothing of the computation survives into the output. A `#comptime`
        \\expression is replaced by its result before the backend sees it, so the
        \\emitted function contains a literal where the call used to be.
    );
    code_block(16, "glosso", #string
        \\fib :: (n: s64) -> s64 { if n < 2 return n; return fib(n - 1) + fib(n - 2); }
        \\
        \\seed :: () -> s64 #dump {
        \\    return #comptime fib(20);
        \\}
        \\
        \\main :: () { d := seed(); }
    );
    code_block(17, "text", #string
        \\; ---- #dump typed-ir seed() -> ssize  [4 ins] ----
        \\   0  temp_mark v0
        \\   1  const v1 =6765
        \\   2  temp_restore v0
        \\   3  ret v1
        \\; ---- end seed ----
    );

    subheading(18, "A top-level `#comptime` is a build step");
    paragraph(19, #string,oneline
        \\At file scope `#comptime` is a declaration. It runs once, in
        \\declaration order, after checking and before the backend emits
        \\anything, and it contributes no code to the program. This is where a
        \\build does work that is not part of the program: inspect the target,
        \\run an external tool, generate a source file, refuse to proceed.
    );
    code_block(20, "glosso", #string
        \\#import "Io";
        \\
        \\check_target :: () {
        \\    if OUT.os == Target_OS.Windows print("[build] targeting Windows\n");
        \\    else print("[build] targeting something else\n");
        \\    if OUT.cpu != Target_CPU.X86_64 {
        \\        print("[build] this program has only been tested on x86-64\n");
        \\        exit(1);
        \\    }
        \\}
        \\
        \\#comptime check_target();
        \\
        \\main :: () { print("hello\n"); }
    );
    code_block(21, "text", #string
        \\glosso: compile program.glo (target=x86_64-pc-windows-msvc)
        \\[build] targeting Windows
        \\glosso: link program.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done program.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
    );
    paragraph(22, #string,oneline
        \\`exit(status)` called from compile time stops the build where it
        \\stands. No binary is written, the remaining top-level `#comptime`
        \\declarations do not run, and the compiler itself exits with the
        \\requested status, which is what makes the guard above a real gate
        \\rather than a warning. Output already produced by the block is still
        \\flushed.
    );
    paragraph(23, #string,oneline
        \\The chosen backend makes no difference. `--backend llvm-ir` and
        \\`--backend object` run every top-level `#comptime` exactly as the
        \\default backend does; the compile-time machine sits before the point
        \\where the backends diverge.
    );
    note(24, #string,oneline
        \\A program with a top-level `#comptime` is never restored from the
        \\native artifact cache. The cache cannot know what the block did, so a
        \\rebuild that skipped it would skip a build step, and the compiler
        \\declines to cache the artifact at all. A `#comptime` used only for a
        \\constant does not have this effect, which also means its side effects
        \\are skipped on a cached rebuild. The Build Cache and Generated Sources
        \\covers the cache.
    );
    paragraph(25, #string,oneline
        \\The standard library turns this mechanism into a full build system: a
        \\top-level `#comptime` that calls into `std/Compiler` can set build
        \\options, add source files, and drive nested compilations. Build Scripts
        \\covers that API, and The Compile-Time Command Line and Artifact Cache
        \\covers the arguments a build step can read.
    );

    subheading(26, "Inside a function body");
    paragraph(27, #string,oneline
        \\In a body, `#comptime` is handled by the constant evaluator, and the
        \\checker visits a body more than once. A `#comptime` block written as a
        \\statement therefore runs an unpredictable number of times: at least
        \\twice, once more for each generic instantiation, and at least once even
        \\when nothing calls the enclosing procedure. What Runs When shows the
        \\counts for a small program.
    );
    paragraph(28, #string,oneline
        \\The consequence is a rule rather than a number. An in-body `#comptime`
        \\is for its value; anything that writes a file, prints, or calls the
        \\compiler belongs in a top-level `#comptime` where the count is exactly
        \\one.
    );
    note(29, #string,oneline
        \\A bare expression after `#comptime` in statement position is a trap.
        \\The parser consumes the directive and then wraps the expression in an
        \\ordinary expression statement, dropping the compile-time marking
        \\entirely, so `#comptime f();` inside a body runs at run time. Only the
        \\block form runs during compilation there.
    );
    code_block(30, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    print("runtime start\n");
        \\    #comptime print("A: statement-level #comptime expr\n");
        \\    #comptime { print("B: statement-level #comptime block\n"); }
        \\    print("runtime end\n");
        \\}
    );
    code_block(31, "text", #string
        \\glosso: compile program.glo (target=x86_64-pc-windows-msvc)
        \\B: statement-level #comptime block
        \\B: statement-level #comptime block
        \\glosso: link program.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done program.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\runtime start
        \\A: statement-level #comptime expr
        \\runtime end
    );

    subheading(32, "What `#comptime` cannot reach");
    paragraph(33, #string,oneline
        \\A `#comptime` fails when the code it names needs something that does
        \\not exist yet. The program is not running, so there is no heap, no
        \\process, no loaded library, and no global storage. What Runs When
        \\compares the two engines' answers; the table below is the set a value
        \\position runs into, all reported by the constant evaluator.
    );
    table_header(34, "Refused   —   Diagnostic");
    table_row(35, "A `#foreign` function   |   `error: 'now_c' is foreign, so its result is not compile-time known`");
    table_row(36, "`alloc`, `free`, or any allocator route   |   `error: #magic intrinsic 'ctx_alloc' is not available during compile-time evaluation`");
    table_row(37, "Reading a mutable global   |   `error: unknown const counter`");
    table_row(38, "Reading a runtime local or parameter   |   `error: unknown const x`");
    table_row(39, "`goto`, a label, `#asm`, and other unsupported statements   |   `error: statement is not available at compile time`");
    table_row(40, "A loop that does not terminate quickly   |   `error: compile-time while exceeded 1000000 iterations`");
    paragraph(41, #string,oneline
        \\`#comptime` is one half of the metaprogramming surface: it computes
        \\values. The other half turns values back into program text, and is
        \\covered by Code Values: `#code` and Backticks, `#insert`, and Macros
        \\with `#expand`.
    );
}

render_section_107 :: () {
    paragraph(0, #string,oneline
        \\A name is a compile-time value when the checker has recorded its value
        \\in the compile-time environment. Only such a name can drive `#if`, an
        \\array length, an `#inline while` counter, an `#assert #comptime`, or a
        \\`#comptime` parameter. Which spellings put a name there is the subject
        \\here; Values, Constants, and Variables covers the declaration forms
        \\themselves.
    );

    subheading(1, "`::` asks for immutability, `::=` asks for a compile-time value");
    paragraph(2, #string,oneline
        \\`::` declares a constant. The checker tries to evaluate the
        \\initialiser: if that succeeds the name becomes a compile-time constant,
        \\and if it fails the name becomes a runtime-frozen constant instead,
        \\which is still immutable but no longer usable during checking. `::=`
        \\inside a body declares a compile-time binding, and there the evaluation
        \\is required rather than attempted.
    );
    table_header(3, "Spelling   —   Compile-time evaluation   —   Usable in `#if`");
    table_row(4, "`X :: e;`   |   Attempted.   |   Only if it succeeded.");
    table_row(5, "`X : T : e;` and `X : T :: e;`   |   Attempted.   |   Only if it succeeded.");
    table_row(6, "`X ::= e;` in a body   |   Required.   |   Yes.");
    table_row(7, "`X : T := e;` in a body   |   Required.   |   Yes.");
    table_row(8, "`X ::= e;` at file scope   |   Not attempted; this is a mutable global.   |   No.");
    table_row(9, "`X := e;` and `X : T = e;`   |   Not attempted.   |   No.");
    paragraph(10, #string,oneline
        \\The typed forms differ from the untyped ones only in the type they give
        \\the name, and that difference is visible through `type_of`. An untyped
        \\integer constant keeps the literal type `comptime_int`, which has not
        \\yet been given a width; a typed one has the width it was written with.
        \\Compile-Time Numbers and Literal Defaulting explains what
        \\`comptime_int` is for.
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\main :: () {
        \\    A ::  10;
        \\    B ::= 20;
        \\    C : s64 : 30;
        \\    D : s64 := 40;
        \\    print("A=% B=% C=% D=%\n", A, B, C, D);
        \\    print("types: % % % %\n",
        \\          type_name(type_of(A)), type_name(type_of(B)),
        \\          type_name(type_of(C)), type_name(type_of(D)));
        \\    #if A + B + C + D == 100 print("all four are compile-time values\n");
        \\}
    );
    code_block(12, "text", #string
        \\A=10 B=20 C=30 D=40
        \\types: comptime_int comptime_int ssize ssize
        \\all four are compile-time values
    );

    subheading(13, "Runtime-frozen constants");
    paragraph(14, #string,oneline
        \\A `::` whose initialiser cannot be folded is not an error. Immutability
        \\and compile-time knowledge are separate properties, and `::` asks for
        \\only the first of them; refusing the declaration would force a writer
        \\to give up immutability for a reason that has nothing to do with it.
    );
    code_block(15, "glosso", #string
        \\#import "Io";
        \\
        \\report :: (samples: s64) {
        \\    HALF :: samples / 2;
        \\    i := 0;
        \\    while i < 3 {
        \\        print("bucket % of %\n", i, HALF);
        \\        i += 1;
        \\    }
        \\}
        \\
        \\main :: () { report(8); }
    );
    code_block(16, "text", #string
        \\bucket 0 of 4
        \\bucket 1 of 4
        \\bucket 2 of 4
    );
    paragraph(17, #string,oneline
        \\`HALF` is derived from a parameter, so the checker cannot know it. The
        \\declaration is accepted anyway: the expression is evaluated once, when
        \\control reaches the declaration, and the name is bound to that result
        \\for the rest of the scope. That is what a reader of `HALF ::` expects,
        \\and it is what the loop below it needs.
    );
    paragraph(18, #string,oneline
        \\The price is that a frozen constant is not a compile-time value, and
        \\every construct that wanted one says so at the use rather than at the
        \\declaration. For a local `FROZEN :: n * 2` over a runtime `n`,
        \\`#if FROZEN == 14` is `error: unknown const FROZEN`,
        \\`grid: [FROZEN]s64;` is
        \\`error: array count 'FROZEN' is not compile-time known`, and
        \\`#assert #comptime FROZEN == 14` is
        \\`error: #assert #comptime condition is not compile-time evaluable`.
    );
    paragraph(19, #string,oneline
        \\`::=` asks for the other property, so it reports the failure at the
        \\declaration: `K ::= n * 2;` over a runtime `n` is
        \\`error: comptime variable initializer must be compile-time evaluable`.
        \\A later write to a compile-time binding is held to the same standard;
        \\`i: s64 := 0; i = n;` is
        \\`error: comptime assignment must be compile-time evaluable`.
    );

    subheading(20, "A compile-time binding is a variable");
    paragraph(21, #string,oneline
        \\`::=` binds a name that may be reassigned while the checker runs. That
        \\is what makes an unrolled loop possible: `#inline while` re-evaluates
        \\its condition in the compile-time environment after each unrolled body,
        \\so the body has to move something the condition reads.
    );
    code_block(22, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Vec3 :: struct { x: f32; y: f32; z: f32; }
        \\
        \\main :: () {
        \\    i ::= 0;
        \\    #inline while i < 3 {
        \\        print("%\n", field_name(Vec3, i));
        \\        i += 1;
        \\    }
        \\}
    );
    code_block(23, "text", #string
        \\x
        \\y
        \\z
    );
    paragraph(24, #string,oneline
        \\`i := 0` would not serve here: the condition would not be compile-time
        \\evaluable and `field_name(Vec3, i)` would not have an index. `while`
        \\and `#inline while` covers the loop itself. A compile-time binding has
        \\no runtime storage and therefore no address, so `p := *i;` is
        \\`error: cannot take pointer to i`.
    );
    note(25, #string,oneline
        \\`::=` means something else at file scope. Only a declaration inside a
        \\body is entered into the compile-time environment, so a top-level
        \\`G ::= 7;` is an ordinary mutable global and `#if G == 7` after it is
        \\`error: unknown const G`. Use `::` for a file-scope constant.
    );

    subheading(26, "Compile-time meta-types");
    paragraph(27, #string,oneline
        \\`Code`, `Pattern`, `Namespace`, and `Library` describe values that
        \\exist only while the compiler is building the program. Their layouts
        \\are zero-sized and the checker rejects a runtime local immediately.
        \\The capitalisation is part of the language: the former lower-case
        \\`pattern` spelling is now an ordinary identifier, not a type.
    );
    table_header(28, "Type or annotation form   —   Role");
    table_row(29, "`Code`   |   Type of a `#code` quotation.");
    table_row(30, "`Pattern`   |   Type of `#pattern P` with no subject.");
    table_row(31, "`Namespace`   |   Type produced by `#import` and `#load`.");
    table_row(36, "`Library`   |   Type produced by `#library`.");
    table_row(37, "`Typeclass(T, …)`   |   Explicit annotation for a typeclass declaration with those type parameters.");
    table_row(38, "`Macro(signature)`   |   Explicit annotation for a `#expand` declaration with that function signature.");
    paragraph(32, #string,oneline
        \\Bind one of these values with `::`, or state its meta-type in the new
        \\typed-definition form. `:=` asks for runtime storage and reports, for
        \\example, `a 'Pattern' value is compile-time only; bind it with '::'
        \\rather than ':='`. The older `type` value is also zero-sized, but it
        \\does not receive that immediate storage diagnostic; use `::` when the
        \\name must be available to compile-time operations.
    );
    note(40, #string,oneline
        \\`Typeclass(...)` and `Macro(...)` are accepted as explicit declaration
        \\annotations. They are not general type-value expressions or callable
        \\constructors.
    );
    code_block(39, "glosso", #string
        \\IO : Namespace : #import "Io";
        \\C_Runtime : Library : #library,system "c";
        \\Predicate : Typeclass(type) : typeclass(T: type) {}
        \\twice : Macro((ssize) -> ssize) :
        \\    (value: ssize) -> ssize #expand { return value + value; }
        \\
        \\main :: () { IO.print("%\n", twice(21)); }
    );
    code_block(33, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Token :: union { Number: f64; Name: string; Eof: void; }
        \\
        \\Elem   :: s32;
        \\NUMBER :: #pattern Token.Number(n);
        \\BANNER :: #code { print("generated line\n"); };
        \\
        \\main :: () {
        \\    Local  :: f64;
        \\    print("Elem=% Local=%\n", type_name(Elem), type_name(Local));
        \\    #insert BANNER;
        \\    t: Token = .Number(2.0);
        \\    if #pattern t == {
        \\    case #insert NUMBER; print("number\n");
        \\    else;                print("something else\n");
        \\    }
        \\}
    );
    code_block(34, "text", #string
        \\Elem=s32 Local=f64
        \\generated line
        \\number
    );
    paragraph(35, #string,oneline
        \\A procedure that needs a type for reflection normally takes it as a
        \\compile-time parameter. Compile-Time and Type-Only Parameters covers
        \\those parameters, Code Values: `#code` and Backticks covers `Code`, and
        \\Patterns as Compile-Time Values covers `Pattern`.
    );
}

render_section_108 :: () {
    paragraph(0, #string,oneline
        \\`#assert cond` is one statement doing two jobs. When the condition can
        \\be evaluated during checking it is a compile-time check that emits no
        \\code; when it cannot, the same statement compiles into a runtime check.
        \\There is no separate spelling for the runtime one and no flag that
        \\turns one into the other.
    );
    paragraph(1, #string,oneline
        \\The decision runs in order. The condition is type-checked first and
        \\must be `bool`. Then the constant evaluator is asked for its value. If
        \\the answer is `false` the compilation fails; if it is `true` the
        \\statement lowers to nothing at all; if there is no answer the statement
        \\becomes a runtime assertion.
    );
    table_header(2, "Condition   —   Result");
    table_row(3, "Evaluates to `true`   |   Nothing is emitted.");
    table_row(4, "Evaluates to `false`   |   `error: assertion failed`, or `error: assertion failed: <message>`.");
    table_row(5, "Cannot be evaluated   |   A runtime check is compiled in.");
    table_row(6, "Is not a `bool`   |   `#assert 5;` is `error: got ssize, expected bool`.");

    subheading(7, "The compile-time assertion");
    paragraph(8, #string,oneline
        \\Anything the constant evaluator can answer is fair game for a
        \\compile-time assertion, which in practice means layout facts,
        \\reflection results, and target queries. A passing assertion costs
        \\nothing, so it can sit permanently next to the declaration whose
        \\invariant it guards.
    );
    code_block(9, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Vec3 :: struct { x: f32; y: f32; z: f32; }
        \\
        \\main :: () {
        \\    #assert size_of(Vec3) == 12;
        \\    #assert #comptime field_count(Vec3) == 3, "Vec3 must stay three-wide";
        \\    print("checks passed at compile time\n");
        \\}
    );
    code_block(10, "text", #string
        \\checks passed at compile time
    );
    paragraph(11, #string,oneline
        \\A failing one stops the build and points at the `#assert` keyword.
        \\`#assert 1 + 1 == 3;` is `error: assertion failed`, and
        \\`#assert #comptime 1 + 1 == 3, "math is broken";` is
        \\`error: assertion failed: math is broken`.
    );
    paragraph(12, #string,oneline
        \\A typeclass predicate is an ordinary compile-time `bool`, so an
        \\instance requirement can be written as an assertion. For a struct with
        \\no instance, `#assert Show(Opaque), "Opaque must be printable";` is
        \\`error: assertion failed: Opaque must be printable`. How an Instance Is
        \\Chosen explains what the predicate is asking.
    );

    subheading(13, "The runtime assertion");
    paragraph(14, #string,oneline
        \\When the condition depends on a value the compiler cannot know, the
        \\same statement becomes a check in the emitted program. It fires on the
        \\way past, prints the source position and the message, and aborts.
    );
    code_block(15, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    x := 5;
        \\    #assert x > 100, "x must be big";
        \\    print("unreachable\n");
        \\}
    );
    code_block(16, "text", #string
        \\…\program.glo:5:5: assertion failed: x must be big
        \\glosso: program exited with status exit code: 134
    );
    paragraph(17, #string,oneline
        \\The runtime form is not removed at any optimisation level: `-O0`
        \\through `-O3` all abort here. It exits through the same path as the
        \\language's other runtime checks, which Runtime Safety Checks and Panics
        \\describes.
    );

    subheading(18, "What the two lower to");
    paragraph(19, #string,oneline
        \\Nothing about the two spellings differs. Only whether the condition
        \\folded decides which of them a given `#assert` becomes, and `#dump`
        \\shows the difference directly.
    );
    code_block(20, "glosso", #string
        \\static_ok :: (x: s64) -> s64 #dump {
        \\    #assert 1 + 1 == 2, "arithmetic still works";
        \\    return x;
        \\}
        \\
        \\dynamic_check :: (x: s64) -> s64 #dump {
        \\    #assert x > 0, "x must be positive";
        \\    return x;
        \\}
        \\
        \\main :: () { d := static_ok(1) + dynamic_check(2); }
    );
    code_block(21, "text", #string
        \\; ---- #dump typed-ir dynamic_check(x: s64) -> s64  [9 ins] ----
        \\   0  temp_mark v1
        \\   1  const v2 =0
        \\   2  call v3 'op_gt_s64_s64' [v0,v2]
        \\   3  jnz v3 'L1'
        \\   4  const v4 ="…\program.glo:7:5: assertion failed: x must be positive
        \\"
        \\   5  magic _ 'assert_failed' [v4]
        \\   6  label 'L1'
        \\   7  temp_restore v1
        \\   8  ret v0
        \\; ---- end dynamic_check ----
        \\; ---- #dump typed-ir static_ok(x: s64) -> s64  [3 ins] ----
        \\   0  temp_mark v1
        \\   1  temp_restore v1
        \\   2  ret v0
        \\; ---- end static_ok ----
    );
    paragraph(22, #string,oneline
        \\`static_ok` has no instruction for its assertion; the statement
        \\disappeared during checking, message and all. `dynamic_check` gained a
        \\comparison, a branch over the failure, and a call to `assert_failed`
        \\with a string that already carries the source position, because the
        \\position is known then and not later.
    );

    subheading(23, "`#assert #comptime`");
    paragraph(24, #string,oneline
        \\Writing `#comptime` after `#assert` removes the third outcome. The
        \\condition must now be evaluable, and failing to evaluate becomes an
        \\error rather than a silent downgrade. That matters for a check that is
        \\meant to hold at build time: without the modifier, a change that makes
        \\the condition depend on a local quietly turns a compile-time guarantee
        \\into a runtime one and nothing reports it.
    );
    paragraph(25, #string,oneline
        \\For `x := 5;` followed by `#assert #comptime x > 0;` the diagnostic is
        \\`error: #assert #comptime condition is not compile-time evaluable`,
        \\with `note: unknown const x` pointing at the part that could not be
        \\folded. The note names the first thing the evaluator gave up on, which
        \\is usually enough to find the mistake.
    );
    paragraph(26, #string,oneline
        \\Inside a generic body the assertion is checked once per instantiation,
        \\and only for the types that actually reach it.
    );
    code_block(27, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\label_of :: (x: $T) -> string {
        \\    #assert #comptime Show(T), "label_of needs a Show instance";
        \\    return show(x);
        \\}
        \\
        \\main :: () {
        \\    print("% %\n", label_of(41), label_of("hi"));
        \\}
    );
    code_block(28, "text", #string
        \\41 hi
    );
    paragraph(29, #string,oneline
        \\Adding `label_of(o)` for a struct with no `Show` instance is
        \\`error: assertion failed: label_of needs a Show instance`, reported at
        \\the assertion inside the generic body rather than at the call.
    );

    subheading(30, "The message");
    paragraph(31, #string,oneline
        \\The message is optional, follows a comma, and must be a compile-time
        \\`string`. It need not be a literal: any expression the evaluator folds
        \\to a string is accepted, so `str_cat` can compose one from the values
        \\that made the check fail. A value of the wrong type is
        \\`error: #assert message must be a compile-time string`, and a runtime
        \\local used as the message is `error: unknown const reason`, pointing at
        \\the message rather than the condition.
    );

    subheading(32, "`#compile_error`");
    paragraph(33, #string,oneline
        \\`#compile_error <expr>` evaluates its operand and reports the result as
        \\the error message. It has no condition of its own and fires whenever
        \\checking reaches it, which makes it the payload for a `#if` guard
        \\rather than a check in its own right. The message being a value rather
        \\than a fixed string is the point: the failing case can name itself.
    );
    code_block(34, "glosso", #string
        \\#import "String_Builder";
        \\
        \\NAME :: "widget";
        \\
        \\main :: () {
        \\    #compile_error str_cat("unsupported backend: ", NAME);
        \\}
    );
    paragraph(35, #string,oneline
        \\That is `error: unsupported backend: widget`. The operand is held to
        \\the same standard as an `#assert` message: a runtime local is
        \\`error: unknown const reason`.
    );

    subheading(36, "Guarding an instantiation");
    paragraph(37, #string,oneline
        \\`#if` prunes the branch it does not select, so a `#compile_error`
        \\inside an unselected branch never fires. That pairing is how a generic
        \\body rejects an instantiation with a message of the author's choosing
        \\instead of whatever the body happens to fail on first.
    );
    code_block(38, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\#import "String_Builder";
        \\
        \\byte_width :: (x: $T) -> ssize {
        \\    #if !Is_Integer(T) {
        \\        #compile_error str_cat("byte_width needs an integer, got ", type_name(T));
        \\    }
        \\    return size_of(T);
        \\}
        \\
        \\main :: () {
        \\    print("byte_width(u8)  = %\n", byte_width(cast(u8) 1));
        \\    print("byte_width(ssize) = %\n", byte_width(1));
        \\}
    );
    code_block(39, "text", #string
        \\byte_width(u8)  = 1
        \\byte_width(ssize) = 8
    );
    paragraph(40, #string,oneline
        \\Adding `byte_width(1.5)` is
        \\`error: byte_width needs an integer, got f64`. A `where` clause is the
        \\other way to say this, and the two differ in what they do to overload
        \\selection: `where Is_Integer(T)` removes the candidate and reports
        \\`error: constraint failed for byte_width`, while the `#if` guard keeps
        \\the candidate and reports the chosen message. Constraints with `where`
        \\covers the first.
    );

    note(41, #string,oneline
        \\Both directives are statements, not declarations. At file scope
        \\`#assert 1 == 1;` is `error: bad decl name 'assert'` and
        \\`#compile_error "no";` is `error: bad decl name 'compile_error'`. A
        \\whole-file invariant goes inside a top-level `#comptime` block, which
        \\is a declaration and takes statements.
    );
    code_block(42, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Header :: struct { magic: u32; count: s32; }
        \\
        \\#comptime {
        \\    #assert size_of(Header) == 8, "Header must stay 8 bytes wide";
        \\    print("[ct] Header layout checked\n");
        \\}
        \\
        \\main :: () {}
    );
    code_block(43, "text", #string
        \\glosso: compile program.glo (target=x86_64-pc-windows-msvc)
        \\[ct] Header layout checked
        \\glosso: link program.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done program.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
    );
    paragraph(44, #string,oneline
        \\Adding a `pad: u8;` field to `Header` then gives
        \\`error: assertion failed: Header must stay 8 bytes wide`, reported at
        \\the `#assert` inside the block. Static Branching with `#if` covers the
        \\other half of the guard, and Struct Memory Layout covers what
        \\`size_of` is measuring.
    );
}

render_section_109 :: () {
    paragraph(0, #string,oneline
        \\`#code` quotes Glosso syntax and produces a value of the built-in
        \\compile-time type `Code`. A quotation is parsed where it is written,
        \\but names and types inside it are resolved when `#insert` places it
        \\into a program. The same value can therefore be inserted more than
        \\once and can acquire a different meaning in each insertion scope.
    );
    subheading(1, "Block, statement, and expression quotations");
    table_header(2, "Form   —   Contents");
    table_row(3, "`#code { statements }`   |   A statement list, including nested declarations.");
    table_row(4, "`#code statement`   |   One statement; the surrounding semicolon terminates both the quotation and its use.");
    table_row(5, "`#code (expression)`   |   One expression, ready for expression `#insert`.");
    code_block(6, "glosso", #string
        \\#import "Io";
        \\
        \\GREET :: #code { print("hello from Code\n"); };
        \\STEP  :: #code count += 1;
        \\
        \\main :: () {
        \\    count := 0;
        \\    #insert GREET;
        \\    #insert STEP;
        \\    #insert STEP;
        \\
        \\    comparison :: #code (count == 2);
        \\    print("count=% equal=%\n", count, #insert comparison);
        \\}
    );
    code_block(7, "text", #string
        \\hello from Code
        \\count=2 equal=1
    );
    paragraph(8, #string,oneline
        \\The single form is new shorthand for the common one-statement or
        \\one-expression case. `#code print("x")` and `#code (a < b)` need no
        \\braces. A block remains necessary when order or several declarations
        \\are part of the quotation.
    );
    subheading(9, "A `Code` value is compiler-only");
    paragraph(10, #string,oneline
        \\`Code` needs no import, has size zero, and never reaches generated
        \\machine code. Bind a quotation with `::` or pass it directly to a
        \\`#expand` macro. `body := #code print("x");` is rejected with
        \\`a 'Code' value is compile-time only; bind it with '::' rather than
        \\':='`, and an ordinary runtime procedure cannot consume one.
    );
    paragraph(11, #string,oneline
        \\The contents are syntax, not a closure. `STEP` above names `count`
        \\before any such local exists; only the insertion sites are checked,
        \\and both have a `count` in scope. Inserting a quote into a scope where
        \\one of its names is absent reports the error at that insertion.
    );
    subheading(12, "Double-backtick substitution");
    paragraph(13, #string,oneline
        \\Inside a quotation, two backticks ask the compiler to substitute a
        \\compile-time binding while it materialises the syntax. A `string` can
        \\supply an identifier, a `type` can supply a type spelling, and another
        \\`Code` value can supply syntax. This is distinct from the single
        \\backtick used by macros to name the caller's scope.
    );
    code_block(14, "glosso", #string
        \\#import "Io";
        \\
        \\Vec2 :: struct { x: s32 = 0; y: s32 = 0; }
        \\
        \\show_field :: (v: Vec2, #comptime name: string) {
        \\    #insert #code print("field % = %\n", name, v.``name);
        \\}
        \\
        \\main :: () {
        \\    value: Vec2 = .{ .x = 7, .y = 9 };
        \\    show_field(value, "x");
        \\    show_field(value, "y");
        \\}
    );
    code_block(15, "text", #string
        \\field x = 7
        \\field y = 9
    );
    paragraph(16, #string,oneline
        \\The plain `name` in the format call remains the string parameter.
        \\The spliced `v.``name` becomes `v.x` or `v.y` before member lookup.
        \\The argument of a `#comptime` parameter must be known at compile time,
        \\so a runtime string cannot be used to synthesize an identifier.
    );
    subheading(17, "What quotations can carry");
    paragraph(18, #string,oneline
        \\A block quotation uses the statement grammar. Besides executable
        \\statements it can carry a nested procedure, type, macro, or typeclass
        \\instance declaration, and it can carry quoted `case` fragments for
        \\insertion into a switch. A quotation is still not source text: it is
        \\already parsed, retains hygiene marks, and is never written to the
        \\generated-source cache.
    );
    bullet(19, #string,oneline
        \\Use `Code` when the generated shape can be expressed as parsed Glosso
        \\syntax and only names need to vary.
    );
    bullet(20, #string,oneline
        \\Use a `string` insertion when the generator must construct tokens or
        \\whole declarations that cannot be represented by one fixed quotation.
    );
}

render_section_110 :: () {
    paragraph(0, #string,oneline
        \\`#insert` evaluates its operand at compile time and replaces itself
        \\with the resulting syntax. Its position selects both the accepted
        \\source and the grammar applied to that source.
    );
    table_header(1, "Position and form   —   Requirement   —   Result");
    table_row(2, "Statement `#insert source;`   |   `Code` or `string`   |   Statements in the surrounding body.");
    table_row(3, "Top-level `#insert source;`   |   `Code` or `string`   |   Program declarations.");
    table_row(4, "Expression `#insert code`   |   `Code` containing exactly one expression   |   That expression and its type.");
    table_row(5, "Scoped `#insert,scope() code`   |   One-expression `Code`   |   An expression resolved after macro-local hygiene.");
    table_row(6, "Pattern `#insert value`   |   `Pattern`   |   A pattern element.");
    subheading(7, "Statement and expression insertion");
    code_block(8, "glosso", #string
        \\#import "Io";
        \\
        \\repeat_three_times :: (body: Code) #expand {
        \\    #insert body;
        \\    #insert body;
        \\    #insert body;
        \\}
        \\
        \\scoped_less :: (comparison: Code) -> bool #expand {
        \\    a := 1;
        \\    b := 2;
        \\    return (#insert,scope() comparison);
        \\}
        \\
        \\insert_in_caller :: (body: Code) #expand {
        \\    #insert body;
        \\}
        \\
        \\main :: () {
        \\    total := 0;
        \\    repeat_three_times(#code total += 14);
        \\    print("repeated=%\n", total);
        \\
        \\    message := "quotation scope";
        \\    insert_in_caller(#code print("%\n", message));
        \\    print("scoped=%\n", scoped_less(#code (a < b)));
        \\}
    );
    code_block(9, "text", #string
        \\repeated=42
        \\quotation scope
        \\scoped=1
    );
    paragraph(10, #string,oneline
        \\A statement insertion accepts either a quotation or generated text.
        \\An expression insertion is intentionally narrower: it accepts only
        \\`Code` with one expression statement. A string, a block with two
        \\statements, or a quotation whose only item is a declaration is
        \\rejected rather than guessed into an expression.
    );
    paragraph(11, #string,oneline
        \\`scope()` matters inside a macro. It makes the inserted quotation see
        \\the hygienically renamed locals established by that expansion. In
        \\`scoped_less`, the caller writes names `a` and `b` that do not exist at
        \\the call site; the scoped insertion resolves them as the macro's two
        \\locals and produces a `bool`.
    );
    subheading(12, "Generated text and a typed insertion block");
    paragraph(13, #string,oneline
        \\A `string` operand is lexed and parsed at the insertion position.
        \\Instead of calling a separate generator, `#insert -> string { ... }`
        \\runs the block in the constant evaluator and checks its returned value
        \\against the stated type before parsing it.
    );
    code_block(14, "glosso", #string
        \\#import "Io";
        \\
        \\ANSWER_SOURCE :: "ANSWER :: 40 + 2;";
        \\#insert ANSWER_SOURCE;
        \\
        \\main :: () {
        \\    #insert "print(\"plain source %\\n\", ANSWER);";
        \\
        \\    #insert -> string {
        \\        prefix := "typed source";
        \\        return "print(\"typed source %\\n\", ANSWER);";
        \\    }
        \\}
    );
    code_block(15, "text", #string
        \\plain source 42
        \\typed source 42
    );
    paragraph(16, #string,oneline
        \\The annotation after `->` is the compile-time block's result type, not
        \\the type of the generated expression. A statement or top-level
        \\insertion still ultimately requires `Code` or `string`. The typed form
        \\is especially useful when a generator has local control flow and a
        \\mistyped return should be diagnosed before parsing generated source.
    );
    subheading(17, "Top-level declarations");
    paragraph(18, #string,oneline
        \\At top level, text is parsed as declarations. That is the general way
        \\to synthesize a constant, an aggregate with a computed field list, or
        \\several related overloads. A `Code` block can also carry already-parsed
        \\procedure, aggregate, macro, and instance declarations.
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\#import "String_Builder";
        \\
        \\struct_source :: (name: string, fields: ssize) -> string {
        \\    builder := sb_new();
        \\    sb_append(*builder, name);
        \\    sb_append(*builder, " :: struct {\n");
        \\    i := 0;
        \\    while i < fields {
        \\        sb_append(*builder, "    f");
        \\        sb_append(*builder, show(i));
        \\        sb_append(*builder, ": s32 = 0;\n");
        \\        i += 1;
        \\    }
        \\    sb_append(*builder, "}\n");
        \\    return sb_to_string(builder);
        \\}
        \\
        \\#insert struct_source("Generated", 2);
        \\
        \\main :: () {
        \\    value: Generated = .{ .f0 = 20, .f1 = 22 };
        \\    print("%\n", value.f0 + value.f1);
        \\}
    );
    code_block(20, "text", #string
        \\42
    );
    subheading(21, "Pattern insertion");
    paragraph(22, #string,oneline
        \\A subjectless `#pattern P` quotation produces a compiler-only
        \\`Pattern` value. In pattern position, `#insert` accepts that value and
        \\clones its pattern at every use. `#insert A | #insert B` is an
        \\or-pattern because insertion binds tighter than `|`.
    );
    code_block(23, "glosso", #string
        \\#import "Io";
        \\
        \\Token :: union { Number: f64; Name: string; Eof: void; }
        \\NUMBER :: #pattern Token.Number(n);
        \\NAME   :: #pattern Token.Name(text);
        \\
        \\classify :: (token: Token) -> string {
        \\    if #pattern token == {
        \\    case #insert NUMBER; return "number";
        \\    case #insert NAME;   return "name";
        \\    else;                return "end";
        \\    }
        \\}
        \\
        \\main :: () { print("%\n", classify(.Number(2.5))); }
    );
    code_block(24, "text", #string
        \\number
    );
    subheading(25, "Generated-source files and diagnostics");
    paragraph(26, #string,oneline
        \\Every string insertion is materialised under
        \\`<cache>/generated/insert/v1/<sha256>.glo` before parsing. Equal text
        \\shares a cache entry. `--show-generated` prints those paths, while
        \\`--cache-dir` selects the cache root. `Code` and `Pattern` insertion
        \\uses syntax trees directly and creates no file.
    );
    paragraph(27, #string,oneline
        \\A generated parse or type error points both to the written `#insert`
        \\and to the generated file. Nested insertion adds one
        \\`generated by this #insert` note per level, preserving the expansion
        \\chain instead of flattening it into one location.
    );
    subheading(28, "Refusals and bounds");
    table_header(29, "Written   —   Diagnostic");
    table_row(30, "`#insert 42;` in a body   |   `#insert expects Code or string source`");
    table_row(31, "`#insert 42;` at top level   |   `top-level #insert expects Code or string source`");
    table_row(32, "Expression insertion of a string   |   `expression #insert expects Code`");
    table_row(33, "Expression insertion of several statements   |   `expression #insert expects Code containing exactly one expression`");
    table_row(34, "`#insert` inside a struct body   |   `unexpected token 'insert'`");
    paragraph(35, #string,oneline
        \\Recursive insertion is bounded: nesting stops at 16 and the total
        \\number of expansions at 16384. Crossing either boundary reports
        \\`#insert expansion limit exceeded`.
    );
}

render_section_111 :: () {
    paragraph(0, #string,oneline
        \\`#expand` declares a macro. The checker selects it using the argument
        \\types, substitutes argument syntax for parameters, gives declarations
        \\fresh hygienic names, and checks the expanded result in the caller.
        \\A macro with no value return is invoked as a statement; a macro with an
        \\explicit non-`void` return type is a value macro and can contain a full
        \\statement body.
    );
    table_header(1, "Declaration   —   Use");
    table_row(2, "`f :: (...) #expand { ... }`   |   Statement macro.");
    table_row(3, "`f :: (...) -> T #expand { ... }`   |   Typed value macro; every reachable path must return `T`.");
    table_row(4, "`f :: (...) #expand,expression { return e; }`   |   Legacy inferred one-expression macro.");
    subheading(5, "Typed value macros");
    paragraph(6, #string,oneline
        \\The return annotation now selects value context by itself; writing
        \\`#expand,expression` is unnecessary when `-> T` is present. Unlike the
        \\legacy inferred form, a typed value macro may use ordinary control
        \\flow, local declarations, several returns, and `defer`. Its expansion
        \\is checked as a value-producing block and may not fall through.
    );
    code_block(7, "glosso", #string
        \\#import "Io";
        \\
        \\maximum :: (a: ssize, b: ssize) -> ssize #expand {
        \\    if a > b return a;
        \\    return b;
        \\}
        \\
        \\decision :: () -> ssize #expand {
        \\    if `lower < `upper return 0;
        \\    defer print("defer inside decision\n");
        \\    return 1;
        \\}
        \\
        \\main :: () {
        \\    lower := 7;
        \\    upper := 3;
        \\    print("maximum=%\n", maximum(lower, upper));
        \\    print("decision=%\n", decision());
        \\}
    );
    code_block(8, "text", #string
        \\maximum=7
        \\defer inside decision
        \\decision=1
    );
    paragraph(9, #string,oneline
        \\The unquoted parameters of `maximum` are substituted with the caller's
        \\expressions. `decision` instead uses single-backtick identifiers to
        \\look up `lower` and `upper` directly in the caller. Its ordinary
        \\`defer` belongs to the value-macro block and runs before that block
        \\hands its result back.
    );
    subheading(10, "Hygiene and caller escapes");
    paragraph(11, #string,oneline
        \\An unquoted local declared by a macro is renamed for each expansion,
        \\so it cannot collide with a same-named caller local. A single backtick
        \\opts an identifier or control-flow keyword into the caller's scope.
        \\That supports caller-variable access, deliberately published
        \\declarations, caller returns, and caller-scoped defers.
    );
    code_block(12, "glosso", #string
        \\#import "Io";
        \\
        \\bump_caller :: () #expand {
        \\    number := 1000;
        \\    _ := number;
        \\    `number += 10;
        \\}
        \\
        \\leave_caller :: () -> ssize #expand {
        \\    defer print("macro defer\n");
        \\    if `stop `return 42;
        \\    return 0;
        \\}
        \\
        \\caller_defer :: () #expand {
        \\    `defer print("caller defer\n");
        \\    print("registered\n");
        \\}
        \\
        \\escaped :: () -> ssize {
        \\    stop := true;
        \\    _ := leave_caller();
        \\    return -1;
        \\}
        \\
        \\main :: () {
        \\    number := 0;
        \\    bump_caller();
        \\    print("number=% escaped=%\n", number, escaped());
        \\    caller_defer();
        \\    print("after registration\n");
        \\}
    );
    code_block(13, "text", #string
        \\macro defer
        \\number=10 escaped=42
        \\registered
        \\after registration
        \\caller defer
    );
    paragraph(14, #string,oneline
        \\Putting a backtick before `return 42` leaves `escaped`, the procedure
        \\surrounding the expansion; the value is checked against that caller's
        \\return type. The ordinary defer in `leave_caller` still runs while the
        \\expansion unwinds. A backtick before `defer` is different: it registers
        \\with the caller, so its action runs only when `main` leaves.
    );
    note(15, #string,oneline
        \\A backticked declaration can intentionally publish a name to inserted
        \\caller code, as when the macro writes a backtick before
        \\`it := 0;`, then `#insert body;`. Use that narrowly: ordinary macro
        \\locals are hygienic for a reason.
    );
    subheading(16, "Nested and recursive macros");
    paragraph(17, #string,oneline
        \\Macros may be declared inside procedures and inside other macros. A
        \\nested macro participates in the surrounding expansion and can use the
        \\names established there. Recursive value macros are also supported
        \\when static branching makes the expansion terminate.
    );
    code_block(18, "glosso", #string
        \\#import "Io";
        \\
        \\outer_message :: () #expand {
        \\    inner_message :: () #expand { print("nested macro\n"); }
        \\    inner_message();
        \\}
        \\
        \\factorial :: (n: ssize) -> ssize #expand {
        \\    #if n <= 1 return 1;
        \\    else { return n * factorial(n - 1); }
        \\}
        \\
        \\main :: () {
        \\    outer_message();
        \\    print("factorial=%\n", factorial(5));
        \\}
    );
    code_block(19, "text", #string
        \\nested macro
        \\factorial=120
    );
    paragraph(20, #string,oneline
        \\`#if` is essential in `factorial`: it is selected during expansion, so
        \\the recursive call disappears at the base case. Ordinary `if` would
        \\remain runtime control flow and would not by itself stop compile-time
        \\macro expansion.
    );
    subheading(21, "`Code` parameters");
    paragraph(22, #string,oneline
        \\A macro may take `Code` from its caller and insert it zero, one, or many
        \\times. This is the basis of loop, conditional, and resource-wrapper
        \\macros. Use `#insert,scope()` when a one-expression quote must resolve
        \\against the macro's hygienic locals; use ordinary `#insert` when caller
        \\code should remain in caller scope.
    );
    code_block(23, "glosso", #string
        \\#import "Io";
        \\
        \\with_value :: (body: Code) #expand {
        \\    `value_from_macro := 42;
        \\    #insert body;
        \\}
        \\
        \\main :: () {
        \\    with_value(#code print("value=%\n", value_from_macro));
        \\}
    );
    code_block(24, "text", #string
        \\value=42
    );
    subheading(25, "Selection, defaults, and `#modify`");
    paragraph(26, #string,oneline
        \\Macro parameters may be concrete or generic and may have defaults.
        \\Candidate selection uses their inferred argument types and any `where`
        \\clauses. A `#modify` block runs after generic variables are inferred
        \\and may rewrite those variables before the expanded body is checked.
    );
    code_block(27, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\widen_small :: (value: $T) -> $R
        \\#modify {
        \\    R = T;
        \\    if T == u8 { R = u32; }
        \\    if T == s8 { R = s32; }
        \\    return true;
        \\}
        \\{ return value; }
        \\
        \\main :: () {
        \\    small: u8 = 200;
        \\    widened := widen_small(small);
        \\    print("% %\n", widened, type_name(type_of(widened)));
        \\}
    );
    code_block(28, "text", #string
        \\200 u32
    );
    bullet(29, #string,oneline
        \\A macro name still cannot be redeclared at file scope, even for a
        \\different parameter type or a different statement/value form.
    );
    bullet(30, #string,oneline
        \\`#derive` procedures and typeclass expansion methods use the same macro
        \\machinery with signatures fixed by their protocols.
    );
}
render_section_112 :: () {
    paragraph(0, #string,oneline
        \\Reflection is the set of compile-time intrinsics that answer questions
        \\about a type: its tag, its size, the names and types of its fields, the
        \\members of an enum, the variants of a union. They live in `std/Meta` and
        \\arrive with `#import "Meta";`. Every one of them is folded to a constant
        \\by the checker, so a reflection query costs nothing at run time and is
        \\available wherever a constant is: `#comptime`, `#if`, `#assert`, a
        \\`where` clause, a constant initialiser, and the argument of `#insert`.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Vec3  :: struct { x: f32 = 0.0; y: f32 = 0.0; z: f32 = 0.0; }
        \\Color :: enum { Red; Green :: 5; Blue; }
        \\Shape :: union { circle: s32; box: s64; empty: void; }
        \\
        \\main :: () {
        \\    info :: type_info(Vec3);
        \\    print("tag % name % size % alignment %\n",
        \\        cast(s64) info.tag, info.name, info.size, info.alignment);
        \\    print("kinds: Vec3 % Color % Shape %\n",
        \\        cast(s64) type_kind(Vec3), cast(s64) type_kind(Color),
        \\        cast(s64) type_kind(Shape));
        \\    print("fields %: % % %\n", field_count(Vec3),
        \\        field_name(Vec3, 0), field_name(Vec3, 1), field_name(Vec3, 2));
        \\    print("field 0 type %\n", type_name(field_type(Vec3, 0)));
        \\    print("members %: %=% %=% %=%\n", enum_count(Color),
        \\        enum_name(Color, 0), enum_value(Color, 0),
        \\        enum_name(Color, 1), enum_value(Color, 1),
        \\        enum_name(Color, 2), enum_value(Color, 2));
        \\    print("variants %: %:% %:% %:%\n", variant_count(Shape),
        \\        variant_name(Shape, 0), type_name(variant_type(Shape, 0)),
        \\        variant_name(Shape, 1), type_name(variant_type(Shape, 1)),
        \\        variant_name(Shape, 2), type_name(variant_type(Shape, 2)));
        \\}
    );
    code_block(2, "text", #string
        \\tag 7 name Vec3 size 12 alignment 4
        \\kinds: Vec3 7 Color 8 Shape 9
        \\fields 3: x y z
        \\field 0 type f32
        \\members 3: Red=0 Green=5 Blue=6
        \\variants 3: circle:s32 box:s64 empty:void
    );
    subheading(3, "`Type_Info`");
    paragraph(4, #string,oneline
        \\`type_info(T)` answers every shape question about `T` at once. It is an
        \\ordinary struct declared in `std/Meta/Types.glo`, so its result is bound
        \\to a constant and read with `.` like any other value.
    );
    table_header(5, "Field   —   Type   —   Holds");
    table_row(6, "`tag`   |   `Type_Info_Tag`   |   which family `T` belongs to");
    table_row(7, "`name`   |   `string`   |   the printed spelling, as `type_name` gives it");
    table_row(8, "`size`   |   `ssize`   |   size in bytes under the target layout, including `#packed` when present");
    table_row(9, "`alignment`   |   `ssize`   |   required alignment in bytes");
    table_row(10, "`shower`   |   `Any_Show_Proc`   |   the `Show` thunk the `any` boxing carries");
    paragraph(11, #string,oneline
        \\`alignment` is the only route to a type's alignment; there is no
        \\`align_of`, and writing one is `unknown function align_of`. The compiler
        \\populates `shower` with the non-null rendering thunk used when a value
        \\of the described type is boxed into `any`; user code neither implements
        \\nor registers that thunk. `Show`, `FromString`, and `print` are covered
        \\in Formatting, which is the public formatting surface.
    );
    subheading(12, "`Type_Info_Tag`");
    paragraph(13, #string,oneline
        \\The tag is a closed enum of nineteen members numbered `0` through `17`
        \\and `19`. Tag `18` is reserved for the removed character-byte type;
        \\`Rune` remains `19`,
        \\and `type_kind(T)` is the same value without the surrounding record.
        \\Types as Values lists the numbering. What matters when reflecting is
        \\which written spellings collapse onto one tag, because a single tag
        \\often has to be taken apart further.
    );
    table_header(14, "Tag   —   Covers");
    table_row(15, "`Array`   |   `[N]T`, `[]T` and `[..]T` alike");
    table_row(16, "`Pointer`   |   `*T` and `[*]T`");
    table_row(17, "`Union`   |   tagged unions, raw unions, `?T` and `E!T`");
    table_row(18, "`Procedure`   |   procedure types and `#fn_ptr` types");
    table_row(19, "`Enum`   |   `enum` and `enum_flags`");
    table_row(20, "`String`   |   `string`, `cstring`, `string16` and `cstring16`");
    paragraph(21, #string,oneline
        \\The named predicates `Is_Integer`, `Is_Struct`, `Is_Union` and the rest
        \\wrap the tag comparison and are the working vocabulary of `where`
        \\clauses and instance heads; Types as Values gives the full list.
    );
    subheading(22, "The intrinsic table");
    table_header(23, "Intrinsic   —   Answers");
    table_row(24, "`type_info(T)`   |   the record above");
    table_row(25, "`type_kind(T)`   |   the tag alone");
    table_row(26, "`field_count(T)` / `field_name(T, i)` / `field_type(T, i)`   |   struct fields, in declaration order");
    table_row(27, "`enum_count(T)` / `enum_name(T, i)` / `enum_value(T, i)`   |   enum members and their numeric values");
    table_row(28, "`variant_count(T)` / `variant_name(T, i)` / `variant_type(T, i)`   |   union variants; `void` where a variant has no payload");
    table_row(29, "`simd_lane_count(V)` / `simd_element_type(V)`   |   the shape of a `Simd(T, N)`");
    table_row(30, "`matrix_row_count(M)` / `matrix_column_count(M)` / `matrix_element_count(M)`   |   the shape of a `Matrix(T, R, C)`");
    table_row(31, "`matrix_element_type(M)` / `matrix_transpose_type(M)` / `matrix_product_type(A, B)`   |   matrix types computed from matrix types");
    paragraph(32, #string,oneline
        \\`type_of`, `type_name` and `size_of` belong to the same family and are
        \\described in Types as Values; the `pattern_binder_*` and `pattern_missing*`
        \\intrinsics belong to Pattern Reflection; the `derive_type_*` intrinsics
        \\belong to Writing a Derive Macro. `simd_*` comes with `#import "Simd";`
        \\and `matrix_*` with `#import "Math/Matrix";`, the rest with
        \\`#import "Meta";`.
    );
    note(33, #string,oneline
        \\Every one of these queries is registered compile-time-only. A query
        \\that cannot be folded is an error at the query, not a lookup at run
        \\time. The compiler also emits static `Type_Info` records for runtime
        \\`any` boxes, which is distinct from evaluating these queries. That is why the index
        \\arguments below have to be constants.
    );
    subheading(34, "Indices must be compile-time constants");
    paragraph(35, #string,oneline
        \\`field_name(T, i)` folds only if `i` folds. An ordinary loop variable
        \\does not: an `i := 0` counter driving a `while` gives `unknown const i`
        \\at the intrinsic, and so does the loop variable of a plain `for` and of
        \\`#inline for`, which unrolls the body but does not record a compile-time
        \\value for its variable. Two spellings do work: a literal index, and a
        \\counter that is itself a compile-time binding.
    );
    code_block(36, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\#import "String_Builder";
        \\
        \\Vec3 :: struct { x: f32 = 0.0; y: f32 = 0.0; z: f32 = 0.0; }
        \\
        \\fields_desc :: (T: type, i: ssize) -> string {
        \\    if i >= field_count(T) return "";
        \\    one := str_cat(" ", str_cat(field_name(T, i),
        \\        str_cat(": ", type_name(field_type(T, i)))));
        \\    return str_cat(one, fields_desc(T, i + 1));
        \\}
        \\
        \\VEC3_FIELDS :: #comptime fields_desc(Vec3, 0);
        \\
        \\main :: () {
        \\    print("recursive helper:%\n", VEC3_FIELDS);
        \\    print("literal index:    %\n", field_name(Vec3, 1));
        \\    i ::= 0;
        \\    #inline while i < field_count(Vec3) {
        \\        print("#inline while:    %\n", field_name(Vec3, i));
        \\        i += 1;
        \\    }
        \\}
    );
    code_block(37, "text", #string
        \\recursive helper: x: f32 y: f32 z: f32
        \\literal index:    y
        \\#inline while:    x
        \\#inline while:    y
        \\#inline while:    z
    );
    paragraph(38, #string,oneline
        \\The recursive helper is the idiom the standard library uses. It carries
        \\the index as an ordinary parameter, and a parameter of a
        \\const-evaluated call is a constant in the callee, so the intrinsic folds
        \\at every depth. It also composes: the helper returns text, which is what
        \\`#insert` wants. `#inline while` works because the counter is declared
        \\`i ::= 0`, a compile-time binding; declaring it `i := 0` is `#inline
        \\while condition must be compile-time evaluable`.
    );
    subheading(39, "Optionals, results, vectors and matrices");
    paragraph(40, #string,oneline
        \\`?T` and `E!T` are compiler-baked unions, so reflection sees them as
        \\unions with two variants apiece. `Simd` and `Matrix` are flagged array
        \\types with tags of their own and shape intrinsics of their own.
    );
    code_block(41, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\#import "Simd";
        \\#import "Math/Matrix";
        \\
        \\Maybe    :: ?s32;
        \\Fallible :: string!s32;
        \\V4       :: Simd(f32, 4);
        \\M23      :: Matrix(f32, 2, 3);
        \\
        \\main :: () {
        \\    print("?s32        kind % variants % : %:% %:%\n",
        \\        cast(s64) type_kind(Maybe), variant_count(Maybe),
        \\        variant_name(Maybe, 0), type_name(variant_type(Maybe, 0)),
        \\        variant_name(Maybe, 1), type_name(variant_type(Maybe, 1)));
        \\    print("string!s32  kind % variants % : %:% %:%\n",
        \\        cast(s64) type_kind(Fallible), variant_count(Fallible),
        \\        variant_name(Fallible, 0), type_name(variant_type(Fallible, 0)),
        \\        variant_name(Fallible, 1), type_name(variant_type(Fallible, 1)));
        \\    print("Simd(f32,4) kind % lanes % element %\n",
        \\        cast(s64) type_kind(V4), simd_lane_count(V4),
        \\        type_name(simd_element_type(V4)));
        \\    print("Matrix      kind % rows % cols % elements % transpose %\n",
        \\        cast(s64) type_kind(M23), matrix_row_count(M23),
        \\        matrix_column_count(M23), matrix_element_count(M23),
        \\        type_name(matrix_transpose_type(M23)));
        \\    print("names: % % %\n",
        \\        type_name(Maybe), type_name(Fallible), type_name(V4));
        \\}
    );
    code_block(42, "text", #string
        \\?s32        kind 9 variants 2 : None:void Some:s32
        \\string!s32  kind 9 variants 2 : Ok:s32 Err:string
        \\Simd(f32,4) kind 16 lanes 4 element f32
        \\Matrix      kind 17 rows 2 cols 3 elements 6 transpose Matrix(f32, 3, 2)
        \\names: Option_s32 Result_s32_string Simd(f32, 4)
    );
    bullet(43, #string,oneline
        \\`?T` has `None: void` at index `0` and `Some: T` at index `1`. `E!T` has
        \\`Ok: T` at index `0` and `Err: E` at index `1`, so the variant order is
        \\the reverse of the spelling.
    );
    bullet(44, #string,oneline
        \\`type_name` of an optional or a result gives the internal name,
        \\`Option_s32` and `Result_s32_string`. Those names have no source
        \\spelling; `?T` and `E!T` are the whole surface syntax.
    );
    bullet(45, #string,oneline
        \\`type_name` of a structural type is the mangled C spelling the backend
        \\uses: `[]s32` prints as `glo_Arr_int32_t` and `#fn_ptr(a: s32) -> s32`
        \\as `glo_fn_int32_t__int32_t`. Named types, `Simd` and `Matrix` print as
        \\they are written.
    );
    bullet(46, #string,oneline
        \\Native and fixed integers retain their identities, so `variant_type` on
        \\a `box: s64` variant reports `s64`, while one declared `box: ssize`
        \\reports `ssize`. A tuple has tag `Tuple` but `field_count` of a
        \\tuple type is `0`; its components are not reachable through the field
        \\intrinsics.
    );
    subheading(47, "Generating code from a type");
    paragraph(48, #string,oneline
        \\Reflection pays off when its answers become source. The helper below
        \\emits one `print` per field and the generic procedure splices the
        \\result, so a single definition prints any struct without a `Show`
        \\instance and without a runtime type table.
    );
    code_block(49, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\#import "String_Builder";
        \\
        \\Vec3 :: struct { x: f32 = 0.0; y: f32 = 0.0; z: f32 = 0.0; }
        \\Span :: struct { lo: s64 = 0; hi: s64 = 0; }
        \\
        \\field_print_source :: (T: type, i: ssize) -> string {
        \\    if i >= field_count(T) return "";
        \\    name := field_name(T, i);
        \\    line := str_cat("    print(\"  ", str_cat(name,
        \\        str_cat(" = %\\n\", value.", str_cat(name, ");\n"))));
        \\    return str_cat(line, field_print_source(T, i + 1));
        \\}
        \\
        \\describe :: (value: $T) {
        \\    print("% {\n", type_name(T));
        \\    #insert field_print_source(T, 0);
        \\    print("}\n");
        \\}
        \\
        \\main :: () {
        \\    describe(Vec3.{ .x = 1.0, .y = 2.0, .z = 3.0 });
        \\    describe(Span.{ .lo = 4, .hi = 9 });
        \\}
    );
    code_block(50, "text", #string
        \\Vec3 {
        \\  x = 1
        \\  y = 2
        \\  z = 3
        \\}
        \\Span {
        \\  lo = 4
        \\  hi = 9
        \\}
    );
    paragraph(51, #string,oneline
        \\`describe` is instantiated once per argument type and each instantiation
        \\splices its own generated statements, which `--show-generated` reports
        \\as two materialised sources. `T` is a compile-time type parameter, so
        \\the reflection calls fold inside the generic body; `value` is an
        \\ordinary parameter and the generated text names it directly, because a
        \\statement-position `#insert` splices into the scope it stands in.
    );
    note(52, #string,oneline
        \\Generating source is the general answer to a per-field or per-variant
        \\job, and it is often the only one. There is no way to index a struct's
        \\fields at run time, so a loop over `field_count(T)` has to be unrolled
        \\into text or into `#inline while` before it means anything.
    );
}

render_section_113 :: () {
    paragraph(0, #string,oneline
        \\A `#pattern` written with no `= subject` and no `==` switch after it
        \\is a quote: it produces a value instead of performing a match. The
        \\value has the built-in type `Pattern`, and it can be stored in a
        \\constant, passed to a procedure, returned from one, and spliced back
        \\into pattern position with `#insert`. Splicing is covered in Patterns
        \\as Compile-Time Values; this chapter covers the intrinsics that ask a
        \\quote questions.
    );
    paragraph(1, #string,oneline
        \\`Pattern` is a compiler built-in name and needs no import, as `type`
        \\and `Code` do. The six intrinsics that read a quote are declared in
        \\`std/Meta/Utilities.glo` and need `#import "Meta";`. Every one of them
        \\is compile-time only: the checker folds the call to a constant while
        \\it still has the types in hand, so the call may be written in an
        \\ordinary runtime expression but nothing of it survives to run time.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Token :: union { Number: f64; Name: string; Eof: void; }
        \\
        \\NUMBER :: #pattern Token.Number(n);
        \\NAME   :: #pattern Token.Name(text);
        \\
        \\main :: () {
        \\    print("binders of NUMBER: %\n", pattern_binder_count(Token, NUMBER));
        \\    print("  % : %\n", pattern_binder_name(Token, NUMBER, 0),
        \\                       type_name(pattern_binder_type(Token, NUMBER, 0)));
        \\    print("uncovered by NUMBER and NAME: %\n",
        \\          pattern_missing_count(Token, .[NUMBER, NAME]));
        \\    print("  %\n", pattern_missing(Token, .[NUMBER, NAME], 0));
        \\}
    );
    code_block(3, "text", #string
        \\binders of NUMBER: 1
        \\  n : f64
        \\uncovered by NUMBER and NAME: 1
        \\  Token.Eof
    );
    paragraph(4, #string,oneline
        \\A quote has no runtime representation, so it must be bound with `::`
        \\rather than `:=`. `P := #pattern 1;` is `error: a 'Pattern' value is
        \\compile-time only; bind it with '::' rather than ':='`. The same rule
        \\governs `Code` and the other compiler-only meta-values, and it is why
        \\the pattern parameters of the intrinsics are declared `#comptime`.
    );
    subheading(5, "The intrinsics");
    table_header(6, "Call   —   Result");
    table_row(7, "`pattern_binder_count(T, P)`   |   How many names `P` brings into scope when it is matched against `T`.");
    table_row(8, "`pattern_binder_name(T, P, i)`   |   The name of binder `i`, in the order the pattern was written.");
    table_row(9, "`pattern_binder_type(T, P, i)`   |   The type binder `i` receives.");
    table_row(10, "`pattern_missing_count(T, Ps)`   |   How many witnesses of `T` no pattern in the view `Ps` matches.");
    table_row(11, "`pattern_missing(T, Ps, i)`   |   Witness `i`, rendered as source-shaped pattern text.");
    table_row(12, "`pattern_is_useful(T, Ps, Q)`   |   Whether adding `Q` to `Ps` would match anything `Ps` does not.");
    paragraph(13, #string,oneline
        \\The subject type comes first in all six because a pattern's meaning is
        \\a property of the pattern and the type it is matched against together,
        \\not of the pattern alone: `.Some(v)` binds an `s32` against `?s32` and
        \\a `string` against `?string`, and a member name is a union variant for
        \\one subject and an enum constant for another. `Ps` is an ordinary
        \\`[]Pattern` view, so a set of arms can be declared once as
        \\`ARMS : []Pattern : .[A, B, C];` and reused; an untyped `.[A, B]`
        \\constant has type `[2]Pattern` and does not convert on its own.
    );
    subheading(14, "A quote carries no type until it is asked about one");
    paragraph(15, #string,oneline
        \\The compiler checks a copy of the quote against the requested subject
        \\each time it is asked, and discards whatever that check instantiated.
        \\The quote itself is never stamped, so one quote serves several subject
        \\types and the binder types follow the subject rather than the quote.
    );
    code_block(16, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\SOME :: #pattern .Some(v);
        \\NONE :: #pattern .None;
        \\
        \\main :: () {
        \\    print("?s32    v: %\n", type_name(pattern_binder_type(?s32, SOME, 0)));
        \\    print("?string v: %\n", type_name(pattern_binder_type(?string, SOME, 0)));
        \\    print("?f64    v: %\n", type_name(pattern_binder_type(?f64, SOME, 0)));
        \\    print("uncovered by .Some alone: %\n", pattern_missing_count(?s32, .[SOME]));
        \\    print("  %\n", pattern_missing(?s32, .[SOME], 0));
        \\    print("uncovered by .Some and .None: %\n",
        \\          pattern_missing_count(?s32, .[SOME, NONE]));
        \\}
    );
    code_block(17, "text", #string
        \\?s32    v: s32
        \\?string v: string
        \\?f64    v: f64
        \\uncovered by .Some alone: 1
        \\  Option_s32.None
        \\uncovered by .Some and .None: 0
    );
    paragraph(18, #string,oneline
        \\`Option_s32.None` is the internal name of the compiler-baked option
        \\union; `?T` is the whole surface syntax for it, and the witness text is
        \\the one place the internal name shows through. Because checking happens
        \\at the question and not at the declaration, a quote that cannot be
        \\matched against the requested subject reports at the quote's own span:
        \\`#pattern 0..=9` asked about `f64` is `error: a range pattern needs an
        \\integer subject, got f64`, and an alternative that binds different
        \\names from its sibling is `error: or-pattern alternative does not bind
        \\'r', which another alternative does`.
    );
    subheading(19, "Binders");
    paragraph(20, #string,oneline
        \\Binders are reported in source order. `_` is not a binder, a name that
        \\appears twice is reported once, and `whole @ P` contributes the outer
        \\name followed by everything `P` binds. An or-pattern's alternatives
        \\must agree on the names they bind, so a usable or-pattern either binds
        \\the same set in every alternative or binds nothing at all.
    );
    code_block(21, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Shape :: union { Circle: f64; Rect: s32; Empty: void; }
        \\
        \\BOUND :: #pattern whole @ Shape.Circle(r);
        \\EITHER :: #pattern Shape.Circle(_) | Shape.Empty;
        \\
        \\main :: () {
        \\    print("binders of BOUND: %\n", pattern_binder_count(Shape, BOUND));
        \\    print("  % : %\n", pattern_binder_name(Shape, BOUND, 0),
        \\                       type_name(pattern_binder_type(Shape, BOUND, 0)));
        \\    print("  % : %\n", pattern_binder_name(Shape, BOUND, 1),
        \\                       type_name(pattern_binder_type(Shape, BOUND, 1)));
        \\    print("binders of EITHER: %\n", pattern_binder_count(Shape, EITHER));
        \\}
    );
    code_block(22, "text", #string
        \\binders of BOUND: 2
        \\  whole : Shape
        \\  r : f64
        \\binders of EITHER: 0
    );
    paragraph(23, #string,oneline
        \\An index past the end is `error: pattern binder index out of range`,
        \\and the witness accessor reports `error: pattern witness index out of
        \\range`. Both are compile errors, since both calls are folded.
    );
    subheading(24, "Coverage");
    paragraph(25, #string,oneline
        \\`pattern_missing_count` and `pattern_missing` run the same Maranget
        \\usefulness analysis the compiler uses to decide whether a `#pattern`
        \\switch is exhaustive, detached from any switch node. The result is a
        \\list of witnesses: values of `T` that no pattern in `Ps` matches,
        \\rendered as source-shaped pattern text. No more than 32 witnesses are
        \\collected, so a count of 32 means "at least 32".
    );
    code_block(26, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Color :: enum { Red; Green; Blue; }
        \\Point :: struct { x: s32 = 0; y: s32 = 0; }
        \\
        \\RED    :: #pattern Color.Red;
        \\GREEN  :: #pattern Color.Green;
        \\TRUE   :: #pattern true;
        \\ORIGIN :: #pattern Point.{ .x = 0, .y = 0 };
        \\LOW    :: #pattern 0..=9;
        \\HIGH   :: #pattern 10..=255;
        \\TEXT   :: #pattern "hello";
        \\
        \\main :: () {
        \\    print("Color after Red, Green: % (%)\n",
        \\          pattern_missing_count(Color, .[RED, GREEN]),
        \\          pattern_missing(Color, .[RED, GREEN], 0));
        \\    print("bool after true: % (%)\n",
        \\          pattern_missing_count(bool, .[TRUE]),
        \\          pattern_missing(bool, .[TRUE], 0));
        \\    print("Point after origin: % (%)\n",
        \\          pattern_missing_count(Point, .[ORIGIN]),
        \\          pattern_missing(Point, .[ORIGIN], 0));
        \\    print("u8 after 0..=9: % (%)\n",
        \\          pattern_missing_count(u8, .[LOW]),
        \\          pattern_missing(u8, .[LOW], 0));
        \\    print("u8 after 0..=9, 10..=255: %\n", pattern_missing_count(u8, .[LOW, HIGH]));
        \\    print("string after \"hello\": % (%)\n",
        \\          pattern_missing_count(string, .[TEXT]),
        \\          pattern_missing(string, .[TEXT], 0));
        \\}
    );
    code_block(27, "text", #string
        \\Color after Red, Green: 1 (Color.Blue)
        \\bool after true: 1 (false)
        \\Point after origin: 4 (Point.{ .x = 0, .y = -2147483648..=-1 })
        \\u8 after 0..=9: 1 (10..=255)
        \\u8 after 0..=9, 10..=255: 0
        \\string after "hello": 1 (_)
    );
    paragraph(28, #string,oneline
        \\The witnesses show how each type is taken apart. Union variants, enum
        \\constants and booleans are enumerated, so the uncovered ones are named
        \\directly. A struct has exactly one constructor, so coverage is decided
        \\field by field and the report is a cross product over the fields that
        \\were pinned down. An integer domain is not enumerated but split into
        \\closed intervals, which is why `0..=9` over `u8` leaves the single
        \\witness `10..=255` and why adding `10..=255` leaves none. Floats,
        \\strings and pointers have no enumerable structure at all, so only a
        \\wildcard covers them and the witness is the bare `_`.
    );
    note(29, #string,oneline
        \\The analysis errs in one direction only. It may report a case missing
        \\that a reader can see is covered, and it never reports zero for a set
        \\of patterns that is not total. So `pattern_missing_count(T, Ps) == 0`
        \\is a genuine proof of totality, and a non-zero answer means "not
        \\proved", not "definitely reachable". That is the same contract the
        \\compiler's own switches are held to.
    );
    paragraph(30, #string,oneline
        \\Three constructs sit outside the analysis by design, and each of them
        \\is a source of witnesses a reader would not have expected.
    );
    bullet(31, #string,oneline
        \\Where the same analysis runs over a switch, guarded, predicate and
        \\`#falling` arms are excluded from the matrix, because every one of
        \\them can decline a value after matching its shape.
    );
    bullet(32, #string,oneline
        \\A raw union carries no tag, so its values cannot be discriminated at
        \\all and nothing about it can be proved.
    );
    bullet(33, #string,oneline
        \\An or-pattern nested inside a constructor is opaque unless one
        \\alternative is a wildcard. Over `Shape`, adding
        \\`#pattern Shape.Rect(-2147483648..=2147483647)` to the other two
        \\variants leaves nothing uncovered, while the equivalent
        \\`#pattern Shape.Rect(-2147483648..=-1 | 0..=2147483647)` still reports
        \\one witness.
    );
    subheading(34, "Usefulness, subsumption, and equivalence");
    paragraph(35, #string,oneline
        \\`pattern_is_useful(T, Ps, Q)` answers the other half of the same
        \\algorithm: does `Q` match anything `Ps` does not? A `false` answer is
        \\exactly "`Q` would be a dead arm after `Ps`", which is also "`Ps`
        \\subsumes `Q`". Two patterns are equivalent when neither is useful
        \\against the other. That relation is what a reader usually means by
        \\pattern equality, and it is why `Pattern` has no `==`: whether
        \\`A | B` equals `B | A`, or whether `_` equals a binder, has no
        \\structural answer, while mutual non-usefulness has one.
    );
    code_block(36, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Shape :: union { Circle: f64; Rect: s32; Empty: void; }
        \\
        \\A :: #pattern Shape.Circle(_) | Shape.Empty;
        \\B :: #pattern Shape.Empty | Shape.Circle(_);
        \\C :: #pattern Shape.Circle(r);
        \\W :: #pattern _;
        \\
        \\equivalent :: (T: type, #comptime P: Pattern, #comptime Q: Pattern) -> bool {
        \\    return !pattern_is_useful(T, .[P], Q) && !pattern_is_useful(T, .[Q], P);
        \\}
        \\subsumes :: (T: type, #comptime P: Pattern, #comptime Q: Pattern) -> bool {
        \\    return !pattern_is_useful(T, .[P], Q);
        \\}
        \\
        \\main :: () {
        \\    print("A equivalent B = %\n", #comptime equivalent(Shape, A, B));
        \\    print("A equivalent C = %\n", #comptime equivalent(Shape, A, C));
        \\    print("A subsumes C   = %\n", #comptime subsumes(Shape, A, C));
        \\    print("C subsumes A   = %\n", #comptime subsumes(Shape, C, A));
        \\    print("W subsumes A   = %\n", #comptime subsumes(Shape, W, A));
        \\    print("A subsumes W   = %\n", #comptime subsumes(Shape, A, W));
        \\}
    );
    code_block(37, "text", #string
        \\A equivalent B = 1
        \\A equivalent C = 0
        \\A subsumes C   = 1
        \\C subsumes A   = 0
        \\W subsumes A   = 1
        \\A subsumes W   = 0
    );
    subheading(38, "Computing with the answers");
    paragraph(39, #string,oneline
        \\The index arguments are ordinary `ssize` parameters, but they must still
        \\be compile-time constants, because the whole call is folded during
        \\checking. A `while` loop that walks the witnesses with a runtime
        \\counter is `error: unknown const i`. The working shape is a recursive
        \\compile-time helper that carries the index as an argument, the same
        \\idiom type reflection uses and for the same reason; it is described in
        \\Reflection.
    );
    code_block(40, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\#import "String_Builder";
        \\
        \\Token :: union { Number: f64; Name: string; Eof: void; }
        \\
        \\NUMBER :: #pattern Token.Number(n);
        \\NAME   :: #pattern Token.Name(text);
        \\ARMS : []Pattern : .[NUMBER, NAME];
        \\
        \\witness_list :: (T: type, Ps: []Pattern, i: ssize) -> string {
        \\    if i >= pattern_missing_count(T, Ps) return "";
        \\    tail := witness_list(T, Ps, i + 1);
        \\    if tail == "" return pattern_missing(T, Ps, i);
        \\    return str_cat(pattern_missing(T, Ps, i), str_cat(", ", tail));
        \\}
        \\
        \\REPORT :: #comptime witness_list(Token, ARMS, 0);
        \\
        \\main :: () {
        \\    #if REPORT != "" { #compile_error str_cat("switch is not total; uncovered: ", REPORT); }
        \\    print("ok\n");
        \\}
    );
    code_block(41, "text", #string
        \\error: switch is not total; uncovered: Token.Eof
        \\   --> …\total.glo:21:24
        \\   |
        \\21 |     #if REPORT != "" { #compile_error str_cat("switch is not total; uncovered: ", REPORT); }
        \\   |                        ^^^^^^^^^^^^^^
    );
    paragraph(42, #string,oneline
        \\A shorter obligation is `#assert #comptime pattern_missing_count(Token,
        \\ARMS) == 0, "the arm list is not total";`, which fails as `error:
        \\assertion failed: the arm list is not total`. Once the proof holds, the
        \\same constants can drive the switch through `#insert`, so the arms that
        \\were proved total are literally the arms that run.
    );
    code_block(43, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Token :: union { Number: f64; Name: string; Eof: void; }
        \\
        \\NUMBER :: #pattern Token.Number(n);
        \\NAME   :: #pattern Token.Name(text);
        \\EOF    :: #pattern Token.Eof;
        \\ARMS : []Pattern : .[NUMBER, NAME, EOF];
        \\
        \\classify :: (t: Token) -> string {
        \\    #assert #comptime pattern_missing_count(Token, ARMS) == 0, "classify is not total";
        \\    if #pattern t == {
        \\    case #insert NUMBER; return "number";
        \\    case #insert NAME;   return "name";
        \\    case #insert EOF;    return "eof";
        \\    }
        \\}
        \\
        \\main :: () {
        \\    print("%\n", classify(Token.Number(1.5)));
        \\    print("%\n", classify(Token.Name("x")));
        \\    print("%\n", classify(Token.Eof));
        \\}
    );
    code_block(44, "text", #string
        \\number
        \\name
        \\eof
    );
}

render_section_114 :: () {
    paragraph(0, #string,oneline
        \\A build script is an ordinary Glosso file whose work happens in a
        \\top-level `#comptime`. `#import "Compiler";` brings in the build API,
        \\the `#comptime` declaration runs it once during compilation, and
        \\`main :: () {}` is still present because the file is a program like any
        \\other. Nothing in the API is available at run time; every operation is
        \\a compiler service reached from compile-time execution.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\run_build :: () {
        \\    set_build_options_dc(.do_output = false);
        \\
        \\    workspace := compiler_create_workspace("hello");
        \\    options := get_build_options(workspace);
        \\    options.output_type = .Executable;
        \\    options.output_executable_name = "hello.exe";
        \\    set_build_optimization(*options, .Optimized);
        \\    set_build_options(options, workspace);
        \\
        \\    if add_build_file("hello.glo", workspace) == {
        \\    case .Ok(log);
        \\        print("[build] nested compilation said:\n%", log);
        \\    case .Err(failure);
        \\        print("[build] failed with status %\n", failure.status);
        \\        report_error(failure);
        \\        exit(failure.status);
        \\    }
        \\}
        \\
        \\#comptime run_build();
        \\main :: () {}
    );
    code_block(2, "text", #string
        \\$ glosso build.glo
        \\glosso: compile build.glo (target=x86_64-pc-windows-msvc)
        \\[build] nested compilation said:
        \\glosso: compile hello.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link hello.exe (target=x86_64-pc-windows-msvc, -O2)
        \\glosso: done hello.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O2)
        \\$ ./hello.exe
        \\hello from the nested build
    );
    paragraph(3, #string,oneline
        \\`set_build_options_dc(.do_output = false)` suppresses the emit step of
        \\the compilation that is running the script, so no `build.exe` appears.
        \\Without it the driver would also link the build script itself, which
        \\is almost never wanted: the script's `main` is empty and its whole
        \\purpose has already been served. The name means "during compile", and
        \\it is the only setter that changes the current compilation rather than
        \\a nested one.
    );
    paragraph(4, #string,oneline
        \\A nested compilation is a new `glosso` process, taken from
        \\`GLOSSO_COMPILER_EXE` if that is set and from the running executable
        \\otherwise. `add_build_file` and `add_build_string` wait for that child
        \\and return its standard output followed by its standard error instead of
        \\passing either stream through. That is why the child's transcript appears
        \\under `[build]` above and why discarding the `.Ok` payload discards the
        \\child's log. A failed child returns `Compiler_Error`; that type implements
        \\`Error`, so `report_error(failure)` prints `compiler error: ` followed by
        \\the captured diagnostics.
    );
    subheading(5, "`Workspace` and `Build_Options`");
    paragraph(6, #string,oneline
        \\A `Workspace` is an `s64` handle to one reusable `Build_Options`
        \\configuration. Create one with `compiler_create_workspace`, obtain a
        \\detached copy of its options with `get_build_options`, edit that copy,
        \\and install it with `set_build_options`. Nothing is queued:
        \\`add_build_file(path, workspace)` and `add_build_string(source,
        \\workspace)` each start and await one child compilation immediately.
        \\Omitting the workspace argument uses the shared implicit handle `-1`.
    );
    table_header(7, "Field   —   Default   —   Child argument");
    table_row(8, "`output_type`   |   `.Executable`   |   Selects the backend when `backend` is `.Default`; `.No_Output` omits `-o` but does not suppress the child's artifact.");
    table_row(9, "`backend`   |   `.Default`   |   `--backend` with the matching name, or derive it from `output_type`.");
    table_row(10, "`output_executable_name`   |   empty   |   The name passed through `-o`; empty falls back to the source stem.");
    table_row(11, "`output_path`   |   empty   |   Directory joined to the output name; empty uses the working directory.");
    table_row(12, "`target`   |   zeroed   |   An all-zero target inherits the caller; raw `compiler_args` may override it, while a nonzero field is appended last and wins.");
    table_row(13, "`optimization_level`   |   `.Default`   |   One optimization flag; see the table below.");
    table_row(14, "`compiler_args`   |   empty   |   Raw child arguments before the flags derived from this record.");
    table_row(15, "`import_path`   |   empty   |   One `--module-path` per entry, after the standard library in search order.");
    table_row(16, "`linker_args`   |   empty   |   One `--linker-arg` per entry.");
    table_row(17, "`compile_time_command_line`   |   empty   |   Entries after `--`, preserving spaces and empty strings as individual arguments.");
    table_row(18, "`memory_sanitizer`, `thread_sanitizer`   |   `false`   |   `--memory-sanitizer` and `--thread-sanitizer`.");
    table_row(19, "`borrow_check`   |   `.Warning`   |   `--borrow-check` with `off`, `warning`, or `error`.");
    table_row(69, "`color`   |   `.Auto`   |   `--color always` or `--color never`, resolved against the parent's stderr.");
    table_row(70, "`temp_allocator_size`   |   4 MiB   |   `--temp-allocator-size <bytes>` when positive.");
    table_row(71, "`no_main`   |   `false`   |   `--no-main`.");
    table_row(72, "`intermediate_path`, `do_output`, `write_added_strings`, `text_output_flags`   |   reserved defaults   |   Currently ignored by workspace builds.");
    paragraph(20, #string,oneline
        \\`.Auto` never reaches the child as `auto`. The child's standard error
        \\is a capture pipe and can never be a terminal, so the parent resolves
        \\`auto` against its own stderr and passes the answer. A script that
        \\wants plain text in the captured log sets `.Never` explicitly.
    );
    paragraph(21, #string,oneline
        \\The fields are written through mutators that take a pointer to the
        \\record: `set_build_backend`, `set_build_target`,
        \\`set_build_optimization`, `set_build_memory_sanitizer`,
        \\`set_build_thread_sanitizer`, `set_build_borrow_check`,
        \\`set_build_color`, `set_build_temp_allocator_size`,
        \\`set_build_no_main`, `add_build_compiler_arg`,
        \\`add_build_linker_arg`, `add_build_linker_args` and
        \\`add_build_module_path`. They mutate only the detached local record;
        \\call `set_build_options` afterwards. Direct field assignment and
        \\`array_add` on its dynamic-array fields are equivalent.
    );
    paragraph(22, #string,oneline
        \\`Compiler_Backend` has seven members. `LLVM`, `Object`, `LLVM_IR`,
        \\`Static_Lib` and `Shared_Lib` map to `--backend llvm`, `object`,
        \\`llvm-ir`, `static-lib` and `shared-lib`. `Default` passes no
        \\`--backend` and lets the output type decide. `X64` maps to nothing at
        \\all and behaves exactly like `Default`; it is a dead value.
    );
    note(73, #string,oneline
        \\`Build_Output_Type` supplies the default backend independently of the
        \\file name: `.Executable`, `.Object_File`, `.LLVM_IR`, `.Static_Library`
        \\and `.Shared_Library` select the corresponding artifact. `.No_Output`
        \\means "do not pass `-o`"; the child still emits to its own source-derived
        \\default path. To suppress the build script's own artifact, use
        \\`set_build_options_dc(.do_output = false)` instead.
    );
    subheading(23, "Optimization levels");
    paragraph(24, #string,oneline
        \\`Optimization` is an explicitly numbered enum because its values are
        \\part of the compile-time service ABI. `Default` is not a synonym for
        \\`Very_Debug`: it passes no optimization flag at all, and the child then
        \\applies its own default, which is `-O1`.
    );
    table_header(25, "Member   —   Value   —   Child flag and current result");
    table_row(26, "`Debug`   |   0   |   `-O0`; runtime checks stay enabled");
    table_row(27, "`Very_Debug`   |   1   |   `-O1`; runtime checks stay enabled");
    table_row(28, "`Optimized`   |   2   |   `-O2`");
    table_row(29, "`Very_Optimized`   |   3   |   `-O3`");
    table_row(30, "`Optimized_Small`   |   4   |   `-Os`; currently rejected by LLVM 23's `default<Os>` pipeline");
    table_row(31, "`Optimized_Very_Small`   |   5   |   `-Oz`; currently rejected by LLVM 23's `default<Oz>` pipeline");
    table_row(32, "`Optimized_Tiny`   |   6   |   `-Ozz`; reaches the same rejected `default<Oz>` pipeline before stripping");
    table_row(33, "`Default`   |   7   |   none; child defaults to working `-O1`");
    note(68, #string,oneline
        \\Glosso maps the three size modes to LLVM `optsize` or `minsize`
        \\attributes and selects `default<Os>` or `default<Oz>`, but LLVM 23 still
        \\aborts on those pipeline-level optimization names. Use `Optimized` or
        \\`Very_Optimized` for a linked workspace build. C archive compilation is
        \\narrower by design: `compile_c_archive` accepts only `Debug` through
        \\`Very_Optimized`; the size modes and `.Default` return a
        \\`Compiler_Error` before invoking the C compiler.
    );
    subheading(34, "Named and implicit workspaces");
    paragraph(35, #string,oneline
        \\`compiler_create_workspace(name)` returns fresh handles numbered from
        \\zero for the life of the compiler process. The name is retained but is
        \\otherwise informational; it need not be unique, and there is no destroy
        \\operation. Each new handle starts with independent default options.
        \\Handle `-1` is reserved for the process-wide implicit workspace used by
        \\every call that omits its workspace argument. Reading any other unknown
        \\handle materializes it with defaults rather than reporting an error.
    );
    code_block(36, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\drive :: () {
        \\    set_build_options_dc(.do_output = false);
        \\
        \\    defaults := get_build_options();
        \\    print("output_type=% backend=% optimization=% do_output=%\n",
        \\          defaults.output_type, defaults.backend,
        \\          defaults.optimization_level, defaults.do_output);
        \\
        \\    space := compiler_create_workspace("tool");
        \\    options := get_build_options(space);
        \\    options.output_executable_name = "tool.exe";
        \\    set_build_optimization(*options, .Optimized);
        \\    set_build_options(options, space);
        \\
        \\    if add_build_file("hello.glo", space) == {
        \\    case .Ok(log);      print("[ws] built:\n%", log);
        \\    case .Err(failure); print("[ws] failed: %\n", failure.message);
        \\    }
        \\}
        \\
        \\#comptime drive();
        \\main :: () {}
    );
    code_block(37, "text", #string
        \\output_type=1 backend=0 optimization=7 do_output=1
        \\[ws] built:
        \\glosso: compile hello.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link tool.exe (target=x86_64-pc-windows-msvc, -O2)
        \\glosso: done tool.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O2)
    );
    paragraph(38, #string,oneline
        \\Enum values print as their numbers, so the defaults read as
        \\`output_type = Executable`, `backend = Default` and
        \\`optimization_level = Default`. The output name comes from
        \\`output_executable_name`, joined onto `output_path` when that is set,
        \\and falls back to the source's file stem. The whole name is passed
        \\through as `-o`, so a fallback name carries no platform extension: a
        \\workspace with only `output_path = "outdir"` set produces
        \\`glosso: done outdir\hello`. `add_build_string(source, w)`
        \\is the same operation over text: the source is written to a temporary
        \\file named `glosso_build_string_<pid>_<n>.glo` and that file is
        \\compiled and left in place, which is why its diagnostics name a path in
        \\the system temporary directory. Give it an explicit output name when the
        \\temporary source stem would not be a useful artifact name.
    );
    note(39, #string,oneline
        \\`compile_time_command_line` is active: a nonempty list is appended after
        \\`--`, and the child reads exactly those entries through
        \\`get_cmdline_args()`. Four other fields are currently reserved:
        \\`intermediate_path`, `do_output`, `write_added_strings`, and
        \\`text_output_flags`. In particular, changing `Build_Options.do_output`
        \\does not suppress either compilation, and `write_added_strings = false`
        \\does not stop `add_build_string` from writing its temporary source.
    );
    subheading(40, "Building C sources");
    paragraph(41, #string,oneline
        \\`compile_c_archive(name, sources)` compiles a list of C files
        \\with the compiler's bundled native toolchain and returns
        \\`Native_Compile_Output`, whose `artifact` field is the path of the
        \\static library it produced and whose `output` field is the tool's log.
        \\The archive is written into the native cache, keyed by the archive
        \\name, the active target and the parameters, so an unchanged archive is
        \\built once. Pass `include_paths`, `preprocessor_definitions`, and
        \\`compiler_args` as named `[]string` parameters, which default to `.[]`.
        \\Their slices and strings are borrowed for the call. `sources` remains a
        \\dynamic `[..]string` array. `position_independent` defaults to `false`,
        \\and `optimization_level` defaults to `.Optimized`; only `.Debug`,
        \\`.Very_Debug`, `.Optimized`, and `.Very_Optimized` are accepted.
        \\The input option record and its specialized mutators are no longer
        \\public APIs.
    );
    code_block(42, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\#import "String_Builder";
        \\
        \\adder_bindings :: () -> string {
        \\    sources: [..]string;
        \\    defer array_free(*sources);
        \\    array_add(*sources, "adder.c");
        \\
        \\    arguments: [1]string = .["-fno-builtin"];
        \\
        \\    if compile_c_archive("adder", sources,
        \\        .compiler_args = arguments[..]) == {
        \\    case .Ok(archive);
        \\        print("[c] archive at %\n", archive.artifact);
        \\        return str_cat(
        \\            str_cat("adder :: #library,static \"", archive.artifact),
        \\            "\";\nc_add :: (a: s32, b: s32) -> s32 #foreign adder \"c_add\";");
        \\    case .Err(failure);
        \\        return "#comptime { #compile_error \"the adder archive did not build\"; }";
        \\    }
        \\}
        \\
        \\#insert #comptime adder_bindings();
        \\
        \\main :: () { print("c_add(3, 4) = %\n", c_add(3, 4)); }
    );
    code_block(43, "text", #string
        \\glosso: compile archive.glo (target=x86_64-pc-windows-msvc)
        \\[c] archive at C:\Users\…\glosso\cache\native\v7\adder\x86_64-windows-msvc\…\adder.lib
        \\glosso: link archive.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done archive.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\c_add(3, 4) = 7
    );
    paragraph(44, #string,oneline
        \\The `#library` declaration and the `#foreign` declaration have to be
        \\inserted together. A top-level string `#insert` that declares only the
        \\library, with the `#foreign` procedure written in the file, is
        \\`error: #foreign refers to unknown library 'adder' (declare it with
        \\#library)`. Handing `archive.artifact` to Bindgen's `library_spec`
        \\and inserting the generated source does the same job for a real header;
        \\that route is covered in Generating Bindings with Bindgen.
    );
    subheading(45, "Other compiler services");
    paragraph(46, #string,oneline
        \\`executable_path()` returns the absolute path of the compiler running
        \\the script; its contract is `returns_fresh, released_by(string_free)`,
        \\so a script that keeps the result and does not free it draws
        \\`warning: [memory.leak] resource must be released by 'string_free'
        \\before leaving scope`. `find_header(name, root)`, `find_library(name)` and
        \\`find_resource(name)` search the target directories, the usual
        \\environment variables and the project root, and return an empty string
        \\when nothing matches; `find_resource("std")` resolves the standard
        \\library directory. `run_command(text)` runs a shell command and returns
        \\its captured output as `Compiler_Error!string`.
        \\`add_current_linker_arg(arg)` appends a raw flag to the link of the
        \\current compilation, which a bad flag proves loudly: `error: lld-link:
        \\error: could not open '/no-such-linker-flag': no such file or
        \\directory`.
    );
    note(74, #string,oneline
        \\`macro_unit(path, argument)` is the native-code route for a reusable
        \\source generator. It builds `path` as a program through a nested compiler,
        \\benefits from the native artifact cache, runs the result with `argument`
        \\after `--`, and returns the program's standard output as source text.
        \\Write `#insert macro_unit("macros/derive_json.glo", "record");` at the
        \\use site. A build or run failure is returned as diagnostic text so the
        \\following insertion fails with the generator's error visible.
    );
    subheading(47, "The build-driver idiom");
    paragraph(48, #string,oneline
        \\The shape every real build script converges on is a single top-level
        \\`#comptime` that turns off its own output, reads a task name from the
        \\compile-time command line, and dispatches. This manual is built that
        \\way: `glosso first.glo -- build` compiles the manual's `main.glo` for
        \\`wasm32-freestanding`, and other task names regenerate its reference
        \\data and its syntax highlighting.
    );
    code_block(49, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\build_release :: () {
        \\    workspace := compiler_create_workspace("release");
        \\    options := get_build_options(workspace);
        \\    options.output_executable_name = "hello.exe";
        \\    set_build_optimization(*options, .Optimized);
        \\    set_build_borrow_check(*options, Compiler_Borrow_Check.Error);
        \\    set_build_color(*options, .Always);
        \\    set_build_options(options, workspace);
        \\    if #pattern .Err(failure) = add_build_file("hello.glo", workspace) {
        \\        print("release build failed:\n");
        \\        report_error(failure);
        \\        exit(failure.status);
        \\    }
        \\    print("built hello.exe\n");
        \\}
        \\
        \\usage :: () {
        \\    print("usage: glosso first.glo -- <command>\n");
        \\    print("commands:\n");
        \\    print("  release   build hello.glo optimized\n");
        \\}
        \\
        \\run_task :: () {
        \\    set_build_options_dc(.do_output = false);
        \\    args := get_cmdline_args();
        \\    if args.count == 0 { usage(); exit(1); }
        \\    if args[0] == {
        \\    case "release"; build_release(); return;
        \\    else;
        \\        print("unknown task: %\n", args[0]);
        \\        usage();
        \\        exit(1);
        \\    }
        \\}
        \\
        \\#comptime run_task();
        \\main :: () {}
    );
    code_block(50, "text", #string
        \\$ glosso first.glo
        \\glosso: compile first.glo (target=x86_64-pc-windows-msvc)
        \\usage: glosso first.glo -- <command>
        \\commands:
        \\  release   build hello.glo optimized
        \\$ echo $?
        \\1
        \\$ glosso first.glo -- release
        \\glosso: compile first.glo (target=x86_64-pc-windows-msvc)
        \\built hello.exe
        \\$ glosso first.glo -- deploy
        \\glosso: compile first.glo (target=x86_64-pc-windows-msvc)
        \\unknown task: deploy
        \\usage: glosso first.glo -- <command>
        \\commands:
        \\  release   build hello.glo optimized
    );
    paragraph(51, #string,oneline
        \\`exit(status)` from compile-time execution stops the build with that
        \\status and writes no binary, which is what makes a build script usable
        \\from a shell script or a continuous-integration job. Because the driver
        \\emits nothing, the run above produces `hello.exe` and no `first.exe`.
        \\Cross-compiling a nested build is a matter of one more setter:
        \\`set_build_target(*options, .{ .os = Target_OS.Wasm, .cpu =
        \\Target_CPU.Wasm32, .abi = Target_ABI.Freestanding })` makes the child report
        \\`target=wasm32-unknown-unknown`. That changes only children using this
        \\workspace. `compile_c_archive` still uses the build script's active target;
        \\compile the script itself for the matching target when its C archive must
        \\be link-compatible with the nested Glosso artifact.
    );
}

render_section_115 :: () {
    paragraph(0, #string,oneline
        \\`glosso [options] <file.glo> -- <args...>` hands everything after the
        \\`--` separator to compile-time execution rather than to the driver. The
        \\separator itself, and the fact that `get_cmdline_args()` returns the
        \\process argument vector in the built program, are covered in Using the
        \\Compiler. What matters here is the compile-time half: the arguments are
        \\how a build script written in Glosso is parameterized, and they are
        \\part of the identity of the artifact the build produces.
    );
    paragraph(1, #string,oneline
        \\`get_cmdline_args :: () -> []const string #magic "get_cmdline_args"
        \\#memory{returns_static};` is the whole surface. During top-level
        \\`#comptime` it returns exactly the words after `--`, with no program
        \\name in front and none of the compiler's own options, so index `0` is
        \\the first argument the caller wrote. An empty vector means the
        \\separator was absent or carried nothing.
    );
    code_block(2, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\read_options :: () {
        \\    set_build_options_dc(.do_output = false);
        \\    args := get_cmdline_args();
        \\    output := "app.exe";
        \\    level := Optimization.Default;
        \\    i := 0;
        \\    while i < args.count {
        \\        if args[i] == {
        \\        case "--release"; level = .Optimized;
        \\        case "--out";
        \\            if i + 1 >= args.count {
        \\                print("--out needs a path\n");
        \\                exit(2);
        \\            }
        \\            output = args[i + 1];
        \\            i += 1;
        \\        else;
        \\            print("unknown option: %\n", args[i]);
        \\            exit(2);
        \\        }
        \\        i += 1;
        \\    }
        \\    print("[ct] output = %  optimization = %\n", output, level);
        \\}
        \\
        \\#comptime read_options();
        \\main :: () {}
    );
    code_block(3, "text", #string
        \\$ glosso opts.glo -- --release --out dist/tool.exe
        \\glosso: compile opts.glo (target=x86_64-pc-windows-msvc)
        \\[ct] output = dist/tool.exe  optimization = 2
        \\$ glosso opts.glo -- --fast
        \\glosso: compile opts.glo (target=x86_64-pc-windows-msvc)
        \\unknown option: --fast
        \\$ echo $?
        \\2
    );
    paragraph(4, #string,oneline
        \\A rejected option can end the build immediately because `exit` from
        \\compile-time execution aborts the compilation with the requested
        \\status and writes no output file. Compile-time `print` output is
        \\buffered and flushed to standard output in one block after every
        \\top-level `#comptime` has run, while the compiler's own progress lines
        \\go to standard error, so the interleaving of the two in a terminal is
        \\not something to depend on.
    );
    subheading(5, "Forwarding arguments to a workspace build");
    paragraph(6, #string,oneline
        \\A child started by `add_build_file` or `add_build_string` does not inherit
        \\the build script's own `--` arguments automatically. Put the arguments
        \\for that child in `Build_Options.compile_time_command_line`, then install
        \\the options before starting the build. The service writes one `--`
        \\separator followed by the list; each element remains one argument, even
        \\when it contains spaces or is empty.
    );
    code_block(7, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\drive :: () {
        \\    set_build_options_dc(.do_output = false);
        \\    print("[parent] % argument(s)\n", get_cmdline_args().count);
        \\
        \\    workspace := compiler_create_workspace("child");
        \\    options := get_build_options(workspace);
        \\    options.output_executable_name = "child.exe";
        \\    array_add(*options.compile_time_command_line, "release");
        \\    defer array_free(*options.compile_time_command_line);
        \\    set_build_options(options, workspace);
        \\
        \\    if add_build_file("child.glo", workspace) == {
        \\    case .Ok(log);      print("%", log);
        \\    case .Err(failure); report_error(failure);
        \\    }
        \\}
        \\
        \\#comptime drive();
        \\main :: () {}
    );
    code_block(8, "text", #string
        \\$ glosso parent.glo -- top
        \\glosso: compile parent.glo (target=x86_64-pc-windows-msvc)
        \\[parent] 1 argument(s)
        \\[child] 1 argument(s)
        \\[child]   release
        \\glosso: compile child.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link child.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done child.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
    );
    subheading(9, "The native artifact cache");
    paragraph(10, #string,oneline
        \\When a compilation would produce a native artifact and nothing about it
        \\has changed, the driver copies the previous result out of a per-user
        \\cache instead of running the pipeline. The restore is announced, and it
        \\replaces every phase after argument parsing, so no `compile` or `link`
        \\line appears at all.
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\main :: () { print("%\n", 6 * 7); }
    );
    code_block(12, "text", #string
        \\$ glosso --run sum.glo
        \\glosso: compile sum.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link sum.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done sum.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\42
        \\$ glosso --run sum.glo
        \\glosso: restored sum.exe from the native artifact cache
        \\42
        \\$ glosso --run sum.glo -- release
        \\glosso: compile sum.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link sum.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done sum.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\42
        \\$ glosso -O2 --run sum.glo
        \\glosso: compile sum.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link sum.exe (target=x86_64-pc-windows-msvc, -O2)
        \\glosso: done sum.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O2)
        \\42
    );
    subheading(13, "The key");
    paragraph(14, #string,oneline
        \\The key is a hash of an identity string assembled from everything that
        \\could change the bytes of the artifact. Adding `-- release` to an
        \\otherwise identical command line produced a third cache entry above,
        \\because a build script can read those words and emit something
        \\different for them.
    );
    table_header(15, "Group   —   What goes into the identity");
    table_row(16, "Sources   |   The canonicalized path of the input file and the resolved standard-library directory.");
    table_row(17, "Target   |   The LLVM triple, and separately every key and value of `--target`, because the triple collapses distinct maps such as `uefi` and `msvc`.");
    table_row(18, "Code generation   |   Backend name, optimization level, size mode, and sanitizer selection.");
    table_row(19, "Checking   |   The `--borrow-check` mode and whether the standard library is in use.");
    table_row(20, "Runtime   |   The temporary allocator size and `--no-main`.");
    table_row(21, "Linking   |   Every `--linker-arg`, in order.");
    table_row(22, "Compile time   |   Every argument after `--`, in order.");
    table_row(23, "Modules   |   Every `--module-path` directory, in order.");
    paragraph(24, #string,oneline
        \\The output path is deliberately absent. Building the same source with
        \\`-o other.exe` restores the cached artifact and copies it to the new
        \\name: `glosso: restored other.exe from the native artifact cache`. The
        \\key is 32 hexadecimal characters, and the two files that make up an
        \\entry are `<key>.artifact` and `<key>.manifest` under
        \\`<cache>/native/artifacts/v1`. Both are written to temporary names and
        \\renamed into place, so a concurrent build never observes half an entry.
    );
    subheading(25, "The manifest");
    paragraph(26, #string,oneline
        \\The key decides which entry to look at; the manifest decides whether it
        \\is still valid. It is a small binary file beginning with the magic
        \\`GLOART01`, followed by a count and then one record per dependency:
        \\the path, the file's length, and its modification time in seconds and
        \\nanoseconds. The artifact is restored only if every stamp still
        \\matches. The dependency list is the source file, every file reached
        \\through `#load` and `#import`, the compiler executable itself, and any
        \\`--linker-arg` that names an existing file.
    );
    code_block(27, "glosso", #string
        \\// uses.glo
        \\#import "Io";
        \\#load "helper.glo";
        \\main :: () { print("%\n", greeting()); }
        \\
        \\// helper.glo
        \\greeting :: () -> string { return "one"; }
    );
    code_block(28, "text", #string
        \\$ glosso --run uses.glo
        \\glosso: compile uses.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link uses.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done uses.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\one
        \\$ glosso --run uses.glo
        \\glosso: restored uses.exe from the native artifact cache
        \\one
        \\$ # helper.glo edited to return "two"
        \\$ glosso --run uses.glo
        \\glosso: compile uses.glo (target=x86_64-pc-windows-msvc)
        \\glosso: link uses.exe (target=x86_64-pc-windows-msvc, -O1)
        \\glosso: done uses.exe  (backend=llvm, target=x86_64-pc-windows-msvc, -O1)
        \\two
    );
    note(29, #string,oneline
        \\Validation is by length and modification time, not by content hash.
        \\Restoring a checkout, copying a tree, or any operation that rewrites a
        \\file's timestamp without changing its bytes therefore forces a rebuild
        \\rather than a stale restore, which is the safe direction. A tool that
        \\preserves timestamps while changing content is the unsafe direction and
        \\has no defence here.
    );
    subheading(30, "When caching is skipped");
    paragraph(31, #string,oneline
        \\A cache miss costs a compile; a wrong cache hit costs correctness. The
        \\driver therefore declines the cache entirely in every case where it
        \\cannot account for what the build did.
    );
    bullet(32, #string,oneline
        \\Only the executable, object and static-library backends are cached.
        \\`--backend llvm-ir` and `--backend shared-lib` recompile every time.
    );
    bullet(33, #string,oneline
        \\A program with any top-level `#comptime` is never stored, because that
        \\code can read files, run commands and write outputs that the manifest
        \\does not describe. This is why a build script recompiles on every
        \\invocation, and why a build script must not be made expensive to check.
    );
    bullet(34, #string,oneline
        \\`--show-generated` disables the cache for that run, so the generated
        \\`#insert` sources it reports are actually produced rather than skipped.
    );
    bullet(35, #string,oneline
        \\Setting the environment variable `GLOSSO_DISABLE_ARTIFACT_CACHE` to
        \\anything turns the cache off for the process.
    );
    bullet(36, #string,oneline
        \\A build that emitted nothing is not stored: a compile-time `exit`, or
        \\`set_build_options_dc(.do_output = false)`, both end the run before the
        \\store step.
    );
    paragraph(37, #string,oneline
        \\A failure to write an entry is a warning and not an error: `glosso:
        \\warning: could not update artifact cache: <reason>`, after which the
        \\build finishes normally. Entries are never removed by the compiler;
        \\the cache directory grows until it is deleted by hand.
    );
    subheading(38, "`--cache-dir` and `--print-cache-dir`");
    paragraph(39, #string,oneline
        \\`--print-cache-dir` prints the resolved cache root and exits without
        \\reading any source. `--cache-dir <dir>` overrides that root for the
        \\run, and the path must be absolute: a relative one is
        \\`glosso: --cache-dir: cache directory override must be an absolute
        \\path` with exit code 2. The override moves the whole root, so the
        \\generated-source cache described in The Build Cache and Generated
        \\Sources moves with it; that is what makes a build reproducible inside a
        \\project directory.
    );
    code_block(40, "text", #string
        \\$ glosso --print-cache-dir
        \\C:\Users\almag\AppData\Local\glosso\cache
        \\$ glosso --cache-dir C:\work\manual\build\cache --print-cache-dir
        \\C:\work\manual\build\cache
        \\$ glosso --cache-dir relative/dir --print-cache-dir
        \\glosso: --cache-dir: cache directory override must be an absolute path
    );
    paragraph(41, #string,oneline
        \\With no override the root is chosen from the host convention, and the
        \\environment variable `GLOSSO_CACHE_DIR` overrides that choice without a
        \\flag. It too must hold an absolute path.
    );
    table_header(42, "Host   —   Default cache root");
    table_row(43, "Windows   |   `%LOCALAPPDATA%\\glosso\\cache`");
    table_row(44, "macOS   |   `~/Library/Caches/glosso`");
    table_row(45, "Other Unix   |   `$XDG_CACHE_HOME/glosso`, or `~/.cache/glosso` when that is unset");
}
