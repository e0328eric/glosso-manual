// Sections 72-87: compile time, interop, diagnostics, and style.

render_section_72 :: () {
    paragraph(0, #string,oneline
        \\`#comptime` executes Glosso code in the compiler's own bytecode VM
        \\while the program is being checked, and freezes the result into the
        \\program as a constant.
    );
    code_block(1, "glosso", #string
        \\Table_Size :: #comptime {
        \\    base := 16;
        \\    return base * base;
        \\};
    );
    paragraph(2, #string,oneline
        \\The evaluation happens during checking, before any IR is lowered and
        \\before the backend runs. The declaration above therefore reaches code
        \\generation as the literal `256`; nothing about `base` survives into the
        \\executable.
    );
    subheading(3, "Forms");
    table_header(4, "Form   —   Result/effect");
    table_row(5, #string,oneline
        \\`value := #comptime expression;`   |   Evaluates the expression during
        \\checking and embeds the resulting constant
    );
    table_row(6, #string,oneline
        \\`Value :: #comptime { ... return expression; };`   |   Runs a
        \\compile-time block; the returned value becomes the constant, typed by
        \\inference from the returned expression
    );
    table_row(7, #string,oneline
        \\`Value :: #comptime -> T { ... return expression; };`   |   Same, but
        \\the result is typed exactly `T` instead of the inferred default
    );
    table_row(8, #string,oneline
        \\`#comptime { statements }` at top level   |   Runs the block for its
        \\compile-time side effects only; no runtime function body is emitted
    );
    table_row(9, #string,oneline
        \\`#comptime T: type` parameter   |   Requires a compile-time argument,
        \\participates in specialization identity, and is erased from the runtime
        \\parameter list
    );
    table_row(10, #string,oneline
        \\`$T`   |   Shorthand for an inferred compile-time type parameter
        \\introduced by the argument it annotates
    );
    paragraph(11, #string,oneline
        \\The annotated block form matters whenever the default numeric type is
        \\wrong. `#comptime { return 200; }` produces an eight-byte `int`;
        \\`#comptime -> u8 { return 200; }` produces a one-byte `u8`. The
        \\annotation accepts aggregates too, so a lookup table can be built by a
        \\loop and stored as a fixed array. This program exercises every row of
        \\the table:
    );
    code_block(12, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\#comptime {
        \\    print("generating\n");
        \\}
        \\
        \\Table_Size :: #comptime {
        \\    base := 16;
        \\    return base * base;
        \\};
        \\
        \\Byte_Limit :: #comptime -> u8 { return 200; };
        \\
        \\zero_of :: (#comptime T: type) -> T { return cast(T) 0; }
        \\name_of :: (value: $T) -> string { return type_name(T); }
        \\
        \\main :: () {
        \\    inline_size := #comptime 16 * 16;
        \\    print("% % % % %\n",
        \\        Table_Size, size_of(type_of(Byte_Limit)), inline_size,
        \\        zero_of(f32), name_of(3.5));
        \\}
    );
    code_block(13, "text", #string
        \\generating
        \\256 1 256 0 f64
    );
    paragraph(14, #string,oneline
        \\`generating` is printed by the compiler, not by the program: the
        \\top-level block runs once during checking, whichever backend is
        \\selected, and even when the chosen backend writes an object file
        \\instead of an executable.
    );
    subheading(15, "What the compile-time VM can reach");
    paragraph(16, #string,oneline
        \\The checker resolves a `#comptime` operand against the constant
        \\environment. Ordinary Glosso bodies and compiler `#magic` services run;
        \\runtime locals, procedure parameters, and anything that only exists
        \\after process start do not. The failure is the generic constant-lookup
        \\diagnostic, reported at the offending sub-expression rather than at the
        \\directive.
    );
    code_block(17, "glosso", #string
        \\read_now :: (n: s64) -> s64 { return n * 2; }
        \\
        \\main :: () {
        \\    n: s64 = 4;
        \\    v :: #comptime read_now(n);
        \\}
    );
    code_block(18, "text", #string
        \\error: unknown const n
        \\  --> comptime.glo:5:29
        \\  |
        \\5 |     v :: #comptime read_now(n);
        \\  |                             ^
    );
    paragraph(19, #string,oneline
        \\The same rule decides whether other compile-time constructs take their
        \\compile-time or their runtime path. A `::` binding whose initializer is
        \\evaluable is folded and can then be used by `#if` and `#assert`; the
        \\`:=` spelling of the same initializer is not. See _Assertions with
        \\`#assert`_ for how that single character changes a build error into a
        \\runtime abort.
    );
    subheading(20, "Numeric parity with the native backend");
    paragraph(21, #string,oneline
        \\The VM carries full 128-bit values, and its division and remainder
        \\agree with the native backend. Overflow is the one place where the two
        \\disagree: the VM wraps silently, while the native backend traps at
        \\`-O0` and `-O1`. A constant folded through `#comptime` therefore never
        \\reports the overflow that the same arithmetic would abort on at
        \\runtime. This program prints the wrapped constant, then aborts on the
        \\runtime addition — and at `-O2`, where the optimizer folds the check
        \\away, it prints the same value twice and exits 0.
    );
    code_block(22, "glosso", #string
        \\#import "Io";
        \\
        \\Wrapped :: #comptime {
        \\    hi: s64 = 9223372036854775807;
        \\    return hi + 1;
        \\};
        \\
        \\main :: () {
        \\    print("%\n", Wrapped);       // -9223372036854775808, no diagnostic
        \\
        \\    hi: s64 = 9223372036854775807;
        \\    bump: s64 = 1;
        \\    print("%\n", hi + bump);     // aborts with status 134 at -O0
        \\}
    );
    paragraph(23, #string,oneline
        \\Write the wide arithmetic in a width that cannot overflow, or check the
        \\bound explicitly, when a compile-time table is derived from values near
        \\a type's limit. _128-Bit Integers_ covers the literal and width rules
        \\the VM shares with the backend.
    );
    note(24, #string,oneline
        \\A compile-time result is cached only through the mechanisms documented
        \\by the operation being used (for example string `#insert` or native
        \\archive caches). `#comptime` itself does not promise that arbitrary
        \\filesystem/process side effects will be replayed or invalidated as a
        \\build-system dependency.
    );
}

render_section_73 :: () {
    paragraph(0, #string,oneline
        \\`#code { ... }` captures parsed syntax as a `Code` value. The fragment
        \\is parsed where it is written and is not executed there; it can be
        \\returned from a compile-time function, stored, and inserted later with
        \\`#insert`.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Vec2 :: struct { x: s64; y: s64; }
        \\
        \\read_field :: (#comptime T: type, #comptime i: s64) -> Code {
        \\    name :: field_name(T, i);
        \\    return #code { print("%\n", ``name); };
        \\}
        \\
        \\main :: () {
        \\    x: s64 = 3;
        \\    y: s64 = 4;
        \\    #insert read_field(Vec2, 0);
        \\    #insert read_field(Vec2, 1);
        \\}
    );
    code_block(2, "text", #string
        \\3
        \\4
    );
    paragraph(3, #string,oneline
        \\`read_field` never runs at run time. The checker evaluates the call,
        \\the compile-time constant `name` holds the string `"x"`, and the
        \\double-backtick splice puts that string into the argument position as
        \\an identifier. The identifier is resolved where the fragment is
        \\inserted, which is why the generated code reads `main`'s locals.
    );
    subheading(4, "How names in a quoted fragment connect");
    paragraph(5, #string,oneline
        \\A quote is checked in the environment where it is written, not where it
        \\is inserted. A free name that only exists at the insertion site is
        \\rejected at the quote, so a fragment reaches into its insertion site
        \\only through a splice or through a `Code` argument written by the
        \\caller.
    );
    table_header(6, "Inside `#code`   —   Meaning during insertion");
    table_row(7, #string,oneline
        \\Ordinary local declaration   |   Hygienic: the binding receives a fresh
        \\generated name, so it cannot collide with or shadow a caller local of
        \\the same spelling
    );
    table_row(8, #string,oneline
        \\Ordinary free name   |   Resolved in the environment that contains the
        \\`#code` quote; a name that only exists at the insertion site is
        \\`error: unbound '<name>'` reported at the quote
    );
    table_row(9, #string,oneline
        \\Single backtick `` `name ``   |   Non-hygienic: the written name
        \\survives expansion, so a macro body can introduce a binding the caller
        \\can then use
    );
    table_row(10, #string,oneline
        \\Double backtick ` ``name `   |   Splice: substitutes the compile-time
        \\value of `name` into that parser position. A string constant becomes an
        \\identifier or field name resolved at the insertion site
    );
    table_row(11, #string,oneline
        \\`#insert code_value;`   |   Clones the represented syntax into the
        \\current body
    );
    table_row(12, #string,oneline
        \\`#insert string_value;`   |   Parses generated Glosso source text,
        \\caches the bytes, and inserts the parsed declarations/statements
    );
    paragraph(13, #string,oneline
        \\Hygiene and single-backtick capture are visible in one program. The
        \\macro's own `tmp` is renamed; the caller's `tmp` is what the inserted
        \\body sees; `` `shared `` is created by the macro and outlives it:
    );
    code_block(14, "glosso", #string
        \\#import "Io";
        \\
        \\with_temp :: (body: Code) #expand {
        \\    tmp := 100;
        \\    `shared := 7;
        \\    #insert body;
        \\    print("macro tmp %\n", tmp);
        \\}
        \\
        \\main :: () {
        \\    tmp := 1;
        \\    with_temp(#code {
        \\        tmp += 1;
        \\        shared += 1;
        \\    });
        \\    print("caller tmp % shared %\n", tmp, shared);
        \\}
    );
    code_block(15, "text", #string
        \\macro tmp 100
        \\caller tmp 2 shared 8
    );
    paragraph(16, #string,oneline
        \\The fragment passed to `with_temp` is written at the call site, so its
        \\`tmp` is the caller's `tmp` with no splice needed. This is the cheapest
        \\way to hand a macro a block of user code.
    );
    subheading(17, "Where `#insert` is not accepted");
    paragraph(18, #string,oneline
        \\`#insert` is a declaration or statement position. The body of a switch
        \\is parsed as a list of `case`/`else` arms and accepts neither a `Code`
        \\insertion nor generated source, whatever the fragment contains:
    );
    code_block(19, "glosso", #string
        \\dispatch :: (value: s64) {
        \\    if value == {
        \\        #insert "case 1; handle(1);";
        \\    else;
        \\        print("other\n");
        \\    }
        \\}
    );
    code_block(20, "text", #string
        \\error: expected case/else
        \\  --> insert.glo:3:9
        \\  |
        \\3 |         #insert "case 1; handle(1);";
        \\  |         ^^^^^^^
    );
    paragraph(21, #string,oneline
        \\Generate the whole switch statement instead of its arms, or dispatch
        \\through generated procedures. The same rule holds for any position the
        \\grammar restricts to a fixed set of clauses.
    );
    note(22, #string,oneline
        \\`#insert` accepts only a `Code` value or string source, and a top-level
        \\insertion must produce top-level-compatible syntax. Expansion is
        \\bounded: a macro that inserts a call to itself stops with `error:
        \\#insert expansion limit exceeded` at the offending `#insert` rather
        \\than looping.
    );
}

render_section_74 :: () {
    paragraph(0, #string,oneline
        \\A `#expand` procedure is expanded into its call site during checking
        \\instead of being lowered to a callable function. Its body becomes part
        \\of the caller's body, so a binding it creates can be made visible to
        \\the caller.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\emit_counter :: () #expand {
        \\    `calls := 0;
        \\    `calls += 1;
        \\}
        \\
        \\emit_named :: (#comptime name: string) #expand {
        \\    #insert str_cat(name, " := 0;");
        \\}
        \\
        \\main :: () {
        \\    emit_counter();
        \\    print("%\n", calls);
        \\    emit_named("hits");
        \\    hits += 7;
        \\    print("%\n", hits);
        \\}
    );
    code_block(2, "text", #string
        \\1
        \\7
    );
    paragraph(3, #string,oneline
        \\Those are the two ways to give a generated binding a caller-visible
        \\name: a single backtick when the spelling is fixed, and generated
        \\source when the spelling is computed. A double-backtick splice does not
        \\work here. `` ``name `` substitutes a compile-time value into a parser
        \\position, and a declaration whose name node is a spliced value does not
        \\publish that name to the enclosing body:
    );
    code_block(4, "glosso", #string
        \\emit_counter :: (name: string) #expand {
        \\    #insert #code { ``name := 0; };
        \\}
        \\
        \\main :: () {
        \\    emit_counter("calls");
        \\    print("%\n", calls);
        \\}
    );
    code_block(5, "text", #string
        \\error: unbound 'calls'
        \\  --> expand.glo:7:18
        \\  |
        \\7 |     print("%\n", calls);
        \\  |                  ^^^^^
    );
    subheading(6, "Expression macros");
    paragraph(7, #string,oneline
        \\`#expand,expression` makes the call usable anywhere an expression is
        \\allowed. The body must be exactly one `return` of one expression;
        \\anything else is rejected at the declaration, not at the call.
    );
    code_block(8, "glosso", #string
        \\#import "Io";
        \\
        \\counter: s64 = 0;
        \\
        \\bump :: () -> s64 {
        \\    counter += 1;
        \\    return counter;
        \\}
        \\
        \\twice :: (value: $T) #expand,expression {
        \\    return value + value;
        \\}
        \\
        \\main :: () {
        \\    print("%\n", twice(21));
        \\    total := twice(bump());
        \\    print("total % counter %\n", total, counter);
        \\}
    );
    code_block(9, "text", #string
        \\42
        \\total 3 counter 2
    );
    paragraph(10, #string,oneline
        \\`total 3` and `counter 2` are the point: expansion substitutes the
        \\argument expression at every parameter reference, so `twice(bump())`
        \\becomes `bump() + bump()` and calls `bump` twice, summing `1 + 2`. This
        \\is deliberate C-style macro evaluation, and it is the main reason to
        \\bind an argument to a local inside the macro before using it more than
        \\once.
    );
    code_block(11, "glosso", #string
        \\bad :: (v: s64) #expand,expression {
        \\    if v > 0 return 1;
        \\    return 0;
        \\}
    );
    code_block(12, "text", #string
        \\error: expression macro 'bad' must contain exactly `return <expr>;`
        \\  --> macro.glo:1:1
        \\  |
        \\1 | bad :: (v: s64) #expand,expression {
        \\  | ^^^
    );
    subheading(13, "Rejecting inputs a macro cannot handle");
    paragraph(14, #string,oneline
        \\A macro that reflects on its argument type should reject the shapes it
        \\does not support with `#compile_error` rather than failing later inside
        \\generated code. The diagnostic is reported at the `#compile_error`
        \\statement inside the macro body, so the message itself has to name the
        \\macro and the requirement; the call site appears only in the build's
        \\surrounding context.
    );
    code_block(15, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\sum_fields :: (value: $T) #expand {
        \\    #if !Is_Struct(T)
        \\        #compile_error "sum_fields requires a struct";
        \\    print("fields %\n", field_count(T));
        \\}
        \\
        \\main :: () {
        \\    sum_fields(3);
        \\}
    );
    code_block(16, "text", #string
        \\error: sum_fields requires a struct
        \\  --> macro.glo:6:9
        \\  |
        \\6 |         #compile_error "sum_fields requires a struct";
        \\  |         ^^^^^^^^^^^^^^
    );
    paragraph(17, #string,oneline
        \\Generated macro parameters keep their Glosso operand types. Callers
        \\should use the corresponding C-width types when C integer promotions or
        \\overflow behavior matter; Bindgen skips syntax it cannot translate
        \\safely rather than inventing a conversion.
    );
    paragraph(18, #string,oneline
        \\For a string-valued insertion, Glosso preserves the exact generated
        \\bytes in its content-addressed cache. `--show-generated` prints the
        \\cached path for each insertion, which is where a stepping debugger and
        \\further diagnostics point:
    );
    code_block(19, "text", #string
        \\glosso: generated source
        \\  ...\glosso\cache\generated\insert\v1\e4334f7f....glo
    );
    paragraph(20, #string,oneline
        \\Diagnostics remain anchored at the editable `#insert`, with notes
        \\showing the cached generated location and any nested insertion sites.
        \\See _Compiler Cache and Generated Sources_ for paths and controls.
    );
}

render_section_75 :: () {
    paragraph(0, #string,oneline
        \\`std/Meta` exposes type names, sizes, kind tags, fields, enum items,
        \\and union variants. Every entry is a `#magic` compiler intrinsic: the
        \\checker folds each call to a constant while it still knows the type, so
        \\the queries work on `type` values and create no runtime descriptor.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Color :: enum { Red; Green :: 10; Blue; }
        \\Shape :: union { circle: f64; rect: s64; }
        \\Vec2  :: struct { x: s64; y: f32; }
        \\
        \\main :: () {
        \\    info :: type_info(Vec2);
        \\    print("% tag % size % align %\n",
        \\        info.name, cast(s64) info.tag, info.size, info.alignment);
        \\    print("enum % % %\n",
        \\        enum_count(Color), enum_name(Color, 1), enum_value(Color, 1));
        \\    print("variant % % %\n", variant_count(Shape),
        \\        variant_name(Shape, 0), type_name(variant_type(Shape, 0)));
        \\    print("field % %\n",
        \\        field_name(Vec2, 1), type_name(field_type(Vec2, 1)));
        \\}
    );
    code_block(2, "text", #string
        \\Vec2 tag 7 size 16 align 8
        \\enum 3 Green 10
        \\variant 2 circle f64
        \\field y f32
    );
    subheading(3, "The index must be a compile-time constant");
    paragraph(4, #string,oneline
        \\Because the intrinsics are folded during checking, the ordinal argument
        \\has to be a constant the checker already knows. An ordinary loop
        \\variable is not, and `#inline for` does not make one: its induction
        \\variable is still a runtime local, so `field_name(T, i)` fails with the
        \\same constant-lookup error a runtime value produces anywhere else.
    );
    code_block(5, "glosso", #string
        \\print_fields :: (T: type) #expand {
        \\    #inline for i: 0..field_count(T) {
        \\        print("field %\n", field_name(T, i));
        \\    }
        \\}
    );
    code_block(6, "text", #string
        \\error: unknown const i
        \\  --> meta.glo:3:42
        \\  |
        \\3 |         print("field %\n", field_name(T, i));
        \\  |                                          ^
    );
    paragraph(7, #string,oneline
        \\Walk the members with a `#comptime` parameter and `#if` instead. Each
        \\recursive expansion binds the next constant index, and the recursion
        \\terminates because `#if` deletes the branch that would expand past the
        \\member count:
    );
    code_block(8, "glosso", #string
        \\#import "Io";
        \\#import "Meta";
        \\
        \\Vec2 :: struct { x: s32; y: f32; }
        \\
        \\print_fields_from :: (#comptime T: type, #comptime i: s64) #expand {
        \\    #if i < field_count(T) {
        \\        print("field %: %\n",
        \\            field_name(T, i), type_name(field_type(T, i)));
        \\        print_fields_from(T, i + 1);
        \\    }
        \\}
        \\
        \\print_fields :: (#comptime T: type) #expand { print_fields_from(T, 0); }
        \\
        \\main :: () { print_fields(Vec2); }
    );
    code_block(9, "text", #string
        \\field x: s32
        \\field y: f32
    );
    paragraph(10, #string,oneline
        \\The alternative is to build source text and hand it to `#insert`, which
        \\is what the standard library's `Serialization` and `#derive` machinery
        \\does. Text generation scales better to whole declarations; the
        \\recursive expansion above is clearer for a handful of statements.
    );
    subheading(11, "The query surface");
    table_header(12, "Question   —   Use");
    table_row(13, #string,oneline
        \\What kind of type is this?   |   `type_kind(T)` or `type_info(T).tag`
        \\against `Type_Info_Tag`, and the `Is_Integer`/`Is_Struct`/`Is_Union`
        \\predicates in `where` clauses
    );
    table_row(14, #string,oneline
        \\How big is it?   |   `size_of(T)`, and `type_info(T).size` /
        \\`type_info(T).alignment` for the same facts as struct fields
    );
    table_row(15, #string,oneline
        \\Which struct fields exist?   |   `field_count`, `field_name`,
        \\`field_type`
    );
    table_row(16, #string,oneline
        \\Which enum items exist?   |   `enum_count`, `enum_name`, `enum_value`
        \\— `enum_value` returns the declared ordinal, not the position
    );
    table_row(17, #string,oneline
        \\Which union variants exist?   |   `variant_count`, `variant_name`,
        \\`variant_type`
    );
    table_row(18, #string,oneline
        \\Can a generic parameter be mapped safely?   |   `type_uses_param`,
        \\`type_is_param`, `type_occurs_covariantly` — these live in
        \\`std/Typeclass/Derive`, not in `std/Meta`
    );
    paragraph(19, #string,oneline
        \\`Type_Info` carries only `tag`, `name`, `size`, `alignment`, and a
        \\`shower` procedure pointer. There is no field-offset entry and no
        \\`offset_of` builtin; a byte offset has to be measured with pointer
        \\arithmetic at run time.
    );
    note(20, #string,oneline
        \\Source field order and target storage layout are different contracts.
        \\`field_name` enumerates declaration order, while the layout pass
        \\reorders an ordinary struct by descending alignment. For `Rec :: struct
        \\{ a: u8; b: u64; }` reflection reports `a, b` while the measured
        \\offsets are `a=8, b=0`. Use `struct #packed` when declaration order must
        \\be the storage order — see _Packed Records_ — and explicit format
        \\metadata rather than raw field order for persistent serialization.
    );
}

render_section_76 :: () {
    paragraph(0, #string,oneline
        \\The implicit `context` carries `print_style`, `allocator`,
        \\`temp_allocator`, `logger`, `random_generator`, `user_ptr`, and
        \\`user_index`. Every ordinary Glosso call passes it as a hidden
        \\parameter. Import `Context` to name the field types and the allocator
        \\constructors.
    );
    code_block(1, "glosso", #string
        \\#import "Context";
        \\#import "Io";
        \\
        \\doubled :: (x: s64) -> s64 #no_context { return x * 2; }
        \\
        \\main :: () {
        \\    #push_context {
        \\        context.user_index = 99;
        \\        context.allocator = heap_allocator();
        \\        p := alloc(128);
        \\        defer free(p);
        \\        print("inside %\n", context.user_index);
        \\    }
        \\    print("restored %\n", context.user_index);
        \\
        \\    fresh: #Context;
        \\    fresh.user_index = 5;
        \\    #push_context fresh {
        \\        print("replaced %\n", context.user_index);
        \\    }
        \\    print("doubled %\n", doubled(21));
        \\}
    );
    code_block(2, "text", #string
        \\inside 99
        \\restored 0
        \\replaced 5
        \\doubled 42
    );
    paragraph(3, #string,oneline
        \\The bodiless form copies the current context, so a mutation inside the
        \\block is discarded on exit. The `#push_context value { ... }` form
        \\installs a whole replacement, which is why `replaced 5` and not
        \\`replaced 99`: `fresh` is a zeroed `#Context` with only `user_index`
        \\set, and it does not inherit the caller's allocator or print style.
    );
    subheading(4, "Naming the type and the exceptions");
    paragraph(5, #string,oneline
        \\The built-in context type has a directive spelling. `context` is a
        \\reserved keyword and bare `Context` names the imported module, so a
        \\declaration must be written `#Context`:
    );
    code_block(6, "text", #string
        \\error: the built-in Context type is written #Context
        \\  --> ctx.glo:7:12
        \\  |
        \\7 |     fresh: Context;
        \\  |            ^^^^^^^
    );
    paragraph(7, #string,oneline
        \\`#c_call` and `#no_context` procedures have no context parameter at all,
        \\which is what makes them usable as C callbacks. Touching `context` in
        \\such a body is rejected during checking rather than reading a stale
        \\pointer at run time:
    );
    code_block(8, "text", #string
        \\error: cannot access 'context' in a #c_call / #no_context procedure
        \\  --> ctx.glo:2:53
        \\  |
        \\2 | doubled :: (x: s64) -> s64 #no_context { return x * context.user_index; }
        \\  |                                                     ^^^^^^^
    );
    table_header(9, "Construct   —   Context behavior");
    table_row(10, #string,oneline
        \\Ordinary Glosso function   |   Receives the current context implicitly
    );
    table_row(11, #string,oneline
        \\Function marked `#no_context`   |   No implicit context; referencing
        \\`context` in its body is rejected
    );
    table_row(12, #string,oneline
        \\Function marked `#c_call` / any `#foreign` call   |   Uses the C ABI
        \\and has no implicit Glosso context parameter
    );
    table_row(13, #string,oneline
        \\`#push_context { ... }`   |   Copies/pushes the current context for
        \\the body, then restores the saved context on every structured exit
    );
    table_row(14, #string,oneline
        \\`#push_context replacement { ... }`   |   Installs the supplied
        \\`#Context` value for the body and restores the previous one afterward
    );
    table_row(15, #string,oneline
        \\`#push_allocator(allocator);`   |   Replaces `context.allocator` until
        \\the enclosing defer scope exits, then restores it
    );
    paragraph(16, #string,oneline
        \\A pushed context is restored through the same LIFO defer machinery as
        \\user `defer` statements, including early return and loop exits that
        \\leave its scope. Because the restoration is a defer, it does not run on
        \\a failed `#assert` or any other abort — see _Assertions with `#assert`_.
    );
    paragraph(17, #string,oneline
        \\The default context sets `print_style.default_format_int.base` to 10,
        \\`allocator` to the debug allocator at `-O0` and the heap allocator
        \\otherwise, `temp_allocator` to the default temporary allocator, and
        \\zeroes the remaining vtables. A replacement context that is not
        \\initialized from `context` therefore starts with no logger and no random
        \\generator.
    );
}

render_section_77 :: () {
    paragraph(0, #string,oneline
        \\Temporary allocation is useful for formatting and transient strings.
        \\`#push_allocator(context.temp_allocator);` routes following
        \\allocations to the temp allocator in the compiler-managed region.
    );
    paragraph(1, #string,oneline
        \\Memory allocated from `context.temp_allocator` lives until the
        \\enclosing compiler-managed temporary scope is restored. Blocks, branch
        \\bodies, loop bodies, and non-escaping function bodies form these
        \\scopes; a returned temp-backed string or pointer-like value is still
        \\only valid until the caller's enclosing temp scope exits. Copy data
        \\into heap/context-owned storage when it must outlive that region.
    );
    code_block(2, "glosso", #string
        \\#import "Context";
        \\#import "Format";
        \\
        \\make_message :: (name: string) -> string {
        \\    #push_allocator(context.temp_allocator);
        \\    return format("hello %", name);
        \\}
    );
    subheading(3, "What the region reuse looks like");
    paragraph(4, #string,oneline
        \\A loop body is one of those scopes, so every iteration hands the same
        \\bytes back. A value saved out of an iteration is not copied; it keeps
        \\pointing at storage the next iteration overwrites. Nothing diagnoses
        \\this — the program compiles without a warning and prints garbage:
    );
    code_block(5, "glosso", #string
        \\#import "Context";
        \\#import "Format";
        \\#import "Io";
        \\
        \\label :: (n: s64) -> string {
        \\    #push_allocator(context.temp_allocator);
        \\    return format("item-%", n);
        \\}
        \\
        \\main :: () {
        \\    kept: string;
        \\    for i: 0..3 {
        \\        s := label(i);
        \\        if i == 0 kept = s;
        \\        print("iteration % -> %\n", i, s);
        \\    }
        \\    print("kept -> %\n", kept);
        \\}
    );
    code_block(6, "text", #string
        \\iteration 0 -> item-0
        \\iteration 1 -> item-1
        \\iteration 2 -> item-2
        \\kept ->
    );
    paragraph(7, #string,oneline
        \\`kept` still has the right length; its six bytes now hold whatever the
        \\region was last used for. Copy into context-owned storage at the moment
        \\the value has to outlive its region, and release the copy:
    );
    code_block(8, "glosso", #string
        \\#import "String_Builder";
        \\
        \\main :: () {
        \\    kept := str_cat(label(0), "");
        \\    defer string_free(kept);
        \\    for i: 1..3 { _ := label(i); }
        \\    print("kept -> %\n", kept);   // kept -> item-0
        \\}
    );
    paragraph(9, #string,oneline
        \\The arena is a fixed allocation, not a growing heap. Hosted programs get
        \\4 MiB by default and `--temp-allocator-size <bytes>` changes it;
        \\`Compiler.DEFAULT_TEMP_ALLOCATOR_SIZE` is the same 4 MiB constant for
        \\build scripts. Bare-metal targets get a non-TLS 64 KiB arena instead —
        \\see _Bare-Metal and Freestanding Targets_.
    );
}

render_section_78 :: () {
    paragraph(0, #string,oneline
        \\At `-O0`, the default allocator is the debug allocator. It tracks live
        \\allocations and can report leaks. In optimized builds, the default is
        \\the heap allocator.
    );
    code_block(1, "glosso", #string
        \\#import "Context";
        \\#import "Io";
        \\
        \\main :: () {
        \\    p := alloc(32);
        \\    _ = p;
        \\    debug_allocator_report_leaks();
        \\}
    );
    code_block(2, "text", #string
        \\warning: resource must be released by 'free' before leaving scope
        \\  --> leak.glo:5:10
        \\  |
        \\5 |     p := alloc(32);
        \\  |          ^^^^^
        \\note: release obligation was created here
        \\
        \\glosso debug allocator: leaked 1 allocation(s), 32 byte(s)
        \\  leak: 32 byte(s)
        \\    allocated at:
        \\      ...\leak.glo:5:10
    );
    subheading(3, "Two independent mechanisms");
    paragraph(4, #string,oneline
        \\The warning and the leak report come from different places and can
        \\disagree. The warning is a compile-time temporal check driven by the
        \\`#memory released_by(...)` annotation on `alloc`; `--borrow-check
        \\<off|warning|error>` selects its severity, and `error` turns the same
        \\text into `error: resource must be released by 'free' before leaving
        \\scope`. The report is produced at run time by the debug allocator, which
        \\records the call site of every block it hands out.
    );
    paragraph(5, #string,oneline
        \\The debug allocator is installed as `context.allocator` only at `-O0`.
        \\The same program built `-O2` still emits the compile-time warning and
        \\prints nothing at run time, because the heap allocator tracks nothing.
    );
    paragraph(6, #string,oneline
        \\It also only sees what it allocated. An allocation made under
        \\`#push_allocator(context.temp_allocator)` never reaches it, so the
        \\report stays empty while the compile-time warning still fires:
    );
    code_block(7, "glosso", #string
        \\main :: () {
        \\    #push_allocator(context.temp_allocator);
        \\    p := alloc(64);          // warning: must be released by 'free'
        \\    _ = p;
        \\    debug_allocator_report_leaks();   // prints nothing
        \\}
    );
    paragraph(8, #string,oneline
        \\Run representative success and error paths: a leak usually appears only
        \\after a partial initialization, and the report is emitted where the call
        \\is placed rather than at process exit, so an early `return` skips it.
    );
}

render_section_79 :: () {
    paragraph(0, #string,oneline
        \\Declare a library with `#library`; bind functions with `#foreign`. The
        \\symbol name is optional when it matches the Glosso declaration name.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\libc :: #library "c";
        \\strlen :: (text: *const s8) -> u64 #foreign libc "strlen";
        \\puts :: (text: *const s8) -> s32 #foreign libc;
        \\
        \\main :: () {
        \\    text := "hello\0";
        \\    p := cast(*const s8) text.data;
        \\    print("len %\n", strlen(p));
        \\    _ := puts(p);
        \\}
    );
    code_block(2, "text", #string
        \\len 5
        \\hello
    );
    paragraph(3, #string,oneline
        \\A Glosso `string` is a descriptor, not a NUL-terminated buffer, so the
        \\literal carries its own `\0` and the C parameter is spelled
        \\`*const s8`. Link kind modifiers are `#library,system`,
        \\`#library,dyn`, and `#library,static`.
    );
    subheading(4, "Declaration forms");
    paragraph(5, #string,oneline
        \\`#library` creates a compile-time library handle. `#foreign` creates a
        \\bodyless function whose call uses the C ABI and whose external symbol
        \\is resolved from either that handle or a directly written library
        \\name. A library handle must be declared before a referencing
        \\`#foreign` declaration is registered.
    );
    bullet(6, #string,oneline
        \\`name :: #library[, static|system|dyn] "file";` declares a reusable
        \\handle. The default kind is `static`; only one kind modifier is
        \\allowed.
    );
    bullet(7, #string,oneline
        \\`fn_name :: (parameters) -> Return #foreign library_handle
        \\["symbol"];` uses a declared handle. An unknown handle is a compile
        \\error.
    );
    bullet(8, #string,oneline
        \\`fn_name :: (parameters) -> Return #foreign "file" ["symbol"];`
        \\bypasses `#library` and behaves as a non-dynamic link input.
    );
    bullet(9, #string,oneline
        \\When the optional symbol string is absent, the external symbol is the
        \\Glosso declaration name. A foreign declaration has no Glosso body.
    );
    paragraph(10, #string,oneline
        \\Both restrictions are enforced during parsing and checking, before any
        \\linker runs:
    );
    code_block(11, "text", #string
        \\error: #library accepts only one link-kind modifier
        \\  --> lib.glo:1:25
        \\  |
        \\1 | libc :: #library,static,dyn "c";
        \\  |                         ^^^
        \\
        \\error: #foreign refers to unknown library 'nosuchlib' (declare it with #library)
        \\  --> lib.glo:1:1
        \\  |
        \\1 | puts :: (text: *const s8) -> s32 #foreign nosuchlib "puts";
        \\  | ^^^^
    );
    code_block(12, "glosso", #string
        \\// Reusable library handle; `c` is the linker input.
        \\libc :: #library "c";
        \\strlen :: (text: *const s8) -> u64 #foreign libc "strlen";
        \\
        \\// The symbol string may be omitted when both names are equal.
        \\puts :: (text: *const s8) -> s32 #foreign libc;
        \\
        \\// A direct library string needs no #library declaration.
        \\memcmp :: (a: *const void, b: *const void, count: u64) -> s32
        \\    #foreign "c" "memcmp";
    );
    subheading(13, "Library kinds");
    table_header(14, #string,oneline
        \\Declaration   —   Resolution time   —   Compiler behavior
    );
    table_row(15, #string,oneline
        \\`#library "name"`   |   Link time   |   The default; identical to
        \\`#library,static`. The name or path becomes a target-specific linker
        \\input.
    );
    table_row(16, #string,oneline
        \\`#library,static "name"`   |   Link time   |   Explicit spelling of
        \\the default link kind. It does not force a system linker to choose a
        \\static archive when only a shared/import library is available; use an
        \\archive path to force one file.
    );
    table_row(17, #string,oneline
        \\`#library,system "name"`   |   Link time   |   Marks the declaration
        \\as a system library. It currently uses the same name translation and
        \\linker search path as the default kind; Glosso does not scan system
        \\directories itself.
    );
    table_row(18, #string,oneline
        \\`#library,dyn "path-or-name"`   |   Runtime   |   Does not add that
        \\library to the normal link. The generated program loads it with
        \\`LoadLibraryA` on Windows or `dlopen(..., RTLD_NOW)` elsewhere, then
        \\resolves the function with `GetProcAddress` or `dlsym`.
    );
    subheading(19, "Which libraries are linked");
    paragraph(20, #string,oneline
        \\Declaring a library does not by itself add it to the final link. After
        \\lowering the program, the compiler walks runtime-reachable functions
        \\and function references. A non-dynamic library is added only when a
        \\reachable call or function value refers to one of its foreign
        \\functions. Repeated library inputs are deduplicated. This is why a
        \\target-specific foreign declaration may exist harmlessly when no
        \\reachable code selects it.
    );
    subheading(21, "Name conversion and search");
    paragraph(22, #string,oneline
        \\Glosso converts a logical library spelling to the input shown below.
        \\The linker then performs the actual directory search.
        \\`#library,system` does not add another directory and does not call a
        \\Glosso package resolver. Supply an explicit path to select a
        \\particular file, or pass a target-appropriate search-path option
        \\through `--linker-arg` or `Compiler.add_current_linker_arg`.
    );
    table_header(23, "Target   —   Logical spelling   —   Linker input");
    table_row(24, #string,oneline
        \\Windows MSVC   |   `c` or `libc`   |   `legacy_stdio_definitions.lib`
        \\and `ucrt.lib`
    );
    table_row(25, #string,oneline
        \\Windows MSVC   |   `user32` or `libuser32`   |   `user32.lib`
    );
    table_row(26, #string,oneline
        \\Windows MSVC   |   A path or a name ending in `.lib`   |   Passed as
        \\written; the Clang/lld-link SDK and `/LIBPATH:` directories resolve a
        \\bare name
    );
    table_row(27, "Windows GNU   |   `c` or `libc`   |   `libmsvcrt.a`");
    table_row(28, #string,oneline
        \\Windows GNU   |   `user32`, `libuser32`, or `user32.lib`   |
        \\  `libuser32.a`
    );
    table_row(29, #string,oneline
        \\Windows GNU   |   A path or a name ending in `.a`   |   Passed as
        \\written
    );
    table_row(30, #string,oneline
        \\Linux, macOS, and other non-Windows targets   |   `c` or `libc`   |
        \\  No extra input; the target C runtime is already part of the link
        \\plan
    );
    table_row(31, #string,oneline
        \\Linux, macOS, and other non-Windows targets   |   `ssl` or `libssl`
        \\  |   `-lssl`
    );
    table_row(32, #string,oneline
        \\Linux, macOS, and other non-Windows targets   |   A path or a name
        \\ending in `.a`, `.so`, or `.dylib`   |   Passed as written
    );
    code_block(33, "text", #string
        \\# Search an additional Unix directory
        \\glosso app.glo --linker-arg -L/opt/vendor/lib
        \\
        \\# Search an additional MSVC directory
        \\glosso app.glo --linker-arg /LIBPATH:C:\vendor\lib
    );
    subheading(34, "Dynamic-library behavior");
    code_block(35, "glosso", #string
        \\#import "Io";
        \\
        \\k32 :: #library,dyn "kernel32.dll";
        \\GetTickCount :: () -> u32 #foreign k32 "GetTickCount";
        \\
        \\main :: () { print("%\n", GetTickCount() > 0); }
    );
    paragraph(36, #string,oneline
        \\Nothing in that program reaches the linker: `kernel32.dll` is not a link
        \\input, and the call goes through a `LoadLibraryA`/`GetProcAddress` pair
        \\generated around the first invocation.
    );
    bullet(37, #string,oneline
        \\The `dyn` string is embedded as the runtime loader input. It is not
        \\converted to `-l...`, `.lib`, or `.a` form.
    );
    bullet(38, #string,oneline
        \\The resolved function address is cached in a generated slot after the
        \\first successful lookup.
    );
    bullet(39, #string,oneline
        \\A program using dynamic foreign calls links the platform loader
        \\support (`-ldl` on non-Windows native targets).
    );
    bullet(40, #string,oneline
        \\Dynamic libraries are rejected for WebAssembly and WASI targets.
    );
    bullet(41, #string,oneline
        \\The compile-time VM can execute dynamic foreign calls only in its
        \\supported Windows/libffi configuration; ordinary linked executables
        \\use the LLVM backend behavior described above.
    );
    bullet(42, #string,oneline
        \\A missing library or symbol is a runtime loading failure for `dyn`,
        \\but a missing non-dynamic library or symbol is normally a linker
        \\error.
    );
    note(43, #string,oneline
        \\`#foreign` declares a signature; it cannot verify a C header. Integer
        \\widths, struct layout, pointer constness, nullability, ownership, and
        \\the external symbol's real prototype must match. Use `#memory` effects
        \\on opaque foreign functions when temporal checking needs to know
        \\whether pointers are borrowed, stored, invalidated, released, or
        \\returned.
    );
}

render_section_80 :: () {
    paragraph(0, #string,oneline
        \\`#c_call` changes the calling convention and removes normal Glosso
        \\context passing. Use it for callbacks and foreign ABI surfaces.
    );
    code_block(1, "glosso", #string,oneline
        \\Callback :: #fn_ptr(data: *void) -> *void #c_call;
    );
    paragraph(2, #string,oneline
        \\A `#c_call` function cannot rely on implicit `context` unless a
        \\context is explicitly made available through supported mechanisms.
    );
    subheading(3, "C ABI validation");
    paragraph(4, #string,oneline
        \\`#foreign` declarations always use the C ABI. `#c_call` applies that
        \\ABI to a Glosso function definition, function-pointer type, or
        \\interoperable struct declaration. Unlike an ordinary Glosso call, a
        \\C-ABI call has no implicit `context` parameter.
    );
    bullet(5, #string,oneline
        \\Use `callback :: (...) -> T #c_call { ... }` for a Glosso body
        \\callable through C, and `Callback :: #fn_ptr(...) -> T #c_call;` for
        \\the matching pointer type.
    );
    bullet(6, #string,oneline
        \\Accessing implicit `context` inside a `#c_call` body is a compile
        \\error. Pass required state through an explicit pointer or parameter.
    );
    bullet(7, #string,oneline
        \\A C function-pointer type is distinct from an ordinary Glosso
        \\function-pointer type, even when its written parameters and return
        \\type otherwise match.
    );
    bullet(8, #string,oneline
        \\`#c_call` on a struct declaration means something different from
        \\`#c_call` on a function: it selects layout, not a calling convention.
        \\The fields of such a struct are also recursively checked for
        \\unsupported by-value representations.
    );
    code_block(9, "glosso", #string
        \\User_Data :: struct #c_call { total: s64; }
        \\Callback :: #fn_ptr(data: *void, value: s32) -> s32 #c_call;
        \\
        \\add_to_total :: (data: *void, value: s32) -> s32 #c_call {
        \\    user := cast(*User_Data)data;
        \\    user.*.total += value;
        \\    return value;
        \\}
        \\
        \\// An ordinary Glosso wrapper may use context and call the C surface.
        \\run_callback :: (callback: Callback, data: *void) -> s32 {
        \\    return callback(data, 42);
        \\}
    );
    paragraph(10, #string,oneline
        \\`run_callback` may touch `context`; `add_to_total` may not. The
        \\restriction is checked on the definition, and the diagnostic names both
        \\attributes because they share the rule:
    );
    code_block(11, "text", #string
        \\error: cannot access 'context' in a #c_call / #no_context procedure
        \\  --> abi.glo:3:53
        \\  |
        \\3 | doubled :: (x: s64) -> s64 #no_context { return x * context.user_index; }
        \\  |                                                     ^^^^^^^
    );
    subheading(12, "Struct layout across the ABI");
    paragraph(13, #string,oneline
        \\Three different layouts are available, and the difference matters as
        \\soon as a record is shared with C. An undecorated struct is reordered by
        \\the layout pass; struct-level `#c_call` keeps declaration order and
        \\applies the target C ABI's natural alignment, inter-field padding, and
        \\tail padding; `#packed` keeps declaration order with no padding at all
        \\and alignment 1.
    );
    table_header(14, #string,oneline
        \\Declaration   —   Field order   —   Padding   —   Size and alignment of
        \\`{ a: u8; b: u64; c: u8; }`
    );
    table_row(15, #string,oneline
        \\`struct`   |   Reordered by descending alignment   |   Natural   |
        \\  size 16, align 8
    );
    table_row(16, #string,oneline
        \\`struct #c_call`   |   Declaration order   |   Target C ABI natural and
        \\tail padding   |   size 24, align 8
    );
    table_row(17, #string,oneline
        \\`struct #packed`   |   Declaration order   |   None   |   size 10, align
        \\1
    );
    table_row(18, #string,oneline
        \\`struct #c_call #packed`   |   Declaration order   |   None   |
        \\  identical to `#packed`: size 10, align 1
    );
    paragraph(19, #string,oneline
        \\`#packed` is the sole packing switch, so adding `#c_call` to a packed
        \\struct changes nothing; the directives may appear in either order.
        \\_Packed Records_ covers the attribute itself, including the fact that it
        \\is rejected on unions, enums, procedures, and `#fn_ptr` types.
    );
    paragraph(20, #string,oneline
        \\A struct passed by value through a `#c_call` signature does not need
        \\struct-level `#c_call`: the function's own attribute already selects the
        \\C ABI, and the target's aggregate-passing rules apply to whatever layout
        \\the struct has. A packed eight-byte record travels in one integer
        \\register on Microsoft x64:
    );
    code_block(21, "glosso", #string
        \\Packed8 :: struct #packed { tag: u8; count: u16; value: u32; extra: u8; }
        \\
        \\take_packed :: (v: Packed8) -> s32 #c_call { return cast(s32) v.tag; }
    );
    code_block(22, "text", #string
        \\%Packed8 = type <{ i8, i16, i32, i8 }>
        \\define i32 @glo_take_packed(i64 %0) {
    );
    paragraph(23, #string,oneline
        \\The angle brackets on the LLVM type are the packed spelling; an ordinary
        \\struct emits `type { ... }` with the reordered fields. A UEFI target
        \\applies the Microsoft C record rules for these aggregates even though
        \\`OUT.os` stays `Target_OS.Freestanding` — the ABI comes from `OUT.abi`,
        \\not from the OS field.
    );
    subheading(24, "Rejected by-value representations");
    paragraph(25, #string,oneline
        \\The checker walks C-ABI parameters, returns, callback signatures, and
        \\fields of non-generic `#c_call` structs. Complex primitives,
        \\`Simd(...)`, and `Matrix(...)` are rejected because Glosso does not
        \\declare a portable by-value C ABI for them. The check is recursive
        \\through structs, unions, tuples, fixed arrays, and C function pointers,
        \\and it applies to a `#packed` record crossing the boundary exactly as it
        \\does to a `#c_call` one.
    );
    code_block(26, "text", #string
        \\error: Simd(f32, 4) has no portable C ABI; pass scalar memory and use simd_load/simd_store at the boundary
        \\  --> abi.glo:2:1
        \\  |
        \\2 | take :: (v: Simd(f32, 4)) -> f32 #c_call { return 0.0; }
        \\  | ^^^^
    );
    bullet(27, #string,oneline
        \\On Windows x64, C-ABI structs follow the platform aggregate ABI: sizes
        \\1, 2, 4, and 8 bytes travel as integers; other by-value aggregates use
        \\indirect storage where required.
    );
    bullet(28, #string,oneline
        \\Builtin `string` values are Glosso descriptors, not `char *`. A C text
        \\parameter normally uses `*const s8`, `[*]const s8`, or another
        \\prototype-matching pointer type.
    );
    bullet(29, #string,oneline
        \\Pointer ownership and nullability are not inferred from the C ABI.
        \\Describe temporal behavior with `#memory` and expose safer Glosso
        \\wrappers where appropriate.
    );
    bullet(30, #string,oneline
        \\The external header remains authoritative. Glosso validates supported
        \\representation categories, but cannot prove that a handwritten
        \\declaration matches a particular C prototype.
    );
}

render_section_81 :: () {
    paragraph(0, #string,oneline
        \\A bare `...` is the C vararg marker. It must be last and must follow
        \\at least one fixed parameter. Use `std/VarArg` to work with vararg
        \\lists.
    );
    code_block(1, "glosso", #string
        \\#import "VarArg";
        \\
        \\libc :: #library "c";
        \\printf :: (fmt: *const s8, ...) -> s32
        \\    #foreign libc "printf";
    );
    paragraph(2, #string,oneline
        \\Prefer typed Glosso variadics for Glosso APIs; reserve C varargs for
        \\foreign compatibility.
    );
    subheading(3, "Ellipsis rules and default promotions");
    paragraph(4, #string,oneline
        \\A bare `...` declares a C ellipsis, not a Glosso rest sequence. It is
        \\allowed on a `#foreign` declaration or a `#c_call` definition and
        \\becomes part of that function or function-pointer type.
    );
    bullet(5, #string,oneline
        \\The marker must be last and must follow at least one fixed parameter.
        \\`(...)` by itself is rejected.
    );
    bullet(6, #string,oneline
        \\Fixed parameters must be concrete runtime parameters; compile-time or
        \\generic fixed parameters are rejected.
    );
    bullet(7, #string,oneline
        \\Operators and expansion procedures cannot be C-variadic. A lambda
        \\cannot initialize a variadic function pointer.
    );
    bullet(8, #string,oneline
        \\For each extra call argument, Glosso applies C default promotions:
        \\`bool`, 8-bit integers, and 16-bit integers become 32-bit integers;
        \\`f16` and `f32` become `f64`.
    );
    table_header(9, "Source argument type   —   Type passed through `...`");
    table_row(10, "`bool`   |   32-bit integer");
    table_row(11, "`s8`, `u8`, `s16`, `u16`   |   32-bit integer");
    table_row(12, "`f16`, `f32`   |   `f64` / C `double`");
    table_row(13, #string,oneline
        \\Other supported scalar, pointer, or aggregate type   |   Its C-ABI
        \\type without a default-promotion change
    );
    code_block(14, "glosso", #string
        \\libc :: #library "c";
        \\printf :: (format: *const s8, ...) -> s32 #foreign libc;
        \\
        \\main :: () {
        \\    fmt := "value=%d ratio=%f\n\0";
        \\    // `small` and `ratio` are promoted before the foreign call.
        \\    small: u8 = 7;
        \\    ratio: f32 = 0.5;
        \\    _ := printf(cast(*const s8) fmt.data, small, ratio);
        \\}
    );
    code_block(15, "text", #string
        \\value=7 ratio=0.500000
    );
    paragraph(16, #string,oneline
        \\`%f` reads a `double` and the call supplies one, because `ratio` was
        \\promoted from `f32`. Passing an unpromoted 32-bit float would read eight
        \\bytes from a four-byte argument slot; the promotion is what makes the
        \\pairing correct.
    );
    code_block(17, "text", #string
        \\error: C vararg marker '...' requires at least one fixed parameter
        \\  --> varargs.glo:2:9
        \\  |
        \\2 | bad :: (...) -> s32 #foreign libc "puts";
        \\  |         ^^^
    );
    paragraph(18, #string,oneline
        \\A Glosso definition that receives C ellipsis arguments uses
        \\`std/VarArg` to start, copy, read, and finish the platform vararg
        \\list. The format string or another fixed discriminator must agree with
        \\the promoted types; neither the callee nor the compiler receives
        \\runtime type tags. Dynamic `#library,dyn` calls through the
        \\compile-time VM do not support C varargs.
    );
}

render_section_82 :: () {
    paragraph(0, #string,oneline
        \\`#asm` emits backend assembly. `#bytes` injects raw bytes. These
        \\features are target-specific and should be hidden behind small
        \\target-gated wrappers.
    );
    code_block(1, "glosso", #string
        \\pause :: () {
        \\    #if OUT.cpu == Target_CPU.X86_64 {
        \\        #asm {
        \\            \\pause
        \\            clobber: .Memory;
        \\        }
        \\    }
        \\}
    );
    paragraph(2, #string,oneline
        \\Structured assembly starts with one or more `\\` instruction lines.
        \\Operands have source-level names used as `{name}` placeholders in
        \\those lines. `in`, `out`, and `inout` state data flow; the compiler
        \\translates Prelude `Asm_Constraint` values such as `.Register`,
        \\`.Byte_Register`, `.Memory`, and `.Immediate` to backend constraints.
        \\`.Early_Clobber` is an optional output flag. `fixed(rax)` selects a
        \\contextual register name validated for the output target. Clobbers use
        \\contextual register names plus `.Memory` or `.Condition_Codes`.
    );
    code_block(3, "glosso", #string
        \\increment :: (value: *s64) {
        \\    current := value.*;
        \\    #asm {
        \\        \\incq {current}
        \\        current: inout(.Register);
        \\        clobber: .Condition_Codes;
        \\    }
        \\    value.* = current;
        \\}
    );
    code_block(4, "glosso", #string
        \\main :: () {
        \\    n: s64 = 41;
        \\    increment(*n);
        \\    print("%\n", n);        // 42
        \\}
    );
    paragraph(5, #string,oneline
        \\Constraint strings, positional operand numbers, and LLVM direction
        \\markers are not needed in structured assembly. Write an ordinary `$`
        \\once; the compiler escapes it for the backend. Use `{{` and `}}` when
        \\the target assembly requires literal braces. The legacy
        \\colon-separated `#asm` form remains accepted for source compatibility.
    );
    subheading(6, "Raw bytes");
    paragraph(7, #string,oneline
        \\`#bytes` takes a compile-time byte array and emits its elements into the
        \\function body at that point. It is not assembled and not validated: the
        \\bytes must already be encoded for the output CPU, and nothing checks
        \\that they preserve the registers the surrounding code expects.
    );
    code_block(8, "glosso", #string
        \\#import "Io";
        \\
        \\NOPS :: .[ 16#90, 16#90, 16#90 ];
        \\
        \\three_nops :: () {
        \\    #bytes NOPS;
        \\}
        \\
        \\main :: () {
        \\    three_nops();
        \\    print("ok\n");
        \\}
    );
    paragraph(9, #string,oneline
        \\Because the encoding is fixed at authoring time, a `#bytes` sequence
        \\belongs inside a `#if OUT.cpu == ...` arm with a `#compile_error` for
        \\the CPUs that have no encoding. That is how the compiler's own
        \\`inline_bytes` example selects among a dozen syscall stubs.
    );
}

render_section_83 :: () {
    paragraph(0, #string,oneline
        \\`#compile_error` fails the build with a compile-time string. `#assert`
        \\states a condition and decides at compile time whether that costs
        \\nothing or becomes a runtime check. `#must`, `#noreturn`, and
        \\`#returns_twice` annotate a function's contract for its callers, and
        \\`#dump` prints its lowered IR.
    );
    code_block(1, "glosso", #string
        \\#import "Meta";
        \\
        \\require_integer :: (T: type) #expand {
        \\    #if !Is_Integer(T) #compile_error "integer type required";
        \\}
        \\
        \\sum :: (a: $T, b: T) -> T {
        \\    require_integer(T);
        \\    return a + b;
        \\}
    );
    paragraph(2, #string,oneline
        \\The `#if` is load-bearing. `#compile_error` is executed when the checker
        \\reaches the statement, not when a runtime branch would take it, so
        \\writing `if` instead of `#if` fails the build for every instantiation
        \\including the valid ones:
    );
    code_block(3, "glosso", #string
        \\require_integer :: (T: type) #expand {
        \\    if !Is_Integer(T) #compile_error "integer type required";
        \\}
        \\
        \\main :: () { print("%\n", sum(1, 2)); }   // T is int, still rejected
    );
    code_block(4, "text", #string
        \\error: integer type required
        \\  --> diag.glo:2:23
        \\  |
        \\2 |     if !Is_Integer(T) #compile_error "integer type required";
        \\  |                       ^^^^^^^^^^^^^^
    );
    subheading(5, "The directive table");
    table_header(6, "Directive   —   Enforced behavior");
    table_row(7, #string,oneline
        \\`#compile_error expression;`   |   Expression must evaluate to a
        \\compile-time string; compilation fails at that statement with the string
        \\as its message
    );
    table_row(8, #string,oneline
        \\`#assert cond;` / `#assert cond, "msg";`   |   Compile-time-known
        \\condition is decided during checking and emits nothing; otherwise it
        \\becomes a runtime check that aborts
    );
    table_row(9, #string,oneline
        \\`#assert #comptime cond;`   |   Forces the compile-time path; a
        \\condition that cannot be evaluated is an error instead of a runtime
        \\check
    );
    table_row(10, #string,oneline
        \\Function `#must`   |   Discarding a call result as an expression
        \\statement is an error; `_ := call();` is an explicit acknowledged
        \\discard
    );
    table_row(11, #string,oneline
        \\Function `#noreturn`   |   The checker rejects an explicit return or a
        \\body that can fall through normally; call sites treat a guaranteed call
        \\as terminating
    );
    table_row(12, #string,oneline
        \\Function `#returns_twice`   |   Marks lowered/LLVM function metadata for
        \\control-flow operations with returns-twice semantics
    );
    table_row(13, #string,oneline
        \\Function `#dump`   |   Prints that function's lowered typed IR during
        \\compilation
    );
    subheading(14, "`#assert` chooses its own phase");
    paragraph(15, #string,oneline
        \\`#assert` runs the same constant evaluation the checker uses for `::`
        \\bindings. When the condition folds to a constant, the assertion is
        \\settled during checking: a true condition emits no branch, no string,
        \\and no call, and a false one is a build error headed `assertion failed:
        \\<message>`. When it does not fold, lowering emits a branch around an
        \\abort. Which binding form introduced the value therefore decides the
        \\phase:
    );
    code_block(16, "glosso", #string
        \\limit :: () -> s64 { return 3; }
        \\
        \\main :: () {
        \\    n :: limit();                          // '::' folds
        \\    #assert n > 100, "limit must exceed 100";
        \\}
    );
    code_block(17, "text", #string
        \\error: assertion failed: limit must exceed 100
        \\  --> diag.glo:5:5
        \\  |
        \\5 |     #assert n > 100, "limit must exceed 100";
        \\  |     ^^^^^^^
    );
    paragraph(18, #string,oneline
        \\Writing `n := limit();` instead compiles, and the same assertion becomes
        \\a runtime abort. The failure writes `<source path>:<line>:<col>:
        \\assertion failed: <message>` to stderr and terminates with status 134.
        \\No `defer` runs — not in the asserting frame and not in any caller — and
        \\optimization does not remove the check:
    );
    code_block(19, "glosso", #string
        \\#import "Io";
        \\
        \\sum_all :: (values: []s64) -> s64 {
        \\    #assert values.count > 0, "sum_all needs at least one value";
        \\    total := 0;
        \\    for values total = total + it;
        \\    return total;
        \\}
        \\
        \\main :: () {
        \\    defer print("never printed\n");
        \\    empty: [0]s64 = .[];
        \\    print("%\n", sum_all(empty[..]));
        \\}
    );
    code_block(20, "text", #string
        \\...\assert.glo:4:5: assertion failed: sum_all needs at least one value
        \\(exit status 134)
    );
    paragraph(21, #string,oneline
        \\`#assert #comptime cond` refuses the runtime fallback. If the condition
        \\cannot be folded the build stops with `#assert #comptime condition is
        \\not compile-time evaluable` plus a note carrying the underlying
        \\evaluation failure — for a procedure parameter, `note: unknown const
        \\<name>`. There is no `#static_assert`, and there is no switch that
        \\removes runtime assertions: `#disable(assert);` is `error: unknown
        \\feature 'assert'`, since the only feature names are `lossy_numerics`,
        \\`pointer_punning`, `union_unwrap`, and `private_section`. _Assertions
        \\with `#assert`_ covers the message rules and the `#meaningful`
        \\interaction.
    );
    subheading(22, "`#must` and `#noreturn`");
    code_block(23, "glosso", #string
        \\#import "Io";
        \\
        \\open_handle :: () -> s64 #must { return 7; }
        \\
        \\stop :: (message: string) #noreturn {
        \\    print("%\n", message);
        \\}
        \\
        \\main :: () {
        \\    open_handle();
        \\}
    );
    code_block(24, "text", #string
        \\error: #noreturn function 'stop' can return normally
        \\  --> diag.glo:5:1
        \\  |
        \\5 | stop :: (message: string) #noreturn {
        \\  | ^^^^
        \\
        \\error: discarded return value of #must function 'open_handle'
        \\   --> diag.glo:10:5
        \\   |
        \\10 |     open_handle();
        \\   |     ^^^^^^^^^^^
        \\help: bind it explicitly, for example `_ := open_handle(...);`, if discarding is intentional
        \\
        \\error: aborting due to 2 previous errors
    );
    paragraph(25, #string,oneline
        \\`_ := open_handle();` satisfies `#must`, and adding `exit(1);` to
        \\`stop`'s body satisfies `#noreturn`. The `#noreturn` check is on the
        \\definition, so the contract is verified once rather than at every call
        \\site; call sites then treat a guaranteed call as terminating and stop
        \\requiring a following `return`.
    );
}

render_section_84 :: () {
    paragraph(0, #string,oneline
        \\The prelude target enums let code choose implementations at compile
        \\time.
    );
    code_block(1, "glosso", #string
        \\separator :: () -> string {
        \\    #if OUT.os == Target_OS.Windows {
        \\        return "\\";
        \\    } else {
        \\        return "/";
        \\    }
        \\}
    );
    paragraph(2, #string,oneline
        \\`#if` deletes the branch it does not take before checking, so the
        \\discarded arm never has to link. That is why a gate should surround the
        \\smallest target-specific implementation and leave a portable wrapper
        \\around it: only the selected arm's foreign declarations become link
        \\inputs.
    );
    subheading(3, "The constants");
    table_header(4, "Constant   —   Contents");
    table_row(5, #string,oneline
        \\`OUT: Output_Target`   |   Selected output `os: Target_OS`, `cpu:
        \\Target_CPU`, and `abi: Target_ABI`; changes with `--target`
    );
    table_row(6, #string,oneline
        \\`HOST: Host_Target`   |   Compiler host `os` and `cpu` only — there is
        \\no `abi` field; it does not change when the output is cross-compiled
    );
    table_row(7, #string,oneline
        \\`target_endian()`   |   Prelude helper returning `Target_Endian.Little`
        \\or `Target_Endian.Big`, derived from `OUT.cpu`
    );
    paragraph(8, #string,oneline
        \\`Target_Endian` has exactly the two members `Little` and `Big`.
        \\`target_endian()` is an ordinary `#if` over `OUT.cpu` that answers `Big`
        \\for `Powerpc`, `Powerpc64`, `S390x`, `Mips`, and `Mips64`, and `Little`
        \\otherwise, so it is usable in a compile-time condition:
    );
    code_block(9, "glosso", #string
        \\byte_order :: () -> string {
        \\    #if target_endian() == Target_Endian.Big return "big";
        \\    else return "little";
        \\}
    );
    subheading(10, "Which `--target` string produces which enum values");
    paragraph(11, #string,oneline
        \\A gate compares enum values, not the spelling passed on the command
        \\line. These are the mappings a portable program is most likely to gate
        \\on:
    );
    table_header(12, #string,oneline
        \\`--target`   —   `OUT.os`   —   `OUT.cpu`   —   `OUT.abi`
    );
    table_row(13, #string,oneline
        \\host default   |   `.Windows` / `.Linux` / `.Macos`   |   host CPU   |
        \\  host ABI
    );
    table_row(14, #string,oneline
        \\`linux-x86_64-gnu`   |   `.Linux`   |   `.X86_64`   |   `.Gnu`
    );
    table_row(15, #string,oneline
        \\`wasm32-wasi`   |   `.Wasm`   |   `.Wasm32`   |   `.Wasi`
    );
    table_row(16, #string,oneline
        \\`wasm32-freestanding`   |   `.Wasm`   |   `.Wasm32`   |
        \\  `.Freestanding`
    );
    table_row(17, #string,oneline
        \\`x86_64-freestanding`   |   `.Freestanding`   |   `.X86_64`   |
        \\  `.Freestanding`
    );
    table_row(18, #string,oneline
        \\`x86_64-freestanding-uefi`   |   `.Freestanding`   |   `.X86_64`   |
        \\  `.Uefi`
    );
    table_row(19, #string,oneline
        \\`x86_64-freestanding-msvc`   |   `.Freestanding`   |   `.X86_64`   |
        \\  `.Msvc`
    );
    paragraph(20, #string,oneline
        \\The last two rows are the trap. `x86_64-freestanding-msvc` is a legacy
        \\alias that produces the same LLVM triple and the same Microsoft x64 C
        \\ABI as `x86_64-freestanding-uefi`, but it reports `Target_ABI.Msvc`, so
        \\`#if OUT.abi == Target_ABI.Uefi` does not fire for it. Note also that
        \\`OUT.os` stays `Target_OS.Freestanding` on UEFI: the C record and
        \\aggregate-passing rules come from `OUT.abi`, never from the OS field.
        \\_Bare-Metal and Freestanding Targets_ has the full `--target` grammar,
        \\the recognized CPU and OS names, and the runtime differences on those
        \\targets.
    );
    paragraph(21, #string,oneline
        \\Use `OUT` for every decision about emitted code and `HOST` only for
        \\compile-time tooling that executes on the build machine. The two agree
        \\on a native build, which is exactly why the confusion survives until
        \\someone cross-compiles.
    );
    paragraph(22, #string,oneline
        \\`#if` is a statement directive: it lives inside a procedure body, not at
        \\file scope. Its switch form gates several targets at once, and an `else`
        \\arm gives an unsupported target an explicit diagnostic instead of a link
        \\error from a branch that was never intended for it:
    );
    code_block(23, "glosso", #string
        \\platform_name :: () -> string {
        \\    #if OUT.os == {
        \\    case .Windows; #falling;
        \\    case .Linux;   return "desktop";
        \\    case .Wasm;    return "wasm";
        \\    else;          #compile_error "no platform layer for this target";
        \\    }
        \\}
    );
    code_block(24, "text", #string
        \\$ glosso app.glo --target x86_64-freestanding --backend object -o app.obj
        \\error: no platform layer for this target
        \\  --> app.glo:6:20
        \\  |
        \\6 |     else;          #compile_error "no platform layer for this target";
        \\  |                    ^^^^^^^^^^^^^^
    );
}

render_section_85 :: () {
    paragraph(0, #string,oneline
        \\`std/Compiler` lets compile-time code create workspaces, add files or
        \\strings, set options, and invoke the compiler. Every entry point is a
        \\service of the compiler that is currently running, reached from a
        \\`#comptime` block; none of it exists at run time.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\#comptime {
        \\    options: Compile_Options;
        \\    set_backend(*options, Compiler_Backend.Object);
        \\    set_target(*options, Output_Target.{
        \\        .os = Target_OS.Freestanding,
        \\        .cpu = Target_CPU.X86_64,
        \\        .abi = Target_ABI.Uefi,
        \\    });
        \\    set_optimization_level(*options, Optimization.Optimized_Tiny);
        \\    set_no_main(*options);
        \\    built := compile("firmware.glo", "firmware.obj", options);
        \\    if built == {
        \\    case .Ok(log);    print("wrote firmware.obj\n");
        \\    case .Err(error); print("failed (%): %\n", error.status, error.message);
        \\    }
        \\}
        \\
        \\main :: () {}
    );
    code_block(2, "text", #string
        \\wrote firmware.obj
    );
    paragraph(3, #string,oneline
        \\That is a complete UEFI build driver. `set_no_main` maps the nested
        \\compilation to the compiler's `--no-main` mode, so reachability starts
        \\at the defined `#c_call` exports and no hosted `main(argc, argv)` or
        \\WASI `_start` wrapper is synthesized. `set_target` takes an
        \\`Output_Target` struct with typed `os`, `cpu`, and `abi` fields — never
        \\an encoded target string. The final PE image is produced by an external
        \\linker; see _Bare-Metal and Freestanding Targets_.
    );
    subheading(4, "Every operation returns a `Result`");
    paragraph(5, #string,oneline
        \\`run_command`, `add_build_file`, `add_build_string`, `compile_args`, and
        \\`compile` return `Result(string, Compiler_Error)`; `compile_c_archive`
        \\returns `Result(Native_Compile_Output, Compiler_Error)`.
        \\`Compiler_Error` is `struct { status: s64 = 1; message: string = ""; }`
        \\and has an `Error` instance, so `report_error` prints it and `?` can
        \\propagate it. Test the result with a switch, with `result_is_ok` /
        \\`result_is_err`, or with `?`:
    );
    code_block(6, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\#comptime {
        \\    built := compile("no_such_file.glo", "out.obj");
        \\    if result_is_err(built) {
        \\        print("status %\n", built.Err.status);
        \\        report_error(built.Err);
        \\    }
        \\    ran := run_command("cmd /c echo hi");
        \\    if result_is_ok(ran) print("ran [%]\n", ran.Ok);
        \\}
        \\
        \\main :: () {}
    );
    code_block(7, "text", #string
        \\status 1
        \\compiler error: glosso: cannot read no_such_file.glo
        \\ran [hi
        \\]
    );
    paragraph(8, #string,oneline
        \\The old service records are no longer part of the API. `Compiler_Result`
        \\and `Native_Compile_Result` still carry the compile-time VM's wire
        \\format, but they live inside a `#enable(private_section)` region of
        \\`std/Compiler.glo` and cannot be named or field-accessed from user code:
    );
    code_block(9, "text", #string
        \\error: unknown type 'Compiler_Result'
        \\  --> build.glo:4:8
        \\  |
        \\4 |     r: Compiler_Result;
        \\  |        ^^^^^^^^^^^^^^^
        \\
        \\error: no union field ok
        \\  --> build.glo:5:17
        \\  |
        \\5 |     if !outcome.ok return;
        \\  |                 ^^
    );
    subheading(10, "Entry points");
    table_header(11, "Operation   —   Signature and effect");
    table_row(12, #string,oneline
        \\`compile(source, output, options := .{})`   |   One-shot nested
        \\compilation; returns `Result(string, Compiler_Error)` whose `Ok` payload
        \\is the captured compiler output
    );
    table_row(13, #string,oneline
        \\`compile_args(source, output, args)`   |   Same, but driven by raw
        \\command-line arguments instead of a `Compile_Options` value
    );
    table_row(14, #string,oneline
        \\`compiler_create_workspace(name := "")`   |   Returns a `Workspace`
        \\handle (an `s64`); `-1` names the current compilation
    );
    table_row(15, #string,oneline
        \\`add_build_file(path, workspace := -1)` / `add_build_string(source,
        \\workspace := -1)`   |   Accumulate source inputs under a workspace
    );
    table_row(16, #string,oneline
        \\`get_build_options(workspace := -1)` / `set_build_options(options,
        \\workspace := -1)`   |   Read and replace a workspace's `Build_Options`
    );
    table_row(17, #string,oneline
        \\`set_build_options_dc(do_output := true, write_added_strings := true)`
        \\  |   Shorthand for those two flags alone;
        \\`set_build_options_dc(.do_output = false)` is how a build driver
        \\suppresses its own output
    );
    table_row(18, #string,oneline
        \\`compile_c_archive(name, sources, options := .{})`   |   Compiles
        \\target-aware C sources into a cached native archive; `Ok` carries
        \\`Native_Compile_Output { output; artifact; }`
    );
    table_row(19, #string,oneline
        \\`find_header`, `find_library`, `find_resource`, `executable_path`   |
        \\  Locate compiler and bundle resources; each returns a plain `string`
    );
    table_row(20, #string,oneline
        \\`add_current_linker_arg(arg)`   |   Adds one raw argument to the final
        \\link of the program currently being compiled
    );
    table_row(21, #string,oneline
        \\`run_command(command)`   |   Executes a host command at compile time and
        \\captures its output
    );
    subheading(22, "Options and setters");
    paragraph(23, #string,oneline
        \\`Compile_Options` configures a one-shot compile: `backend`, `target`,
        \\`optimization_level`, `compiler_args`, `linker_args`,
        \\`memory_sanitizer`, `thread_sanitizer`, `borrow_check`, `color`,
        \\`temp_allocator_size`, and `no_main`. `Build_Options` adds
        \\`output_type`, `output_executable_name`, `output_path`,
        \\`intermediate_path`, `import_path`, `compile_time_command_line`,
        \\`do_output`, `write_added_strings`, and `text_output_flags`, but has no
        \\`color` field.
        \\`C_Compile_Options` carries `include_paths`,
        \\`preprocessor_definitions`, `compiler_args`, `optimization_level`
        \\(defaulting to `Optimization.Optimized`), and `position_independent`.
    );
    table_header(24, "Struct   —   Setters");
    table_row(25, #string,oneline
        \\`Compile_Options`   |   `set_backend`, `set_target`,
        \\`set_optimization_level`, `set_memory_sanitizer`,
        \\`set_thread_sanitizer`, `set_borrow_check`, `set_color`,
        \\`set_temp_allocator_size`,
        \\`set_no_main`, `add_compiler_arg`, `add_linker_arg`
    );
    table_row(26, #string,oneline
        \\`Build_Options`   |   `set_build_backend`, `set_build_optimization`,
        \\`set_build_memory_sanitizer`, `set_build_thread_sanitizer`,
        \\`set_build_borrow_check`, `set_build_temp_allocator_size`,
        \\`set_build_no_main`, `add_build_compiler_arg`, `add_build_linker_arg`,
        \\`add_build_linker_args` (variadic)
    );
    table_row(27, #string,oneline
        \\`C_Compile_Options`   |   `add_c_include_path`,
        \\`add_c_preprocessor_definition`, `add_c_compiler_arg`
    );
    paragraph(28, #string,oneline
        \\`Build_Options` has no `set_build_target`: a workspace inherits the
        \\driver's own target. Every setter takes a pointer to the options value,
        \\and enum arguments accept the leading-dot shorthand.
    );
    subheading(29, "The enums");
    code_block(30, "glosso", #string
        \\Compiler_Backend :: enum {
        \\    Default; LLVM; Object; LLVM_IR; X64; Static_Lib; Shared_Lib;
        \\}
        \\
        \\Build_Output_Type :: enum {
        \\    No_Output; Executable; Object_File; LLVM_IR;
        \\    Static_Library; Shared_Library;
        \\}
        \\
        \\Optimization :: enum {
        \\    // These values are part of the compile-time compiler-service ABI.
        \\    Debug                :: 0;
        \\    Very_Debug           :: 1;
        \\    Optimized            :: 2;
        \\    Very_Optimized       :: 3;
        \\    Optimized_Small      :: 4;
        \\    Optimized_Very_Small :: 5;
        \\    Optimized_Tiny       :: 6;
        \\    Default              :: 7;
        \\}
        \\
        \\Compiler_Color        :: enum { Auto; Always; Never; }
        \\Compiler_Borrow_Check :: enum { Off; Warning; Error; }
        \\
        \\DEFAULT_TEMP_ALLOCATOR_SIZE :: 4 * 1024 * 1024;
    );
    paragraph(31, #string,oneline
        \\`Optimization`'s members carry explicit `::` values because the numbers
        \\cross the compile-time service boundary; reordering them would silently
        \\change the meaning of an existing build script. `optimization_level`
        \\on all three option structs is typed `Optimization`, not `s64`.
        \\`Build_Output_Type`'s members are Title_Case — the old
        \\SCREAMING_CASE spellings no longer exist — and `Compiler_Backend.X64`
        \\has no `--backend` spelling on the command line.
    );
    paragraph(32, #string,oneline
        \\Two renames are worth knowing because the compiler suggests the fix:
        \\`set_build_optimization_level` is now `set_build_optimization`, and
        \\`set_optimization(options, Optimization_Type, runtime_checks)` was
        \\removed outright.
    );
    code_block(33, "text", #string
        \\error: unknown function set_build_optimization_level
        \\  --> build.glo:5:5
        \\  |
        \\5 |     set_build_optimization_level(*opts, 2);
        \\  |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
        \\help: did you mean 'set_build_optimization'?
    );
    note(34, #string,oneline
        \\These are compile-time compiler services, not runtime subprocess APIs. A
        \\build driver's own work participates in the build: derive outputs from
        \\explicit source and option inputs, write generated files to predictable
        \\build-owned locations, and keep timestamps and undeclared environment
        \\reads out of the inputs unless they are deliberately part of the build
        \\key. Report a failure with `report_error(result.Err)` or with
        \\`error.message`, which carries the nested compiler's own diagnostic text
        \\rather than only an exit number.
    );
}

render_section_86 :: () {
    paragraph(0, #string,oneline
        \\The opt-in `Lua` module exposes Lua 5.5.0's C API. Importing it
        \\locates the vendored source tree, compiles Lua's 32 library
        \\translation units for `OUT`, caches a static archive, generates
        \\target-aware declarations from `lua.h`, `lauxlib.h`, and `lualib.h`,
        \\and adds the archive to the current link. It excludes the `lua` and
        \\`luac` command-line translation units. A program that never imports
        \\`Lua` performs none of this work.
    );
    code_block(1, "glosso", #string
        \\#import "Lua";
        \\
        \\main :: () {
        \\    L := luaL_newstate();
        \\    if L == null return;
        \\    luaL_openlibs(L);
        \\    status := luaL_dostring(L, "value = 40 + 2");
        \\    if status == LUA_OK {
        \\        _ := lua_getglobal(L, "value");
        \\        value := lua_tointeger(L, -1);
        \\        lua_pop(L, 1);
        \\    }
        \\    lua_close(L);
        \\}
    );
    paragraph(2, #string,oneline
        \\Static source linkage is the default because it naturally follows the
        \\output architecture and avoids shipping a matrix of prebuilt binaries.
        \\Host-architecture Windows MSVC and Linux are supported, as are
        \\cross-architecture Linux musl bundles; POSIX builds add `libm` but do
        \\not silently enable `dlopen`, so Lua source modules are unaffected.
        \\Targets without a coherent C runtime/sysroot are rejected instead of
        \\compiling against host headers accidentally. The source is read from
        \\`thirdparty/lua` in a checkout and from `lib/lua` in installed or
        \\published bundles.
    );
    paragraph(3, #string,oneline
        \\Applications that intentionally ship a matching Lua 5.5 shared library
        \\can create their own bindings module with the side-effect-free
        \\`Lua_Build` helper:
    );
    code_block(4, "glosso", #string
        \\Lua_Build :: #import "Lua/Build";
        \\#insert Lua_Build.dynamic_bindings_source("/path/to/liblua5.5.so");
    );
    paragraph(5, #string,oneline
        \\This produces the same declarations and macro conveniences as `#import
        \\"Lua"`; the application owns the shared library's path and deployment.
        \\Dynamic mode is limited to host-architecture Windows MSVC and
        \\dynamically linked Linux outputs; WASI, static musl, and unsupported
        \\cross-host loaders are rejected. Do not combine the bundled 5.5.0
        \\headers with a 5.4 library or a library built with incompatible
        \\number, integer, calling-convention, or CRT options.
    );
}

render_section_87 :: () {
    paragraph(0, #string,oneline
        \\Prefer explicit overflow operators when overflow behavior matters.
        \\Prefer `where` constraints over letting generic bodies fail far from
        \\the call site. Keep `#expand` macros small and emit understandable
        \\code. Wrap low-level interop behind narrow APIs. Free dynamic arrays
        \\that own storage, and distinguish array views from owners in API names
        \\and comments.
    );
    subheading(1, "Public surface and internal conventions");
    paragraph(2, #string,oneline
        \\Glosso style aims to make ownership, compile-time behavior, and public
        \\surface visible without depending on compiler-enforced privacy.
        \\Consistency matters most at module boundaries, where names and
        \\signatures become navigation for other programmers.
    );
    bullet(3, #string,oneline
        \\Use clear public names and reserve a leading `__` for functions and
        \\constants intended as implementation details; the prefix is a
        \\convention and does not enforce privacy.
    );
    bullet(4, #string,oneline
        \\Place `__` functions and constants after the public declarations of
        \\the same category so the supported surface appears first.
    );
    bullet(5, #string,oneline
        \\Use private sections when access must be enforced, and the `__`
        \\convention when signaling internal intent is sufficient.
    );
    paragraph(6, #string,oneline
        \\`#enable(private_section);` is the enforced form. Every declaration
        \\after it in that file is invisible to other files while remaining usable
        \\within its own; `#disable(private_section);` ends the region.
        \\`#enable(private_section, siblings);` additionally keeps the region
        \\visible to the other files of the same module, which is how the standard
        \\library shares helpers across a multi-file module without exporting
        \\them. The plural spelling `private_sections` is accepted for both.
    );
    code_block(7, "glosso", #string
        \\// widget.glo
        \\make_widget :: () -> s64 { return __seed() * 2; }
        \\
        \\#enable(private_section);
        \\
        \\__seed :: () -> s64 { return 21; }
    );
    code_block(8, "glosso", #string
        \\// main.glo
        \\#import "Io";
        \\#load "widget.glo";
        \\
        \\main :: () {
        \\    print("%\n", make_widget());   // 42
        \\    print("%\n", __seed());
        \\}
    );
    code_block(9, "text", #string
        \\error: unknown function __seed
        \\  --> main.glo:7:18
        \\  |
        \\7 |     print("%\n", __seed());
        \\  |                  ^^^^^^
        \\help: did you mean 'seek'?
    );
    paragraph(10, #string,oneline
        \\The `__` prefix on its own carries no enforcement — `__seed` above is
        \\hidden by the section, not by its name. Choose one and be consistent
        \\within a module: a `__` name outside a private section is a request, and
        \\a private section makes it a rule. `std/Compiler` uses the enforced form
        \\so its compile-time service records cannot be depended on.
    );
    bullet(11, #string,oneline
        \\Prefer explicit width, ownership, and borrowing information at APIs,
        \\even when local inference could shorten the spelling.
    );
    bullet(12, #string,oneline
        \\Keep compile-time metaprogramming behind ordinary typed interfaces and
        \\document generated behavior that is not evident at the call site.
    );
}

render_section_96 :: () {
    paragraph(0, #string,oneline
        \\`#assert` states a condition that must hold. It is a single directive
        \\rather than a compile-time form plus a run-time form: the compiler
        \\decides which path an individual assertion takes by asking whether its
        \\condition can be evaluated during checking.
    );
    code_block(1, "glosso", #string
        \\#import "Io";
        \\
        \\clamp_index :: (i: s64, count: s64) -> s64 {
        \\    #assert count > 0, "clamp_index needs a non-empty range";
        \\    if i < 0 return 0;
        \\    if i >= count return count - 1;
        \\    return i;
        \\}
        \\
        \\MAX :: 64;
        \\
        \\main :: () {
        \\    #assert MAX % 8 == 0, "MAX must be a multiple of 8";
        \\    #assert #comptime MAX > 0;
        \\    print("%\n", clamp_index(99, MAX));
        \\}
    );
    paragraph(2, #string,oneline
        \\The checker evaluates the condition with the same constant evaluator
        \\that folds `::` bindings. `count > 0` inside `clamp_index` mentions a
        \\parameter and cannot fold, so it becomes a run-time check. `MAX % 8 ==
        \\0` folds to `true` during checking, so it disappears entirely.
    );
    table_header(3, "Condition at check time   —   What the compiler does");
    table_row(4, #string,oneline
        \\Folds to `true`   |   The statement is marked compile-time true and
        \\lowering returns immediately: no branch, no message string, and no
        \\call are emitted
    );
    table_row(5, #string,oneline
        \\Folds to `false`   |   Compilation fails at the `#assert` with
        \\`assertion failed: <message>`, or exactly `assertion failed` when no
        \\message was given
    );
    table_row(6, #string,oneline
        \\Does not fold   |   Lowering emits a conditional branch around the
        \\assertion-failure path, entered only when the condition is false while
        \\the program runs
    );
    table_row(7, #string,oneline
        \\Does not fold, and `#comptime` was written   |   Compilation fails
        \\with `#assert #comptime condition is not compile-time evaluable` plus
        \\a note carrying the evaluator's own reason
    );
    paragraph(8, #string,oneline
        \\"Emits nothing" is literal. Compiling a body whose only statement is
        \\`#assert 1 + 1 == 2, "never emitted";` with `--backend llvm-ir -O0`
        \\produces a function containing only the temporary-allocator mark and
        \\restore pair and a return; the module contains no `assertion failed`
        \\string constant at all.
    );
    subheading(9, "What counts as compile-time known");
    paragraph(10, #string,oneline
        \\Classification is automatic and follows constant evaluation exactly.
        \\The single most surprising consequence is that `:=` and `::` decide
        \\whether the same assertion is a build failure or a run-time panic. A
        \\`::` binding whose initializer is evaluable is folded, so an assertion
        \\about it is decided during compilation.
    );
    code_block(11, "glosso", #string
        \\limit :: () -> s64 { return 3; }
        \\
        \\main :: () {
        \\    n :: limit();
        \\    #assert n > 100, "limit must exceed 100";
        \\}
    );
    code_block(12, "text", #string
        \\error: assertion failed: limit must exceed 100
        \\  --> limits.glo:5:5
        \\  |
        \\5 |     #assert n > 100, "limit must exceed 100";
        \\  |     ^^^^^^^
    );
    paragraph(13, #string,oneline
        \\Changing `n :: limit();` to `n := limit();` makes the same program
        \\compile: the local is no longer a constant, so the assertion lowers to
        \\a run-time check and the executable aborts with the same message. A
        \\procedure parameter is never compile-time known inside the body. A
        \\mixed condition such as `addable(s64) && n > 0` is run-time as a
        \\whole, because one operand fails to fold even though the other is a
        \\constant.
    );
    note(14, #string,oneline
        \\The primary span always underlines the `#assert` keyword, not the
        \\condition, so the reported column is the directive's column. Only the
        \\notes attached to a failure point into the condition.
    );
    subheading(15, "The run-time check");
    paragraph(16, #string,oneline
        \\A run-time assertion lowers to a branch that skips the failure path
        \\when the condition holds. The failure path receives one baked string of
        \\the form `<absolute source path>:<line>:<column>: assertion failed[:
        \\<message>]` followed by a newline, writes it directly to standard
        \\error, and then takes the process-abort termination path.
    );
    code_block(17, "glosso", #string
        \\#import "Io";
        \\
        \\sum_all :: (values: []s64) -> s64 {
        \\    #assert values.count > 0, "sum_all needs at least one value";
        \\    total := 0;
        \\    for values total = total + it;
        \\    return total;
        \\}
        \\
        \\main :: () {
        \\    values: [3]s64 = .[1, 2, 3];
        \\    print("sum = %\n", sum_all(values[..]));
        \\    empty: [0]s64 = .[];
        \\    print("sum2 = %\n", sum_all(empty[..]));
        \\}
    );
    code_block(18, "text", #string
        \\sum = 6
        \\C:\work\sums.glo:4:5: assertion failed: sum_all needs at least one value
        \\
        \\# exit status 134
    );
    paragraph(19, #string,oneline
        \\Three properties of that output matter. The message is copied
        \\literally: a `%` in it is not an interpolation placeholder, because no
        \\formatting call is involved. `defer` statements do not run, neither in
        \\the asserting frame nor in any caller, because the abort path is taken
        \\directly rather than by unwinding. The path is the absolute path of the
        \\source file on the build machine, so it is baked into the shipped
        \\binary. Inside an `#expand` body the location reported is the `#assert`
        \\line in the macro, not the call site.
    );
    note(20, #string,oneline
        \\Run-time assertions cannot be turned off. They are not stripped by
        \\optimization—the same panic occurs at `-O3`—and there is no feature
        \\gate for them: `#disable(assert);` fails with `error: unknown feature
        \\'assert'`, since the only recognized features are `lossy_numerics`,
        \\`pointer_punning`, `union_unwrap`, and `private_section`. Reserve
        \\`#assert` for invariants whose violation should stop the process.
    );
    subheading(21, "Forcing the compile-time path");
    paragraph(22, #string,oneline
        \\Writing `#comptime` immediately after `#assert` demands that the
        \\condition be decided during compilation. The token must be adjacent;
        \\the parser checks for it as soon as it has consumed the directive. A
        \\true value emits nothing and a false value produces the ordinary
        \\`assertion failed` error, but a condition that cannot be evaluated is
        \\now itself an error instead of silently becoming a run-time check.
    );
    code_block(23, "glosso", #string
        \\check :: (n: s64) {
        \\    #assert #comptime n > 0, "must be positive";
        \\}
        \\
        \\main :: () {
        \\    check(5);
        \\}
    );
    code_block(24, "text", #string
        \\error: #assert #comptime condition is not compile-time evaluable
        \\  --> forced.glo:2:5
        \\  |
        \\2 |     #assert #comptime n > 0, "must be positive";
        \\  |     ^^^^^^^
        \\note: unknown const n
        \\  --> forced.glo:2:23
        \\  |
        \\2 |     #assert #comptime n > 0, "must be positive";
        \\  |                       ^
    );
    paragraph(25, #string,oneline
        \\The note is the constant evaluator's own failure, so its wording varies
        \\with the cause; `unknown const <name>` is what an ordinary run-time
        \\local or parameter produces. `#comptime` composes with a structural
        \\probe, so `#assert #comptime #meaningful { ... }, "msg";` is accepted
        \\and still prints the probe notes described below. There is no separate
        \\`#static_assert` directive, and none is needed: the compiler already
        \\knows whether an expression is compile-time evaluable, by exactly the
        \\rule that governs `::` bindings, so a second directive would only
        \\restate what `#assert #comptime` already spells out.
    );
    code_block(26, "text", #string
        \\error: unexpected directive 'static_assert'
        \\  --> probe.glo:2:5
        \\  |
        \\2 |     #static_assert 1 + 1 == 2;
        \\  |     ^^^^^^^^^^^^^^
    );
    subheading(27, "Message and condition rules");
    paragraph(28, #string,oneline
        \\At most one message may follow a single comma. It is evaluated in the
        \\compile-time environment and must produce a string value, so any
        \\compile-time string expression works, including concatenation of
        \\constants. The resolved text is stored on the statement and used by
        \\both the compile-time headline and the baked run-time string.
    );
    code_block(29, "glosso", #string
        \\NAME :: "widget";
        \\main :: () {
        \\    #assert 1 == 2, "bad " + NAME;
        \\}
        \\// error: assertion failed: bad widget
    );
    paragraph(30, #string,oneline
        \\The condition is checked by coercing it to `bool`, so a non-boolean
        \\condition surfaces as the ordinary coercion diagnostic rather than as a
        \\message mentioning `#assert`. The span of that diagnostic points at the
        \\offending expression.
    );
    table_header(31, "Rejected form   —   Diagnostic");
    table_row(32, #string,oneline
        \\`#assert n > 0, why;` where `why: string` is a parameter   |   `error:
        \\unknown const why`—the raw evaluation failure, because a run-time
        \\string cannot be a message
    );
    table_row(33, #string,oneline
        \\`#assert 1 == 1, 42;`   |   `error: #assert message must be a
        \\compile-time string`, with the span on the `42`
    );
    table_row(34, #string,oneline
        \\`#assert 1 == 1, "a", "b";`   |   `error: unexpected token ','`
    );
    table_row(35, "`#assert;`   |   `error: unexpected token ';'`");
    table_row(36, #string,oneline
        \\`#assert 1 + 1, "not a bool";`   |   `error: got int, expected bool`,
        \\with the span on the `+`
    );
    table_row(37, #string,oneline
        \\`#assert SIZE % 2 == 0;` at file scope   |   `error: bad decl name
        \\'assert'`
    );
    subheading(38, "Where `#assert` may appear");
    paragraph(39, #string,oneline
        \\`#assert` is a statement-only directive. It is valid in procedure
        \\bodies, `#expand` bodies, loop and conditional bodies, `#comptime`
        \\blocks, and taken `#if` branches. It is not a declaration, so file
        \\scope rejects it as a malformed declaration name.
    );
    code_block(40, "glosso", #string
        \\#import "Io";
        \\DEBUG :: false;
        \\main :: () {
        \\    #if DEBUG {
        \\        #assert 1 == 2, "should never be reported";
        \\    }
        \\    for i: 0..2 { #assert i >= 0, "index non-negative"; }
        \\    if true { #assert 1 == 1; }
        \\    #comptime { #assert 1 + 1 == 2, "inside comptime"; }
        \\    #assert #comptime 2 * 3 == 6, "arithmetic"
        \\    print("ok\n");
        \\}
    );
    note(41, #string,oneline
        \\That program prints `ok`. The false assertion in the untaken `#if`
        \\branch is never reported because an untaken branch is never checked,
        \\which makes `#if` the way to write assertions that only exist in some
        \\configurations. The trailing semicolon is optional, as the
        \\`#assert #comptime 2 * 3 == 6, "arithmetic"` line shows.
    );
    subheading(42, "Structural constraints and probe diagnostics");
    paragraph(43, #string,oneline
        \\A condition may contain a `#meaningful` probe, which reports whether a
        \\block of statements would typecheck. Combining the two states a
        \\structural requirement and turns a violation into a build failure that
        \\names both the requirement and the reason it is unmet. The probe's own
        \\rules are covered by Structural Constraints with `#meaningful`.
    );
    code_block(44, "glosso", #string
        \\Vec :: struct { x: s64; y: s64; }
        \\
        \\supported :: (T: type) -> bool {
        \\    return #meaningful { p, q: T; p + q; };
        \\}
        \\
        \\main :: () {
        \\    #assert supported(Vec), "Vec must support +";
        \\}
    );
    code_block(45, "text", #string
        \\error: assertion failed: Vec must support +
        \\  --> vec.glo:8:5
        \\  |
        \\8 |     #assert supported(Vec), "Vec must support +";
        \\  |     ^^^^^^^
        \\note: constraint is not meaningful for these types
        \\note: no operator '+' for Vec, Vec
        \\  --> vec.glo:4:37
        \\  |
        \\4 |     return #meaningful { p, q: T; p + q; };
        \\  |                                     ^
    );
    paragraph(46, #string,oneline
        \\When a failed assertion's condition contained a failed probe, exactly
        \\two notes are appended: a fixed `constraint is not meaningful for these
        \\types`, then the checker's own inner error with the span of the probe
        \\statement that did not typecheck. That second note carries a source
        \\location only when the probe lives inside a named predicate procedure.
        \\Written inline in the assertion it is bare text, because the cloned
        \\probe body has no span the diagnostic can point at.
    );
    code_block(47, "text", #string
        \\// #assert #meaningful { p, q: Vec; p + q; }, "Vec must support +";
        \\error: assertion failed: Vec must support +
        \\  --> inline.glo:4:5
        \\  |
        \\4 |     #assert #meaningful { p, q: Vec; p + q; }, "Vec must support +";
        \\  |     ^^^^^^^
        \\note: constraint is not meaningful for these types
        \\note: no operator '+' for Vec, Vec
    );
    paragraph(48, #string,oneline
        \\Probe failure reasons nest correctly. Evaluating a probe saves any
        \\enclosing failure reason and restores it when an inner probe succeeds,
        \\so an inner success cannot erase an outer reason and an inner failure
        \\cannot overwrite one. An outer probe that runs a succeeding inner probe
        \\and then fails on its own statement reports its own statement.
    );
    code_block(49, "glosso", #string
        \\Vec :: struct { x: s64; }
        \\
        \\inner :: (T: type) -> bool { return #meaningful { p, q: T; p * q; }; }
        \\
        \\outer :: (T: type) -> bool {
        \\    return #meaningful {
        \\        ok :: inner(s64);
        \\        p, q: T;
        \\        p + q;
        \\    };
        \\}
        \\
        \\main :: () {
        \\    #assert outer(Vec), "outer constraint";
        \\}
    );
    code_block(50, "text", #string
        \\error: assertion failed: outer constraint
        \\   --> nested.glo:14:5
        \\   |
        \\14 |     #assert outer(Vec), "outer constraint";
        \\   |     ^^^^^^^
        \\note: constraint is not meaningful for these types
        \\note: no operator '+' for Vec, Vec
        \\  --> nested.glo:9:11
        \\  |
        \\9 |         p + q;
        \\  |           ^
    );
    paragraph(51, #string,oneline
        \\Checking an assertion clears the recorded probe failure before
        \\evaluating the condition, so an unrelated failed probe earlier in the
        \\function cannot leak a stale note onto a later assertion. A failing
        \\assertion whose condition contained no probe at all prints its headline
        \\with no notes.
    );
    paragraph(52, #string,oneline
        \\Probes are also hygienic with respect to code generation. While a probe
        \\is being evaluated the checker raises a probe depth, and generic
        \\instantiations discovered under it are recorded speculatively rather
        \\than lowered. Asking whether `Heavy` is sortable emits no specialized
        \\`sortish` symbol; a later real call from ordinary code commits the
        \\instance normally.
    );
    code_block(53, "glosso", #string
        \\#import "Io";
        \\
        \\sortish :: (items: []$T) { for items { } }
        \\
        \\Sortable :: (T: type) -> bool {
        \\    return #meaningful { items: []T; sortish(items); };
        \\}
        \\
        \\Heavy :: struct { blob: [4096]u8; }
        \\
        \\main :: () {
        \\    #if Sortable(Heavy) { print("Heavy could be sorted\n"); }
        \\}
    );
    paragraph(54, #string,oneline
        \\Compiling that with `--backend llvm-ir` yields a module with no symbol
        \\matching `sortish`; adding `xs: [2]Heavy; sortish(xs[..]);` to `main`
        \\makes the specialization appear. Instantiations are the part of a probe
        \\that is transactional: constant evaluations a probe forces are not
        \\rolled back, so a probe is not a general sandbox. A probe verdict is
        \\computed once by the checker and cached on the node, and both constant
        \\evaluation and lowering read the cache. The observable guarantee is that
        \\a probe used as a run-time expression lowers to a plain constant boolean
        \\that always agrees with the verdict an `#if` saw.
    );
    subheading(55, "Per-instantiation constraints in generic bodies");
    paragraph(56, #string,oneline
        \\An assertion in a generic body is decided separately for every
        \\instantiation, because the condition becomes compile-time known once
        \\the type parameter is bound. Instantiations that satisfy it compile with
        \\no emitted code; one that does not is a build failure naming both the
        \\assertion's message and the captured probe reason.
    );
    code_block(57, "glosso", #string
        \\#import "Io";
        \\
        \\Vec :: struct { x: s64; }
        \\
        \\addable :: (T: type) -> bool { return #meaningful { p, q: T; p + q; }; }
        \\
        \\twice :: (v: $T) -> T {
        \\    #assert addable(T), "twice needs a type with +";
        \\    return v + v;
        \\}
        \\
        \\main :: () {
        \\    print("%\n", twice(21));    // ok
        \\    w: Vec;
        \\    print("%\n", twice(w).x);   // rejected
        \\}
    );
    code_block(58, "text", #string
        \\error: assertion failed: twice needs a type with +
        \\  --> twice.glo:8:5
        \\  |
        \\8 |     #assert addable(T), "twice needs a type with +";
        \\  |     ^^^^^^^
        \\note: constraint is not meaningful for these types
        \\note: no operator '+' for Vec, Vec
        \\  --> twice.glo:5:64
        \\  |
        \\5 | addable :: (T: type) -> bool { return #meaningful { p, q: T; p + q; }; }
        \\  |                                                                ^
    );
    paragraph(59, #string,oneline
        \\This is not an alternative spelling of `where`. A failed `where`
        \\constraint removes a candidate from overload resolution, so another
        \\declaration may still apply; a failed `#assert` is a hard build error
        \\that no other candidate can rescue. Use `where` to describe which
        \\declaration applies, and `#assert` to say that a property must hold or
        \\the build stops.
    );
    subheading(60, "Assertions during compile-time execution");
    paragraph(61, #string,oneline
        \\A procedure containing a run-time assertion can still be executed by
        \\the compile-time evaluator, for instance to fold a `::` constant or to
        \\run a `#comptime` block. If the assertion trips there, the failure is
        \\raised inside the evaluator and reported as an ordinary compile error
        \\anchored at the `#assert` statement.
    );
    code_block(62, "glosso", #string
        \\#import "Io";
        \\checked :: (n: s64) -> s64 {
        \\    #assert n > 0, "checked needs positive n";
        \\    return n * 2;
        \\}
        \\main :: () {
        \\    #comptime { v :: checked(-5); }
        \\    print("ok\n");
        \\}
    );
    code_block(63, "text", #string
        \\error: assertion failed: checked needs positive n
        \\  --> vm.glo:3:5
        \\  |
        \\3 |     #assert n > 0, "checked needs positive n";
        \\  |     ^^^^^^^
    );
    note(64, #string,oneline
        \\One assertion therefore has three possible reporting contexts: a build
        \\error when the condition folds to false, a build error when the
        \\enclosing procedure is executed during compilation with failing
        \\arguments, and a process abort when the compiled program reaches it
        \\with failing values. The message text is identical in all three.
    );
}

render_section_97 :: () {
    paragraph(0, #string,oneline
        \\A freestanding target produces code for an environment with no
        \\operating system, no C runtime, and no process startup: firmware, a
        \\bootloader, a kernel, or a UEFI application. `--target` selects such an
        \\environment, and `--no-main` decides what the compiler treats as the
        \\program's roots when there is no hosted entry point to start from.
    );
    code_block(1, "text", #string
        \\# bare-metal ELF executable, entry symbol glo_main
        \\glosso kernel.glo --target x86_64-freestanding -O2 -o kernel.elf
        \\
        \\# UEFI object; the PE image is produced by a separate link step
        \\glosso firmware.glo --target x86_64-freestanding-uefi \
        \\    --no-main --backend object -o firmware.obj
    );
    subheading(2, "`x86_64-freestanding`: bare-metal ELF");
    paragraph(3, #string,oneline
        \\This target sets `OUT.os` to `Target_OS.Freestanding`, `OUT.cpu` to
        \\`Target_CPU.X86_64`, and `OUT.abi` to `Target_ABI.Freestanding`. It maps
        \\to the LLVM triple `x86_64-unknown-none-elf` and emits ELF objects.
        \\Executables are linked with `ld.lld -e glo_main`, so the image entry
        \\point is the symbol `glo_main`—the compiled `main` procedure itself,
        \\entered directly by the loader with no `main(argc, argv)` wrapper in
        \\front of it.
    );
    code_block(4, "glosso", #string
        \\main :: () {
        \\    value: u32 = 42;
        \\    if value == 0 return;
        \\}
    );
    code_block(5, "text", #string
        \\glosso: compile min.glo (target=x86_64-unknown-none-elf)
        \\glosso: link min.elf (target=x86_64-unknown-none-elf, -O2)
        \\glosso: done min.elf  (backend=llvm, target=x86_64-unknown-none-elf, -O2)
        \\
        \\# ELF entry address resolves to the symbol glo_main; the only other
        \\# symbols are glo_temp_buf, glo_temp_initial_block, glo_temp_current,
        \\# glo_temp_used, and glo_temp_restore
    );
    paragraph(6, #string,oneline
        \\The hosted machinery that a normal executable receives is absent. There
        \\is no command-line argument wrapper and no command-line globals, and the
        \\heap allocator, debug allocator, default temporary allocator, and the
        \\generated `show__` printing procedures are no longer implicit
        \\reachability roots, so they are dropped unless the program reaches them
        \\itself. That same source lowers to two emitted functions on this
        \\target—`glo_main` and the temporary-allocator restore helper—against
        \\thirty-four on the host.
    );
    paragraph(7, #string,oneline
        \\Temporary storage also changes. The scratch arena is non-thread-local
        \\and defaults to 64 KiB rather than the hosted 4 MiB, which matters when
        \\the image must fit in a boot-time budget. `--temp-allocator-size
        \\<bytes>` overrides it on any target.
    );
    code_block(8, "text", #string
        \\# --backend llvm-ir, target x86_64-freestanding
        \\@glo_temp_buf = internal global [65536 x i8] zeroinitializer, align 16
        \\
        \\# --backend llvm-ir, host target
        \\@glo_temp_buf = internal global [4194304 x i8] zeroinitializer, align 16
        \\
        \\# --temp-allocator-size 4096
        \\@glo_temp_buf = internal global [4096 x i8] zeroinitializer, align 16
    );
    note(9, #string,oneline
        \\A bare-metal image has no host I/O and no C runtime, so `#import "Io"`
        \\does not link on `x86_64-freestanding`. Checked arithmetic is a subtler
        \\version of the same problem: at the default `-O1` an overflow check
        \\keeps a reference to `abort` alive and the link fails, while `-O2` folds
        \\the check away and the same source links. Supply the primitives the
        \\image needs through `#foreign` declarations backed by your own runtime,
        \\or avoid the constructs that call them.
    );
    code_block(10, "text", #string
        \\error: ld.lld: error: undefined symbol: abort
        \\>>> referenced by add_one
        \\
        \\ld.lld: error: undefined symbol: write
        \\ld.lld: error: undefined symbol: __errno_location
        \\ld.lld: error: undefined symbol: memcpy
    );
    subheading(11, "`x86_64-freestanding-uefi`: PE/COFF for firmware");
    paragraph(12, #string,oneline
        \\UEFI is freestanding in its runtime but Microsoft in its ABI. This
        \\target keeps `OUT.os` at `Target_OS.Freestanding` while setting
        \\`OUT.abi` to `Target_ABI.Uefi`, and internally uses the LLVM triple
        \\`x86_64-pc-windows-msvc`. The consequence is PE/COFF output and
        \\Microsoft x64 C record and aggregate-passing rules, without any hosted
        \\Windows runtime being injected. A gate written against
        \\`OUT.os == Target_OS.Freestanding`—see Target-Gated Code for the
        \\constants themselves—therefore matches both bare-metal ELF and UEFI,
        \\and only `OUT.abi` distinguishes them.
    );
    paragraph(13, #string,oneline
        \\`--print-targets` describes this target as a UEFI PE/COFF object, not an
        \\executable, and that is exact: the default executable backend invokes
        \\the platform linker, which looks for a hosted C entry point and fails.
        \\Emit an object and produce the final image with an external UEFI link
        \\step.
    );
    code_block(14, "text", #string
        \\glosso firmware.glo --target x86_64-freestanding-uefi -o firmware.efi
        \\error: rust-lld: error: undefined symbol: wmain
        \\
        \\# correct shape
        \\glosso firmware.glo --target x86_64-freestanding-uefi \
        \\    --no-main --backend object -o firmware.obj
        \\lld-link /nologo /machine:x64 /subsystem:efi_application \
        \\    /entry:glo_efi_main /nodefaultlib /opt:ref \
        \\    /out:BOOTX64.EFI firmware.obj
    );
    paragraph(15, #string,oneline
        \\`/entry:glo_efi_main` reflects the export naming rule: a Glosso
        \\procedure named `efi_main` is emitted as the symbol `glo_efi_main`.
        \\There is no source directive that renames an exported symbol; only
        \\bodyless `#foreign` declarations carry an external symbol name.
    );
    paragraph(16, #string,oneline
        \\`x86_64-freestanding-msvc` remains accepted as a compatibility spelling.
        \\It produces the same LLVM triple and the same Microsoft C ABI, but it
        \\reports `OUT.abi == Target_ABI.Msvc`. Source that gates on
        \\`Target_ABI.Uefi` silently does not match it, which is the one real
        \\hazard in the alias.
    );
    code_block(17, "glosso", #string
        \\report :: () {
        \\    #if OUT.abi == Target_ABI.Uefi         #compile_error "ABI=Uefi";
        \\    #if OUT.abi == Target_ABI.Msvc         #compile_error "ABI=Msvc";
        \\    #if OUT.abi == Target_ABI.Freestanding #compile_error "ABI=Freestanding";
        \\    #if OUT.abi == Target_ABI.Gnu          #compile_error "ABI=Gnu";
        \\}
        \\main :: () { report(); }
    );
    table_header(18, "`--target` spelling   —   LLVM triple   —   `OUT.os` / `OUT.abi`");
    table_row(19, #string,oneline
        \\`x86_64-freestanding`   |   `x86_64-unknown-none-elf`   |
        \\  `Freestanding` / `Freestanding`
    );
    table_row(20, #string,oneline
        \\`x86_64-freestanding-uefi`   |   `x86_64-pc-windows-msvc`   |
        \\  `Freestanding` / `Uefi`
    );
    table_row(21, #string,oneline
        \\`x86_64-freestanding-msvc`   |   `x86_64-pc-windows-msvc`   |
        \\  `Freestanding` / `Msvc`
    );
    table_row(22, #string,oneline
        \\`x86_64-freestanding-gnu`   |   `x86_64-unknown-none-elf`   |
        \\  `Freestanding` / `Gnu`
    );
    table_row(23, #string,oneline
        \\`x86-freestanding-uefi`   |   `i686-pc-windows-msvc`   |
        \\  `Freestanding` / `Uefi`
    );
    table_row(24, #string,oneline
        \\`aarch64-freestanding`   |   `aarch64-unknown-none-elf`   |
        \\  `Freestanding` / `Freestanding`
    );
    table_row(25, #string,oneline
        \\`wasm32-freestanding`   |   `wasm32-unknown-unknown`   |   `Wasm` /
        \\`Freestanding`
    );
    paragraph(26, #string,oneline
        \\Only `wasm32-freestanding`, `x86_64-freestanding`, and
        \\`x86_64-freestanding-uefi` are advertised by `--print-targets`. The
        \\other rows are produced by the target grammar rather than by an
        \\enumeration, which is why `riscv64-freestanding` and `arm-freestanding`
        \\also resolve, to `riscv64-unknown-none-elf` and `arm-unknown-none-elf`.
    );
    subheading(27, "The `--target` grammar");
    paragraph(28, #string,oneline
        \\`--target <spec>` and `--target=<spec>` are equivalent. The spec is
        \\split on `-` and interpreted by rules tried in order, with any field the
        \\spec does not determine defaulting to the compiler's host target.
    );
    table_header(29, "Spec shape   —   Interpretation");
    table_row(30, #string,oneline
        \\`host`, `native`   |   The compiler's own host target
    );
    table_row(31, #string,oneline
        \\First part `wasm32` or `wasm64`   |   OS becomes `Wasm`, that word is
        \\the CPU, and the ABI is the third part if present, otherwise
        \\`Freestanding`
    );
    table_row(32, #string,oneline
        \\Exactly two parts, a CPU name then literally `freestanding`   |   OS
        \\`Freestanding`, that CPU, ABI `Freestanding`
    );
    table_row(33, #string,oneline
        \\`wasi-wasm32`, `wasi-wasm64`   |   Legacy WASI shorthand: OS `Wasm`,
        \\ABI `Wasi`
    );
    table_row(34, #string,oneline
        \\A CPU name then an OS name, optionally an ABI   |   `x86_64-windows-gnu`
        \\and `x86_64-freestanding-uefi` take this route
    );
    table_row(35, #string,oneline
        \\Anything else   |   The parts are zipped positionally onto os, cpu, and
        \\abi, which is how `windows-x86_64-gnu` works
    );
    paragraph(36, #string,oneline
        \\Recognized CPU names are `x86_64`, `amd64`, `x86`, `i386`, `i686`,
        \\`aarch64`, `arm64`, `arm`, `armv5`, `armv7`, `thumb`, `loongarch64`,
        \\`mips`, `mipsel`, `mips64`, `mips64el`, `powerpc`, `ppc`, `ppc32`,
        \\`ppc64le`, `riscv64`, `s390x`, `wasm32`, and `wasm64`. Recognized OS
        \\names are `linux`, `macos`, `darwin`, `osx`, `windows`, `win32`,
        \\`freebsd`, `wasm`, `webassembly`, and `freestanding`. When the resolved
        \\OS is freestanding, an ABI of `uefi` or `msvc` selects
        \\`<cpu>-pc-windows-msvc` and anything else selects
        \\`<cpu>-unknown-none-elf`.
    );
    note(37, #string,oneline
        \\The two-part freestanding shorthand is recognized CPU-first only.
        \\`freestanding-x86_64` falls through to positional zipping, inherits the
        \\build machine's ABI, and on a Windows host silently resolves to
        \\`x86_64-pc-windows-msvc` with `OUT.abi == Target_ABI.Msvc`. Write
        \\`x86_64-freestanding` or give all three fields. The driver also does not
        \\validate spellings itself—an unrecognized spec is only rejected later by
        \\LLVM, as `--target totally-bogus-abi` shows with `error: No available
        \\targets are compatible with triple "bogus-unknown-totally-abi"`.
    );
    subheading(38, "Explicit no-main compilation");
    paragraph(39, #string,oneline
        \\`--no-main` changes what reachability analysis starts from: every
        \\defined `#c_call` procedure becomes a root, and `main` does not. Along
        \\with `main`, the implicit hosted roots are suppressed—the
        \\`main(argc, argv)` wrapper, the WASI `_start` wrapper, the command-line
        \\globals, and the implicit heap, debug, and temporary allocator
        \\procedures and `show__` printers. Anything reachable only from `main` is
        \\dropped even when a procedure named `main` exists.
    );
    code_block(40, "glosso", #string
        \\firmware_entry :: () #c_call {}
        \\
        \\// Explicit no-main mode must not make this hosted entry reachable.
        \\main :: () {}
        \\
        \\unreachable_helper :: () {}
    );
    code_block(41, "text", #string
        \\# glosso no_main.glo --no-main --backend llvm-ir -o on.ll
        \\define void @glo_firmware_entry()
        \\define internal void @glo_temp_restore(i64 %0)
        \\
        \\# glosso no_main.glo --backend llvm-ir -o off.ll
        \\# 34 definitions, including @glo_main, @glo_heap_allocator_proc,
        \\# @glo_default_temp_allocator_proc, and @glo_show__string
    );
    paragraph(42, #string,oneline
        \\The mode is explicit rather than inferred from a missing `main` because
        \\the two conditions are unrelated. That example defines `main` and still
        \\wants no-main roots, which inference could not express. In the other
        \\direction, a hosted program that is merely missing `main`—a typo, a
        \\wrong file on the command line—should fail its link rather than
        \\silently build an artifact containing only its exports. The one place
        \\the compiler does infer is a bare-metal target, where `os ==
        \\freestanding` and no `main` at all already roots `#c_call` exports
        \\without the flag.
    );
    paragraph(43, #string,oneline
        \\`--no-main` needs an output kind that does not run the platform linker,
        \\because the linker still expects a hosted C entry point. Use
        \\`--backend object`, `static-lib`, or `shared-lib`; the default
        \\executable backend fails with `rust-lld: error: undefined symbol:
        \\wmain` on Windows targets. The flag is not restricted to bare metal—it
        \\is equally the way to compile a hosted static library that exports only
        \\`#c_call` entry points.
    );
    paragraph(44, #string,oneline
        \\The same switch is available to compile-time build code as the `no_main`
        \\field on `Compile_Options` and `Build_Options`, both defaulting to
        \\`false`, with the helpers `set_no_main` and `set_build_no_main`. Setting
        \\it maps the nested compilation to the compiler's `--no-main` mode.
        \\Combined with `.os = .Freestanding`, `.abi = .Uefi`, and
        \\`Compiler_Backend.Object`, this is the supported way to produce a UEFI
        \\object from a build script. The rest of that API surface belongs to
        \\Build-Time Compilation Helpers.
    );
    code_block(45, "glosso", #string
        \\#import "Io";
        \\#import "Compiler";
        \\
        \\build :: () {
        \\    set_build_options_dc(.do_output = false);
        \\
        \\    options: Compile_Options;
        \\    options.backend = Compiler_Backend.Object;
        \\    options.target.os  = .Freestanding;
        \\    options.target.cpu = .X86_64;
        \\    options.target.abi = .Uefi;
        \\    options.optimization_level = Optimization.Very_Optimized;
        \\    options.temp_allocator_size = 64 * 1024;
        \\    set_no_main(*options);
        \\
        \\    compiled := compile("firmware.glo", "firmware.obj", options);
        \\    if result_is_err(compiled) {
        \\        print("BUILD FAILED: %\n", compiled.Err.message);
        \\        return;
        \\    }
        \\    print("BUILD OK no_main=% abi=%\n", options.no_main, options.target.abi);
        \\}
        \\
        \\#comptime build();
        \\
        \\main :: () {}
    );
    code_block(46, "text", #string
        \\BUILD OK no_main=1 abi=9
        \\
        \\# firmware.glo declared efi_main :: (image: *void, table: *void) -> u64
        \\# #c_call plus an unreferenced not_reachable :: () {}
        \\# firmware.obj contains exactly one Glosso symbol: glo_efi_main
    );
    note(47, #string,oneline
        \\`abi=9` is the ordinal of `Target_ABI.Uefi`; `Compile_Options.target` is
        \\an `Output_Target` struct with typed `os`, `cpu`, and `abi` fields, never
        \\an encoded target string, so enum shorthand such as `.Freestanding`
        \\works. `set_build_options_dc(.do_output = false)` suppresses the outer
        \\program's own output while the script drives the nested compile.
    );
}

render_section_101 :: () {
    paragraph(0, #string,oneline
        \\`context.allocator` and `context.temp_allocator` hold values of type
        \\`Allocator`, a two-word vtable. Every allocation a program performs
        \\reaches memory by loading one of those two fields and calling through
        \\it. This chapter is the contract a replacement has to satisfy. All of
        \\the names below are declared in `std/Context.glo` and need
        \\`#import "Context";` before they can be spelled.
    );
    subheading(1, "The `Allocator` vtable");
    code_block(2, "glosso", #string
        \\Allocator_Proc :: #fn_ptr(
        \\    data: *void,
        \\    mode: Allocator_Mode,
        \\    size: s64,
        \\    alignment: s64,
        \\    old_memory: *void,
        \\    old_size: s64
        \\) -> *void;
        \\
        \\Allocator :: struct { procedure: Allocator_Proc; data: *void; }
    );
    paragraph(3, #string,oneline
        \\`data` is handed back as the first argument on every dispatch, so it is
        \\where an allocator keeps its state; the five shipped constructors all
        \\set it to `null` because their state is compiler-provided. `procedure`
        \\is tested for null before every dispatch: an `Allocator` left at its
        \\zero value does not fail allocations, it falls through to the
        \\compiler's built-in allocator. Installing a zeroed `Allocator` is
        \\therefore not a way to disable allocation — `nil_allocator()` is.
    );
    subheading(4, "The six parameters");
    table_header(5, "Parameter   —   Meaning");
    table_row(6, #string,oneline
        \\`data`   |   The `data` field of the `Allocator` being dispatched
        \\through, passed unchanged.
    );
    table_row(7, #string,oneline
        \\`mode`   |   Which operation is requested. The body is expected to be
        \\one `if mode == { ... }` switch.
    );
    table_row(8, #string,oneline
        \\`size`   |   Byte count for `.Alloc` and `.Alloc_Non_Zeroed`, and the
        \\_new_ size for `.Resize` and `.Resize_Non_Zeroed`. Zero for `.Free`
        \\and `.Free_All`.
    );
    table_row(9, #string,oneline
        \\`alignment`   |   Requested alignment in bytes. Every shipped entry
        \\point passes the constant 16 on allocation and 0 on `.Free`; no
        \\standard-library call exposes it, so an allocator that wants a
        \\different alignment must be reached through its own wrapper.
    );
    table_row(10, #string,oneline
        \\`old_memory`   |   The block being freed or resized. `null` for
        \\`.Alloc`, `.Alloc_Non_Zeroed` and `.Free_All`.
    );
    table_row(11, #string,oneline
        \\`old_size`   |   The previous size of `old_memory`, supplied only by
        \\`mem_resize`. Zero everywhere else, including on `.Free` — a
        \\size-tracking allocator cannot rely on it during a free.
    );
    paragraph(12, #string,oneline
        \\The result is the new block for the allocating and resizing modes and
        \\`null` to report failure. `.Free` and `.Free_All` return `null` by
        \\convention and every caller discards the value. There is no error
        \\channel: `Allocator_Proc` returns a bare `*void`, so a failed
        \\allocation is indistinguishable from a null return of any other kind.
    );
    subheading(13, "`Allocator_Mode`");
    paragraph(14, #string,oneline
        \\The enum is declared without explicit values, so the variants take
        \\ordinals 0 through 7 in declaration order. That numbering is part of
        \\the calling convention rather than an implementation detail: `alloc`
        \\and `free` are compiler intrinsics that build the dispatch with a
        \\literal 0 and a literal 1 in the `mode` position, never through the
        \\Glosso enum.
    );
    table_header(15, "Variant   —   Ordinal, and what dispatches it");
    table_row(16, #string,oneline
        \\`.Alloc`   |   0. Sent by `alloc` and by `mem_alloc`. Returns a block
        \\of `size` bytes, or `null`.
    );
    table_row(17, #string,oneline
        \\`.Free`   |   1. Sent by `free` and by `mem_free`, with the block in
        \\`old_memory` and `size`, `alignment` and `old_size` all zero.
    );
    table_row(18, #string,oneline
        \\`.Free_All`   |   2. Sent only by `free_all`, and therefore also by
        \\`reset_temporary_storage`. Releases everything the allocator owns.
    );
    table_row(19, #string,oneline
        \\`.Resize`   |   3. Sent only by `mem_resize`, with the old block, its
        \\`old_size`, and the new `size`.
    );
    table_row(20, #string,oneline
        \\`.Query_Features`   |   4. Never sent by the standard library or by
        \\the compiler.
    );
    table_row(21, #string,oneline
        \\`.Query_Info`   |   5. Never sent by the standard library or by the
        \\compiler.
    );
    table_row(22, #string,oneline
        \\`.Alloc_Non_Zeroed`   |   6. Never sent by any shipped entry point;
        \\only ever reached as a fall-through target inside an allocator body.
    );
    table_row(23, #string,oneline
        \\`.Resize_Non_Zeroed`   |   7. Never sent by any shipped entry point;
        \\same fall-through role as `.Alloc_Non_Zeroed`.
    );
    paragraph(24, #string,oneline
        \\Four of the eight modes are consequently dead as far as callers are
        \\concerned. The zeroed/non-zeroed distinction is nominal as well: all
        \\three shipped allocator procedures implement `.Alloc` by falling
        \\through into `.Alloc_Non_Zeroed`, so nothing in the standard library
        \\zeroes a fresh block. A custom allocator only has to answer `.Alloc`,
        \\`.Free`, and — if anything will call `free_all` on it — `.Free_All`;
        \\`else; return null;` is a complete implementation of the remainder.
    );
    subheading(25, "`Allocator_Error` and `allocator_error_reason`");
    code_block(26, "glosso", #string
        \\Allocator_Error :: enum {
        \\    None :: 0;
        \\    Out_Of_Memory :: 1;
        \\    Invalid_Pointer :: 2;
        \\    Invalid_Argument :: 3;
        \\    Mode_Not_Implemented :: 4;
        \\}
        \\
        \\allocator_error_reason :: (error: Allocator_Error) -> string
        \\    #memory returns_static { ... }
    );
    table_header(27, "Variant   —   Value, and `allocator_error_reason` result");
    table_row(28, "`.None`   |   0, and the string `no error`");
    table_row(29, "`.Out_Of_Memory`   |   1, and the string `out of memory`");
    table_row(30, "`.Invalid_Pointer`   |   2, and the string `invalid pointer`");
    table_row(31, #string,oneline
        \\`.Invalid_Argument`   |   3, and the string `invalid argument`
    );
    table_row(32, #string,oneline
        \\`.Mode_Not_Implemented`   |   4, and the string
        \\`allocator mode is not implemented`
    );
    paragraph(33, #string,oneline
        \\`allocator_error_reason` carries `#memory returns_static`, so its
        \\result may be stored and returned without a release obligation.
        \\`Allocator_Error` also has an `instance Error` whose `report_error`
        \\prints `allocator error: <reason>` through `error_report_line`, which
        \\makes the enum usable with `?` and with the `Error` typeclass.
    );
    note(34, #string,oneline
        \\No procedure in the standard library ever returns, accepts or produces
        \\an `Allocator_Error`. The vtable signature has no room for one, and
        \\every shipped entry point signals failure with a null pointer. The
        \\enum exists so that an allocator built on top of the interface can
        \\report its own failures through the ordinary error machinery.
    );
    subheading(35, "Entry points");
    code_block(36, "glosso", #string
        \\mem_alloc  :: (size: s64, allocator := context.allocator) -> *void;
        \\mem_resize :: (old_memory: *void, old_size: s64, size: s64,
        \\               allocator := context.allocator) -> *void;
        \\mem_free   :: (ptr: *void, allocator := context.allocator);
        \\
        \\allocator_mem_alloc :: (allocator: Allocator, size: $T) -> *void;
        \\allocator_mem_free  :: (allocator: Allocator, ptr: *void);
        \\
        \\free_all :: (allocator := context.allocator);
        \\reset_temporary_storage :: ();
    );
    table_header(37, "Call   —   Mode dispatched, and memory contract");
    table_row(38, #string,oneline
        \\`mem_alloc(size, allocator)`   |   `.Alloc` with `alignment` 16.
        \\`#memory(returns_fresh, released_by(mem_free))`.
    );
    table_row(39, #string,oneline
        \\`mem_resize(old, old_size, size, allocator)`   |   `.Resize` with
        \\`alignment` 16. `#memory(returns_fresh, invalidates(old_memory),
        \\noescape(old_memory))`.
    );
    table_row(40, #string,oneline
        \\`mem_free(ptr, allocator)`   |   `.Free`.
        \\`#memory(kills(ptr), noescape(ptr))`. Returns `void`; the vtable's
        \\result is bound to a local and discarded.
    );
    table_row(41, #string,oneline
        \\`allocator_mem_alloc(allocator, size)`   |   Argument-swapped
        \\`mem_alloc`. `size` is generic (`$T`) and is `cast(s64)`-ed, so an
        \\`s32` or a `u64` count is accepted without a written cast. Carries
        \\`#memory returns_fresh` but _not_ `released_by`.
    );
    table_row(42, #string,oneline
        \\`allocator_mem_free(allocator, ptr)`   |   Argument-swapped
        \\`mem_free`, with the same `kills`/`noescape` contract.
    );
    table_row(43, #string,oneline
        \\`free_all(allocator)`   |   `.Free_All`. The default argument is
        \\`context.allocator`, not `context.temp_allocator`.
    );
    table_row(44, #string,oneline
        \\`reset_temporary_storage()`   |   Exactly
        \\`free_all(context.temp_allocator);` — see _Temporary Allocation_.
    );
    table_row(45, #string,oneline
        \\`alloc(n)` / `free(p)`   |   The context-routed pair, and the only two
        \\that are not written in Glosso: they are the `ctx_alloc` and
        \\`ctx_free` intrinsics. See _Context Values_.
    );
    paragraph(46, #string,oneline
        \\`alloc` and `free` do not call `mem_alloc`. The backend emits a small
        \\helper that loads `context.allocator` from the context global, branches
        \\on whether `procedure` is null, and then either calls the vtable with
        \\the literal argument list `(data, mode, size, 16, null, 0)`, takes an
        \\inlined fast path when `procedure` happens to be the debug allocator's
        \\own procedure, or falls back to the built-in allocator. The three-way
        \\branch is why a zeroed `Allocator` still allocates.
    );
    subheading(47, "`mem_resize` does not discharge the release obligation");
    paragraph(48, #string,oneline
        \\`mem_alloc` carries `released_by(mem_free)` and `mem_resize` carries
        \\`invalidates(old_memory)`. Invalidation is not release, so the
        \\obligation created by the original `mem_alloc` survives the resize and
        \\the borrow checker reports it even though the resized block is freed:
    );
    code_block(49, "glosso", #string
        \\#import "Context";
        \\
        \\main :: () {
        \\    a := heap_allocator();
        \\    p := mem_alloc(48, a);
        \\    q := mem_resize(p, 48, 96, a);
        \\    mem_free(q, a);
        \\}
    );
    code_block(50, "text", #string
        \\warning: resource must be released by 'mem_free' before leaving scope
        \\  --> mem.glo:5:10
        \\  |
        \\5 |     p := mem_alloc(48, a);
        \\  |          ^^^^^^^^^
        \\note: release obligation was created here
        \\  --> mem.glo:5:10
        \\  |
        \\5 |     p := mem_alloc(48, a);
        \\  |          ^^^^^^^^^
    );
    paragraph(51, #string,oneline
        \\Assigning the result back over `p` instead of into a fresh `q` does not
        \\help; the obligation is attached to the acquisition, not to the name.
        \\The fix is the intentional-leak annotation on the acquiring expression,
        \\which suppresses exactly the missing-release finding and nothing else:
    );
    code_block(52, "glosso", #string
        \\    p := mem_alloc(48, a) #memory leak;
        \\    q := mem_resize(p, 48, 96, a);
        \\    mem_free(q, a);
    );
    subheading(53, "`free_all` on the default allocator");
    paragraph(54, #string,oneline
        \\`free_all()` with no argument dispatches `.Free_All` to
        \\`context.allocator`, and neither default allocator frees anything in
        \\response. `heap_allocator_proc` has no `.Free_All` case at all, so at
        \\`-O1` and above the call is a silent no-op. At `-O0` the default is
        \\the debug allocator, whose `.Free_All` case prints the live-allocation
        \\report:
    );
    code_block(55, "glosso", #string
        \\#import "Context";
        \\#import "Io";
        \\
        \\main :: () {
        \\    p := alloc(64);
        \\    print("before\n");
        \\    free_all();
        \\    print("after\n");
        \\    free(p);
        \\}
    );
    code_block(56, "text", #string
        \\before
        \\glosso debug allocator: leaked 1 allocation(s), 64 byte(s)
        \\  leak: 64 byte(s)
        \\    allocated at:
        \\      fa.glo:5:10
        \\after
    );
    paragraph(57, #string,oneline
        \\The block is still live afterwards and `free(p)` still succeeds:
        \\`.Free_All` on the debug allocator reports, it does not release. Only
        \\the temporary allocator implements `.Free_All` as an actual reset,
        \\which is why `reset_temporary_storage` names the temp allocator
        \\explicitly. See _Debug Allocation_ for the report format.
    );
    subheading(58, "Constructors");
    table_header(59, "Constructor   —   What it installs");
    table_row(60, #string,oneline
        \\`heap_allocator()`   |   The libc-backed allocator. `.Alloc` and
        \\`.Alloc_Non_Zeroed` share one case; `.Resize` reallocates; `.Free`
        \\frees; everything else returns `null`. The default at `-O1` and above.
    );
    table_row(61, #string,oneline
        \\`debug_allocator()`   |   The tracking allocator. Same four modes plus
        \\`.Free_All`, which prints the leak report. The default at `-O0`.
    );
    table_row(62, #string,oneline
        \\`default_temp_allocator()`   |   The growing arena that
        \\`context.temp_allocator` starts out holding. Implements only `.Alloc`,
        \\`.Alloc_Non_Zeroed` and `.Free_All`; an individual `.Free` is a no-op
        \\returning `null`.
    );
    table_row(63, #string,oneline
        \\`temp_allocator()`   |   An Odin-style alias that returns exactly
        \\`default_temp_allocator()`. The two are interchangeable.
    );
    table_row(64, #string,oneline
        \\`nil_allocator()`   |   Every mode returns `null`, unconditionally.
        \\Installing it proves that a region of code performs no successful
        \\allocation.
    );
    paragraph(65, #string,oneline
        \\All five carry `#memory returns_static`: they build a two-word value
        \\and allocate nothing, so the returned `Allocator` may be stored
        \\anywhere without a release obligation. `nil_allocator` is the only one
        \\that is not a plausible default:
    );
    code_block(66, "glosso", #string
        \\#import "Context";
        \\#import "Io";
        \\
        \\main :: () {
        \\    n := mem_alloc(16, nil_allocator());
        \\    print("nil %\n", n == null);
        \\    mem_free(n, nil_allocator());
        \\}
    );
    code_block(67, "text", "nil 1");
    subheading(68, "Installing an allocator");
    table_header(69, "Form   —   Extent of the replacement");
    table_row(70, #string,oneline
        \\`context.allocator = a;`   |   Until something else assigns the field.
        \\No scope, no restore.
    );
    table_row(71, #string,oneline
        \\`#push_allocator(a);`   |   Replaces `context.allocator` until the
        \\enclosing defer scope exits, then restores the previous value through
        \\the same LIFO machinery as `defer`.
    );
    table_row(72, #string,oneline
        \\`#push_context { context.allocator = a; ... }`   |   Replaces the
        \\whole context for the block, so the assignment is discarded on exit
        \\along with every other field change.
    );
    paragraph(73, #string,oneline
        \\`#push_allocator(context.temp_allocator)` needs no import, because it
        \\names a field rather than a type; `#push_allocator(temp_allocator())`
        \\does, because it names a procedure from the `Context` module. The
        \\context is a single process-global value and not thread-local, so a
        \\pushed allocator is visible to every thread that is running while the
        \\push is in scope — see _Context Values_.
    );
    paragraph(74, #string,oneline
        \\A `#c_call` or `#no_context` procedure has no context and cannot use
        \\`alloc`, `free` or `#push_allocator` directly. Wrapping the body in
        \\`#push_context { ... }` re-establishes one, and allocator pushes nest
        \\inside it normally:
    );
    code_block(75, "glosso", #string
        \\#import "Context";
        \\#import "Io";
        \\
        \\callback :: (n: s64) -> s64 #c_call {
        \\    total := 0;
        \\    #push_context {
        \\        #push_allocator(context.temp_allocator);
        \\        p := alloc(n);
        \\        total = context.user_index;
        \\        free(p);
        \\    }
        \\    return total + n;
        \\}
        \\
        \\main :: () {
        \\    print("callback %\n", callback(7));
        \\}
    );
    code_block(76, "text", "callback 7");
    subheading(77, "A complete custom allocator");
    paragraph(78, #string,oneline
        \\The allocator below keeps a live-block count and a byte total in a
        \\caller-supplied `Stats` record, reached through the `data` pointer, and
        \\delegates the actual memory to `heap_allocator()`. It handles the four
        \\modes anything will ever send it and answers everything else with
        \\`null`. The `#memory` contract mirrors the shipped procedures:
        \\`unknown` because the returned lifetime is not expressible, and
        \\`noescape` on the two pointer parameters.
    );
    code_block(79, "glosso", #string
        \\#import "Context";
        \\#import "Io";
        \\
        \\Stats :: struct {
        \\    live:  s64;
        \\    bytes: s64;
        \\}
        \\
        \\counting_proc :: (
        \\    data: *void,
        \\    mode: Allocator_Mode,
        \\    size: s64,
        \\    alignment: s64,
        \\    old_memory: *void,
        \\    old_size: s64
        \\) -> *void #memory(unknown, noescape(data), noescape(old_memory)) {
        \\    s := cast(*Stats) data;
        \\    if mode == {
        \\        case .Alloc; #falling;
        \\        case .Alloc_Non_Zeroed;
        \\            s.*.live  = s.*.live + 1;
        \\            s.*.bytes = s.*.bytes + size;
        \\            return mem_alloc(size, heap_allocator());
        \\        case .Free;
        \\            s.*.live = s.*.live - 1;
        \\            mem_free(old_memory, heap_allocator());
        \\            return null;
        \\        case .Resize; #falling;
        \\        case .Resize_Non_Zeroed;
        \\            s.*.bytes = s.*.bytes + (size - old_size);
        \\            return mem_resize(old_memory, old_size, size,
        \\                heap_allocator());
        \\        case .Free_All;
        \\            s.*.live  = 0;
        \\            s.*.bytes = 0;
        \\            return null;
        \\        else;
        \\            return null;
        \\    }
        \\}
        \\
        \\counting_allocator :: (s: *Stats) -> Allocator {
        \\    a: Allocator;
        \\    a.procedure = counting_proc;
        \\    a.data = cast(*void) s;
        \\    return a;
        \\}
        \\
        \\main :: () {
        \\    stats: Stats;
        \\    {
        \\        #push_allocator(counting_allocator(*stats));
        \\        p := alloc(64);
        \\        q := alloc(128);
        \\        print("live % bytes %\n", stats.live, stats.bytes);
        \\        free(p);
        \\        free(q);
        \\        print("live % bytes %\n", stats.live, stats.bytes);
        \\    }
        \\    r := alloc(256);
        \\    print("outside live %\n", stats.live);
        \\    free(r);
        \\}
    );
    code_block(80, "text", #string
        \\live 2 bytes 192
        \\live 0 bytes 192
        \\outside live 0
    );
    paragraph(81, #string,oneline
        \\The program compiles with no borrow-check warnings and prints the
        \\three lines above. `outside live 0` is the point of the example: the
        \\`alloc(256)` after the block went to the default allocator, because
        \\`#push_allocator` restored `context.allocator` when the block closed.
        \\Assigning a procedure name to a `#fn_ptr` field, as
        \\`a.procedure = counting_proc;` does, is an ordinary assignment —
        \\`counting_proc` is not marked `#c_call`, and does not need to be,
        \\because `Allocator_Proc` is a plain `#fn_ptr`.
    );
    subheading(82, "The `#Context` field-type import gate");
    paragraph(83, #string,oneline
        \\The compiler pre-registers the twelve types that make up `#Context` so
        \\it can lay the struct out before any module is loaded, but their names
        \\stay private to `std/Context.glo`. Naming one in a file that has not
        \\imported `Context` is a dedicated error rather than an
        \\unknown-identifier error:
    );
    code_block(84, "text", #string
        \\error: 'Allocator' is a #Context field type; add `#import "Context";` to name it
        \\  --> gate.glo:2:8
        \\  |
        \\2 |     a: Allocator;
        \\  |        ^^^^^^^^^
    );
    paragraph(85, #string,oneline
        \\The gate fires at every user-written type annotation, and the message
        \\differs only in the quoted name. The twelve gated names, none of which
        \\can be used until the file imports `Context`:
    );
    table_header(86, "Gated name   —   Kind, and what it belongs to");
    table_row(87, "`Print_Format_Int`   |   struct, field of `Print_Style`");
    table_row(88, "`Print_Style`   |   struct, type of `context.print_style`");
    table_row(89, "`Allocator_Mode`   |   enum, second parameter of `Allocator_Proc`");
    table_row(90, "`Allocator_Error`   |   enum, unused by the vtable itself");
    table_row(91, "`Allocator_Proc`   |   `#fn_ptr`, field of `Allocator`");
    table_row(92, #string,oneline
        \\`Allocator`   |   struct, type of `context.allocator` and
        \\`context.temp_allocator`
    );
    table_row(93, #string,oneline
        \\`Random_Generator_Mode`   |   enum, second parameter of
        \\`Random_Generator_Proc`
    );
    table_row(94, "`Random_Generator_Proc`   |   `#fn_ptr`, field of `Random_Generator`");
    table_row(95, #string,oneline
        \\`Random_Generator`   |   struct, type of `context.random_generator`
    );
    table_row(96, "`Logger_Level`   |   enum, second parameter of `Logger_Proc`");
    table_row(97, "`Logger_Proc`   |   `#fn_ptr`, field of `Logger`");
    table_row(98, "`Logger`   |   struct, type of `context.logger`");
    paragraph(99, #string,oneline
        \\`#Context` itself is never gated, and neither is reading or writing a
        \\field through `context`. `context.allocator = context.temp_allocator;`
        \\and `#push_allocator(context.temp_allocator);` both compile in a file
        \\with no imports at all. Only spelling one of the twelve names as a
        \\type — a declaration, a parameter, a return type, a cast target —
        \\trips the gate.
    );
    subheading(100, "The other context field types");
    paragraph(101, #string,oneline
        \\The remaining eight gated names describe the three non-allocator
        \\context fields. All three follow the same `{ procedure, data }` shape
        \\as `Allocator`:
    );
    code_block(102, "glosso", #string
        \\Print_Format_Int :: struct { base: s64 = 10; }
        \\Print_Style :: struct { default_format_int: Print_Format_Int; }
        \\
        \\Logger_Level :: enum {
        \\    Debug :: 0; Info :: 10; Warning :: 20; Error :: 30; Fatal :: 40;
        \\}
        \\Logger_Proc :: #fn_ptr(data: *void, level: Logger_Level,
        \\                       text: *void, len: s64);
        \\Logger :: struct {
        \\    procedure: Logger_Proc;
        \\    data: *void;
        \\    lowest_level: Logger_Level;
        \\}
        \\
        \\Random_Generator_Mode :: enum { Read; Reset; Query_Info; }
        \\Random_Generator_Proc :: #fn_ptr(data: *void,
        \\                                 mode: Random_Generator_Mode,
        \\                                 p: *void, len: s64);
        \\Random_Generator :: struct {
        \\    procedure: Random_Generator_Proc;
        \\    data: *void;
        \\}
    );
    paragraph(103, #string,oneline
        \\`Print_Style` is the only one of the three the compiler itself reads.
        \\`context.print_style.default_format_int.base` defaults to 10 and is
        \\honoured by `print`, so assigning 16 to it changes integer formatting
        \\for every subsequent `%` in the current context:
    );
    code_block(104, "glosso", #string
        \\#import "Io";
        \\
        \\main :: () {
        \\    print("%\n", 255);
        \\    context.print_style.default_format_int.base = 16;
        \\    print("%\n", 255);
        \\}
    );
    code_block(105, "text", #string
        \\255
        \\ff
    );
    paragraph(106, #string,oneline
        \\`Random_Generator` has three modes — `.Read`, `.Reset` and
        \\`.Query_Info` — and `std/Random` supplies constructors that build one
        \\from an engine state, in the same shape as the allocator constructors:
        \\`pcg32_generator`, `xoshiro256ss_generator`, `chacha20_generator`,
        \\`system_random_generator` and others. Every `std/Random` procedure
        \\takes `generator := context.random_generator` as a default argument,
        \\but nothing installs one: the default context zeroes the field, so a
        \\program either assigns `context.random_generator` itself or passes a
        \\generator explicitly.
    );
    note(107, #string,oneline
        \\`Logger` is inert. `Logger`, `Logger_Proc` and `Logger_Level` are
        \\declared in `std/Context.glo` and appear in no other file in the
        \\standard library: nothing installs a logger, nothing reads
        \\`context.logger`, and no logging procedure ships at all. The field
        \\exists so that a program can carry its own logging vtable through the
        \\context and call through it itself.
    );
    paragraph(108, #string,oneline
        \\_Context Values_ covers the context struct, `#push_context` and the
        \\`#Context` spelling rule; _Temporary Allocation_ covers the arena's
        \\lifetime rules and `--temp-allocator-size`; _Debug Allocation_ covers
        \\the tracking allocator's leak report and
        \\`debug_allocator_report_leaks`.
    );
}

render_section_102 :: () {
    paragraph(0, #string,oneline
        \\`Bindgen` is a standard module that runs the compiler's C header
        \\binding generator during compile-time evaluation. It hands a
        \\header to libclang, translates every declaration libclang reports
        \\into Glosso, and returns the result either as source text or as a
        \\written file. One `#import "Bindgen";` brings the whole surface
        \\into scope.
    );
    paragraph(1, #string,oneline
        \\Both entry points exist only while the compiler is running. They
        \\wrap `#magic` intrinsics backed by a compiler service, so a call
        \\that survives into the executable is rejected at native lowering
        \\rather than at checking:
    );
    code_block(2, "glosso", #string
        \\#import "Bindgen";
        \\
        \\main :: () {
        \\    r := generate_source("mini.h", static_library("mini"));
        \\}
    );
    code_block(3, "text", #string
        \\error: #magic 'bindgen_generate_source' must not reach native LLVM
        \\lowering: compiler service or type query must be folded before native
        \\lowering while lowering 'generate_source' at IR instruction 0
    );
    paragraph(4, #string,oneline
        \\Every example below therefore runs inside `#comptime { ... }`,
        \\inside a procedure called by `#insert`, or inside a `#comptime`
        \\constant initializer.
    );
    subheading(5, "The two entry points");
    code_block(6, "glosso", #string
        \\generate :: (header: string, output: string, library: any,
        \\             options: Bindgen_Options = .{})
        \\    -> Result(string, Bindgen_Error);
        \\
        \\generate_source :: (header: string, library: any,
        \\                    options: Bindgen_Options = .{})
        \\    -> Result(string, Bindgen_Error);
    );
    table_header(7, "Entry point   —   `Ok` payload");
    table_row(8, #string,oneline
        \\`generate`   |   Writes the bindings to `output` and returns only the
        \\status line `bindgen: wrote <output>` followed by a newline. The
        \\declarations are not added to the compilation; a later `#load` or
        \\`#import` has to pick the file up.
    );
    table_row(9, #string,oneline
        \\`generate_source`   |   Returns the complete bindings text and writes
        \\nothing to disk. This is the form `#insert` consumes.
    );
    paragraph(10, #string,oneline
        \\`options` has a default, so the three-argument and two-argument
        \\calls are the common spellings. The whole binding of a small
        \\header is one `#insert`:
    );
    code_block(11, "glosso", #string
        \\#import "Io";
        \\#import "Bindgen";
        \\
        \\mini_bindings :: () -> string #memory returns_fresh {
        \\    opts: Bindgen_Options;
        \\    r := generate_source("mini.h", static_library("mini"), opts);
        \\    if result_is_err(r) { report_error(r.Err); return ""; }
        \\    return r.Ok;
        \\}
        \\
        \\#insert mini_bindings();
        \\
        \\main :: () {
        \\    print("%\n", mini_add(2, 3));
        \\}
    );
    paragraph(12, #string,oneline
        \\Against a header declaring one record, one enum, one object-like
        \\macro and two functions, that call produces exactly this text,
        \\which `#insert` then parses as if it had been typed into the file:
    );
    code_block(13, "glosso", #string
        \\// Generated by Glosso's Clang C header bindgen from mini.h.
        \\mini :: #library,static "mini";
        \\
        \\Mini_Point :: struct #c_call {
        \\    x: s32;
        \\    y: s32;
        \\}
        \\
        \\Mini_Kind :: s32;
        \\
        \\MINI_A :: 0;
        \\
        \\MINI_B :: 1;
        \\
        \\MINI_VERSION :: 3;
        \\
        \\mini_add :: (a: s32, b: s32) -> s32 #foreign mini "mini_add" #memory unknown;
        \\
        \\mini_open :: (path: [*]const s8) -> [*]void #foreign mini "mini_open" #memory unknown;
        \\
        \\// bindgen: 1 type declarations, 1 aliases, 0 callbacks, 3 constants, 0 macros, 2 functions, 0 skipped declaration parts/macros (libclang).
    );
    paragraph(14, #string,oneline
        \\The `#library` declaration comes first and every generated
        \\function references it by handle. The handle is the library's
        \\`name`, used verbatim as a Glosso identifier.
    );
    subheading(15, "Naming the library");
    code_block(16, "glosso", #string
        \\Library_Kind :: enum { Static; System; Dynamic; }
        \\
        \\Library :: struct {
        \\    name: string = "";
        \\    file: string = "";
        \\    kind: Library_Kind = Library_Kind.Static;
        \\}
        \\
        \\static_library  :: (name: string, file: string = "") -> Library;
        \\system_library  :: (name: string, file: string = "") -> Library;
        \\dynamic_library :: (name: string, path: string) -> Library;
    );
    table_header(17, "Call   —   Emitted declaration");
    table_row(18, #string,oneline
        \\`static_library("mini", "mini")`   |   `mini :: #library,static "mini";`
    );
    table_row(19, #string,oneline
        \\`system_library("m")`   |   `m :: #library,system "m";`
    );
    table_row(20, #string,oneline
        \\`dynamic_library("mini", "libmini.so")`   |   `mini :: #library,dyn
        \\"libmini.so";` — note the emitted spelling is `dyn`, not `dynamic`
    );
    paragraph(21, #string,oneline
        \\`static_library` and `system_library` copy `name` into `file` when
        \\`file` is left empty, so the single-argument spelling is the usual
        \\one. `dynamic_library` has no default: the second argument is the
        \\path or soname the loader will be given.
    );
    paragraph(22, #string,oneline
        \\The parameter is typed `any`, not `Library`, and a plain string is
        \\accepted. It produces a `#library` declaration with no kind at
        \\all, which is the right thing when the link is arranged some other
        \\way:
    );
    code_block(23, "glosso", #string
        \\mini :: #library "mini";
    );
    subheading(24, "`Bindgen_Options`");
    code_block(25, "glosso", #string
        \\Bindgen_Options :: struct #c_call {
        \\    include_paths: [..]string;
        \\    preprocessor_definitions: [..]string;
        \\    compiler_args: [..]string;
        \\    allow_textual_fallback: bool = false;
        \\}
    );
    table_header(26, "Field   —   Effect");
    table_row(27, #string,oneline
        \\`include_paths`   |   Each entry becomes one `-I` on the preprocessor
        \\command line, in order.
    );
    table_row(28, #string,oneline
        \\`preprocessor_definitions`   |   Each entry is `NAME` or `NAME=VALUE`;
        \\Bindgen supplies the `-D` itself, so the entries must not carry
        \\one.
    );
    table_row(29, #string,oneline
        \\`compiler_args`   |   Passed through to the preprocessor verbatim. This
        \\is where `--target=`, `-std=`, `-ffreestanding` and anything else
        \\belong.
    );
    table_row(30, #string,oneline
        \\`allow_textual_fallback`   |   When libclang fails, retry with the
        \\module's own textual parser instead of returning an error. Default
        \\`false`.
    );
    paragraph(31, #string,oneline
        \\Three helpers append to the three arrays. They take a pointer to
        \\the options record, so the record itself is an ordinary local:
    );
    code_block(32, "glosso", #string
        \\add_include_path :: (options: *Bindgen_Options, path: string);
        \\add_bindgen_preprocessor_definition :: (options: *Bindgen_Options,
        \\                                        definition: string);
        \\add_bindgen_compiler_arg :: (options: *Bindgen_Options, arg: string);
    );
    paragraph(33, #string,oneline
        \\The definition helper is deliberately named to avoid colliding
        \\with `add_c_preprocessor_definition` from `std/Compiler`, which
        \\does the same job for the native C compiler. A header whose
        \\interesting declarations sit behind an include directory and a
        \\feature macro is bound like this:
    );
    code_block(34, "glosso", #string
        \\#comptime {
        \\    opts: Bindgen_Options;
        \\    add_include_path(*opts, "inc");
        \\    add_bindgen_preprocessor_definition(*opts, "MINI_EXTRA");
        \\    add_bindgen_compiler_arg(*opts, "-std=c11");
        \\    r := generate("gated.h", "gated_bindings.glo",
        \\                  static_library("mini"), opts);
        \\    if result_is_err(r) report_error(r.Err);
        \\}
    );
    paragraph(35, #string,oneline
        \\The `#ifdef MINI_EXTRA` branch and the type it needs from the
        \\include directory are both present in the written file:
    );
    code_block(36, "glosso", #string
        \\// Generated by Glosso's Clang C header bindgen from gated.h.
        \\mini :: #library,static "mini";
        \\
        \\Shared_Handle :: struct #c_call {
        \\    id: s32;
        \\}
        \\
        \\mini_extra :: (h: Shared_Handle) -> s32 #foreign mini "mini_extra" #memory unknown;
        \\
        \\mini_base :: () -> s32 #foreign mini "mini_base" #memory unknown;
    );
    subheading(37, "Bindgen preprocesses for the host, not for `OUT`");
    paragraph(38, #string,oneline
        \\Nothing about the compilation's own target reaches the
        \\preprocessor. Bindgen invokes clang with its default target, which
        \\is the machine the compiler is running on, so conditional
        \\declarations resolve for the host even when the program is being
        \\built for something else. A header guarded by `#if
        \\defined(__wasm32__)` demonstrates it:
    );
    code_block(39, "glosso", #string
        \\#comptime {
        \\    a := generate_source("tgt.h", static_library("mini"));
        \\
        \\    opts: Bindgen_Options;
        \\    add_bindgen_compiler_arg(*opts, "--target=wasm32-unknown-unknown");
        \\    b := generate_source("tgt.h", static_library("mini"), opts);
        \\}
    );
    code_block(40, "glosso", #string
        \\// a.Ok
        \\Ulong_Alias :: u32;
        \\on_host :: () -> s32 #foreign mini "on_host" #memory unknown;
        \\
        \\// b.Ok
        \\Ulong_Alias :: u32;
        \\on_wasm :: () -> s32 #foreign mini "on_wasm" #memory unknown;
    );
    note(41, #string,oneline
        \\Cross-compilation requires an explicit `--target=` in
        \\`compiler_args`. The same applies to every other target-dependent
        \\width the preprocessor and libclang decide: the `u32` above is the
        \\Windows host's 32-bit `unsigned long`, and a Linux host binds the
        \\same typedef as `u64`.
    );
    subheading(42, "The textual fallback");
    paragraph(43, #string,oneline
        \\When libclang cannot preprocess the header, the default result is
        \\a failure carrying clang's own output:
    );
    code_block(44, "text", #string
        \\bindgen error: bindgen_generate_source: Clang could not preprocess
        \\`...\broken.h` (status 1):
        \\...\broken.h:1:10: fatal error: 'definitely_not_here.h' file not found
        \\    1 | #include <definitely_not_here.h>
        \\      |          ^~~~~~~~~~~~~~~~~~~~~~~
        \\1 error generated.
    );
    paragraph(45, #string,oneline
        \\Setting `allow_textual_fallback` to `true` retries with a small
        \\hand-written C parser that ignores includes and most conditionals.
        \\It recovers the plain function declarations and drops everything
        \\it cannot understand:
    );
    code_block(46, "glosso", #string
        \\// Generated by Glosso's C header bindgen from broken.h.
        \\mini :: #library,static "mini";
        \\
        \\f :: (a: s32) -> s32 #foreign mini "f" #memory unknown;
        \\
        \\// bindgen: 0 type declarations, 0 aliases, 0 callbacks, 0 constants, 0 macros, 1 functions, 0 skipped declaration parts/macros.
    );
    paragraph(47, #string,oneline
        \\The banner and the trailing summary are how the two paths are told
        \\apart: the libclang path writes `Clang C header bindgen` and ends
        \\its summary with `(libclang)`, the textual path writes neither.
        \\The fallback is off by default because a clang error is a truthful
        \\report that the header was not understood, whereas a silently
        \\reduced binding set is not.
    );
    subheading(48, "Output conventions");
    table_header(49, "C construct   —   Generated Glosso");
    table_row(50, #string,oneline
        \\`struct S { int x; }`   |   `S :: struct #c_call { x: s32; }` — every
        \\record carries `#c_call` so its layout follows the platform C ABI
    );
    table_row(51, #string,oneline
        \\an opaque or forward-declared record   |   `Mini_Opaque :: struct
        \\#c_call {}` — a field-less struct, referenced only through
        \\pointers
    );
    table_row(52, #string,oneline
        \\`typedef enum K { A, B } K;`   |   `K :: s32;` plus one top-level
        \\constant per member (`A :: 0;`, `B :: 1;`) — the enum becomes an
        \\integer alias, not a Glosso `enum`
    );
    table_row(53, "`#define MINI_VERSION 3`   |   `MINI_VERSION :: 3;`");
    table_row(54, #string,oneline
        \\`typedef void (*Mini_Log)(const char *);`   |   `Mini_Log ::
        \\#fn_ptr(arg0: [*]const s8) #c_call;` — unnamed C parameters become
        \\`arg0`, `arg1`, and so on
    );
    table_row(55, "`const char *`   |   `[*]const s8`");
    table_row(56, #string,oneline
        \\`T *`   |   `[*]T` — every C pointer becomes a many-pointer, including
        \\`void *`, which becomes `[*]void`
    );
    table_row(57, #string,oneline
        \\`int mini_add(int, int);`   |   `mini_add :: (a: s32, b: s32) -> s32
        \\#foreign mini "mini_add" #memory unknown;`
    );
    paragraph(58, #string,oneline
        \\The last line of every run is a comment counting what was
        \\translated and what was not. A non-zero skip count is the signal
        \\to look at the header:
    );
    code_block(59, "glosso", #string
        \\// bindgen: 1 type declarations, 0 aliases, 1 callbacks, 0 constants, 0 macros, 2 functions, 0 skipped declaration parts/macros (libclang).
    );
    subheading(60, "The `#memory unknown` every generated function carries");
    paragraph(61, #string,oneline
        \\Bindgen cannot know what a C function does with memory, so it
        \\stamps `#memory unknown` on all of them. That contract is not the
        \\one that answers the borrow checker's question about an opaque
        \\foreign result. Calling the generated `mini_open`, which returns
        \\`[*]void`, warns:
    );
    code_block(62, "text", #string
        \\warning: lifetime of memory returned by opaque foreign call 'mini_open' is unknown
        \\   --> bg5.glo:14:10
        \\   |
        \\14 |     h := mini_open("data.bin");
        \\   |          ^^^^^^^^^
        \\note: add returns_fresh, returns_borrow(...), or returns_static to its #memory contract
    );
    paragraph(63, #string,oneline
        \\The note lists the three contracts that do silence it and
        \\pointedly omits `unknown`, which is already present. Generated
        \\bindings therefore warn on every opaque-pointer result until the
        \\program states the real contract itself, with a top-level
        \\`#memory` overlay naming the generated declaration:
    );
    code_block(64, "glosso", #string
        \\#memory mini_open {
        \\    returns_fresh,
        \\    released_by(mini_close),
        \\}
    );
    paragraph(65, #string,oneline
        \\_Memory Contracts and Temporal Checking_ covers overlays and the
        \\thirteen effects. The overlay is written in the user's own file
        \\and survives regeneration, which is the reason to prefer it over
        \\editing generated source.
    );
    subheading(66, "Errors");
    code_block(67, "glosso", #string
        \\Bindgen_Error :: struct {
        \\    status: s64 = 1;
        \\    message: string = "";
        \\}
        \\
        \\Bindgen_Error :: instance Error { ... }
    );
    paragraph(68, #string,oneline
        \\`status` is the generator's exit status and `message` is the text
        \\a human should read. Because the record has an `Error` instance,
        \\`report_error` prints it in the standard shape and appends a
        \\newline if the message lacks one:
    );
    code_block(69, "text", #string
        \\bindgen error: bindgen_generate_source: could not read nope.h
    );
    paragraph(70, #string,oneline
        \\A failure is an ordinary `Result`, not a compile error. A binding
        \\step that gives up therefore has to say so itself; the pattern the
        \\manual's own Clay bindings use is to return a `#compile_error`
        \\declaration as the inserted source, so the failure surfaces at the
        \\`#insert` site:
    );
    code_block(71, "glosso", #string
        \\bindings := generate_source(header, static_library("clay", archive),
        \\                            bindgen_options);
        \\if result_is_err(bindings) {
        \\    report_error(bindings.Err);
        \\    return "#compile_error \"Clay Bindgen failed\";";
        \\}
        \\return bindings.Ok;
    );
    subheading(72, "Module qualification");
    paragraph(73, #string,oneline
        \\A qualified import binds the module's procedures but not its
        \\types. The qualified form calls fine and then fails on the options
        \\declaration:
    );
    code_block(74, "glosso", #string
        \\Bindgen :: #import "Bindgen";
        \\
        \\#comptime {
        \\    opts: Bindgen.Bindgen_Options;
        \\    r := Bindgen.generate_source("mini.h",
        \\                                 Bindgen.static_library("mini"), opts);
        \\}
    );
    code_block(75, "text", #string
        \\error: unknown type 'Bindgen.Bindgen_Options'
        \\  --> bg4.glo:5:11
        \\  |
        \\5 |     opts: Bindgen.Bindgen_Options;
        \\  |           ^^^^^^^^^^^^^^^^^^^^^^^
    );
    paragraph(76, #string,oneline
        \\Declaring a `Bindgen_Options` value requires the unqualified
        \\`#import "Bindgen";` form. There is no qualified spelling of the
        \\type.
    );
    subheading(77, "The intrinsics");
    table_header(78, "Intrinsic   —   Wrapper");
    table_row(79, #string,oneline
        \\`#magic "bindgen_generate"`   |   `generate` — the private
        \\`__bindgen_generate_raw`, returning the internal `Bindgen_Result`
        \\record `{ ok, status, output }`
    );
    table_row(80, #string,oneline
        \\`#magic "bindgen_generate_source"`   |   `generate_source` — the private
        \\`__bindgen_generate_source_raw`, same record
    );
    paragraph(81, #string,oneline
        \\Both are compile-time-only intrinsics that require an installed
        \\binding service; the comptime VM reports `bindgen_generate
        \\requires an installed BindgenMagicService` when one is absent. The
        \\raw declarations sit inside the module's private section, so the
        \\`Result` wrappers are the only public spelling. _Intrinsics and
        \\`#magic`_ covers the registry those two names belong to.
    );
    subheading(82, "Building the library and binding it in one step");
    paragraph(83, #string,oneline
        \\Bindgen only reads the header; producing the object code the
        \\handle resolves to is `std/Compiler`'s job. The manual's own Clay
        \\bindings do both in one compile-time procedure — compile the C
        \\sources into an archive, then bind the header against that
        \\archive:
    );
    code_block(84, "glosso", #string
        \\#import "Compiler";
        \\#import "Bindgen";
        \\
        \\bindings_source :: () -> string #memory returns_fresh {
        \\    header := find_header("clay.h", "vendor/clay");
        \\
        \\    sources: [..]string;
        \\    defer array_free(*sources);
        \\    array_add(*sources, header);
        \\
        \\    c_options: C_Compile_Options;
        \\    add_c_include_path(*c_options, "vendor/clay");
        \\    add_c_compiler_arg(*c_options, "-ffreestanding");
        \\    clay := compile_c_archive("clay", sources, c_options);
        \\    if result_is_err(clay) return "#compile_error \"build failed\";";
        \\
        \\    bindgen_options: Bindgen_Options;
        \\    add_include_path(*bindgen_options, "vendor/clay");
        \\    add_bindgen_compiler_arg(*bindgen_options,
        \\                             "--target=wasm32-unknown-unknown");
        \\    bindings := generate_source(
        \\        header,
        \\        static_library("clay", clay.Ok.artifact),
        \\        bindgen_options,
        \\    );
        \\    if result_is_err(bindings) return "#compile_error \"bindgen failed\";";
        \\    return bindings.Ok;
        \\}
        \\
        \\#insert bindings_source();
    );
    paragraph(85, #string,oneline
        \\The archive path returned by `compile_c_archive` is passed as the
        \\library's `file`, so the emitted `#library,static` names the
        \\artifact that was just built. The preprocessor definitions given
        \\to the C compiler and the ones given to Bindgen are separate lists
        \\and generally need to agree; the two `add_*` helper families exist
        \\precisely because the two command lines are distinct.
    );
    paragraph(86, #string,oneline
        \\_C Libraries and Foreign Functions_ covers `#foreign`, `#library`
        \\and the handle rules the generated declarations use; _C Calling
        \\Convention_ covers what `struct #c_call` means for layout and
        \\argument passing; _Build-Time Compilation Helpers_ covers
        \\`compile_c_archive` and the rest of `std/Compiler`; _Lua 5.5
        \\Source Integration_ is a shipped module built on exactly this
        \\pattern.
    );
}

render_section_103 :: () {
    paragraph(0, #string,oneline
        \\`#derive` is written in two places and means something different
        \\in each. On a struct or union header its arguments are typeclass
        \\names. On a typeclass header its arguments are procedure names —
        \\the macros that will run when some aggregate asks for that class.
    );
    table_header(1, "Position   —   Arguments name");
    table_row(2, #string,oneline
        \\`S :: struct #derive(Show, PartialEq) { ... }`   |   Typeclasses. The
        \\checker looks up each class's own derive macros and runs them.
    );
    table_row(3, #string,oneline
        \\`C :: typeclass (T: type) #derive(derive_c) { ... }`   |   Procedures.
        \\This is the registration that makes `#derive(C)` legal at all.
    );
    paragraph(4, #string,oneline
        \\The two halves are one mechanism seen from its two ends: the class
        \\declares how it is derived, the aggregate asks to be derived.
        \\Neither side works alone. A class with no `#derive` clause is not
        \\derivable, and saying so is the compiler's most common derive
        \\diagnostic:
    );
    code_block(5, "glosso", #string
        \\Plain :: typeclass (T: type) {
        \\    name_of :: (value: T) -> string;
        \\}
        \\
        \\P :: struct #derive(Plain) { x: s64; }
    );
    code_block(6, "text", #string
        \\error: typeclass 'Plain' does not declare a derive macro
        \\  --> derive.glo:5:1
        \\  |
        \\5 | P :: struct #derive(Plain) { x: s64; }
        \\  | ^
    );
    paragraph(7, #string,oneline
        \\Naming the macro procedure on the aggregate side produces the same
        \\error, because the aggregate position always resolves its
        \\arguments as typeclasses: `P :: struct #derive(derive_named)`
        \\reports `error: typeclass 'derive_named' does not declare a derive
        \\macro`.
    );
    note(8, #string,oneline
        \\Only structs and unions accept `#derive`. An enum accepts no
        \\directives at all, so `E :: enum #derive(Show) { A; B; }` fails in
        \\the parser with `error: unexpected token 'derive'` rather than in
        \\the checker.
    );
    subheading(9, "The typeclass-side clause");
    paragraph(10, #string,oneline
        \\The clause sits in the typeclass header, after the parameter list
        \\and after any `where` constraints, and it may name several macros.
        \\All of them run, in the order written:
    );
    code_block(11, "glosso", #string
        \\Two :: typeclass (T: type) where PartialEq(T, T) #derive(mac_a, mac_b) {
        \\    a_of :: (v: T) -> s64;
        \\    b_of :: (v: T) -> s64;
        \\}
    );
    paragraph(12, #string,oneline
        \\Arguments are bare identifiers. There is no argument syntax richer
        \\than that in either position: `#derive(Functor(T))` is `error:
        \\unexpected token '('` at the open parenthesis. This is why
        \\`Derive_Options` is, in practice, always empty — see _Focused type
        \\parameters_ below.
    );
    subheading(13, "The macro procedure");
    code_block(14, "glosso", #string
        \\derive_total :: (T: type, info: Derive_Type_Info,
        \\                 opts: Derive_Options) #expand {
        \\    // ...
        \\}
    );
    paragraph(15, #string,oneline
        \\Three parameters, in that order, and `#expand`. `T` is the nominal
        \\type being derived, `info` is its reflection summary, and `opts`
        \\carries the request. The procedure returns nothing and its return
        \\value is never read: everything it produces must be published with
        \\`#insert`, either of a `#code` value or of a generated source
        \\string. A macro whose body produces nothing is legal and derives
        \\nothing.
    );
    paragraph(16, #string,oneline
        \\Every way of getting that declaration wrong collapses into a
        \\single diagnostic, raised at the aggregate that asked for the
        \\class rather than at the macro. Two parameters instead of three, a
        \\missing `#expand`, and a `#derive` clause naming a procedure that
        \\does not exist all report:
    );
    code_block(17, "text", #string
        \\error: no macro overload of 'mac1' matches this invocation
        \\  --> derive.glo:3:1
        \\  |
        \\3 | P :: struct #derive(C1) { x: s64; }
        \\  | ^
    );
    subheading(18, "A complete derive macro");
    paragraph(19, #string,oneline
        \\`Total` sums the `s64` content of a value: for a struct, every
        \\field; for a tagged union, the payload of whichever variant is
        \\active. The class declares its macro, and the macro generates one
        \\instance per deriving type. This file compiles and runs as it
        \\stands.
    );
    code_block(20, "glosso", #string
        \\#import "Io";
        \\
        \\Total :: typeclass (T: type) #derive(derive_total) {
        \\    total :: (value: T) -> s64;
        \\}
        \\
        \\total_struct_body :: (info: Derive_Type_Info) -> string
        \\    #memory(returns_fresh, reads(info), noescape(info)) {
        \\    source := sb_new();
        \\    sb_append(*source, "return 0");
        \\    for field: info.fields {
        \\        sb_append(*source, #comptime tprint(" + value.%", field.name));
        \\    }
        \\    sb_append(*source, ";");
        \\    return sb_to_string(source);
        \\}
        \\
        \\total_union_case :: (variant: Derive_Variant_Info) -> Code {
        \\    name := variant.name;
        \\    if variant.payload == void return #code { case ``name; return 0; };
        \\    return #code { case ``name; return value.``name; };
        \\}
        \\
        \\derive_total :: (T: type, info: Derive_Type_Info, opts: Derive_Options) #expand {
        \\    if !Is_Struct(T) && !Is_Union(T)
        \\        #compile_error "Total can only be derived for struct or union types";
        \\    if Is_Union(T) && info.raw_union
        \\        #compile_error "Total derive is not defined for #raw union";
        \\
        \\    no_focuses: []s64;
        \\    no_replacements: []Code;
        \\    section := derive_type_section(info, no_focuses);
        \\    input_type := derive_type_apply(info, no_focuses, no_replacements);
        \\
        \\    if Is_Struct(T) {
        \\        #insert #code {
        \\            ``section :: instance Total {
        \\                total :: (value: ``input_type) -> s64 {
        \\                    #insert total_struct_body(info);
        \\                }
        \\            }
        \\        };
        \\    }
        \\
        \\    if Is_Union(T) {
        \\        #insert #code {
        \\            ``section :: instance Total {
        \\                total :: (value: ``input_type) -> s64 {
        \\                    if value == {
        \\                        #inline for variant: info.variants {
        \\                            ``total_union_case(variant)
        \\                        }
        \\                    }
        \\                    return 0;
        \\                }
        \\            }
        \\        };
        \\    }
        \\}
        \\
        \\Point :: struct #derive(Total) {
        \\    x: s64;
        \\    y: s64;
        \\}
        \\
        \\Reading :: union #derive(Total) {
        \\    exact: s64;
        \\    missing: void;
        \\}
        \\
        \\main :: () {
        \\    p: Point;
        \\    p.x = 3;
        \\    p.y = 4;
        \\    print("point %\n", total(p));
        \\
        \\    r: Reading;
        \\    r.exact = 11;
        \\    print("exact %\n", total(r));
        \\
        \\    m: Reading;
        \\    m.missing;
        \\    print("missing %\n", total(m));
        \\}
    );
    code_block(21, "text", #string
        \\point 7
        \\exact 11
        \\missing 0
    );
    paragraph(22, #string,oneline
        \\Four mechanisms carry the whole example. `derive_type_section`
        \\builds the instance head, which the double-backtick splice drops
        \\in front of `:: instance Total`. `derive_type_apply` builds the
        \\type of the value the method receives. `#inline for` inside a
        \\`#code` quote emits one `case` fragment per variant, each of which
        \\was itself built by an ordinary procedure returning `Code`. And
        \\`#insert` of a plain string generates the struct body textually,
        \\which is often shorter than quoting it.
    );
    paragraph(23, #string,oneline
        \\Nothing in the macro is special to derive except the
        \\three-parameter signature: `#code`, the backtick splices, `#inline
        \\for` and `#insert` are the ordinary compile-time facilities
        \\described in _Code Values with `#code`_ and _Expand Procedures and
        \\`#insert`_.
    );
    subheading(24, "`Derive_Type_Info` and the descriptor records");
    code_block(25, "glosso", #string
        \\Derive_Type_Info :: struct {
        \\    base: Type_Info;
        \\    params: []Type_Param_Info;
        \\    fields: []Derive_Field_Info;
        \\    variants: []Derive_Variant_Info;
        \\    raw_union: bool;
        \\}
        \\
        \\Type_Param_Info    :: struct { name: string; index: s64; }
        \\Derive_Field_Info  :: struct { name: string; ty: type; }
        \\Derive_Variant_Info :: struct { name: string; payload: type; }
        \\Derive_Options     :: struct { focus_params: []string; }
    );
    table_header(26, "Member   —   Meaning");
    table_row(27, #string,oneline
        \\`base`   |   The ordinary `Type_Info` for the type, so `base.name`,
        \\`base.size` and the rest of _Reflection_'s surface are available
        \\without a second lookup.
    );
    table_row(28, #string,oneline
        \\`params`   |   Generic type parameters in declaration order. Empty for a
        \\non-generic type. Every `focuses` and `param_index` argument in
        \\this chapter is an index into this array.
    );
    table_row(29, #string,oneline
        \\`fields`   |   Struct fields in declaration order; empty for a union.
    );
    table_row(30, #string,oneline
        \\`variants`   |   Tagged-union variants in declaration order; empty for a
        \\struct.
    );
    table_row(31, #string,oneline
        \\`raw_union`   |   True for `#raw union`, where there is no tag to switch
        \\on and most derives are meaningless.
    );
    table_row(32, #string,oneline
        \\`Type_Param_Info.index`   |   The parameter's own zero-based position.
        \\It equals the array index, and is present so a single parameter
        \\can be passed around on its own.
    );
    table_row(33, #string,oneline
        \\`Derive_Field_Info.ty`   |   The field type already resolved in the
        \\derived type's generic scope.
    );
    table_row(34, #string,oneline
        \\`Derive_Variant_Info.payload`   |   The variant's payload type.
        \\Payload-less variants report `void`, which is the test the `Total`
        \\macro above uses.
    );
    table_row(35, #string,oneline
        \\`Derive_Options.focus_params`   |   Parameter names the request asked
        \\the macro to focus on. Always empty today.
    );
    paragraph(36, #string,oneline
        \\A helper that receives only the type can rebuild the record for
        \\itself. `derive_type_info` is the intrinsic behind the `info`
        \\parameter and returns exactly the same value:
    );
    code_block(37, "glosso", #string
        \\derive_type_info :: (T: type) -> Derive_Type_Info
        \\    #magic "derive_type_info" #memory returns_static;
    );
    subheading(38, "Type-shape queries");
    code_block(39, "glosso", #string
        \\type_uses_param :: (T: type, param_index: s64) -> bool
        \\    #magic "type_uses_param";
        \\type_is_param :: (T: type, param_index: s64) -> bool
        \\    #magic "type_is_param";
        \\type_occurs_covariantly :: (T: type, param_index: s64) -> bool
        \\    #magic "type_occurs_covariantly";
    );
    paragraph(40, #string,oneline
        \\`type_uses_param` asks whether the parameter appears in `T` at
        \\all, `type_is_param` whether `T` is exactly that parameter, and
        \\`type_occurs_covariantly` whether every occurrence sits in a
        \\position a mapping function may rewrite. They are the tools for
        \\deciding whether a field needs generated code or can be copied
        \\unchanged.
    );
    paragraph(41, #string,oneline
        \\The three answers can be inspected directly by printing them from
        \\a `#comptime` block inside a macro. Deriving over a struct that
        \\mentions its only parameter in four different shapes, plus one
        \\field that does not mention it at all, gives:
    );
    code_block(42, "glosso", #string
        \\Shapes :: struct #derive(Probe) {
        \\    direct: $A;
        \\    view: []A;
        \\    ptr: *A;
        \\    fixed: [4]A;
        \\    plain: s64;
        \\}
    );
    code_block(43, "text", #string
        \\field direct ty=__derive_param_0_A uses=1 is=1 cov=1
        \\field view ty=[]A uses=0 is=0 cov=1
        \\field ptr ty=*A uses=0 is=0 cov=1
        \\field fixed ty=[4]A uses=0 is=0 cov=1
        \\field plain ty=int uses=0 is=0 cov=1
    );
    note(44, #string,oneline
        \\Only a direct occurrence is detected. `[]A`, `*A`, `[4]A` and a
        \\function type mentioning `A` all report `type_uses_param` false in
        \\the current compiler, and `type_occurs_covariantly` therefore
        \\reports true for them — it is answering about a parameter it never
        \\found, not certifying the position. A macro must not treat a false
        \\from `type_uses_param` as proof that a field is parameter-free.
        \\The standard derives work within this limit by requiring exactly
        \\one directly focused field or variant and rejecting everything
        \\else with `#compile_error`.
    );
    paragraph(45, #string,oneline
        \\An unbound generic parameter shows up as a placeholder type named
        \\`__derive_param_<index>_<Name>`, as `direct` does above. It is not
        \\spellable in source; the way to name it in generated code is to
        \\let `derive_type_apply` write it.
    );
    subheading(46, "Building type expressions");
    code_block(47, "glosso", #string
        \\derive_type_section :: (info: Derive_Type_Info, focuses: []s64) -> Code
        \\    #magic "derive_type_section";
        \\derive_type_apply :: (info: Derive_Type_Info, focuses: []s64,
        \\                      replacements: []Code) -> Code
        \\    #magic "derive_type_apply";
        \\derive_type_fn :: (params: []Code, ret: Code) -> Code
        \\    #magic "derive_type_fn";
    );
    table_header(48, "Call   —   Produces");
    table_row(49, #string,oneline
        \\`derive_type_section(info, .[1])` on `Result(E, A)`   |   The instance
        \\head `Result($E, _)`, with the focused parameter left as a hole.
        \\Splice it in front of `:: instance C`.
    );
    table_row(50, #string,oneline
        \\`derive_type_section(info, empty)`   |   The head with no holes at all —
        \\what a non-higher-kinded class such as `Show` or the `Total`
        \\example needs.
    );
    table_row(51, #string,oneline
        \\`derive_type_apply(info, .[1], .[#code { B }])`   |   Applied to
        \\`Result(E, A)`, produces `Result(E, B)`. Non-focused parameters
        \\keep their original names; replacements are substituted into the
        \\focused positions in order.
    );
    table_row(52, #string,oneline
        \\`derive_type_fn(.[#code { $A }], #code { $B })`   |   The function type
        \\`($A) -> $B`, for use as a replacement.
    );
    paragraph(53, #string,oneline
        \\Composing the last two is how a higher-kinded method spells the
        \\argument it maps with. This macro generates a method whose
        \\parameter type is `Maybe(($A) -> $B)`, and it compiles and runs:
    );
    code_block(54, "glosso", #string
        \\Sizer :: typeclass (F: (type) -> type) #derive(derive_sizer) {
        \\    fn_size :: (v: F(($A) -> $B)) -> s64;
        \\}
        \\
        \\derive_sizer :: (F: type, info: Derive_Type_Info, opts: Derive_Options) #expand {
        \\    focuses := derive_focus_params(info, opts, 1);
        \\    section := derive_type_section(info, focuses);
        \\    fn_type := derive_type_apply(info, focuses,
        \\                                 .[derive_type_fn(.[#code { $A }], #code { $B })]);
        \\    #insert #code {
        \\        ``section :: instance Sizer {
        \\            fn_size :: (v: ``fn_type) -> s64 { return size_of(type_of(v)); }
        \\        }
        \\    };
        \\}
        \\
        \\Maybe :: union #derive(Sizer) {
        \\    some: $T;
        \\    none: void;
        \\}
        \\
        \\main :: () {
        \\    m: Maybe((s64) -> s64);
        \\    print("%\n", fn_size(m));    // 16
        \\}
    );
    subheading(55, "Focused type parameters");
    code_block(56, "glosso", #string
        \\derive_param_index :: (info: Derive_Type_Info,
        \\                       explicit_name: string) -> s64;
        \\derive_focus_params :: (info: Derive_Type_Info, opts: Derive_Options,
        \\                        default_count: s64) -> [..]s64;
        \\derive_focus_param :: (info: Derive_Type_Info, opts: Derive_Options) -> s64;
        \\derive_two_focus_params :: (info: Derive_Type_Info,
        \\                            opts: Derive_Options) -> (s64, s64);
    );
    paragraph(57, #string,oneline
        \\These four are ordinary Glosso procedures in
        \\`std/Typeclass/Derive.glo`, not intrinsics. `derive_focus_params`
        \\turns the request into the index list every derive intrinsic
        \\wants: with no explicit names it selects the final `default_count`
        \\parameters, which is why `Functor` maps the last one; with
        \\explicit names it requires exactly `default_count` of them and
        \\resolves each through `derive_param_index`. Any mismatch — wrong
        \\count, a name that is not a parameter, a repeated index — returns
        \\an empty array rather than raising, so the caller checks
        \\`focuses.count` and issues its own `#compile_error`.
        \\`derive_param_index` returns `-1` for an unknown name.
        \\`derive_focus_param` and `derive_two_focus_params` are the unary
        \\and binary wrappers, returning `-1` on failure.
    );
    note(58, #string,oneline
        \\`Derive_Options.focus_params` is always empty in the current
        \\compiler. `#derive(...)` accepts only bare identifiers, so there
        \\is no syntax for naming a parameter, and the checker always
        \\constructs the default options record. The explicit-name path in
        \\`derive_focus_params` is reachable only by a macro that builds its
        \\own `Derive_Options` before calling it.
    );
    paragraph(59, #string,oneline
        \\`std/Typeclass/Functor.glo` is the reference use. Its macro
        \\focuses one parameter, builds the sectioned head and the two
        \\applied types, then generates one `fmap`:
    );
    code_block(60, "glosso", #string
        \\focuses := derive_focus_params(info, opts, 1);
        \\if focuses.count != 1
        \\    #compile_error "Functor derive needs exactly one focused type parameter";
        \\focus := focuses[0];
        \\section := derive_type_section(info, focuses);
        \\input_type := derive_type_apply(info, focuses, .[#code { $A }]);
        \\output_type := derive_type_apply(info, focuses, .[#code { B }]);
    );
    subheading(61, "When a derive macro runs");
    paragraph(62, #string,oneline
        \\Derivation happens during checking, at the aggregate declaration,
        \\before any instantiation. It runs once per nominal type — not once
        \\per generic instantiation — so a generic type is derived exactly
        \\once and the generated instance is itself generic. Declaring
        \\`Shapes($A)` and then using both `Shapes(s64)` and `Shapes(f64)`
        \\runs the macro a single time.
    );
    paragraph(63, #string,oneline
        \\Because the macro body is ordinary code, its `#compile_error`
        \\calls carry the macro's own location, not the user's declaration.
        \\The `Total` macro's raw-union guard reports:
    );
    code_block(64, "text", #string
        \\error: Total derive is not defined for #raw union
        \\   --> derive.glo:28:9
        \\   |
        \\28 |         #compile_error "Total derive is not defined for #raw union";
        \\   |         ^^^^^^^^^^^^^^
    );
    paragraph(65, #string,oneline
        \\For a macro that lives in `std/`, the caret lands in the standard
        \\library rather than in the user's file — the four `#derive(Error)`
        \\rejections in _Try Expressions and Propagation_ all point at
        \\`std/Typeclass/Error.glo`. The declaration that triggered it is
        \\not named anywhere in the diagnostic, which is worth knowing
        \\before hunting for it.
    );
    paragraph(66, #string,oneline
        \\Errors in the generated code are reported differently: the primary
        \\span sits at the `#insert` inside the macro and a provenance note
        \\points into the cached generated file. Deriving `Total` for a
        \\struct with a `string` field gives:
    );
    code_block(67, "text", #string
        \\error: no operator '+' for int, string
        \\   --> derive.glo:39:21
        \\   |
        \\39 |                     #insert total_struct_body(info);
        \\   |                     ^^^^^^^
        \\note: generated source failed here
        \\  --> <cache>/generated/insert/v1/b46ef957....glo:1:20
        \\  |
        \\1 | return 0 + value.x + value.name;
        \\  |                    ^
    );
    paragraph(68, #string,oneline
        \\The generated line is the readable half of that report. _Compiler
        \\Cache and Generated Sources_ covers where those files live and how
        \\to keep them.
    );
    subheading(69, "The derivable classes in the standard library");
    table_header(70, "Class   —   What deriving generates");
    table_row(71, #string,oneline
        \\`PartialEq`   |   `'=='` — field-wise `&&` for a struct, a variant
        \\switch for a tagged union. Refuses anything else and refuses `#raw
        \\union`.
    );
    table_row(72, #string,oneline
        \\`Show`   |   `show(value) -> string`, rendering a struct as `{1, 2}` and
        \\a union as `Variant(payload)`. This is what `print` and `%` reach
        \\through.
    );
    table_row(73, #string,oneline
        \\`Serialize`   |   `serialize(value) -> Serialization_Value`, the input
        \\to `json_serialize`, `toml_serialize`, `yaml_serialize` and
        \\`messagepack_serialize`.
    );
    table_row(74, #string,oneline
        \\`Deserialize`   |   `deserialize(#empty: T, value) -> Result(T,
        \\Serialization_Error)`, the counterpart used by the `*_deserialize`
        \\family.
    );
    table_row(75, #string,oneline
        \\`Functor`   |   `fmap` over the final type parameter. Rejects a
        \\non-covariant field with `Functor derive found a non-covariant
        \\field`, and rejects `#raw union`.
    );
    table_row(76, #string,oneline
        \\`Error`   |   `report_error` as an exhaustive variant switch forwarding
        \\to each payload's own `Error` instance. Tagged unions only; see
        \\_Try Expressions and Propagation_ for its five rejections.
    );
    note(77, #string,oneline
        \\`Applicative` and `Monad` declare derive macros and do not work.
        \\`#derive(Applicative)` generates an instance whose `pure` cannot
        \\be selected at any call site — `m: Maybe(s64) = pure(3);` reports
        \\`no overload 'pure' accepts these arguments` with `note: call pure
        \\cannot produce expected type Maybe_int` — and whose `ap` fails
        \\inside the standard library itself the moment it is called, at
        \\`std/Typeclass/Applicative.glo:11`, with `no overload 'fmap'
        \\accepts these arguments` and `note: generic arg mismatch: fnptr vs
        \\fnptr`. `#derive(Monad)`'s `bind` does compile, but only when
        \\`Applicative` is derived alongside it, since `Monad`'s own `where
        \\Applicative(M)` constraint must be satisfied for the instance to
        \\be selected; deriving `Monad` without it gives `no overload 'bind'
        \\accepts these arguments`. Neither class is exercised anywhere in
        \\the compiler's test suite. Write these instances by hand.
    );
    paragraph(78, #string,oneline
        \\_Higher-Kinded Typeclasses and Derive_ covers `#derive` from the
        \\consuming side; _Typeclasses_ and _Default Methods and Negative
        \\Instances_ cover instance heads, `#minimal` and the resolution
        \\rules the generated instances obey; _Code Values with `#code`_
        \\covers `#code`, the single and double backtick splices, and `Code`
        \\itself; _Expand Procedures and `#insert`_ covers `#expand` and
        \\both `#insert` forms; _Reflection_ covers `Type_Info` and the
        \\ordinary reflection intrinsics.
    );
}

